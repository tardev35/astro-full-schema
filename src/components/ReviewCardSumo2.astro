---
export interface Props {
  title?: string;
}

const { title = "เสียงจากสมาชิก YIMSIAM889" } = Astro.props;

const reviews = [
  {
    name: "คุณภูมิ",
    role: "ย้ายมาจากเว็บที่ผ่านเอเย่นต์",
    stars: 5,
    tag: "เว็บตรงไม่ผ่านเอเย่นต์",
    content:
      "เคยเล่นเว็บที่ผ่านนายหน้ามาก่อน พอมาลอง YIMSIAM889 ที่เชื่อมสัญญาณตรงจากค่ายแม่ก็รู้สึกได้เลยขอรับว่าเกมนิ่งกว่า ไม่ค้างกลางวงล้อ อัตราการชนะก็เป็นไปตามค่า RTP ที่ค่ายกำหนด ไม่มีใครมาแอบปรับหลังบ้านให้หงุดหงิดหัวใจ วัดกันที่ดวงและฝีมือล้วนๆ ตรวจสอบย้อนหลังได้ทุกขั้นตอน สบายใจกว่าเยอะ",
    avatar: "🏛️",
  },
  {
    name: "คุณต้น",
    role: "สมาชิกใหม่ที่เพิ่งรับโปรต้อนรับ",
    stars: 5,
    tag: "ยิ้มรับโปรสมาชิกใหม่",
    content:
      "เพิ่งก้าวเข้ามาเป็นสมาชิกได้ไม่นาน ได้ของขวัญต้อนรับชุดใหญ่ไปเต็มๆ ทั้งโบนัสเพิ่มทุนและสิทธิพิเศษที่ทางเว็บจัดสรรมาให้อย่างเหมาะสม ทำให้มีกระสุนเริ่มเล่นมากขึ้นโดยไม่ต้องกังวลเรื่องทุนรอน ขั้นตอนรับสิทธิ์ง่ายดายเพียงลัดนิ้วมือเดียว ไม่ต้องกรอกอะไรยาวเหมือนใบสมัครงาน ประทับใจการต้อนรับแบบไทยแท้ขอรับ",
    avatar: "🎁",
  },
  {
    name: "คุณแนน",
    role: "ทำรายการฝากถอนเองผ่านแอปธนาคาร",
    stars: 4,
    tag: "ธุรกรรมว่องไว",
    content:
      "ระบบฝากถอนของที่นี่เป็นอัตโนมัติเต็มรูปแบบขอรับ ทำรายการเองผ่านแอปธนาคารหรือทรูวอลเลทได้เลย ไม่ต้องส่งสลิปให้แอดมินดูให้เสียเวลา ฝากปุ๊บเงินเข้าปั๊บ ถอนปุ๊บโอนเข้าบัญชีทันที ยอดตรงเป๊ะทุกบาททุกสตางค์ แถมจะนอนเล่นอยู่บนเรือนหรือเดินทางไกล ก็เปิดทางเข้าผ่านมือถือได้ทั้ง iOS และ Android ไม่มีสะดุด",
    avatar: "⚡",
  },
];
const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label={title} class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#eaf4ff] via-[#9cc9ff] to-[#7cc0ff] bg-clip-text text-3xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</p>
    <div aria-hidden="true" class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#2f8cff] to-transparent"></div>
  </div>

  <div class="mx-auto mb-8 flex max-w-md items-center justify-center gap-5 rounded-2xl border border-[#16357a] bg-[#061538] px-6 py-4 shadow-[0_10px_30px_rgba(47,140,255,0.18)]">
    <div class="flex flex-col items-center">
      <span class="bg-gradient-to-b from-[#eaf4ff] to-[#7cc0ff] bg-clip-text text-4xl leading-none font-black text-transparent">{average}</span>
      <span class="mt-1 text-[10px] font-bold tracking-widest text-[#93a9d6] uppercase">คะแนนเฉลี่ย</span>
    </div>
    <div class="h-12 w-px bg-[#16357a]"></div>
    <div class="flex flex-col gap-1.5">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#7cc0ff]" : "text-[#16357a]"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#93a9d6]">คะแนนเฉลี่ย {average} จาก 5 ดาว จากรีวิวของสมาชิก {reviews.length} ท่าน</span>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
    {
      reviews.map((review) => (
        <article class="group relative isolate flex flex-col gap-4 overflow-hidden rounded-2xl border border-[#16357a] bg-[#061538] p-6 text-left shadow-[0_10px_30px_rgba(47,140,255,0.16)] transition-all duration-300 hover:-translate-y-1 hover:border-[#2f8cff]/55 hover:shadow-[0_15px_40px_rgba(47,140,255,0.28)]">
          <span aria-hidden="true" class="absolute inset-y-0 left-0 -z-10 w-1 bg-gradient-to-b from-[#eaf4ff] via-[#2f8cff] to-[#0b4fd6] opacity-80 transition-opacity duration-300 group-hover:opacity-100" />
          <span aria-hidden="true" class="pointer-events-none absolute -top-14 -right-14 -z-10 h-32 w-32 rounded-full bg-[#2f8cff]/16 blur-[50px] transition-all duration-300 group-hover:bg-[#7cc0ff]/18" />

          <div class="flex items-center justify-between gap-3">
            <span class="inline-flex items-center gap-1.5 rounded-full border border-[#16357a] bg-[#0a1f4d] px-3 py-1 text-[10px] font-bold tracking-widest text-[#dbeaff] uppercase">
              <span aria-hidden="true" class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#2f8cff]" />
              {review.tag}
            </span>
            <span class="flex gap-0.5 text-sm">
              <span aria-hidden="true" class="flex gap-0.5">
                {Array.from({ length: 5 }).map((_, i) => (
                  <span class={i < review.stars ? "text-[#7cc0ff]" : "text-[#16357a]"}>★</span>
                ))}
              </span>
              <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
            </span>
          </div>

          <p class="text-left text-base leading-relaxed text-[#d6e4ff]">{review.content}</p>

          <div class="mt-auto flex items-center gap-3 border-t border-[#16357a] pt-4">
            <span
              aria-hidden="true"
              class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#16357a] bg-gradient-to-br from-[#eaf4ff] via-[#9cc9ff] to-[#4d9dff] text-xl shadow-inner transition-transform duration-300 group-hover:scale-110">
              {review.avatar}
            </span>
            <span class="flex flex-col">
              <span class="text-sm font-black text-[#9cc9ff] transition-colors group-hover:text-[#eaf4ff]">{review.name}</span>
              <span class="text-[10px] font-bold tracking-wider text-[#93a9d6] uppercase">{review.role}</span>
            </span>
          </div>
        </article>
      ))
    }
  </div>
</section>
