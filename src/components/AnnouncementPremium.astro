---
const {
  message = "KOH888 เว็บตรงรวมสล็อต คาสิโน บาคาร่า บอล และหวยไว้ในบัญชีเดียว • เมนูแบ่งเป็นหมวดชัด สลับจากสล็อตไปคาสิโนหรือบอลได้จากหน้าเดิม • ฝากถอนออโต้ขั้นตอนสั้น ดูยอดและประวัติรายการได้จากหน้าบัญชี • หน้าสมาชิกรวมเครดิต โปรโมชั่น และรายการทั้งหมดไว้จุดเดียว • สมัครไม่กี่ขั้นตอนแล้วเข้าเลือกเกมได้ทันที",
} = Astro.props;
---

<div class="mx-auto w-full max-w-7xl px-4 py-4 font-sans">
  <div
    class="relative flex overflow-hidden rounded-full border border-[#f5c542]/35 bg-[#1a0a2e]/92 shadow-[0_8px_20px_rgba(139,54,217,0.25)] backdrop-blur-lg transition-shadow duration-300 hover:shadow-[0_8px_25px_rgba(245,197,66,0.30)]">
    <div
      class="relative z-10 flex shrink-0 items-center justify-center rounded-full bg-gradient-to-r from-[#ffe9a3] via-[#f5c542] to-[#a9761a] px-8 py-2.5 font-black text-[#1a0a2e] shadow-[4px_0_15px_rgba(245,197,66,0.25)]">
      <span aria-hidden="true" class="mr-2 text-lg">👑</span> ประกาศ
    </div>

    <div class="marquee-container relative flex-1 overflow-hidden py-2.5 pr-6">
      <div aria-hidden="true" class="pointer-events-none absolute top-0 left-0 z-10 h-full w-12 bg-gradient-to-r from-[#1a0a2e] to-transparent"></div>

      <div class="marquee-content inline-block pl-4 text-sm font-medium tracking-wide whitespace-nowrap text-[#e9dcf6]">
        <span class="mr-10 inline-flex items-center gap-3"><span aria-hidden="true" class="h-2 w-2 rounded-full bg-[#c77dff] shadow-[0_0_8px_rgba(199,125,255,0.6)]"></span>{message}</span>
        <span class="mr-10 inline-flex items-center gap-3"><span aria-hidden="true" class="h-2 w-2 rounded-full bg-[#c77dff] shadow-[0_0_8px_rgba(199,125,255,0.6)]"></span>{message}</span>
      </div>
    </div>
  </div>
</div>

<style>
  .marquee-content {
    animation: marquee 25s linear infinite;
  }
  .marquee-container:hover .marquee-content {
    animation-play-state: paused;
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee-content {
      animation: none;
    }
  }
  @keyframes marquee {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }
</style>
