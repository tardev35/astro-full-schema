---
import { Picture } from "astro:assets";
import img1 from "../assets/providers/game1.avif";
import img2 from "../assets/providers/game2.avif";
import img3 from "../assets/providers/game3.avif";
import img4 from "../assets/providers/game4.avif";
import img5 from "../assets/providers/game5.avif";
import img6 from "../assets/providers/game6.avif";

const games = [
  { rank: 1, name: "บาคาร่า ห้อง Live สด", type: "คาสิโนสด • รอบเร็ว", menus: ["ยอดนิยม", "เล่นล่าสุด"], players: 5124, img: img6 },
  { rank: 2, name: "รูเล็ต โต๊ะไลฟ์", type: "คาสิโนสด • วงเงินหลายระดับ", menus: ["ยอดนิยม", "รายการโปรด"], players: 3842, img: img3 },
  { rank: 3, name: "เสือมังกร โต๊ะสด", type: "คาสิโนสด • กติกาสั้น", menus: ["ยอดนิยม", "รายการโปรด"], players: 3517, img: img1 },
  { rank: 4, name: "สล็อตฟีเจอร์โบนัส", type: "สล็อต • ความผันผวนสูง", menus: ["เกมใหม่", "เล่นล่าสุด"], players: 2905, img: img2 },
  { rank: 5, name: "สล็อตเดิมพันเริ่มต้นต่ำ", type: "สล็อต • เริ่ม 1–10 บาท", menus: ["เกมใหม่", "รายการโปรด"], players: 2431, img: img4 },
  { rank: 6, name: "กีฬาและบอลสด", type: "กีฬา • ราคาขยับตามเกม", menus: ["เกมใหม่", "เล่นล่าสุด"], players: 2108, img: img5 },
];

const medal = (rank: number) => (rank === 1 ? "🥇" : rank === 2 ? "🥈" : rank === 3 ? "🥉" : null);
---

<section aria-label="โต๊ะคาสิโนสดและหมวดเกมยอดนิยมของ WINSIAM88" class="mx-auto w-full max-w-[1300px] px-4 py-8 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <span aria-hidden="true" class="text-2xl">🏆</span>
    <p class="bg-gradient-to-r from-[#f5cf4d] via-[#d4a017] to-[#9a7112] bg-clip-text text-2xl font-black tracking-widest text-transparent uppercase">
      โต๊ะคาสิโนสดและหมวดเกมยอดนิยมของ WINSIAM88
    </p>
    <p class="max-w-3xl text-base leading-relaxed text-[#a3e635]">
      สล็อตให้ดูเดิมพันเริ่มต้น ความผันผวน และฟีเจอร์โบนัส ส่วนโต๊ะสดให้ดูค่ายเกม วงเงินโต๊ะ ความเร็วรอบ และสถานะเปิดรับเดิมพัน
      รายชื่อในแต่ละหมวดเปลี่ยนแปลงได้ตามช่วงเวลา และควรตรวจวงเงินจากหน้าเกมจริงอีกครั้งก่อนกดยืนยัน
    </p>
    <div class="mt-2 h-[3px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#d4a017] to-transparent"></div>
  </div>

  <div class="flex flex-col gap-3">
    {
      games.map((g) => {
        const top = g.rank === 1;
        return (
          <article
            class={`group relative flex items-center gap-3 overflow-hidden rounded-2xl border p-3 backdrop-blur-md transition-all duration-300 hover:-translate-y-0.5 sm:gap-5 sm:p-4 ${
              top
                ? "border-[#d4a017]/50 bg-gradient-to-r from-[#122010]/95 via-[#0b1408]/92 to-[#0b1408]/92 shadow-[0_15px_40px_rgba(212,160,23,0.3)]"
                : "border-[#d4a017]/25 bg-[#0b1408]/92 shadow-[0_10px_30px_rgba(212,160,23,0.18)] hover:border-[#d4a017]/50 hover:shadow-[0_15px_40px_rgba(212,160,23,0.3)]"
            }`}>
            <div class="pointer-events-none absolute top-1/2 -left-10 h-24 w-24 -translate-y-1/2 rounded-full bg-[#a3e635]/25 blur-[40px] transition-all duration-500 group-hover:bg-[#a3e635]/35" />

            <div class="relative z-10 flex w-8 shrink-0 flex-col items-center justify-center sm:w-12">
              {
                medal(g.rank) ? (
                  <span class="text-2xl sm:text-3xl">
                    <span aria-hidden="true">{medal(g.rank)}</span>
                    <span class="sr-only">อันดับ {g.rank}</span>
                  </span>
                ) : (
                  <span class="text-xl font-black text-[#9a7112] sm:text-2xl">#{g.rank}</span>
                )
              }
            </div>

            <div class={`relative z-10 h-14 w-14 shrink-0 overflow-hidden rounded-xl border sm:h-16 sm:w-16 ${top ? "border-[#d4a017]/50" : "border-[#d4a017]/25"}`}>
              <Picture
                src={g.img}
                alt={`ภาพหน้าปกเกม ${g.name} ในกระดานเกมยอดนิยมของ WINSIAM88`}
                formats={["avif", "webp"]}
                fallbackFormat="webp"
                loading="lazy"
                fetchpriority="low"
                widths={[100, 200]}
                sizes="(max-width: 640px) 56px, 64px"
                decoding="async"
                class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-110"
              />
            </div>

            <div class="relative z-10 min-w-0 flex-1">
              <div class="flex items-center gap-2">
                <p class="truncate text-base font-black text-[#dfeacf] sm:text-lg">{g.name}</p>
                {top && <span class="hidden shrink-0 rounded-full border border-[#4d7c0f]/70 bg-[#071005] px-2 py-0.5 text-[9px] font-black tracking-wider text-[#a3e635] sm:inline">ยอดนิยมสูงสุด</span>}
              </div>
              <p class="truncate text-[11px] text-[#a3e635] sm:text-xs">{g.type}</p>

              <div class="mt-2 flex flex-wrap items-center gap-1.5">
                {g.menus.map((m) => (
                  <span class="rounded-full border border-[#d4a017]/25 bg-[#071005] px-2.5 py-0.5 text-[10px] font-bold text-[#d4a017]">{m}</span>
                ))}
              </div>
            </div>

            <div class="relative z-10 hidden shrink-0 flex-col items-end gap-1 sm:flex">
              <span class="flex items-center gap-1.5 text-[11px] text-[#a3e635]">
                <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-green-500 shadow-[0_0_6px_rgba(34,197,94,0.6)]" />
                <span class="tabular-nums" data-players data-base={g.players}>
                  {g.players.toLocaleString("en-US")}
                </span>{" "}
                ออนไลน์
              </span>
              <a
                href="/register"
                class={`rounded-full px-4 py-1.5 text-xs font-black transition-transform hover:scale-105 ${
                  top
                    ? "bg-gradient-to-r from-[#f5cf4d] via-[#d4a017] to-[#9a7112] text-[#0f1a06] shadow-[0_10px_30px_rgba(212,160,23,0.22)]"
                    : "border border-[#d4a017]/60 bg-[#071005] text-[#d4a017] hover:border-[#d4a017] hover:bg-[#122010]"
                }`}>
                เข้าดูเกม
              </a>
            </div>
          </article>
        );
      })
    }
  </div>
</section>

<script>
  import { startLiveCounters } from "../lib/liveCounter";

  startLiveCounters();
</script>
