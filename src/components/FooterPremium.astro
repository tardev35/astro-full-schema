---
import { Picture } from "astro:assets";
import BankStrip from "./BankStrip.astro";
import { BRAND_ADDRESS, BRAND_NAME } from "../lib/brandProfile";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });
const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

const logoAlt = "โลโก้ YIMSIAM889 หน้ายักษ์ทวารบาลสีขาวเงินอยู่เหนือป้ายชื่อแบรนด์ตัวอักษรโครเมียมขอบน้ำเงิน บนโล่สีกรมท่าเรืองแสงสีฟ้า";
---

<footer
  class="relative mt-16 w-full overflow-hidden rounded-t-[3rem] border-t-2 border-[#2f8cff] bg-[#010a1f] pt-16 pb-8 font-sans text-[#d6e4ff] shadow-[0_-15px_40px_rgba(47,140,255,0.22)]">
  <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 -top-20 mx-auto h-[250px] w-full max-w-4xl rounded-full bg-[#2f8cff]/20 blur-[100px]"></div>

  <div class="relative z-10 mx-auto w-full max-w-[1200px] px-6">
    <div class="mb-12 grid grid-cols-1 gap-12 md:grid-cols-12">
      <div class="flex flex-col gap-5 md:col-span-5">
        <a href="/" class="inline-block transition-transform duration-300 hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt={logoAlt}
                widths={[130, 260, 390]}
                sizes="130px"
                loading="lazy"
                class="h-[75px] w-auto drop-shadow-[0_5px_15px_rgba(47,140,255,0.45)]"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <span class="bg-gradient-to-r from-[#eaf4ff] to-[#2f8cff] bg-clip-text text-4xl font-black tracking-widest text-transparent">YIMSIAM889</span>
            )
          }
        </a>
        <p class="border-l-2 border-[#2f8cff] pl-4 text-sm leading-relaxed text-[#d6e4ff]/75">
          YIMSIAM889 สล็อตสยาม เว็บตรงไม่ผ่านเอเย่นต์ เชื่อมต่อสัญญาณเกมโดยตรงจากค่ายแม่ ทั้ง PG SOFT, Joker Gaming และ Pragmatic Play อัตราการชนะเป็นไปตามค่า RTP มาตรฐานสากล
          ฝากถอนผ่านระบบอัตโนมัติ ทำรายการเองได้ผ่านแอปธนาคารชั้นนำหรือทรูวอลเลท ไม่ต้องส่งสลิป รองรับมือถือ iOS, Android คอมพิวเตอร์และแท็บเล็ต บริการด้วยใจแบบไทยแท้
        </p>
        <div class="mt-4 flex gap-3">
          <span class="rounded-full border border-[#2f8cff]/45 bg-[#2f8cff]/15 px-4 py-1 text-xs font-medium text-[#eaf4ff]">เว็บตรงลิขสิทธิ์แท้</span>
          <span class="rounded-full border border-[#7cc0ff]/45 bg-[#7cc0ff]/15 px-4 py-1 text-xs font-medium text-[#dbeaff]">ฝากถอนอัตโนมัติ</span>
        </div>
      </div>

      <nav aria-label="ลิงก์หน้าเว็บ YIMSIAM889" class="flex flex-col gap-4 md:col-span-3 lg:pl-8">
        <p class="text-lg font-black tracking-widest text-[#eaf4ff] uppercase drop-shadow-sm">เมนูลัด</p>
        <div aria-hidden="true" class="h-[1px] w-12 bg-[#2f8cff]"></div>
        <ul class="flex flex-col gap-3 text-sm font-medium text-[#d6e4ff]/75">
          <li><a href="/" class="transition-colors hover:text-[#7cc0ff]">หน้าแรก</a></li>
          <li><a href="/promotion/" class="transition-colors hover:text-[#7cc0ff]">โปรโมชั่น</a></li>
          <li><a href="/register/" class="transition-colors hover:text-[#7cc0ff]">สมัครสมาชิก</a></li>
          <li><a href="/login/" class="transition-colors hover:text-[#7cc0ff]">เข้าสู่ระบบ</a></li>
          <li><a href="/ทางเข้า/" class="transition-colors hover:text-[#7cc0ff]">ทางเข้า</a></li>
          <li><a href="/ทดลองเล่น/" class="transition-colors hover:text-[#7cc0ff]">ทดลองเล่น</a></li>
          <li><a href="/วิธีฝากถอน/" class="transition-colors hover:text-[#7cc0ff]">วิธีฝากถอน</a></li>
          <li><a href="/about-us/" class="transition-colors hover:text-[#7cc0ff]">เกี่ยวกับเรา</a></li>
          <li><a href="/contact-us/" class="transition-colors hover:text-[#7cc0ff]">ติดต่อเรา</a></li>
        </ul>
      </nav>

      <div class="flex flex-col gap-5 md:col-span-4">
        <p class="text-lg font-black tracking-widest text-[#eaf4ff] uppercase drop-shadow-sm">ฝ่ายดูแลสมาชิก</p>
        <div aria-hidden="true" class="h-[1px] w-12 bg-[#2f8cff]"></div>

        <a
          href="/line/"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] py-3.5 font-bold text-white shadow-[0_5px_15px_rgba(0,185,0,0.3)] transition-all hover:-translate-y-1 hover:shadow-[0_8px_20px_rgba(0,185,0,0.4)]">
          ติดต่อแอดมิน LINE
        </a>

        {
          BRAND_ADDRESS.lines.length > 0 && (
            <address aria-label={BRAND_ADDRESS.label} class="mt-2 rounded-xl border border-white/15 bg-black/20 p-4 text-xs leading-relaxed not-italic opacity-90">
              <p class="mb-2 flex items-center gap-2 text-[11px] font-bold tracking-wider uppercase opacity-80">
                <span aria-hidden="true" class="text-sm">📍</span>
                {BRAND_ADDRESS.label}
              </p>
              {BRAND_ADDRESS.lines.map((line) => (
                <span class="block">{line}</span>
              ))}
              {BRAND_ADDRESS.email && (
                <a href={`mailto:${BRAND_ADDRESS.email}`} class="mt-3 inline-flex items-center gap-2 font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                  <span aria-hidden="true" class="text-sm">✉️</span>
                  {BRAND_ADDRESS.email}
                </a>
              )}
            </address>
          )
        }

        <div class="mt-4 text-xs font-medium tracking-widest text-[#d6e4ff]/60 uppercase">ช่องทางฝากถอนที่รองรับ</div>
        <BankStrip size={30} />
      </div>
    </div>

    <div class="flex flex-col items-center justify-between border-t border-[#16357a] pt-8 text-xs font-medium tracking-wide text-[#d6e4ff]/55 md:flex-row">
      <p>COPYRIGHT &copy; {new Date().getFullYear()} {BRAND_NAME}. ALL RIGHTS RESERVED.</p>
      <div class="mt-4 flex gap-4 md:mt-0">
        <a href="/terms/" class="transition-colors hover:text-[#7cc0ff]">TERMS &amp; CONDITIONS</a>
        <a href="/privacy/" class="transition-colors hover:text-[#7cc0ff]">PRIVACY POLICY</a>
      </div>
    </div>
  </div>
</footer>
