---
import ContentBoxTwo from "./ContentBoxTwo.astro";

const steps = [
  { icon: "📝", name: "สมัครยูสเองจากหน้าเว็บ", detail: "กรอกข้อมูลพื้นฐานไม่กี่ช่อง รับยูสเซอร์เนมได้ภายในไม่กี่วินาที ไม่ต้องรอเจ้าหน้าที่อนุมัติ", tag: "ขั้นที่ 1" },
  { icon: "💰", name: "ฝากเงินเล่นแบบไม่มีขั้นต่ำ", detail: "ทำรายการผ่านระบบออโต้ ทุนหลักสิบหลักร้อยก็เริ่มได้ เครดิตเข้าทันทีโดยไม่ต้องส่งสลิป", tag: "ขั้นที่ 2" },
  { icon: "🎰", name: "เลือกเกมลิขสิทธิ์แท้จากค่ายโดยตรง", detail: "ทุกเกมเดินตามค่า RTP ต้นฉบับของค่าย ไม่มีล็อกยูส และไม่มีการปรับจูนระบบหลังบ้าน", tag: "ขั้นที่ 3" },
  { icon: "🤖", name: "ให้ AI ช่วยสรุปจังหวะเกม", detail: "ระบบอ่านรูปแบบการออกฟีเจอร์และความถี่ของโบนัสแบบเรียลไทม์ แล้วสรุปเป็นสัญญาณเชิงแนวโน้ม", tag: "ขั้นที่ 4" },
  { icon: "⚡", name: "ถอนเงินเองได้ตลอด 24 ชั่วโมง", detail: "ระบบออโต้ประมวลผลรายการทันที ไม่ต้องผ่านคนกลาง ยอดเข้าบัญชีครบตามที่ทำรายการไว้", tag: "ขั้นที่ 5" },
];

const chips = ["เว็บตรงลิขสิทธิ์แท้", "ไม่ผ่านเอเย่นต์", "ไม่มีล็อกยูส", "สมัครออโต้", "ฝากไม่มีขั้นต่ำ", "ถอนออโต้", "ตลอด 24 ชั่วโมง", "AI อ่านจังหวะเกม", "RTP ต้นฉบับ", "ระบบนิ่ง"];
---

<ContentBoxTwo titleleft="เข้าสู่ระบบ TOPGAMEVIP" titleright="ลำดับการใช้งานตั้งแต่สมัครถึงถอนยอด" label="เข้าสู่ระบบ TOPGAMEVIP และลำดับการใช้งานตั้งแต่สมัครถึงถอนยอด">
  <div slot="left" class="flex h-full flex-col gap-4">
    <div class="relative overflow-hidden rounded-2xl border border-[#f6c9c6] bg-[#fff7f6] p-6 shadow-[0_10px_30px_rgba(230,0,18,0.12)]">
      <div aria-hidden="true" class="pointer-events-none absolute -top-10 -right-10 h-32 w-32 rounded-full bg-[#e60012]/12 blur-[50px]"></div>

      <div class="relative z-10 mb-5 flex items-center gap-3">
        <span
          aria-hidden="true"
          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#b30009]/40 bg-gradient-to-br from-[#ff4b41] via-[#e60012] to-[#b30009] text-xl shadow-inner">
          🎰
        </span>
        <div class="flex flex-col">
          <p class="text-base font-black text-[#8a0208]">ล็อกอินแล้วจัดการทุกขั้นตอนได้ด้วยตัวเอง</p>
          <span class="text-[11px] text-[#6f4b4d]">
            ยูสเดียวเข้าได้ทั้งสล็อตลิขสิทธิ์แท้และโต๊ะสด ยอดฝากถอนเดินผ่านระบบออโต้ชุดเดียวกัน ตรวจเครดิตคงเหลือ ดูสถานะรายการ และย้อนดูประวัติการทำรายการได้จากหน้าเมมเบอร์
          </span>
        </div>
      </div>

      <div class="relative z-10 flex flex-col gap-3.5">
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#e60012]">👤</span>
          <input
            type="text"
            placeholder="เบอร์โทรศัพท์ / ยูสเซอร์เนม"
            class="w-full rounded-xl border border-[#f6c9c6] bg-white py-3 pr-4 pl-12 text-[#2d1214] transition-all outline-none placeholder:text-[#6f4b4d] focus:border-[#e60012] focus:ring-1 focus:ring-[#e60012]/40"
          />
        </div>
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#e60012]">🔑</span>
          <input
            type="password"
            placeholder="รหัส PIN 4 หลัก"
            class="w-full rounded-xl border border-[#f6c9c6] bg-white py-3 pr-4 pl-12 text-[#2d1214] transition-all outline-none placeholder:text-[#6f4b4d] focus:border-[#e60012] focus:ring-1 focus:ring-[#e60012]/40"
          />
        </div>

        <div class="flex items-center justify-between px-1 text-xs">
          <label class="flex items-center gap-2 text-[#6f4b4d]">
            <input type="checkbox" class="h-3.5 w-3.5 rounded border-[#f6c9c6] bg-white accent-[#e60012]" />
            จดจำฉันไว้
          </label>
          <a href="/login/" class="text-[#6f4b4d] transition-colors hover:text-[#8a0208]">ลืมรหัส PIN?</a>
        </div>

        <button
          class="mt-1 w-full rounded-xl border border-[#b30009]/40 bg-gradient-to-r from-[#ff4b41] via-[#e60012] to-[#b30009] p-3.5 font-black text-white shadow-[0_10px_30px_rgba(230,0,18,0.28)] transition-all hover:scale-[1.02] hover:shadow-[0_15px_40px_rgba(230,0,18,0.36)]">
          เข้าสู่ระบบ
        </button>

        <div class="flex items-center gap-3 py-1 text-[11px] text-[#6f4b4d]">
          <span class="h-px flex-1 bg-[#f6c9c6]"></span>
          หรือ
          <span class="h-px flex-1 bg-[#f6c9c6]"></span>
        </div>

        <a
          href="/line/"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] p-3 text-sm font-bold text-white shadow-md transition-all hover:scale-[1.02]">
          <span aria-hidden="true">💬</span> ทักไลน์ทีมงานตลอด 24 ชั่วโมง
        </a>

        <div class="mt-1 flex items-center justify-between px-1">
          <div class="flex gap-2">
            <span class="rounded-full border border-[#f6c9c6] bg-white px-2.5 py-1 text-[10px] font-bold text-[#8a0208]"><span aria-hidden="true">🔒</span> เข้ารหัสข้อมูล</span>
            <span class="rounded-full border border-[#8a6410]/40 bg-[#ffe9a8]/60 px-2.5 py-1 text-[10px] font-bold text-[#8a6410]"><span aria-hidden="true">🕐</span> ใช้งานได้ตลอด 24 ชม.</span>
          </div>
          <a href="/register/" class="text-xs font-bold text-[#6f4b4d] transition-colors hover:text-[#8a0208]">สมัครสมาชิกใหม่</a>
        </div>
      </div>
    </div>
  </div>

  <div slot="right" class="h-full">
    <div class="flex h-full flex-col rounded-2xl border border-[#f6c9c6] bg-[#fff7f6] p-5 shadow-[0_10px_30px_rgba(230,0,18,0.12)]">
      <div class="mb-5 flex items-center justify-between gap-3">
        <div>
          <span class="text-xs font-bold tracking-wide text-[#6f4b4d]">ลำดับการใช้งานที่ TOPGAMEVIP วางไว้ ตั้งแต่เปิดยูสจนถอนยอดออก อยู่ในระบบออโต้ชุดเดียวกันทั้งหมด</span>
          <div class="bg-gradient-to-r from-[#8a0208] via-[#e60012] to-[#8a6410] bg-clip-text text-2xl font-black text-transparent sm:text-3xl">สมัคร • ฝาก • เล่น • ถอน</div>
        </div>
        <span class="flex items-center gap-1.5 self-start rounded-full border border-green-600/40 bg-green-50 px-2.5 py-1">
          <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-green-600 shadow-[0_0_8px_rgba(22,163,74,0.6)]"></span>
          <span class="text-[10px] font-bold tracking-widest text-green-700 uppercase">Live</span>
        </span>
      </div>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#6f4b4d] uppercase">
        <span>ขั้นตอนการใช้งาน</span>
        <span>ลำดับ</span>
      </div>

      <div class="flex flex-1 flex-col gap-2.5">
        {
          steps.map((s) => (
            <div class="rounded-xl border border-[#f6c9c6] bg-white px-3.5 py-2.5 transition-colors hover:border-[#e60012]/45 hover:bg-[#ffe9e7]">
              <div class="flex items-center justify-between gap-2 text-sm">
                <span class="flex min-w-0 items-center gap-2 font-bold text-[#2d1214]">
                  <span aria-hidden="true" class="w-5 shrink-0 text-center">
                    {s.icon}
                  </span>{" "}
                  <span class="truncate">{s.name}</span>
                </span>
                <span class="shrink-0 rounded-full border border-[#8a6410]/40 bg-[#ffe9a8]/60 px-2.5 py-0.5 text-[10px] font-bold text-[#8a6410]">{s.tag}</span>
              </div>
              <div class="mt-1.5 text-[11px] tracking-wide text-[#6f4b4d]">{s.detail}</div>
            </div>
          ))
        }
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
        {chips.map((c) => <span class="rounded-full border border-[#f6c9c6] bg-white px-3 py-1 text-[10px] font-bold text-[#8a0208]">{c}</span>)}
      </div>

      <div class="mt-3 text-center text-[10px] tracking-wide text-[#6f4b4d]">
        ลำดับในตารางสรุปจากที่หน้าเว็บแสดงไว้ รายละเอียดของค่ายเกม เงื่อนไขการทำรายการ และบริการที่เปิดใช้งานจริงให้ยึดตามหน้าเมมเบอร์ของ TOPGAMEVIP ก่อนทำรายการทุกครั้ง และอย่าบอกรหัสผ่านหรือ OTP
        กับใคร หากติดขัดตรงไหนทักไลน์ทีมงานได้ตลอด 24 ชั่วโมง
      </div>
    </div>
  </div>
</ContentBoxTwo>
