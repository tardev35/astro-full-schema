---
import { Picture } from "astro:assets";
import { BRAND_NAME } from "../lib/brandProfile";
import imgPg from "../assets/providers/game1.avif";
import imgJoker from "../assets/providers/game4.avif";
import imgJili from "../assets/providers/game5.avif";
import imgPp from "../assets/providers/game6.avif";

const games = [
  {
    name: "Treasures of Aztec",
    provider: "PG Soft",
    fit: "เหมาะกับคนชอบลุ้นยาวในรอบฟรีสปิน",
    mechanics: ["ฟรีสปิน", "ตัวคูณขยับตามคอมโบ"],
    img: imgPg,
    alt: "โลโก้ PG Pocket Games Soft กับตัวละครสาวสวมมงกุฎขนนกและเพื่อนร่วมเกม",
  },
  {
    name: "Sweet Bonanza",
    provider: "Pragmatic Play",
    fit: "เหมาะกับคนทุนพร้อมที่อยากกดซื้อฟรีสปิน",
    mechanics: ["สัญลักษณ์ร่วงหล่น", "ลูกระเบิดตัวคูณ", "ซื้อฟรีสปิน"],
    img: imgPp,
    alt: "โลโก้ PP Slot กับเทพเจ้าเคราขาวถือสายฟ้า",
  },
  {
    name: "Fortune Gems",
    provider: "JILI",
    fit: "รอบเดินไว เหมาะกับคนที่เล่นทีละช่วงสั้น",
    mechanics: ["3 รีล", "วงล้อตัวคูณด้านขวา"],
    img: imgJili,
    alt: "โลโก้ JILI กับนักรบชุดทองถือขวานพู่สี",
  },
  {
    name: "Roma",
    provider: "Joker Gaming",
    fit: "เล่นง่าย เหมาะกับคนเพิ่งเริ่ม",
    mechanics: ["คลาสสิก", "โบนัสพิเศษระหว่างปั่น"],
    img: imgJoker,
    alt: "โลโก้ JOKER กับนักรบสวมหมวกเหล็กหน้าโคลอสเซียม",
  },
];

const boardTitle = `เทียบกลไกเกมสล็อตก่อนเลือกเล่นกับ ${BRAND_NAME}`;
---

<section aria-label={boardTitle} class="mx-auto w-full max-w-[1300px] px-4 py-8 font-sans">
  <div class="mb-6 flex w-full flex-col items-center justify-center gap-2 text-center">
    <span aria-hidden="true" class="text-2xl">🎰</span>
    <p class="text-2xl leading-normal font-black tracking-wide text-white">{boardTitle}</p>
    <div aria-hidden="true" class="mt-2 h-[3px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#f5c542] to-transparent"></div>
  </div>

  <p class="mb-6 text-left text-base leading-relaxed text-[#ead9ec]">
    แต่ละแถวสรุปกลไกหลักของเกมจากค่ายที่ {BRAND_NAME} รวมไว้ในเว็บเดียว ดูว่ารอบฟรีสปินเข้าแบบไหน ตัวคูณทำงานตอนไหน และซื้อฟีเจอร์ได้หรือไม่ แล้วเลือกแนวที่เข้ามือตัวเอง
  </p>

  <div class="flex flex-col gap-3">
    {
      games.map((g) => (
        <article class="group relative flex items-center gap-3 overflow-hidden rounded-2xl border border-[#5a1a60] bg-[#1c0620] p-3 shadow-[0_10px_30px_rgba(0,0,0,0.3)] transition-all duration-300 hover:-translate-y-0.5 hover:border-[#8a2f8f] hover:bg-[#26082c] hover:shadow-[0_15px_40px_rgba(193,63,196,0.22)] sm:gap-5 sm:p-4">
          <span aria-hidden="true" class="absolute inset-y-0 left-0 w-1 bg-gradient-to-b from-[#e061e3] to-[#9c2193] opacity-80 transition-opacity duration-300 group-hover:opacity-100" />

          <div class="relative h-14 w-14 shrink-0 overflow-hidden rounded-xl border border-[#5a1a60] sm:h-16 sm:w-16">
            <Picture
              src={g.img}
              alt={g.alt}
              formats={["avif", "webp"]}
              fallbackFormat="webp"
              loading="lazy"
              fetchpriority="low"
              widths={[100, 200]}
              quality={60}
              sizes="(max-width: 640px) 56px, 64px"
              decoding="async"
              class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-110"
            />
          </div>

          <div class="min-w-0 flex-1">
            <div class="flex flex-wrap items-center gap-2">
              <p class="text-base font-black text-white sm:text-lg">{g.name}</p>
              <span class="shrink-0 rounded-full bg-gradient-to-b from-[#ffe08a] via-[#f5c542] to-[#b07d12] px-2 py-0.5 text-[10px] font-black tracking-wider text-[#3a0535]">{g.provider}</span>
            </div>
            <p class="text-xs text-[#c9a8cc]">{g.fit}</p>

            <div class="mt-2 flex flex-wrap items-center gap-1.5">
              {g.mechanics.map((m) => (
                <span class="rounded-full border border-[#5a1a60] bg-[#31103a] px-2.5 py-0.5 text-[11px] font-bold text-[#ffe08a]">{m}</span>
              ))}
            </div>
          </div>

          <a
            href="/register/"
            class="hidden shrink-0 rounded-full bg-gradient-to-b from-[#e061e3] to-[#9c2193] px-4 py-1.5 text-xs font-black text-white shadow-[0_10px_30px_rgba(193,63,196,0.35)] transition-transform hover:scale-105 sm:inline-block">
            สมัครเข้าเล่น
          </a>
        </article>
      ))
    }
  </div>
</section>
