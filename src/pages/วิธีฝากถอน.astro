---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement6.astro";
import { pageGraph } from "../lib/schema";

const pageTitle = "วิธีฝากถอน TGA99 ระบบออโต้ ฝากเริ่ม 20 บาท ถอนเองได้ 24 ชม. ไม่ต้องส่งสลิป";

const pageHeading = "วิธีฝากถอน TGA99 ผ่านระบบออโต้ ทำรายการเองได้จากมือถือตลอด 24 ชม.";

const pageDescription =
  "วิธีฝากถอน TGA99 ระบบออโต้ ฝากขั้นต่ำ 20 บาท ถอนขั้นต่ำ 50 บาท รองรับทุกธนาคารและ TrueMoney Wallet เครดิตขึ้นในไม่กี่วินาที ไม่ต้องส่งสลิป กดถอนเองได้ 24 ชม.";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "วิธีฝากถอน", path: "/วิธีฝากถอน" },
  ],
});

const linkClass = "font-bold text-[#ffe08a] underline underline-offset-4 transition-colors hover:text-[#f5c542]";
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox as="h1" title={pageHeading}>
    <p class="mb-4 text-left text-base leading-relaxed">
      ฝากถอนของ <strong class="text-[#ffe08a]">TGA99</strong> เป็นระบบออโต้ทั้งขาเข้าและขาออก ทุนน้อยหรือทุนหนาใช้ระบบชุดเดียวกัน ทำรายการเองได้จากมือถือ ไม่ต้องแคปสลิปส่งแชต และไม่ต้องรอแอดมินกดให้ครับ
    </p>

    <ul class="flex flex-col gap-2 text-left text-base leading-relaxed">
      <li class="rounded-xl border border-[#5a1a60] bg-[#31103a] px-4 py-3">
        <strong class="text-[#ffe08a]">ช่องทาง:</strong> ทุกธนาคาร และ TrueMoney Wallet (ทรูวอเลท) ใช้ได้ทั้งตอนฝากและตอนถอน
      </li>
      <li class="rounded-xl border border-[#5a1a60] bg-[#31103a] px-4 py-3">
        <strong class="text-[#ffe08a]">ขั้นต่ำ:</strong> ฝาก 20 บาท ถอน 50 บาท
      </li>
      <li class="rounded-xl border border-[#5a1a60] bg-[#31103a] px-4 py-3">
        <strong class="text-[#ffe08a]">เวลา:</strong> เครดิตขึ้นเองในไม่กี่วินาที กดถอนเองได้ตลอด 24 ชั่วโมง ไม่ต้องส่งสลิป
      </li>
    </ul>
  </ContentBox>

  <ContentBox as="h2" title="ฝากเงินเข้า TGA99 เริ่ม 20 บาท เครดิตขึ้นเองไม่ต้องส่งสลิป">
    <p class="mb-4 text-left text-base leading-relaxed">
      <a href="/login/" class={linkClass}>เข้าสู่ระบบ</a> แล้วเลือกฝาก จะโอนจากแอปธนาคารหรือเติมผ่าน TrueMoney Wallet ก็ได้ ยอดฝากขั้นต่ำคือ 20 บาท ก่อนกดยืนยันให้ตรวจยอดเงินที่จะโอนอีกครั้งครับ
    </p>

    <p class="mb-4 text-left text-base leading-relaxed">
      พอยอดเข้า ระบบจะปรับเครดิตให้เองภายในไม่กี่วินาที ไม่ต้องแคปสลิปส่งให้แอดมิน และไม่ต้องทักใครช่วยดันรายการ เครดิตขึ้นแล้วเปิดเกมต่อได้เลย
    </p>

    <p class="text-left text-base leading-relaxed">ลองฝากก้อนเล็กสักครั้ง จะเห็นจังหวะของระบบด้วยตาตัวเองมากกว่าอ่านคำอธิบายไหน</p>
  </ContentBox>

  <ContentBox as="h2" title="ถอนเงินขั้นต่ำ 50 บาท กดเองได้ตลอด 24 ชั่วโมง ไม่ต้องผ่านแอดมิน">
    <p class="mb-4 text-left text-base leading-relaxed">
      ขาถอนก็ทำเองเหมือนกัน ใส่ยอดตั้งแต่ 50 บาทขึ้นไปแล้วกดยืนยัน กดได้ทั้ง 24 ชั่วโมง ถอนตอนตีสามก็ไม่ต้องรอแอดมินตื่น ระบบทำรายการให้เองครับ
    </p>

    <p class="mb-4 text-left text-base leading-relaxed">
      ถ้ารับโปรไว้ ให้เปิด<a href="/promotion/" class={linkClass}>หน้าโปรโมชั่น</a>ดูเงื่อนไขของโปรตัวนั้นก่อนกดถอน ว่าต้องทำเทิร์นก่อนถอนหรือเปล่า จะได้ไม่งงว่าทำไมยอดในเครดิตยังถอนไม่ได้
    </p>

    <p class="text-left text-base leading-relaxed">บิลเล็กหรือบิลใหญ่ใช้กติกาการถอนชุดเดียวกัน ตัวเลขที่กดถอนคือตัวเลขที่เข้าบัญชี</p>
  </ContentBox>

  <ContentBox as="h2" title="โอนแล้วเครดิตยังไม่ขึ้น อย่าเพิ่งโอนซ้ำ จดเวลากับยอดแล้วทักแอดมิน">
    <p class="mb-4 text-left text-base leading-relaxed">
      ถ้าโอนแล้วเครดิตยังไม่ขึ้น อย่าเพิ่งโอนซ้ำ จดเวลาที่โอนกับยอดเงินไว้ แล้วทักแอดมินทาง <a href="/line/" class={linkClass}>LINE Official</a> หรือช่องทางในหน้า <a href="/contact-us/" class={linkClass}>ติดต่อเรา</a> พร้อมชื่อยูส
    </p>

    <p class="mb-4 text-left text-base leading-relaxed">
      รายการที่ข้อมูลครบจะตามเจอไวกว่า แอดมินของ TGA99 รับเคสตลอด 24 ชั่วโมง และไม่ต้องส่งรหัสผ่านหรือ OTP ให้ใครทั้งนั้น ทีมงานตัวจริงไม่มีเหตุให้ต้องขอสองอย่างนี้ครับ
    </p>

    <p class="text-left text-base leading-relaxed">โอนซ้ำเพราะใจร้อนหนึ่งครั้ง อาจต้องตามเงินสองก้อนแทนก้อนเดียว</p>
  </ContentBox>

  <ContentBox as="h2" title="ช่องทางที่รองรับ ทุกธนาคารและ TrueMoney Wallet ทั้งขาฝากและขาถอน">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed">
        TGA99 รับทุกธนาคาร และรับ TrueMoney Wallet (ทรูวอเลท) ด้วย ทั้งสองช่องทางเปิดให้ใช้ทั้งขาฝากและขาถอน เลือกช่องทางที่ตัวเองใช้อยู่ทุกวันได้เลยครับ
      </p>

      <p class="text-left text-base leading-relaxed">
        ทุกขั้นตอนทำบนมือถือได้ครบ ทั้ง iOS และ Android ผ่านเบราว์เซอร์โดยไม่ต้องโหลดแอปเพิ่ม โอนเสร็จในแอปธนาคารหรือวอเลทแล้ว สลับกลับมาที่หน้าเว็บก็เล่นต่อได้เลย
      </p>

      <div class="flex flex-col items-center justify-center gap-4 pt-4 sm:flex-row">
        <a
          href="/login/"
          class="inline-flex w-full max-w-[320px] items-center justify-center gap-2 rounded-xl bg-gradient-to-b from-[#e061e3] to-[#9c2193] px-8 py-3.5 text-lg font-black tracking-wide text-white shadow-[0_10px_30px_rgba(193,63,196,0.35)] transition duration-300 hover:scale-105 hover:brightness-110">
          <span aria-hidden="true">💳</span> เข้าสู่ระบบเพื่อฝากถอน
        </a>

        <a
          href="/register/"
          class="inline-flex w-full max-w-[320px] items-center justify-center gap-2 rounded-xl border-2 border-[#f5c542] bg-[#31103a] px-8 py-3.5 text-lg font-bold tracking-wide text-[#ffe08a] transition-colors duration-300 hover:bg-[#3a0535]">
          สมัครสมาชิก TGA99
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
