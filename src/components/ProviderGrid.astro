---
const providers = [
  { name: "บาคาร่าออนไลน์", desc: "เลือกโต๊ะ ดูวงเงิน และเข้าเดิมพันจากหน้าจอเดียว โต๊ะถูกจัดเป็นหมวดให้เทียบรูปแบบเกมได้ง่าย", tag: "หมวดหลัก", icon: "🎴" },
  { name: "สล็อตเว็บตรง", desc: "มีทั้งเกมคลาสสิก เกมโบนัส และเกมใหม่ที่ออกแบบมาสำหรับมือถือ เลือกตามค่าย ธีม หรือฟรีสปินที่ชอบ", tag: "หมวดหลัก", icon: "🎰" },
  { name: "คาสิโนสด", desc: "หมวดโต๊ะถ่ายทอดสดที่ช่วยให้ตัวเลือกในบัญชีเดียวครบขึ้น สลับเข้าออกจากหน้าเดิมได้เลย", tag: "เพิ่มตัวเลือก", icon: "🃏" },
  { name: "กีฬา", desc: "หมวดสำหรับคนที่อยากพักจากเกมสล็อตไปดูกีฬา ใช้เครดิตและบัญชีชุดเดียวกับหมวดอื่น", tag: "สลับหมวดได้", icon: "⚽" },
  { name: "เกมใหม่บนมือถือ", desc: "เกมที่ออกแบบมาสำหรับจอเล็ก เปิดผ่านเบราว์เซอร์ได้โดยไม่ต้องโหลดโปรแกรมเพิ่ม", tag: "ปี 2026", icon: "📱" },
  { name: "ฝากถอนออโต้", desc: "เติมเครดิต ถอนเงิน และดูสถานะรายการผ่านหน้าบัญชี ทำรายการได้ตามเวลาที่สะดวก", tag: "ตลอด 24 ชม.", icon: "🔁" },
  { name: "ทางเข้าทุกอุปกรณ์", desc: "รองรับโทรศัพท์ แท็บเล็ต และคอมพิวเตอร์ ใช้บัญชีเดิมเข้าสู่ระบบได้ทุกเครื่อง", tag: "บัญชีเดิม", icon: "🧭" },
];
---

<section aria-label="หมวดเกมและบริการที่ WINNOW168 รวมไว้ในบัญชีเดียว" class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#ff5a5f] via-[#e01e26] to-[#f5c542] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      หมวดเกมและบริการที่ <span class="text-[#f5c542]">WINNOW168</span> รวมไว้ในบัญชีเดียว
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#e01e26] to-transparent"></div>
  </div>

  <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4 lg:gap-5 xl:grid-cols-7">
    {
      providers.map((provider) => (
        <a
          href="/register"
          class="group relative flex flex-col items-center justify-center overflow-hidden rounded-2xl border border-[#f5c542]/25 bg-[#170707]/92 p-5 shadow-[0_10px_30px_rgba(10,4,3,0.55)] backdrop-blur-md transition-all duration-300 hover:-translate-y-2 hover:border-[#f5c542]/55 hover:bg-[#210a08]/95 hover:shadow-[0_15px_40px_rgba(224,30,38,0.30)]">
          <div class="pointer-events-none absolute inset-0 bg-[#6e0709]/35 opacity-0 transition-opacity duration-300 group-hover:opacity-100" />

          <div class="absolute top-2 right-2 z-10 rounded-full bg-gradient-to-r from-[#ffdf8a] via-[#f5c542] to-[#8a5a12] px-2 py-0.5 text-[9px] font-black tracking-wide whitespace-nowrap text-[#1a0202] shadow-sm transition-transform duration-300 group-hover:scale-110">
            {provider.tag}
          </div>

          <div aria-hidden="true" class="mb-3 text-4xl transition-transform duration-300 group-hover:scale-125 group-hover:rotate-3">
            {provider.icon}
          </div>
          <p class="text-center text-sm font-black text-[#f2dede] transition-colors group-hover:text-[#ffdf8a]">{provider.name}</p>
          <p class="mt-1 text-center text-[10px] text-[#f2dede]/70">{provider.desc}</p>

          <span class="relative z-10 mt-4 block w-full rounded-full border border-[#f5c542]/25 bg-[#0a0403] py-1.5 text-center text-[11px] font-bold text-[#f5c542] shadow-inner transition-colors duration-300 group-hover:border-[#f5c542]/50 group-hover:bg-gradient-to-r group-hover:from-[#ff5a5f] group-hover:via-[#e01e26] group-hover:to-[#a20d12] group-hover:text-[#1a0202]">
            เข้าดูหมวดนี้
          </span>
        </a>
      ))
    }
  </div>
</section>
