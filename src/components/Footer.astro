---
import { Picture } from "astro:assets";

const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.*", { eager: true });
const imagePaths = Object.keys(images);
const targetPath = imagePaths.find((path) => path.endsWith(".webp")) || imagePaths.find((path) => path.endsWith(".png")) || (imagePaths.length > 0 ? imagePaths[0] : null);
const mainLogo = targetPath ? images[targetPath].default : null;
---

<footer class="relative mt-12 w-full overflow-hidden rounded-t-[3rem] border-t-2 border-red-600 bg-[#050505] pt-16 pb-8 font-sans text-white shadow-[0_-10px_30px_rgba(220,38,38,0.15)]">
  <!-- รัศมีแสงสีแดงจางๆ หนุนหลัง -->
  <div class="pointer-events-none absolute inset-x-0 -top-20 mx-auto h-[200px] w-full max-w-4xl rounded-full bg-red-700/10 blur-[80px]"></div>

  <div class="relative z-10 mx-auto w-full max-w-[1400px] px-6">
    <div class="mb-12 grid grid-cols-1 gap-12 md:grid-cols-12">
      <!-- โลโก้และข้อมูลเว็บ -->
      <div class="flex flex-col gap-4 md:col-span-5">
        <a href="/" class="inline-block max-w-max rounded-xl border border-red-600/30 bg-white px-4 py-2 transition-transform duration-300 hover:scale-105">
          {
            mainLogo ? (
              <Picture src={mainLogo} alt="SUMOHENG" class="h-[50px] w-auto object-contain" formats={["avif", "webp"]} fallbackFormat="webp" />
            ) : (
              <h2 class="text-3xl font-black tracking-widest text-[#0a0a0a]">
                SUMO<span class="text-red-600">HENG</span>
              </h2>
            )
          }
        </a>
        <p class="mt-2 border-l-2 border-red-600 pl-4 text-sm leading-relaxed text-gray-400">
          เว็บไซต์ทางการ SUMOHENG สล็อตเว็บตรงค่ายใหญ่ อันดับ 1 ในเอเชีย รวบรวมเกมสล็อตแตกง่าย คาสิโนสด กีฬา และหวย ไว้ในที่เดียว ระบบออโต้ ฝาก-ถอนรวดเร็ว ปลอดภัย 100%
        </p>
        <div class="mt-2 flex gap-3">
          <span class="rounded-sm border border-red-500/30 bg-red-900/40 px-3 py-1 text-[10px] font-bold text-red-400">100% SECURE</span>
          <span class="rounded-sm border border-yellow-500/30 bg-yellow-500/10 px-3 py-1 text-[10px] font-bold text-yellow-400">OFFICIAL PARTNER</span>
        </div>
      </div>

      <!-- เมนู -->
      <nav class="flex flex-col gap-4 md:col-span-3 lg:pl-12">
        <h3 class="border-b border-red-600/30 pb-2 text-base font-black tracking-widest text-white uppercase">ทางลัด</h3>
        <ul class="flex flex-col gap-3 text-sm font-medium text-gray-400">
          <li><a href="/" class="flex items-center gap-2 transition-colors hover:text-red-500"><span class="text-red-600">▸</span> หน้าแรก</a></li>
          <li><a href="/slot" class="flex items-center gap-2 transition-colors hover:text-red-500"><span class="text-red-600">▸</span> สล็อตออนไลน์</a></li>
          <li><a href="/promotion" class="flex items-center gap-2 transition-colors hover:text-red-500"><span class="text-red-600">▸</span> โปรโมชั่น</a></li>
          <li><a href="/register" class="flex items-center gap-2 transition-colors hover:text-red-500"><span class="text-red-600">▸</span> สมัครสมาชิก</a></li>
        </ul>
      </nav>

      <!-- บริการลูกค้า -->
      <div class="flex flex-col gap-4 md:col-span-4">
        <h3 class="border-b border-red-600/30 pb-2 text-base font-black tracking-widest text-white uppercase">บริการลูกค้า 24 ชม.</h3>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-md bg-gradient-to-r from-green-600 to-green-500 py-3 text-sm font-black text-white shadow-md transition-all hover:scale-[1.02]">
          💬 ติดต่อแอดมิน (LINE)
        </a>

        <div class="mt-2 text-xs font-bold text-gray-500">รองรับทุกธนาคารและทรูมันนี่วอเลท:</div>
        <div class="flex flex-wrap gap-2 opacity-80">
          <div class="rounded border border-white/5 bg-white/10 px-2 py-1 font-mono text-[10px]">KBANK</div>
          <div class="rounded border border-white/5 bg-white/10 px-2 py-1 font-mono text-[10px]">SCB</div>
          <div class="rounded border border-white/5 bg-white/10 px-2 py-1 font-mono text-[10px]">KTB</div>
          <div class="rounded border border-white/5 bg-white/10 px-2 py-1 font-mono text-[10px]">TRUE WALLET</div>
        </div>
      </div>
    </div>

    <!-- ลิขสิทธิ์ -->
    <div class="flex flex-col items-center justify-between border-t border-white/10 pt-6 text-xs font-medium text-gray-500 md:flex-row">
      <p>COPYRIGHT &copy; {new Date().getFullYear()} SUMOHENG.COM. ALL RIGHTS RESERVED.</p>
      <div class="mt-3 flex gap-4 md:mt-0">
        <a href="/" class="transition-colors hover:text-white">เงื่อนไขข้อตกลง</a>
        <a href="/" class="transition-colors hover:text-white">นโยบายความเป็นส่วนตัว</a>
      </div>
    </div>
  </div>
</footer>
<style>
  .font-sans {
    font-family: "Kanit", sans-serif;
  }
</style>
