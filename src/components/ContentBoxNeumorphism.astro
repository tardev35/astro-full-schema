---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";
---

<section class="relative z-10 my-6 flex w-full justify-center px-4 font-sans">
  <div
    class="w-full max-w-[1400px] rounded-[25px] border border-[#0a4a2e]/70 bg-[#0f1d16] p-8 text-left text-base leading-relaxed text-[#f1e6d3] shadow-[10px_10px_20px_#091310,-10px_-10px_20px_#12251b]">
    {
      title && (
        <header class="mb-8 border-b border-[#e8a13c]/25 pb-4 text-center">
          <HeadingTag class={`bg-gradient-to-r from-[#f7cf8a] via-[#e8a13c] to-[#0f8f57] bg-clip-text ${headingSize} leading-normal font-black tracking-wide text-transparent`}>{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
