---
import MainLayout from "../layouts/MainLayout.astro";
import AnnouncementHuay from "../components/AnnouncementHuay.astro";
import Navfoot from "../components/Navfoot.astro";

const tips = [
  { title: "แนวทางหวยรัฐบาล งวด 30 ก.ค.", desc: "เลขเด็ดพญาเต่างอย งวดนี้มาแรงมาก ฟันธงเน้นๆ รวยแน่นอน!", type: "หวยรัฐบาล", date: "วันนี้", hot: true },
  { title: "เจาะเลขฮานอยพิเศษ", desc: "วิเคราะห์สูตรฮานอยแม่นๆ เข้ามาแล้ว 3 งวดติด ด่วนก่อนเลขอั้น", type: "หวยฮานอย", date: "วันนี้", hot: true },
  { title: "สูตรหวยลาว แม่น้ำหนึ่ง", desc: "เลขธูปปู่ 3 ตัวตรงๆ จดไว้เลยงวดนี้ห้ามพลาด", type: "หวยลาว", date: "เมื่อวาน", hot: false },
  { title: "รวมเลขเด็ด สำนักดัง", desc: "สรุปเลขเด็ดจาก 5 สำนักดังทั่วไทย มัดรวมไว้ให้ที่นี่ที่เดียว", type: "ข่าวสาร", date: "เมื่อวาน", hot: false },
  { title: "เทคนิคแทงยี่กีให้ได้กำไร", desc: "สอนสูตรเดินเงินยี่กี ทุนน้อยก็ปั้นบวกได้ทุกวัน 88 รอบ", type: "เทคนิค", date: "2 วันที่แล้ว", hot: false },
  { title: "แนวทางหุ้นนิเคอิ เช้า-บ่าย", desc: "วิเคราะห์กราฟหุ้นต่างประเทศ พร้อมเลขเด่นรูด 19 ประตู", type: "หวยหุ้น", date: "2 วันที่แล้ว", hot: false },
];
---

<MainLayout title="LOT888 | แนวทางหวย เลขเด็ด เลขดัง อัปเดตทุกวัน">
  <AnnouncementHuay message="🔮 แหล่งรวมเลขเด็ด สำนักดัง แนวทางหวยรัฐบาล ฮานอย ลาว แม่นที่สุด อัปเดตใหม่ทุกวัน!" />

  <section class="mx-auto my-8 w-full max-w-7xl px-4 font-sans">
    <div class="mb-10 flex flex-col items-center text-center">
      <span class="mb-2 text-4xl drop-shadow-[0_0_10px_rgba(251,191,36,0.8)]">🔮</span>
      <h1 class="bg-gradient-to-r from-yellow-300 to-yellow-600 bg-clip-text text-4xl font-black tracking-widest text-transparent uppercase">แนวทางหวยแม่นๆ</h1>
      <p class="mt-3 max-w-2xl text-red-200/80">รวบรวมเลขเด็ด เลขดัง จากทุกสำนักทั่วประเทศ วิเคราะห์สูตรหวยฮานอย ลาว ยี่กี ให้คุณไม่พลาดทุกโอกาสในการรับทรัพย์</p>
    </div>

    <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
      {
        tips.map((tip) => (
          <div class="group relative flex cursor-pointer flex-col overflow-hidden rounded-2xl border border-red-700/30 bg-[#2a0404]/80 p-6 shadow-lg backdrop-blur-sm transition-all duration-300 hover:-translate-y-2 hover:border-yellow-500/50 hover:shadow-[0_15px_30px_rgba(220,38,38,0.4)]">
            <div class="pointer-events-none absolute inset-0 bg-gradient-to-br from-red-900/20 to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100" />

            <div class="relative z-10 mb-4 flex items-center justify-between">
              <span class="rounded-full border border-red-500/50 bg-[#450a0a] px-3 py-1 text-xs font-bold text-yellow-500">{tip.type}</span>
              {tip.hot && <span class="flex animate-pulse items-center gap-1 text-xs font-black text-red-400">🔥 มาแรง</span>}
              {!tip.hot && <span class="text-xs font-medium text-red-300/50">{tip.date}</span>}
            </div>

            <h3 class="relative z-10 mb-2 line-clamp-1 text-xl font-bold text-white transition-colors group-hover:text-yellow-400">{tip.title}</h3>

            <p class="relative z-10 mb-6 line-clamp-2 text-sm leading-relaxed text-red-100/70">{tip.desc}</p>

            <div class="relative z-10 mt-auto flex items-center gap-2 text-sm font-bold text-yellow-500 transition-transform group-hover:translate-x-2">
              อ่านเพิ่มเติม
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </div>
          </div>
        ))
      }
    </div>

    <div class="mt-12 flex justify-center">
      <button
        class="rounded-full border border-yellow-500/50 bg-[#2a0404] px-8 py-3 font-bold text-yellow-500 shadow-[0_0_15px_rgba(251,191,36,0.1)] transition-all hover:bg-yellow-500/10 hover:shadow-[0_0_20px_rgba(251,191,36,0.3)]">
        โหลดบทความเพิ่มเติม
      </button>
    </div>
  </section>

  <Navfoot />
</MainLayout>
<style>
  .font-sans {
    font-family: "Kanit", sans-serif;
  }
  p {
    color: #e6bd57;
  }
</style>
