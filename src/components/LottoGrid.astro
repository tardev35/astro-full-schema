---
const lottos = [
  { name: "หวยรัฐบาลไทย", close: "15:00 น.", reward: "3 ตัวบน บาทละ 950", icon: "🇹🇭" },
  { name: "หวยลาวพัฒนา", close: "20:00 น.", reward: "3 ตัวบน บาทละ 950", icon: "🇱🇦" },
  { name: "หวยฮานอย", close: "18:00 น.", reward: "3 ตัวบน บาทละ 950", icon: "🇻🇳" },
  { name: "หวยมาเลย์", close: "18:00 น.", reward: "3 ตัวบน บาทละ 950", icon: "🇲🇾" },
  { name: "หวยยี่กี 88 รอบ", close: "ทุก 15 นาที", reward: "2 ตัวบน บาทละ 95", icon: "⏱️" },
  { name: "หวยหุ้นไทย", close: "16:40 น.", reward: "2 ตัวบน บาทละ 95", icon: "📈" },
];
---

<section aria-label="ตลาดหวยออนไลน์ที่เปิดรับกับ POE888" class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#ffe98a] via-[#ffd93d] to-[#cd994e] bg-clip-text text-3xl leading-normal font-black tracking-widest text-transparent uppercase drop-shadow-sm">
      ตลาดหวยออนไลน์ที่เปิดรับกับ POE888
    </p>
    <div class="mt-2 h-[3px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#ffd93d] to-transparent"></div>
  </div>

  <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-6 lg:gap-5">
    {
      lottos.map((lotto) => (
        <div class="group relative flex flex-col items-center justify-center overflow-hidden rounded-2xl border border-[#2e8bff]/30 bg-[#04173f]/85 p-5 shadow-[0_10px_30px_rgba(2,10,30,0.55)] backdrop-blur-md transition-all duration-300 hover:-translate-y-2 hover:border-[#ffd93d]/60 hover:bg-[#062459] hover:shadow-[0_15px_40px_rgba(255,217,61,0.25)]">
          <div aria-hidden="true" class="mb-3 text-5xl drop-shadow-[0_0_15px_rgba(46,139,255,0.45)] transition-transform duration-300 group-hover:scale-110">
            {lotto.icon}
          </div>
          <p class="text-center text-sm font-bold text-[#dbeafe] transition-colors group-hover:text-[#ffe98a]">{lotto.name}</p>
          <p class="mt-1 text-[11px] text-[#b9cdf0]">
            ปิดรับ: <span class="font-mono text-[#a8d4ff]">{lotto.close}</span>
          </p>
          <div class="mt-3 rounded-full bg-gradient-to-r from-[#ffe98a] via-[#ffd93d] to-[#cd994e] px-3.5 py-1.5 text-center text-[10px] font-bold text-[#02143a] shadow-md transition-transform duration-300 group-hover:scale-105">
            {lotto.reward}
          </div>
        </div>
      ))
    }
  </div>
</section>
