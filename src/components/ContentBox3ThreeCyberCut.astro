---
const { titleleft, titlecenter, titleright } = Astro.props;
---

<section class="mx-auto mb-6 w-full max-w-7xl px-4 font-sans">
  <div
    class="relative w-full border border-purple-500/40 bg-[#0a001a]/90 p-8 text-white/90 shadow-[0_0_25px_rgba(157,78,221,0.15)] backdrop-blur-md transition-all duration-300 hover:border-purple-400 hover:shadow-[0_0_40px_rgba(157,78,221,0.3)]"
    style="clip-path: polygon(30px 0, 100% 0, 100% calc(100% - 30px), calc(100% - 30px) 100%, 0 100%, 0 30px);">
    <div class="absolute top-0 left-0 h-[2px] w-24 bg-gradient-to-r from-purple-500 to-transparent"></div>
    <div class="absolute right-0 bottom-0 h-[2px] w-24 bg-gradient-to-l from-purple-500 to-transparent"></div>
    <div class="absolute top-0 left-0 h-16 w-[2px] bg-gradient-to-b from-purple-500 to-transparent"></div>
    <div class="absolute right-0 bottom-0 h-16 w-[2px] bg-gradient-to-t from-purple-500 to-transparent"></div>

    <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
      <article class="flex flex-col gap-4 border-b border-purple-500/30 pb-6 md:border-r md:border-b-0 md:pr-6 md:pb-0">
        {
          titleleft && (
            <h3 class="flex items-center gap-2 text-lg font-black tracking-widest text-purple-400 uppercase">
              <span class="h-2 w-2 bg-yellow-400 shadow-[0_0_5px_rgba(255,215,0,0.8)]" /> {titleleft}
            </h3>
          )
        }
        <div class="text-sm leading-relaxed text-indigo-200/70">
          <slot name="left" />
        </div>
      </article>

      <article class="flex flex-col gap-4 border-b border-purple-500/30 pb-6 md:border-r md:border-b-0 md:px-4 md:pb-0">
        {
          titlecenter && (
            <h3 class="flex items-center gap-2 text-lg font-black tracking-widest text-purple-400 uppercase">
              <span class="h-2 w-2 bg-yellow-400 shadow-[0_0_5px_rgba(255,215,0,0.8)]" /> {titlecenter}
            </h3>
          )
        }
        <div class="text-sm leading-relaxed text-indigo-200/70">
          <slot name="center" />
        </div>
      </article>

      <article class="flex flex-col gap-4 md:pl-6">
        {
          titleright && (
            <h3 class="flex items-center gap-2 text-lg font-black tracking-widest text-purple-400 uppercase">
              <span class="h-2 w-2 bg-yellow-400 shadow-[0_0_5px_rgba(255,215,0,0.8)]" /> {titleright}
            </h3>
          )
        }
        <div class="text-sm leading-relaxed text-indigo-200/70">
          <slot name="right" />
        </div>
      </article>
    </div>
  </div>
</section>

<style>
  .font-sans {
    font-family: "Kanit", sans-serif;
  }
</style>
