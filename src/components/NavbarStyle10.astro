---
import { isActivePath } from "../lib/nav";
import { Picture } from "astro:assets";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });
const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;
const currentPath = Astro.url.pathname;
const isActive = (path: string) => isActivePath(currentPath, path);

const logoAlt =
  "โลโก้ ANKERSPIN ตัวอักษร ANKER สีชมพูบานเย็นไล่เฉดขอบขาว ต่อด้วยคำว่า SPIN สีขาวเงิน มีรูปสมอเรือสีชมพูวางทับอยู่ด้านบนตัวอักษร พร้อมเส้นแสงสีชมพูเรืองรอบตัวโลโก้";

const links = [
  { name: "หน้าแรก", path: "/", icon: "🏠" },
  { name: "โปรโมชั่น", path: "/promotion", icon: "🎁" },
  { name: "สมัครสมาชิก", path: "/register", icon: "📝" },
  { name: "เข้าสู่ระบบ", path: "/login", icon: "🔑" },
  { name: "ทดลองเล่น", path: "/ทดลองเล่น", icon: "🎰" },
  { name: "เกี่ยวกับเรา", path: "/about-us", icon: "📖" },
  { name: "ติดต่อเรา", path: "/contact-us", icon: "📞" },
  { name: "ตรวจหวย", path: "/ตรวจหวย", icon: "🔍" },
  { name: "แนวทาง", path: "/แนวทาง", icon: "📊" },
];
---

<div class="hidden w-full border-b border-[#a4126b]/40 bg-gradient-to-r from-[#0d0207] via-[#3d0f24] to-[#0d0207] px-4 py-1.5 font-sans text-xs font-bold text-[#f9dcec]/85 lg:block">
  <div class="mx-auto flex max-w-400 justify-between">
    <div class="flex gap-4">
      <span class="flex items-center gap-1"><span aria-hidden="true" class="text-[#ff6bb5]">🎰</span> ANKERSPIN เว็บตรงลิขสิทธิ์แท้ รวมสล็อต คาสิโนสด กีฬา ในบัญชีเดียว</span>
      <span class="flex items-center gap-1 text-[#ffc4e2]"><span aria-hidden="true" class="text-[#ff6bb5]">⚡</span> ฝากถอน Auto Wallet ระบบออโต้ 24 ชั่วโมง</span>
    </div>
    <div class="flex gap-4">
      <a href="/line" class="flex items-center gap-1 transition-colors hover:text-[#ffa6d5]">ติดต่อแอดมิน LINE: @ANKERSPIN</a>
    </div>
  </div>
</div>

<header class="sticky top-2 z-50 mt-2 w-full px-2 font-sans md:px-4">
  <nav
    class="relative mx-auto flex h-[75px] w-full max-w-400 items-center justify-between gap-4 rounded-[20px] border border-[#ff2d8f]/45 bg-[#1f0611]/90 px-4 shadow-[0_10px_30px_rgba(255,45,143,0.16)] backdrop-blur-lg xl:px-6">
    <a href="/" class="z-50 flex-shrink-0 transition-transform hover:scale-105">
      {
        mainLogo ? (
          <Picture
            src={mainLogo}
            alt={logoAlt}
            loading="eager"
            fetchpriority="high"
            widths={[170, 340, 510]}
            sizes="170px"
            class="h-[40px] w-auto max-w-[170px] object-contain drop-shadow-[0_0_10px_rgba(255,107,181,0.5)] xl:h-[45px]"
            formats={["avif", "webp"]}
            fallbackFormat="webp"
          />
        ) : (
          <span class="bg-gradient-to-b from-[#ffa6d5] to-[#ff2d8f] bg-clip-text text-3xl font-black text-transparent drop-shadow-[0_0_8px_rgba(255,107,181,0.4)]">ANKERSPIN</span>
        )
      }
    </a>

    <div class="hidden h-full min-w-0 items-center justify-center gap-5 xl:flex 2xl:gap-8">
      {
        links.map((item) => (
          <a
            href={item.path}
            class={`group relative flex h-full shrink-0 items-center gap-1.5 text-sm font-bold whitespace-nowrap transition-colors xl:text-base ${isActive(item.path) ? "text-[#ff6bb5] drop-shadow-[0_0_8px_rgba(255,107,181,0.4)]" : "text-[#f9dcec]/80 hover:text-[#ff6bb5]"}`}>
            <span aria-hidden="true" class="text-base leading-none">
              {item.icon}
            </span>
            <span>{item.name}</span>
            <div
              class={`absolute bottom-[18px] left-0 h-[2px] w-full origin-center bg-[#ff6bb5] shadow-[0_0_8px_rgba(255,107,181,0.8)] transition-transform duration-300 ${isActive(item.path) ? "scale-x-100" : "scale-x-0 group-hover:scale-x-100"}`}
            />
          </a>
        ))
      }
    </div>

    <div class="z-50 flex shrink-0 items-center gap-2 xl:gap-3">
      <a
        href="/login"
        class="hidden items-center justify-center rounded-full border border-[#ff6bb5]/55 bg-[#3d0f24] px-6 py-2 text-sm font-bold whitespace-nowrap text-[#ffa6d5] shadow-sm transition-all hover:bg-[#ff6bb5]/20 2xl:flex">
        เข้าสู่ระบบ
      </a>
      <a
        href="/register"
        class="hidden items-center justify-center rounded-full bg-gradient-to-r from-[#ffa6d5] via-[#ff2d8f] to-[#c2185b] px-4 py-2 text-sm font-black whitespace-nowrap text-[#0d0207] shadow-[0_0_15px_rgba(255,45,143,0.4)] transition-all hover:scale-105 lg:flex xl:px-6">
        สมัครสมาชิก
      </a>

      <button
        id="hamburger-btn"
        class="relative flex h-[42px] w-[42px] flex-col items-center justify-center gap-[5px] rounded-full border border-[#ff2d8f]/35 bg-gradient-to-b from-[#3d0f24] to-[#0d0207] shadow-sm xl:hidden"
        aria-label="เปิดเมนู">
        <span class="line-1 h-[2px] w-5 origin-center rounded-full bg-[#ff6bb5] transition-all duration-300"></span>
        <span class="line-2 h-[2px] w-5 origin-center rounded-full bg-[#ff6bb5] transition-all duration-300"></span>
        <span class="line-3 h-[2px] w-5 origin-center rounded-full bg-[#ff6bb5] transition-all duration-300"></span>
      </button>
    </div>
  </nav>

  <div id="fullscreen-menu" class="pointer-events-none fixed inset-0 z-[40] flex flex-col items-center justify-center bg-[#0d0207]/98 opacity-0 backdrop-blur-xl transition-opacity duration-500">
    <div class="flex w-full flex-col items-center space-y-5 px-6">
      {
        links.map((item) => (
          <a
            href={item.path}
            class={`fs-item flex items-center gap-3 text-2xl font-black tracking-widest uppercase transition-all duration-300 ${isActive(item.path) ? "text-[#ff6bb5] drop-shadow-[0_0_10px_rgba(255,107,181,0.6)]" : "text-[#f9dcec]/85 hover:text-[#ffa6d5]"}`}>
            <span aria-hidden="true" class="text-2xl leading-none">
              {item.icon}
            </span>
            {item.name}
          </a>
        ))
      }
      <div class="fs-item mt-4 flex w-full max-w-[280px] flex-col gap-4 pt-6">
        <a
          href="/register"
          class="flex w-full items-center justify-center rounded-full bg-gradient-to-r from-[#ffa6d5] to-[#ff2d8f] py-3.5 text-lg font-black text-[#0d0207] shadow-[0_0_20px_rgba(255,45,143,0.5)]">
          สมัครสมาชิกใหม่
        </a>
        <a
          href="/login"
          class="flex w-full items-center justify-center rounded-full border-2 border-[#ff6bb5]/55 bg-[#3d0f24] py-3.5 text-lg font-bold text-[#ffa6d5] transition-colors hover:bg-[#ff6bb5]/20">
          เข้าสู่ระบบ
        </a>
      </div>
    </div>
  </div>
</header>

<style is:global>
  #hamburger-btn.active .line-1 {
    transform: translateY(7px) rotate(45deg);
  }
  #hamburger-btn.active .line-2 {
    opacity: 0;
  }
  #hamburger-btn.active .line-3 {
    transform: translateY(-7px) rotate(-45deg);
  }

  .fs-item {
    opacity: 0;
    transform: translateY(20px);
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .fs-item.show {
    opacity: 1;
    transform: translateY(0);
  }
  .fs-item:nth-child(1) {
    transition-delay: 0.1s;
  }
  .fs-item:nth-child(2) {
    transition-delay: 0.15s;
  }
  .fs-item:nth-child(3) {
    transition-delay: 0.2s;
  }
  .fs-item:nth-child(4) {
    transition-delay: 0.25s;
  }
  .fs-item:nth-child(5) {
    transition-delay: 0.3s;
  }
  .fs-item:nth-child(6) {
    transition-delay: 0.35s;
  }
  .fs-item:nth-child(7) {
    transition-delay: 0.4s;
  }
  .fs-item:nth-child(8) {
    transition-delay: 0.45s;
  }

  @media (prefers-reduced-motion: reduce) {
    .fs-item {
      transition: none;
      transform: none;
    }
  }
</style>

<script>
  const hamburgerBtn = document.getElementById("hamburger-btn");
  const fsMenu = document.getElementById("fullscreen-menu");
  const fsItems = document.querySelectorAll(".fs-item");

  const toggleFsMenu = () => {
    hamburgerBtn?.classList.toggle("active");
    fsMenu?.classList.toggle("opacity-0");
    fsMenu?.classList.toggle("pointer-events-none");

    if (!fsMenu?.classList.contains("opacity-0")) {
      document.body.style.overflow = "hidden";
      fsItems.forEach((item) => item.classList.add("show"));
    } else {
      document.body.style.overflow = "";
      fsItems.forEach((item) => item.classList.remove("show"));
    }
  };

  hamburgerBtn?.addEventListener("click", toggleFsMenu);
  fsItems.forEach((item) => {
    item.addEventListener("click", () => {
      if (!fsMenu?.classList.contains("opacity-0")) toggleFsMenu();
    });
  });
</script>
