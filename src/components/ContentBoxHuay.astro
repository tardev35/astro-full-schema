---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#ffd93d]/35 bg-[#04173f]/95 p-8 text-left text-base leading-relaxed text-[#dbeafe] shadow-[0_10px_30px_rgba(255,217,61,0.14)] backdrop-blur-xl transition-all duration-500 hover:border-[#ffd93d]/60 hover:shadow-[0_15px_40px_rgba(255,217,61,0.24)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#ffd93d]/20 blur-[55px] transition-all duration-500 group-hover:bg-[#ffd93d]/30">
    </div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#0b4ea8]/55 blur-[55px] transition-all duration-500 group-hover:bg-[#2e8bff]/45">
    </div>

    {
      title && (
        <header class="mb-6 flex items-center gap-4 border-b border-[#ffd93d]/30 pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffe98a] to-[#cd994e] shadow-[0_0_10px_rgba(255,217,61,0.45)]" />
          <HeadingTag class="bg-gradient-to-r from-[#ffe98a] via-[#ffd93d] to-[#cd994e] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
