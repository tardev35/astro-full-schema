---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";
import CtaRedirect from "../components/CtaRedirect.astro";
import { pageGraph } from "../lib/schema";

const pageDescription = "หน้าสมัครสมาชิก BUNNY555 สล็อตเว็บตรง มีปุ่มเดียวสำหรับเปิดบัญชีใหม่ผ่านมือถือ ใช้บัญชีเดียวเลือกเกมค่าย PG Slot และ JILI รับโบนัส และฝากถอนผ่าน True Wallet";

const graph = pageGraph(Astro, {
  name: "สมัครสมาชิก BUNNY555 สล็อตเว็บตรง",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "สมัครสมาชิก", path: "/register" },
  ],
});

const targetUrl = "https://yoalink.com/22hs";
---

<MainLayout title="สมัครสมาชิก BUNNY555 | ปุ่มเปิดบัญชีสล็อตเว็บตรงผ่านมือถือ" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="สมัครสมาชิก BUNNY555" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label="สมัครสมาชิก BUNNY555"
        class="group relative mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#a86a10]/50 bg-gradient-to-b from-[#f7c948] to-[#e8a020] px-6 py-4 text-xl font-bold tracking-wide text-[#7a1038] shadow-[0_10px_30px_rgba(190,24,93,0.18)] transition-all duration-300 hover:scale-105 hover:border-[#be185d]/70 hover:shadow-[0_15px_40px_rgba(232,160,32,0.20)]">
        สมัครสมาชิก BUNNY555
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="สมัครสมาชิก" />
</MainLayout>
