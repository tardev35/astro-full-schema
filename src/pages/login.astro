---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement2.astro";
import CtaRedirect from "../components/CtaRedirect.astro";
import { pageGraph } from "../lib/schema";

const pageTitle = "เข้าสู่ระบบ AMD365 | ปุ่มล็อกอินเข้าหน้าเมมเบอร์ สล็อต คาสิโน กีฬา หวย";

const pageDescription =
  "หากคุณกำลังมองหาทางกลับเข้าหน้าเมมเบอร์ที่ไม่ยุ่งยาก AMD365 มีปุ่มเข้าสู่ระบบเพียงปุ่มเดียว พาไปเล่นสล็อต คาสิโนสด กีฬา และหวยด้วยยูสเดิม เช็กเครดิตต่อได้ทันที";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เข้าสู่ระบบ", path: "/login" },
  ],
});

const targetUrl = "https://yoalink.com/22hs";
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="เข้าสู่ระบบ AMD365" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label="เข้าสู่ระบบ AMD365"
        class="group relative mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#fec93a]/60 bg-gradient-to-b from-[#c9ccd4] to-[#5c6472] px-6 py-4 text-xl font-bold tracking-wide text-[#160e03] shadow-[0_10px_30px_rgba(201,204,212,0.24)] transition-all duration-300 hover:scale-105 hover:border-[#ffe9a8]/70 hover:shadow-[0_15px_40px_rgba(201,204,212,0.35)]">
        เข้าสู่ระบบ AMD365
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="เข้าสู่ระบบ" />
</MainLayout>
