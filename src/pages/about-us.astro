---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";
import { pageGraph } from "../lib/schema";

const pageTitle = "เกี่ยวกับเรา SUPERCLUB168 สล็อตเว็บตรง API แท้ ระบบเดียวจบครบทุกค่าย";

const pageHeading = "เกี่ยวกับเรา SUPERCLUB168 สล็อตเว็บตรง API แท้ ที่จบได้ในยูสเดียว";

const pageDescription =
  "รู้จัก SUPERCLUB168 สล็อตเว็บตรง API แท้ ที่เชื่อมเกมจากเซิร์ฟเวอร์ค่ายแม่โดยตรง ฝากถอนออโต้ไม่มีขั้นต่ำ และรวมทุกค่ายไว้ในกระเป๋าเดียว อ่านว่าระบบทำงานอย่างไร";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox as="h1" title={pageHeading}>
    <p class="mb-4 text-left text-base leading-relaxed">
      <strong class="text-[#ffe38a]">SUPERCLUB168</strong> คือสล็อตเว็บตรงที่เชื่อม API แท้ จากเซิร์ฟเวอร์ของค่ายเกมโดยตรง สมาชิกใช้ยูสเดียวเลือกเกม ฝาก ถอน และดูสถานะรายการได้จากหน้าเดียวกัน
    </p>

    <p class="mb-4 text-left text-base leading-relaxed">
      สิ่งที่เราให้เวลากับมันคือเส้นทางที่สั้นลง ไม่ใช่ฟีเจอร์ที่เยอะขึ้น ทุกอย่างวางไว้ให้จบได้จากมือถือเครื่องเดียว
    </p>

    <p class="text-left text-base leading-relaxed">หน้านี้เล่าว่าเว็บทำงานอย่างไร ไม่ได้เขียนไว้ขายของ</p>
  </ContentBox>

  <ContentBox as="h2" title="เชื่อม API แท้ จากเซิร์ฟเวอร์ค่ายแม่ ไม่ผ่านตัวกลาง">
    <p class="mb-4 text-left text-base leading-relaxed">
      เกมทุกเกมบนเว็บต่อตรงกับเซิร์ฟเวอร์ของผู้พัฒนา ไม่ได้ผ่านเอเย่นต์หลายชั้น ภาพและเสียงจึงมาแบบ Real-time และรอบการเล่นไม่สะดุดกลางทาง
    </p>

    <p class="mb-4 text-left text-base leading-relaxed">
      ผลที่ตามมาคือค่า RTP ที่ค่ายประกาศไว้คือค่าที่ใช้จริง ไม่มีการปรับเรทระหว่างทาง และไม่มีการล็อกยูสรายบัญชี ไม่ว่าจะเบทเบาหรือเบทหนัก
    </p>

    <p class="text-left text-base leading-relaxed">ตัวเลขที่อ่านได้ในหน้าเกม กับตัวเลขที่ระบบใช้คำนวณ เป็นชุดเดียวกัน</p>
  </ContentBox>

  <ContentBox as="h2" title="ค่ายเกมที่เปิดให้เล่น และระบบกระเป๋าเดียว">
    <p class="mb-4 text-left text-base leading-relaxed">
      ค่ายที่เปิดให้เล่นมีทั้ง PG SOFT, Pragmatic Play, JILI, Joker, CQ9, Relax Gaming และ Hacksaw แต่ละค่ายมีสไตล์เกมและจังหวะฟีเจอร์ของตัวเอง
    </p>

    <p class="mb-4 text-left text-base leading-relaxed">
      ทั้งหมดอยู่ในกระเป๋าเดียว ไม่ต้องโยกเงินระหว่างค่ายก่อนเปลี่ยนเกม เลือกจากหน้ารวมเกมแล้วกดเข้าเล่นได้ทันที ไม่ต้องรอรอบโอนระหว่างค่าย
    </p>

    <p class="text-left text-base leading-relaxed">การไม่ต้องโยกเงิน ทำให้ยอดคงเหลือมีที่อยู่เดียวและตรวจง่ายกว่า</p>
  </ContentBox>

  <ContentBox as="h2" title="ฝากถอนออโต้ เฉลี่ย 1–3 วินาที และไม่มีขั้นต่ำ">
    <p class="mb-4 text-left text-base leading-relaxed">
      คำขอฝากและถอนถูกประมวลผลอัตโนมัติตลอด 24 ชั่วโมง เวลาเฉลี่ยต่อรายการอยู่ที่ 1–3 วินาที รองรับทั้งแอปธนาคารไทยและ True Money Wallet
    </p>

    <p class="mb-4 text-left text-base leading-relaxed">
      ไม่มีขั้นต่ำทั้งฝากและถอน เริ่มได้ตั้งแต่ 1 บาท และยอดที่ถอนได้คือยอดเต็มจำนวน ไม่อั้นยอด ไม่จำกัดจำนวนรอบต่อวัน
    </p>

    <p class="mb-4 text-left text-base leading-relaxed">
      ถ้ายอดยังไม่ขึ้น ให้รอรอบประมวลผลก่อนแล้วค่อยเช็กซ้ำ การกดส่งซ้ำรัว ๆ สร้างได้แค่รายการซ้ำที่ต้องตามแก้ทีหลัง
    </p>

    <p class="text-left text-base leading-relaxed">รายการตอนตีสามกับตอนบ่ายสอง จึงใช้เวลาไม่ต่างกัน</p>
  </ContentBox>

  <ContentBox as="h2" title="สมัครฟรี ไม่ต้องฝากก่อน และการดูแลบัญชีสมาชิก">
    <p class="mb-4 text-left text-base leading-relaxed">
      การสมัครฟรี 100% ไม่ต้องฝากเงินก่อน และขอเฉพาะข้อมูลที่จำเป็นต่อการยืนยันตัวตน ขั้นตอนทั้งหมดใช้เวลาไม่เกินสิบวินาที
    </p>

    <p class="mb-4 text-left text-base leading-relaxed">
      เมื่อได้ยูสแล้วจะเข้าดูเกม สำรวจหน้าเว็บ และลองระบบก่อนตัดสินใจเติมจริงก็ได้ ไม่มีเงื่อนไขผูกมัดและไม่ต้องเติมเงินเพื่อเปิดดู
    </p>

    <p class="mb-4 text-left text-base leading-relaxed">
      รหัสผ่านควรตั้งให้ไม่ซ้ำกับบัญชีสำคัญอื่น และไม่ส่งรหัสผ่านหรือรหัส OTP ให้ใคร ไม่ว่าอีกฝ่ายจะอ้างว่าเป็นใครก็ตาม
    </p>

    <p class="text-left text-base leading-relaxed">บัญชีที่ปลอดภัยไม่ได้ทำให้เล่นเก่งขึ้น แต่ทำให้ไม่ต้องคอยระแวงมัน</p>
  </ContentBox>

  <Navfoot />
</MainLayout>
