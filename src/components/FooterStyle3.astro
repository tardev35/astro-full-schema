---
import { Picture } from "astro:assets";
import BankStrip from "./BankStrip.astro";
import { BRAND_ADDRESS, BRAND_NAME } from "../lib/brandProfile";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });

const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

const quickLinks = [
  { name: "หน้าแรก", path: "/" },
  { name: "โปรโมชั่น", path: "/promotion/" },
  { name: "ทดลองเล่น", path: "/ทดลองเล่น/" },
  { name: "วิธีฝากถอน", path: "/วิธีฝากถอน/" },
  { name: "ทางเข้า", path: "/ทางเข้า/" },
  { name: "เกี่ยวกับเรา", path: "/about-us/" },
  { name: "สมัครสมาชิก", path: "/register/" },
  { name: "เข้าสู่ระบบ", path: "/login/" },
  { name: "ติดต่อเรา", path: "/contact-us/" },
];

const logoAlt = "โลโก้ Supreme888 ตัวอักษรเอียงสีขาวบนกล่องสี่เหลี่ยมสีแดง";
---

<footer class="relative mt-32 w-full border-t-4 border-[#ec1b24] bg-[#140405] pt-64 pb-6 font-sans text-[#f6eeee] shadow-[0_-10px_30px_rgba(20,20,20,0.12)] md:pt-40">
  <div
    class="absolute -top-14 left-1/2 z-20 flex w-[92%] max-w-5xl -translate-x-1/2 flex-col items-center justify-between rounded-2xl border border-[#ff4d55]/60 bg-gradient-to-r from-[#b5121a] via-[#ec1b24] to-[#b5121a] p-6 shadow-[0_15px_40px_rgba(236,27,36,0.30)] md:-top-16 md:flex-row md:p-8">
    <div class="mb-5 flex flex-col text-center md:mb-0 md:text-left">
      <p class="text-xl font-black tracking-wide text-white uppercase italic drop-shadow-[0_2px_4px_rgba(20,4,5,0.45)] md:text-3xl">
        <span aria-hidden="true">👑</span> เปิดยูส {BRAND_NAME} วันนี้ ถอนได้เต็มทุกบิล
      </p>
      <p class="mt-2 text-sm font-medium text-white/90 md:text-base">
        ฝากเริ่ม 20 บาท ถอนเองได้ตลอด 24 ชม. ทุกธนาคารและ TrueMoney Wallet สล็อตหลายค่ายในเว็บเดียว ทำได้ครบบนมือถือ
      </p>
    </div>

    <a
      href="/register/"
      class="group relative flex items-center justify-center overflow-hidden rounded-full border border-white bg-white px-8 py-3.5 text-sm font-extrabold whitespace-nowrap text-[#b5121a] shadow-[0_6px_18px_rgba(20,4,5,0.30)] transition-all hover:scale-105 hover:text-white md:text-base">
      <span class="relative z-10">สมัครสมาชิกเลย <span aria-hidden="true">🚀</span></span>
      <div aria-hidden="true" class="absolute inset-0 translate-y-full bg-[#141414] transition-transform duration-300 group-hover:translate-y-0"></div>
    </a>
  </div>

  <div class="relative z-10 mx-auto max-w-[1200px] px-6">
    <div class="mb-10 grid grid-cols-1 gap-10 md:grid-cols-12 lg:gap-12">
      <div class="flex flex-col gap-6 md:col-span-12 lg:col-span-4">
        <a href="/" class="inline-block origin-left transition-transform hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt={logoAlt}
                widths={[100, 200, 300]}
                sizes="100px"
                loading="lazy"
                decoding="async"
                class="h-[56px] w-auto shadow-[0_6px_18px_rgba(236,27,36,0.35)]"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <p class="inline-block bg-[#ec1b24] px-3 py-1 text-3xl font-black text-white italic">{BRAND_NAME}</p>
            )
          }
        </a>
        <p class="text-sm leading-relaxed text-[#f6eeee]/85">
          {BRAND_NAME} สล็อตที่ยอดถอนเข้าเต็มจำนวนไม่หักเปอร์เซ็นต์ ฝากถอนออโต้กดเองได้ทั้งวัน รวม PG Soft, Pragmatic Play, JILI และ Joker Gaming ไว้ในเว็บเดียว
          มือถือเครื่องเดียวทำได้ครบ และมีแอดมินรับเรื่องตลอด 24 ชั่วโมง
        </p>

        <div class="mt-2 flex flex-wrap gap-3">
          <a
            href="/line/"
            class="flex items-center gap-2 rounded-full border border-[#00B900]/40 bg-[#00B900]/15 px-4 py-2 text-xs font-bold text-[#8fe6a8] shadow-[0_0_10px_rgba(0,185,0,0.15)] transition-colors hover:bg-[#00B900] hover:text-white">
            <span aria-hidden="true" class="text-base">💬</span> LINE OFFICIAL
          </a>
        </div>

        {
          BRAND_ADDRESS.lines.length > 0 && (
            <address aria-label={BRAND_ADDRESS.label} class="mt-2 rounded-xl border border-white/15 bg-black/20 p-4 text-xs leading-relaxed not-italic opacity-90">
              <p class="mb-2 flex items-center gap-2 text-[11px] font-bold tracking-wider uppercase opacity-80">
                <span aria-hidden="true" class="text-sm">📍</span>
                {BRAND_ADDRESS.label}
              </p>
              {BRAND_ADDRESS.lines.map((line) => (
                <span class="block">{line}</span>
              ))}
              {BRAND_ADDRESS.email && (
                <a href={`mailto:${BRAND_ADDRESS.email}`} class="mt-3 inline-flex items-center gap-2 font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                  <span aria-hidden="true" class="text-sm">✉️</span>
                  {BRAND_ADDRESS.email}
                </a>
              )}
            </address>
          )
        }
      </div>

      <div class="md:col-span-6 lg:col-span-5">
        <p class="relative mb-5 inline-block text-lg font-bold tracking-wider text-white uppercase">
          ลิงก์ด่วน (Quick Links)
          <span aria-hidden="true" class="absolute -bottom-2 left-0 h-1 w-1/2 rounded-full bg-gradient-to-r from-[#ff4d55] to-[#b5121a]"></span>
        </p>

        <div class="grid grid-cols-2 gap-x-4 gap-y-3 text-sm">
          {
            quickLinks.map((link) => (
              <a href={link.path} class="group flex items-center text-[#f6eeee]/85 transition-colors hover:text-white">
                <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#ec1b24] transition-transform group-hover:rotate-45" />
                {link.name}
              </a>
            ))
          }
        </div>
      </div>

      <div class="md:col-span-6 lg:col-span-3">
        <p class="relative mb-5 inline-block text-lg font-bold tracking-wider text-white uppercase">
          ระบบการเงิน
          <span aria-hidden="true" class="absolute -bottom-2 left-0 h-1 w-1/2 rounded-full bg-gradient-to-r from-[#ff4d55] to-[#b5121a]"></span>
        </p>

        <p class="mb-4 text-xs text-[#f6eeee]/85">ฝากถอนได้ทุกธนาคารและ TrueMoney Wallet ฝากขั้นต่ำ 20 บาท ถอนขั้นต่ำ 50 บาท ระบบปรับเครดิตให้เองในไม่กี่วินาที ไม่ต้องส่งสลิป</p>

        <BankStrip size={30} />

        <div class="mt-3 flex h-10 items-center justify-center rounded border border-white/12 bg-[#1c0607] transition-colors hover:border-[#ec1b24]/70">
          <span class="flex items-center gap-1 text-xs font-bold text-[#f6eeee]"><span aria-hidden="true" class="text-lg">⚡</span> เครดิตไม่ขึ้น อย่าโอนซ้ำ ทักแอดมินได้ 24 ชม.</span>
        </div>
      </div>
    </div>

    <hr class="mb-6 border-white/15" />

    <div class="mb-6 hidden text-justify text-[10px] leading-relaxed text-[#f6eeee]/65 md:block">
      {BRAND_NAME} รวมเกมสล็อตจากหลายค่ายไว้ในเว็บเดียว ให้เลือกเล่นจากกลไกฟรีสปิน ตัวคูณ และฟีเจอร์ของแต่ละเกม ตั้งงบของวันไว้ก่อนเปิดเกมทุกครั้ง
      การสมัคร ฝาก ปั่น และถอนทำได้ครบบนมือถือผ่านเบราว์เซอร์ทั้ง iOS และ Android รับโปรใดไว้ให้อ่านเงื่อนไขในหน้าโปรโมชั่นก่อนกดถอน
      และไม่ส่งรหัสผ่านหรือ OTP ให้ใครทั้งนั้น
    </div>

    <div class="flex flex-col items-center justify-between gap-4 border-t border-white/15 pt-6 text-xs text-[#f6eeee]/75 md:flex-row">
      <p>&copy; {new Date().getFullYear()} <span class="font-bold tracking-wider text-white uppercase">{BRAND_NAME}</span>. All Rights Reserved.</p>

      <div class="flex items-center gap-6">
        <a href="/terms/" class="transition-colors hover:text-white">เงื่อนไขและข้อตกลง</a>
        <a href="/privacy/" class="transition-colors hover:text-white">นโยบายความเป็นส่วนตัว</a>

        <a
          href="#top"
          class="flex h-8 w-8 items-center justify-center rounded border border-white/25 bg-white/10 text-white transition-all hover:border-[#ec1b24] hover:bg-[#ec1b24] hover:shadow-[0_0_15px_rgba(236,27,36,0.45)]"
          aria-label="กลับขึ้นด้านบนสุดของหน้า">
          <span aria-hidden="true">↑</span>
        </a>
      </div>
    </div>
  </div>
</footer>
