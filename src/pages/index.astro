---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/AnnouncementPremium.astro";
import ContentBox from "../components/ContentBox.astro";
import ContentBoxCyberCut from "../components/ContentBoxCyberCut.astro";
import ContentBoxSpecial from "../components/ContentBoxSpecial.astro";
import ContentBox3Three from "../components/ContentBox3Three.astro";
import ContentBoxSevenThree from "../components/ContentBoxSevenThree.astro";
import ContentBoxSevenThreeCyberCut from "../components/ContentBoxSevenThreeCyberCut.astro";
import FeatureHighlights from "../components/FeatureHighlights.astro";
import ProviderGridPremium from "../components/ProviderGridPremium.astro";
import GameRankingBoard from "../components/GameRankingBoard.astro";
import SmoothCarousel from "../components/SmoothCarousel.astro";
import LatestWinnersPremium from "../components/LatestWinnersPremium.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import ReviewCardSumo2 from "../components/ReviewCardSumo2.astro";
import Faq4 from "../components/Faq4.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import imgBonus from "../assets/slide1.png";
import imgProviders from "../assets/slide3.png";

const pageTitle = "SUPERCLUB168 สล็อตเว็บตรงAPIแท้ แตกบ่อย โบนัสระดับซุปเปอร์เมกะ";

const pageDescription =
  "SUPERCLUB168 สล็อตเว็บตรงAPIแท้ รวมค่ายเกมพรีเมียม แตกบ่อย จ่ายหนักตรงเวลา โบนัสระดับซุปเปอร์เมกะ ฝากถอนโอนไว ไม่มีขั้นต่ำ สมัครสมาชิกฟรี";

const bonusAlt =
  "ภาพโปรโมชั่นพื้นดำ-ทอง ตราวงกลม SUPERCLUB168 ด้านบน หัวข้อ COMMISSION คืนทุกยอดเล่นตลอดทั้งวัน 0.3% ระบุเล่นถึง 50% ถอนได้เลย กดรับง่ายๆ ที่หน้าเว็บได้เลย รับสิทธิ์ก่อน 23.59 น. ของทุกวัน ปิดท้ายด้วยข้อความ ยิ่งเล่นเยอะ ยิ่งได้เยอะ ด้านซ้ายเป็นพรีเซนเตอร์หญิงสวมชุดเลื่อมสีทอง";

const providersAlt =
  "ภาพโปรโมชั่นพื้นดำ-ทอง ตราวงกลม SUPERCLUB168 มุมขวาบน ปุ่มเรียงด้านซ้ายระบุ หวย บอล บาคาร่า สล็อต ข้อความใหญ่ ครบจบในที่เดียว และแถบรายการด้านล่าง บอล คาสิโน สล็อต ยิงปลา ไก่ชน มวย ไฮโล รูเล็ต ตรงกลางเป็นพรีเซนเตอร์หญิงสวมชุดเลื่อมสีทอง";

const providerPoints = [
  {
    icon: "🎨",
    title: "PG SOFT",
    description: "ภาพสวย แตกไว ฟีลพรีเมียม เป็นค่ายที่สมาชิกเปิดบ่อยที่สุดในไลน์อัพของเรา",
    accent: "blue" as const,
  },
  {
    icon: "🎁",
    title: "Pragmatic Play",
    description: "ซื้อฟรีสปินจัดจ้าน โบนัสแรง เหมาะกับสายที่อยากเข้าฟีเจอร์ใหญ่โดยไม่ต้องรอรอบ",
    accent: "red" as const,
  },
  {
    icon: "🔥",
    title: "JILI / Joker / CQ9 / Relax Gaming / Hacksaw",
    description: "ทุกค่ายเกมที่ถูกเลือกมาคือ “ค่ายที่แตกถี่ แตกบ่อยและได้รับความนิยมสูงสุดในตลาดจริง”",
    accent: "blue" as const,
  },
  {
    icon: "👛",
    title: "กระเป๋าเดียว ไม่ต้องโยกเงิน",
    description: "คุณไม่ต้องโยกเงิน ไม่ต้องย้ายกระเป๋า เว็บนี้ใช้ระบบ กระเป๋าเดียว เลือกเกมแล้วลุยได้ทันทีทุกเกมทุกค่าย ทุกประเภท",
    accent: "red" as const,
  },
];

const faqs = [
  {
    q: "SUPERCLUB168 เป็นสล็อตเว็บตรง API แท้ อย่างไร?",
    a: "SUPERCLUB168 เชื่อมต่อ API แท้ จากเซิร์ฟเวอร์หลักของผู้พัฒนาเกมโดยตรง ไม่ผ่านตัวกลาง ผลคือเล่นได้แบบ Real-time ไม่มีดีเลย์ ภาพสวยเสียงชัด และค่า RTP เป็นของจริง ไม่มีการปรับลดเปอร์เซ็นต์",
  },
  {
    q: "ทำไม SUPERCLUB168 ถึงแตกบ่อยกว่าเว็บทั่วไป?",
    a: "เพราะเกมเชื่อมตรงจากค่ายแม่ ค่า RTP เต็มระบบ ไม่มีการปรับเรท ไม่มีล็อกยูส โบนัสจึงออกถี่และสม่ำเสมอตามมาตรฐานของแต่ละเกม ไม่ได้ขึ้นกับช่วงเวลาที่คุณเข้ามาเล่น",
  },
  {
    q: "โบนัสระดับซุปเปอร์เมกะ ต้องรอช่วงเวลาไหม?",
    a: "ไม่ต้องรอ ที่ SUPERCLUB168 ทุกนาทีเสถียรเท่ากัน ทุกการสปินมีสิทธิเข้าฟีเจอร์ใหญ่และแตะซุปเปอร์เมกะ (Super Mega Win) ได้เหมือนกันหมด จะปั่นเบทเบาหรือกดหนักต่อเนื่องก็รองรับแบบแฟร์ 100%",
  },
  {
    q: "ฝากถอนของ SUPERCLUB168 ใช้เวลานานแค่ไหน?",
    a: "ระบบฝากถอน Auto ใช้เวลาเฉลี่ยเพียง 1–3 วินาที ทำรายการได้ 24 ชั่วโมง รองรับทั้งแอปธนาคารไทยและ True Money Wallet ฝากแล้วเครดิตเข้าทันที ถอนแล้วเงินเด้งเข้าบัญชี",
  },
  {
    q: "SUPERCLUB168 มีขั้นต่ำในการฝากถอนหรือไม่?",
    a: "ไม่มีขั้นต่ำทั้งฝากและถอน เริ่มต้นได้ตั้งแต่ 1 บาท จะมีทุนร้อยหรือทุนล้านก็ได้รับการดูแลรวดเร็วเท่าเทียมกัน และถอนยอดได้เต็มจำนวน ไม่อั้น ไม่จำกัดรอบ",
  },
  {
    q: "สมัครสมาชิก SUPERCLUB168 ต้องฝากเงินก่อนไหม?",
    a: "ไม่ต้องฝากก่อน สมัครฟรี 100% กรอกข้อมูลน้อย ใช้เวลาไม่เกิน 10 วินาที ก็ได้ยูสเข้าดูเกม ทดลองระบบ และสำรวจบรรยากาศคลับก่อนตัดสินใจเติมจริงแบบไม่ผูกมัด",
  },
  {
    q: "SUPERCLUB168 มีค่ายเกมอะไรบ้าง และต้องโยกเงินไหม?",
    a: "ไลน์อัพครอบคลุม PG SOFT, Pragmatic Play, JILI, Joker, CQ9, Relax Gaming และ Hacksaw ทั้งหมดอยู่ในระบบกระเป๋าเดียว จึงเลือกเกมแล้วลุยได้ทันที ไม่ต้องโยกเงินหรือย้ายกระเป๋าระหว่างค่าย",
  },
];

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBoxCyberCut as="h1" title="SUPERCLUB168 สล็อตเว็บตรงAPIแท้ แตกถี่ โบนัสระดับซุปเปอร์เมกะ">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed">
        SUPERCLUB168 เปิดประตูต้อนรับคุณเข้าสู่อาณาจักรเดิมพันระดับ VVIP ที่ซึ่งคำว่า “แตกบ่อย” เป็นเรื่องปกติ และคำว่า “รางวัลใหญ่” คือมาตรฐานที่คุณคู่ควร
      </p>

      <p class="text-left text-base leading-relaxed">
        เราคือ สล็อตเว็บตรง API แท้ ที่ส่งตรงความแรงจากค่ายเกมระดับโลก มอบความเสถียรลื่นไหลให้คุณล่า โบนัสระดับซุปเปอร์เมกะ เราเตรียมแจ็คพอตก้อนโตและความสนุกสุดเหวี่ยงไว้รอเสิร์ฟตลอด 24 ชั่วโมง
        เข้ามาสัมผัสความ “SUPERCLUB168” ด้วยตัวคุณเอง
      </p>
    </div>
  </ContentBoxCyberCut>

  <SmoothCarousel />

  <ContentBox as="h2" title="ทำไมต้อง SUPERCLUB168 สล็อตเว็บตรงAPIแท้ ที่เสถียรที่สุด">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed">
        SUPERCLUB168 เลือกใช้ระบบโครงสร้างพื้นฐานที่ดีที่สุด โดยการเชื่อมต่อ API แท้ จากเซิร์ฟเวอร์หลักของผู้พัฒนาเกมโดยตรง ผลลัพธ์คือความลื่นไหลระดับหัวแตก!
      </p>

      <p class="text-left text-base leading-relaxed">
        คุณจะเล่นเกมได้แบบ Real-time ไม่มีดีเลย์ รักษาคุณภาพภาพสวยเสียงชัด และที่สำคัญคือค่า RTP (อัตราการชนะ) ที่เป็นของจริง ไม่มีการปรับลดเปอร์เซ็นต์
      </p>
    </div>
  </ContentBox>

  <ContentBoxSpecial as="h2" title="SUPERCLUB168 แตกบ่อย จ่ายหนักตรงเวลา ไม่อั้นถอน">
    <div slot="left" class="flex flex-col gap-3">
      <p class="text-left text-base leading-relaxed">
        แตกจริง จ่ายจริง ตรงเวลาไม่มีกั๊ก SUPERCLUB168 นี่แหละเว็บใหญ่ของจริง ที่นี่แตกถี่เพราะเกมเชื่อมตรงจากค่ายแม่ ค่า RTP เต็มระบบ โบนัสแรง ยอดเท่าไหร่ เราจ่ายทันที ไม่แบ่งจ่าย
      </p>
    </div>

    <div slot="right" class="flex flex-col gap-3">
      <p class="text-left text-base leading-relaxed">ถอนหลักร้อยหลักพัน ก็เด้งไวเหมือนเดิม ถอนหลักหมื่นหลักแสน ก็ไม่มีอาการสะดุด หรือทำทีว่าระบบขัดข้อง</p>

      <p class="text-left text-base leading-relaxed">ยอดใหญ่แค่ไหนก็กดถอนได้เต็มจำนวน ไม่อั้น ไม่จำกัดรอบ</p>
    </div>
  </ContentBoxSpecial>

  <LatestWinnersPremium />

  <ContentBoxSevenThree as="h2" titleright="โบนัสระดับซุปเปอร์เมกะ ได้ทุกการสปิน ทำได้ตลอดทั้งวัน">
    <Picture
      slot="left"
      src={imgBonus}
      alt={bonusAlt}
      loading="lazy"
      fetchpriority="low"
      widths={[240, 353, 480, 706]}
      sizes="(max-width: 767px) calc(100vw - 96px), 353px"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={70}
      class="mx-auto h-auto w-full rounded-2xl border border-[#16305f] shadow-[0_10px_30px_rgba(247,208,70,0.22)]"
    />

    <div slot="right" class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed">
        ลืมคำว่า “ช่วงเวลาโบนัส” แบบเดิมๆ ที่ต้องมารอนั่งเฝ้าหน้าจอไปได้เลยครับ! เพราะที่ SUPERCLUB168 เราปลดล็อกขีดจำกัดให้ทุกนาทีกลายเป็นนาทีทองของคุณ
      </p>

      <p class="text-left text-base leading-relaxed">
        ทำให้โอกาสในการคว้า โบนัสระดับซุปเปอร์เมกะ (Super Mega Win) เกิดขึ้นได้จริงใน ทุกการสปิน เสถียรเท่ากันทุกชั่วโมง ทุกการสปินมีสิทธิเข้าฟีเจอร์ใหญ่ ได้รางวัลหนัก
        และแตะซุปเปอร์เมกะได้เหมือนกันหมด
      </p>

      <p class="text-left text-base leading-relaxed">จะปั่นเบทเบา ๆ ก็มีลุ้น จะกดหนักต่อเนื่องก็แตกหนักสะใจ ทุกแนวการเล่นเรารองรับแบบแฟร์ 100% ไม่มีล็อกยูส ไม่มีแบ่งช่วง</p>
    </div>
  </ContentBoxSevenThree>

  <ContentBox3Three
    as="h2"
    title="ฝากถอนโอนไว ออโต้ ไม่มีขั้นต่ำ อิสระที่คุณเลือกได้"
    titleleft="ออโต้ไวเหมือนแสง"
    titlecenter="ไม่มีขั้นต่ำ ทุนเท่าไหร่ก็เริ่มได้"
    titleright="ธนาคารไทยและ True Money Wallet">
    <p slot="left" class="text-left text-base leading-relaxed">
      ระบบการเงินของ SUPERCLUB168 ทำงานด้วยระบบ AI อัจฉริยะที่ประมวลผลไวเหมือนแสง ฝากปุ๊บเครดิตเข้าปั๊บ ถอนปุ๊บเงินเด้งเข้าบัญชี
    </p>

    <p slot="center" class="text-left text-base leading-relaxed">
      สมาชิกทุกคนบริหารเงินทุนได้อย่างอิสระ ไม่มีขั้นต่ำ ในการฝากถอน จะมีทุนร้อยหรือทุนล้าน ก็ได้รับการดูแลรวดเร็วเท่าเทียมกัน
    </p>

    <p slot="right" class="text-left text-base leading-relaxed">จะใช้แอปธนาคารหรือ True Money Wallet ก็สะดวก ตอบโจทย์ไลฟ์สไตล์คนรุ่นใหม่ที่ชอบความรวดเร็วและง่ายดาย</p>
  </ContentBox3Three>

  <ContentBox as="h2" title="สมัครสมาชิกฟรี เข้าคลับได้ทันที ไม่ต้องเติมเงินก่อน">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed">สมัคร SUPERCLUB168 “ประตูคลับ” ให้ทุกคนฟรี ไม่ต้องเติมเงินก่อน ไม่ต้องใช้ข้อมูลส่วนตัวเยอะ</p>

      <p class="text-left text-base leading-relaxed">
        เพียงกรอกข้อมูลเบื้องต้น คุณจะได้ยูสพร้อมเข้าดูเกม ทดลองระบบ หรือสำรวจบรรยากาศคลับของเราก่อนตัดสินใจเติมจริง เพราะเรามั่นใจในคุณภาพ เลยยินดีให้คุณทดลองก่อนแบบไม่ผูกมัด
      </p>

      <a
        href="/register/"
        class="inline-flex w-fit items-center gap-2 rounded-full bg-gradient-to-r from-[#ffeeb8] via-[#ffd95e] to-[#c99a17] px-7 py-3 text-sm font-black tracking-widest text-[#03091f] shadow-[0_10px_30px_rgba(247,208,70,0.34)] transition-transform duration-300 hover:scale-105">
        <span aria-hidden="true">👑</span> สมัครสมาชิก SUPERCLUB168
      </a>
    </div>
  </ContentBox>

  <LoginRtpSection />

  <ContentBoxSevenThreeCyberCut as="h2" titleright="SUPERCLUB168 รวมค่ายเกมพรีเมียม ชั้นนำครบวงจร ระดับโลก">
    <Picture
      slot="left"
      src={imgProviders}
      alt={providersAlt}
      loading="lazy"
      fetchpriority="low"
      widths={[240, 346, 480, 692]}
      sizes="(max-width: 767px) calc(100vw - 96px), 346px"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={70}
      class="mx-auto h-auto w-full rounded-2xl border border-[#16305f] shadow-[0_10px_30px_rgba(247,208,70,0.22)]"
    />

    <div slot="right" class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed">SUPERCLUB168 รวบรวมค่ายเกมตัวท็อปมาเต็มไลน์อัพ เช่น</p>

      <FeatureHighlights items={providerPoints} />

      <p class="text-left text-base leading-relaxed">
        SUPERCLUB168 คือสล็อตเว็บตรง API แท้ ส่งตรงระบบจากค่ายเกมหลักระดับโลก ให้ความเสถียรสูง แตกบ่อย จ่ายหนัก พร้อมโบนัสซุปเปอร์เมกะได้ทุกการสปิน
      </p>

      <p class="text-left text-base leading-relaxed">แตกบ่อยจริงเพราะเชื่อม API แท้จากค่ายแม่ ไม่มีการปรับเรท ไม่มีล็อกยูส ค่า RTP ถูกต้องตามมาตรฐาน ทำให้โบนัสออกถี่และสม่ำเสมอ</p>

      <p class="text-left text-base leading-relaxed">ระบบฝากถอน Auto ของ SUPERCLUB168 ใช้เวลาเฉลี่ยเพียง 1–3 วินาที รองรับธนาคารไทยและทรูวอเล็ท ทำรายการได้ 24 ชั่วโมง</p>

      <p class="text-left text-base leading-relaxed">SUPERCLUB168 ไม่มีขั้นต่ำในการฝากและถอน ผู้เล่นสามารถเริ่มต้นได้ตั้งแต่ 1 บาท และถอนยอดได้เต็มจำนวนไม่อั้น</p>

      <p class="text-left text-base leading-relaxed">สมัครสมาชิก SUPERCLUB168 ฟรี 100% ไม่ต้องฝากก่อน กรอกข้อมูลน้อย ใช้เวลาไม่เกิน 10 วินาที พร้อมรับยูสเข้าเล่นได้ทันที</p>
    </div>
  </ContentBoxSevenThreeCyberCut>

