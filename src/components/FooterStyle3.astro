---
import { Picture } from "astro:assets";
import BankStrip from "./BankStrip.astro";
import { BRAND_ADDRESS, BRAND_NAME } from "../lib/brandProfile";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });

const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

const quickLinks = [
  { name: "หน้าแรก", path: "/" },
  { name: "โปรโมชั่น", path: "/promotion/" },
  { name: "ทดลองเล่น", path: "/ทดลองเล่น/" },
  { name: "วิธีฝากถอน", path: "/วิธีฝากถอน/" },
  { name: "ทางเข้า", path: "/ทางเข้า/" },
  { name: "เกี่ยวกับเรา", path: "/about-us/" },
  { name: "สมัครสมาชิก", path: "/register/" },
  { name: "เข้าสู่ระบบ", path: "/login/" },
  { name: "ติดต่อเรา", path: "/contact-us/" },
];

const logoAlt = "โลโก้ OHO555 ตัวอักษร OHO สีทองส้มและ 555 สีเขียวขาว แบบสามมิติ";
---

<footer class="relative mt-32 w-full border-t-4 border-[#fcaa04] bg-[#031208] pt-64 pb-6 font-sans text-[#e3eedf] shadow-[0_-10px_30px_rgba(1,10,3,0.35)] md:pt-40">
  <div
    class="absolute -top-14 left-1/2 z-20 flex w-[92%] max-w-5xl -translate-x-1/2 flex-col items-center justify-between rounded-2xl border border-[#ffd24d]/60 bg-gradient-to-r from-[#0d3d12] via-[#1d6b00] to-[#0d3d12] p-6 shadow-[0_15px_40px_rgba(252,170,4,0.22)] md:-top-16 md:flex-row md:p-8">
    <div class="mb-5 flex flex-col text-center md:mb-0 md:text-left">
      <p class="text-xl font-black tracking-wide text-white uppercase italic drop-shadow-[0_2px_4px_rgba(1,10,3,0.55)] md:text-3xl">
        <span aria-hidden="true">👑</span> สมัคร <span class="text-[#ffd24d]">{BRAND_NAME}</span> เว็บตรงไม่ผ่านเอเย่นต์
      </p>
      <p class="mt-2 text-sm font-medium text-white/90 md:text-base">
        ฝากถอนขั้นต่ำ 1 บาท ผ่านทรูวอเลทหรือบัญชีทุกธนาคาร สล็อตกระเป๋าเดียวทุกค่าย คาสิโนสดใช้ยูสเดียวกัน มีแอดมินดูแล 24 ชม.
      </p>
    </div>

    <a
      href="/register/"
      class="group relative flex items-center justify-center overflow-hidden rounded-full border border-[#ffe9a8] bg-gradient-to-b from-[#ffe08a] via-[#fcaa04] to-[#c77d00] px-8 py-3.5 text-sm font-extrabold whitespace-nowrap text-[#1a1000] shadow-[0_6px_18px_rgba(1,10,3,0.4)] transition-all hover:scale-105 hover:text-white md:text-base">
      <span class="relative z-10">สมัครสมาชิกเลย <span aria-hidden="true">🚀</span></span>
      <div aria-hidden="true" class="absolute inset-0 translate-y-full bg-[#d81e1e] transition-transform duration-300 group-hover:translate-y-0"></div>
    </a>
  </div>

  <div class="relative z-10 mx-auto max-w-[1200px] px-6">
    <div class="mb-10 grid grid-cols-1 gap-10 md:grid-cols-12 lg:gap-12">
      <div class="flex flex-col gap-6 md:col-span-12 lg:col-span-4">
        <a href="/" class="inline-block origin-left transition-transform hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt={logoAlt}
                widths={[120, 240, 360]}
                sizes="120px"
                loading="lazy"
                decoding="async"
                class="h-[56px] w-auto drop-shadow-[0_6px_18px_rgba(252,170,4,0.3)]"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <p class="inline-block bg-gradient-to-b from-[#ffe9a8] to-[#fcaa04] bg-clip-text px-1 text-3xl font-black text-transparent italic">{BRAND_NAME}</p>
            )
          }
        </a>
        <p class="text-sm leading-relaxed text-[#e3eedf]/85">
          {BRAND_NAME} เว็บตรงไม่ผ่านเอเย่นต์ สล็อตจาก PG Soft, Pragmatic Play และ Yggdrasil ใช้กระเป๋าเดียว ยูสเดียวกันเปิดโต๊ะสด SA Gaming กับ Sexy Baccarat ได้ทันที
          เล่นผ่านเบราว์เซอร์ทั้ง iOS และ Android ไม่ต้องโหลดแอป
        </p>

        <div class="mt-2 flex flex-wrap gap-3">
          <a
            href="/line/"
            class="flex items-center gap-2 rounded-full border border-[#00B900]/40 bg-[#00B900]/15 px-4 py-2 text-xs font-bold text-[#8fe6a8] shadow-[0_0_10px_rgba(0,185,0,0.15)] transition-colors hover:bg-[#00B900] hover:text-white">
            <span aria-hidden="true" class="text-base">💬</span> LINE OFFICIAL
          </a>
        </div>

        {
          BRAND_ADDRESS.lines.length > 0 && (
            <address aria-label={BRAND_ADDRESS.label} class="mt-2 rounded-xl border border-white/15 bg-black/20 p-4 text-xs leading-relaxed not-italic opacity-90">
              <p class="mb-2 flex items-center gap-2 text-[11px] font-bold tracking-wider uppercase opacity-80">
                <span aria-hidden="true" class="text-sm">📍</span>
                {BRAND_ADDRESS.label}
              </p>
              {BRAND_ADDRESS.lines.map((line) => (
                <span class="block">{line}</span>
              ))}
              {BRAND_ADDRESS.email && (
                <a href={`mailto:${BRAND_ADDRESS.email}`} class="mt-3 inline-flex items-center gap-2 font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                  <span aria-hidden="true" class="text-sm">✉️</span>
                  {BRAND_ADDRESS.email}
                </a>
              )}
            </address>
          )
        }
      </div>

      <div class="md:col-span-6 lg:col-span-5">
        <p class="relative mb-5 inline-block text-lg font-bold tracking-wider text-white uppercase">
          ลิงก์ด่วน (Quick Links)
          <span aria-hidden="true" class="absolute -bottom-2 left-0 h-1 w-1/2 rounded-full bg-gradient-to-r from-[#ffd24d] to-[#2f9e1f]"></span>
        </p>

        <div class="grid grid-cols-2 gap-x-4 gap-y-3 text-sm">
          {
            quickLinks.map((link) => (
              <a href={link.path} class="group flex items-center text-[#e3eedf]/85 transition-colors hover:text-[#ffd24d]">
                <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#fcaa04] transition-transform group-hover:rotate-45" />
                {link.name}
              </a>
            ))
          }
        </div>
      </div>

      <div class="md:col-span-6 lg:col-span-3">
        <p class="relative mb-5 inline-block text-lg font-bold tracking-wider text-white uppercase">
          ระบบการเงิน
          <span aria-hidden="true" class="absolute -bottom-2 left-0 h-1 w-1/2 rounded-full bg-gradient-to-r from-[#ffd24d] to-[#2f9e1f]"></span>
        </p>

        <p class="mb-4 text-xs text-[#e3eedf]/85">ฝากถอนขั้นต่ำ 1 บาท ผ่านทรูวอเลท (TrueMoney Wallet) หรือบัญชีทุกธนาคาร ระบบออโต้ปรับเครดิตให้เอง ไม่ต้องส่งสลิป ถอนกดเองได้จากหน้าเว็บ</p>

        <BankStrip size={30} />

        <div class="mt-3 flex h-10 items-center justify-center rounded border border-white/12 bg-[#0c2a12] transition-colors hover:border-[#fcaa04]/70">
          <span class="flex items-center gap-1 text-xs font-bold text-[#e3eedf]"><span aria-hidden="true" class="text-lg">⚡</span> ยอดไม่ขึ้น อย่าโอนซ้ำ ทักแอดมินได้ 24 ชม.</span>
        </div>
      </div>
    </div>

    <hr class="mb-6 border-white/15" />

    <div class="mb-6 hidden text-justify text-[10px] leading-relaxed text-[#e3eedf]/65 md:block">
      {BRAND_NAME} รวมสล็อตกระเป๋าเดียวทุกค่ายกับคาสิโนสดไว้ในยูสเดียว บาคาร่า เสือมังกร และรูเล็ตเปิดได้ทั้งบนมือถือ คอมพิวเตอร์ และแท็บเล็ต
      รับโปรใดไว้ให้อ่านเงื่อนไขในหน้าโปรโมชั่นก่อนกดรับ ถ้าโอนแล้วยอดไม่ขึ้นให้ส่งเวลาโอนกับจำนวนเงินให้แอดมิน และไม่ส่งรหัสผ่านหรือ OTP ให้ใครทั้งนั้น
    </div>

    <div class="flex flex-col items-center justify-between gap-4 border-t border-white/15 pt-6 text-xs text-[#e3eedf]/75 md:flex-row">
      <p>&copy; {new Date().getFullYear()} <span class="font-bold tracking-wider text-[#ffd24d] uppercase">{BRAND_NAME}</span>. All Rights Reserved.</p>

      <div class="flex items-center gap-6">
        <a href="/terms/" class="transition-colors hover:text-[#ffd24d]">เงื่อนไขและข้อตกลง</a>
        <a href="/privacy/" class="transition-colors hover:text-[#ffd24d]">นโยบายความเป็นส่วนตัว</a>

        <a
          href="#top"
          class="flex h-8 w-8 items-center justify-center rounded border border-white/25 bg-white/10 text-white transition-all hover:border-[#fcaa04] hover:bg-[#fcaa04] hover:text-[#1a1000] hover:shadow-[0_0_15px_rgba(252,170,4,0.45)]"
          aria-label="กลับขึ้นด้านบนสุดของหน้า">
          <span aria-hidden="true">↑</span>
        </a>
      </div>
    </div>
  </div>
</footer>
