---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";
---

<section class="relative z-10 my-6 flex w-full justify-center px-4 font-sans">
  <div
    class="w-full max-w-[1400px] rounded-[25px] border border-[#a855f7]/45 bg-[#0b011b] p-8 text-left text-base leading-relaxed text-[#e7dcf7] shadow-[10px_10px_20px_#000000,-10px_-10px_20px_#1e0c33]">
    {
      title && (
        <header class="mb-8 border-b border-[#a855f7]/30 pb-4 text-center">
          <HeadingTag class={`bg-gradient-to-r from-[#ffe9a8] via-[#f5c542] to-[#a3610c] bg-clip-text ${headingSize} leading-normal font-black tracking-wide text-transparent`}>{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
