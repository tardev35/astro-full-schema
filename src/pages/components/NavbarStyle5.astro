---
import { Picture } from "astro:assets";
const images = import.meta.glob<{ default: ImageMetadata }>("../../assets/logo.{png,webp,jpg}", { eager: true });

const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

const currentPath = Astro.url.pathname;

const isActive = (path: string) => {
  if (path === "/") return currentPath === "/";
  return currentPath.startsWith(path);
};
---

<header class="sticky top-0 z-50 w-full font-sans">
  <div class="hidden items-center justify-between border-b border-white/5 bg-[#0d0d12] px-6 py-1.5 text-xs font-medium tracking-wide lg:flex xl:px-10">
    <div class="flex items-center gap-2 text-gray-400">
      <span class="text-sm text-yellow-500">✦</span>
      ยินดีต้อนรับสู่เว็บสล็อตออโต้ที่ดีที่สุด ฝาก-ถอน รวดเร็ว 24 ชม.
    </div>
    <div class="flex items-center gap-5">
      <a href="/signin" class="flex items-center gap-1 text-gray-400 transition-colors hover:text-white">🔒 เข้าสู่ระบบ</a>
      <a href="/signup" class="flex items-center gap-1 font-bold text-yellow-400 transition-colors hover:text-yellow-300">🔥 สมัครสมาชิกใหม่รับโบนัส 100%</a>
    </div>
  </div>

  <nav class="relative z-[70] flex h-[70px] w-full items-center justify-between border-b border-white/10 bg-[#151520]/95 px-4 shadow-2xl backdrop-blur-md xl:px-10">
    <a href="/" class="z-50 flex-shrink-0 transition-transform hover:scale-105">
      <Picture src={mainLogo!} alt="Main Logo" loading="eager" fetchpriority="high" class="h-[35px] w-auto drop-shadow-lg xl:h-[40px]" formats={["avif", "webp"]} fallbackFormat="webp" />
    </a>

    <div class="hidden h-full items-center gap-6 lg:flex xl:gap-10">
      <a href="/" class={`group relative h-full flex items-center text-sm xl:text-base font-bold transition-colors ${isActive("/") ? "text-white" : "text-gray-400 hover:text-white"}`}>
        <span>หน้าแรก</span>
        <div class={`absolute bottom-[-1px] left-0 w-full h-[3px] bg-yellow-400 transition-transform duration-300 origin-left ${isActive("/") ? "scale-x-100" : "scale-x-0 group-hover:scale-x-100"}`}>
        </div>
      </a>

      <a
        href="/promotion"
        class={`group relative h-full flex items-center text-sm xl:text-base font-bold transition-colors ${isActive("/promotion") ? "text-white" : "text-gray-400 hover:text-white"}`}>
        <span>โปรโมชั่น</span>
        <div
          class={`absolute bottom-[-1px] left-0 w-full h-[3px] bg-yellow-400 transition-transform duration-300 origin-left ${isActive("/promotion") ? "scale-x-100" : "scale-x-0 group-hover:scale-x-100"}`}>
        </div>
      </a>

      <a href="/gamedemo" class={`group relative h-full flex items-center text-sm xl:text-base font-bold transition-colors ${isActive("/gamedemo") ? "text-white" : "text-gray-400 hover:text-white"}`}>
        <span>ทดลองเล่น</span>
        <div
          class={`absolute bottom-[-1px] left-0 w-full h-[3px] bg-yellow-400 transition-transform duration-300 origin-left ${isActive("/gamedemo") ? "scale-x-100" : "scale-x-0 group-hover:scale-x-100"}`}>
        </div>
      </a>

      <a
        href="/gamelogin"
        class={`group relative h-full flex items-center text-sm xl:text-base font-bold transition-colors ${isActive("/gamelogin") ? "text-white" : "text-gray-400 hover:text-white"}`}>
        <span>ทางเข้า</span>
        <div
          class={`absolute bottom-[-1px] left-0 w-full h-[3px] bg-yellow-400 transition-transform duration-300 origin-left ${isActive("/gamelogin") ? "scale-x-100" : "scale-x-0 group-hover:scale-x-100"}`}>
        </div>
      </a>

      <a href="/contact" class={`group relative h-full flex items-center text-sm xl:text-base font-bold transition-colors ${isActive("/contact") ? "text-white" : "text-gray-400 hover:text-white"}`}>
        <span>ติดต่อเรา</span>
        <div
          class={`absolute bottom-[-1px] left-0 w-full h-[3px] bg-yellow-400 transition-transform duration-300 origin-left ${isActive("/contact") ? "scale-x-100" : "scale-x-0 group-hover:scale-x-100"}`}>
        </div>
      </a>
    </div>

    <div class="z-50 flex items-center gap-4">
      <a
        href="/signup"
        class="hidden items-center justify-center rounded-full bg-white px-6 py-2 text-sm font-extrabold text-black shadow-[0_0_15px_rgba(255,255,255,0.3)] transition-all hover:scale-105 hover:bg-gray-200 lg:flex">
        สมัครสมาชิก
      </a>

      <button id="hamburger-btn" class="relative flex h-[40px] w-[40px] flex-col items-end justify-center gap-[6px] p-2 lg:hidden" aria-label="Menu">
        <span class="line-1 h-[2px] w-6 origin-center rounded-full bg-white transition-all duration-300"></span>
        <span class="line-2 h-[2px] w-4 origin-center rounded-full bg-white transition-all duration-300"></span>
      </button>
    </div>
  </nav>

  <div id="fullscreen-menu" class="pointer-events-none fixed inset-0 z-[60] flex flex-col items-center justify-center bg-[#0d0d12]/98 opacity-0 backdrop-blur-2xl transition-opacity duration-500">
    <div class="flex w-full flex-col items-center space-y-6 px-6">
      <a
        href="/"
        class={`fs-item text-3xl font-black uppercase tracking-widest transition-all duration-300 ${isActive("/") ? "text-yellow-400" : "text-transparent bg-clip-text bg-gradient-to-r from-white to-gray-500 hover:text-white"}`}>
        หน้าแรก
      </a>
      <a
        href="/promotion"
        class={`fs-item text-3xl font-black uppercase tracking-widest transition-all duration-300 ${isActive("/promotion") ? "text-yellow-400" : "text-transparent bg-clip-text bg-gradient-to-r from-white to-gray-500 hover:text-white"}`}>
        โปรโมชั่น
      </a>
      <a
        href="/gamedemo"
        class={`fs-item text-3xl font-black uppercase tracking-widest transition-all duration-300 ${isActive("/gamedemo") ? "text-yellow-400" : "text-transparent bg-clip-text bg-gradient-to-r from-white to-gray-500 hover:text-white"}`}>
        ทดลองเล่น
      </a>
      <a
        href="/gamelogin"
        class={`fs-item text-3xl font-black uppercase tracking-widest transition-all duration-300 ${isActive("/gamelogin") ? "text-yellow-400" : "text-transparent bg-clip-text bg-gradient-to-r from-white to-gray-500 hover:text-white"}`}>
        ทางเข้า
      </a>
      <a
        href="/contact"
        class={`fs-item text-3xl font-black uppercase tracking-widest transition-all duration-300 ${isActive("/contact") ? "text-yellow-400" : "text-transparent bg-clip-text bg-gradient-to-r from-white to-gray-500 hover:text-white"}`}>
        ติดต่อเรา
      </a>

      <div class="fs-item mt-4 flex w-full max-w-[250px] flex-col gap-4 pt-8">
        <a href="/signup" class="flex w-full items-center justify-center rounded-full bg-white py-3.5 text-lg font-extrabold text-black shadow-[0_0_20px_rgba(255,255,255,0.4)]">สมัครสมาชิก</a>
        <a href="/signin" class="flex w-full items-center justify-center rounded-full border border-white/20 py-3.5 text-lg font-bold text-white transition-colors hover:bg-white/10">เข้าสู่ระบบ</a>
      </div>
    </div>
  </div>
</header>

<style is:global>
  nav,
  header {
    font-family: kanit, sans-serif !important;
  }
  /* อนิเมชันปุ่ม Hamburger (จาก 2 เส้นไม่เท่ากัน กลายเป็นกากบาท X) */
  #hamburger-btn.active .line-1 {
    transform: translateY(4px) rotate(45deg);
  }
  #hamburger-btn.active .line-2 {
    width: 24px; /* ยืดเส้นที่ 2 ให้ยาวเท่าเส้นแรก */
    transform: translateY(-4px) rotate(-45deg);
  }

  /* อนิเมชันข้อความเด้งขึ้นมาจากด้านล่างทีละบรรทัด */
  .fs-item {
    opacity: 0;
    transform: translateY(30px) scale(0.9);
    transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .fs-item.show {
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  /* หน่วงเวลาให้ข้อความเด้งไล่ระดับ */
  .fs-item:nth-child(1) {
    transition-delay: 0.1s;
  }
  .fs-item:nth-child(2) {
    transition-delay: 0.15s;
  }
  .fs-item:nth-child(3) {
    transition-delay: 0.2s;
  }
  .fs-item:nth-child(4) {
    transition-delay: 0.25s;
  }
  .fs-item:nth-child(5) {
    transition-delay: 0.3s;
  }
  .fs-item:nth-child(6) {
    transition-delay: 0.4s;
  }
</style>

<script>
  const hamburgerBtn = document.getElementById("hamburger-btn");
  const fsMenu = document.getElementById("fullscreen-menu");
  const fsItems = document.querySelectorAll(".fs-item");

  const toggleFsMenu = () => {
    // 1. สลับหน้าตาปุ่ม Hamburger
    hamburgerBtn?.classList.toggle("active");

    // 2. โชว์/ซ่อน ฉากหลัง Fullscreen
    fsMenu?.classList.toggle("opacity-0");
    fsMenu?.classList.toggle("pointer-events-none");

    // 3. จัดการอนิเมชันตัวหนังสือ & ล็อกหน้าจอ
    if (!fsMenu?.classList.contains("opacity-0")) {
      document.body.style.overflow = "hidden";
      // เติมคลาสให้ตัวหนังสือเด้งขึ้นมา
      fsItems.forEach((item) => item.classList.add("show"));
    } else {
      document.body.style.overflow = "";
      // ถอดคลาสออก เพื่อให้ตัวหนังสือมุดกลับลงไป
      fsItems.forEach((item) => item.classList.remove("show"));
    }
  };

  hamburgerBtn?.addEventListener("click", toggleFsMenu);

  // ปิดเมนูเวลากดลิงก์
  fsItems.forEach((item) => {
    item.addEventListener("click", () => {
      if (!fsMenu?.classList.contains("opacity-0")) {
        toggleFsMenu();
      }
    });
  });
</script>
