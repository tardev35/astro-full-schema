---
import ContentBoxTwoPremium from "./ContentBoxTwoPremium.astro";

const steps = [
  { icon: "📝", name: "สมัครยูสด้วยข้อมูลเท่าที่จำเป็น", detail: "ใช้ข้อมูลเท่าที่จำเป็นต่อการเปิดยูสและยืนยันเจ้าของบัญชี ตั้งรหัสผ่านที่ไม่ซ้ำกับบัญชีอื่นของตัวเอง", tag: "ขั้นที่ 1" },
  { icon: "🔑", name: "เข้าสู่ระบบด้วยยูสเดียว", detail: "ยูสนี้เชื่อมทั้งการเล่น ยอดเงิน และประวัติการทำรายการไว้ด้วยกัน จึงควรเก็บข้อมูล Login ไว้กับตัวเอง", tag: "ขั้นที่ 2" },
  { icon: "🦈", name: "เลือกค่ายจากระบบตรง", detail: "เข้าเลือกเกมจากค่ายที่เปิดให้บริการได้ทันที ตารางจ่าย ฟีเจอร์โบนัส และ RTP อ่านได้จากหน้าของเกม", tag: "ขั้นที่ 3" },
  { icon: "⚡", name: "ส่งคำขอฝากถอนออโต้", detail: "ระบบรับคำขอ ตรวจสอบข้อมูล และอัปเดตสถานะให้เอง ส่งแล้วเช็กสถานะในระบบก่อนทำรายการครั้งใหม่", tag: "ขั้นที่ 4" },
  { icon: "💰", name: "ยืนยันแล้วรับยอดเต็มทุกบิล", detail: "ดูยอดคงเหลือ ยอดถอน และเงื่อนไขของสิทธิ์ที่ใช้อยู่ก่อนกดยืนยัน ยอดที่ได้จากระบบไม่ถูกลดทอน", tag: "ขั้นที่ 5" },
];

const chips = ["เว็บนอกลิขสิทธิ์แท้", "ระบบตรง", "ยูสเดียวจบ", "ฝากออโต้", "ถอนออโต้", "จ่ายเต็มทุกบิล", "ดูตารางจ่ายได้", "เล่นบนมือถือ", "ใช้ได้ทุกอุปกรณ์", "ปลอดภัย 100%"];
---

<ContentBoxTwoPremium
  titleleft="เข้าสู่ระบบ BABYSHARK8899"
  titleright="ลำดับการใช้งานตั้งแต่สมัครถึงถอนยอด"
  label="เข้าสู่ระบบ BABYSHARK8899 และลำดับการใช้งานตั้งแต่สมัครถึงถอนยอด">
  <div slot="left" class="flex h-full flex-col gap-4">
    <div class="relative overflow-hidden rounded-2xl border border-[#0a2258] bg-[#04143c] p-6 shadow-[0_10px_30px_rgba(11,131,250,0.18)]">
      <div aria-hidden="true" class="pointer-events-none absolute -top-10 -right-10 h-32 w-32 rounded-full bg-[#0b83fa]/18 blur-[50px]"></div>

      <div class="relative z-10 mb-5 flex items-center gap-3">
        <span
          aria-hidden="true"
          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#00397f] bg-gradient-to-br from-[#9ed4ff] via-[#38a9ff] to-[#0057c7] text-xl shadow-inner">
          🦈
        </span>
        <div class="flex flex-col">
          <p class="text-base font-black text-[#6cc5ff]">ล็อกอินแล้วจัดการทุกขั้นตอนได้จากยูสของตัวเอง</p>
          <span class="text-[11px] text-[#9fb8dc]">
            ยูสเดียวใช้ได้ทั้งการเข้าเล่นเกมและการทำรายการฝากถอน ตรวจยอดคงเหลือ ดูสถานะรายการ และย้อนดูประวัติการทำรายการได้จากหน้าเมมเบอร์
          </span>
        </div>
      </div>

      <div class="relative z-10 flex flex-col gap-3.5">
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#0b83fa]">👤</span>
          <input
            type="text"
            placeholder="เบอร์โทรศัพท์ / ยูสเซอร์เนม"
            class="w-full rounded-xl border border-[#0a2258] bg-[#000b24] py-3 pr-4 pl-12 text-[#dbe9ff] transition-all outline-none placeholder:text-[#9fb8dc] focus:border-[#0b83fa] focus:ring-1 focus:ring-[#0b83fa]/50"
          />
        </div>
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#0b83fa]">🔑</span>
          <input
            type="password"
            placeholder="รหัส PIN 4 หลัก"
            class="w-full rounded-xl border border-[#0a2258] bg-[#000b24] py-3 pr-4 pl-12 text-[#dbe9ff] transition-all outline-none placeholder:text-[#9fb8dc] focus:border-[#0b83fa] focus:ring-1 focus:ring-[#0b83fa]/50"
          />
        </div>

        <div class="flex items-center justify-between px-1 text-xs">
          <label class="flex items-center gap-2 text-[#9fb8dc]">
            <input type="checkbox" class="h-3.5 w-3.5 rounded border-[#0a2258] bg-[#000b24] accent-[#0b83fa]" />
            จดจำฉันไว้
          </label>
          <a href="/login" class="text-[#9fb8dc] transition-colors hover:text-[#6cc5ff]">ลืมรหัส PIN?</a>
        </div>

        <button
          class="mt-1 w-full rounded-xl border border-[#00397f] bg-gradient-to-r from-[#9ed4ff] via-[#38a9ff] to-[#0057c7] p-3.5 font-black text-[#000b24] shadow-[0_10px_30px_rgba(11,131,250,0.34)] transition-all hover:scale-[1.02] hover:shadow-[0_15px_40px_rgba(11,131,250,0.44)]">
          เข้าสู่ระบบ
        </button>

        <div class="flex items-center gap-3 py-1 text-[11px] text-[#9fb8dc]">
          <span class="h-px flex-1 bg-[#0a2258]"></span>
          หรือ
          <span class="h-px flex-1 bg-[#0a2258]"></span>
        </div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] p-3 text-sm font-bold text-white shadow-md transition-all hover:scale-[1.02]">
          <span aria-hidden="true">💬</span> ทักไลน์ทีมงานตลอด 24 ชั่วโมง
        </a>

        <div class="mt-1 flex items-center justify-between px-1">
          <div class="flex gap-2">
            <span class="rounded-full border border-[#0a2258] bg-[#000b24] px-2.5 py-1 text-[10px] font-bold text-[#6cc5ff]"><span aria-hidden="true">🔒</span> ดูแลข้อมูลสมาชิก</span>
            <span class="rounded-full border border-[#6e0a10] bg-[#000b24] px-2.5 py-1 text-[10px] font-bold text-[#ff8080]"><span aria-hidden="true">📱</span> ใช้ได้ทุกอุปกรณ์</span>
          </div>
          <a href="/register" class="text-xs font-bold text-[#9fb8dc] transition-colors hover:text-[#6cc5ff]">สมัครสมาชิกใหม่</a>
        </div>
      </div>
    </div>
  </div>

  <div slot="right" class="h-full">
    <div class="flex h-full flex-col rounded-2xl border border-[#0a2258] bg-[#04143c] p-5 shadow-[0_10px_30px_rgba(11,131,250,0.18)]">
      <div class="mb-5 flex items-center justify-between gap-3">
        <div>
          <span class="text-xs font-bold tracking-wide text-[#9fb8dc]">ลำดับการใช้งานที่ BABYSHARK8899 วางไว้ ตั้งแต่เปิดยูสจนถอนยอดออก อยู่ในระบบออโต้ชุดเดียวกันทั้งหมด</span>
          <div class="bg-gradient-to-r from-[#9ed4ff] via-[#38a9ff] to-[#ff8080] bg-clip-text text-2xl font-black text-transparent sm:text-3xl">สมัคร • ล็อกอิน • เล่น • ถอน</div>
        </div>
        <span class="flex items-center gap-1.5 self-start rounded-full border border-green-400/40 bg-[#000b24] px-2.5 py-1">
          <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-green-400 shadow-[0_0_8px_rgba(74,222,128,0.7)]"></span>
          <span class="text-[10px] font-bold tracking-widest text-green-400 uppercase">Live</span>
        </span>
      </div>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#9fb8dc] uppercase">
        <span>ขั้นตอนการใช้งาน</span>
        <span>ลำดับ</span>
      </div>

      <div class="flex flex-1 flex-col gap-2.5">
        {
          steps.map((s) => (
            <div class="rounded-xl border border-[#0a2258] bg-[#000b24] px-3.5 py-2.5 transition-colors hover:border-[#0b83fa]/55 hover:bg-[#0a2258]">
              <div class="flex items-center justify-between gap-2 text-sm">
                <span class="flex min-w-0 items-center gap-2 font-bold text-[#dbe9ff]">
                  <span aria-hidden="true" class="w-5 shrink-0 text-center">
                    {s.icon}
                  </span>{" "}
                  <span class="truncate">{s.name}</span>
                </span>
                <span class="shrink-0 rounded-full border border-[#6e0a10] bg-[#04143c] px-2.5 py-0.5 text-[10px] font-bold text-[#ff8080]">{s.tag}</span>
              </div>
              <div class="mt-1.5 text-[11px] tracking-wide text-[#9fb8dc]">{s.detail}</div>
            </div>
          ))
        }
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
        {chips.map((c) => <span class="rounded-full border border-[#0a2258] bg-[#000b24] px-3 py-1 text-[10px] font-bold text-[#6cc5ff]">{c}</span>)}
      </div>

      <div class="mt-3 text-center text-[10px] tracking-wide text-[#9fb8dc]">
        ลำดับในตารางสรุปจากที่หน้าเว็บแสดงไว้ เงื่อนไขการทำรายการ วงเงินต่อรายการ และข้อกำหนดของสิทธิ์ที่กำลังใช้งานให้ยึดตามคู่มือและหน้าเมมเบอร์ของ BABYSHARK8899 ก่อนทำรายการทุกครั้ง
        และอย่าบอกรหัสผ่านหรือ OTP กับใคร หากติดขัดตรงไหนทักไลน์ทีมงานได้ตลอด 24 ชั่วโมง
      </div>
    </div>
  </div>
</ContentBoxTwoPremium>
