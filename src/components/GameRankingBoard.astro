---
import { Picture } from "astro:assets";
import img1 from "../assets/providers/game1.avif";
import img2 from "../assets/providers/game2.avif";
import img3 from "../assets/providers/game3.avif";
import img4 from "../assets/providers/game4.avif";
import img5 from "../assets/providers/game5.avif";
import img6 from "../assets/providers/game6.avif";

const games = [
  { rank: 1, name: "บาคาร่าโต๊ะสด", type: "หมวดหลักที่สมาชิก OKHENG เข้าบ่อยที่สุด เลือกโต๊ะตามจังหวะที่ถนัดแล้วย้ายห้องได้ตลอด", menus: ["โต๊ะสด", "เรียลไทม์"], players: 5124, img: img4 },
  { rank: 2, name: "คาสิโนสดห้องอื่น ๆ", type: "ห้องเล่นสดแบบอื่นสำหรับคนที่ชอบไล่ดูหลายห้องก่อนเลือกลงเดิมพัน", menus: ["ห้องสด", "เลือกต่อได้"], players: 3842, img: img5 },
  { rank: 3, name: "สล็อตลิขสิทธิ์หลายค่าย", type: "รวมสล็อตลิขสิทธิ์จากผู้ให้บริการหลายเจ้า เลือกค่ายหรือหมวดก่อนแล้วค่อยเปิดเกม", menus: ["หลายค่าย", "ลิขสิทธิ์แท้"], players: 3517, img: img2 },
  { rank: 4, name: "สล็อตเกมโบนัสและฟรีสปิน", type: "หมวดเกมที่มีรอบโบนัสในตัว เหมาะกับคนที่ชอบรอฟีเจอร์มากกว่าหมุนรัวยาว", menus: ["เกมโบนัส", "ฟรีสปิน"], players: 2905, img: img6 },
  { rank: 5, name: "สล็อตคลาสสิกและธีมใหม่", type: "ทั้งวงล้อแบบคลาสสิกและเกมธีมใหม่จากค่ายที่เพิ่งเปิดให้เล่น หาเจอจากหน้ารวมเกม", menus: ["ตามธีม", "ของใหม่"], players: 2431, img: img3 },
  { rank: 6, name: "เกมที่เล่นล่าสุดและรายการโปรด", type: "กลับไปเปิดโต๊ะหรือเกมที่เคยเล่นได้ทันทีจากหน้าเมมเบอร์ OKHENG", menus: ["เล่นประจำ", "รายการโปรด"], players: 2108, img: img1 },
];

const medal = (rank: number) => (rank === 1 ? "🥇" : rank === 2 ? "🥈" : rank === 3 ? "🥉" : null);
---

<section aria-label="หมวดเกมที่สมาชิก OKHENG เลือกเปิดใช้บ่อย" class="mx-auto w-full max-w-[1300px] px-4 py-8 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <span aria-hidden="true" class="text-2xl">🏆</span>
    <p class="bg-gradient-to-r from-[#ff3d63] via-[#f9dfe3] to-[#f0b429] bg-clip-text text-2xl font-black tracking-widest text-transparent uppercase">หมวดเกมที่สมาชิก OKHENG เปิดใช้บ่อยที่สุด</p>
    <p class="max-w-3xl text-base leading-relaxed text-[#f9dfe3]">
      ทุกหมวดในตารางนี้เชื่อมผ่าน API แท้เข้ากับยูสและเครดิตชุดเดียวกัน สลับจากโต๊ะบาคาร่าไปสล็อตลิขสิทธิ์ได้โดยไม่ต้องออกจากระบบ ลำดับความนิยมขยับตามคนที่เข้ามาใช้งานในแต่ละช่วง
      ไม่ได้แปลว่าหมวดไหนให้อัตราจ่ายดีกว่าหมวดไหน เลือกจากสไตล์ที่ถนัดแล้วเข้าเล่นต่อจากหน้าเมมเบอร์ได้เลย
    </p>
    <div class="mt-2 h-[3px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#ed0133] to-transparent"></div>
  </div>

  <div class="flex flex-col gap-3">
    {
      games.map((g) => {
        const top = g.rank === 1;
        return (
          <article
            class={`group relative flex items-center gap-3 overflow-hidden rounded-2xl border p-3 transition-all duration-300 hover:-translate-y-0.5 sm:gap-5 sm:p-4 ${
              top
                ? "border-[#ed0133]/60 bg-gradient-to-r from-[#3a070f] via-[#2a0509] to-[#2e1c05] shadow-[0_15px_40px_rgba(237,1,51,0.26)]"
                : "border-[#6b0d1e] bg-[#2a0509] shadow-[0_10px_30px_rgba(237,1,51,0.14)] hover:border-[#ed0133]/60 hover:shadow-[0_15px_40px_rgba(237,1,51,0.26)]"
            }`}>
            <div
              aria-hidden="true"
              class="pointer-events-none absolute top-1/2 -left-10 h-24 w-24 -translate-y-1/2 rounded-full bg-[#ed0133]/16 blur-[40px] transition-all duration-500 group-hover:bg-[#f0b429]/20"
            />

            <div class="relative z-10 flex w-8 shrink-0 flex-col items-center justify-center sm:w-12">
              {medal(g.rank) ? (
                <span class="text-2xl sm:text-3xl">
                  <span aria-hidden="true">{medal(g.rank)}</span>
                  <span class="sr-only">อันดับ {g.rank}</span>
                </span>
              ) : (
                <span class="text-xl font-black text-[#ff3d63] sm:text-2xl">#{g.rank}</span>
              )}
            </div>

            <div class={`relative z-10 h-14 w-14 shrink-0 overflow-hidden rounded-xl border sm:h-16 sm:w-16 ${top ? "border-[#ed0133]/60" : "border-[#6b0d1e]"}`}>
              <Picture
                src={g.img}
                alt={`ภาพหน้าปกเกมของหมวด ${g.name} บนกระดานหมวดเกมยอดนิยมของ OKHENG`}
                formats={["avif", "webp"]}
                fallbackFormat="webp"
                loading="lazy"
                fetchpriority="low"
                widths={[100, 200]}
                quality={60}
                sizes="(max-width: 640px) 56px, 64px"
                decoding="async"
                class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-110"
              />
            </div>

            <div class="relative z-10 min-w-0 flex-1">
              <div class="flex items-center gap-2">
                <p class="truncate text-base font-black text-[#ffdb7d] sm:text-lg">{g.name}</p>
                {top && (
                  <span class="hidden shrink-0 rounded-full border border-[#ed0133]/50 bg-[#3a070f] px-2 py-0.5 text-[9px] font-black tracking-wider text-[#f0b429] sm:inline">ยอดนิยมสูงสุด</span>
                )}
              </div>
              <p class="truncate text-[11px] text-[#e0b6bd] sm:text-xs">{g.type}</p>

              <div class="mt-2 flex flex-wrap items-center gap-1.5">
                {g.menus.map((m) => (
                  <span class="rounded-full border border-[#6b0d1e] bg-[#170206] px-2.5 py-0.5 text-[10px] font-bold text-[#ff3d63]">{m}</span>
                ))}
              </div>
            </div>

            <div class="relative z-10 hidden shrink-0 flex-col items-end gap-1 sm:flex">
              <span class="flex items-center gap-1.5 text-[11px] text-[#e0b6bd]">
                <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-green-400 shadow-[0_0_6px_rgba(74,222,128,0.7)]" />
                <span class="tabular-nums" data-players data-base={g.players}>
                  {g.players.toLocaleString("en-US")}
                </span>{" "}
                ออนไลน์
              </span>
              <a
                href="/register"
                class={`rounded-full px-4 py-1.5 text-xs font-black transition-transform hover:scale-105 ${
                  top
                    ? "bg-gradient-to-r from-[#ffdb7d] via-[#f0b429] to-[#a8710c] text-[#170206] shadow-[0_10px_30px_rgba(237,1,51,0.28)]"
                    : "border border-[#6b0d1e] bg-[#170206] text-[#ff3d63] hover:border-[#ed0133]/60 hover:bg-[#3a070f]"
                }`}>
                เข้าดูหมวดนี้
              </a>
            </div>
          </article>
        );
      })
    }
  </div>
</section>

<script>
  import { startLiveCounters } from "../lib/liveCounter";

  startLiveCounters();
</script>
