---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/Announcement6.astro";
import ContentBox from "../components/ContentBox.astro";
import ContentBoxPremium from "../components/ContentBoxPremium.astro";
import ContentBoxCyberCut from "../components/ContentBoxCyberCut.astro";
import ContentBoxTwoPremium from "../components/ContentBoxTwoPremium.astro";
import ContentBoxSevenThreePremium from "../components/ContentBoxSevenThreePremium.astro";
import ContentBoxSevenThreeCyberCut from "../components/ContentBoxSevenThreeCyberCut.astro";
import FeatureHighlights from "../components/FeatureHighlights.astro";
import SmoothCarousel from "../components/SmoothCarousel.astro";
import GameRankingBoard from "../components/GameRankingBoard.astro";
import ProviderGrid from "../components/ProviderGrid.astro";
import LatestWinnersPremium from "../components/LatestWinnersPremium.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import ReviewCardSumo2 from "../components/ReviewCardSumo2.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import imgAllStyles from "../assets/slide2.png";
import imgStable from "../assets/slide3.png";

const pageTitle = "TGA99 สล็อต คาสิโนสด หวย ยิงปลา บัญชีเดียว ฝากถอนออโต้ 24 ชม.";

const pageDescription =
  "ทางเข้า TGA99 รวมสล็อตโบนัสแตกถี่จ่ายหนัก คาสิโนสดภาพคมชัด หวยครบไม่อั้นเลข เกมยิงปลาปลาบอสโบนัสใหญ่ ฝากถอนออโต้บัญชีเดียวตลอด 24 ชม. สมัครเข้าเล่นเลย";

const announcementMessage =
  "TGA99 สล็อต คาสิโนสด หวย ยิงปลา บัญชีเดียว • ฝากถอนออโต้ตลอด 24 ชั่วโมง ฝากขั้นต่ำ 20 บาท ถอนขั้นต่ำ 50 บาท • โอนได้จากทุกธนาคารและทรูวอเลท ไม่ต้องแนบสลิป • สลับหมวดเล่นต่อได้ทันที ไม่ต้องโยกเครดิต";

const allStylesAlt = "TGA99 สนุกครบทุกสไตล์ รวมเกมยอดนิยมไว้ในที่เดียว ปุ่มเริ่มสนุก";

const stableAlt = "TGA99 มั่นใจทุกการใช้งาน ระบบเสถียร ใช้งานลื่นไหล ปุ่มสมัครเลย";

const games = [
  {
    icon: "🐱",
    title: "Lucky Neko (PG Soft)",
    description: "เกมแมวกวักที่ตัวคูณเพิ่มขึ้นเมื่อมีสัญลักษณ์แมวเข้ามาในชุดชนะ จุดลุ้นอยู่ที่ตัวคูณมากกว่าการรอแตกใหญ่ทีเดียว",
    accent: "magenta" as const,
  },
  {
    icon: "⚡",
    title: "Gates of Olympus (Pragmatic Play)",
    description: "เกมเทพซุสใช้ระบบสัญลักษณ์ร่วงหล่น พร้อมลูกแก้วสายฟ้าที่สุ่มตัวคูณมาทบยอดในรอบโบนัส",
    accent: "gold" as const,
  },
  {
    icon: "🀄",
    title: "Mahjong Ways 2 (PG Soft)",
    description: "สล็อตไพ่นกกระจอกที่สัญลักษณ์กรอบทองในชุดชนะจะกลายเป็นไวลด์ ส่วนตัวคูณขยับขึ้นตามจำนวนครั้งที่ชนะต่อเนื่องในสปินเดียว",
    accent: "magenta" as const,
  },
  {
    icon: "🏛️",
    title: "Roma (Joker)",
    description: "เกมเก่าที่คนเล่นรุ่นแรกคุ้นมือ สแกตเตอร์ 3 ตัวพาเข้าฟรีสปิน แล้วมีโบนัสสู้สิงโตให้ลุ้นในรอบนั้น",
    accent: "gold" as const,
  },
];

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
});

const inlineLink = "font-bold text-[#ffe08a] underline underline-offset-4 transition-colors hover:text-[#f5c542]";
const slideFrame = "mx-auto h-auto w-full rounded-2xl border border-[#5a1a60] shadow-[0_10px_30px_rgba(193,63,196,0.25)]";
const body = "text-left text-base leading-relaxed";
const listItem = "rounded-xl border-l-4 border-[#c13fc4] bg-[#26082c] px-4 py-3";
const listLabel = "font-black text-[#ffe08a]";
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement message={announcementMessage} />

  <SmoothCarousel />

  <ContentBoxPremium as="h1" title="TGA99 สล็อต คาสิโนสด หวย ยิงปลา บัญชีเดียว ฝากถอนออโต้ตลอด 24 ชม.">
    <p class={body}>
      บางวันคุณอาจอยากหมุนวงล้อสั้นๆ หรือเปิดโต๊ะไพ่ดูเค้าไพ่สด TGA99 จึงรวมทั้งสี่หมวดไว้ในบัญชีเดียวและกระเป๋าเงินเดียวโดยไม่ต้องจำรหัสผ่านหลายที่ เริ่มตั้งแต่สล็อตโบนัสแตกถี่ที่จ่ายหนักจ่ายจริง คาสิโนสดภาพคมชัดจากห้องดีลเลอร์ หวยออนไลน์ครบตลาดแบบไม่อั้นเลข ไปจนถึงเกมยิงปลาที่ได้เล็งปลาบอสโบนัสใหญ่ เรื่องเงินจัดการผ่านฝากถอนออโต้ซึ่งทำรายการเองได้ทั้งวันทั้งคืน ฝากเริ่ม 20 บาท ถอนขั้นต่ำ 50 บาท สลับหมวดเล่นต่อได้ทันทีโดยไม่ต้องโยกเครดิต
    </p>
  </ContentBoxPremium>

  <ContentBoxCyberCut as="h2" title="สล็อต TGA99 โบนัสแตกถี่ จ่ายหนักจ่ายจริงจากค่ายฮิต">
    <p class={body}>
      อยากได้เกมที่โบนัสออกถี่แต่ไม่อยากเปิดหลายแท็บไล่เทียบข้ามเว็บ หมวดสล็อตที่นี่รวมเกมที่มีฟีเจอร์ดันตัวคูณในรอบโบนัสไว้ให้แล้ว โดยมีเกมหลักจากค่ายที่คนเล่นคุ้นมืออย่าง PG Soft, Pragmatic Play และ Joker ให้เลือกตามสไตล์การเดินเบท ยอดที่ชนะมากดถอนออกด้วยระบบออโต้ได้โดยไม่ต้องรอแอดมิน
    </p>

    <FeatureHighlights items={games} as="p" />
  </ContentBoxCyberCut>

  <ProviderGrid />

  <GameRankingBoard />

  <ContentBoxSevenThreePremium as="h2" titleright="คาสิโนสด TGA99 ภาพคมชัด มีบาคาร่า รูเล็ต ไฮโลครบโต๊ะ">
    <Picture
      slot="left"
      src={imgAllStyles}
      alt={allStylesAlt}
      loading="lazy"
      fetchpriority="low"
      widths={[280, 380, 480, 600]}
      sizes="(max-width: 767px) calc(100vw - 96px), (max-width: 1399px) calc(30vw - 38px), 382px"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={70}
      class={slideFrame}
    />

    <p slot="right" class={body}>
      คนที่อยากเปลี่ยนบรรยากาศจากเกมหมุนวงล้อมาดูจังหวะเปิดไพ่ตามเวลาจริง สลับมาหมวดคาสิโนสดได้ด้วยเครดิตก้อนเดิม สัญญาณภาพส่งตรงจากโต๊ะดีลเลอร์ด้วยความละเอียดคมชัด เห็นหน้าไพ่ ลูกเต๋า และวงล้อชัดเจน มีให้เลือกครบทั้งบาคาร่าสำหรับคนชอบอ่านสถิติเค้าไพ่ รูเล็ตที่เลือกได้ทั้งวางเลขเดี่ยวหรือแทงสีแทงคู่คี่ และไฮโลที่ได้ลุ้นแต้มสูงต่ำจบไวเป็นรอบๆ ตั้งงบต่อรอบไว้ก่อนวางชิปแล้วเล่นตามนั้น
    </p>
  </ContentBoxSevenThreePremium>

  <ContentBoxPremium as="h2" title="ซื้อหวยที่ TGA99 ไม่อั้นเลข ครบหวยหุ้น ลาว ฮานอย และหวยไทย">
    <p class={body}>
      ปัญหาที่คอหวยเจอบ่อยคือหาได้เลขเด็ดมาแล้วกดส่งโพยไม่ผ่านเพราะติดเลขอั้น หรือโดนหั่นราคาจ่ายตอนใกล้ปิดรับ ที่นี่เปิดรับแทงด้วยนโยบายไม่อั้นเลขเพื่อให้ส่งโพยเลขที่ตั้งใจไว้ได้ครบทุกตัว เข้ามาลุ้นได้มากกว่าแค่สองงวดต่อเดือน เพราะเปิดตลาดที่ออกผลรายวันไว้ทั้งหวยหุ้น ฮานอย ลาว รวมถึงงวดรัฐบาลไทย เช็กเรทจ่ายของตลาดที่จะเล่นก่อนส่งโพยทุกครั้ง ถูกรางวัลแล้วถอนออกด้วยระบบออโต้เหมือนทุกหมวด
    </p>
  </ContentBoxPremium>

  <ContentBoxSevenThreeCyberCut as="h2" titleright="เกมยิงปลาบนเว็บนี้ ใช้ฝีมือเล็งเป้า ลุ้นปลาบอสโบนัสใหญ่">
    <Picture
      slot="left"
      src={imgStable}
      alt={stableAlt}
      loading="lazy"
      fetchpriority="low"
      widths={[280, 380, 480, 600]}
      sizes="(max-width: 767px) calc(100vw - 96px), (max-width: 1399px) calc(30vw - 67px), 353px"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={70}
      class={slideFrame}
    />

    <p slot="right" class={body}>
      ถ้าวันไหนไม่อยากรอจังหวะสุ่มของวงล้อหรือรอบออกผลรางวัล หมวดเกมยิงปลาที่นี่เป็นทางเลือกที่ให้คุณคุมจังหวะการยิงและเลือกเป้าหมายเองได้ เครดิตที่ใช้ยิงมาจากกระเป๋าเงินเดียวกับหมวดอื่น จะเล็งตัวไหนหรือพักมือรอตัวใหญ่ก็ตัดสินใจเองทั้งหมด ส่วนปลาบอสคือตัวที่พกโบนัสก้อนใหญ่มาให้ลุ้น ห้องที่เปิดมีทั้ง Mega Fishing ของ JILI ที่มีบอสยักษ์กับกงล้อโบนัส และ Dinosaur Tycoon ที่เปลี่ยนฝูงปลาเป็นไดโนเสาร์ เหมาะกับคนที่ชอบเกมภาพสวยและอยากใช้ความแม่นกะจังหวะกระสุนด้วยตัวเอง
    </p>
  </ContentBoxSevenThreeCyberCut>

  <ContentBoxTwoPremium as="h2" title="ฝากถอนออโต้ บัญชีเดียวตลอด 24 ชม. รองรับวอเลท">
    <p slot="left" class={body}>
      การสลับเล่นถึงสี่หมวดจะสะดุดทันทีถ้าต้องคอยโยกเครดิตเข้าออกตามค่ายหรือส่งหลักฐานโอนเงินให้แอดมินตรวจ TGA99 จึงผูกทุกหมวดเข้ากับกระเป๋าเงินเดียวและทำรายการฝากถอนออโต้ได้ตลอด 24 ชั่วโมง โอนได้จากทุกธนาคารและทรูวอเลท (TrueMoney Wallet) ยอดปรับเข้าออกในไม่กี่วินาทีแบบไม่ต้องแนบสลิป ทั้งยังมีโปรฝาก เครดิตฟรี และกิจกรรมแจกเสริมทุนให้เช็กเงื่อนไขล่าสุดได้ที่<a href="/promotion/" class={inlineLink}>หน้าโปรโมชั่น</a>
    </p>

    <ul slot="right" class="flex flex-col gap-3">
      <li class={listItem}><strong class={listLabel}>ฝากขั้นต่ำ 20 บาท:</strong> เริ่มเติมทุนได้ตั้งแต่ยอดเล็ก</li>
      <li class={listItem}><strong class={listLabel}>ถอนขั้นต่ำ 50 บาท:</strong> ยอดถึงเกณฑ์เมื่อไหร่กดถอนเองได้เลย ระบบทำให้โดยไม่ต้องผ่านแอดมิน</li>
      <li class={listItem}><strong class={listLabel}>สมัครครั้งเดียว:</strong> กรอกข้อมูลตามช่องที่ระบบกำหนดแล้วตรวจก่อนยืนยัน สมาชิกเดิมล็อกอินด้วยข้อมูลเดิมได้ทุกเครื่อง ใช้เล่นได้ทั้งสี่หมวดโดยไม่ค้างยอดข้ามหมวด</li>
    </ul>
  </ContentBoxTwoPremium>

  <LatestWinnersPremium />

  <LoginRtpSection />

  <ContentBox>
    <p class={body}>
      TGA99 รวบรวมสล็อตโบนัสแตกถี่จากค่ายดัง โต๊ะคาสิโนสดภาพชัดทั้งบาคาร่า รูเล็ต ไฮโล ตลาดหวยหุ้น ลาว ฮานอย และหวยไทยที่เปิดรับแบบไม่อั้นเลข รวมถึงห้องเกมยิงปลาล่าบอสโบนัสใหญ่ไว้ภายใต้บัญชีเดียว ส่วนเรื่องเงินใช้ฝากถอนออโต้ตลอด 24 ชั่วโมง ใครที่มองหาเว็บเดียวจบครบสี่แนว <a href="/register/" class={inlineLink}>สมัคร TGA99</a> แล้วเริ่มเล่นหมวดที่ถนัดได้เลย
    </p>
  </ContentBox>

  <ReviewCardSumo2 />

  <Navfoot />
</MainLayout>
