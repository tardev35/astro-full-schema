---
export interface Props {
  title?: string;
  titleleft?: string;
  titleright?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, titleleft, titleright, as: HeadingTag = "h2" } = Astro.props;
---

<section class="my-12 flex w-full justify-center px-4 font-sans">
  <div
    class="relative isolate w-full max-w-7xl rounded-2xl border-2 border-[#f6c9c6] bg-white p-8 pt-44 shadow-[0_10px_30px_rgba(230,0,18,0.12)] md:pt-40">
    <div aria-hidden="true" class="pointer-events-none absolute -right-10 -bottom-16 -z-10 h-40 w-40 rounded-full bg-[#d4a017]/22 blur-[60px]"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -top-16 -left-10 -z-10 h-40 w-40 rounded-full bg-[#e60012]/16 blur-[60px]"></div>

    {
      title && (
        <div class="absolute -top-6 left-1/2 w-[92%] max-w-2xl -translate-x-1/2 rounded-lg border-2 border-[#f5c542]/70 bg-gradient-to-r from-[#b30009] via-[#e60012] to-[#b30009] px-4 py-2.5 text-center shadow-[0_10px_30px_rgba(230,0,18,0.28)] sm:px-8">
          <HeadingTag class="text-lg leading-normal font-black tracking-tight text-white uppercase sm:text-xl md:text-2xl">{title}</HeadingTag>
        </div>
      )
    }

    <div class="grid grid-cols-1 gap-10 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#2d1214]">
        {titleleft && <p class="text-2xl leading-normal font-bold text-[#8a0208]">{titleleft}</p>}
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#2d1214] md:border-l md:border-[#f6c9c6] md:pl-10">
        {titleright && <p class="text-2xl leading-normal font-bold text-[#8a0208]">{titleright}</p>}
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
