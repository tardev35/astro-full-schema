---
import ContentBoxTwo from "./ContentBoxTwo.astro";

const steps = [
  { icon: "🔑", name: "เข้าสู่ระบบด้วยบัญชีเดิม", detail: "ใช้เบอร์โทรศัพท์หรือยูสเซอร์เนมที่สมัครไว้ เข้าได้ทั้งจากมือถือและคอม", tag: "ขั้นที่ 1" },
  { icon: "🎰", name: "เปิดหมวดสล็อตแล้วเลือกค่าย", detail: "เลือกค่ายใหญ่ที่สนใจก่อน แล้วค่อยไล่ดูเกมในค่ายนั้นจากหน้ารวมเกม", tag: "ขั้นที่ 2" },
  { icon: "🎁", name: "เช็กโบนัสที่เปิดอยู่", detail: "ดูสิทธิ์และเงื่อนไขของโปรแต่ละช่วงจากหน้าสมาชิกก่อนเลือกใช้", tag: "ขั้นที่ 3" },
  { icon: "💳", name: "จัดการเครดิตผ่านระบบออโต้", detail: "ฝากถอนออโต้จากหน้าบัญชีเดิม ดูยอดคงเหลือได้ก่อนกลับเข้าเกมต่อ", tag: "ขั้นที่ 4" },
  { icon: "🧾", name: "ย้อนดูประวัติรายการ", detail: "เครดิต โบนัส และรายการฝากถอนรวมอยู่ในบัญชีเดียว ตรวจย้อนหลังได้เอง", tag: "ขั้นที่ 5" },
];

const chips = ["สล็อตแท้เว็บตรง", "เกมค่ายใหญ่", "หลายค่าย", "เกมโบนัส", "ฟรีสปิน", "โบนัสสมาชิก", "ฝากถอนออโต้"];
---

<ContentBoxTwo titleleft="เข้าสู่ระบบ SCLASS88" titleright="ทางเข้าและเข้าสู่ระบบผ่านมือถือ ใช้งานง่ายแค่ไหน" label="เข้าสู่ระบบ SCLASS88 และลำดับการใช้งานบนหน้าสมาชิก">
  <div slot="left" class="flex h-full flex-col gap-4">
    <div class="relative overflow-hidden rounded-2xl border border-[#f5c542]/25 bg-[#0d0904]/92 p-6 shadow-[0_10px_30px_rgba(245,197,66,0.18)] backdrop-blur-md">
      <div aria-hidden="true" class="pointer-events-none absolute -top-10 -right-10 h-32 w-32 rounded-full bg-[#f5c542]/20 blur-[50px]"></div>

      <div class="relative z-10 mb-5 flex items-center gap-3">
        <span
          aria-hidden="true"
          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#f5c542]/45 bg-gradient-to-br from-[#ffd75e] via-[#e0a81e] to-[#a3610c] text-xl shadow-inner">
          🎰
        </span>
        <div class="flex flex-col">
          <p class="text-base font-black text-[#ffe9a8]">เข้าสู่ระบบแล้วเลือกเกมค่ายที่ชอบต่อได้ทันที</p>
          <span class="text-[11px] text-[#c2ac7f]">บัญชีเดียวใช้เลือกค่ายเกม เช็กโบนัส ดูเครดิต และย้อนดูประวัติรายการของ SCLASS88 ได้จากหน้าเดียว</span>
        </div>
      </div>

      <div class="relative z-10 flex flex-col gap-3.5">
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#f5c542]">👤</span>
          <input
            type="text"
            placeholder="เบอร์โทรศัพท์ / ยูสเซอร์เนม"
            class="w-full rounded-xl border border-[#f5c542]/25 bg-[#161006] py-3 pr-4 pl-12 text-[#efe1c2] transition-all outline-none placeholder:text-[#c2ac7f] focus:border-[#f5c542] focus:ring-1 focus:ring-[#f5c542]/50"
          />
        </div>
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#f5c542]">🔑</span>
          <input
            type="password"
            placeholder="รหัส PIN 4 หลัก"
            class="w-full rounded-xl border border-[#f5c542]/25 bg-[#161006] py-3 pr-4 pl-12 text-[#efe1c2] transition-all outline-none placeholder:text-[#c2ac7f] focus:border-[#f5c542] focus:ring-1 focus:ring-[#f5c542]/50"
          />
        </div>

        <div class="flex items-center justify-between px-1 text-xs">
          <label class="flex items-center gap-2 text-[#c2ac7f]">
            <input type="checkbox" class="h-3.5 w-3.5 rounded border-[#f5c542]/25 bg-[#161006] accent-[#f5c542]" />
            จดจำฉันไว้
          </label>
          <a href="/login" class="text-[#c2ac7f] transition-colors hover:text-[#ffe9a8]">ลืมรหัส PIN?</a>
        </div>

        <button
          class="mt-1 w-full rounded-xl border border-[#f5c542]/45 bg-gradient-to-r from-[#ffd75e] via-[#e0a81e] to-[#a3610c] p-3.5 font-black text-[#1a1206] shadow-[0_10px_30px_rgba(245,197,66,0.20)] transition-all hover:scale-[1.02] hover:shadow-[0_15px_40px_rgba(245,197,66,0.28)]">
          เข้าสู่ระบบ
        </button>

        <div class="flex items-center gap-3 py-1 text-[11px] text-[#c2ac7f]">
          <span class="h-px flex-1 bg-[#f5c542]/25"></span>
          หรือ
          <span class="h-px flex-1 bg-[#f5c542]/25"></span>
        </div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] p-3 text-sm font-bold text-white shadow-md transition-all hover:scale-[1.02]">
          <span aria-hidden="true">💬</span> ทักไลน์ทีมงานตลอด 24 ชั่วโมง
        </a>

        <div class="mt-1 flex items-center justify-between px-1">
          <div class="flex gap-2">
            <span class="rounded-full border border-[#f5c542]/25 bg-[#161006] px-2.5 py-1 text-[10px] font-bold text-[#ffe9a8]"><span aria-hidden="true">🔒</span> เข้ารหัสข้อมูล</span>
            <span class="rounded-full border border-[#a3610c]/50 bg-[#161006] px-2.5 py-1 text-[10px] font-bold text-[#ffd75e]"><span aria-hidden="true">🕐</span> ใช้งานได้ตลอด 24 ชม.</span>
          </div>
          <a href="/register" class="text-xs font-bold text-[#c2ac7f] transition-colors hover:text-[#ffe9a8]">สมัครสมาชิกใหม่</a>
        </div>
      </div>
    </div>
  </div>

  <div slot="right" class="h-full">
    <div class="flex h-full flex-col rounded-2xl border border-[#f5c542]/25 bg-[#0d0904]/92 p-5 shadow-[0_10px_30px_rgba(245,197,66,0.18)] backdrop-blur-md">
      <div class="mb-5 flex items-center justify-between gap-3">
        <div>
          <span class="text-xs font-bold tracking-wide text-[#c2ac7f]">ลำดับการใช้งานที่ SCLASS88 วางไว้บนหน้าสมาชิก หลังเข้าสู่ระบบด้วยบัญชีเดิม</span>
          <div class="bg-gradient-to-r from-[#ffe9a8] via-[#f5c542] to-[#bc7b14] bg-clip-text text-2xl font-black text-transparent sm:text-3xl">เกมค่ายใหญ่ • โบนัส • ระบบออโต้</div>
        </div>
        <span class="flex items-center gap-1.5 self-start rounded-full border border-green-500/40 bg-green-900/20 px-2.5 py-1">
          <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-green-400 shadow-[0_0_8px_rgba(74,222,128,0.8)]"></span>
          <span class="text-[10px] font-bold tracking-widest text-green-400 uppercase">Live</span>
        </span>
      </div>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#c2ac7f] uppercase">
        <span>ขั้นตอนการใช้งาน</span>
        <span>ลำดับ</span>
      </div>

      <div class="flex flex-1 flex-col gap-2.5">
        {
          steps.map((s) => (
            <div class="rounded-xl border border-[#f5c542]/20 bg-[#161006] px-3.5 py-2.5 transition-colors hover:border-[#f5c542]/50 hover:bg-[#241906]">
              <div class="flex items-center justify-between gap-2 text-sm">
                <span class="flex min-w-0 items-center gap-2 font-bold text-[#efe1c2]">
                  <span aria-hidden="true" class="w-5 shrink-0 text-center">
                    {s.icon}
                  </span>{" "}
                  <span class="truncate">{s.name}</span>
                </span>
                <span class="shrink-0 rounded-full border border-[#f5c542]/45 bg-[#0d0904] px-2.5 py-0.5 text-[10px] font-bold text-[#ffd75e]">{s.tag}</span>
              </div>
              <div class="mt-1.5 text-[11px] tracking-wide text-[#c2ac7f]">{s.detail}</div>
            </div>
          ))
        }
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
        {chips.map((c) => <span class="rounded-full border border-[#f5c542]/25 bg-[#161006] px-3 py-1 text-[10px] font-bold text-[#ffe9a8]">{c}</span>)}
      </div>

      <div class="mt-3 text-center text-[10px] tracking-wide text-[#c2ac7f]">
        ลำดับในตารางสรุปจากที่หน้าเว็บแสดงไว้ รายละเอียดของเกมและเงื่อนไขโบนัสจริงให้ยึดตามหน้าสมาชิกและหน้าโปรโมชั่นของ SCLASS88 ก่อนเลือกใช้ทุกครั้ง หากติดขัดตรงไหนทักไลน์ทีมงานได้ตลอด 24 ชั่วโมง
      </div>
    </div>
  </div>
</ContentBoxTwo>
