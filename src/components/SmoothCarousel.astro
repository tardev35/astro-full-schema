---
import { Picture } from "astro:assets";

import slide2 from "../assets/slide2.png";
import slide3 from "../assets/slide3.png";

const images = [
  {
    src: slide2,
    alt: "ภาพโปรโมชั่น VING999 โทนแดงเข้มบนพื้นดำ มุมบนซ้ายเป็นโลโก้ตัวอักษรโครเมียม VING กับเลข 999 สีแดง ด้านขวาเป็นพรีเซนเตอร์หญิงสวมชุดสีแดงสลับขาวถือเหรียญที่มีโลโก้ VING999 ตัวอักษรใหญ่ว่า โบนัสสุดคุ้ม! ถัดมาระบุช่วงเวลา 12:00น. ถึง 15:00น. และ 15% ซื้อฟรีสปินได้ พร้อมบรรทัดเงื่อนไขว่า ทำเทิร์น 1 เท่า 2 เท่า รวมทุน รับได้วันละ 1 ครั้ง ด้านล่างเป็นแถวไอคอนห้าช่องว่า สมัครง่าย รวดเร็ว ไม่กี่ขั้นตอน ฝาก-ถอน ออโต้ รวดเร็วทันใจ รองรับธนาคารและวอเลท โปรโมชั่นจัดเต็มทุกสัปดาห์ และ ปลอดภัย มั่นคง เชื่อถือได้",
  },
  {
    src: slide3,
    alt: "ภาพโปรโมชั่น VING999 โทนแดงเข้มบนพื้นดำ มุมบนซ้ายเป็นโลโก้ตัวอักษรโครเมียม VING กับเลข 999 สีแดง ตัวอักษรใหญ่ว่า โปรฝากสุดคุ้ม พร้อมตัวเลขใหญ่ว่า ฝาก 29฿ รับ 100฿ ถัดลงมาเป็นบรรทัดเงื่อนไขว่า ทำเทิร์น 4 เท่า รวมทุน และป้ายว่า ฝากขั้นต่ำ 1 บาท ด้านล่างเป็นแถวไอคอนห้าช่องว่า สมัครง่าย รวดเร็ว ไม่กี่ขั้นตอน ฝาก-ถอน ออโต้ รวดเร็วทันใจ รองรับธนาคารและวอเลท โปรโมชั่นจัดเต็มทุกสัปดาห์ และ ปลอดภัย มั่นคง เชื่อถือได้",
  },
];

const COPIES = 3;
const slides = Array.from({ length: COPIES }, () => images).flat();
---

<div class="marquee mx-auto w-full max-w-7xl overflow-hidden px-4 py-5">
  <input id="carousel-pause" type="checkbox" class="peer sr-only" />
  <label
    for="carousel-pause"
    class="sr-only cursor-pointer peer-focus-visible:not-sr-only peer-focus-visible:mb-3 peer-focus-visible:inline-block peer-focus-visible:rounded-full peer-focus-visible:border peer-focus-visible:border-[#e01b2d]/60 peer-focus-visible:bg-[#170a0b] peer-focus-visible:px-4 peer-focus-visible:py-2 peer-focus-visible:text-sm peer-focus-visible:font-bold peer-focus-visible:text-[#f2f5f7]">
    หยุด / เล่นสไลด์ภาพ
  </label>

  <div class="marquee-track flex">
    {
      slides.map((slide, index) => {
        const isDuplicate = index >= images.length;
        return (
          <div class="marquee-slide" aria-hidden={isDuplicate ? "true" : undefined}>
            <Picture
              src={slide.src}
              alt={isDuplicate ? "" : slide.alt}
              class="block w-full rounded-xl border border-[#5a1a1e] object-cover shadow-[0_10px_30px_rgba(224,27,45,0.20)]"
              width={slide.src.width}
              height={slide.src.height}
              loading="lazy"
              fetchpriority="low"
              decoding="async"
              widths={[300, 360, 420, 480, 540, 600]}
              sizes="(max-width: 767px) calc(100vw - 32px), (max-width: 1279px) calc((100vw - 48px) / 2), 403px"
              formats={["avif", "webp"]}
              fallbackFormat="webp"
              quality={60}
            />
          </div>
        );
      })
    }
  </div>
</div>

<style>
  .marquee {
    --gap: 12px;
    --per-view: 1;
    --shift: calc(-200% - 24px);
  }

  @media (min-width: 768px) {
    .marquee {
      --gap: 16px;
      --per-view: 2;
      --shift: calc(-100% - 16px);
    }
  }

  @media (min-width: 1280px) {
    .marquee {
      --gap: 20px;
      --per-view: 3;
      --shift: calc(-66.6667% - 13.3333px);
    }
  }

  .marquee-track {
    gap: var(--gap);
    width: 100%;
    animation: carousel-scroll 24s linear infinite;
    will-change: transform;
  }

  .marquee-slide {
    flex: 0 0 calc((100% - (var(--per-view) - 1) * var(--gap)) / var(--per-view));
  }

  @keyframes carousel-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(var(--shift));
    }
  }

  .marquee:hover .marquee-track,
  .marquee:focus-within .marquee-track,
  .marquee > input:checked ~ .marquee-track {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
    }
  }
</style>
