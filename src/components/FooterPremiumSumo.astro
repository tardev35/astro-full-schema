---
import { Picture } from "astro:assets";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });
const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;
---

<footer class="relative mt-16 w-full overflow-hidden rounded-t-[3rem] border-t border-blue-500/60 bg-[#030d16] pt-16 pb-8 font-sans text-white shadow-[0_-15px_40px_rgba(37,99,235,0.25)]">
  <div class="pointer-events-none absolute inset-x-0 -top-20 mx-auto h-[250px] w-full max-w-4xl rounded-full bg-blue-600/20 blur-[100px]"></div>

  <div class="relative z-10 mx-auto w-full max-w-[1200px] px-6">
    <div class="mb-12 grid grid-cols-1 gap-12 md:grid-cols-12">
      <div class="flex flex-col gap-5 md:col-span-5">
        <a href="/" class="inline-block max-w-max rounded-xl border border-blue-500/30 bg-white px-4 py-2 transition-transform duration-300 hover:scale-105">
          {
            mainLogo ? (
              <Picture src={mainLogo} alt="HENGJUD365 Logo" class="h-[50px] w-auto object-contain" formats={["avif", "webp"]} fallbackFormat="webp" />
            ) : (
              <h2 class="text-3xl font-black tracking-widest text-[#0a0a0a]">
                HENG<span class="text-blue-600">JUD365</span>
              </h2>
            )
          }
        </a>
        <p class="border-l-2 border-yellow-500/50 pl-4 text-sm leading-relaxed text-gray-400">
          HENGJUD365 เว็บไซต์รีวิวเกมสล็อตออนไลน์ผ่านระบบเว็บตรง ข้อมูลเว็บตรง ระบบฝากถอนอัตโนมัติ และทางเข้าล่าสุด อัปเดตต่อเนื่องเพื่อผู้เริ่มต้นเล่นเกมสล็อต
        </p>
        <div class="mt-4 flex gap-3">
          <span class="rounded-full border border-blue-400/30 bg-blue-900/30 px-4 py-1 text-xs font-medium text-blue-300 backdrop-blur-sm">เว็บตรง</span>
          <span class="rounded-full border border-yellow-500/30 bg-yellow-900/20 px-4 py-1 text-xs font-medium text-yellow-400 backdrop-blur-sm">RTP 96.7%</span>
        </div>
      </div>

      <nav class="flex flex-col gap-4 md:col-span-3 lg:pl-8">
        <h2 class="text-lg font-black tracking-widest text-white uppercase drop-shadow-sm">ทางลัด</h2>
        <div class="h-[1px] w-12 bg-yellow-500"></div>
        <ul class="flex flex-col gap-3 text-sm font-medium text-gray-400">
          <li><a href="/" class="transition-colors hover:text-yellow-400">หน้าหลัก</a></li>
          <li><a href="/promotion" class="transition-colors hover:text-yellow-400">โปรโมชั่น</a></li>
          <li><a href="/register" class="transition-colors hover:text-yellow-400">สมัครสมาชิก</a></li>
          <li><a href="/login" class="transition-colors hover:text-yellow-400">เข้าสู่ระบบ</a></li>
        </ul>
      </nav>

      <div class="flex flex-col gap-5 md:col-span-4">
        <h2 class="text-lg font-black tracking-widest text-white uppercase drop-shadow-sm">บริการลูกค้า 24 ชม.</h2>
        <div class="h-[1px] w-12 bg-yellow-500"></div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] py-3.5 font-bold text-white shadow-[0_5px_15px_rgba(0,185,0,0.3)] transition-all hover:-translate-y-1 hover:shadow-[0_8px_20px_rgba(0,185,0,0.4)]">
          ติดต่อแอดมิน LINE
        </a>

        <div class="mt-4 text-xs font-medium tracking-widest text-gray-500 uppercase">Supported Payments</div>
        <div class="flex flex-wrap gap-2 opacity-90">
          <div class="flex h-7 w-11 items-center justify-center rounded-md border border-white/10 bg-[#118A44] text-[10px] font-bold text-white shadow-sm" title="KBank">KB</div>
          <div class="flex h-7 w-11 items-center justify-center rounded-md border border-white/10 bg-[#4E2B7A] text-[10px] font-bold text-white shadow-sm" title="SCB">SCB</div>
          <div class="flex h-7 w-11 items-center justify-center rounded-md border border-white/10 bg-[#1BA1E2] text-[10px] font-bold text-white shadow-sm" title="KTB">KTB</div>
          <div class="flex h-7 w-11 items-center justify-center rounded-md border border-white/10 bg-[#1E4598] text-[10px] font-bold text-white shadow-sm" title="Bangkok Bank">BBL</div>
          <div class="flex h-7 w-11 items-center justify-center rounded-md border border-white/10 bg-[#FEC400] text-[10px] font-bold text-[#1E4598] shadow-sm" title="Krungsri">BAY</div>
          <div
            class="flex h-7 w-11 items-center justify-center rounded-md border border-white/10 bg-gradient-to-r from-orange-500 to-orange-400 text-[10px] font-bold text-white shadow-sm"
            title="TrueMoney Wallet">
            TW
          </div>
        </div>
      </div>
    </div>

    <div class="flex flex-col items-center justify-between border-t border-blue-900/40 pt-8 text-xs font-medium tracking-wide text-gray-500 md:flex-row">
      <p>COPYRIGHT &copy; {new Date().getFullYear()} HENGJUD365.COM. ALL RIGHTS RESERVED.</p>
      <div class="mt-4 flex gap-4 md:mt-0">
        <a href="/" class="transition-colors hover:text-yellow-400">เงื่อนไขข้อตกลง</a>
        <a href="/" class="transition-colors hover:text-yellow-400">นโยบายความเป็นส่วนตัว</a>
      </div>
    </div>
  </div>
</footer>

<style>
  footer a {
    text-decoration: none;
    font-family: "Kanit", sans-serif;
  }
  footer {
    font-family: "Kanit", sans-serif;
  }
</style>
