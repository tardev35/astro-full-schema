---
export interface FeatureItem {
  icon: string;
  title: string;
  description: string;
  accent?: "blue" | "gold";
}

export interface Props {
  items: FeatureItem[];
  as?: "h3" | "h4" | "p";
}

const { items, as: HeadingTag = "h3" } = Astro.props;
---

<div class="mt-5 grid grid-cols-1 gap-4 md:grid-cols-2">
  {
    items.map((item) => {
      const isGold = item.accent === "gold";
      return (
        <div class="group flex flex-col items-start gap-4 rounded-2xl border border-[#d6e2f7] bg-[#eef4ff] p-6 transition-all duration-300 hover:-translate-y-1 hover:border-[#9dbcf0] hover:bg-white hover:shadow-[0_10px_20px_rgba(26,95,224,0.16)] sm:flex-row">
          <div
            aria-hidden="true"
            class={`flex h-14 w-14 shrink-0 items-center justify-center rounded-xl text-3xl transition-transform duration-300 group-hover:scale-110 ${
              isGold ? "bg-gradient-to-b from-[#ffd45c] via-[#e0a91b] to-[#b07d12] shadow-[0_5px_15px_rgba(224,169,27,0.35)] group-hover:rotate-3" : "bg-gradient-to-b from-[#4d8ff5] via-[#1a5fe0] to-[#0b3a9e] shadow-[0_5px_15px_rgba(26,95,224,0.30)]"
            }`}>
            {item.icon}
          </div>
          <div class="flex flex-col gap-2 text-left">
            <HeadingTag class="text-xl leading-normal font-black tracking-wide text-[#0a1f5c]">{item.title}</HeadingTag>
            <p class="text-left text-base leading-relaxed text-[#1f2a44]">{item.description}</p>
          </div>
        </div>
      );
    })
  }
</div>
