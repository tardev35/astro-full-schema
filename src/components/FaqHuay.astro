---
export interface FAQ {
  q: string;
  a: string;
}
export interface Props {
  faqs?: FAQ[];
}

const {
  faqs = [
    { q: "FINNBET จ่ายสูงสุดเท่าไหร่?", a: "เราให้อัตราจ่ายสูงสุดในประเทศ หวยรัฐบาลไทยจ่าย 3 ตัวบน บาทละ 900 และ 2 ตัวล่าง บาทละ 90 เต็มราคา ไม่มีหักเปอร์เซ็นต์" },
    { q: "สามารถแทงขั้นต่ำได้กี่บาท?", a: "ระบบของเราออกแบบมาเพื่อทุกคน คุณสามารถเริ่มต้นแทงหวยได้ตั้งแต่ 1 บาทเป็นต้นไป ทุกประเภทหวย" },
    { q: "มีเลขปิด หรือเลขอั้นไหม?", a: "FINNBET การันตีไม่มีปิดเลข คุณสามารถแทงได้ทุกตัวเลข (กรณีเลขอั้น ระบบจะแจ้งอัตราจ่ายให้ทราบก่อนยืนยันบิลเสมอ)" },
  ],
} = Astro.props;
---

<section class="mx-auto mb-12 w-full max-w-4xl px-4 font-sans">
  <div class="mb-6 text-center">
    <h2 class="text-2xl font-black tracking-widest text-[#0a1128] uppercase">คำถามที่พบบ่อย (FAQ)</h2>
  </div>

  <div class="flex flex-col gap-3">
    {
      faqs.map((faq) => (
        <div class="faq-item group overflow-hidden rounded-xl border border-gray-200 bg-white transition-all duration-300 hover:border-[#ffd60a] hover:shadow-md">
          <button class="faq-btn flex w-full items-center justify-between p-5 text-left outline-none">
            <span class="text-base font-bold text-[#0a1128] transition-colors group-hover:text-[#007bff]">{faq.q}</span>
            <span class="icon flex h-6 w-6 shrink-0 items-center justify-center rounded-md bg-gray-100 text-sm font-bold text-gray-500 transition-all duration-300 group-hover:bg-[#ffd60a] group-hover:text-[#0a1128]">
              +
            </span>
          </button>
          <div class="faq-content grid grid-rows-[0fr] transition-[grid-template-rows] duration-300 ease-in-out">
            <div class="overflow-hidden">
              <p class="border-t border-gray-100 bg-gray-50 p-5 text-sm leading-relaxed text-gray-600">{faq.a}</p>
            </div>
          </div>
        </div>
      ))
    }
  </div>
</section>

<script>
  const faqItems = document.querySelectorAll(".faq-item");
  faqItems.forEach((item) => {
    const btn = item.querySelector(".faq-btn");
    const content = item.querySelector(".faq-content");
    const icon = item.querySelector(".icon");

    btn?.addEventListener("click", () => {
      const isOpen = content?.classList.contains("grid-rows-[1fr]");
      document.querySelectorAll(".faq-content").forEach((c) => c.classList.remove("grid-rows-[1fr]"));
      document.querySelectorAll(".icon").forEach((i) => {
        i.classList.remove("rotate-45", "bg-[#ffd60a]", "text-[#0a1128]");
        i.textContent = "+";
      });
      document.querySelectorAll(".faq-item").forEach((i) => i.classList.remove("border-[#ffd60a]", "shadow-md"));

      if (!isOpen) {
        content?.classList.add("grid-rows-[1fr]");
        icon?.classList.add("rotate-45", "bg-[#ffd60a]", "text-[#0a1128]");
        item.classList.add("border-[#ffd60a]", "shadow-md");
      }
    });
  });
</script>
