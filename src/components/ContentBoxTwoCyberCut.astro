---
export interface Props {
  title?: string;
  titleleft?: string;
  titleright?: string;
  label?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, titleleft, titleright, label, as } = Astro.props;
const TitleTag = as ?? "p";
const intro = Astro.slots.has("default") ? (await Astro.slots.render("default")).trim() : "";

const sectionLabel = label ?? title ?? titleleft ?? titleright ?? "ข้อมูลประกอบ";
---

<section aria-label={sectionLabel} class="mx-auto mb-6 w-full max-w-7xl px-4 font-sans">
  <div
    class="relative isolate w-full border border-[#ffd400]/25 bg-[#170733]/92 p-8 text-[#ece2fb] shadow-[0_10px_30px_rgba(255,212,0,0.16)] backdrop-blur-md transition-all duration-300 hover:border-[#ffd400]/50 hover:shadow-[0_15px_40px_rgba(255,212,0,0.26)]"
    style="clip-path: polygon(30px 0, 100% 0, 100% calc(100% - 30px), calc(100% - 30px) 100%, 0 100%, 0 30px);">
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-[2px] w-24 bg-gradient-to-r from-[#ffd400] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-[2px] w-24 bg-gradient-to-l from-[#ff4fd8] to-transparent"></div>
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-16 w-[2px] bg-gradient-to-b from-[#ffd400] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-16 w-[2px] bg-gradient-to-t from-[#ff4fd8] to-transparent"></div>

    {
      title && (
        <TitleTag class="mb-4 bg-gradient-to-r from-[#ffe94d] via-[#ffd400] to-[#ff4fd8] bg-clip-text text-center text-2xl leading-normal font-black text-transparent uppercase">
          {title}
        </TitleTag>
      )
    }

    {intro && <div class="mb-8 text-left text-base leading-relaxed text-[#ece2fb]" set:html={intro} />}

    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <article class="relative flex flex-col gap-4 text-left text-base leading-relaxed text-[#ece2fb]">
        {
          titleleft && (
            <p class="flex items-center gap-2 border-b border-[#ffd400]/25 pb-2 text-xl leading-normal font-black text-[#ffd400] uppercase">
              <span aria-hidden="true" class="inline-block h-2 w-2 shrink-0 bg-[#ffd400] shadow-[0_0_5px_rgba(255,212,0,0.7)]" /> {titleleft}
            </p>
          )
        }
        <slot name="left" />
      </article>

      <article class="relative flex flex-col gap-4 text-left text-base leading-relaxed text-[#ece2fb] md:border-l md:border-[#ffd400]/25 md:pl-8">
        {
          titleright && (
            <p class="flex items-center gap-2 border-b border-[#ffd400]/25 pb-2 text-xl leading-normal font-black text-[#ffd400] uppercase">
              <span aria-hidden="true" class="inline-block h-2 w-2 shrink-0 bg-[#ff4fd8] shadow-[0_0_5px_rgba(255,79,216,0.8)]" /> {titleright}
            </p>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
