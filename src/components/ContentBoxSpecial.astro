---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h2" } = Astro.props;
---

<section class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#f9a8d4] bg-white p-6 text-[#5b2140] shadow-[0_10px_30px_rgba(236,72,153,0.14)] transition-all duration-500 hover:border-[#ec4899]/60 md:p-10">
    <div
      aria-hidden="true"
      class="pointer-events-none absolute top-0 left-1/2 -z-10 h-[2px] w-1/2 -translate-x-1/2 bg-gradient-to-r from-transparent via-[#ec4899] to-transparent opacity-60 transition-opacity duration-500 group-hover:opacity-100">
    </div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#fbcfe8] pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ec4899] to-[#a855f7] shadow-[0_0_10px_rgba(236,72,153,0.30)]" />
          <HeadingTag class="bg-gradient-to-r from-[#9d174d] via-[#db2777] to-[#7e22ce] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-2 lg:gap-10">
      <article
        class="relative flex gap-4 rounded-2xl border border-[#fbcfe8] bg-[#fdf2f8] p-6 text-left text-base leading-relaxed text-[#5b2140] transition-all duration-300 hover:-translate-y-2 hover:border-[#ec4899]/60 hover:bg-[#fce7f3] hover:shadow-[0_15px_40px_rgba(236,72,153,0.16)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#f9a8d4] bg-gradient-to-br from-[#f472b6] via-[#ec4899] to-[#db2777] text-2xl shadow-[0_5px_15px_rgba(236,72,153,0.22)]">
          📱
        </div>
        <slot name="left" />
      </article>

      <article
        class="relative flex gap-4 rounded-2xl border border-[#e9d5ff] bg-[#faf5ff] p-6 text-left text-base leading-relaxed text-[#5b2140] transition-all duration-300 hover:-translate-y-2 hover:border-[#a855f7]/60 hover:bg-[#f3e8ff] hover:shadow-[0_15px_40px_rgba(168,85,247,0.18)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#e9d5ff] bg-gradient-to-br from-[#c084fc] via-[#a855f7] to-[#7e22ce] text-2xl shadow-[0_5px_15px_rgba(168,85,247,0.22)]">
          💻
        </div>
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
