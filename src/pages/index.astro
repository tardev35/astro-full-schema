---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxCyberCut.astro";
import ContentBoxTwo from "../components/ContentBoxTwoCyberCut.astro";
import ContentBoxSevenThree from "../components/ContentBoxSevenThreeCyberCut.astro";
import ContentBoxThreeColums from "../components/ContentBox3ThreeCyberCut.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementCyber.astro";
import SmoothCarousel from "../components/SmoothCarousel.astro";
import ProviderGrid from "../components/ProviderGrid.astro";
import LatestWinners from "../components/LatestWinnersCyber.astro";
import Faq from "../components/Faq4.astro";

const currentPath = Astro.url.pathname;
const homePage = Astro.url.origin;
const logoUrl = homePage + "/logo.webp";

const webPageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: "TEENOI168 เว็บตรงสล็อตpg บาคาร่า ระบบ API ตี๋น้อย168",
  description: "TEENOI168 เว็บตรงสล็อตpg และบาคาร่า ระบบ API แท้ 100% เว็บพนันออนไลน์อันดับ 1  รีวิวจากผู้เล่นจริง แตกง่าย แจกโบนัสจัดเต็ม มาตรฐานสากล ตี๋น้อย168 ",
  url: currentPath,
};
const webSiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "TEENOI168",
  alternateName: ["teeno168", "teeno168h", "teeno168 auto"],
  url: "https://teenoi168bkk.com/",
};
const orgSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "TEENOI168",
  logo: logoUrl,
  url: homePage,
};
const allSchemas = [webPageSchema, orgSchema, webSiteSchema];

import { Picture } from "astro:assets";
import image1 from "../assets/pro2.jpg";
---

<MainLayout>
  <script type="application/ld+json" set:html={JSON.stringify(allSchemas)} />

  <Announcement />

  <ContentBox title="TEENOI168 เว็บตรงสล็อตpg บาคาร่า ระบบ API ตี๋น้อย168">
    <p class="leading-relaxed">
      TEENOI168 ไม่ใช่ร้านสุกี้ ตี๋น้อย168 ไม่ใช่ร้านอาหาร สู่แพลตฟอร์ม เว็บตรงสล็อตpg และบาคาร่า ที่มาพร้อม ระบบ API แท้ 100% TEENOI168 เชื่อมต่อตรงจากเซิร์ฟเวอร์หลัก ไม่ผ่านเอเย่นต์
      ไร้ปัญหาการล็อคยูสเซอร์ ไม่ว่าคุณจะตามหาเกมสล็อตแตกง่าย หรือโต๊ะบาคาร่าสดที่ได้มาตรฐานสากล ตี๋น้อย168 พร้อมมอบประสบการณ์การเล่นที่เหนือระดับ ด้วยระบบฝาก-ถอนออโต้ที่รวดเร็วที่สุดในไทย
      ให้คุณสนุกและทำกำไรได้อย่างไร้ขีดจำกัด
    </p>

    <div class="mt-8 flex flex-wrap justify-center gap-6">
      <a
        href="/login"
        class="group relative flex items-center justify-center px-10 py-3.5 font-black text-white transition-all hover:scale-105 hover:shadow-[0_0_15px_rgba(239,68,68,0.4)]"
        style="clip-path: polygon(15% 0, 100% 0, 100% 70%, 85% 100%, 0 100%, 0 30%); background: #7f1d1d; border: 1px solid #ef4444;">
        เข้าระบบเกม
      </a>
      <a
        href="/register"
        class="group relative flex items-center justify-center px-10 py-3.5 font-black text-[#2a0800] shadow-[0_0_20px_rgba(255,215,0,0.5)] transition-all hover:scale-105"
        style="clip-path: polygon(15% 0, 100% 0, 100% 70%, 85% 100%, 0 100%, 0 30%); background: linear-gradient(to right, #fbbf24, #f59e0b);">
        สมัครสมาชิก
      </a>
    </div>
  </ContentBox>
  <ProviderGrid />
  <LatestWinners />
  <ContentBoxThreeColums titleleft="CORE_STABILITY" titlecenter="AUTO_TRANSFER" titleright="ENCRYPTED_VIP">
    <div slot="left">ระบบประมวลผลความเร็วสูง มั่นใจได้ในทุกการเดิมพัน ไม่มีสะดุด ปลอดภัย 100%</div>
    <div slot="center">ฝาก-ถอน อัตโนมัติด้วย AI อัจฉริยะ ทำรายการเพียง 3 วินาที รองรับทุกธนาคาร</div>
    <div slot="right">การดูแลระดับพรีเมียมจากทีมงานผู้เชี่ยวชาญ พร้อมความปลอดภัยข้อมูลขั้นสูงสุด</div>
  </ContentBoxThreeColums>

  <ContentBoxTwo titleleft="ทำความรู้จัก ตี๋น้อย168 (TEENOI168) จุดเริ่มต้นจากตำนานสู่เว็บพนันออนไลน์อันดับ 1" titleright="ตี๋น้อย168 (Teenoi168) เว็บตรงมาตรฐานสากล ตัวเลือกลำดับแรกของนักเดิมพัน">
    <div slot="left" class="text-white/80">
      <p>
        "ตี๋น้อย168" ไม่ได้เกิดขึ้นเพียงข้ามคืน แต่เรามีจุดเริ่มต้นมาจากความมุ่งมั่น ที่ก่อตั้งขึ้นในปี พ.ศ. 2565 ท่ามกลางสถานการณ์การระบาดของโควิด-19
        ที่ทำให้การเดินทางไปเดิมพันในบ่อนจริงเป็นเรื่องยาก ด้วยประสบการณ์ในวงการเดิมพันกว่า 30 ปี ทีมงานของเราจึงรวบรวมประสบการณ์เหล่านั้นมาสร้างเป็นแพลตฟอร์มออนไลน์ที่ตอบโจทย์นักเดิมพันไทยมากที่สุด
        จนในปัจจุบัน "ตี๋น้อย168" ได้กลายเป็นเว็บพนันออนไลน์อันดับ 1 ที่ผู้เล่นให้การยอมรับในเรื่องความมั่นคงและประวัติที่โปร่งใส
      </p>
    </div>
    <div slot="right" class="text-white/80">
      <p>
        ทำไมต้องเลือกเดิมพันกับเรา? ในฐานะเว็บตรงมาตรฐานสากล "ตี๋น้อย168" (TEENOI168) ให้บริการโดยเชื่อมต่อระบบ API แท้จากค่ายเกมชั้นนำทั่วโลกโดยตรง ทำให้สมาชิกมั่นใจได้ว่า
        ทุกยอดการวางเดิมพันจะได้รับความเป็นธรรม 100% ไม่มีระบบล็อคยูสเซอร์ และไม่มีการผ่านเอเย่นต์ให้ยุ่งยาก
        เราเป็นตัวเลือกแรกของนักเดิมพันเพราะเรายึดถือมาตรฐานความปลอดภัยและการบริการที่ตรงไปตรงมาเป็นสำคัญ
      </p>
    </div>
  </ContentBoxTwo>

  <SmoothCarousel />

  <ContentBoxSevenThree>
    <div slot="left" class="flex h-full flex-col justify-center">
      <Picture
        src={image1}
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600, 800]}
        sizes="(max-width: 768px) 100vw, 50vw"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
        alt="Vegus24 VIP Service"
        class="mx-auto h-auto w-full rounded-2xl border-2 border-yellow-500/30 shadow-[0_10px_30px_rgba(234,179,8,0.2)]"
      />
    </div>
    <div slot="right">
      <h2 class="mb-4 text-3xl font-black tracking-[0.2em] text-red-400 uppercase drop-shadow-[0_0_10px_rgba(239,68,68,0.4)]">รีวิว ประสบการณ์การเดิมพัน Teenoi168 จากผู้เล่นจริง</h2>
      <p>
        จากการทดสอบใช้งานจริงบน Teenoi168 สิ่งที่สมาชิกจะสัมผัสได้ทันทีคือ "ความลื่นไหล" ของระบบ ไม่ว่าคุณจะใช้งานผ่านมือถือ iOS หรือ Android หน้าเว็บถูกออกแบบมาให้ตอบสนอง (Responsive) อย่างรวดเร็ว
        การเปลี่ยนเกมไปมาทำได้โดยไม่ต้องโยกเงินให้เสียเวลา ภาพกราฟิกในเกมสล็อตและคาสิโนสดมีความคมชัดสูง ไม่พบปัญหาหน้าจอค้างหรือกระตุกระหว่างเดิมพัน
        ซึ่งถือเป็นประสบการณ์ระดับพรีเมียมที่หาได้ยากในเว็บเอเย่นต์ทั่วไป
      </p>

      <a
        href="/line"
        class="inline-flex items-center bg-[#00B900] px-8 py-3 font-bold text-white shadow-lg transition-transform hover:scale-105"
        style="clip-path: polygon(15% 0, 100% 0, 100% 70%, 85% 100%, 0 100%, 0 30%);">
        <span class="mr-2 text-xl">LINE</span> ติดต่อแอดมิน
      </a>
    </div>
  </ContentBoxSevenThree>
  <ContentBox>
    <h2 class="mb-4 text-3xl font-black tracking-[0.2em] text-red-400 uppercase drop-shadow-[0_0_10px_rgba(239,68,68,0.4)]">เจาะลึกเกมดังบน Teenoi168 เว็บตรงสล็อตpg แตกง่าย แจกโบนัสจัดเต็ม</h2>
    <p class="leading-relaxed">
      Teenoi168 คือสวรรค์ของผู้ชื่นชอบเกมสล็อต โดยเฉพาะค่าย PG Slot ที่เรานำเข้ามาแบบลิขสิทธิ์แท้ การเล่นผ่านเว็บตรงสล็อตpg กับเรามีข้อได้เปรียบคือ ค่า RTP (Return to Player)
      จะเป็นไปตามมาตรฐานของผู้พัฒนาเกม ทำให้โอกาสชนะและแจ็คพอตแตกนั้นมีความยุติธรรม สมาชิกสามารถเข้าถึงเกมดังกว่า 5,000 เกม
      พร้อมรับสูตรสล็อตและเทคนิคการหมุนเพื่อลุ้นโบนัสใหญ่ได้อย่างเต็มที่ทุกช่วงเวลา 100%
    </p>
  </ContentBox>
  <ContentBoxTwo titleleft="เดิมพันบาคาร่าที่ Teenoi168 มั่นใจได้ในความโปร่งใส ระบบ API แท้ 100% " titleright="ฝาก-ถอนออโต้ของ Teenoi168 แม่นยำ ฉับไว เสร็จธุรกรรไม่เกิน 3 วินาที">
    <div slot="left" class="text-white/80">
      <p>
        สำหรับสายบาคาร่า Teenoi168 ให้บริการถ่ายทอดสดจากคาสิโนจริงผ่านระบบ API แท้ คุณจะได้สัมผัสบรรยากาศการเดิมพันเหมือนนั่งอยู่ในคาสิโนระดับโลก สัญญาณภาพไม่มีดีเลย์
        ช่วยให้คุณตัดสินใจวางเดิมพันได้แม่นยำ ทุกโต๊ะบาคาร่าของเราผ่านการตรวจสอบความโปร่งใส ทำให้ผู้เล่นมั่นใจได้ว่าทุกไพ่ที่เปิดออกมาคือความจริงใจที่เรามอบให้สมาชิกทุกท่าน
      </p>
    </div>
    <div slot="right" class="text-white/80">
      <p>
        หัวใจสำคัญของความเชื่อมั่นทางการเงินที่ Teenoi168 คือระบบฝาก-ถอนออโต้ (Fully Automated System) ที่เราพัฒนาขึ้นเพื่อตัดปัญหาความล่าช้า ไม่ว่าจะเป็นยอดหลักร้อยหรือหลักแสน
        ระบบของเราสามารถประมวลผลและปรับยอดเครดิตให้คุณได้ภายในเวลาไม่เกิน 3 วินาที สมาชิกสามารถทำรายการได้ด้วยตัวเองตลอด 24 ชั่วโมง โดยไม่ต้องรอแอดมินหรือส่งสลิปให้วุ่นวาย
      </p>
    </div>
  </ContentBoxTwo>
  <Faq />
  <Navfoot />

  <style>
    :global(.text-emerald-gradient) {
      background: linear-gradient(to bottom, #34d399 0%, #10b981 100%) !important;
      -webkit-background-clip: text !important;
      -webkit-text-fill-color: transparent !important;
    }
  </style>
</MainLayout>
