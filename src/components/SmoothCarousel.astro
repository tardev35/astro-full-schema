---
import { Picture } from "astro:assets";

import slide2 from "../assets/slide2.png";
import slide3 from "../assets/slide3.png";

const images = [
  {
    src: slide2,
    alt: "ภาพโปรโมชั่น BUNNY555 โปรใจป๋า เติม 29 รับ 100 พื้นหลังชมพูมีเหรียญทองกระจายอยู่ ด้านบนเป็นมงกุฎทองและข้อความว่า โปรใจป๋า ถัดลงมาเป็นตัวเลขขนาดใหญ่ว่า เติม 29 รับ 100 ใต้ลงมาเป็นแถบเขียนว่า สล็อตเว็บตรง อันดับ 1 คู่กับโลโก้ BUNNY555 และแถบเขียนว่า เกมค่ายใหญ่ โบนัสไหลทุกชม. แถวล่างเป็นไอคอนวอลเล็ท ธนาคารที่รองรับ และพร้อมเพย์ พร้อมป้ายเขียนว่า เฉพาะสล็อตเท่านั้น ด้านขวาเป็นพรีเซนเตอร์หญิงสวมชุดสีชมพูถือชิปคาสิโน",
  },
  {
    src: slide3,
    alt: "ภาพโปรโมชั่น BUNNY555 โปรสมาชิกใหม่ บิลแรกรับ 20 เปอร์เซ็นต์ พื้นหลังชมพูมีไพ่ เหรียญทอง และของขวัญกระจายอยู่ ด้านบนซ้ายเป็นโลโก้ BUNNY555 ถัดมาเป็นป้ายเขียนว่า โปรสมาชิกใหม่ และตัวอักษรขนาดใหญ่ว่า บิลแรก รับ 20% ใต้ลงมาเป็นแถบเขียนว่า BUNNY555 สล็อตเว็บตรง อันดับ 1 และ เกมค่ายใหญ่ โบนัสไหลทุกชม. แถวล่างสุดเขียนว่า เล่นง่าย ฝาก-ถอนสะดวก ตลอด 24 ชม. ด้านขวาเป็นพรีเซนเตอร์หญิงสวมชุดสีชมพู ข้างกันเป็นตุ๊กตากระต่ายสีขาวสวมมงกุฎอยู่กับไหทองคำ",
  },
];

const COPIES = 3;
const slides = Array.from({ length: COPIES }, () => images).flat();
---

<div class="marquee mx-auto w-full max-w-7xl overflow-hidden px-4 py-5">
  <input id="carousel-pause" type="checkbox" class="peer sr-only" />
  <label
    for="carousel-pause"
    class="sr-only cursor-pointer peer-focus-visible:not-sr-only peer-focus-visible:mb-3 peer-focus-visible:inline-block peer-focus-visible:rounded-full peer-focus-visible:border peer-focus-visible:border-[#ec4899]/60 peer-focus-visible:px-4 peer-focus-visible:py-2 peer-focus-visible:text-sm peer-focus-visible:font-bold peer-focus-visible:text-[#9d174d]">
    หยุด / เล่นสไลด์ภาพ
  </label>

  <div class="marquee-track flex">
    {
      slides.map((slide, index) => {
        const isDuplicate = index >= images.length;
        return (
          <div class="marquee-slide" aria-hidden={isDuplicate ? "true" : undefined}>
            <Picture
              src={slide.src}
              alt={isDuplicate ? "" : slide.alt}
              class="block w-full rounded-xl border border-[#e8a020]/40 object-cover shadow-[0_10px_30px_rgba(190,24,93,0.15)]"
              width={slide.src.width}
              height={slide.src.height}
              loading="lazy"
              fetchpriority="low"
              decoding="async"
              widths={[300, 360, 420, 480, 540, 600]}
              sizes="(max-width: 767px) calc(100vw - 32px), (max-width: 1279px) calc((100vw - 48px) / 2), 403px"
              formats={["avif", "webp"]}
              fallbackFormat="webp"
              quality={60}
            />
          </div>
        );
      })
    }
  </div>
</div>

<style>
  .marquee {
    --gap: 12px;
    --per-view: 1;
    --shift: calc(-200% - 24px);
  }

  @media (min-width: 768px) {
    .marquee {
      --gap: 16px;
      --per-view: 2;
      --shift: calc(-100% - 16px);
    }
  }

  @media (min-width: 1280px) {
    .marquee {
      --gap: 20px;
      --per-view: 3;
      --shift: calc(-66.6667% - 13.3333px);
    }
  }

  .marquee-track {
    gap: var(--gap);
    width: 100%;
    animation: carousel-scroll 24s linear infinite;
    will-change: transform;
  }

  .marquee-slide {
    flex: 0 0 calc((100% - (var(--per-view) - 1) * var(--gap)) / var(--per-view));
  }

  @keyframes carousel-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(var(--shift));
    }
  }

  .marquee:hover .marquee-track,
  .marquee:focus-within .marquee-track,
  .marquee > input:checked ~ .marquee-track {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
    }
  }
</style>
