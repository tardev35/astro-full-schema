---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";
import CtaRedirect from "../components/CtaRedirect.astro";
import { pageGraph } from "../lib/schema";

const pageTitle = "สมัครสมาชิก RIEL38 | ปุ่มเปิดยูสใหม่ผ่านมือถือ เว็บสล็อตมาใหม่";

const pageDescription =
  "สมัครสมาชิก RIEL38 เปิดยูสใหม่ผ่านมือถือได้ในไม่กี่นาที กดปุ่มเดียวไปยังหน้าสมัคร ใช้ยูสเดียวเล่นได้กว่า 2,000 เกมจาก 30+ ค่าย พร้อมรับโปรสมาชิกใหม่ของ เรียล38";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "สมัครสมาชิก", path: "/register" },
  ],
});

const targetUrl = "https://yoalink.com/22hs";
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="สมัครสมาชิก RIEL38" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label="สมัครสมาชิก RIEL38"
        class="group relative mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#db2777]/60 bg-gradient-to-r from-[#fb923c] via-[#f472b6] to-[#ec4899] px-6 py-4 text-xl font-bold tracking-wide text-white shadow-[0_10px_30px_rgba(236,72,153,0.26)] transition-all duration-300 hover:scale-105 hover:border-[#f9a8d4]/70 hover:shadow-[0_15px_40px_rgba(236,72,153,0.35)]">
        สมัครสมาชิก RIEL38
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="สมัครสมาชิก" />
</MainLayout>
