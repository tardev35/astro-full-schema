---
const reviews = [
  {
    name: "สมาชิกที่ย้ายมาจากเว็บเอเย่นต์",
    role: "เทียบความเสถียรตอนคนเล่นพร้อมกันเยอะ",
    stars: 5,
    tag: "เว็บตรง ไร้ตัวกลาง",
    content:
      "ที่ต่างชัดคือช่วงหัวค่ำที่คนเข้าพร้อมกันเยอะครับ เกมยังไม่เด้ง ไม่หลุดกลางรอบ กดเข้าเกมแล้วโหลดขึ้นเลย เพราะเชื่อ API ตรงจากค่ายแม่ ไม่ได้ผ่านคนกลาง เครดิตกับยอดเดิมพันเลยเดินตรงไปตรงมา ไม่ต้องมานั่งลุ้นว่าระบบจะค้างตรงไหน",
    avatar: "🐷",
  },
  {
    name: "สมาชิกที่ทำรายการเองทุกครั้ง",
    role: "ฝากถอนผ่านระบบออโต้ ไม่แจ้งสลิป",
    stars: 5,
    tag: "ธุรกรรมในเสี้ยววินาที",
    content:
      "เมื่อก่อนต้องส่งสลิปแล้วรอแอดมินตอบค่ะ ที่นี่ฝากเสร็จเครดิตเข้ากระเป๋าเกมเลย ถอนก็เด้งเข้าบัญชีไวมาก ทำรายการตอนดึกก็ไม่ต้องรอใครมาเปิดระบบให้ ขั้นตอนสั้นจนบางทีกดถอนแล้วเปิดแอปธนาคารไม่ทันด้วยซ้ำ",
    avatar: "⚡",
  },
  {
    name: "สมาชิกที่เริ่มจากยอดเล็ก",
    role: "เติมเครดิตผ่านทรูมันนี่วอลเล็ท",
    stars: 5,
    tag: "ไม่บังคับขั้นต่ำ",
    content:
      "ผมชอบที่ไม่บังคับขั้นต่ำครับ วันไหนอยากวอร์มระบบก็เริ่มยอดเล็ก วันไหนจังหวะเข้ามือค่อยเพิ่มน้ำหนัก ไม่ต้องฝืนตามที่เว็บกำหนด แล้วเติมผ่านวอเลทได้ด้วย ช่วงที่แอปธนาคารปิดปรับปรุงก็ยังเติมเครดิตต่อได้",
    avatar: "👛",
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label="เสียงจากสมาชิก PIGAUTO" class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#ffe9a8] via-[#f5c542] to-[#f9a8bd] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      เสียงจากสมาชิก <span class="text-[#f5c542]">PIGAUTO</span>
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#f5c542] to-transparent"></div>
  </div>

  <div class="mx-auto mb-8 flex max-w-md items-center justify-center gap-5 rounded-2xl border border-[#f5c542]/25 bg-[#1c0403]/92 px-6 py-4 shadow-[0_10px_30px_rgba(10,2,1,0.5)] backdrop-blur-xl">
    <div class="flex flex-col items-center">
      <span class="bg-gradient-to-b from-[#ffe9a8] to-[#a9761a] bg-clip-text text-4xl leading-none font-black text-transparent">{average}</span>
      <span class="mt-1 text-[10px] font-bold tracking-widest text-[#f7e2e2]/70 uppercase">คะแนนเฉลี่ย</span>
    </div>
    <div class="h-12 w-px bg-[#4a0d0a]"></div>
    <div class="flex flex-col gap-1.5">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#f5c542]" : "text-[#4a0d0a]"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#f7e2e2]/70">คะแนนเฉลี่ย {average} จาก 5 ดาว จากการใช้งานจริงของสมาชิก {reviews.length} ด้าน</span>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
    {
      reviews.map((review) => (
        <article class="group relative isolate flex flex-col gap-4 overflow-hidden rounded-2xl border border-[#f5c542]/25 bg-[#1c0403]/92 p-6 text-left shadow-[0_10px_30px_rgba(10,2,1,0.5)] backdrop-blur-xl transition-all duration-300 hover:-translate-y-1 hover:border-[#f5c542]/55 hover:shadow-[0_15px_40px_rgba(245,197,66,0.30)]">
          <span class="absolute inset-y-0 left-0 -z-10 w-1 bg-gradient-to-b from-[#ffe9a8] to-[#d81f26] opacity-80 transition-opacity duration-300 group-hover:opacity-100" />
          <span class="pointer-events-none absolute -top-14 -right-14 -z-10 h-32 w-32 rounded-full bg-[#d81f26]/45 blur-[50px] transition-all duration-300 group-hover:bg-[#f5c542]/25" />

          <div class="flex items-center justify-between gap-3">
            <span class="inline-flex items-center gap-1.5 rounded-full border border-[#f5c542]/25 bg-[#2e0806] px-3 py-1 text-[10px] font-bold tracking-widest text-[#f5c542] uppercase">
              <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#f5c542]" />
              {review.tag}
            </span>
            <span class="flex gap-0.5 text-sm">
              <span aria-hidden="true" class="flex gap-0.5">
                {Array.from({ length: 5 }).map((_, i) => (
                  <span class={i < review.stars ? "text-[#f5c542]" : "text-[#4a0d0a]"}>★</span>
                ))}
              </span>
              <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
            </span>
          </div>

          <p class="text-left text-base leading-relaxed text-[#f7e2e2]">{review.content}</p>

          <div class="mt-auto flex items-center gap-3 border-t border-[#4a0d0a] pt-4">
            <span
              aria-hidden="true"
              class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#f5c542]/30 bg-gradient-to-br from-[#ffe9a8] via-[#f5c542] to-[#4a0d0a] text-xl shadow-inner transition-transform duration-300 group-hover:scale-110">
              {review.avatar}
            </span>
            <span class="flex flex-col">
              <span class="text-sm font-black text-[#f7e2e2] transition-colors group-hover:text-[#ffe9a8]">{review.name}</span>
              <span class="text-[10px] font-bold tracking-wider text-[#f7e2e2]/70 uppercase">{review.role}</span>
            </span>
          </div>
        </article>
      ))
    }
  </div>
</section>
