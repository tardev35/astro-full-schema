---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import ContentBoxTwo from "../components/ContentBoxTwo.astro";
import ContentBoxSevenThree from "../components/ContentBoxSevenThree.astro";
import ContentBoxThreeColums from "../components/ContentBox3Three.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import SmoothCarousel from "../components/SmoothCarousel.astro";
import ProviderGrid from "../components/ProviderGrid.astro";
import LatestWinners from "../components/LatestWinners2.astro";

const currentPath = Astro.url.pathname;
const homePage = Astro.url.origin;
const logoUrl = homePage + "/logo.webp";

// 🌟 JS Schema ครบถ้วน ห้ามตัด!
const webPageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: "KONG24H เว็บเดิมพัน อันดับ 1 เกมคาสิโนล้ำสมัย โปรเด็ดดวง",
  description: "KONG24H คาสิโนออนไลน์ สล็อต บาคาร่า หวย กีฬา ยิงปลา ฝากถอนออโต้ 24 ชั่วโมง การันตีคุณภาพระดับ VIP",
  url: currentPath,
};
const webSiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "KONG24H",
  alternateName: ["kong24h", "kong24", "kong24h auto"],
  url: "https://kong24h-main.com/",
};
const orgSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "KONG24H",
  logo: logoUrl,
  url: homePage,
};
const allSchemas = [webPageSchema, orgSchema, webSiteSchema];

import { Picture } from "astro:assets";
import image1 from "../assets/slide2.jpg";
---

<MainLayout>
  <script type="application/ld+json" set:html={JSON.stringify(allSchemas)} />

  <Announcement />

  <ContentBox title="KONG24H เว็บเดิมพันออนไลน์ล้ำสมัย ศูนย์รวมคาสิโนระดับโลก">
    <p class="leading-relaxed">
      <strong class="text-amber-400">KONG24H</strong> แพลตฟอร์มเว็บเดิมพันออนไลน์ที่ล้ำสมัยที่สุดในยุคนี้ เราได้รวบรวมความบันเทิงระดับโลกมาไว้ให้คุณในที่เดียว เพื่อมอบประสบการณ์การเล่นเกมคาสิโนที่เหนือชั้น
      ปลอดภัย และได้มาตรฐานสากล ไม่ว่าคุณจะเป็นนักเดิมพันสายไหน ที่นี่คือคำตอบสุดท้ายที่จะเปลี่ยนทุกการสปินและการวางเดิมพันของคุณให้กลายเป็นผลกำไรได้อย่างคุ้มค่า เปิดให้บริการเต็มรูปแบบตลอด 24 ชั่วโมง
    </p>

    <div class="mt-8 flex flex-wrap justify-center gap-5">
      <a
        href="/login"
        class="flex items-center justify-center rounded-full border-2 border-yellow-500 bg-[#4a0404] px-10 py-3.5 font-black text-yellow-400 shadow-[0_0_20px_rgba(234,179,8,0.3)] transition-transform hover:scale-105 hover:bg-[#5c0a0a]">
        เข้าสู่ระบบ
      </a>
      <a
        href="/register"
        class="flex items-center justify-center rounded-full bg-gradient-to-r from-yellow-400 via-yellow-500 to-yellow-600 px-10 py-3.5 font-black text-red-950 shadow-[0_0_20px_rgba(234,179,8,0.5)] transition-transform hover:scale-105">
        สมัครสมาชิกใหม่
      </a>
    </div>
  </ContentBox>

  <LatestWinners />

  <ProviderGrid />

  <ContentBoxThreeColums titleleft="🥇 เว็บอันดับ 1" titlecenter="⚡ ฝาก-ถอน ออโต้" titleright="💎 VIP SERVICE">
    <div slot="left" class="text-sm text-red-100/80">การันตีคุณภาพด้วยยอดผู้เล่นสูงสุด คัดสรรเฉพาะค่ายเกมระดับโลก มั่นคง ปลอดภัย 100%</div>
    <div slot="center" class="text-sm text-red-100/80">ทำรายการธุรกรรมการเงินด้วยระบบอัตโนมัติที่รวดเร็วที่สุด ไม่ต้องรอนาน ใช้งานง่ายตลอด 24 ชั่วโมง</div>
    <div slot="right" class="text-sm text-red-100/80">ดูแลลูกค้าอย่างดีเยี่ยมดุจญาติมิตร ด้วยทีมงานคุณภาพที่พร้อมให้คำปรึกษาและแก้ไขปัญหาทันที</div>
  </ContentBoxThreeColums>

  <ContentBoxTwo titleleft="KONG24H เว็บคาสิโนล้ำสมัย อันดับ 1" titleright="KONG24H เชื่อม API ตรง เกมคาสิโนยอดฮิต รันครบจบทุกค่าย">
    <div slot="left" class="text-white/80">
      <p>
        ก้าวสู่มิติใหม่ของกาเดิมพัน เปลี่ยนเวลาว่างๆเป็นให้สนุกและอาจะทำเงินได้ง่ายๆ ได้กับ <strong class="text-yellow-400">KONG24H</strong> เว็บคาสิโนล้ำสมัยที่ครองอันดับ 1 ในใจผู้เล่นทั่วประเทศ เราโดดเด่นด้วยการพัฒนาระบบหลังบ้านให้มีความเสถียรสูงสุด
        รองรับการเข้าใช้งานพร้อมกันได้นับแสนคนโดยไม่มีอาการกระตุก นอกจากนี้เรายังเป็นเว็บตรงมั่นคงปลอดภัย 100% ที่การเงินหนาที่สุด ทำให้ผู้เล่นมั่นใจได้เลยว่า ทุกยอดถอนจะได้รับเงินจริง ครบทุกบาททุกสตางค์อย่างแน่นอน
      </p>
    </div>
    <div slot="right" class="text-white/80">
      <p>
        หมดปัญหาเรื่องเกมค้างหรือโบนัสไม่เข้า เพราะที่ KONG24H เราใช้ระบบ <strong class="text-amber-400">เชื่อม API ตรง</strong> จากค่ายเกมชั้นนำระดับโลก ไม่ผ่านคนกลาง ทำให้สัญญาณเกมมีความแม่นยำ ลื่นไหล
        และมีอัตราการชนะ (RTP) ที่เป็นธรรมที่สุด สนุกไปกับเกมคาสิโนยอดฮิตมากมาย:
      </p>
      <ul class="list-inside list-disc text-white/80">
        <li class="mb-2">สล็อตออนไลน์: รวมค่ายดังอย่าง PG Slot, Pragmatic Play, Joker Gaming สล็อตแตกง่าย กราฟิก 3D ล้ำสมัย</li>
        <li class="mb-2">คาสิโนสด (Live Casino): ส่งตรงสัญญาณคมชัดระดับ Full HD จาก Evolution Gaming, Sexy Baccarat, SA Gaming ให้คุณเดิมพันบาคาร่าและไฮโลแบบเรียลไทม์</li>
        <li class="mb-2">เกมเดิมพันอื่นๆ: ครบครันทั้งเกมยิงปลา, เดิมพันกีฬา, และ E-Sports ยอดนิยม รับครบจบในเว็บเดียวไม่ต้องโยกเงิน</li>
      </ul>
    </div>
  </ContentBoxTwo>

  <SmoothCarousel />

  <ContentBoxSevenThree>
    <div slot="left" class="flex h-full flex-col justify-center">
      <Picture
        src={image1}
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600, 800]}
        sizes="(max-width: 768px) 100vw, 50vw"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
        alt="KONG24H VIP Service"
        class="mx-auto h-auto w-full rounded-2xl border-2 border-yellow-500/30 shadow-[0_10px_30px_rgba(234,179,8,0.2)]"
      />
    </div>
    <div slot="right">
      <h2 class="text-imperial-gradient mb-4 text-3xl font-black uppercase">รวมโปรเด็ดดวงและสิทธิพิเศษสำหรับสมาชิก KONG24H</h2>
      <p class="mb-6 text-white/80">เราพร้อมซัพพอร์ตนักเดิมพันทุกคนด้วย โปรเด็ดดวง และสิทธิพิเศษมากมายที่คุ้มค่ากว่าเว็บไหนๆ เพื่อเพิ่มทุนและเพิ่มโอกาสในการชนะรางวัลใหญ่ให้กับคุณ:</p>
      <ul class="list-inside list-disc text-white/80">
        <li class="mb-2">โปรโมชันสมาชิกใหม่: รับโบนัสต้อนรับทันทีเมื่อทำการสมัครและฝากเงินครั้งแรก</li>
        <li class="mb-2">โบนัสเงินฝากรายวัน: แจกเครดิตเพิ่มให้ทุกยอดฝาก ยิ่งฝากมากยิ่งได้สิทธิ์หมุนวงล้อลุ้นโชคใหญ่</li>
        <li class="mb-2">กิจกรรมแจกทองและเครดิตฟรี: ร่วมสนุกกับกิจกรรมพิเศษของทางเว็บไซต์ที่มีจัดขึ้นเป็นประจำทุกสัปดาห์</li>
      </ul>
      <a href="/line" class="inline-flex items-center rounded-full bg-[#00B900] px-8 py-3 font-bold text-white shadow-lg transition-transform hover:scale-105">
        <span class="mr-2 text-xl">💬</span> LINE Call Center
      </a>
    </div>
  </ContentBoxSevenThree>
  <ContentBoxTwo titleleft="สมัครสมาชิก KONG24H ง่ายๆ ใน 3 ขั้นตอน" titleright="ฝากถอน ไม่มีขั้นต่ำ คืนยอดเสียสูงถึง10%">
    <div slot="left" class="text-white/80">
      <p>เริ่มต้นความสนุกและเข้ารับโปรเด็ดดวงกับเว็บอันดับ 1 ได้ง่ายๆ ภายในเวลาไม่ถึง 1 นาที ด้วยระบบสมัครสมาชิกอัตโนมัติ:</p>
      <ul>
        <li class="mb-2">เข้าสู่หน้าเว็บ: คลิกที่ปุ่ม "สมัครสมาชิก" บนหน้าเว็บไซต์ KONG24H</li>
        <li class="mb-2">กรอกข้อมูล: ใส่เบอร์โทรศัพท์ และข้อมูลบัญชีธนาคารสำหรับใช้ฝาก-ถอน (ข้อมูลจะถูกเก็บเป็นความลับสูงสุด)</li>
        <li class="mb-2">เข้าเล่นได้ทันที: รับ Username และ Password จากนั้นล็อกอินเข้าสู่ระบบ เลือกรับโปรโมชันที่ต้องการแล้วลุยได้เลย!</li>
      </ul>
    </div>
    <div slot="right" class="text-white/80">
      <p>
        อิสระทางการเงินที่แท้จริงเริ่มต้นที่นี่ KONG24H เปิดโอกาสให้ผู้เล่นทุกระดับทุนเข้ามาร่วมสนุกได้อย่างเท่าเทียมด้วยระบบ <strong class="text-yellow-400">ฝากถอน ไม่มีขั้นต่ำ</strong> มี 1 บาทก็ฝากเข้ามาเล่นได้
        ทำรายการผ่านระบบออโต้รวดเร็วใน 3 วินาที และพิเศษสุดสำหรับสมาชิกของเรา เล่นเสียเราไม่ปล่อยให้หมดหวัง! ซัพพอร์ตด้วยการ คืนยอดเสียสูงถึง 10% ทุกวัน ให้คุณมีทุนกลับไปแก้มือและทำกำไรได้ใหม่อีกครั้ง
      </p>
    </div>
  </ContentBoxTwo>
  <ContentBox>
    <h2 class="text-imperial-gradient mb-4 text-3xl font-black uppercase">รวมโปรเด็ดดวงและสิทธิพิเศษสำหรับสมาชิก KONG24H</h2>
    <p>
      คุณสามารถเข้าถึงความสนุกกับ KONG24H ได้อย่างสะดวกสบายผ่าน <strong class="text-amber-400">ทางเข้า เว็บเดิมพัน</strong> ที่ทีมงานของเราคอยอัปเดตลิงก์ใหม่ล่าสุดอยู่เสมอ เพื่อป้องกันปัญหาลิงก์เสียหรือโดนบล็อก
      รองรับการใช้งานตลอด 24 ชั่วโมงในทุกแพลตฟอร์ม ระบบมือถือ รองรับทั้ง iOS และ Android เล่นผ่านเบราว์เซอร์ได้ทันทีโดยไม่ต้องดาวน์โหลดแอปพลิเคชัน ระบบคอมพิวเตอร์: รองรับทั้ง Windows และ Mac หน้าจอปรับขนาดอัตโนมัติ
      (Responsive Design) สวยงาม เต็มตา ทุกอุปกรณ์
    </p>
  </ContentBox>
  <Navfoot />

  <style>
    :global(.text-imperial-gradient) {
      background: linear-gradient(to bottom, #fef08a 0%, #ca8a04 100%) !important;
      -webkit-background-clip: text !important;
      -webkit-text-fill-color: transparent !important;
    }
  </style>
</MainLayout>
