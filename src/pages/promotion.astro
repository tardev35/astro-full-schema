---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxCyberCut.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";

import { Picture } from "astro:assets";

import pro1 from "../assets/slide1.png";
import pro2 from "../assets/slide2.png";
import pro3 from "../assets/slide3.png";
import pro4 from "../assets/slide4.png";
import { pageGraph } from "../lib/schema";

const pageTitle = "โปรโมชั่น GOAT888";

const pageDescription =
  "รวมภาพโปรโมชั่น GOAT888 ไว้ครบในหน้าเดียว ทั้งคืนยอดเสีย ชวนเพื่อนรับค่าคอม ฝากประจำรับเครดิตฟรี และสิทธิ์สมาชิกใหม่ อ่านเงื่อนไขบนภาพให้ครบก่อนกดรับสิทธิ์";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: pro1.src,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="โปรโมชั่น GOAT888" as="h1">
    <p class="mb-8 text-left text-base leading-relaxed text-[#f7e3f4]">
      หน้านี้รวมภาพโปรโมชั่นที่ <strong class="text-[#f5c451]">GOAT888</strong> เปิดให้สมาชิกเลือกใช้ ทั้งคืนยอดเสียรายสัปดาห์ ชวนเพื่อนผ่านลิงก์รับค่าคอมต่อเนื่อง ฝากประจำรับเครดิตฟรีเพิ่ม
      และสิทธิ์สำหรับสมาชิกใหม่ แต่ละรายการมีเกมที่ร่วม ยอดเริ่มต้น และเงื่อนไขถอนไม่เท่ากัน จึงควรอ่านรายละเอียดบนภาพให้ครบก่อนกดรับสิทธิ์ทุกครั้ง
      เลือกโปรที่ตรงกับรูปแบบการเล่นได้แล้ว สมัครสมาชิกจากปุ่มด้านล่างเพื่อเริ่มใช้สิทธิ์ได้ทันที
    </p>

    <div class="grid w-full grid-cols-1 gap-6 sm:grid-cols-2">
      <Picture
        src={pro1}
        alt="ภาพโปรโมชั่น GOAT888 คืนยอดเสียสูงสุด 5 เปอร์เซ็นต์ มีตราวงกลมสีทองเขียนว่า CASHBACK REBATE และแถบข้อความ เว็บตรงสล็อตแท้ เข้าสู่ระบบง่าย รับเครดิตคืนทุกสัปดาห์ รีบเช็กสิทธิ์ก่อนเล่นรอบถัดไป พื้นหลังสีดำเรืองแสงชมพูนีออน มีพรีเซนเตอร์หญิงชุดหนังสีดำยืนอยู่ด้านขวา และหน้าจอมือถือขึ้นคำว่า BIG WIN"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class="mx-auto h-auto w-full rounded-xl border border-[#8f1080]/70 object-contain shadow-[0_10px_30px_rgba(255,61,219,0.22)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#f5c451]/60 hover:shadow-[0_15px_40px_rgba(245,196,81,0.28)]"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />

      <Picture
        src={pro2}
        alt="ภาพโปรโมชั่น GOAT888 ชวนเพื่อนผ่านลิงก์รับรายได้ต่อเนื่อง มีไอคอนสี่ขั้นตอนเรียงกัน คัดลอกลิงก์ แชร์ให้เพื่อน เพื่อนสมัคร รับค่าคอมต่อเนื่อง พร้อมข้อความ แชร์ลิงก์ง่าย รับค่าคอมทุกสัปดาห์ และ สมัครง่ายผ่านมือถือ ใช้งานสะดวก พื้นหลังสีดำลายเส้นทองตัดชมพู มีพรีเซนเตอร์หญิงถือโทรศัพท์ยืนอยู่ด้านขวา"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class="mx-auto h-auto w-full rounded-xl border border-[#8f1080]/70 object-contain shadow-[0_10px_30px_rgba(255,61,219,0.22)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#f5c451]/60 hover:shadow-[0_15px_40px_rgba(245,196,81,0.28)]"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />

      <Picture
        src={pro3}
        alt="ภาพโปรโมชั่น GOAT888 ฝากประจำทุกวันรับเครดิตฟรีเพิ่ม มีไอคอนสี่ช่องเขียนว่า สมัครง่ายเข้าสู่ระบบไว เว็บตรงสล็อตแท้ สมาชิกใหม่รับโปรได้ต่อเนื่อง โบนัสจัดเต็มคุ้มทุกวัน ด้านล่างมีข้อความ ฝากถอนออโต้ เล่นผ่านมือถือได้ทุกวัน ในภาพมีหีบสมบัติทองเปิดออกพร้อมเหรียญและชิปคาสิโน และพรีเซนเตอร์หญิงผมสีชมพูยืนอยู่ด้านซ้าย"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class="mx-auto h-auto w-full rounded-xl border border-[#8f1080]/70 object-contain shadow-[0_10px_30px_rgba(255,61,219,0.22)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#f5c451]/60 hover:shadow-[0_15px_40px_rgba(245,196,81,0.28)]"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />

      <Picture
        src={pro4}
        alt="ภาพโปรโมชั่น GOAT888 เข้าสู่ระบบง่าย เว็บตรงสล็อตแท้ สมาชิกใหม่สมัครรับเครดิตฟรี ในภาพมีการ์ด VIP สีทอง ไพ่โพดำ ชิปคาสิโน และกล่องของขวัญวางกองรวมกัน ด้านล่างมีแถบข้อความ เล่นผ่านมือถือ ฝากถอนอัตโนมัติ ใช้งานง่าย และปุ่มสีทองเขียนว่า สมัครสมาชิก พรีเซนเตอร์หญิงชุดสีดำยืนอยู่ด้านขวา"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class="mx-auto h-auto w-full rounded-xl border border-[#8f1080]/70 object-contain shadow-[0_10px_30px_rgba(255,61,219,0.22)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#f5c451]/60 hover:shadow-[0_15px_40px_rgba(245,196,81,0.28)]"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />
    </div>

    <div class="mt-12 flex justify-center pb-4">
      <a
        href="/register"
        class="flex items-center justify-center rounded-lg border border-[#ffa3ee]/60 bg-gradient-to-r from-[#ffa3ee] via-[#ff3ddb] to-[#8f1080] px-10 py-3.5 text-lg font-black text-[#0a0208] shadow-[0_10px_30px_rgba(255,61,219,0.28)] transition-transform hover:scale-105 hover:shadow-[0_15px_40px_rgba(245,196,81,0.4)]">
        สมัครสมาชิก GOAT888
      </a>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
