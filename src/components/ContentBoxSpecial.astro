---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h2" } = Astro.props;
---

<section class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#1f0b4d] bg-[#0a0320] p-6 text-[#ece6ff] shadow-[0_10px_30px_rgba(255,61,200,0.16)] transition-all duration-500 hover:border-[#ff3dc8]/55 md:p-10">
    <div
      aria-hidden="true"
      class="pointer-events-none absolute top-0 left-1/2 -z-10 h-[3px] w-1/2 -translate-x-1/2 bg-gradient-to-r from-transparent via-[#ff3dc8] to-transparent opacity-60 transition-opacity duration-500 group-hover:opacity-100">
    </div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#1f0b4d] pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ff3dc8] to-[#1be5f4] shadow-[0_0_10px_rgba(255,61,200,0.45)]" />
          <HeadingTag class="bg-gradient-to-r from-[#9bf2fb] via-[#ff8fe0] to-[#ff3dc8] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-2 lg:gap-10">
      <article
        class="relative flex gap-4 rounded-2xl border border-[#1f0b4d] bg-[#120633] p-6 text-left text-base leading-relaxed text-[#ece6ff] transition-all duration-300 hover:-translate-y-2 hover:border-[#ff3dc8]/55 hover:bg-[#1f0b4d] hover:shadow-[0_15px_40px_rgba(255,61,200,0.24)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#2c1266] bg-gradient-to-br from-[#ff8fe0] via-[#ff3dc8] to-[#b3128a] text-2xl shadow-[0_5px_15px_rgba(255,61,200,0.35)]">
          🎰
        </div>
        <slot name="left" />
      </article>

      <article
        class="relative flex gap-4 rounded-2xl border border-[#1f0b4d] bg-[#120633] p-6 text-left text-base leading-relaxed text-[#ece6ff] transition-all duration-300 hover:-translate-y-2 hover:border-[#1be5f4]/60 hover:bg-[#1f0b4d] hover:shadow-[0_15px_40px_rgba(27,229,244,0.22)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#0aa4c4] bg-gradient-to-br from-[#9bf2fb] via-[#1be5f4] to-[#0aa4c4] text-2xl shadow-[0_5px_15px_rgba(27,229,244,0.30)]">
          ⚖️
        </div>
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
