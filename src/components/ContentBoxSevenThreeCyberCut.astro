---
export interface Props {
  titleleft?: string;
  titleright?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { titleleft, titleright, as: HeadingTag = "h2" } = Astro.props;
---

<section class="mx-auto mb-6 w-full max-w-7xl px-4 font-sans">
  <div
    class="relative isolate w-full border border-[#e0aa2e]/30 bg-[#160f07]/92 p-8 text-[#efe0c4] shadow-[0_10px_30px_rgba(224,170,46,0.18)] backdrop-blur-md transition-all duration-300 hover:border-[#e0aa2e]/55 hover:shadow-[0_15px_40px_rgba(224,170,46,0.28)]"
    style="clip-path: polygon(30px 0, 100% 0, 100% calc(100% - 30px), calc(100% - 30px) 100%, 0 100%, 0 30px);">
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-[2px] w-24 bg-gradient-to-r from-[#e0aa2e] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-[2px] w-24 bg-gradient-to-l from-[#d8cdb6] to-transparent"></div>
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-16 w-[2px] bg-gradient-to-b from-[#e0aa2e] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-16 w-[2px] bg-gradient-to-t from-[#d8cdb6] to-transparent"></div>

    <div class="grid grid-cols-1 gap-8 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#efe0c4]">
        {
          titleleft && (
            <div class="flex items-baseline gap-2 border-b border-[#6b4310]/60 pb-2">
              <span aria-hidden="true" class="font-mono text-[#d8cdb6]">
                &gt;_
              </span>
              <HeadingTag class="text-xl leading-normal font-black text-[#f5d488] uppercase">{titleleft}</HeadingTag>
            </div>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#efe0c4] md:border-l md:border-[#6b4310]/60 md:pl-8">
        {
          titleright && (
            <div class="flex items-baseline gap-2 border-b border-[#6b4310]/60 pb-2">
              <span aria-hidden="true" class="font-mono text-[#d8cdb6]">
                &gt;_
              </span>
              <HeadingTag class="text-xl leading-normal font-black text-[#f5d488] uppercase">{titleright}</HeadingTag>
            </div>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
