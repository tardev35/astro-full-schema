---
import { Picture } from "astro:assets";

import slide2 from "../assets/slide2.png";
import slide3 from "../assets/slide3.png";

const images = [
  {
    src: slide3,
    alt: "ภาพโปรโมชั่น GOAT888 พื้นหลังสีดำมีเหรียญทองลอยอยู่และแสงสีชมพูนีออน ด้านบนเป็นตัวอักษรว่า GOAT888 ถัดลงมาเป็นตัวอักษรขนาดใหญ่ว่า ฝากประจำทุกวัน รับ เครดิตฟรี เพิ่ม ใต้ลงมาเป็นการ์ดสี่ใบเขียนว่า สมัครง่าย เข้าสู่ระบบไว, เว็บตรง สล็อตแท้, สมาชิกใหม่ รับโปรได้ต่อเนื่อง และ โบนัสจัดเต็ม คุ้มทุกวัน ตรงกลางล่างเป็นหีบสมบัติสีทองเปิดอยู่พร้อมเหรียญทองและชิปคาสิโนที่มีเลข 888 แถบล่างสุดเขียนว่า ฝากถอนออโต้ และ เล่นผ่านมือถือได้ทุกวัน ด้านซ้ายเป็นพรีเซนเตอร์หญิงผมสีชมพูสวมชุดสีดำมันวาว",
  },
  {
    src: slide2,
    alt: "ภาพโปรโมชั่น GOAT888 พื้นหลังสีดำมีเส้นแสงสีชมพูนีออนและแถบสีทอง ด้านบนซ้ายเป็นโลโก้รูปหัวแพะสีทองพร้อมตัวอักษรว่า GOAT888 ถัดลงมาเป็นตัวอักษรขนาดใหญ่ว่า ชวนเพื่อน ผ่านลิงก์ และ รับรายได้ต่อเนื่อง ใต้ลงมาเป็นแถบเขียนว่า แชร์ลิงก์ง่าย รับค่าคอมทุกสัปดาห์ ตามด้วยไอคอนสี่ขั้นตอนเขียนว่า คัดลอกลิงก์, แชร์ให้เพื่อน, เพื่อนสมัคร และ รับค่าคอมต่อเนื่อง แถบล่างสุดเขียนว่า สมัครง่าย ผ่านมือถือ ใช้งานสะดวก คู่กับกรอบที่มีตัวอักษรว่า WWW.GOAT888.COM ด้านขวาเป็นพรีเซนเตอร์หญิงชุดสีดำกำลังถือโทรศัพท์ที่มีโลโก้ GOAT888",
  },
];

const COPIES = 3;
const slides = Array.from({ length: COPIES }, () => images).flat();
---

<div class="marquee mx-auto w-full max-w-7xl overflow-hidden px-4 py-5">
  <input id="carousel-pause" type="checkbox" class="peer sr-only" />
  <label
    for="carousel-pause"
    class="sr-only cursor-pointer peer-focus-visible:not-sr-only peer-focus-visible:mb-3 peer-focus-visible:inline-block peer-focus-visible:rounded-full peer-focus-visible:border peer-focus-visible:border-[#f5c451]/60 peer-focus-visible:px-4 peer-focus-visible:py-2 peer-focus-visible:text-sm peer-focus-visible:font-bold peer-focus-visible:text-[#ffe6a3]">
    หยุด / เล่นสไลด์ภาพ
  </label>

  <div class="marquee-track flex">
    {
      slides.map((slide, index) => {
        const isDuplicate = index >= images.length;
        return (
          <div class="marquee-slide" aria-hidden={isDuplicate ? "true" : undefined}>
            <Picture
              src={slide.src}
              alt={isDuplicate ? "" : slide.alt}
              class="block w-full rounded-xl border border-[#f5c451]/40 object-cover shadow-[0_10px_30px_rgba(255,61,219,0.30)]"
              width={slide.src.width}
              height={slide.src.height}
              loading="lazy"
              fetchpriority="low"
              decoding="async"
              widths={[300, 360, 420, 480, 540, 600]}
              sizes="(max-width: 767px) calc(100vw - 32px), (max-width: 1279px) calc((100vw - 48px) / 2), 403px"
              formats={["avif", "webp"]}
              fallbackFormat="webp"
              quality={60}
            />
          </div>
        );
      })
    }
  </div>
</div>

<style>
  .marquee {
    --gap: 12px;
    --per-view: 1;
    --shift: calc(-200% - 24px);
  }

  @media (min-width: 768px) {
    .marquee {
      --gap: 16px;
      --per-view: 2;
      --shift: calc(-100% - 16px);
    }
  }

  @media (min-width: 1280px) {
    .marquee {
      --gap: 20px;
      --per-view: 3;
      --shift: calc(-66.6667% - 13.3333px);
    }
  }

  .marquee-track {
    gap: var(--gap);
    width: 100%;
    animation: carousel-scroll 24s linear infinite;
    will-change: transform;
  }

  .marquee-slide {
    flex: 0 0 calc((100% - (var(--per-view) - 1) * var(--gap)) / var(--per-view));
  }

  @keyframes carousel-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(var(--shift));
    }
  }

  .marquee:hover .marquee-track,
  .marquee:focus-within .marquee-track,
  .marquee > input:checked ~ .marquee-track {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
    }
  }
</style>
