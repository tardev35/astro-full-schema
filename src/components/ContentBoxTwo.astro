---
export interface Props {
  titleleft?: string;
  titleright?: string;
  label?: string;
}
const { titleleft, titleright, label } = Astro.props;

const sectionLabel = label ?? titleleft ?? titleright ?? "ข้อมูลประกอบ";
---

<section aria-label={sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#7a1038]">
      {
        titleleft && (
          <p class="flex items-center gap-3 border-b border-[#f9c2d9] pb-3 text-xl leading-normal font-black tracking-widest text-[#9d174d] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#e8a020]/40 bg-gradient-to-br from-[#f7c948] via-[#e8a020] to-[#a86a10] text-sm text-[#7a1038] shadow-[0_5px_15px_rgba(232,160,32,0.20)]">
              🔐
            </span>
            {titleleft}
          </p>
        )
      }
      <slot name="left" />
    </article>

    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#7a1038]">
      {
        titleright && (
          <p class="flex items-center gap-3 border-b border-[#f9c2d9] pb-3 text-xl leading-normal font-black tracking-widest text-[#9d174d] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#ec4899]/60 bg-gradient-to-br from-[#f472b6] via-[#ec4899] to-[#be185d] text-sm text-white shadow-[0_5px_15px_rgba(190,24,93,0.20)]">
              📊
            </span>
            {titleright}
          </p>
        )
      }
      <slot name="right" />
    </article>
  </div>
</section>
