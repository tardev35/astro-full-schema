---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
  label?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label } = Astro.props;

const sectionLabel = label ?? title ?? titleleft ?? titleright ?? "ข้อมูลประกอบ";
---

<section aria-label={sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#1d5c22] bg-[#06230a] p-8 text-[#d9f7d0] shadow-[0_10px_30px_rgba(63,194,10,0.16)] transition-all duration-500 hover:border-[#3fc20a]/55 md:p-10">
    {
      title && (
        <header class="mb-6 flex items-center gap-4 border-b border-[#1d5c22] pb-4">
          <span aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#c8fc04] to-[#3fc20a] shadow-[0_0_10px_rgba(200,252,4,0.45)]" />
          <HeadingTag class="bg-gradient-to-r from-[#f3ffe9] via-[#c8fc04] to-[#3fc20a] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#d9f7d0]">
        {
          titleleft && (
            <p class="flex items-center gap-3 border-b border-[#1d5c22] pb-3 text-xl leading-normal font-black tracking-widest text-[#e6ff6a] uppercase">
              <span
                aria-hidden="true"
                class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#1d5c22] bg-gradient-to-br from-[#e6ff6a] via-[#c8fc04] to-[#7ee000] text-sm text-[#0b2a05] shadow-[0_5px_15px_rgba(200,252,4,0.32)]">
                🔐
              </span>
              {titleleft}
            </p>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#d9f7d0]">
        {
          titleright && (
            <p class="flex items-center gap-3 border-b border-[#1d5c22] pb-3 text-xl leading-normal font-black tracking-widest text-[#e6ff6a] uppercase">
              <span
                aria-hidden="true"
                class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#1a7a08] bg-gradient-to-br from-[#c8fc04] via-[#3fc20a] to-[#1a7a08] text-sm text-[#0b2a05] shadow-[0_5px_15px_rgba(63,194,10,0.30)]">
                🎰
              </span>
              {titleright}
            </p>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
