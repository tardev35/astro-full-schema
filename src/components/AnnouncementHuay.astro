---
const { message = "🐉 HUAYPUNG มังกรพ่นลาภ: หวยออนไลน์ครบวงจร จ่ายไว จ่ายจริง รองรับทุกเลขเด็ด สมัครวันนี้รับสิทธิ์เข้ากลุ่มเลขลับ VIP ฟรี!" } = Astro.props;
---

<div class="mx-auto w-full max-w-7xl px-4 py-3 font-sans">
  <div class="relative flex overflow-hidden rounded-full border border-red-600/40 bg-[#450a0a]/90 shadow-[0_5px_15px_rgba(220,38,38,0.3)] backdrop-blur-md">
    <div
      class="relative z-10 flex shrink-0 items-center justify-center rounded-full bg-gradient-to-r from-yellow-600 via-yellow-500 to-yellow-600 px-6 py-2.5 font-black text-[#450a0a] shadow-[4px_0_15px_rgba(0,0,0,0.3)]">
      <span class="mr-2 animate-pulse text-lg">🐉</span> ประกาศด่วน!
    </div>

    <div class="marquee-container relative flex-1 overflow-hidden py-2.5 pr-6">
      <div class="pointer-events-none absolute top-0 left-0 z-10 h-full w-8 bg-gradient-to-r from-[#450a0a] to-transparent"></div>

      <div class="marquee-content inline-block pl-4 text-sm font-bold tracking-widest whitespace-nowrap text-red-100">
        <span class="mr-8 inline-flex items-center gap-2"><span class="h-2 w-2 rounded-full bg-yellow-400 shadow-[0_0_8px_rgba(251,191,36,0.8)]"></span>{message}</span>
        <span class="mr-8 inline-flex items-center gap-2"><span class="h-2 w-2 rounded-full bg-yellow-400 shadow-[0_0_8px_rgba(251,191,36,0.8)]"></span>{message}</span>
      </div>
    </div>
  </div>
</div>

<style>
  .font-sans {
    font-family: "Kanit", sans-serif;
  }
  .marquee-content {
    animation: marquee 20s linear infinite;
  }
  .marquee-container:hover .marquee-content {
    animation-play-state: paused;
  }
  @keyframes marquee {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }
</style>
