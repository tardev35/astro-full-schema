---
import { Picture } from "astro:assets";
import BankStrip from "./BankStrip.astro";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });
const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;
---

<footer
  class="relative mt-10 w-full overflow-hidden border-t border-[#d4a017]/35 bg-[#0a1207] pt-16 pb-8 font-sans text-[#dfeacf]"
  style="clip-path: polygon(0 30px, 50vw 0, 100% 30px, 100% 100%, 0 100%);">
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 opacity-[0.12]"
    style="background-image: linear-gradient(#4d7c0f 1px, transparent 1px), linear-gradient(90deg, #9a7112 1px, transparent 1px); background-size: 30px 30px;">
  </div>

  <div class="relative z-10 mx-auto w-full max-w-[1200px] px-6">
    <div class="mb-12 grid grid-cols-1 gap-10 md:grid-cols-12">
      <div class="flex flex-col gap-5 md:col-span-5">
        <a href="/" class="inline-block transition-transform hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt="โลโก้ WINSIAM88 ตัวอักษรทองสลักลายไทยพร้อมมาสคอตยักษ์สีเขียว"
                widths={[160, 320, 480]}
                sizes="160px"
                loading="lazy"
                class="h-[60px] w-auto drop-shadow-[0_4px_12px_rgba(163,230,53,0.35)]"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <span class="text-3xl font-black tracking-widest text-[#f5cf4d]">WINSIAM88</span>
            )
          }
        </a>
        <p class="border-l-2 border-[#d4a017] pl-4 text-sm leading-relaxed text-[#dfeacf]/80">
          WINSIAM88 เว็บหลักที่รวมสล็อต คาสิโนสด บาคาร่า กีฬา และเกมจากผู้ให้บริการกว่า 13 ค่ายไว้ในบัญชีเดียว ใช้ระบบกระเป๋าเดียว ฝากถอนออโต้ตลอด 24 ชั่วโมง และตรวจประวัติรายการได้จากจุดเดียว
        </p>
        <div class="mt-4 flex gap-3">
          <span class="border border-[#d4a017]/45 bg-[#0b1408] px-3 py-1 font-mono text-xs text-[#f5cf4d]">ONE_WALLET</span>
          <span class="border border-[#a3e635]/45 bg-[#0b1408] px-3 py-1 font-mono text-xs text-[#a3e635]">AUTO_24H</span>
        </div>
      </div>

      <nav class="flex flex-col gap-4 md:col-span-3 lg:pl-8">
        <p class="text-lg font-black tracking-widest text-[#f5cf4d] uppercase">/// DIRECTORY</p>
        <ul class="flex flex-col gap-3 font-mono text-sm text-[#dfeacf]/80">
          <li><a href="/" class="transition-colors hover:text-[#a3e635]">&gt; หน้าแรก</a></li>
          <li><a href="/promotion" class="transition-colors hover:text-[#a3e635]">&gt; โปรโมชั่น</a></li>
          <li><a href="/ทดลองเล่น" class="transition-colors hover:text-[#a3e635]">&gt; ทดลองเล่น</a></li>
          <li><a href="/ทางเข้า" class="transition-colors hover:text-[#a3e635]">&gt; ทางเข้า</a></li>
          <li><a href="/contact-us" class="transition-colors hover:text-[#a3e635]">&gt; ติดต่อเรา</a></li>
          <li><a href="/register" class="transition-colors hover:text-[#a3e635]">&gt; สมัครสมาชิก</a></li>
          <li><a href="/login" class="transition-colors hover:text-[#a3e635]">&gt; เข้าสู่ระบบ</a></li>
        </ul>
      </nav>

      <div class="flex flex-col gap-5 md:col-span-4">
        <p class="text-lg font-black tracking-widest text-[#f5cf4d] uppercase">/// SUPPORT_LINK</p>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 bg-[#00B900] py-3 font-bold text-white transition-all hover:bg-[#009900]"
          style="clip-path: polygon(10px 0, 100% 0, 100% calc(100% - 10px), calc(100% - 10px) 100%, 0 100%, 0 10px);">
          LINE CONNECT
        </a>

        <a
          href="#top"
          class="flex w-full items-center justify-center gap-2 border border-[#a3e635]/60 bg-transparent py-3 font-bold text-[#a3e635] transition-all hover:bg-[#1f3a08]/50"
          style="clip-path: polygon(10px 0, 100% 0, 100% calc(100% - 10px), calc(100% - 10px) 100%, 0 100%, 0 10px);">
          <span aria-hidden="true">↑</span> กลับขึ้นบน
        </a>

        <div class="mt-2 font-mono text-xs text-[#dfeacf]/60">ACCEPTED_PAYMENTS</div>
        <BankStrip size={28} />
      </div>
    </div>

    <div class="flex flex-col items-center justify-between border-t border-[#d4a017]/25 pt-6 font-mono text-xs text-[#dfeacf]/60 md:flex-row">
      <p>SYSTEM_COPYRIGHT &copy; {new Date().getFullYear()} WINSIAM88</p>
      <div class="mt-4 flex gap-4 md:mt-0">
        <a href="/terms/" class="hover:text-[#a3e635]">TERMS_OF_SERVICE</a>
        <a href="/privacy/" class="hover:text-[#a3e635]">PRIVACY_POLICY</a>
      </div>
    </div>
  </div>
</footer>

<style>
  footer a {
    text-decoration: none;
    font-family: var(--font-sans);
  }
  .font-mono {
    font-family: monospace;
  }
</style>
