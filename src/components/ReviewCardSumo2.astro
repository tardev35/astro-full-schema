---
const reviews = [
  {
    name: "สมาชิกที่ย้ายมาจากเว็บผ่านเอเย่นต์",
    role: "เทียบแล้วบอกว่าเว็บตรงระบบนิ่งกว่าจริง",
    stars: 5,
    tag: "เว็บตรงไม่ผ่านเอเย่นต์",
    content:
      "เคยเล่นเว็บที่ผ่านนายหน้ามาก่อน พอมาลอง GODDUBAI ที่นำเข้าระบบ API แท้ตรงจากค่ายเกมยักษ์ใหญ่ก็รู้สึกได้เลยว่าเกมนิ่งกว่า ไม่มีสะดุด ไม่มีกระตุกกลางวงล้อ อัตราการชนะเป็นไปตามค่า RTP มาตรฐานสากล ไม่มีการปรับแต่งค่าใดๆ หลังบ้าน ทุกการสปินโปร่งใสและตรวจสอบได้จริง สบายใจกว่าเยอะ",
    avatar: "🏙️",
  },
  {
    name: "สมาชิกทุนน้อยที่เริ่มจากหลักบาท",
    role: "ฝากไม่มีขั้นต่ำ บริหารเงินหน้าตักได้เอง",
    stars: 5,
    tag: "ฝากถอนไม่มีขั้นต่ำ",
    content:
      "ภาพลักษณ์เว็บดูหรูหราจนคิดว่าต้องมีทุนหนักถึงจะเล่นได้ แต่เอาเข้าจริงมีเงินติดบัญชีแค่ 1 บาทก็ฝากเข้ามาเริ่มเล่นได้เลย ไม่มีเงื่อนไขผูกมัดให้ปวดหัว อยากฝากเท่าไหร่ อยากถอนตอนไหน จัดการได้เอง 100% ถอนเท่าไหร่ก็ได้เต็มจำนวน ไม่มีหัก ไม่มีค่าบริการ คนทุนน้อยก็มีสิทธิ์ลุ้นเป็นเศรษฐีเหมือนกัน",
    avatar: "💎",
  },
  {
    name: "สมาชิกที่ถอนผ่านแอปธนาคารตอนดึก",
    role: "ทำรายการเองผ่านระบบ Auto ไม่ต้องส่งสลิป",
    stars: 5,
    tag: "ธุรกรรม Auto ไวใน 3 วินาที",
    content:
      "ระบบฝากถอนของที่นี่เป็น Auto High-Speed เต็มรูปแบบ ทำรายการเองผ่านแอปธนาคารชั้นนำหรือ True Money Wallet ได้เลย ไม่ต้องส่งสลิปให้แอดมินดูให้เสียเวลา ประมวลผลเฉลี่ยแค่ 1-3 วินาที เงินเข้าปุ๊บเล่นต่อได้ปั๊บ ทำรายการได้ตลอด 24 ชั่วโมง ยอดตรงเป๊ะทุกบาททุกสตางค์ ความต่อเนื่องแบบนี้แหละที่หายาก",
    avatar: "⚡",
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label="เสียงจากสมาชิก GODDUBAI" class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#f7cf8a] via-[#e8a13c] to-[#0f8f57] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      เสียงจากสมาชิก <span class="text-[#e8a13c]">GODDUBAI</span>
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#e8a13c] to-transparent"></div>
  </div>

  <div
    class="mx-auto mb-8 flex max-w-md items-center justify-center gap-5 rounded-2xl border border-[#e8a13c]/25 bg-[#0f1d16]/92 px-6 py-4 shadow-[0_10px_30px_rgba(15,143,87,0.22)] backdrop-blur-xl">
    <div class="flex flex-col items-center">
      <span class="bg-gradient-to-b from-[#f7cf8a] to-[#a8611a] bg-clip-text text-4xl leading-none font-black text-transparent">{average}</span>
      <span class="mt-1 text-[10px] font-bold tracking-widest text-[#f1e6d3]/70 uppercase">คะแนนเฉลี่ย</span>
    </div>
    <div class="h-12 w-px bg-[#a8611a]/35"></div>
    <div class="flex flex-col gap-1.5">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#e8a13c]" : "text-[#a8611a]/40"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#f1e6d3]/70">คะแนนเฉลี่ย {average} จาก 5 ดาว จากการใช้งานจริงของสมาชิก {reviews.length} ด้าน</span>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
    {
      reviews.map((review) => (
        <article class="group relative isolate flex flex-col gap-4 overflow-hidden rounded-2xl border border-[#e8a13c]/25 bg-[#0f1d16]/92 p-6 text-left shadow-[0_10px_30px_rgba(15,143,87,0.22)] backdrop-blur-xl transition-all duration-300 hover:-translate-y-1 hover:border-[#e8a13c]/50 hover:shadow-[0_15px_40px_rgba(232,161,60,0.3)]">
          <span class="absolute inset-y-0 left-0 -z-10 w-1 bg-gradient-to-b from-[#f7cf8a] to-[#a8611a] opacity-80 transition-opacity duration-300 group-hover:opacity-100" />
          <span class="pointer-events-none absolute -top-14 -right-14 -z-10 h-32 w-32 rounded-full bg-[#0a4a2e]/50 blur-[50px] transition-all duration-300 group-hover:bg-[#0f8f57]/45" />

          <div class="flex items-center justify-between gap-3">
            <span class="inline-flex items-center gap-1.5 rounded-full border border-[#e8a13c]/25 bg-[#091310] px-3 py-1 text-[10px] font-bold tracking-widest text-[#e8a13c] uppercase">
              <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#0f8f57]" />
              {review.tag}
            </span>
            <span class="flex gap-0.5 text-sm">
              <span aria-hidden="true" class="flex gap-0.5">
                {Array.from({ length: 5 }).map((_, i) => (
                  <span class={i < review.stars ? "text-[#e8a13c]" : "text-[#a8611a]/40"}>★</span>
                ))}
              </span>
              <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
            </span>
          </div>

          <p class="text-left text-base leading-relaxed text-[#f1e6d3]">{review.content}</p>

          <div class="mt-auto flex items-center gap-3 border-t border-[#a8611a]/35 pt-4">
            <span
              aria-hidden="true"
              class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#e8a13c]/30 bg-gradient-to-br from-[#f7cf8a] via-[#e8a13c] to-[#a8611a] text-xl shadow-inner transition-transform duration-300 group-hover:scale-110">
              {review.avatar}
            </span>
            <span class="flex flex-col">
              <span class="text-sm font-black text-[#f1e6d3] transition-colors group-hover:text-[#f7cf8a]">{review.name}</span>
              <span class="text-[10px] font-bold tracking-wider text-[#f1e6d3]/70 uppercase">{review.role}</span>
            </span>
          </div>
        </article>
      ))
    }
  </div>
</section>
