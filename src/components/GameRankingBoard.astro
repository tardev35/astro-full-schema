---
import { Picture } from "astro:assets";
import img1 from "../assets/providers/game1.avif";
import img2 from "../assets/providers/game2.avif";
import img3 from "../assets/providers/game3.avif";
import img4 from "../assets/providers/game4.avif";
import img5 from "../assets/providers/game5.avif";
import img6 from "../assets/providers/game6.avif";

const games = [
  { rank: 1, name: "สล็อต", type: "หมวดสล็อตมีพื้นที่สำหรับเกมใหม่และเกมหลายสไตล์ เลือกจากรายชื่อหมวดได้ตรง ๆ", menus: ["ยอดนิยม", "เกมใหม่ปี 2026"], players: 5124, img: img2 },
  { rank: 2, name: "บาคาร่า", type: "เน้นการเลือกโต๊ะและรูปแบบเกมที่ต้องการ เริ่มจากประเภทที่ถนัดได้ทันที", menus: ["ยอดนิยม", "รายการโปรด"], players: 3842, img: img5 },
  { rank: 3, name: "คาสิโน", type: "รวมเกมโต๊ะไว้ในหมวดคาสิโน สลับจากสล็อตมาเล่นต่อจากหน้าเดิมได้", menus: ["ยอดนิยม", "เล่นล่าสุด"], players: 3517, img: img6 },
  { rank: 4, name: "ฟุตบอล", type: "แยกเป็นหมวดเฉพาะ เลือกรายการและตลาดที่เปิดให้เล่นจากบัญชีเดียวกับหมวดอื่น", menus: ["ยอดนิยม", "เล่นล่าสุด"], players: 2905, img: img3 },
  { rank: 5, name: "เกมใหม่ปี 2026", type: "เพิ่มตัวเลือกให้คนที่ไม่อยากวนอยู่กับรายชื่อเดิม เข้าถึงผ่านบัญชีสมาชิกชุดเดิม", menus: ["เกมใหม่ปี 2026"], players: 2431, img: img4 },
  { rank: 6, name: "เล่นผ่านมือถือ", type: "เข้าสู่ระบบและเปิดเกมผ่านเบราว์เซอร์บนจอเล็กได้ ใช้บัญชีเดิมต่อจากคอมได้เลย", menus: ["ทุกอุปกรณ์", "รายการโปรด"], players: 2108, img: img1 },
];

const medal = (rank: number) => (rank === 1 ? "🥇" : rank === 2 ? "🥈" : rank === 3 ? "🥉" : null);
---

<section aria-label="หมวดเกมยอดนิยมของ ANDAMAN168" class="mx-auto w-full max-w-[1300px] px-4 py-8 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <span aria-hidden="true" class="text-2xl">🏆</span>
    <p class="bg-gradient-to-r from-[#ffe999] via-[#fdb524] to-[#7fe6ff] bg-clip-text text-2xl font-black tracking-widest text-transparent uppercase">
      หมวดเกมยอดนิยมของ ANDAMAN168 ที่สมาชิกเปิดเล่นกันมากที่สุด
    </p>
    <p class="max-w-3xl text-base leading-relaxed text-[#dbeefb]/75">
      ทุกหมวดในตารางนี้เข้าถึงได้จากบัญชีเดียวกัน เครดิตและประวัติรายการจึงอยู่ในหน้าสมาชิกเดียว ลำดับความนิยมขยับตามคนที่เข้ามาเล่นในแต่ละช่วง ไม่ได้แปลว่าหมวดไหนให้ผลตอบแทนดีกว่าหมวดไหน
    </p>
    <div class="mt-2 h-[3px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#21d4f2] to-transparent"></div>
  </div>

  <div class="flex flex-col gap-3">
    {
      games.map((g) => {
        const top = g.rank === 1;
        return (
          <article
            class={`group relative flex items-center gap-3 overflow-hidden rounded-2xl border p-3 backdrop-blur-md transition-all duration-300 hover:-translate-y-0.5 sm:gap-5 sm:p-4 ${
              top
                ? "border-[#fdb524]/55 bg-gradient-to-r from-[#0a3a68]/95 via-[#04182f]/92 to-[#04182f]/92 shadow-[0_15px_40px_rgba(253,181,36,0.28)]"
                : "border-[#21d4f2]/35 bg-[#04182f]/92 shadow-[0_10px_30px_rgba(3,19,36,0.55)] hover:border-[#fdb524]/55 hover:shadow-[0_15px_40px_rgba(33,212,242,0.35)]"
            }`}>
            <div
              aria-hidden="true"
              class="pointer-events-none absolute top-1/2 -left-10 h-24 w-24 -translate-y-1/2 rounded-full bg-[#21d4f2]/45 blur-[40px] transition-all duration-500 group-hover:bg-[#fdb524]/25"
            />

            <div class="relative z-10 flex w-8 shrink-0 flex-col items-center justify-center sm:w-12">
              {medal(g.rank) ? (
                <span class="text-2xl sm:text-3xl">
                  <span aria-hidden="true">{medal(g.rank)}</span>
                  <span class="sr-only">อันดับ {g.rank}</span>
                </span>
              ) : (
                <span class="text-xl font-black text-[#21d4f2] sm:text-2xl">#{g.rank}</span>
              )}
            </div>

            <div class={`relative z-10 h-14 w-14 shrink-0 overflow-hidden rounded-xl border sm:h-16 sm:w-16 ${top ? "border-[#fdb524]/55" : "border-[#21d4f2]/35"}`}>
              <Picture
                src={g.img}
                alt={`ภาพหน้าปกเกมในหมวด ${g.name} บนกระดานหมวดเกมยอดนิยมของ ANDAMAN168`}
                formats={["avif", "webp"]}
                fallbackFormat="webp"
                loading="lazy"
                fetchpriority="low"
                widths={[100, 200]}
                sizes="(max-width: 640px) 56px, 64px"
                decoding="async"
                class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-110"
              />
            </div>

            <div class="relative z-10 min-w-0 flex-1">
              <div class="flex items-center gap-2">
                <p class="truncate text-base font-black text-[#dbeefb] sm:text-lg">{g.name}</p>
                {top && (
                  <span class="hidden shrink-0 rounded-full border border-[#fdb524]/60 bg-[#031324] px-2 py-0.5 text-[9px] font-black tracking-wider text-[#fdb524] sm:inline">ยอดนิยมสูงสุด</span>
                )}
              </div>
              <p class="truncate text-[11px] text-[#dbeefb]/70 sm:text-xs">{g.type}</p>

              <div class="mt-2 flex flex-wrap items-center gap-1.5">
                {g.menus.map((m) => (
                  <span class="rounded-full border border-[#21d4f2]/40 bg-[#031324] px-2.5 py-0.5 text-[10px] font-bold text-[#7fe6ff]">{m}</span>
                ))}
              </div>
            </div>

            <div class="relative z-10 hidden shrink-0 flex-col items-end gap-1 sm:flex">
              <span class="flex items-center gap-1.5 text-[11px] text-[#dbeefb]/70">
                <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-green-500 shadow-[0_0_6px_rgba(34,197,94,0.6)]" />
                <span class="tabular-nums" data-players data-base={g.players}>
                  {g.players.toLocaleString("en-US")}
                </span>{" "}
                ออนไลน์
              </span>
              <a
                href="/register"
                class={`rounded-full px-4 py-1.5 text-xs font-black transition-transform hover:scale-105 ${
                  top
                    ? "bg-gradient-to-r from-[#ffe999] via-[#fdb524] to-[#b06f00] text-[#04182f] shadow-[0_10px_30px_rgba(253,181,36,0.30)]"
                    : "border border-[#fdb524]/60 bg-[#031324] text-[#fdb524] hover:border-[#fdb524] hover:bg-[#062a4f]"
                }`}>
                เข้าดูหมวดนี้
              </a>
            </div>
          </article>
        );
      })
    }
  </div>
</section>

<script>
  import { startLiveCounters } from "../lib/liveCounter";

  startLiveCounters();
</script>
