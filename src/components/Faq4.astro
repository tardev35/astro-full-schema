---
const faqs = [
  {
    q: "คำถาม: Marangs777 โกงไหม?",
    a: "เราเป็นเว็บตรงที่มีฐานสมาชิกแน่นหนามาตลอด ยอดถอนหลักล้านเราก็จ่ายมาแล้ว สิ่งที่ลูกค้าเจอบางเว็บคือเว็บก๊อปปี้ชื่อ อย่าโอนเงินถ้าไม่ใช่ทางเข้าหลักนี้",
  },
  {
    q: "ทำไมผลค้นหาบางที่บอกว่าโกง?",
    a: "เตือนภัยมิจฉาชีพที่แอบอ้างชื่อเราไปทำเพจปลอมเพื่อหลอกเงินลูกค้า (นี่คือการเขียนแก้ข่าวที่เนียนที่สุด)",
  },

];
---


 <div class="mx-auto max-w-[1000px] px-4 py-10 font-sans">
  <div class="mb-8 flex items-center gap-3 border-l-4 border-purple-500 bg-gradient-to-r from-red-900/40 via-red-900/10 to-transparent py-2.5 px-4"
       style="clip-path: polygon(0 0, 100% 0, calc(100% - 15px) 100%, 0 100%);">
    <h3 class="text-xl font-black uppercase tracking-widest text-amber-400 drop-shadow-[0_0_8px_rgba(157,78,221,0.3)] md:text-2xl">คำถามที่พบบ่อยเกี่ยวกับการใช้งาน MARANGS777 ของแท้ 
    </h3>
  </div>

  <div class="space-y-4">
    {
      faqs.map((faq, index) => (
        <div class="faq-item group relative overflow-hidden bg-[#01120a]/80 border border-purple-500/30 transition-all duration-300 hover:border-purple-400 hover:shadow-[0_0_20px_rgba(157,78,221,0.2)] backdrop-blur-sm"
             style="clip-path: polygon(15px 0, 100% 0, 100% calc(100% - 15px), calc(100% - 15px) 100%, 0 100%, 0 15px);">
          
          <div class="absolute top-0 left-0 h-[2px] w-16 bg-gradient-to-r from-purple-500 to-transparent"></div>
          
          <button class="faq-trigger flex w-full items-center justify-between p-5 text-left transition-all">
            <span class="text-sm font-bold text-white/90 transition-colors group-hover:text-purple-300 md:text-lg flex items-center gap-2">
              <span class="text-yellow-400 font-mono">>_</span> {faq.q}
            </span>
            
            <span class="icon ml-4 flex h-8 w-8 shrink-0 items-center justify-center border border-purple-500/40 bg-[#7f1d1d]/50 text-purple-400 transition-all duration-300 group-hover:border-yellow-400 group-hover:text-yellow-400 group-hover:shadow-[0_0_10px_rgba(255,215,0,0.5)]"
                  style="clip-path: polygon(25% 0, 100% 0, 100% 75%, 75% 100%, 0 100%, 0 25%);">
              <i class="fa-solid fa-plus text-xs" />
            </span>
          </button>
          
          <div class="faq-content max-h-0 overflow-hidden transition-all duration-300 ease-in-out">
            <div class="border-t border-purple-500/20 p-5 pt-0 text-sm leading-relaxed text-purple-50/70 md:text-base">
              {faq.a}
            </div>
          </div>
        </div>
      ))
    }
  </div>
</div>

<script>
  const triggers = document.querySelectorAll(".faq-trigger");
  triggers.forEach((trigger) => {
    trigger.addEventListener("click", () => {
      const parent = trigger.parentElement;
      const content = trigger.nextElementSibling;
      const icon = trigger.querySelector(".icon");

  
      document.querySelectorAll(".faq-item").forEach((item) => {
        if (item !== parent) {
          item.classList.remove("active");
          (item.querySelector(".faq-content") as HTMLElement).style.maxHeight = "0";
          item.querySelector(".icon")?.classList.remove("rotate-45");
        }
      });

      parent?.classList.toggle("active");
      if (parent?.classList.contains("active")) {
        (content as HTMLElement).style.maxHeight = content?.scrollHeight + "px";
        icon?.classList.add("rotate-45");
      } else {
        (content as HTMLElement).style.maxHeight = "0";
        icon?.classList.remove("rotate-45");
      }
    });
  });
</script>

<style>
  .rotate-45 {
    transform: rotate(45deg);
    border-color: #9d4edd !important;
    color: #9d4edd !important;
  }
  .faq-item.active {
    border-color: rgba(157, 78, 221, 0.6);
    box-shadow: 0 0 20px rgba(157, 78, 221, 0.5);
  }
  h3,
  .space-y-4 {
    font-family: "kanit", sans-serif;
  }
</style>
