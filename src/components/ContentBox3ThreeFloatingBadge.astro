---
const { title, titleleft, titlecenter, titleright } = Astro.props;
---

<section class="my-10 flex w-full justify-center px-4 font-sans">
  <div class="relative w-full max-w-7xl rounded-2xl border-2 border-[#10b981]/40 bg-gradient-to-b from-[#062b15] to-[#021207] p-8 pt-18 shadow-[0_20px_50px_rgba(0,0,0,0.6)]">
    {
      title && (
        <div class="absolute -top-6 left-1/2 w-[92%] max-w-2xl -translate-x-1/2 rounded-lg border-2 border-[#10b981]/60 bg-gradient-to-b from-[#064e3b] to-[#021207] px-5 py-3 text-center shadow-[0_10px_20px_rgba(0,0,0,0.5)] sm:px-10">
          <h2 class="bg-gradient-to-r from-yellow-100 via-yellow-400 to-yellow-600 bg-clip-text text-lg font-black tracking-widest text-transparent uppercase sm:text-2xl">{title}</h2>
          <div class="absolute bottom-1 left-1/2 h-[2px] w-1/2 -translate-x-1/2 bg-[#10b981]/80 shadow-[0_0_5px_rgba(16,185,129,1)]" />
        </div>
      )
    }

    <div class="grid grid-cols-1 gap-8 md:grid-cols-3">
      <article class="flex flex-col gap-3 text-center md:border-r md:border-[#10b981]/20 md:pr-6">
        {titleleft && <h3 class="text-xl font-black text-yellow-400 uppercase drop-shadow-md">{titleleft}</h3>}
        <div class="text-sm leading-relaxed text-green-50/70">
          <slot name="left" />
        </div>
      </article>

      <article class="flex flex-col gap-3 text-center md:border-r md:border-[#10b981]/20 md:px-4">
        {titlecenter && <h3 class="text-xl font-black text-yellow-400 uppercase drop-shadow-md">{titlecenter}</h3>}
        <div class="text-sm leading-relaxed text-green-50/70">
          <slot name="center" />
        </div>
      </article>

      <article class="flex flex-col gap-3 text-center md:pl-6">
        {titleright && <h3 class="text-xl font-black text-yellow-400 uppercase drop-shadow-md">{titleright}</h3>}
        <div class="text-sm leading-relaxed text-green-50/70">
          <slot name="right" />
        </div>
      </article>
    </div>
  </div>
</section>

<style>
  .font-sans {
    font-family: "Kanit", sans-serif;
  }
</style>
