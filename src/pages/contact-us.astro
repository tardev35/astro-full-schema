---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";

import { Picture } from "astro:assets";
import imgLine from "../assets/contact-line.webp";
import { pageGraph } from "../lib/schema";
import { BRAND_ADDRESS } from "../lib/brandProfile";

const pageTitle = "ติดต่อทีมงาน 77RUAY | สอบถามผ่าน LINE Official";

const pageDescription =
  "ติดต่อทีมงาน 77RUAY ผ่าน LINE Official เมื่อล็อกอินไม่ได้ ฝากแล้วเครดิตไม่ขึ้น หรือมีรายการค้าง อย่าโอนเงินซ้ำ แจ้งช่วงเวลาที่ทำรายการกับยอดเงินให้แอดมินตรวจสอบ";

const announcementMessage =
  "77RUAY สล็อตออนไลน์ เล่นผ่านเบราว์เซอร์ได้ทั้ง iOS และ Android ไม่ต้องโหลดแอป • ฝากถอนออโต้ตลอด 24 ชั่วโมง ไม่ต้องแนบสลิป • สมัคร ฝาก เล่น และถอนจบบนมือถือเครื่องเดียว • มีเรื่องติดขัดติดต่อแอดมินผ่านช่องทางบนหน้าเว็บ";

const graph = pageGraph(Astro, {
  type: "ContactPage",
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ติดต่อเรา", path: "/contact-us" },
  ],
  org: {
    contactPoints: [
      {
        contactType: "customer service",
        availableLanguage: ["Thai"],
        path: "/line",
        description: "ติดต่อทีมงาน 77RUAY ผ่าน LINE Official สอบถามการสมัครสมาชิก การเข้าสู่ระบบ และการฝากถอน",
      },
    ],
  },
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement message={announcementMessage} />

  <ContentBox title="ติดต่อทีมงาน 77RUAY" as="h1">
    <div>
      <Picture
        src={imgLine}
        alt="ภาพช่องทางติดต่อทีมงาน 77RUAY ทาง LINE ไอคอนแอป LINE สีเขียวทรงสี่เหลี่ยมมุมมน มีกรอบข้อความสีครีมที่เขียนคำว่า LINE อยู่ตรงกลาง ด้านบนเป็นวงกลมลูกศรสีเขียวล้อมตัวเลข 24h และมีผู้หญิงผมดำรวบตึง สวมชุดราตรีซาตินสีเขียวเข้มเปิดไหล่ ใส่สร้อยคอสีทอง ยืนอยู่ทางขวาของภาพ"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600]}
        sizes="(max-width: 768px) 100vw, 400px"
        class="mx-auto h-auto w-full max-w-[400px] object-contain"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={60}
      />
      {
        BRAND_ADDRESS.lines.length > 0 && (
          <address aria-label={BRAND_ADDRESS.label} class="mt-8 mb-8 rounded-r-xl border-l-4 border-[#1a5fe0] bg-[#eef4ff] py-4 pr-4 pl-6 text-left text-base leading-relaxed text-[#4a5878] not-italic">
            <span class="mb-1 block font-bold text-[#0a1f5c]">{BRAND_ADDRESS.label}</span>
            {BRAND_ADDRESS.lines.map((line) => (
              <span class="block">{line}</span>
            ))}
            {BRAND_ADDRESS.email && (
              <span class="mt-3 block">
                <span aria-hidden="true" class="mr-2">
                  ✉️
                </span>
                <a href={`mailto:${BRAND_ADDRESS.email}`} class="font-bold text-[#1a5fe0] underline underline-offset-4 transition-colors hover:text-[#8a6508]">
                  {BRAND_ADDRESS.email}
                </a>
              </span>
            )}
          </address>
        )
      }

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/register/"
          aria-label="สมัครสมาชิก 77RUAY"
          class="flex items-center justify-center rounded-xl border-2 border-[#ffd45c] bg-gradient-to-b from-[#4d8ff5] via-[#1a5fe0] to-[#0b3a9e] px-8 py-3 font-bold text-white shadow-[0_10px_30px_rgba(26,95,224,0.35)] transition-all hover:scale-105 hover:brightness-110 hover:shadow-[0_15px_40px_rgba(26,95,224,0.45)]">
          สมัครสมาชิก
        </a>

        <a
          href="/login/"
          aria-label="เข้าสู่ระบบ 77RUAY"
          class="flex items-center justify-center rounded-xl border-2 border-[#b07d12]/40 bg-gradient-to-b from-[#ffd45c] via-[#e0a91b] to-[#b07d12] px-8 py-3 font-bold text-[#0a1f5c] shadow-[0_10px_30px_rgba(224,169,27,0.35)] transition-all hover:scale-105 hover:brightness-110 hover:shadow-[0_15px_40px_rgba(224,169,27,0.40)]">
          เข้าสู่ระบบ
        </a>

        <a
          href="/line/"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="ติดต่อทีมงาน 77RUAY ผ่าน Line Official"
          class="flex items-center justify-center rounded-xl border border-[#00B900]/70 bg-[#00B900] px-8 py-3 font-bold text-white shadow-[0_8px_24px_rgba(0,185,0,0.25)] transition-transform hover:scale-105 hover:bg-[#00a300]">
          ติดต่อผ่าน Line Official
        </a>
      </div>
    </div>
  </ContentBox>
  <Navfoot />
</MainLayout>
