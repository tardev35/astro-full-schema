---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-xl sm:text-2xl md:text-3xl" : "text-lg sm:text-xl md:text-2xl";
---

<section class="my-12 flex w-full justify-center px-4 font-sans">
  <div
    class="relative isolate w-full max-w-[1400px] rounded-2xl border-2 border-[#f1d2d3] bg-white p-8 pt-28 text-left text-base leading-relaxed text-[#2b2627] shadow-[0_10px_30px_rgba(236,27,36,0.10)]">
    <div aria-hidden="true" class="pointer-events-none absolute -top-16 -right-10 -z-10 h-40 w-40 rounded-full bg-[#ec1b24]/8 blur-[60px]"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -bottom-16 -left-10 -z-10 h-40 w-40 rounded-full bg-[#d4a017]/8 blur-[60px]"></div>

    {
      title && (
        <div class="absolute -top-6 left-1/2 flex w-[92%] max-w-2xl -translate-x-1/2 items-center justify-center gap-2 rounded-lg border-2 border-white bg-gradient-to-b from-[#ff4d55] to-[#d0121b] px-4 py-2.5 text-center shadow-[0_10px_30px_rgba(236,27,36,0.30)] sm:px-8">
          <span aria-hidden="true" class="shrink-0 text-[#f5c542]">
            ✦
          </span>
          <HeadingTag class={`min-w-0 ${headingSize} leading-normal font-black tracking-tight text-white`}>{title}</HeadingTag>
          <span aria-hidden="true" class="shrink-0 text-[#f5c542]">
            ✦
          </span>
        </div>
      )
    }

    <slot />
  </div>
</section>
