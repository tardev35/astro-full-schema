---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#f9a8d4] bg-white/92 p-8 text-left text-base leading-relaxed text-[#5b2140] shadow-[0_10px_30px_rgba(236,72,153,0.14)] transition-all duration-500 hover:border-[#ec4899]/70 hover:shadow-[0_15px_40px_rgba(236,72,153,0.24)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#ec4899]/16 blur-[60px] transition-all duration-500 group-hover:bg-[#f472b6]/26"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#a855f7]/14 blur-[60px] transition-all duration-500 group-hover:bg-[#c084fc]/22"></div>

    {
      title && (
        <header class="mb-6 flex items-center gap-4 border-b border-[#fbcfe8] pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#fb923c] to-[#ec4899] shadow-[0_0_10px_rgba(236,72,153,0.45)]" />
          <HeadingTag class="bg-gradient-to-r from-[#9d174d] via-[#db2777] to-[#7e22ce] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
