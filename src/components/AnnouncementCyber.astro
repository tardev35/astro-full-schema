---
const {
  message = "AMBHENG88 สล็อตทรูมันนี่วอลเล็ท เติมยอดเข้ายูสเดียวแล้วเลือกเกมสล็อตต่อได้ทันที ไม่ต้องสมัครยูสใหม่หลายครั้ง • ระบบเติม ฝาก ถอนใช้การประมวลผลอัตโนมัติ ส่งคำขอแล้วติดตามสถานะรายการได้จากหน้าสมาชิก • เงื่อนไขไม่มีขั้นต่ำระบุไว้ชัดเจน อ่านข้อกำหนดของแต่ละช่องทางและโปรโมชั่นก่อนทำรายการทุกครั้ง • เข้าใช้งานผ่านมือถือและเว็บเบราว์เซอร์ได้ต่อเนื่องตลอด 24 ชั่วโมง • โบนัสแตกหลักล้าน จ่ายเต็มทุกบาท ไม่มีหักค่าธรรมเนียม ถอนไม่จำกัดวงเงินต่อวัน",
} = Astro.props;
---

<div class="mx-auto w-full max-w-7xl px-4 py-3 font-sans">
  <div
    class="relative flex overflow-hidden border border-[#ff2d8e]/50 bg-[#140310]/90 shadow-[0_0_15px_rgba(255,45,142,0.3)] backdrop-blur-md"
    style="clip-path: polygon(15px 0, 100% 0, calc(100% - 15px) 100%, 0 100%);">
    <div
      class="relative z-10 flex shrink-0 items-center justify-center bg-gradient-to-r from-[#ff2d8e] to-[#ffe814] px-6 py-2.5 font-black text-[#170512]"
      style="clip-path: polygon(0 0, 100% 0, calc(100% - 10px) 100%, 0 100%);">
      ประกาศ
    </div>

    <div class="marquee-container relative flex-1 overflow-hidden py-2.5 pr-6">
      <div class="pointer-events-none absolute top-0 left-0 z-10 h-full w-8 bg-gradient-to-r from-[#140310] to-transparent"></div>

      <div class="marquee-content inline-block pl-4 text-sm font-bold tracking-widest whitespace-nowrap text-[#f3e3ee]">
        <span class="mr-8 inline-flex items-center gap-2"><span aria-hidden="true" class="h-2 w-2 bg-[#ffe814] shadow-[0_0_8px_rgba(255,232,20,1)]"></span>{message}</span>
        <span class="mr-8 inline-flex items-center gap-2"><span aria-hidden="true" class="h-2 w-2 bg-[#ffe814] shadow-[0_0_8px_rgba(255,232,20,1)]"></span>{message}</span>
      </div>
    </div>
  </div>
</div>

<style>
  .marquee-content {
    animation: marquee 20s linear infinite;
  }
  .marquee-container:hover .marquee-content {
    animation-play-state: paused;
  }
  @keyframes marquee {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee-content {
      animation: none;
    }
  }
</style>
