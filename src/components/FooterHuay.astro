---
import { Picture } from "astro:assets";

// โค้ดดึงไฟล์โลโก้อัจฉริยะ รองรับ .png และ .webp
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.*", { eager: true });
const imagePaths = Object.keys(images);
const targetPath = imagePaths.find((path) => path.endsWith(".png")) || imagePaths.find((path) => path.endsWith(".webp")) || (imagePaths.length > 0 ? imagePaths[0] : null);
const mainLogo = targetPath ? images[targetPath].default : null;
---

<footer class="relative mt-12 w-full overflow-hidden rounded-t-[3rem] border-t border-red-500/30 bg-[#2a0408] pt-16 pb-8 font-sans text-white shadow-[0_-10px_30px_rgba(0,0,0,0.5)]">
  <div class="pointer-events-none absolute inset-x-0 -top-20 mx-auto h-[200px] w-full max-w-4xl rounded-full bg-red-700/10 blur-[80px]"></div>

  <div class="relative z-10 mx-auto w-full max-w-[1400px] px-6">
    <div class="mb-12 grid grid-cols-1 gap-12 md:grid-cols-12">
      <div class="flex flex-col gap-4 md:col-span-5">
        <a href="/" class="inline-block max-w-max rounded-xl border border-white/10 bg-white/5 p-2 transition-transform duration-300 hover:scale-105">
          {
            mainLogo ? (
              <Picture src={mainLogo} alt="ศูนย์รวม-ลุ้นหวย88" class="h-[50px] w-auto drop-shadow-md" formats={["avif", "webp"]} fallbackFormat="webp" />
            ) : (
              <h2 class="text-3xl font-black tracking-widest text-white italic">
                <span class="rounded-md bg-white px-2 text-red-500">LOT</span>888
              </h2>
            )
          }
        </a>
        <p class="mt-2 border-l-2 border-yellow-500/50 pl-4 text-sm leading-relaxed text-red-50/70">
          ศูนย์รวม-ลุ้นหวย88.com เว็บหวยออนไลน์ที่ให้อัตราจ่ายสูงสุด แทงง่าย จ่ายจริง จ่ายไว พร้อมบริการฝากถอนอัตโนมัติด้วยเทคโนโลยีล้ำสมัยที่สุดในประเทศไทย มั่นคง ปลอดภัย 100%
        </p>
        <div class="mt-2 flex gap-3">
          <span class="rounded-full border border-red-500/30 bg-[#5f0914] px-4 py-1 text-xs font-bold text-white shadow-sm">SMART AUTO</span>
          <span class="rounded-full border border-yellow-500/30 bg-yellow-500/20 px-4 py-1 text-xs font-bold text-yellow-400 shadow-sm">100% SECURE</span>
        </div>
      </div>

      <nav class="flex flex-col gap-4 md:col-span-3 lg:pl-12">
        <h3 class="border-b border-red-500/30 pb-2 text-lg font-black tracking-widest text-white uppercase">ทางลัดหน้าเว็บ</h3>
        <ul class="flex flex-col gap-3 text-sm font-medium text-red-50/70">
          <li><a href="/" class="transition-colors hover:text-yellow-400">หน้าหลัก</a></li>
          <li><a href="/ตรวจหวย" class="transition-colors hover:text-yellow-400">ตรวจผลรางวัล</a></li>
          <li><a href="/แนวทาง" class="transition-colors hover:text-yellow-400">แนวทางหวย</a></li>
          <li><a href="/promotion" class="transition-colors hover:text-yellow-400">โปรโมชั่น</a></li>
          <li><a href="/contact" class="transition-colors hover:text-yellow-400">ติดต่อเรา</a></li>
        </ul>
      </nav>

      <div class="flex flex-col gap-4 md:col-span-4">
        <h3 class="border-b border-red-500/30 pb-2 text-lg font-black tracking-widest text-white uppercase">บริการลูกค้า</h3>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] py-3.5 font-bold text-white shadow-md transition-all hover:-translate-y-1 hover:shadow-lg">
          ติดต่อทีมงาน LINE 24 ชม.
        </a>

        <div class="mt-2 text-xs font-medium text-red-50/50">ระบบฝาก-ถอนอัตโนมัติ รองรับ:</div>
        <div class="flex flex-wrap gap-2 opacity-90">
          <div class="flex h-7 w-11 items-center justify-center rounded-md border border-white/10 bg-[#118A44] text-[10px] font-bold text-white shadow-sm">KB</div>
          <div class="flex h-7 w-11 items-center justify-center rounded-md border border-white/10 bg-[#4E2B7A] text-[10px] font-bold text-white shadow-sm">SCB</div>
          <div class="flex h-7 w-11 items-center justify-center rounded-md border border-white/10 bg-[#1BA1E2] text-[10px] font-bold text-white shadow-sm">KTB</div>
          <div class="flex h-7 w-11 items-center justify-center rounded-md border border-white/10 bg-[#1E4598] text-[10px] font-bold text-white shadow-sm">BBL</div>
          <div class="flex h-7 w-11 items-center justify-center rounded-md border border-white/10 bg-gradient-to-r from-orange-500 to-orange-400 text-[10px] font-bold text-white shadow-sm">TW</div>
        </div>
      </div>
    </div>

    <div class="flex flex-col items-center justify-between border-t border-red-900/50 pt-8 text-xs font-medium text-red-50/40 md:flex-row">
      <p>COPYRIGHT &copy; {new Date().getFullYear()} ศูนย์รวม-ลุ้นหวย88.com ALL RIGHTS RESERVED.</p>
      <div class="mt-4 flex gap-4 md:mt-0">
        <a href="/" class="transition-colors hover:text-white">เงื่อนไขและข้อตกลง</a>
        <a href="/" class="transition-colors hover:text-white">นโยบายความเป็นส่วนตัว</a>
      </div>
    </div>
  </div>
</footer>
