    games: ["Lucky Neko", "Mahjong Ways 2"],
    img: imgPg,
    alt: "โลโก้ PG Pocket Games Soft กับตัวละครสาวสวมมงกุฎขนนกและเพื่อนร่วมทาง",
  },
  {
    tagline: "Pragmatic Play",
    name: "Pragmatic Play ขนมหวานเต็มกระดาน",
    desc: "Sugar Rush ใช้กระดาน 7×7 จ่ายเมื่อขนมแบบเดียวกันเกาะติดกันเป็นกลุ่ม ส่วน Sweet Bonanza ธีมหวานเหมือนกันแต่ไม่มีไลน์ให้จำ นับแค่ว่าสัญลักษณ์แบบเดียวกันขึ้นทั้งจอกี่ตัว",
    games: ["Sugar Rush", "Sweet Bonanza"],
    img: imgPp,
    alt: "โลโก้ PP Slot กับเทพเจ้าเคราขาวถือสายฟ้า",
  },
  {
    tagline: "JILI",
    name: "JILI วงล้อเล็กกับวงพิเศษข้างจอ",
