---
import { isActivePath } from "../lib/nav";
import { Picture } from "astro:assets";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });

const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

const currentPath = Astro.url.pathname;

const isActive = (path: string) => isActivePath(currentPath, path);

const affUrl = "https://tinyurl.com/yz22c2r4";

const links = [
  { name: "หน้าแรก", path: "/", icon: "🏠" },
  { name: "โปรโมชั่น", path: "/promotion/", icon: "🎁" },
  { name: "ทดลองเล่น", path: "/ทดลองเล่น/", icon: "🎰" },
  { name: "วิธีฝากถอน", path: "/วิธีฝากถอน/", icon: "💳" },
  { name: "เกี่ยวกับเรา", path: "/about-us/", icon: "🛕" },
  { name: "ติดต่อเรา", path: "/contact-us/", icon: "💬" },
];

const logoAlt = "โลโก้ YIMSIAM889 หน้ายักษ์ทวารบาลสีขาวเงินอยู่เหนือป้ายชื่อแบรนด์ตัวอักษรโครเมียมขอบน้ำเงิน บนโล่สีกรมท่าเรืองแสงสีฟ้า";
---

<header class="sticky top-0 z-50 w-full font-sans">
  <nav aria-label="เมนูหลัก YIMSIAM889" class="relative z-40 w-full bg-[#020b24]/95 shadow-[0_4px_20px_rgba(1,10,31,0.7)]">
    <div aria-hidden="true" class="absolute bottom-0 left-0 h-[2px] w-full bg-gradient-to-r from-[#0b4fd6] via-[#2f8cff] to-[#7cc0ff] opacity-80"></div>

    <div class="flex h-[65px] w-full items-center justify-between px-3 md:px-6 lg:h-[80px]">
      <div class="flex items-center">
        <a href="/" class="flex-shrink-0 transition-transform hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt={logoAlt}
                widths={[140, 280, 420]}
                sizes="140px"
                loading="eager"
                fetchpriority="high"
                class="h-[45px] w-auto drop-shadow-[0_0_10px_rgba(47,140,255,0.55)] lg:h-[60px]"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <span class="bg-gradient-to-b from-[#eaf4ff] to-[#2f8cff] bg-clip-text text-2xl font-black tracking-widest text-transparent">YIMSIAM889</span>
            )
          }
        </a>
      </div>

      <div class="hidden h-full items-center justify-center gap-4 lg:flex xl:gap-7">
        {
          links.map((link) => (
            <a href={link.path} class="group relative flex h-full items-center gap-1.5 text-sm font-bold transition-all xl:text-base">
              <span aria-hidden="true" class="text-base transition-transform duration-300 group-hover:-translate-y-0.5">
                {link.icon}
              </span>
              <span class={`transition-colors duration-300 ${isActive(link.path) ? "text-[#eaf4ff] drop-shadow-[0_0_8px_rgba(47,140,255,0.75)]" : "text-[#dbeaff]/85 group-hover:text-[#9cc9ff]"}`}>
                {link.name}
              </span>
              {isActive(link.path) && <div class="absolute bottom-0 left-0 h-[3px] w-full rounded-t-md bg-[#2f8cff] shadow-[0_-2px_10px_rgba(47,140,255,0.9)]" />}
            </a>
          ))
        }
      </div>

      <div class="z-50 flex items-center gap-2 md:gap-4">
        <a
          href={affUrl}
          rel="nofollow sponsored"
          class="hidden items-center justify-center gap-1.5 rounded border border-[#2f8cff]/70 px-6 py-2 text-sm font-bold text-[#dbeaff] transition-all hover:bg-[#0a1f4d]/70 hover:shadow-[0_0_15px_rgba(47,140,255,0.4)] lg:flex">
          <span aria-hidden="true">🔑</span> เข้าระบบ
        </a>
        <a
          href={affUrl}
          rel="nofollow sponsored"
          class="nav-cta-chrome hidden items-center justify-center gap-1.5 rounded px-6 py-2 text-sm font-extrabold text-[#03133c] shadow-[0_0_20px_rgba(47,140,255,0.55)] transition-all hover:brightness-110 lg:flex">
          <span aria-hidden="true">👑</span> สมัครสมาชิก
        </a>

        <button id="hamburger-btn" class="flex flex-col items-center justify-center space-y-1.5 rounded border border-[#2f8cff]/45 bg-[#0a1f4d]/50 p-2 lg:hidden" aria-label="เปิดเมนู">
          <span class="hamburger-line h-[2px] w-5 origin-center rounded-full bg-[#eaf4ff] transition-all duration-300"></span>
          <span class="hamburger-line h-[2px] w-5 rounded-full bg-[#eaf4ff] transition-all duration-300"></span>
          <span class="hamburger-line h-[2px] w-5 origin-center rounded-full bg-[#eaf4ff] transition-all duration-300"></span>
        </button>
      </div>
    </div>
  </nav>

  <div id="mobile-overlay" class="pointer-events-none fixed inset-0 z-40 bg-[#010a1f]/80 opacity-0 transition-opacity duration-300 lg:hidden"></div>

  <div
    id="mobile-sidebar"
    class="fixed top-0 right-0 z-50 h-screen w-[260px] translate-x-full transform overflow-y-auto border-l border-[#2f8cff]/40 bg-[#020b24] shadow-[-10px_0_30px_rgba(1,10,31,0.85)] transition-transform duration-400 ease-[cubic-bezier(0.3,1,0.3,1)] lg:hidden">
    <div class="flex items-center justify-between border-b border-white/5 px-5 py-5">
      <span class="text-sm font-extrabold tracking-wider text-[#dbeaff]">เมนู</span>
      <button id="close-sidebar-btn" class="p-1 text-xl text-[#9cc9ff] hover:text-white" aria-label="ปิดเมนู">✕</button>
    </div>

    <div class="flex flex-col space-y-2 px-4 pt-4 pb-8">
      {
        links.map((link) => (
          <a
            href={link.path}
            class={`sidebar-item flex items-center rounded-lg border px-4 py-3.5 transition-all ${isActive(link.path) ? "border-[#2f8cff]/60 bg-[#0a1f4d]/70 text-[#eaf4ff]" : "border-transparent bg-white/5 text-[#dbeaff]/85 hover:bg-white/10"}`}>
            <span aria-hidden="true" class="mr-3 text-xl">
              {link.icon}
            </span>
            <span class="text-sm font-bold">{link.name}</span>
          </a>
        ))
      }

      <div class="mt-6 flex flex-col gap-3 border-t border-[#2f8cff]/40 pt-6">
        <a
          href={affUrl}
          rel="nofollow sponsored"
          class="sidebar-item nav-cta-chrome flex items-center justify-center gap-2 rounded-lg py-3.5 text-sm font-extrabold text-[#03133c] shadow-[0_0_15px_rgba(47,140,255,0.45)]">
          <span aria-hidden="true">👑</span> สมัครสมาชิก
        </a>
        <a
          href={affUrl}
          rel="nofollow sponsored"
          class="sidebar-item flex items-center justify-center gap-2 rounded-lg border border-[#2f8cff]/70 bg-transparent py-3.5 text-sm font-bold text-[#eaf4ff] transition-colors hover:bg-[#0a1f4d]">
          <span aria-hidden="true">🔑</span> เข้าระบบ
        </a>
      </div>
    </div>
  </div>
</header>

<style is:global>
  .nav-cta-chrome {
    background-image: linear-gradient(in oklab to right, #eaf4ff, #9cc9ff, #4d9dff);
  }

  #hamburger-btn.active .hamburger-line:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  #hamburger-btn.active .hamburger-line:nth-child(2) {
    opacity: 0;
  }
  #hamburger-btn.active .hamburger-line:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  .sidebar-item {
    opacity: 0;
    transform: translateX(20px);
    transition: all 0.3s cubic-bezier(0.3, 1, 0.3, 1);
  }
  .sidebar-item.item-show {
    opacity: 1;
    transform: translateX(0);
  }
  .sidebar-item:nth-child(1) {
    transition-delay: 0.1s;
  }
  .sidebar-item:nth-child(2) {
    transition-delay: 0.15s;
  }
  .sidebar-item:nth-child(3) {
    transition-delay: 0.2s;
  }
  .sidebar-item:nth-child(4) {
    transition-delay: 0.25s;
  }
  .sidebar-item:nth-child(5) {
    transition-delay: 0.3s;
  }
  .sidebar-item:nth-child(6) {
    transition-delay: 0.35s;
  }
  @media (prefers-reduced-motion: reduce) {
    .sidebar-item {
      transition: none;
      opacity: 1;
      transform: none;
    }
  }
</style>

<script>
  const hamburgerBtn = document.getElementById("hamburger-btn");
  const closeBtn = document.getElementById("close-sidebar-btn");
  const overlay = document.getElementById("mobile-overlay");
  const sidebar = document.getElementById("mobile-sidebar");
  const sidebarItems = document.querySelectorAll(".sidebar-item");

  const toggleSidebar = () => {
    hamburgerBtn?.classList.toggle("active");

    sidebar?.classList.toggle("translate-x-full");
    sidebar?.classList.toggle("translate-x-0");

    overlay?.classList.toggle("opacity-0");
    overlay?.classList.toggle("opacity-100");
    overlay?.classList.toggle("pointer-events-none");
    overlay?.classList.toggle("pointer-events-auto");

    if (sidebar?.classList.contains("translate-x-0")) {
      document.body.style.overflow = "hidden";
      sidebarItems.forEach((item) => item.classList.add("item-show"));
    } else {
      document.body.style.overflow = "";
      sidebarItems.forEach((item) => item.classList.remove("item-show"));
    }
  };

  hamburgerBtn?.addEventListener("click", toggleSidebar);
  closeBtn?.addEventListener("click", toggleSidebar);
  overlay?.addEventListener("click", toggleSidebar);

  sidebarItems.forEach((item) => {
    item.addEventListener("click", () => {
      if (sidebar?.classList.contains("translate-x-0")) {
        toggleSidebar();
      }
    });
  });
</script>
