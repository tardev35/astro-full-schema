---
import kbankLogo from "../assets/banks/kbank.png";
import scbLogo from "../assets/banks/scb.png";
import krungsriLogo from "../assets/banks/krungsri.png";
import ktbLogo from "../assets/banks/ktb.png";
import ttbLogo from "../assets/banks/ttb.png";
import { BRAND_NAME, brandFlag, brandPick } from "../lib/brandProfile";

const bankPool = [
  { name: "KBank", color: "bg-[#1155cc]", icon: kbankLogo.src },
  { name: "SCB", color: "bg-[#4e1c80]", icon: scbLogo.src },
  { name: "Krungsri", color: "bg-[#fcd34d]", icon: krungsriLogo.src },
  { name: "KTB", color: "bg-[#0ea5e9]", icon: ktbLogo.src },
  { name: "TTB", color: "bg-[#ca8a04]", icon: ttbLogo.src },
];

const AMOUNT_MIN = 500;
const AMOUNT_MAX = 30000;

const LETTERS = "abcdefghijklmnopqrstuvwxyz";
const pick = (salt: string, n: number) => brandPick(Astro.site, salt, n);
const digits = (salt: string, n: number) => Array.from({ length: n }, (_, d) => pick(`${salt}-${d}`, 10)).join("");

const initialRows = Array.from({ length: 4 }, (_, i) => ({
  bank: bankPool[pick(`card-bank-${i}`, bankPool.length)],
  user: `${LETTERS.charAt(pick(`card-a-${i}`, 26))}${LETTERS.charAt(pick(`card-b-${i}`, 26))}***${digits(`card-u${i}`, 4)}`,
  amount: (AMOUNT_MIN + pick(`card-amount-${i}`, AMOUNT_MAX - AMOUNT_MIN + 1)).toLocaleString("en-US"),
  pending: brandFlag(Astro.site, `card-pending-${i}`),
}));

const feedTitle = `รายการถอนเงินล่าสุดของสมาชิก ${BRAND_NAME}`;

const PENDING_CLASS = "text-[#a35000] bg-[#fff4e5] border border-[#f7941d]/50 font-bold motion-safe:animate-pulse";
const DONE_CLASS = "text-white bg-gradient-to-r from-[#0077b3] to-[#006d99] border border-[#0077b3]/40 font-black shadow-sm";
---

<div class="mx-auto w-full max-w-[1300px] p-4 font-sans">
  <section
    aria-label={feedTitle}
    class="relative isolate overflow-hidden rounded-[30px] border-2 border-[#cfe9f4] bg-white px-4 py-8 shadow-[0_10px_30px_rgba(12,53,80,0.08)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-10 left-1/2 -z-10 h-32 w-64 -translate-x-1/2 rounded-full bg-[#4cc9f0]/30 blur-[50px]"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-10 -bottom-12 -z-10 h-32 w-48 rounded-full bg-[#ffb84d]/25 blur-[50px]"></div>

    <div class="mb-8 flex items-center justify-center gap-3 text-center">
      <span aria-hidden="true" class="text-2xl">🏆</span>
      <p class="text-xl leading-normal font-black tracking-wide text-[#0c3550] md:text-3xl">
        รายการถอนเงินล่าสุดของสมาชิก <span class="text-[#006d99]">{BRAND_NAME}</span>
      </p>
      <span aria-hidden="true" class="text-2xl">🏆</span>
    </div>

    <div
      data-winners-feed
      data-interval="5000"
      data-max-rows="4"
      data-amount-min={AMOUNT_MIN}
      data-amount-max={AMOUNT_MAX}
      data-pending-chance="0.4"
      data-user-style="letters"
      data-user-digits="4"
      class="grid grid-cols-1 gap-4 md:grid-cols-2">
      {
        initialRows.map((row) => (
          <div data-winner-row class="winner-card transition-all duration-500 ease-out">
            <div class="flex flex-col rounded-[20px] border border-[#cfe9f4] bg-[#e8f7fd] p-5 transition-all hover:border-[#8ed3ee] hover:bg-white hover:shadow-[0_15px_40px_rgba(0,164,212,0.18)]">
              <div class="mb-4 flex items-start justify-between">
                <div data-winner-bank class={`flex h-10 w-10 items-center justify-center rounded-full border-2 border-white shadow-sm ${row.bank.color}`}>
                  <img data-winner-icon src={row.bank.icon} alt="" width="24" height="24" loading="lazy" decoding="async" class="h-6 w-6 object-contain" />
                </div>
                <div
                  data-winner-status
                  data-pending-text="กำลังดำเนินการ"
                  data-done-text="ถอนสำเร็จแล้ว"
                  data-pending-class={PENDING_CLASS}
                  data-done-class={DONE_CLASS}
                  class={`rounded-full px-3 py-1 text-[10px] ${row.pending ? PENDING_CLASS : DONE_CLASS}`}>
                  {row.pending ? "กำลังดำเนินการ" : "ถอนสำเร็จแล้ว"}
                </div>
              </div>
              <div>
                <div class="text-sm text-[#5a6b7a]">
                  ยูสเซอร์:{" "}
                  <span data-winner-user class="font-bold text-[#0c3550]">
                    {row.user}
                  </span>
                </div>
                <div class="mt-1 text-2xl font-black text-[#006d99]">
                  <span data-winner-amount>{row.amount}</span> <span class="text-xs text-[#5a6b7a]">THB</span>
                </div>
              </div>
            </div>
          </div>
        ))
      }
    </div>

    <p class="mt-6 text-center text-xs leading-relaxed tracking-wide text-[#5a6b7a]">
      ฝากถอนกับ <strong class="font-bold text-[#a35000]">{BRAND_NAME}</strong> เป็นระบบออโต้ ทำรายการเองได้ตลอด 24 ชั่วโมงโดยไม่ต้องส่งสลิป หากโอนแล้วเครดิตยังไม่ขึ้น อย่าเพิ่งโอนซ้ำ ให้แจ้งเวลากับยอดผ่านช่องทางบนหน้าเว็บ
    </p>

    <script type="application/json" data-winners-banks set:html={JSON.stringify(bankPool)} />
  </section>
</div>

<script>
  import { startWinnersFeed } from "../lib/winnersFeed";

  startWinnersFeed();
</script>

<style>
  .winner-card.is-entering {
    transform: scale(0.95);
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .winner-card {
      transition: none;
    }
  }
</style>
