---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";
import CtaRedirect from "../components/CtaRedirect.astro";
import { pageGraph } from "../lib/schema";

const pageTitle = "สมัครสมาชิก YIMSIAM889 | ปุ่มเปิดบัญชีใหม่ สล็อตสยาม เว็บตรง";

const pageDescription =
  "หากท่านกำลังมองหาสล็อตสยาม เว็บตรงไม่ผ่านเอเย่นต์ YIMSIAM889 พร้อมมอบปุ่มสมัครสมาชิกเพียงปุ่มเดียว เพื่อเปิดบัญชีใหม่และยิ้มรับโปรสมาชิกใหม่ได้จากทุกอุปกรณ์";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "สมัครสมาชิก", path: "/register" },
  ],
});

const targetUrl = "https://tinyurl.com/yz22c2r4";
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="สมัครสมาชิก YIMSIAM889" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label="สมัครสมาชิก YIMSIAM889"
        class="group relative mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#2f8cff]/70 bg-gradient-to-r from-[#eaf4ff] via-[#9cc9ff] to-[#4d9dff] px-6 py-4 text-xl font-bold tracking-wide text-[#03133c] shadow-[0_10px_30px_rgba(47,140,255,0.4)] transition-all duration-300 hover:scale-105 hover:border-[#eaf4ff] hover:shadow-[0_15px_40px_rgba(47,140,255,0.55)]">
        สมัครสมาชิก YIMSIAM889
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="สมัครสมาชิก" />
</MainLayout>
