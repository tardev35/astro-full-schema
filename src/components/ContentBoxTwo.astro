---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
  label?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label } = Astro.props;

const sectionLabel = label ?? title ?? titleleft ?? titleright ?? "ข้อมูลประกอบ";
---

<section aria-label={sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  {
    title && (
      <header class="mb-6 flex items-center gap-4 border-b border-[#6b0d1e] pb-4">
        <span aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ed0133] to-[#f0b429] shadow-[0_0_10px_rgba(237,1,51,0.45)]" />
        <HeadingTag class="bg-gradient-to-r from-[#ff3d63] via-[#f9dfe3] to-[#f0b429] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
      </header>
    )
  }

  <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f9dfe3]">
      {
        titleleft && (
          <p class="flex items-center gap-3 border-b border-[#6b0d1e] pb-3 text-xl leading-normal font-black tracking-widest text-[#ffdb7d] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#6b0d1e] bg-gradient-to-br from-[#ff3d63] via-[#ed0133] to-[#7a0119] text-sm text-[#170206] shadow-[0_5px_15px_rgba(237,1,51,0.28)]">
              🔐
            </span>
            {titleleft}
          </p>
        )
      }
      <slot name="left" />
    </article>

    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f9dfe3]">
      {
        titleright && (
          <p class="flex items-center gap-3 border-b border-[#6b0d1e] pb-3 text-xl leading-normal font-black tracking-widest text-[#ffdb7d] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#6b0d1e] bg-gradient-to-br from-[#ffdb7d] via-[#f0b429] to-[#a8710c] text-sm text-[#170206] shadow-[0_5px_15px_rgba(240,180,41,0.28)]">
              📊
            </span>
            {titleright}
          </p>
        )
      }
      <slot name="right" />
    </article>
  </div>
</section>
