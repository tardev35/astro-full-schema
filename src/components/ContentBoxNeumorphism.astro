---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";
---

<section class="relative z-10 my-6 flex w-full justify-center px-4 font-sans">
  <div
    class="w-full max-w-[1400px] rounded-[25px] border border-[#a86f00]/55 bg-[#1c0a30] p-8 text-left text-base leading-relaxed text-[#ede4fb] shadow-[10px_10px_20px_#0b0313,-10px_-10px_20px_#2c1247]">
    {
      title && (
        <header class="mb-8 border-b border-[#a86f00]/45 pb-4 text-center">
          <HeadingTag class={`bg-gradient-to-r from-[#ffe680] via-[#fdc700] to-[#d99400] bg-clip-text ${headingSize} leading-normal font-black tracking-wide text-transparent`}>{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
