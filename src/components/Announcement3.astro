---
const {
  message = "GGHENG สล็อตเว็บตรงสายเฮง ระบบแท้100% จากต่างประเทศ ทุกเกมรันด้วยค่า RTP มาตรฐานสากลจากค่ายแม่โดยตรง ไม่มีล็อกยูส • จ่ายไม่อั้น ถอนหลักแสนหลักล้านก็โอนครบทุกบาท ไม่หักค่าธรรมเนียม • ไม่มีขั้นต่ำ ทุนหลักสิบหลักร้อยก็เริ่มได้ • รวมค่ายดัง PG SOFT, Pragmatic Play, Joker Gaming ลิขสิทธิ์แท้ครบในที่เดียว • ฝากถอนออโต้ผ่านธนาคารและ True Money Wallet เข้าเล่นได้ทุกแพลตฟอร์มด้วยยูสเดียว",
} = Astro.props;
---

<div class="mx-auto mt-4 max-w-[900px] px-4 md:px-0">
  <div
    class="relative flex h-[46px] items-center rounded-r-full border border-[#5c0b13] bg-gradient-to-r from-[#3a0a0d] to-[#1f0405] py-2 pr-4 pl-12 shadow-[0_0_20px_rgba(225,29,29,0.25)]">
    <div class="absolute top-1/2 -left-2 flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full border-[3px] border-[#f5c542] bg-[#140202] shadow-[0_0_15px_rgba(245,197,66,0.35)]">
      <span aria-hidden="true" class="animate-pulse text-xl">📢</span>
    </div>

    <div class="mr-4 h-full w-[1px] bg-[#f5c542]/30"></div>

    <div class="flex-1 overflow-hidden [mask-image:linear-gradient(90deg,transparent_0%,#000_5%,#000_95%,transparent_100%)]">
      <div class="flex w-max animate-[scroll_25s_linear_infinite] gap-12 text-sm font-bold whitespace-nowrap text-[#ffe9a3]">
        <span>{message}</span>
        <span aria-hidden="true">{message}</span>
      </div>
    </div>
  </div>
</div>

<style>
  @keyframes scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(calc(-50% - 24px));
    }
  }
</style>
