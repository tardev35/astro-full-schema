---
import kbankLogo from "../assets/banks/kbank.png";
import scbLogo from "../assets/banks/scb.png";
import krungsriLogo from "../assets/banks/krungsri.png";
import ktbLogo from "../assets/banks/ktb.png";
import { brandPick } from "../lib/brandProfile";

const bankPool = [
  { name: "KBank", color: "bg-[#1155cc]", icon: kbankLogo.src },
  { name: "SCB", color: "bg-[#4e1c80]", icon: scbLogo.src },
  { name: "Krungsri", color: "bg-[#fcd34d]", icon: krungsriLogo.src },
  { name: "KTB", color: "bg-[#0ea5e9]", icon: ktbLogo.src },
];

const AMOUNT_MIN = 500;
const AMOUNT_MAX = 900000;
const BIG_WIN = 400000;
const pick = (salt: string, n: number) => brandPick(Astro.site, salt, n);
const digits = (salt: string, n: number) => Array.from({ length: n }, (_, d) => pick(`${salt}-${d}`, 10)).join("");

const initialRows = Array.from({ length: 5 }, (_, i) => {
  const amount = AMOUNT_MIN + pick(`okheng-amount-${i}`, AMOUNT_MAX - AMOUNT_MIN + 1);
  return {
    bank: bankPool[pick(`okheng-bank-${i}`, bankPool.length)],
    user: `0${pick(`okheng-p-${i}`, 2) === 0 ? "8" : "9"}***${digits(`okheng-u${i}`, 4)}`,
    amount,
    big: amount > BIG_WIN,
  };
});

const seedTotal = initialRows.reduce((sum, row) => sum + row.amount, 0);

const ROW_NORMAL = "border-[#ed0133]/25";
const ROW_BIG = "border-[#f0b429]/60 shadow-[0_0_15px_rgba(240,180,41,0.28)]";
const STATUS_NORMAL = "text-green-400 font-bold";
const STATUS_BIG = "text-[#ffdb7d] font-black";
---

<div class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <section
    aria-label="รายการถอนเงินล่าสุดของสมาชิก OKHENG"
    class="relative overflow-hidden rounded-3xl border border-[#ed0133]/45 bg-[#2a0509]/92 shadow-[0_10px_40px_rgba(0,0,0,0.85)] backdrop-blur-xl">
    <div class="relative z-10 flex flex-col gap-4 border-b border-[#ed0133]/35 px-5 py-5 sm:flex-row sm:items-center sm:justify-between md:px-8">
      <div class="flex items-center gap-3">
        <span aria-hidden="true" class="flex h-10 w-10 items-center justify-center rounded-full border border-[#ed0133]/45 bg-[#3a070f] text-2xl text-[#f0b429]">🏆</span>
        <div class="flex flex-col">
          <p class="text-2xl font-black tracking-widest text-[#f9dfe3] drop-shadow-sm">
            รายการถอนเงินล่าสุด OK<span class="text-[#f0b429]">HENG</span>
          </p>
          <span class="text-[11px] font-medium tracking-wide text-[#e0b6bd]">ระบบฝากถอนออโต้ ถอนได้จริงสูงสุด 10 ล้านบาท ดูสถานะและประวัติรายการได้จากหน้าเมมเบอร์ของตัวเอง</span>
        </div>
      </div>
      <div class="flex items-center gap-2 self-start rounded-full border border-green-500/40 bg-green-900/20 px-3 py-1.5 sm:self-auto">
        <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-green-400 shadow-[0_0_8px_rgba(74,222,128,0.8)]"></span>
        <span class="text-[10px] font-bold tracking-widest text-green-400 uppercase">Live</span>
      </div>
    </div>

    <div class="relative z-10 grid grid-cols-2 gap-px overflow-hidden border-b border-[#ed0133]/30 bg-[#4a0611]/40 sm:grid-cols-3">
      <div class="flex flex-col items-center gap-1 bg-[#2a0509] px-4 py-4">
        <span class="text-[11px] font-medium tracking-wide text-[#e0b6bd]">ยอดถอนรวมวันนี้</span>
        <span data-winners-total data-prefix="฿" data-seed={seedTotal} class="bg-gradient-to-r from-[#ffdb7d] to-[#a8710c] bg-clip-text font-mono text-lg font-black text-transparent sm:text-xl">
          ฿{seedTotal.toLocaleString("en-US")}
        </span>
      </div>
      <div class="flex flex-col items-center gap-1 bg-[#2a0509] px-4 py-4">
        <span class="text-[11px] font-medium tracking-wide text-[#e0b6bd]">รายการสำเร็จวันนี้</span>
        <span data-winners-count data-seed={initialRows.length} class="font-mono text-lg font-black text-[#f9dfe3] sm:text-xl">{initialRows.length}</span>
      </div>
      <div class="col-span-2 flex flex-col items-center gap-1 bg-[#2a0509] px-4 py-4 sm:col-span-1">
        <span class="text-[11px] font-medium tracking-wide text-[#e0b6bd]">ถอนได้ต่อรายการ</span>
        <span class="font-mono text-lg font-black text-[#f9dfe3] sm:text-xl">฿{AMOUNT_MIN.toLocaleString("en-US")}–{AMOUNT_MAX.toLocaleString("en-US")}</span>
      </div>
    </div>

    <div class="relative z-10 hidden grid-cols-[2fr_1.3fr_1fr_0.8fr] gap-4 px-8 pt-4 text-[11px] font-bold tracking-widest text-[#e0b6bd] uppercase sm:grid">
      <span>ผู้ใช้งาน</span>
      <span>สถานะ</span>
      <span class="text-right">จำนวนเงิน</span>
      <span class="text-right">เวลา</span>
    </div>

    <div
      data-winners-feed
      data-interval="3500"
      data-max-rows="5"
      data-amount-min={AMOUNT_MIN}
      data-amount-max={AMOUNT_MAX}
      data-user-style="phone"
      data-big-win-above={BIG_WIN}
      class="relative z-10 flex h-[380px] flex-col gap-2 overflow-hidden px-4 py-4 md:px-8">
      {
        initialRows.map((row) => (
          <div data-winner-row class="winner-row origin-top transition-all duration-500 ease-out">
            <div
              data-winner-big
              data-normal-class={ROW_NORMAL}
              data-big-class={ROW_BIG}
              class={`grid grid-cols-[auto_1fr] items-center gap-4 rounded-xl border bg-[#3a070f]/88 p-3.5 shadow-sm transition-colors duration-300 hover:border-[#ed0133]/70 hover:bg-[#4a0611] sm:grid-cols-[2fr_1.3fr_1fr_0.8fr] ${row.big ? ROW_BIG : ROW_NORMAL}`}>
              <div class="col-span-2 flex items-center gap-3 sm:col-span-1">
                <div data-winner-bank class={`flex h-9 w-9 shrink-0 items-center justify-center rounded-full border border-white/10 shadow-inner ${row.bank.color}`}>
                  <img data-winner-icon src={row.bank.icon} alt="" width="20" height="20" loading="lazy" decoding="async" class="h-5 w-5 object-contain grayscale" />
                </div>
                <span data-winner-user class="font-mono text-sm font-bold text-[#f9dfe3]">
                  {row.user}
                </span>
              </div>
              <div data-winner-big data-normal-class={STATUS_NORMAL} data-big-class={STATUS_BIG} class={`text-[11px] tracking-wide sm:text-xs ${row.big ? STATUS_BIG : STATUS_NORMAL}`}>
                <span data-winner-big data-normal-text="✓" data-big-text="🔥" aria-hidden="true">
                  {row.big ? "🔥" : "✓"}
                </span>{" "}
                <span data-winner-big data-normal-text="ทำรายการสำเร็จ" data-big-text="ยอดใหญ่ ทำรายการสำเร็จ">
                  {row.big ? "ยอดใหญ่ ทำรายการสำเร็จ" : "ทำรายการสำเร็จ"}
                </span>
              </div>
              <div class="bg-gradient-to-r from-[#ffdb7d] to-[#a8710c] bg-clip-text text-right font-mono text-base font-black text-transparent sm:text-lg">
                ฿<span data-winner-amount>{row.amount.toLocaleString("en-US")}</span>
              </div>
              <div class="text-right text-[11px] font-medium text-[#e0b6bd] sm:text-xs">เมื่อสักครู่</div>
            </div>
          </div>
        ))
      }
    </div>

    <script type="application/json" data-winners-banks set:html={JSON.stringify(bankPool)} />
  </section>
</div>

<script>
  import { startWinnersFeed } from "../lib/winnersFeed";

  startWinnersFeed();
</script>

<style>
  .font-mono {
    font-family: var(--font-sans);
  }

  .winner-row.is-entering {
    transform: translateY(-0.75rem);
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .winner-row {
      transition: none;
    }
  }
</style>
