---
const {
  message = "POE888 เว็บสีฟ้า รวมหวยไทย หวยลาว หวยฮานอย และหวยมาเลย์ไว้ในบัญชีเดียว • เลือกเลข จัดโพย และตรวจผลรางวัลผ่านมือถือได้ทุกงวด • อัตราจ่าย 3 ตัวบน บาทละ 950 · 3 ตัวโต๊ด 150 · 3 ตัวล่าง 200 · 2 ตัวบน และ 2 ตัวล่าง 95 • แต่ละตลาดปิดรับคนละเวลา เช็กรอบของงวดก่อนยืนยันโพยทุกครั้ง",
} = Astro.props;

const SCROLL_PX_PER_SEC = 50;
const PX_PER_CHAR = 7.6;
const TRAILING_PX = 48;
const scrollSeconds = Math.max(12, Math.round((message.length * PX_PER_CHAR + TRAILING_PX) / SCROLL_PX_PER_SEC));
---

<div class="relative z-10 mx-auto w-full max-w-[1400px] px-4 py-3 font-sans">
  <div class="relative flex overflow-hidden rounded-full border border-[#ffd93d]/35 bg-[#04173f]/85 shadow-[0_5px_15px_rgba(2,10,30,0.5)] backdrop-blur-md">
    <div
      class="relative z-10 flex shrink-0 items-center justify-center bg-gradient-to-r from-[#ffd93d] via-[#ffe98a] to-[#ffd93d] px-6 py-2.5 font-black text-[#02143a] shadow-[4px_0_15px_rgba(2,10,30,0.5)]">
      <span aria-hidden="true" class="mr-2 animate-pulse text-lg">📢</span> ประกาศ
    </div>

    <div class="marquee-container relative flex-1 overflow-hidden py-2.5 pr-6">
      <div aria-hidden="true" class="pointer-events-none absolute top-0 left-0 z-10 h-full w-8 bg-gradient-to-r from-[#04173f] to-transparent"></div>

      <div class="marquee-content inline-block pl-4 text-sm font-bold tracking-widest whitespace-nowrap text-[#dbeafe]/90" style={`animation-duration:${scrollSeconds}s`}>
        <span class="mr-8 inline-flex items-center gap-2"><span aria-hidden="true" class="h-2 w-2 rounded-full bg-[#ffd93d] shadow-[0_0_8px_rgba(255,217,61,0.8)]"></span>{message}</span>
        <span class="mr-8 inline-flex items-center gap-2"><span aria-hidden="true" class="h-2 w-2 rounded-full bg-[#ffd93d] shadow-[0_0_8px_rgba(255,217,61,0.8)]"></span>{message}</span>
      </div>
    </div>
  </div>
</div>

<style>
  .marquee-content {
    animation: marquee 43s linear infinite;
  }
  .marquee-container:hover .marquee-content {
    animation-play-state: paused;
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee-content {
      animation: none;
    }
  }
  @keyframes marquee {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }
</style>
