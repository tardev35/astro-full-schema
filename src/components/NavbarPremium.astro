---
import { Picture } from "astro:assets";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });
const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;
const currentPath = Astro.url.pathname;
const isActive = (path: string) => {
  if (path === "/") return currentPath === "/";
  return currentPath.startsWith(path);
};
---

<header class="sticky top-0 z-[100] w-full font-sans">
  <nav
    class="relative mx-auto flex h-[85px] w-full items-center justify-between rounded-b-2xl border-b border-purple-800/50 bg-[#120322]/80 px-4 shadow-[0_10px_30px_rgba(59,7,100,0.5)] backdrop-blur-xl xl:px-8">
    <a href="/" class="z-[110] flex-shrink-0 transition-transform duration-300 hover:scale-105 hover:drop-shadow-[0_0_15px_rgba(234,179,8,0.5)]">
      {
        mainLogo ? (
          <Picture src={mainLogo} alt="QQ882 Logo" loading="eager" class="h-[55px] w-auto xl:h-[70px]" formats={["avif", "webp"]} fallbackFormat="webp" />
        ) : (
          <h1 class="bg-gradient-to-r from-yellow-300 to-yellow-600 bg-clip-text text-4xl font-black tracking-widest text-transparent drop-shadow-md">QQ882</h1>
        )
      }
    </a>

    <div class="hidden h-full flex-1 items-center justify-center gap-8 lg:flex">
      {
        [
          { name: "หน้าแรก", path: "/" },
          { name: "โปรโมชั่น", path: "/promotion" },
          { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
          { name: "ทางเข้า", path: "/ทางเข้า" },
          { name: "ติดต่อเรา", path: "/contact-us" },
        ].map((item) => (
          <a
            href={item.path}
            class={`group relative flex h-full items-center px-2 text-sm font-bold tracking-widest uppercase transition-colors duration-300 xl:text-base ${isActive(item.path) ? "text-yellow-400" : "text-purple-200/70 hover:text-white"}`}>
            <span>{item.name}</span>
            <div
              class={`absolute bottom-0 left-0 h-[3px] w-full rounded-t-full bg-gradient-to-r from-yellow-400 to-yellow-600 shadow-[0_-2px_10px_rgba(234,179,8,0.8)] transition-transform duration-300 ${isActive(item.path) ? "scale-x-100" : "scale-x-0 group-hover:scale-x-100"}`}
            />
          </a>
        ))
      }
    </div>

    <div class="z-[110] flex items-center gap-4">
      <a
        href="/login"
        class="hidden items-center justify-center rounded-full border border-purple-500/50 bg-purple-900/30 px-7 py-2.5 text-sm font-bold text-purple-200 backdrop-blur-md transition-all duration-300 hover:bg-purple-800/60 hover:text-white hover:shadow-[0_0_15px_rgba(147,51,234,0.4)] lg:flex">
        เข้าสู่ระบบ
      </a>
      <a
        href="/register"
        class="hidden items-center justify-center rounded-full bg-gradient-to-r from-yellow-400 via-yellow-500 to-yellow-600 px-7 py-2.5 text-sm font-black text-[#120322] shadow-[0_4px_15px_rgba(234,179,8,0.3)] transition-all duration-300 hover:-translate-y-0.5 hover:shadow-[0_8px_25px_rgba(234,179,8,0.6)] lg:flex">
        สมัครสมาชิก
      </a>

      <button
        id="hamburger-btn"
        class="relative flex h-[45px] w-[45px] flex-col items-center justify-center gap-[6px] rounded-full border border-purple-500/30 bg-purple-900/50 lg:hidden"
        aria-label="Menu">
        <span class="line-1 h-[2px] w-5 origin-center rounded-full bg-yellow-400 transition-all duration-300"></span>
        <span class="line-2 h-[2px] w-5 origin-center rounded-full bg-yellow-400 transition-all duration-300"></span>
        <span class="line-3 h-[2px] w-5 origin-center rounded-full bg-yellow-400 transition-all duration-300"></span>
      </button>
    </div>
  </nav>

  <div
    id="mobile-menu"
    class="pointer-events-none absolute top-[85px] left-0 w-full origin-top -translate-y-4 scale-y-95 flex-col rounded-b-3xl border-b border-purple-800/50 bg-[#120322]/98 px-6 pt-4 pb-8 opacity-0 shadow-2xl backdrop-blur-2xl transition-all duration-400 lg:hidden">
    <div class="flex flex-col gap-2">
      {
        [
          { name: "หน้าแรก", path: "/" },
          { name: "โปรโมชั่น", path: "/promotion" },
          { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
          { name: "ทางเข้า", path: "/ทางเข้า" },
          { name: "ติดต่อเรา", path: "/contact-us" },
        ].map((item) => (
          <a
            href={item.path}
            class={`flex items-center rounded-xl px-5 py-3.5 text-lg font-bold tracking-widest uppercase transition-colors ${isActive(item.path) ? "bg-purple-900/40 text-yellow-400 shadow-inner" : "text-purple-200/70 hover:bg-white/5 hover:text-white"}`}>
            {item.name}
          </a>
        ))
      }
    </div>
    <div class="mt-6 flex flex-col gap-4">
      <a
        href="/register"
        class="flex w-full justify-center rounded-full bg-gradient-to-r from-yellow-400 to-yellow-600 py-3.5 text-lg font-black text-[#120322] shadow-[0_5px_15px_rgba(234,179,8,0.3)]">
        สมัครสมาชิก
      </a>
      <a href="/login" class="flex w-full justify-center rounded-full border border-purple-500/50 bg-purple-900/30 py-3.5 text-lg font-bold text-purple-200">เข้าสู่ระบบ</a>
    </div>
  </div>
</header>

<style is:global>
  nav,
  header {
    font-family: "Kanit", sans-serif !important;
  }
  #hamburger-btn.active .line-1 {
    transform: translateY(8px) rotate(45deg);
  }
  #hamburger-btn.active .line-2 {
    opacity: 0;
  }
  #hamburger-btn.active .line-3 {
    transform: translateY(-8px) rotate(-45deg);
  }
  #mobile-menu.show {
    opacity: 1;
    transform: translateY(0) scaleY(100%);
    pointer-events: auto;
  }
</style>

<script>
  const hamburgerBtn = document.getElementById("hamburger-btn");
  const mobileMenu = document.getElementById("mobile-menu");
  hamburgerBtn?.addEventListener("click", () => {
    hamburgerBtn.classList.toggle("active");
    mobileMenu?.classList.toggle("show");
  });
</script>
