---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";

import { Picture } from "astro:assets";
import imgLine from "../assets/contact-line.webp";
import { pageGraph } from "../lib/schema";
import { BRAND_ADDRESS } from "../lib/brandProfile";

const pageTitle = "ติดต่อ - TOPGAMEVIP";

const pageDescription =
  "ช่องทางติดต่อทีมงาน TOPGAMEVIP ทักผ่าน LINE Official ได้ตลอด 24 ชั่วโมง พร้อมที่อยู่ติดต่อและอีเมลของทีมงาน สอบถามการสมัคร ฝากถอนออโต้ และการใช้งานระบบ";

const graph = pageGraph(Astro, {
  type: "ContactPage",
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ติดต่อเรา", path: "/contact-us" },
  ],
  org: {
    alternateName: "TOPGAMEVIP เว็บตรงเกมสล็อต ลิขสิทธิ์แท้ ระบบออโต้ สมัคร ฝาก ถอน ไม่มีขั้นต่ำ",
    contactPoints: [
      {
        contactType: "customer service",
        availableLanguage: ["Thai", "English"],
        path: "/line",
        description: "ติดต่อทีมงาน TOPGAMEVIP ผ่าน LINE Official สอบถามการสมัคร การฝากถอนออโต้ และการใช้งานระบบ",
      },
    ],
  },
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="ติดต่อทีมงาน TOPGAMEVIP" as="h1">
    <Picture
      src={imgLine}
      alt="ไอคอนแอป LINE สีเขียวทรงสี่เหลี่ยมมุมมน มีกรอบข้อความสีครีมที่เขียนคำว่า LINE อยู่ตรงกลาง ด้านหลังเป็นวงกลมลูกศรสีเขียวล้อมตัวเลข 24h และมีผู้หญิงผมดำรวบตึง สวมชุดราตรีซาตินสีเขียวเข้มเปิดไหล่ ใส่สร้อยคอมุก ยืนอยู่ทางขวาของภาพ"
      loading="lazy"
      fetchpriority="low"
      widths={[200, 400, 600]}
      sizes="(max-width: 768px) 100vw, 400px"
      class="mx-auto h-auto w-full max-w-[400px] object-contain"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={60}
    />
    {
      BRAND_ADDRESS.lines.length > 0 && (
        <address aria-label={BRAND_ADDRESS.label} class="mt-8 mb-8 rounded-r-xl border-l-4 border-[#e60012] bg-[#fff7f6] py-4 pl-6 text-left text-base leading-relaxed not-italic">
          <span class="mb-1 block font-bold text-[#8a0208]">{BRAND_ADDRESS.label}</span>
          {BRAND_ADDRESS.lines.map((line) => (
            <span class="block">{line}</span>
          ))}
          {BRAND_ADDRESS.email && (
            <span class="mt-3 block">
              <span aria-hidden="true" class="mr-2">
                ✉️
              </span>
              <a href={`mailto:${BRAND_ADDRESS.email}`} class="font-bold text-[#b30009] underline decoration-[#e60012] underline-offset-4 transition-colors hover:text-[#e60012]">
                {BRAND_ADDRESS.email}
              </a>
            </span>
          )}
        </address>
      )
    }

    <div class="flex flex-wrap justify-center gap-4">
      <a
        href="/register"
        aria-label="สมัครสมาชิก TOPGAMEVIP"
        class="flex items-center justify-center rounded-lg border border-[#8a6410] bg-gradient-to-r from-[#ffe9a8] via-[#f5c542] to-[#d4a017] px-8 py-3 font-bold text-[#2a0709] shadow-[0_10px_30px_rgba(212,160,23,0.24)] transition-transform hover:scale-105 hover:shadow-[0_15px_40px_rgba(212,160,23,0.34)]">
        สมัครสมาชิก
      </a>

      <a
        href="/login"
        aria-label="เข้าสู่ระบบ TOPGAMEVIP"
        class="flex items-center justify-center rounded-lg border border-[#e60012]/45 bg-white px-8 py-3 font-extrabold text-[#8a0208] shadow-[0_4px_14px_rgba(230,0,18,0.14)] transition-transform hover:scale-105 hover:bg-[#ffe9e7]">
        เข้าสู่ระบบ
      </a>

      <a
        href="/line"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="ติดต่อทีมงาน TOPGAMEVIP ผ่าน Line Official"
        class="flex items-center justify-center rounded-lg border border-green-300 bg-gradient-to-b from-green-400 to-green-700 px-8 py-3 font-bold text-white transition-transform hover:scale-105">
        ติดต่อผ่าน Line Official
      </a>
    </div>
  </ContentBox>
  <Navfoot />
</MainLayout>
