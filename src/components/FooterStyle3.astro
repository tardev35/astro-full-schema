---
import { Picture } from "astro:assets";
import BankStrip from "./BankStrip.astro";
import { BRAND_ADDRESS } from "../lib/brandProfile";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });

const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

const quickLinks = [
  { name: "หน้าแรก", path: "/" },
  { name: "ทดลองเล่นเกมฟรี", path: "/ทดลองเล่น" },
  { name: "โปรโมชั่นสมาชิกใหม่", path: "/promotion" },
  { name: "ทางเข้าล่าสุด", path: "/ทางเข้า" },
  { name: "เกี่ยวกับเรา", path: "/about-us" },
  { name: "สมัครสมาชิก", path: "/register" },
  { name: "ติดต่อแอดมิน", path: "/contact-us" },
];
---

<footer class="relative mt-32 w-full border-t border-[#f5c542]/30 bg-[#0e0604] pt-64 pb-6 font-sans text-[#f3e3c6] shadow-[0_-10px_30px_rgba(224,27,27,0.22)] md:pt-40">
  <div
    class="absolute -top-14 left-1/2 z-20 flex w-[92%] max-w-5xl -translate-x-1/2 flex-col items-center justify-between rounded-2xl border border-[#f5c542]/35 bg-gradient-to-r from-[#2a1109] via-[#5c1210] to-[#1c0a06] p-6 shadow-[0_15px_40px_rgba(224,27,27,0.35)] md:-top-16 md:flex-row md:p-8">
    <div class="mb-5 flex flex-col text-center md:mb-0 md:text-left">
      <p class="text-xl font-black tracking-wide text-[#ffe9a8] uppercase italic drop-shadow-[0_2px_4px_rgba(0,0,0,0.5)] md:text-3xl">
        <span aria-hidden="true">🃏</span> พร้อมเล่นสล็อตและคาสิโนสดจากบัญชีเดียวกับ 888NEO แล้วหรือยัง?
      </p>
      <p class="mt-2 text-sm font-medium text-[#f3e3c6]/90 md:text-base">
        สมัครสมาชิก 888NEO แล้วเข้าถึงสล็อตและคาสิโนสดได้จากบัญชีเดียว สลับหมวดตามอารมณ์โดยไม่ต้องออกจากระบบ พร้อมระบบออโต้ที่จัดการฝากถอนและเครดิตให้จบในหน้าสมาชิก
      </p>
    </div>

    <a
      href="/register"
      class="group relative flex items-center justify-center overflow-hidden rounded-full border border-[#ffe9a8] bg-gradient-to-b from-[#ffe9a8] to-[#b8860b] px-8 py-3.5 text-sm font-extrabold whitespace-nowrap text-[#1c0a06] shadow-[0_0_15px_rgba(245,197,66,0.4)] transition-all hover:scale-105 md:text-base">
      <span class="relative z-10">สมัครสมาชิกเลย <span aria-hidden="true">🚀</span></span>
      <div aria-hidden="true" class="absolute inset-0 translate-y-full bg-[#e01b1b] transition-transform duration-300 group-hover:translate-y-0"></div>
    </a>
  </div>

  <div class="relative z-10 mx-auto max-w-[1200px] px-6">
    <div class="mb-10 grid grid-cols-1 gap-10 md:grid-cols-12 lg:gap-12">
      <div class="flex flex-col gap-6 md:col-span-12 lg:col-span-4">
        <a href="/" class="inline-block origin-left transition-transform hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt="โลโก้ 888NEO เลข 888 เป็นวงแหวนทองคล้องกันบนพื้นดำ ต่อด้วยตัวอักษรหนาสีแดงว่า NEO และบรรทัดเล็กใต้ตัวอักษรว่า WWW.888NEO.COM"
                widths={[100, 200, 300]}
                sizes="100px"
                height={45}
                loading="lazy"
                decoding="async"
                class="h-[45px] w-auto drop-shadow-[0_0_12px_rgba(245,197,66,0.55)]"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <p class="bg-gradient-to-b from-[#ffe9a8] to-[#b8860b] bg-clip-text text-3xl font-black text-transparent drop-shadow-[0_0_8px_rgba(245,197,66,0.5)]">888NEO</p>
            )
          }
        </a>
        <p class="text-sm leading-relaxed text-[#f3e3c6]/75">
          888NEO รวมเกมสล็อตหลายรูปแบบกับคาสิโนสดไว้ในแพลตฟอร์มเดียว เมนูแยกตามหมวดจึงเลือกเกมหมุนหรือเปลี่ยนไปเล่นเกมโต๊ะได้เร็ว
          เครดิต เกมที่ใช้งาน และประวัติรายการรวมอยู่ในหน้าสมาชิกเดียวกัน พร้อมระบบออโต้ที่ทำรายการฝากถอนและตรวจสถานะได้ตลอด 24 ชั่วโมง
        </p>

        <div class="mt-2 flex flex-wrap gap-3">
          <a
            href="/line"
            class="flex items-center gap-2 rounded-full border border-[#00B900]/30 bg-[#00B900]/10 px-4 py-2 text-xs font-bold text-[#00B900] shadow-[0_0_10px_rgba(0,185,0,0.1)] transition-colors hover:bg-[#00B900] hover:text-white">
            <span aria-hidden="true" class="text-base">💬</span> LINE OFFICIAL
          </a>
        </div>

        {
          BRAND_ADDRESS.lines.length > 0 && (
            <address aria-label={BRAND_ADDRESS.label} class="mt-2 rounded-xl border border-white/15 bg-black/20 p-4 text-xs leading-relaxed not-italic opacity-90">
              <p class="mb-2 flex items-center gap-2 text-[11px] font-bold tracking-wider uppercase opacity-80">
                <span aria-hidden="true" class="text-sm">📍</span>
                {BRAND_ADDRESS.label}
              </p>
              {BRAND_ADDRESS.lines.map((line) => (
                <span class="block">{line}</span>
              ))}
              {BRAND_ADDRESS.email && (
                <a href={`mailto:${BRAND_ADDRESS.email}`} class="mt-3 inline-flex items-center gap-2 font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                  <span aria-hidden="true" class="text-sm">✉️</span>
                  {BRAND_ADDRESS.email}
                </a>
              )}
            </address>
          )
        }
      </div>

      <div class="md:col-span-6 lg:col-span-5">
        <p class="relative mb-5 inline-block text-lg font-bold tracking-wider text-[#f3e3c6] uppercase">
          ลิงก์ด่วน (Quick Links)
          <span aria-hidden="true" class="absolute -bottom-2 left-0 h-1 w-1/2 rounded-full bg-gradient-to-r from-[#e01b1b] to-[#ffe9a8] shadow-[0_0_8px_rgba(245,197,66,0.6)]"></span>
        </p>

        <div class="grid grid-cols-2 gap-x-4 gap-y-3 text-sm">
          {
            quickLinks.map((link) => (
              <a href={link.path} class="group flex items-center text-[#f3e3c6]/75 transition-colors hover:text-[#ffe9a8]">
                <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#ff5a4d] transition-transform group-hover:rotate-45" />
                {link.name}
              </a>
            ))
          }
        </div>
      </div>

      <div class="md:col-span-6 lg:col-span-3">
        <p class="relative mb-5 inline-block text-lg font-bold tracking-wider text-[#f3e3c6] uppercase">
          ระบบการเงิน
          <span aria-hidden="true" class="absolute -bottom-2 left-0 h-1 w-1/2 rounded-full bg-gradient-to-r from-[#e01b1b] to-[#ffe9a8] shadow-[0_0_8px_rgba(245,197,66,0.6)]"></span>
        </p>

        <p class="mb-4 text-xs text-[#f3e3c6]/75">รองรับการฝาก-ถอนผ่านแอปธนาคารชั้นนำและ TrueMoney Wallet โดยควรใช้บัญชีชื่อเดียวกับข้อมูลที่สมัครไว้</p>

        <BankStrip size={30} />

        <div class="mt-3 flex h-10 items-center justify-center rounded border border-white/5 bg-[#1c0a06] transition-colors hover:border-[#f5c542]/50" title="ตรวจรายการย้อนหลัง">
          <span class="flex items-center gap-1 text-xs font-bold text-[#f3e3c6]"><span aria-hidden="true" class="text-lg text-[#f5c542]">🧾</span> เก็บเลขรายการไว้ตรวจสอบได้</span>
        </div>
      </div>
    </div>

    <hr class="mb-6 border-[#f5c542]/25" />

    <div class="mb-6 hidden text-justify text-[10px] leading-relaxed text-[#f3e3c6]/60 md:block">
      888NEO เว็บสล็อตและคาสิโนสด รวมเกมหมุนกับเกมโต๊ะไว้ในบัญชีเดียว เลือกสล็อตตามค่าย ธีม ฟรีสปิน หรือตัวคูณ และเปลี่ยนไปนั่งโต๊ะคาสิโนสดได้จากหมวดเดียวกัน
      ระบบออโต้ทำรายการฝากถอนได้ตลอด 24 ชั่วโมง ตรวจเครดิตและประวัติรายการจากหน้าสมาชิก ทางเข้า 888NEO รองรับโทรศัพท์ แท็บเล็ต และคอมพิวเตอร์ด้วยบัญชีเดิม
    </div>

    <div class="flex flex-col items-center justify-between gap-4 border-t border-white/5 pt-6 text-xs text-[#f3e3c6]/60 md:flex-row">
      <p>&copy; {new Date().getFullYear()} <span class="font-bold tracking-wider text-[#ffe9a8] uppercase">888NEO</span>. All Rights Reserved.</p>

      <div class="flex items-center gap-6">
        <a href="/terms/" class="transition-colors hover:text-[#f3e3c6]">เงื่อนไขและข้อตกลง</a>
        <a href="/privacy/" class="transition-colors hover:text-[#f3e3c6]">นโยบายความเป็นส่วนตัว</a>

        <a
          href="#top"
          class="flex h-8 w-8 items-center justify-center rounded border border-white/10 bg-white/5 text-[#f3e3c6] transition-all hover:border-[#ffe9a8] hover:bg-[#2a1109] hover:shadow-[0_0_15px_rgba(245,197,66,0.5)]"
          aria-label="กลับขึ้นด้านบนสุดของหน้า">
          <span aria-hidden="true">↑</span>
        </a>
      </div>
    </div>
  </div>
</footer>
