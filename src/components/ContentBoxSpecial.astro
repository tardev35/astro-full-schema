---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h2" } = Astro.props;
---

<section class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#a06a09]/55 bg-[#160e03] p-6 text-[#f4e8d2] shadow-[0_10px_30px_rgba(254,201,58,0.14)] transition-all duration-500 hover:border-[#fec93a]/70 md:p-10">
    <div
      aria-hidden="true"
      class="pointer-events-none absolute top-0 left-1/2 -z-10 h-[2px] w-1/2 -translate-x-1/2 bg-gradient-to-r from-transparent via-[#fec93a] to-transparent opacity-60 transition-opacity duration-500 group-hover:opacity-100">
    </div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#a06a09]/40 pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#fec93a] to-[#c9ccd4] shadow-[0_0_10px_rgba(254,201,58,0.45)]" />
          <HeadingTag class="bg-gradient-to-r from-[#ffe9a8] via-[#fec93a] to-[#d4840e] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-2 lg:gap-10">
      <article
        class="relative flex gap-4 rounded-2xl border border-[#a06a09]/55 bg-[#2b1d05] p-6 text-left text-base leading-relaxed text-[#f4e8d2] transition-all duration-300 hover:-translate-y-2 hover:border-[#fec93a]/70 hover:bg-[#33220a] hover:shadow-[0_15px_40px_rgba(254,201,58,0.20)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#ffe9a8]/55 bg-gradient-to-br from-[#ffe9a8] via-[#fec93a] to-[#d4840e] text-2xl shadow-[0_5px_15px_rgba(254,201,58,0.32)]">
          🎟️
        </div>
        <slot name="left" />
      </article>

      <article
        class="relative flex gap-4 rounded-2xl border border-[#5c6472]/70 bg-[#221703] p-6 text-left text-base leading-relaxed text-[#f4e8d2] transition-all duration-300 hover:-translate-y-2 hover:border-[#c9ccd4]/70 hover:bg-[#2b1d05] hover:shadow-[0_15px_40px_rgba(201,204,212,0.18)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#e6e8ee]/45 bg-gradient-to-br from-[#e6e8ee] via-[#c9ccd4] to-[#5c6472] text-2xl shadow-[0_5px_15px_rgba(201,204,212,0.28)]">
          🧾
        </div>
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
