---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxFloatingBadge.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement6.astro";

import { Picture } from "astro:assets";

import pro1 from "../assets/slide1.png";
import pro2 from "../assets/slide2.png";
import pro3 from "../assets/slide3.png";
import pro4 from "../assets/slide4.png";
import { pageGraph } from "../lib/schema";

const pageTitle = "โปรโมชั่น POE888 รวมภาพโปรหวยออนไลน์ ไทย-ลาว และอัตราจ่ายเว็บสีฟ้า";

const pageHeading = "โปรโมชั่น POE888";

const pageDescription =
  "รวมภาพโปรโมชั่นและอัตราจ่ายหวยออนไลน์ของ POE888 ไว้ในหน้าเดียว ทั้งหวยไทย หวยลาว ฮานอย และมาเลย์ อ่านเงื่อนไขกับตลาดที่ร่วมรายการบนภาพก่อนสมัครและยืนยันโพย";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: pro1.src,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageHeading} as="h1">
    <p class="mb-8 text-left text-base leading-relaxed text-[#dbeafe]">
      หน้านี้รวมภาพโปรโมชั่นและอัตราจ่ายที่ <strong class="text-[#ffd93d]">POE888</strong> เปิดให้สมาชิกดูก่อนเลือกตลาด ทั้งหวยไทย หวยลาว หวยฮานอย และหวยมาเลย์
      แต่ละรายการมีรอบ เวลาปิดรับ และเงื่อนไขไม่เท่ากัน จึงควรอ่านรายละเอียดบนภาพให้ครบก่อนยืนยันโพยทุกครั้ง เลือกตลาดที่ติดตามได้แล้วสมัครสมาชิกจากปุ่มด้านล่าง
      เพื่อเริ่มเลือกเลขและจัดโพยในบัญชีเดียว
    </p>

    <div class="grid w-full grid-cols-1 gap-6 sm:grid-cols-2">
      <Picture
        src={pro1}
        alt="ภาพโปรโมชั่น POE888 ด้านบนเป็นโลโก้แพนด้าในกรอบเหลืองคำว่า POE โป888 ตามด้วยข้อความใหญ่สีทองว่า POE888 หวยออนไลน์ แถบข้อความ แทงหวยไทย-ลาว ตรวจผลไว ถอนง่าย และ เว็บสีฟ้า ใช้งานง่าย จ่ายไว มีป้ายสามช่องเขียนว่า ดูผลเร็ว ซื้อสะดวก เล่นได้ทุกวัน ด้านล่างเรียงปุ่มธงสี่ตลาดคือ หวยไทย หวยลาว หวยฮานอย หวยมาเลย์ ข้างขวาเป็นพรีเซนเตอร์หญิงชุดน้ำเงินทองถือใบสลากหวยคลี่เป็นพัด มุมซ้ายล่างเป็นแพนด้ายกนิ้วโป้งข้างกองเหรียญทอง พื้นหลังสีน้ำเงินมีลูกบอลหวยตัวเลขลอยอยู่"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class="mx-auto h-auto w-full rounded-xl border border-[#052c69]/70 object-contain shadow-[0_10px_30px_rgba(11,78,168,0.22)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#2e8bff]/60 hover:shadow-[0_15px_40px_rgba(46,139,255,0.28)]"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />

      <Picture
        src={pro2}
        alt="ภาพโปรโมชั่น POE888 ด้านบนเป็นโลโก้มงกุฎเหนือชื่อ POE888 ตามด้วยข้อความใหญ่สีทองว่า POE888 หวยออนไลน์ บรรทัด แทงหวยไทยลาว ตรวจผลไว ถอนง่าย และปุ่มตลาด หวยไทย หวยลาว หวยฮานอย หวยมาเลย์ มีป้ายเขียนว่า เว็บสีฟ้า และ อัตราจ่ายชัดเจน กลางภาพเป็นพรีเซนเตอร์หญิงชุดน้ำเงินทองชี้นิ้วขึ้น ข้างซ้ายมีกล่องเขียนว่า 3 ตัวบน สูงสุด 1,200 และ 2 ตัวบน สูงสุด 120 ข้างขวาเป็นตารางอัตราจ่ายว่า 3 ตัวบน บาทละ 950 3 ตัวโต๊ด บาทละ 150 3 ตัวล่าง บาทละ 200 2 ตัวบน บาทละ 95 และ 2 ตัวล่าง บาทละ 95 แถบล่างเขียนว่า ระบบปลอดภัย ออกรางวัลไว ถอนง่ายจ่ายจริง พร้อมไลน์ @POE888"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class="mx-auto h-auto w-full rounded-xl border border-[#052c69]/70 object-contain shadow-[0_10px_30px_rgba(11,78,168,0.22)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#2e8bff]/60 hover:shadow-[0_15px_40px_rgba(46,139,255,0.28)]"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />

      <Picture
        src={pro3}
        alt="ภาพโปรโมชั่น POE888 มุมซ้ายบนเป็นแพนด้าถือธนบัตรคู่กับป้ายชื่อ POE888 ตามด้วยข้อความใหญ่สีทองว่า POE888 หวยออนไลน์ แถบ แทงหวยไทยลาว และ เว็บสีฟ้า ตรวจผลไว ถอนง่าย ข้างขวาเรียงปุ่มตลาดพร้อมธงคือ หวยไทย หวยลาว ฮานอย หวยมาเลย์ กลางภาพเป็นพรีเซนเตอร์หญิงชุดน้ำเงินเหลืองถือใบสลากหวยคลี่เป็นพัด ด้านล่างมีกล่องสองช่องเขียนว่า 2 ตัว บาทละ 95 และ 3 ตัว บาทละ 950 พื้นหลังสีน้ำเงินมีลูกบอลหวยตัวเลขลอยอยู่"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class="mx-auto h-auto w-full rounded-xl border border-[#052c69]/70 object-contain shadow-[0_10px_30px_rgba(11,78,168,0.22)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#2e8bff]/60 hover:shadow-[0_15px_40px_rgba(46,139,255,0.28)]"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />

      <Picture
        src={pro4}
        alt="ภาพโปรโมชั่น POE888 ด้านบนเป็นโลโก้แพนด้าคู่กับชื่อ POE888 ตามด้วยข้อความใหญ่สีทองว่า POE888 หวยออนไลน์ แถบ แทงหวยไทย-ลาว ตรวจผลไว ถอนง่าย และ เว็บสีฟ้า ใช้งานง่าย จ่ายไว มีป้ายเขียนว่า ดูผลเร็ว ถอนสะดวก เล่นได้ทุกวัน ด้านล่างเรียงปุ่มธงสี่ตลาดคือ หวยไทย หวยลาว หวยฮานอย หวยมาเลย์ กลางภาพเป็นพรีเซนเตอร์หญิงชุดน้ำเงินเหลืองถือใบสลากหวยและโทรศัพท์ที่เปิดหน้าแอป POE888 พื้นหลังสีน้ำเงินมีลูกบอลหวยตัวเลขและเหรียญทองลอยอยู่"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class="mx-auto h-auto w-full rounded-xl border border-[#052c69]/70 object-contain shadow-[0_10px_30px_rgba(11,78,168,0.22)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#2e8bff]/60 hover:shadow-[0_15px_40px_rgba(46,139,255,0.28)]"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />
    </div>

    <div class="mt-12 flex justify-center pb-4">
      <a
        href="/register"
        class="flex items-center justify-center rounded-lg border border-[#ffe98a]/60 bg-gradient-to-r from-[#ffe98a] via-[#ffd93d] to-[#cd994e] px-10 py-3.5 text-lg font-black text-[#02143a] shadow-[0_10px_30px_rgba(11,78,168,0.28)] transition-transform hover:scale-105 hover:shadow-[0_15px_40px_rgba(255,217,61,0.4)]">
        สมัครสมาชิก POE888
      </a>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
