---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import CtaRedirect from "../components/CtaRedirect.astro";
import { pageGraph } from "../lib/schema";

const pageDescription =
  "หากคุณกำลังมองหาทางเข้าเล่นที่เร็วที่สุด OKHENG รวมปุ่มเข้าสู่ระบบไว้จุดเดียว ใช้ยูสเดิมล็อกอินแล้วเข้าบาคาร่า คาสิโนสด สล็อตลิขสิทธิ์ พร้อมฝากถอนออโต้ได้ทันที";

const graph = pageGraph(Astro, {
  name: "เข้าสู่ระบบ OKHENG บาคาร่า คาสิโนสด สล็อตลิขสิทธิ์",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เข้าสู่ระบบ", path: "/login" },
  ],
});

const targetUrl = "https://yoalink.com/22hs";
---

<MainLayout title="เข้าสู่ระบบ OKHENG | ปุ่มล็อกอินเข้าเล่นบาคาร่า คาสิโนสด สล็อตลิขสิทธิ์" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="เข้าสู่ระบบ OKHENG" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label="เข้าสู่ระบบ OKHENG"
        class="group relative mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#7a0119]/60 bg-gradient-to-b from-[#ed0133] to-[#7a0119] px-6 py-4 text-xl font-bold tracking-wide text-[#ffdb7d] shadow-[0_10px_30px_rgba(237,1,51,0.18)] transition-all duration-300 hover:scale-105 hover:border-[#f0b429]/70 hover:shadow-[0_15px_40px_rgba(240,180,41,0.24)]">
        เข้าสู่ระบบ OKHENG
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="เข้าสู่ระบบ" />
</MainLayout>
