---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#ffd400]/25 bg-[#170733]/92 p-8 text-left text-base leading-relaxed text-[#ece2fb] shadow-[0_10px_30px_rgba(255,212,0,0.14)] backdrop-blur-xl transition-all duration-500 hover:border-[#ffd400]/50 hover:shadow-[0_15px_40px_rgba(255,212,0,0.26)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#ffd400]/20 blur-[60px] transition-all duration-500 group-hover:bg-[#ffe94d]/30"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#8f1080]/25 blur-[60px] transition-all duration-500 group-hover:bg-[#ff4fd8]/35"></div>

    {
      title && (
        <header class="mb-6 flex items-center gap-4 border-b border-[#ffd400]/25 pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffe94d] to-[#b8860a] shadow-[0_0_10px_rgba(255,212,0,0.5)]" />
          <HeadingTag class="bg-gradient-to-r from-[#ffe94d] via-[#ffd400] to-[#ff4fd8] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
