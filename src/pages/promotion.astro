---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxPremium.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";

import { Picture } from "astro:assets";

import pro1 from "../assets/slide1.png";
import pro2 from "../assets/slide2.png";
import pro3 from "../assets/slide3.png";
import { pageGraph } from "../lib/schema";

const pageTitle = "โปรโมชั่น ANDAMAN168 ฝากแรกของวัน คืนยอดเสีย และแนะนำเพื่อน";

const pageDescription =
  "รวมโปรโมชั่น ANDAMAN168 ทั้งโบนัสฝากแรกของวัน 20% คืนยอดเสีย 10% และค่าคอมแนะนำเพื่อน 1% ดูภาพโปรแต่ละรายการแล้วอ่านเงื่อนไขการรับสิทธิ์ก่อนกดใช้งานทุกครั้ง";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: pro1.src,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="โปรโมชั่น ANDAMAN168 ทุกแคมเปญรวมไว้ที่เดียว" as="h1">
    <p class="mb-8 text-left text-base leading-relaxed text-[#dbeefb]">
      หน้านี้รวมภาพโปรโมชั่นที่ <strong class="text-[#fdb524]">ANDAMAN168</strong> เปิดให้สมาชิกเลือกใช้ ทั้งโบนัสฝากแรกของวัน สิทธิ์คืนยอดเสีย และค่าคอมจากการแนะนำเพื่อน
      ทุกรายการผูกกับบัญชีเดียวกับที่ใช้เล่นบาคาร่า สล็อต ฟุตบอล และคาสิโน จึงกดรับและตรวจสถานะได้จากหน้าสมาชิกหน้าเดิม
      รายละเอียดของแต่ละโปรต่างกันทั้งยอดเริ่มต้น เกมที่ร่วมรายการ และเงื่อนไขรับสิทธิ์ จึงควรอ่านจากหน้าโปรนั้นก่อนกดใช้งานทุกครั้ง
    </p>

    <div class="grid w-full grid-cols-1 gap-6 sm:grid-cols-2">
      <Picture
        src={pro1}
        alt="ภาพโปรโมชั่น ANDAMAN168 ฝากแรกของวันรับ 20 เปอร์เซ็นต์ พื้นหลังทะเลอันดามันสีฟ้าเทอร์ควอยซ์กับต้นมะพร้าว พรีเซนเตอร์หญิงชุดทองถือไพ่เอซโพแดงคู่ ล้อมด้วยเหรียญทองและชิปคาสิโน พร้อมข้อความ ทางเข้าหลัก บาคาร่า สล็อต ฟุตบอล ระบบออโต้ 24 ชม. เล่นผ่านมือถือ ฝากถอนอัตโนมัติ และปุ่ม เข้าเล่นเลย"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class="mx-auto h-auto w-full rounded-xl border border-[#21d4f2]/45 object-contain shadow-[0_10px_30px_rgba(33,212,242,0.22)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#fdb524]/60 hover:shadow-[0_15px_40px_rgba(253,181,36,0.28)]"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />

      <Picture
        src={pro2}
        alt="ภาพโปรโมชั่น ANDAMAN168 บาคาร่า สล็อต ฟุตบอล พื้นหลังทะเลสีน้ำเงินมีเงาต้นมะพร้าว พรีเซนเตอร์หญิงชุดสีน้ำเงินถือไพ่เอซ ด้านซ้ายเป็นวงล้อลุ้นรางวัลใหญ่ทั้งเงินสด ทองคำหนัก 1 บาท iPhone 15 Pro Max สร้อยคอทองคำ และอั่งเปาโบนัส พร้อมข้อความ ระบบออโต้ 24 ชม. สมัครสมาชิก ฝากถอนผ่านมือถือ ทางเข้าหลักเล่นง่าย และ รวมเกมครบในบัญชีเดียว"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class="mx-auto h-auto w-full rounded-xl border border-[#21d4f2]/45 object-contain shadow-[0_10px_30px_rgba(33,212,242,0.22)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#fdb524]/60 hover:shadow-[0_15px_40px_rgba(253,181,36,0.28)]"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />

      <Picture
        src={pro3}
        alt="ภาพโปรโมชั่น ANDAMAN168 คืนยอดเสีย 10 เปอร์เซ็นต์ และแนะนำเพื่อนรับค่าคอม 1 เปอร์เซ็นต์ พื้นหลังทะเลสีฟ้ามีวงล้อรูเล็ต พรีเซนเตอร์หญิงชุดทองยืนข้างกองเหรียญทอง ลูกเต๋า และไพ่ พร้อมข้อความ ทางเข้าหลัก ระบบออโต้ 24 ชม. และ บาคาร่า สล็อต ฟุตบอล เล่นผ่านมือถือ"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class="mx-auto h-auto w-full rounded-xl border border-[#21d4f2]/45 object-contain shadow-[0_10px_30px_rgba(33,212,242,0.22)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#fdb524]/60 hover:shadow-[0_15px_40px_rgba(253,181,36,0.28)]"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />
    </div>

    <div class="mt-12 flex justify-center pb-4">
      <a
        href="/register"
        class="flex items-center justify-center rounded-lg border border-[#fdb524]/60 bg-gradient-to-r from-[#ffe999] via-[#fdb524] to-[#b06f00] px-10 py-3.5 text-lg font-black text-[#031324] shadow-[0_10px_30px_rgba(253,181,36,0.24)] transition-transform hover:scale-105 hover:shadow-[0_15px_40px_rgba(253,181,36,0.38)]">
        สมัครสมาชิก ANDAMAN168
      </a>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
