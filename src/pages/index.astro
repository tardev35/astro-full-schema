---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import ContentBoxTwo from "../components/ContentBoxTwo.astro";
import ContentBoxSevenThree from "../components/ContentBoxSevenThree.astro";
import ContentBoxThreeColums from "../components/ContentBox3Three.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement4.astro";
import SmoothCarousel from "../components/SmoothCarousel.astro";
import ProviderGrid from "../components/ProviderGrid.astro";
import Faq from "../components/Faq2.astro";
import LatestWinners from "../components/LatestWinners.astro";

import { Picture } from "astro:assets";
import image1 from "../assets/pro1.webp";
import image2 from "../assets/pro2.jpg";
import image3 from "../assets/slide4.jpg";
import banner1 from "../assets/banner1.webp";

const currentPath = Astro.url.pathname;
const homePage = Astro.url.origin;
const logoUrl = homePage + "/logo.webp";

const webPageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: "CEO66 เว็บใหญ่ รับผิดชอบทุกความไว้วางใจ ทางเข้าหลักระบบ API แท้ เกมแตกไว",
  description: "CEO66 เว็บใหญ่ ระบบ API แท้ ที่กล้ารับผิดชอบทุกความไว้ใจ รวมเกมสล็อตแตกไว ค่ายดังมีคุณภาพ ปลอดภัย ไม่มีขั้นต่ำ และใช้ระบบออโต้ สมัครง่าย ไม่ต้องแอดไลน์",
  url: currentPath,
};

const webSiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "CEO66",
  alternateName: ["ceo66", "CEO66official", "CEO66officials", "CEO66"],
  url: "https://ceo66.com/",
};

const orgSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "CEO66",
  logo: logoUrl,
  url: homePage,
};

const allSchemas = [webPageSchema, orgSchema, webSiteSchema];
---

<MainLayout>
  <script type="application/ld+json" set:html={JSON.stringify(allSchemas)} />
  <Announcement />

  <ContentBox>
    <p>
      <h1 class="text-blue-gradient mb-2 text-2xl xl:text-4xl">CEO66 เว็บใหญ่ รับผิดชอบทุกความไว้วางใจ ทางเข้าหลักระบบ API แท้ เกมแตกไว</h1>
      <strong class="text-amber-400">CEO66</strong> เว็บใหญ่ ตัวจริงของวงการ เว็บใหญ่ที่เสถียรที่สุดในไทย การันตีด้วย ทางเข้าหลัก ที่ใช้ ระบบ API แท้ 100% มาตรฐานระดับสากล เชื่อมต่อตรงจากค่ายเกม ไม่ว่าจะเป็นคาสิโน
      สล็อต บาคาร่า ยิงปลา หรือหวย ทุกอย่างโปร่งใส ไม่มีการหมกเม็ด และไม่ผ่านเอเย่นต์ ด้วยระบบที่ทันสมัยที่สุดในปี 2026 ผมคัดเฉพาะ เกมแตกไว ที่แตกง่ายจ่ายจริงมาให้เล่นเท่านั้น เพราะความตั้งใจของผมคือการ
      รับผิดชอบทุกความไว้วางใจ ที่สมาชิกทุกคนมีให้กับเรา
      <strong class="text-amber-400">CEO66</strong>
    </p>

    <div class="mt-3.5 flex flex-wrap justify-center gap-4">
      <a
        href="/register"
        aria-label="สมัครสมาชิก"
        class="to-red to-red to-red flex items-center justify-center rounded-lg border border-gray-400 bg-gradient-to-b from-red-900 to-red-700 px-8 py-3 font-bold text-white transition-transform hover:scale-105">
        สมัครสมาชิก
      </a>

      <a
        href="/login"
        aria-label="เข้าเล่นเกม"
        class="flex items-center justify-center rounded-lg border border-yellow-600 bg-gradient-to-b from-yellow-200 to-yellow-500 px-8 py-3 font-extrabold text-black shadow-[0_0_15px_rgba(255,215,0,0.4)] transition-transform hover:scale-105">
        เข้าเล่นเกม
      </a>

      <a
        href="/line"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="ติดต่อเราผ่าน Line"
        class="flex items-center justify-center rounded-lg border border-green-300 bg-gradient-to-b from-green-400 to-green-700 px-8 py-3 font-bold text-white transition-transform hover:scale-105">
        ติดต่อเรา
      </a>
    </div>
  </ContentBox>
  <ProviderGrid />
  <ContentBoxTwo>
    <div slot="left">
      <h2 class="text-blue-gradient mb-4 text-2xl font-bold">ทำไมต้องเลือก CEO66? สัมผัสระบบ API แท้ที่เสถียรที่สุด</h2>
      <p>
        <strong class="text-amber-400">CEO66</strong> สล็อตเว็บใหญ่ มาตรฐานสูงที่ขับเคลื่อนด้วย ระบบ API แท้ 100% ที่ส่งตรงจากเซิร์ฟเวอร์หลักของค่ายเกมต่างประเทศที่ได้คุณผ่านการทดสอบ สิ่งที่สมาชิกจะได้รับคือ
        อัตราการจ่าย (RTP) จะเป็นไปตามมาตรฐานที่ค่ายเกมกำหนดไว้จริง รองรับการเข้าใช้งานพร้อมกันปริมาณมากหลักแสนยูสต่อวัน การประมวลผลที่แม่นยำ ทุกการอัปเดตยอดเงินเป็นไปอย่างเรียลไทม์ แม่นยำทุกสตางค์ และสุดท้าย
        มาตรฐาน API แท้มาพร้อมระบบรักษาความปลอดภัยข้อมูล รัดกุม
      </p>
    </div>
    <div slot="right">
      <h2 class="text-blue-gradient mb-4 text-2xl font-bold">CEO66 แหล่งรวมเกมสล็อตแตกไว คัดสรรเฉพาะค่ายดังมีคุณภาพ ระดับพรีเมียม</h2>
      <p>
        หัวใจของการบริหารแบรนด์ เว็บสล็อต เว็บใหญ่ ระดับพรีเมียม คือการกล้าปฏิเสธค่ายเกมที่ไม่ได้มาตรฐานและเลือกเฉพาะสิ่งที่ดีที่สุดมาไว้ที่นี่ <strong class="text-amber-400">CEO66</strong> จึงเป็นศูนย์รวมของค่ายเกมสล็อต
        และคาสิโนลิขสิทธิ์แท้ระดับสากลที่ผ่านการคัดกรองอย่างรัดกุม ทุกค่ายต้องมีประวัติการจ่ายที่โปร่งใสและมีอัตราการเข้าถึงรอบโบนัสที่รวดเร็ว จนกลายเป็นนิยามของ เกมแตกไว ที่สมาชิกไว้วางใจได้จริง ทุกการอัปเดตระบบในปี
        2026 คือการยกระดับมาตรฐานคุณภาพให้เหนือกว่าเดิม เพื่อเปลี่ยนทุกการเดิมพันให้เป็นโอกาสทำกำไรที่ชัดเจนและมีประสิทธิภาพที่สุด
      </p>
    </div>
  </ContentBoxTwo>
  <ContentBox>
    <h2 class="text-blue-gradient mb-7 text-2xl font-semibold">ฝากง่าย จ่ายจริง จ่ายตรง จ่ายเร็ว ไม่มีขั้นต่ำ ด้วยระบบออโต้</h2>
    <p>
      จบทุกปัญหาเรื่องการเงินด้วยระบบออโต้ 100% ที่ทำงานไวที่สุดในไทย สมาชิก <strong class="text-amber-400">CEO66</strong> สามารถทำรายการได้เองตั้งแต่วันแรกโดย ไม่มีขั้นต่ำ จะฝากหลักสิบเพื่อลองระบบ หรือถอนหลักล้านหลังจากทำกำไร
      ก็จัดการได้ทันทีไม่ต้องรอแอดมินยืนยัน ทุกยอดการเล่นเราการันตี จ่ายจริง จ่ายตรง และจ่ายเร็ว ไม่มีการดึงเช็งหรือขอสลิปให้วุ่นวาย เพราะที่นี่เน้นความถูกต้องและรวดเร็วเป็นหลัก เพื่อให้สมาชิกได้รับเงินเข้าบัญชีภายในไม่กี่วินาที
    </p>
  </ContentBox>
  <SmoothCarousel />
  <LatestWinners />
  <ContentBox>
    <h2 class="text-blue-gradient mb-7 text-2xl font-semibold">ทางเข้าหลัก CEO66 เว็บใหญ่ ไม่ผ่านเอเย่ต์ เน้นความปลอดภัย</h2>
    <p>
      เข้าใช้งานผ่าน <strong class="text-amber-400">ทางเข้าหลัก CEO66</strong> เพื่อตัดความเสี่ยงจากคนกลางและเอเย่นต์ออกไปให้หมด ลิงก์ทางเข้าทุุกตัวส่งสัญญาณตรงถึงเซิร์ฟเวอร์หลัก ไม่มีมือที่สามเพื่อดักข้อมูลสมาชิก
      ระบบมีการอัปเดตทางเข้าใหม่ล่าสุดโดยอัตโนมัติผ่าน Cloud Server เพื่อแก้ปัญหาลิงก์เสียหรือเข้าเล่นไม่ได้ พร้อมระบบเข้ารหัส SSL ขั้นสูงสุดขณะล็อกอิน ป้องกันการถูกแฮกและรักษาความเป็นส่วนตัวได้ 100% เล่นตรงกับทางเข้าหลักปลอดภัยที่สุด
    </p>
  </ContentBox>

  <ContentBoxSevenThree>
    <div slot="left">
      <div class="rounded-xl p-5">
        <Picture
          src={image3}
          alt="ทางเข้า Lockdown168 ล่าสุด"
          loading="lazy"
          fetchpriority="low"
          widths={[200, 400, 600, 800]}
          sizes="(max-width: 768px) 100vw, 33vw"
          class="mx-auto h-auto w-full max-w-[400px] object-contain shadow-xl"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
          fallbackFormat="webp"
        />
      </div>
    </div>
    <div slot="right">
      <h2 class="text-blue-gradient mb-7 text-2xl font-semibold">สมัคร CEO66 ลงทะเเบียนง่าย กรอกข้อมูลน้อย ไม่ต้องแอดไลน์</h2>
      <p class="mb-5">
        สมัคร <strong class="text-amber-400">CEO66</strong> ได้ทันทีผ่านหน้าเว็บหลักโดยไม่ต้องผ่านมือแอดมินหรือคนกลาง ขั้นตอนลงทะเบียนสั้นกระชับกรอกข้อมูลเพียงไม่กี่อย่างเพื่อรับยูสเซอร์เข้าเล่นทันที ระบบอัปเดตข้อมูลตรงเข้าฐานเซิร์ฟเวอร์หลักที่เข้ารหัสความปลอดภัยสูง
        ไม่ต้องเสียเวลาแอดไลน์ส่งข้อมูลส่วนตัวให้ใครเห็น หรือทำการสมัครยืนยันซ้ำซ้อน
      </p>
    </div>
  </ContentBoxSevenThree>

  <Navfoot />
</MainLayout>
<style>
  .text-blue-gradient {
    background: linear-gradient(to bottom, #d700ea 0%, #a32ae9 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
</style>
