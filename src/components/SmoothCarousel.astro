---
import { Picture } from "astro:assets";

import slide2 from "../assets/slide2.png";
import slide4 from "../assets/slide4.png";

const images = [
  {
    src: slide2,
    alt: "ภาพโปรโมชั่น OSIRIS168 ชวนเพื่อนรับค่าคอม 0.8% รับส่วนแบ่งทุกยอด เพื่อนสมัคร เพื่อนเล่น รับได้ต่อเนื่อง ปุ่มดูรายละเอียด พรีเซนเตอร์หญิงชุดอียิปต์ดำทอง ตัวเลข 0.8% สีเขียวมรกตขอบทอง บนพื้นหลังเสาวิหารทอง",
  },
  {
    src: slide4,
    alt: "ภาพโปรโมชั่น OSIRIS168 สมาชิกใหม่ 100% โบนัสต้อนรับ สมัครวันนี้รับสิทธิ์ทันที ปุ่มดูโปรโมชั่น ตัวเลข 100% สีเขียวมรกตขอบทอง ด้านขวาเป็นพรีเซนเตอร์หญิงชุดอียิปต์ขาวทอง ด้านล่างมีปิรามิดทอง ไพ่ และกองเหรียญทอง",
  },
];

const COPIES = 3;
const slides = Array.from({ length: COPIES }, () => images).flat();
---

<div class="marquee mx-auto w-full max-w-7xl overflow-hidden px-4 py-5">
  <input id="carousel-pause" type="checkbox" class="peer sr-only" />
  <label
    for="carousel-pause"
    class="sr-only cursor-pointer peer-focus-visible:not-sr-only peer-focus-visible:mb-3 peer-focus-visible:inline-block peer-focus-visible:rounded-full peer-focus-visible:border peer-focus-visible:border-[#12c48f]/60 peer-focus-visible:bg-[#0f241d] peer-focus-visible:px-4 peer-focus-visible:py-2 peer-focus-visible:text-sm peer-focus-visible:font-bold peer-focus-visible:text-[#f8ecc9]">
    หยุด / เล่นสไลด์ภาพ
  </label>

  <div class="marquee-track flex">
    {
      slides.map((slide, index) => {
        const isDuplicate = index >= images.length;
        return (
          <div class="marquee-slide" aria-hidden={isDuplicate ? "true" : undefined}>
            <Picture
              src={slide.src}
              alt={isDuplicate ? "" : slide.alt}
              class="block w-full rounded-xl border border-[#064c39] object-cover shadow-[0_10px_30px_rgba(18,196,143,0.20)]"
              width={slide.src.width}
              height={slide.src.height}
              loading="lazy"
              fetchpriority="low"
              decoding="async"
              widths={[300, 360, 420, 480, 540, 600]}
              sizes="(max-width: 767px) calc(100vw - 32px), (max-width: 1279px) calc((100vw - 48px) / 2), 403px"
              formats={["avif", "webp"]}
              fallbackFormat="webp"
              quality={60}
            />
          </div>
        );
      })
    }
  </div>
</div>

<style>
  .marquee {
    --gap: 12px;
    --per-view: 1;
    --shift: calc(-200% - 24px);
  }

  @media (min-width: 768px) {
    .marquee {
      --gap: 16px;
      --per-view: 2;
      --shift: calc(-100% - 16px);
    }
  }

  @media (min-width: 1280px) {
    .marquee {
      --gap: 20px;
      --per-view: 3;
      --shift: calc(-66.6667% - 13.3333px);
    }
  }

  .marquee-track {
    gap: var(--gap);
    width: 100%;
    animation: carousel-scroll 24s linear infinite;
    will-change: transform;
  }

  .marquee-slide {
    flex: 0 0 calc((100% - (var(--per-view) - 1) * var(--gap)) / var(--per-view));
  }

  @keyframes carousel-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(var(--shift));
    }
  }

  .marquee:hover .marquee-track,
  .marquee:focus-within .marquee-track,
  .marquee > input:checked ~ .marquee-track {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
    }
  }
</style>
