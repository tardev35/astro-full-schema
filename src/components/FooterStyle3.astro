---
import { Picture } from "astro:assets";
import BankStrip from "./BankStrip.astro";
import { BRAND_ADDRESS } from "../lib/brandProfile";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });

const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

const quickLinks = [
  { name: "หน้าแรก", path: "/" },
  { name: "ทดลองเล่นเกมฟรี", path: "/ทดลองเล่น" },
  { name: "โปรโมชั่นสมาชิกใหม่", path: "/promotion" },
  { name: "ทางเข้าล่าสุด", path: "/ทางเข้า" },
  { name: "เกี่ยวกับเรา", path: "/about-us" },
  { name: "สมัครสมาชิก", path: "/register" },
  { name: "เข้าสู่ระบบ", path: "/login" },
  { name: "ติดต่อแอดมิน", path: "/contact-us" },
];

const logoAlt = "โลโก้ PIGAUTO รูปหมูสีชมพูยิ้มอยู่ในวงเฟืองสีเงิน ใต้ภาพเขียนว่า PIGAUTO ด้วยตัวอักษรสีขาวขอบดำ";
---

<footer class="relative mt-32 w-full border-t border-[#f5c542]/30 bg-[#1a0303] pt-64 pb-6 font-sans text-[#f7e2d6] shadow-[0_-10px_30px_rgba(127,29,29,0.35)] md:pt-40">
  <div
    class="absolute -top-14 left-1/2 z-20 flex w-[92%] max-w-5xl -translate-x-1/2 flex-col items-center justify-between rounded-2xl border border-[#f5c542]/40 bg-gradient-to-r from-[#280707] via-[#7f1d1d] to-[#280707] p-6 shadow-[0_15px_40px_rgba(239,68,68,0.3)] md:-top-16 md:flex-row md:p-8">
    <div class="mb-5 flex flex-col text-center md:mb-0 md:text-left">
      <p class="text-xl font-black tracking-wide text-white uppercase italic drop-shadow-[0_2px_4px_rgba(26,3,3,0.6)] md:text-3xl">
        <span aria-hidden="true">🐷</span> พร้อมปั่นสล็อตออโต้ไม่มีขั้นต่ำกับ PIGAUTO แล้วหรือยัง?
      </p>
      <p class="mt-2 text-sm font-medium text-[#f7e2d6]/90 md:text-base">
        สมัครยูสเดียวแล้วเลือกได้ทั้งสล็อตออโต้ คาสิโนสด และบาคาร่า เปลี่ยนแนวเล่นตามอารมณ์โดยไม่ต้องออกจากระบบ พร้อมระบบออโต้รองรับวอลเล็ทที่จัดการฝากถอนและเครดิตให้จบในหน้าสมาชิก
      </p>
    </div>

    <a
      href="/register"
      class="group relative flex items-center justify-center overflow-hidden rounded-full border border-[#f5c542] bg-gradient-to-b from-[#ffe9a8] to-[#f5c542] px-8 py-3.5 text-sm font-extrabold whitespace-nowrap text-[#280707] shadow-[0_0_15px_rgba(245,197,66,0.45)] transition-all hover:scale-105 md:text-base">
      <span class="relative z-10">สมัครสมาชิกเลย <span aria-hidden="true">🚀</span></span>
      <div aria-hidden="true" class="absolute inset-0 translate-y-full bg-[#ef4444] transition-transform duration-300 group-hover:translate-y-0"></div>
    </a>
  </div>

  <div class="relative z-10 mx-auto max-w-[1200px] px-6">
    <div class="mb-10 grid grid-cols-1 gap-10 md:grid-cols-12 lg:gap-12">
      <div class="flex flex-col gap-6 md:col-span-12 lg:col-span-4">
        <a href="/" class="inline-block origin-left transition-transform hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt={logoAlt}
                widths={[100, 200, 300]}
                sizes="100px"
                height={45}
                loading="lazy"
                decoding="async"
                class="h-[45px] w-auto rounded-md bg-white/95 px-1.5 py-1 drop-shadow-[0_0_12px_rgba(239,68,68,0.55)]"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <p class="bg-gradient-to-b from-white to-[#ffe9a8] bg-clip-text text-3xl font-black text-transparent drop-shadow-[0_0_8px_rgba(245,197,66,0.5)]">PIGAUTO</p>
            )
          }
        </a>
        <p class="text-sm leading-relaxed text-[#f7e2d6]/80">
          PIGAUTO รวมสล็อตออโต้จากหลายค่ายไว้ในยูสเดียว จัดหมวดตามค่ายและแนวเกมให้เลือกเกมที่ชอบหรือลองเกมใหม่ได้เร็ว
          เครดิต โปร และประวัติรายการรวมอยู่ในหน้าสมาชิกเดียวกัน พร้อมระบบออโต้รองรับวอลเล็ทที่ทำรายการและตรวจสถานะได้ตลอด 24 ชั่วโมง
        </p>

        <div class="mt-2 flex flex-wrap gap-3">
          <a
            href="/line"
            class="flex items-center gap-2 rounded-full border border-[#00B900]/40 bg-[#00B900]/15 px-4 py-2 text-xs font-bold text-[#8fe6a8] shadow-[0_0_10px_rgba(0,185,0,0.15)] transition-colors hover:bg-[#00B900] hover:text-white">
            <span aria-hidden="true" class="text-base">💬</span> LINE OFFICIAL
          </a>
        </div>

        {
          BRAND_ADDRESS.lines.length > 0 && (
            <address aria-label={BRAND_ADDRESS.label} class="mt-2 rounded-xl border border-white/15 bg-black/20 p-4 text-xs leading-relaxed not-italic opacity-90">
              <p class="mb-2 flex items-center gap-2 text-[11px] font-bold tracking-wider uppercase opacity-80">
                <span aria-hidden="true" class="text-sm">📍</span>
                {BRAND_ADDRESS.label}
              </p>
              {BRAND_ADDRESS.lines.map((line) => (
                <span class="block">{line}</span>
              ))}
              {BRAND_ADDRESS.email && (
                <a href={`mailto:${BRAND_ADDRESS.email}`} class="mt-3 inline-flex items-center gap-2 font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                  <span aria-hidden="true" class="text-sm">✉️</span>
                  {BRAND_ADDRESS.email}
                </a>
              )}
            </address>
          )
        }
      </div>

      <div class="md:col-span-6 lg:col-span-5">
        <p class="relative mb-5 inline-block text-lg font-bold tracking-wider text-white uppercase">
          ลิงก์ด่วน (Quick Links)
          <span aria-hidden="true" class="absolute -bottom-2 left-0 h-1 w-1/2 rounded-full bg-gradient-to-r from-[#f5c542] to-[#ef4444] shadow-[0_0_8px_rgba(245,197,66,0.6)]"></span>
        </p>

        <div class="grid grid-cols-2 gap-x-4 gap-y-3 text-sm">
          {
            quickLinks.map((link) => (
              <a href={link.path} class="group flex items-center text-[#f7e2d6]/80 transition-colors hover:text-[#ffe9a8]">
                <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#f5c542] transition-transform group-hover:rotate-45" />
                {link.name}
              </a>
            ))
          }
        </div>
      </div>

      <div class="md:col-span-6 lg:col-span-3">
        <p class="relative mb-5 inline-block text-lg font-bold tracking-wider text-white uppercase">
          ระบบการเงิน
          <span aria-hidden="true" class="absolute -bottom-2 left-0 h-1 w-1/2 rounded-full bg-gradient-to-r from-[#f5c542] to-[#ef4444] shadow-[0_0_8px_rgba(245,197,66,0.6)]"></span>
        </p>

        <p class="mb-4 text-xs text-[#f7e2d6]/80">รองรับการฝาก-ถอนผ่านแอปธนาคารชั้นนำและทรูมันนี่วอลเล็ท โดยควรใช้บัญชีชื่อเดียวกับข้อมูลที่สมัครไว้</p>

        <BankStrip size={30} />

        <div class="mt-3 flex h-10 items-center justify-center rounded border border-white/10 bg-[#280707] transition-colors hover:border-[#f5c542]/60" title="ตรวจรายการย้อนหลัง">
          <span class="flex items-center gap-1 text-xs font-bold text-[#f7e2d6]"><span aria-hidden="true" class="text-lg text-[#ffe9a8]">🧾</span> เก็บเลขรายการไว้ตรวจสอบได้</span>
        </div>
      </div>
    </div>

    <hr class="mb-6 border-white/15" />

    <div class="mb-6 hidden text-justify text-[10px] leading-relaxed text-[#f7e2d6]/65 md:block">
      PIGAUTO เว็บสล็อตออโต้แท้ไม่มีขั้นต่ำ รวมเกมจากหลายค่ายไว้ในยูสเดียว เลือกสล็อตตามค่าย ธีม ฟรีสปิน หรือฟีเจอร์โบนัส และสลับไปลองเกมใหม่หรือเข้าโต๊ะคาสิโนสดได้จากบัญชีเดิม
      ระบบออโต้รองรับวอลเล็ททำรายการฝากถอนได้ตลอด 24 ชั่วโมง ตรวจเครดิต โปร และประวัติรายการจากหน้าสมาชิก ทางเข้า PIGAUTO รองรับโทรศัพท์ แท็บเล็ต และคอมพิวเตอร์ด้วยยูสเดิม
    </div>

    <div class="flex flex-col items-center justify-between gap-4 border-t border-white/15 pt-6 text-xs text-[#f7e2d6]/70 md:flex-row">
      <p>&copy; {new Date().getFullYear()} <span class="font-bold tracking-wider text-white uppercase">PIGAUTO</span>. All Rights Reserved.</p>

      <div class="flex items-center gap-6">
        <a href="/terms/" class="transition-colors hover:text-white">เงื่อนไขและข้อตกลง</a>
        <a href="/privacy/" class="transition-colors hover:text-white">นโยบายความเป็นส่วนตัว</a>

        <a
          href="#top"
          class="flex h-8 w-8 items-center justify-center rounded border border-white/20 bg-white/10 text-white transition-all hover:border-[#f5c542] hover:bg-[#280707] hover:shadow-[0_0_15px_rgba(245,197,66,0.5)]"
          aria-label="กลับขึ้นด้านบนสุดของหน้า">
          <span aria-hidden="true">↑</span>
        </a>
      </div>
    </div>
  </div>
</footer>
