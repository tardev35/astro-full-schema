---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/Announcement3.astro";
import ContentBox from "../components/ContentBox.astro";
import ContentBoxPremium from "../components/ContentBoxPremium.astro";
import ContentBoxSpecial from "../components/ContentBoxSpecial.astro";
import ContentBoxTwo from "../components/ContentBoxTwo.astro";
import ContentBoxTwoPremium from "../components/ContentBoxTwoPremium.astro";
import ContentBoxSevenThree from "../components/ContentBoxSevenThree.astro";
import ContentBoxSevenThreePremium from "../components/ContentBoxSevenThreePremium.astro";
import FeatureHighlights from "../components/FeatureHighlights.astro";
import ProviderGrid from "../components/ProviderGrid.astro";
import GameRankingBoard from "../components/GameRankingBoard.astro";
import SmoothCarousel from "../components/SmoothCarousel.astro";
import LatestWinners3 from "../components/LatestWinners3.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import ReviewCardSumo2 from "../components/ReviewCardSumo2.astro";
import Faq3 from "../components/Faq3.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import imgGameLobby from "../assets/slide2.png";
import imgSmartWallet from "../assets/slide4.png";

const pageTitle = "RIEL38 เว็บสล็อตมาใหม่ เลือกเล่นกว่า 2,000 เกม ลองเล่นฟรีที่ เรียล38";

const pageDescription = "RIEL38 เว็บสล็อตมาใหม่ รวมค่ายดัง มีเกมสล็อตให้เลือก กว่า 2,000 เกม รองรับ Smart Wallet เข้าสู่ระบบ ได้ทุกอุปกรณ์ สมัครสมาชิกรับโปรดีๆ ทดลองเล่นฟรี เรียล38";

const announcement =
  "เรียล38 เปิดให้เลือกเกมสล็อตกว่า 2,000 เกม จากค่ายชั้นนำมากกว่า 30 ค่าย จบในบัญชีเดียว • อยากดูจังหวะเกมก่อนก็กดโหมดทดลองเล่นฟรี เครดิตจำลองถอนไม่ได้และไม่นับเป็นยอดเทิร์น • Smart Wallet เก็บเครดิตไว้ที่เดียว เปลี่ยนค่ายแล้วเข้าเกมต่อได้ทันที • AI หลังบ้านคอยรวมข้อมูลเกมที่เล่นบ่อย เทียบ RTP และสรุปโบนัสไว้ให้ดูจากหน้าเมมเบอร์ • ยูสเดิมใช้เข้าได้ทั้งมือถือ แท็บเล็ต และคอม เปลี่ยนเครื่องกลางวันแล้วเล่นต่อได้ • โปรฝาก 39 รับรวม 69 เทิร์น 1 เท่า ถอนได้สูงสุด 300 บาท";

const gameLobbyAlt =
  "ภาพโปรโมชั่น RIEL38 ข้อความ กว่า 2,000 เกม รวม 30+ ค่ายดัง พร้อมปุ่มสีชมพูคำว่า ทดลองเล่นฟรี ฉากหลังเป็นหน้าล็อบบี้เกมสล็อต มีโลโก้ค่าย PG, PRAGMATIC PLAY, JILI, HABANERO และ JOKER พร้อมคำว่า และอีกมากมาย ด้านขวาเป็นพรีเซนเตอร์หญิงชี้มาที่กล้อง";

const smartWalletAlt =
  "ภาพอธิบายระบบ Smart Wallet ของ RIEL38 ข้อความ สลับเกมหลายค่าย เครดิตไม่สะดุด ตรงกลางเป็นกระเป๋าเงินสามมิติสีชมพู ล้อมด้วยไอคอนวงกลม SLOT, LIVE CASINO, FISHING, CRASH และ SPORTS ด้านล่างมีป้ายสามอันว่า รวมเครดิตไว้จุดเดียว เข้าเกมต่อเนื่อง และ สลับค่ายง่าย";

const freeTrialRemark = [
  { label: "วันที่ทดสอบ", value: "1 ก.ย." },
  { label: "มือถือที่ใช้ทดสอบ", value: "SAMSUNG A17" },
  { label: "บราวเซอร์", value: "Google Chrome" },
  { label: "ความเร็วโหลดเกม", value: "ประมาณ 6-10 วินาที" },
  { label: "ค่ายเกมที่ทดลองเล่น", value: "PG SLOT และ JILI และเปิดใช้งาน Smart Wallet ทำงานได้แม่นยำ" },
];

const providerStyles = [
  {
    icon: "📱",
    title: "PG Soft เหมาะกับสายเล่นมือถือและชอบเกมเข้าใจง่าย",
    description: "เกมจาก PG Soft มักมีภาพจำชัด เล่นบนมือถือสะดวก และฟีเจอร์เรียนรู้ไม่ยาก ตัวที่คนเล่นคุ้นชื่อ เช่น Mahjong Ways 2, Lucky Neko, Fortune Tiger และ Ways of the Qilin",
    accent: "pink" as const,
  },
  {
    icon: "🎁",
    title: "Pragmatic Play เหมาะกับสายชอบฟรีสปินและตัวคูณ",
    description:
      "ถ้าชอบรอลุ้นรอบโบนัส เกมอย่าง Sweet Bonanza, Gates of Olympus, Starlight Princess และ Sugar Rush เป็นชื่อที่เจอกันบ่อย จุดเด่นคือแต่ละเกมมีฟีเจอร์ค่อนข้างชัด คนเล่นจึงเลือกแนวที่ตัวเองชอบได้ง่าย",
    accent: "violet" as const,
  },
  {
    icon: "⚡",
    title: "JILI มีเกมจังหวะไวสำหรับสายชอบเปลี่ยนเกมบ่อย",
    description: "ค่าย JILI มีเกมที่เดินจังหวะเร็วและมีฟีเจอร์หลากหลาย เช่น Super Ace, Fortune Gems, Golden Empire และ Money Coming เหมาะกับคนที่ชอบลองหลายเกมในหนึ่งรอบเล่น",
    accent: "pink" as const,
  },
];

const faqs = [
  {
    q: "RIEL38 มีเกมสล็อตให้เลือกกี่เกม",
    a: "รวมเกมจากหลายค่ายไว้มากกว่า 2,000 เกมในบัญชีเดียว มีทั้งเกมยอดนิยม เกมใหม่ ฟรีสปิน และสล็อตหลายสไตล์ เลือกตามค่าย ธีม หรือฟีเจอร์ที่ต้องการได้โดยไม่ต้องเปิดยูสใหม่ตามค่าย",
  },
  {
    q: "โหมดทดลองเล่นฟรีของ เรียล38 ใช้งานยังไง",
    a: "กดเข้าโหมดทดลองเล่นเพื่อดูรูปแบบเกมและฟีเจอร์ก่อนลงเงินจริงได้เลย เครดิตในโหมดนี้เป็นเครดิตจำลอง ถอนไม่ได้และไม่นับเป็นยอดเทิร์น และไม่ใช่ทุกเกมที่เปิดโหมดทดลองให้เล่น",
  },
  {
    q: "RIEL38 รวมค่ายเกมอะไรไว้บ้าง",
    a: "มีผู้ให้บริการสล็อตกว่า 30 ค่ายอยู่ในระบบเดียว ทั้งค่ายที่คนไทยคุ้นชื่ออย่าง PG Soft, Pragmatic Play, JILI และ Joker Gaming ไปจนถึงผู้ให้บริการระดับสากลรายอื่นตามที่เปิดให้บริการอยู่",
  },
  {
    q: "Smart Wallet ของ RIEL38 ทำงานยังไง",
    a: "เป็นศูนย์กลางของเครดิตในระบบสมาชิก เลือกเกมจากหลายค่ายได้โดยยังจัดการยอดผ่านบัญชีหลักจุดเดียว ไม่ต้องมีหน้ากระเป๋าเงินหลายชุดให้จำ และไม่ต้องโยกเครดิตเองก่อนเปลี่ยนค่าย",
  },
  {
    q: "ระบบ AI หลังบ้านของ เรียล38 ช่วยอะไรได้บ้าง",
    a: "ใช้ข้อมูลที่ระบบมีอยู่ช่วยจัดให้ดูง่ายขึ้น เช่น รวมเกมที่เล่นบ่อย เปรียบเทียบ RTP ตรวจโบนัส และเช็กประวัติการใช้งาน ไม่ได้มีหน้าที่ทำนายว่าเกมไหนจะแตกหรือรอบไหนจะจ่าย",
  },
  {
    q: "เข้าสู่ระบบ RIEL38 จากอุปกรณ์ไหนได้บ้าง",
    a: "ใช้บัญชีเดิมล็อกอินได้จากมือถือ แท็บเล็ต หรือคอมพิวเตอร์ เพื่อเปิดเกม เช็กเครดิต และดูโปรโมชั่น โดยไม่ต้องสร้างยูสใหม่ตามเครื่องที่ใช้ เปลี่ยนอุปกรณ์กลางวันแล้วเล่นต่อได้",
  },
];

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement message={announcement} />

  <ContentBoxPremium as="h1" title="RIEL38 เว็บสล็อตมาใหม่ โดดเด่นด้วยระบบ AI สำหรับเกมสล็อตยุคใหม่">
    <p class="mb-4 text-left text-base leading-relaxed">
      RIEL38 เว็บสล็อตยุคใหม่ที่ยังรักษาความสนุกของเกมสล็อตแบบดั้งเดิมไว้ครบ แต่เพิ่ม AI เข้ามาช่วยจัดการประสบการณ์ใช้งานให้สะดวกขึ้น เหมือนมีเลขาส่วนตัวประจำยูส คุณแค่เล่นและ enjoy ให้มากที่สุด
      ที่เหลือปล่อยให้เป็นหน้าที่ของมัน
    </p>

    <p class="mb-4 text-left text-base leading-relaxed">
      ระบบเชื่อมโยงกับหลังบ้านเพื่อช่วยจัดข้อมูลให้แม่นยำได้ทุกเรื่อง ไม่ว่าจะเป็นข้อมูลเกม อัตราการจ่ายตามที่ค่ายตั้งไว้ จำนวนเงินฝากถอน โบนัสสมาชิก และความรวดเร็วของระบบ เรียลตามชื่อ เรียล38
    </p>

    <p class="text-left text-base leading-relaxed">
      ที่นี่มีเกมให้เลือกกว่า 2,000 เกม จากกว่า 30 ค่ายสล็อตชั้นนำที่ได้รับความนิยม เลือกได้อิสระ โยกย้ายเงินเล่นแบบไม่เสียจังหวะเพราะมี Smart Wallet ทางเข้า RIEL38 เว็บตรงแสนง่าย
      เข้าสู่ระบบรองรับการใช้งานทุกอุปกรณ์
    </p>
  </ContentBoxPremium>

  <ContentBoxSevenThreePremium as="h2" title="เรียล38 เว็บสล็อตมาใหม่ รวมกว่า 2,000 เกม ทดลองเล่นฟรีก่อนเปิดยูสจริง">
    <Picture
      slot="left"
      src={imgGameLobby}
      alt={gameLobbyAlt}
      loading="lazy"
      fetchpriority="low"
      widths={[240, 340, 480, 680]}
      sizes="(max-width: 767px) calc(100vw - 96px), 340px"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      class="mx-auto h-auto w-full rounded-2xl border border-[#f9a8d4] shadow-[0_10px_30px_rgba(236,72,153,0.20)]"
    />

    <div slot="right" class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed">
        RIEL38 เป็นเว็บสล็อตมาใหม่ที่รวมเกมจากหลายค่ายไว้มากกว่า 2,000 เกม มีทั้งเกมยอดนิยม เกมใหม่ ฟรีสปิน และสล็อตหลายสไตล์ให้เลือกจากบัญชีเดียว
        คนที่ยังไม่รู้ว่าจะเริ่มเกมไหนสามารถใช้โหมดทดลองเล่นฟรีเพื่อดูรูปแบบเกมก่อนลงเงินจริง
      </p>

      <p class="text-left text-base leading-relaxed">
        ข้อดีของการมีเกมหลายแบบไม่ใช่แค่ตัวเลขเยอะ แต่คือสมาชิก เรียล38 สามารถสลับค่าย เปลี่ยนธีม หรือหาเกมตามฟีเจอร์ที่ต้องการได้สะดวกกว่า วันนี้อยากเล่นเกมไว พรุ่งนี้อยากนั่งรอโบนัสดี ๆ
        ก็ไม่ต้องเปลี่ยนเว็บตามอารมณ์
      </p>

      <p class="text-left text-base leading-relaxed">เครดิตในโหมดทดลองเล่นเป็นเครดิตจำลอง ถอนไม่ได้และไม่นับเป็นยอดเทิร์น และไม่ใช่ทุกเกมที่เปิดโหมดทดลองให้เล่น</p>

      <div class="rounded-2xl border border-[#fbcfe8] bg-[#fdf2f8] p-5">
        <p class="mb-3 flex items-center gap-2 text-sm font-black tracking-widest text-[#9d174d] uppercase">
          <span aria-hidden="true">🧪</span> Remark การทดสอบใช้งานฟรี
        </p>

        <dl class="flex flex-col gap-2 text-left text-base leading-relaxed">
          {
            freeTrialRemark.map((row) => (
              <div class="flex flex-col gap-0.5 sm:flex-row sm:gap-3">
                <dt class="shrink-0 font-bold text-[#9d174d] sm:w-52">{row.label}</dt>
                <dd class="text-[#5b2140]">{row.value}</dd>
              </div>
            ))
          }
        </dl>
      </div>

      <a
        href="/ทดลองเล่น"
        class="inline-flex w-fit items-center gap-2 rounded-full bg-gradient-to-r from-[#f472b6] via-[#ec4899] to-[#a855f7] px-7 py-3 text-sm font-black tracking-widest text-white uppercase shadow-[0_10px_30px_rgba(236,72,153,0.28)] transition-transform duration-300 hover:scale-105">
        <span aria-hidden="true">🕹️</span> เปิดโหมดทดลองเล่นฟรี
      </a>
    </div>
  </ContentBoxSevenThreePremium>

  <GameRankingBoard />

  <ContentBoxTwo as="h2" title="กว่า 30 ค่ายเกมดังบน RIEL38 มีอะไรให้สายสล็อตเลือกบ้าง">
    <div slot="left" class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed">
        รวมผู้ให้บริการสล็อตกว่า 30 ค่ายเจ้าดัง ตั้งแต่ค่ายที่คนไทยคุ้นชื่อ ไปจนถึงผู้ให้บริการเกมระดับสากล ไว้ในระบบเดียว โดยสามารถพบเกมจากค่ายที่นักเล่นสล็อตรู้จักกันดี เช่น PG Soft, Pragmatic Play,
        JILI, Joker Gaming และค่ายอื่น ๆ อีกหลายรายการตามที่เปิดให้บริการในระบบ
      </p>

      <p class="text-left text-base leading-relaxed">
        แต่ละค่ายมีบุคลิกต่างกัน บางค่ายเด่นเรื่องฟรีสปิน บางค่ายเกมเดินเร็ว บางค่ายเน้นฟีเจอร์และตัวคูณ การมีหลายค่ายใน เรียล38 จึงช่วยให้คนเล่นเลือกตามสไตล์ตัวเองได้มากกว่าวิ่งตามคำว่า “เกมแตก”
        อย่างเดียว
      </p>
    </div>

    <FeatureHighlights slot="right" items={providerStyles} />
  </ContentBoxTwo>

  <ProviderGrid />

  <ContentBoxSevenThree as="h2" titleright="Smart Wallet ระบบนี้ของ RIEL38 ช่วยจัดการเครดิตหลายค่ายยังไง">
    <Picture
      slot="left"
      src={imgSmartWallet}
      alt={smartWalletAlt}
      loading="lazy"
      fetchpriority="low"
      widths={[260, 390, 520, 780]}
      sizes="(max-width: 767px) calc(100vw - 96px), 386px"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      class="mx-auto h-auto w-full rounded-2xl border border-[#f9a8d4] shadow-[0_10px_30px_rgba(236,72,153,0.20)]"
    />

    <div slot="right" class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed">
        Smart Wallet RIEL38 ใช้เป็นศูนย์กลางของเครดิตในระบบสมาชิก ทำให้สมาชิกสามารถเลือกเกมจากหลายค่ายโดยยังจัดการยอดผ่านบัญชีหลักจุดเดียว ไม่ต้องมีหน้ากระเป๋าเงินหลายชุดให้จำตามจำนวนค่ายเกม
      </p>

      <p class="text-left text-base leading-relaxed">
        สำหรับสายที่เปลี่ยนเกมบ่อย จุดนี้ช่วยให้การใช้งานของ เรียล38 ต่อเนื่องขึ้น เพราะสิ่งที่ผู้เล่นอยากเปลี่ยนคือเกม ไม่ใช่ขั้นตอนจัดการเงิน ระบบ Wallet ที่ดีควรทำให้เครดิตตามเราไป
        ไม่ใช่ให้เราวิ่งตามเครดิต
      </p>
    </div>
  </ContentBoxSevenThree>

  <LatestWinners3 />

  <ContentBox as="h2" title="โปรโมชั่นดีๆ RIEL38 มีอะไรให้ สมาชิกใหม่ และ สมาชิกเดิม เลือก">
    <p class="mb-4 text-left text-base leading-relaxed">
      โปรโมชั่นดีๆ ที่อยากแนะนำของเว็บคือ โปรฝาก 39 รับรวม 69 เทิร์น 1 เท่า ถอนได้สูงสุด 300 แต่สำหรับสมาชิกทั้งใหม่และเดิม RIEL38 มีพื้นที่ให้กับพวกท่านทั้งหมด
      โดยสิทธิ์ที่เปิดใช้งานอาจแตกต่างกันตามช่วงเวลา เช่น โปรต้อนรับสมาชิกใหม่ โบนัสจากยอดฝาก กิจกรรมเครดิต หรือสิทธิ์สำหรับการใช้งานต่อเนื่อง
