---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
  label?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label } = Astro.props;

const sectionLabel = label ?? title ?? titleleft ?? titleright ?? "ข้อมูลประกอบ";
---

<section aria-label={sectionLabel} class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#16305f] bg-[#03091f] p-8 text-[#f5e7c2] shadow-[0_10px_30px_rgba(247,208,70,0.16)] transition-all duration-500 hover:border-[#f7d046]/55 hover:shadow-[0_15px_40px_rgba(247,208,70,0.28)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 bg-gradient-to-br from-[#071230] to-transparent"></div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#16305f] pb-4">
          <span aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#f7d046] via-[#c99a17] to-[#e12b27] shadow-[0_0_10px_rgba(247,208,70,0.45)]" />
          <HeadingTag class="bg-gradient-to-r from-[#ffeeb8] via-[#ffd95e] to-[#ff9a7a] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-10 md:grid-cols-2">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f5e7c2]">
        {
          titleleft && (
            <p class="flex items-center gap-3 border-b border-[#16305f] pb-3 text-xl leading-normal font-black tracking-widest text-[#ffe38a] uppercase">
              <span aria-hidden="true" class="h-6 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#f7d046] to-[#c99a17] shadow-[0_0_10px_rgba(247,208,70,0.45)]" />
              {titleleft}
            </p>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f5e7c2] md:border-l md:border-[#16305f] md:pl-10">
        {
          titleright && (
            <p class="flex items-center gap-3 border-b border-[#16305f] pb-3 text-xl leading-normal font-black tracking-widest text-[#ff9a7a] uppercase">
              <span aria-hidden="true" class="h-6 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#e12b27] to-[#63120a] shadow-[0_0_10px_rgba(225,43,39,0.45)]" />
              {titleright}
            </p>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
