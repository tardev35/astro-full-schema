---
export interface FeatureItem {
  icon: string;
  title: string;
  description: string;
  accent?: "gold" | "jade";
}

export interface Props {
  items: FeatureItem[];
  as?: "h3" | "h4" | "p";
}

const { items, as: HeadingTag = "h3" } = Astro.props;
---

<div class="mt-4 flex flex-col gap-5">
  {
    items.map((item) => {
      const isGold = item.accent !== "jade";
      return (
        <div
          class={`group flex flex-col items-start gap-4 rounded-2xl border border-[#064c39] bg-[#0f241d]/70 p-6 transition-all duration-300 hover:-translate-y-1 sm:flex-row ${
            isGold
              ? "hover:border-[#e8b52c]/55 hover:bg-[#123128] hover:shadow-[0_10px_20px_rgba(232,181,44,0.18)]"
              : "hover:border-[#4ff0bb]/60 hover:bg-[#123128] hover:shadow-[0_10px_20px_rgba(18,196,143,0.22)]"
          }`}>
          <div
            aria-hidden="true"
            class={`flex h-14 w-14 shrink-0 items-center justify-center rounded-xl text-3xl transition-transform duration-300 group-hover:scale-110 ${
              isGold
                ? "border border-[#ffdd8a]/50 bg-gradient-to-br from-[#e8b52c] to-[#8a6314] shadow-[0_0_15px_rgba(232,181,44,0.45)] group-hover:rotate-3"
                : "border border-[#4ff0bb]/50 bg-gradient-to-br from-[#4ff0bb] via-[#12c48f] to-[#0a8f68] shadow-[0_0_15px_rgba(18,196,143,0.45)]"
            }`}>
            {item.icon}
          </div>
          <div class="flex flex-col gap-2 text-left">
            <HeadingTag
              class={`text-xl leading-normal font-black tracking-wide drop-shadow-sm ${
                isGold ? "bg-gradient-to-r from-[#ffdd8a] to-[#e8b52c] bg-clip-text text-transparent" : "bg-gradient-to-r from-[#4ff0bb] to-[#12c48f] bg-clip-text text-transparent"
              }`}>
              {item.title}
            </HeadingTag>
            <p class="text-left text-base leading-relaxed text-[#dfeee6] transition-colors group-hover:text-[#f8ecc9]">{item.description}</p>
          </div>
        </div>
      );
    })
  }
</div>
