---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import AnnouncementPremium from "../components/AnnouncementPremium.astro";
import { pageGraph } from "../lib/schema";

const pageTitle = "เกี่ยวกับเรา GODDUBAI สล็อตเว็บตรงระดับสุลต่าน ไม่ผ่านเอเย่นต์";

const pageDescription =
  "เกี่ยวกับเรา GODDUBAI สล็อตเว็บตรงระดับสุลต่าน เชื่อม API แท้จากค่ายใหญ่ ไม่ผ่านเอเย่นต์ ฐานทุนหนา จ่ายยอดถอนใหญ่ไม่รอรอบบิล ไม่มีขั้นต่ำ ออโต้ 1-3 วินาที";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <AnnouncementPremium />

  <ContentBox as="h1" title={pageTitle}>
    <p class="mb-4 text-left text-base leading-relaxed text-[#f1e6d3]">
      GODDUBAI เกิดขึ้นจากความตั้งใจข้อเดียวคือยกระดับมาตรฐานวงการเดิมพันให้หรูหราและมั่งคั่งสมชื่อ เราไม่ได้อยากเป็นเว็บที่มีทุกอย่างแล้วไม่ดีสักอย่าง
      แต่อยากให้ทุกครั้งที่คุณเปิดเข้ามา รู้สึกเหมือนกำลังเดินเข้าคาสิโนส่วนตัวระดับ VIP ที่มีคนดูแลอยู่จริง ระบบเสถียร ภาพคมชัด และทุกปุ่มทำงานอย่างที่ควรจะเป็น
      คุณภาพระดับพรีเมียมแบบนี้จะสัมผัสได้ตั้งแต่วินาทีแรกที่สมัคร ไม่ต้องรอให้ถอนเงินก้อนแรกออกไปก่อนถึงจะเชื่อ
    </p>

    <p class="text-left text-base leading-relaxed text-[#f1e6d3]">
      หน้านี้ทำหน้าที่เป็นหน้าข้อมูลและแนะนำ อธิบายว่าเราเป็นใคร ยึดมาตรฐานอะไร และอะไรคือสิ่งที่เราทำต่างจากเว็บทั่วไปในตลาด
      เราเขียนไว้ให้อ่านแล้วนำไปตรวจสอบต่อได้จริง ไม่ใช่ถ้อยคำโฆษณาลอย ๆ เพราะเรื่องเงินไม่ควรวัดกันที่ว่าใครพูดเก่งกว่า
      แต่ควรวัดกันที่ว่าใครทำได้จริงตามที่พูด และเปิดให้ตรวจสอบได้ทุกขั้นตอน
    </p>
  </ContentBox>

  <ContentBox as="h2" title="เว็บเจ้ามือสายป่านยาว จ่ายยอดถอนใหญ่โดยไม่ต้องรอรอบบิล">
    <p class="mb-4 text-left text-base leading-relaxed text-[#f1e6d3]">
      เจ้ามือบางเว็บต้องใช้ลูกไม้ตุกติกกับผู้เล่น ไม่ใช่เพราะอยากโกงตั้งแต่แรก แต่เพราะเงินหมุนไม่ถึง พอมีคนถอนก้อนใหญ่พร้อมกันหลายรายก็เริ่มถ่วงเวลาและตั้งเงื่อนไขเพิ่ม
      GODDUBAI ไม่จำเป็นต้องทำแบบนั้นเลย เพราะฐานทุนของเราหนาพอจะรองรับยอดถอนหลักล้านต่อวัน ความแตกต่างของเราคือสายป่านที่ยาวเหยียดและสภาพคล่องทางการเงินที่สูงมาก
    </p>

    <p class="text-left text-base leading-relaxed text-[#f1e6d3]">
      สายป่านที่ยาวแปลว่าเรากล้าแจกโปรโมชั่นได้จริงโดยไม่ต้องแอบไปหักคืนทางอื่น และกล้าจ่ายยอดถอนใหญ่ทันทีโดยไม่ต้องรอรอบบิลหรือรอเงินเข้าจากที่อื่นก่อน
      ความมั่นคงลักษณะนี้คือสิ่งที่หาไม่ได้จากเว็บเล็ก ๆ ทั่วไป และเป็นเหตุผลเดียวที่ทำให้เว็บหนึ่งกล้าแฟร์กับผู้เล่นได้ตลอดทั้งปี ไม่ใช่แฟร์เฉพาะตอนที่ยอดยังไม่หนัก
    </p>
  </ContentBox>

  <ContentBox as="h2" title="มาตรฐานดูไบของแท้ 100% เชื่อม API ตรงจากค่ายเกมยักษ์ใหญ่">
    <p class="mb-4 text-left text-base leading-relaxed text-[#f1e6d3]">
      GODDUBAI ยึดมั่นในคุณภาพสูงสุด เรานำเข้าระบบ API แท้แบบ Direct API จากค่ายเกมยักษ์ใหญ่ทั่วโลก ผลลัพธ์ของทุกการสปินถูกส่งตรงมาแสดงบนหน้าจอคุณโดยไม่ผ่านเอเย่นต์
      ไม่ผ่านนายหน้า และไม่ผ่านคนกลางชั้นใดทั้งสิ้น ความเสถียรของเว็บสล็อต GODDUBAI จึงเปรียบเหมือนถนนไฮเวย์ในดูไบที่เรียบกริบ ไม่มีสะดุด ไม่มีกระตุก แม้ในชั่วโมงที่คนเล่นหนาแน่นที่สุด
    </p>

    <p class="text-left text-base leading-relaxed text-[#f1e6d3]">
      เรื่องที่สำคัญยิ่งกว่าความเร็วคือความยุติธรรม เราไม่มีการปรับแต่งค่าใด ๆ หลังบ้าน ทุกเกมใช้ค่า RTP ตามมาตรฐานสากลที่ค่ายผู้พัฒนากำหนดมา ไม่แต่ง ไม่ปรับ ไม่ลด
      เมื่อระบบตรงไปตรงมา อัตราจ่ายก็ไหลตามธรรมชาติของเกมนั้นจริง ๆ คุณจึงมั่นใจได้ว่าทุกการสปินคือโอกาสรับโชคใหญ่ที่ขาวสะอาดและตรวจสอบได้ วัดกันที่ดวงและจังหวะล้วน ๆ
    </p>
  </ContentBox>

  <ContentBox as="h2" title="ฝากถอนไม่มีขั้นต่ำ เริ่มที่ 1 บาท ด้วยระบบออโต้ 1-3 วินาที">
    <p class="mb-4 text-left text-base leading-relaxed text-[#f1e6d3]">
      แม้ภาพลักษณ์ของเราจะดูหรูหรา แต่เราเปิดกว้างให้ทุกคนเข้าถึงได้โดยไม่แบ่งชนชั้น ที่ GODDUBAI คุณทำธุรกรรมได้แบบไม่มีขั้นต่ำ มีเงินติดบัญชีแค่ 1 บาทก็ฝากเข้ามาเริ่มเล่นได้
      เพราะคำว่าดวงไม่ได้เลือกข้างคนรวยเสมอไป คนทุนน้อยก็มีสิทธิ์เป็นเศรษฐีได้ที่นี่ ถอนเท่าไหร่ก็ถอนได้เต็มจำนวน ไม่มีหัก ไม่มีค่าบริการแอบแฝง
      คุณบริหารเงินหน้าตักได้อย่างอิสระ 100% อยากฝากเท่าไหร่ อยากถอนตอนไหน จัดการเองได้ทั้งหมด ไม่มีเงื่อนไขผูกมัดให้ปวดหัว
    </p>

    <p class="text-left text-base leading-relaxed text-[#f1e6d3]">
      สำหรับคนที่เวลาเป็นเงินเป็นทอง เราใช้เทคโนโลยีฝากถอน Auto High-Speed เวอร์ชันล่าสุด ที่ประมวลผลยอดเงินของคุณเฉลี่ยเพียง 1-3 วินาที ทั้งขาฝากและขาถอน
      ไม่ว่าจะใช้บัญชีธนาคารชั้นนำหรือ True Money Wallet ระบบของเราก็รองรับครบถ้วน ทำรายการได้ตลอด 24 ชั่วโมงโดยไม่ต้องส่งสลิปให้แอดมินตรวจ
      เงินเข้าปุ๊บเล่นต่อได้ปั๊บ เพราะความต่อเนื่องคือหัวใจสำคัญของการทำกำไร และเราไม่ยอมให้คุณเสียจังหวะ
    </p>
  </ContentBox>

  <ContentBox as="h2" title="สมัครง่าย ใช้ข้อมูลเท่าที่จำเป็น ปลอดภัยระดับ VIP">
    <p class="mb-4 text-left text-base leading-relaxed text-[#f1e6d3]">
      ขั้นตอนสมัครถูกทำให้เรียบง่ายที่สุด กรอกข้อมูลแค่เท่าที่จำเป็นต่อการยืนยันตัวตนและการโอนเงินเท่านั้น ไม่มีการขอข้อมูลแปลก ๆ หรือสิ่งที่ทำให้ผู้เล่นรู้สึกล้ำเส้น
      ข้อมูลทุกอย่างถูกเข้ารหัสตามมาตรฐานเดียวกับแอปธนาคาร เราไม่ขายข้อมูล ไม่มี SMS ขยะ และไม่มีการโทรรบกวนใด ๆ สมัครเสร็จพร้อมเข้าเล่นได้ทันทีภายในไม่ถึง 10 วินาที
    </p>

    <p class="text-left text-base leading-relaxed text-[#f1e6d3]">
      มีอีกสองสามข้อที่อยากให้ช่วยกันดูแล เพราะความปลอดภัยเป็นเรื่องที่ต้องทำจากทั้งสองฝั่ง ชื่อบัญชีธนาคารควรตรงกับชื่อผู้สมัคร และเบอร์โทรควรรับข้อความได้จริง
      เพราะระบบจะเร็วแค่ไหนก็ไม่มีประโยชน์ ถ้ากรอกชื่อบัญชีคลาดเคลื่อนตั้งแต่แรกแล้วต้องมาตามแก้ทีหลัง ก่อนล็อกอินทุกครั้งควรตรวจชื่อเว็บไซต์และการเชื่อมต่อแบบ HTTPS ให้ถูกต้อง
      และไม่ควรส่งรหัสผ่านหรือรหัส OTP ให้บุคคลอื่นไม่ว่ากรณีใด ทีมงานตัวจริงไม่มีความจำเป็นต้องขอสองสิ่งนี้
    </p>
  </ContentBox>

  <Navfoot />
</MainLayout>
