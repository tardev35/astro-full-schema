---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement2.astro";
import { pageGraph } from "../lib/schema";

const pageDescription =
  "หน้าเข้าสู่ระบบ WINNOW168 เว็บตรงรวมบาคาร่า สล็อต คาสิโนสด และกีฬา กดปุ่มเดียวไปยังหน้าล็อกอินของเว็บหลัก เล่นผ่านมือถือได้ทุกอุปกรณ์ ฝากถอนออโต้ 24 ชั่วโมง";

const graph = pageGraph(Astro, {
  name: "เข้าสู่ระบบ WINNOW168 เว็บหลัก",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เข้าสู่ระบบ", path: "/login" },
  ],
});

const targetUrl = "https://yoalink.com/22hs";
---

<MainLayout title="เข้าสู่ระบบ WINNOW168 | ล็อกอินเว็บหลัก รองรับทุกอุปกรณ์" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="เข้าสู่ระบบ WINNOW168" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        aria-label="เข้าระบบเกม"
        class="group relative mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#f5c542]/60 bg-[#210a08] px-6 py-4 text-xl font-bold tracking-wide text-[#f5c542] shadow-[0_10px_30px_rgba(245,197,66,0.22)] transition-all duration-300 hover:scale-105 hover:border-[#e01e26] hover:bg-[#170707] hover:shadow-[0_15px_40px_rgba(224,30,38,0.34)]">
        เข้าระบบเกม
      </a>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
