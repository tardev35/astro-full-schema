---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#ec4899]/35 bg-[#ffffff]/92 p-8 text-[#7a1038] shadow-[0_10px_30px_rgba(190,24,93,0.12)] backdrop-blur-xl transition-all duration-500 hover:border-[#ec4899]/60 hover:shadow-[0_15px_40px_rgba(236,72,153,0.18)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 bg-gradient-to-br from-[#ffe4f0]/70 to-transparent opacity-70"></div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#f9c2d9] pb-4">
          <span aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#f7c948] via-[#f472b6] to-[#9d174d] shadow-[0_0_10px_rgba(236,72,153,0.4)]" />
          <HeadingTag class="bg-gradient-to-r from-[#ec4899] via-[#9d174d] to-[#be185d] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-10 md:grid-cols-2">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#7a1038]">
        {
          titleleft && (
            <p class="flex items-center gap-3 border-b border-[#f9c2d9] pb-3 text-xl leading-normal font-black tracking-widest text-[#9d174d] uppercase">
              <span aria-hidden="true" class="h-6 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#f7c948] via-[#f472b6] to-[#9d174d] shadow-[0_0_10px_rgba(236,72,153,0.35)]" />
              {titleleft}
            </p>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#7a1038] md:border-l md:border-[#f9c2d9] md:pl-10">
        {
          titleright && (
            <p class="flex items-center gap-3 border-b border-[#f9c2d9] pb-3 text-xl leading-normal font-black tracking-widest text-[#9d174d] uppercase">
              <span aria-hidden="true" class="h-6 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#f7c948] via-[#f472b6] to-[#9d174d] shadow-[0_0_10px_rgba(236,72,153,0.35)]" />
              {titleright}
            </p>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
