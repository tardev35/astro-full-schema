---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement6.astro";

import { Picture } from "astro:assets";

import pro1 from "../assets/slide1.png";
import pro2 from "../assets/slide2.png";
import pro3 from "../assets/slide3.png";
import pro4 from "../assets/slide4.png";
import { pageGraph } from "../lib/schema";

const pageTitle = "โปรโมชั่น TGA99 | โปรสมาชิกใหม่ ฝากถอนออโต้เริ่ม 20 บาท";

const pageHeading = "โปรโมชั่น TGA99 โปรสมาชิกใหม่ เช็กเงื่อนไขก่อนรับ";

const pageDescription =
  "โปรโมชั่น TGA99 โปรสมาชิกใหม่สำหรับคนเปิดยูสครั้งแรก เช็กเงื่อนไขยอดฝาก เทิร์น และเกมที่นับยอดก่อนรับ ฝากถอนออโต้เริ่ม 20 บาท รองรับทุกธนาคารและทรูวอเลท";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: pro1.src,
});

const promoClass =
  "mx-auto h-auto w-full rounded-xl border border-[#5a1a60] object-contain shadow-[0_10px_30px_rgba(0,0,0,0.35)] transition-all duration-300 hover:-translate-y-1 hover:border-[#8a2f8f] hover:shadow-[0_15px_40px_rgba(193,63,196,0.35)]";
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageHeading} as="h1">
    <p class="mb-4 text-left text-base leading-relaxed">
      หากคุณกำลังมองหาจุดเริ่มที่คุ้มตั้งแต่วันแรก <strong>TGA99</strong> พร้อมมอบโปรสมาชิกใหม่ให้คนเปิดยูสครั้งแรก คู่กับระบบฝากถอนออโต้ที่เริ่มได้ตั้งแต่ 20 บาท ทั้งทุกธนาคารและ TrueMoney Wallet
    </p>

    <p class="mb-8 text-left text-base leading-relaxed">
      แต่ละโปรมีเงื่อนไขของตัวเอง เช็กก่อนรับว่ามีเงื่อนไขยอดฝากไหม ต้องทำเทิร์นหรือไม่ และนับยอดจากเกมไหน ไม่แน่ใจทักแอดมินได้ตลอด 24 ชม. เพื่อวางแผนถอนได้ตั้งแต่ก่อนฝาก
    </p>

    <div class="grid w-full grid-cols-1 gap-6 sm:grid-cols-2">
      <Picture
        src={pro1}
        alt="TGA99 สมาชิกใหม่ เริ่มต้นง่าย สมัครสะดวก พร้อมสนุกได้ทันที สมัครง่าย ระบบเสถียร พร้อมดูแล ปุ่มสมัครสมาชิก"
        loading="lazy"
        fetchpriority="low"
        widths={[400, 600]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class={promoClass}
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />

      <Picture
        src={pro2}
        alt="TGA99 สนุกครบ ทุกสไตล์ รวมเกมยอดนิยมไว้ในที่เดียว เกมยอดนิยม ใช้งานสะดวก เลือกได้ครบ ปุ่มเริ่มสนุก"
        loading="lazy"
        fetchpriority="low"
        widths={[400, 600]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class={promoClass}
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />

      <Picture
        src={pro3}
        alt="TGA99 มั่นใจ ทุกการใช้งาน ระบบเสถียร ใช้งานลื่นไหล มั่นคง ทันสมัย รวดเร็ว ปุ่มสมัครเลย"
        loading="lazy"
        fetchpriority="low"
        widths={[400, 600]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class={promoClass}
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />

      <Picture
        src={pro4}
        alt="TGA99 พร้อมดูแล ทุกขั้นตอน บริการรวดเร็ว เป็นกันเอง ตอบไว ใส่ใจ พร้อมดูแล ปุ่มติดต่อเรา"
        loading="lazy"
        fetchpriority="low"
        widths={[400, 600]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class={promoClass}
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />
    </div>

    <div class="mt-12 flex justify-center pb-4">
      <a
        href="/register/"
        class="flex items-center justify-center rounded-xl bg-gradient-to-b from-[#e061e3] to-[#9c2193] px-10 py-3.5 text-lg font-black text-white shadow-[0_10px_30px_rgba(193,63,196,0.35)] transition-all hover:scale-105 hover:brightness-110 hover:shadow-[0_15px_40px_rgba(193,63,196,0.45)]">
        สมัครสมาชิก TGA99
      </a>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
