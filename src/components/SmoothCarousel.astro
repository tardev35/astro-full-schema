---
import { Picture } from "astro:assets";

import slide1 from "../assets/slide1.png";
import slide2 from "../assets/slide2.png";

const images = [
  {
    src: slide1,
    alt: "โปรโมชั่น GODKINGKONG ข้อความสีขาวว่า แนะนำเพื่อน รับโบนัส และตัวเลข 0.8% ขนาดใหญ่ขอบสีเขียวนีออนบนแผ่นป้ายสีดำ ใต้ลงมาเขียนว่า สร้างรายได้ 100,000 ต่อเดือน มุมซ้ายบนเป็นโลโก้ godking kong รูปหัวกอริลลาสวมมงกุฎทอง ด้านขวาเป็นพรีเซนเตอร์หญิงชุดเลื่อมสีทอง ฉากหลังเป็นป่าสีเขียวนีออนและเหรียญทองปลิว",
  },
  {
    src: slide2,
    alt: "โปรโมชั่น GODKINGKONG คำว่า COMMISSION สีขาว ใต้ลงมาเขียนว่า คืนทุกยอดเล่นตลอดทั้งวัน และตัวเลข 0.3% สีเขียวนีออนขนาดใหญ่บนแผ่นป้ายสีดำ ถัดลงมาเขียนว่า เล่นถึง 50% ถอนได้เลย รับสิทธิ์ก่อน 23.59 น. ของทุกวัน และ ยิ่งเล่นเยอะ ยิ่งได้เยอะ ด้านบนเป็นโลโก้ godking kong รูปหัวกอริลลาสวมมงกุฎทอง ด้านซ้ายเป็นพรีเซนเตอร์หญิงถือไพ่สี่ใบ ฉากหลังเป็นป่าสีเขียวนีออน",
  },
];

const COPIES = 3;
const slides = Array.from({ length: COPIES }, () => images).flat();
---

<div class="marquee mx-auto w-full max-w-3xl overflow-hidden px-4 py-5">
  <input id="carousel-pause" type="checkbox" class="peer sr-only" />
  <label
    for="carousel-pause"
    class="sr-only cursor-pointer peer-focus-visible:not-sr-only peer-focus-visible:mb-3 peer-focus-visible:inline-block peer-focus-visible:rounded-full peer-focus-visible:border peer-focus-visible:border-[#2fe35f]/60 peer-focus-visible:px-4 peer-focus-visible:py-2 peer-focus-visible:text-sm peer-focus-visible:font-bold peer-focus-visible:text-[#7bff9f]">
    หยุด / เล่นสไลด์ภาพ
  </label>

  <div class="marquee-track flex">
    {
      slides.map((slide, index) => {
        const isDuplicate = index >= images.length;
        return (
          <div class="marquee-slide" aria-hidden={isDuplicate ? "true" : undefined}>
            <Picture
              src={slide.src}
              alt={isDuplicate ? "" : slide.alt}
              class="block w-full rounded-xl border border-[#2fe35f]/25 object-cover shadow-[0_10px_30px_rgba(47,227,95,0.18)]"
              width={slide.src.width}
              height={slide.src.height}
              loading="lazy"
              fetchpriority="low"
              decoding="async"
              widths={[300, 360, 540, 720]}
              sizes="(max-width: 767px) calc(100vw - 32px), 360px"
              formats={["avif", "webp"]}
              fallbackFormat="webp"
              quality={60}
            />
          </div>
        );
      })
    }
  </div>
</div>

<style>
  .marquee {
    --gap: 12px;
    --per-view: 1;
    --shift: calc(-200% - 24px);
  }

  @media (min-width: 768px) {
    .marquee {
      --gap: 16px;
      --per-view: 2;
      --shift: calc(-100% - 16px);
    }
  }

  .marquee-track {
    gap: var(--gap);
    width: 100%;
    animation: carousel-scroll 24s linear infinite;
    will-change: transform;
  }

  .marquee-slide {
    flex: 0 0 calc((100% - (var(--per-view) - 1) * var(--gap)) / var(--per-view));
  }

  @keyframes carousel-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(var(--shift));
    }
  }

  .marquee:hover .marquee-track,
  .marquee:focus-within .marquee-track,
  .marquee > input:checked ~ .marquee-track {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
    }
  }
</style>
