---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-xl sm:text-2xl md:text-3xl" : "text-lg sm:text-xl md:text-2xl";
---

<section class="my-10 flex w-full justify-center px-4 font-sans">
  <div
    class="relative isolate w-full max-w-[1400px] rounded-2xl border-2 border-[#21d4f2]/30 bg-gradient-to-b from-[#062a4f]/95 to-[#031324]/95 p-8 pt-36 text-left text-base leading-relaxed text-[#dbeefb] shadow-[0_10px_30px_rgba(33,212,242,0.20)] md:pt-32">
    <div aria-hidden="true" class="pointer-events-none absolute -top-16 -right-10 -z-10 h-40 w-40 rounded-full bg-[#21d4f2]/25 blur-[60px]"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -bottom-16 -left-10 -z-10 h-40 w-40 rounded-full bg-[#b06f00]/45 blur-[60px]"></div>

    {
      title && (
        <div class="absolute -top-6 left-1/2 flex w-[92%] max-w-2xl -translate-x-1/2 items-center justify-center gap-2 rounded-lg border-2 border-[#fdb524]/40 bg-[#04182f] px-4 py-2.5 text-center shadow-[0_10px_30px_rgba(253,181,36,0.26)] sm:px-8">
          <span aria-hidden="true" class="shrink-0 text-[#7fe6ff]">
            ✦
          </span>
          <HeadingTag class={`min-w-0 bg-gradient-to-r from-[#ffe999] via-[#fdb524] to-[#7fe6ff] bg-clip-text ${headingSize} leading-normal font-black tracking-tight text-transparent uppercase`}>
            {title}
          </HeadingTag>
          <span aria-hidden="true" class="shrink-0 text-[#7fe6ff]">
            ✦
          </span>
        </div>
      )
    }

    <slot />
  </div>
</section>
