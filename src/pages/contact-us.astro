---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxHuay.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementHuay.astro";

import { Picture } from "astro:assets";
import imgLine from "../assets/contact-line.webp";

const currentPath = Astro.url.pathname;
const homePage = Astro.url.origin;
const logoUrl = homePage + "/logo.webp";

const contactPageSchema = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  name: "หวยรัฐบาลไทยและหวยต่างประเทศ: ครบจบในที่เดียว HUAYPUNG",
  description: "หวยเว็บตรง HUAYPUNG ที่ขึ้นตรงกับเซิร์ฟเวอร์หลักเท่านั้น ",
  url: currentPath,
  mainEntity: {
    "@type": "Organization",
    name: "HUAYPUNG",
    logo: logoUrl,
    url: homePage,
    contactPoint: [
      {
        "@type": "ContactPoint",
        contactType: "customer service",
        availableLanguage: ["Thai", "English"],
        contactOption: "TollFree",
        url: "https://tinyurl.com/linepigpg",
        description: "ติดต่อแอดมินผ่าน LINE Official",
      },
    ],
  },
};
---

<script type="application/ld+json" set:html={JSON.stringify(contactPageSchema)} />
<MainLayout title="ติดต่อ HUAYPUNG" ,description="หวยเว็บตรง HUAYPUNG ที่ขึ้นตรงกับเซิร์ฟเวอร์หลักเท่านั้น ">
  <Announcement />

  <ContentBox>
    <h1 class="mb-8 text-3xl text-amber-400">หวยรัฐบาลไทยและหวยต่างประเทศ: ครบจบในที่เดียว HUAYPUNG</h1>
    <Picture
      src={imgLine}
      alt="HUAYPUNG"
      loading="lazy"
      fetchpriority="low"
      widths={[200, 400, 600]}
      sizes="(max-width: 768px) 100vw"
      class="mx-auto h-auto w-full max-w-[400px] object-contain shadow-xl"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={60}
    />
    <p class="my-5 mb-8 text-gray-200">ติดต่อทีมงาน ดูแลตลอด 24 ชม. พร้อมช่วยทุกขั้นตอน ติดต่อทีมงาน ดูแลตลอด 24 ชม. พร้อมช่วยทุกขั้นตอน</p>
    <div class="flex flex-wrap justify-center gap-4">
      <a
        href="/register"
        aria-label="สมัครสมาชิก"
        class="flex items-center justify-center rounded-lg border border-gray-400 bg-gradient-to-b from-gray-600 to-black px-8 py-3 font-bold text-white transition-transform hover:scale-105">
        สมัครสมาชิก
      </a>

      <a
        href="/login"
        aria-label="เข้าเล่นเกม"
        class="flex items-center justify-center rounded-lg border border-yellow-600 bg-gradient-to-b from-yellow-200 to-yellow-500 px-8 py-3 font-extrabold text-black shadow-[0_0_15px_rgba(255,215,0,0.4)] transition-transform hover:scale-105">
        เข้าเล่นเกม
      </a>

      <a
        href="/line"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="ติดต่อเราผ่าน Line"
        class="flex items-center justify-center rounded-lg border border-green-300 bg-gradient-to-b from-green-400 to-green-700 px-8 py-3 font-bold text-white transition-transform hover:scale-105">
        ติดต่อเรา
      </a>
    </div>
  </ContentBox>
  <Navfoot />
</MainLayout>
