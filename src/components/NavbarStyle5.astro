---
import { Picture } from "astro:assets";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });

const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

const currentPath = Astro.url.pathname;

const isActive = (path: string) => {
  if (path === "/") return currentPath === "/";
  return currentPath.startsWith(path);
};
---

<header class="sticky top-0 z-50 w-full font-sans shadow-[0_4px_20px_rgba(0,0,0,0.8)]">
  <div class="hidden items-center justify-between border-b border-red-900/50 bg-[#110000] px-6 py-1.5 text-xs font-medium tracking-wide lg:flex xl:px-10">
    <div class="flex items-center gap-2 text-white/80">
      <span class="text-sm text-yellow-400">✦</span>
      ยินดีต้อนรับสู่เว็บสล็อตออโต้ที่ดีที่สุด ฝาก-ถอน รวดเร็ว 24 ชม.
    </div>
    <div class="flex items-center gap-5">
      <a href="/login" class="flex items-center gap-1 text-white/80 transition-colors hover:text-yellow-400">🔒 เข้าสู่ระบบ</a>
      <a href="/register" class="flex items-center gap-1 font-bold text-yellow-400 drop-shadow-[0_0_5px_rgba(250,204,21,0.5)] transition-colors hover:text-yellow-300">
        🔥 สมัครสมาชิกใหม่รับโบนัส 100%
      </a>
    </div>
  </div>

  <nav class="relative z-[70] flex h-[70px] w-full items-center justify-between border-b border-red-900/40 bg-[#0a0000]/95 px-4 shadow-xl backdrop-blur-md xl:px-10">
    <a href="/" class="z-50 flex-shrink-0 transition-transform hover:scale-105">
      <Picture
        src={mainLogo!}
        alt="Main Logo"
        loading="eager"
        fetchpriority="high"
        class="h-[35px] w-auto drop-shadow-[0_0_10px_rgba(250,204,21,0.3)] xl:h-[40px]"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
      />
    </a>

    <div class="hidden h-full items-center gap-6 lg:flex xl:gap-10">
      <a
        href="/"
        class={`group relative h-full flex items-center text-sm xl:text-base font-bold transition-colors ${isActive("/") ? "text-yellow-400 drop-shadow-[0_0_8px_rgba(250,204,21,0.5)]" : "text-white/80 hover:text-yellow-400"}`}>
        <span>หน้าแรก</span>
        <div
          class={`absolute bottom-[-1px] left-0 w-full h-[3px] bg-gradient-to-r from-yellow-500 to-yellow-300 transition-transform duration-300 origin-left ${isActive("/") ? "scale-x-100" : "scale-x-0 group-hover:scale-x-100"}`}>
        </div>
      </a>

      <a
        href="/promotion"
        class={`group relative h-full flex items-center text-sm xl:text-base font-bold transition-colors ${isActive("/promotion") ? "text-yellow-400 drop-shadow-[0_0_8px_rgba(250,204,21,0.5)]" : "text-white/80 hover:text-yellow-400"}`}>
        <span>โปรโมชั่น</span>
        <div
          class={`absolute bottom-[-1px] left-0 w-full h-[3px] bg-gradient-to-r from-yellow-500 to-yellow-300 transition-transform duration-300 origin-left ${isActive("/promotion") ? "scale-x-100" : "scale-x-0 group-hover:scale-x-100"}`}>
        </div>
      </a>

      <a
        href="/ทดลองเล่น"
        class={`group relative h-full flex items-center text-sm xl:text-base font-bold transition-colors ${isActive("/ทดลองเล่น") ? "text-yellow-400 drop-shadow-[0_0_8px_rgba(250,204,21,0.5)]" : "text-white/80 hover:text-yellow-400"}`}>
        <span>ทดลองเล่น</span>
        <div
          class={`absolute bottom-[-1px] left-0 w-full h-[3px] bg-gradient-to-r from-yellow-500 to-yellow-300 transition-transform duration-300 origin-left ${isActive("/ทดลองเล่น") ? "scale-x-100" : "scale-x-0 group-hover:scale-x-100"}`}>
        </div>
      </a>

      <a
        href="/ทางเข้า"
        class={`group relative h-full flex items-center text-sm xl:text-base font-bold transition-colors ${isActive("/ทางเข้า") ? "text-yellow-400 drop-shadow-[0_0_8px_rgba(250,204,21,0.5)]" : "text-white/80 hover:text-yellow-400"}`}>
        <span>ทางเข้า</span>
        <div
          class={`absolute bottom-[-1px] left-0 w-full h-[3px] bg-gradient-to-r from-yellow-500 to-yellow-300 transition-transform duration-300 origin-left ${isActive("/ทางเข้า") ? "scale-x-100" : "scale-x-0 group-hover:scale-x-100"}`}>
        </div>
      </a>

      <a
        href="/contact-us"
        class={`group relative h-full flex items-center text-sm xl:text-base font-bold transition-colors ${isActive("/contact-us") ? "text-yellow-400 drop-shadow-[0_0_8px_rgba(250,204,21,0.5)]" : "text-white/80 hover:text-yellow-400"}`}>
        <span>ติดต่อเรา</span>
        <div
          class={`absolute bottom-[-1px] left-0 w-full h-[3px] bg-gradient-to-r from-yellow-500 to-yellow-300 transition-transform duration-300 origin-left ${isActive("/contact-us") ? "scale-x-100" : "scale-x-0 group-hover:scale-x-100"}`}>
        </div>
      </a>
    </div>

    <div class="z-50 flex items-center gap-4">
      <a
        href="/register"
        class="hidden items-center justify-center rounded-full bg-gradient-to-r from-yellow-500 via-yellow-400 to-yellow-600 px-6 py-2 text-sm font-extrabold text-[#110000] shadow-[0_0_15px_rgba(250,204,21,0.4)] transition-all hover:scale-105 hover:brightness-110 lg:flex">
        สมัครสมาชิก
      </a>

      <button id="hamburger-btn" class="relative flex h-[40px] w-[40px] flex-col items-end justify-center gap-[6px] p-2 lg:hidden" aria-label="Menu">
        <span class="line-1 h-[2px] w-6 origin-center rounded-full bg-yellow-400 shadow-[0_0_5px_rgba(250,204,21,0.5)] transition-all duration-300"></span>
        <span class="line-2 h-[2px] w-4 origin-center rounded-full bg-yellow-400 shadow-[0_0_5px_rgba(250,204,21,0.5)] transition-all duration-300"></span>
      </button>
    </div>
  </nav>

  <div id="fullscreen-menu" class="pointer-events-none fixed inset-0 z-[60] flex flex-col items-center justify-center bg-[#0a0000]/98 opacity-0 backdrop-blur-2xl transition-opacity duration-500">
    <div class="flex w-full flex-col items-center space-y-6 px-6">
      <a
        href="/"
        class={`fs-item text-3xl font-black uppercase tracking-widest transition-all duration-300 ${isActive("/") ? "text-yellow-400 drop-shadow-[0_0_10px_rgba(250,204,21,0.6)]" : "text-white/80 hover:text-yellow-400"}`}>
        หน้าแรก
      </a>
      <a
        href="/promotion"
        class={`fs-item text-3xl font-black uppercase tracking-widest transition-all duration-300 ${isActive("/promotion") ? "text-yellow-400 drop-shadow-[0_0_10px_rgba(250,204,21,0.6)]" : "text-white/80 hover:text-yellow-400"}`}>
        โปรโมชั่น
      </a>
      <a
        href="/ทดลองเล่น"
        class={`fs-item text-3xl font-black uppercase tracking-widest transition-all duration-300 ${isActive("/ทดลองเล่น") ? "text-yellow-400 drop-shadow-[0_0_10px_rgba(250,204,21,0.6)]" : "text-white/80 hover:text-yellow-400"}`}>
        ทดลองเล่น
      </a>
      <a
        href="/ทางเข้า"
        class={`fs-item text-3xl font-black uppercase tracking-widest transition-all duration-300 ${isActive("/ทางเข้า") ? "text-yellow-400 drop-shadow-[0_0_10px_rgba(250,204,21,0.6)]" : "text-white/80 hover:text-yellow-400"}`}>
        ทางเข้า
      </a>
      <a
        href="/contact-us"
        class={`fs-item text-3xl font-black uppercase tracking-widest transition-all duration-300 ${isActive("/contact-us") ? "text-yellow-400 drop-shadow-[0_0_10px_rgba(250,204,21,0.6)]" : "text-white/80 hover:text-yellow-400"}`}>
        ติดต่อเรา
      </a>

      <div class="fs-item mt-4 flex w-full max-w-[250px] flex-col gap-4 pt-8">
        <a
          href="/register"
          class="flex w-full items-center justify-center rounded-full bg-gradient-to-r from-yellow-500 via-yellow-400 to-yellow-600 py-3.5 text-lg font-extrabold text-[#110000] shadow-[0_0_20px_rgba(250,204,21,0.4)] hover:brightness-110">
          สมัครสมาชิก
        </a>
        <a href="/login" class="flex w-full items-center justify-center rounded-full border-2 border-yellow-500/40 py-3.5 text-lg font-bold text-yellow-400 transition-colors hover:bg-yellow-500/10">
          เข้าสู่ระบบ
        </a>
      </div>
    </div>
  </div>
</header>

<style is:global>
  nav,
  header {
    font-family: kanit, sans-serif !important;
  }

  #hamburger-btn.active .line-1 {
    transform: translateY(4px) rotate(45deg);
  }
  #hamburger-btn.active .line-2 {
    width: 24px;
    transform: translateY(-4px) rotate(-45deg);
  }

  .fs-item {
    opacity: 0;
    transform: translateY(30px) scale(0.9);
    transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .fs-item.show {
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  .fs-item:nth-child(1) {
    transition-delay: 0.1s;
  }
  .fs-item:nth-child(2) {
    transition-delay: 0.15s;
  }
  .fs-item:nth-child(3) {
    transition-delay: 0.2s;
  }
  .fs-item:nth-child(4) {
    transition-delay: 0.25s;
  }
  .fs-item:nth-child(5) {
    transition-delay: 0.3s;
  }
  .fs-item:nth-child(6) {
    transition-delay: 0.4s;
  }
</style>

<script>
  const hamburgerBtn = document.getElementById("hamburger-btn");
  const fsMenu = document.getElementById("fullscreen-menu");
  const fsItems = document.querySelectorAll(".fs-item");

  const toggleFsMenu = () => {
    hamburgerBtn?.classList.toggle("active");
    fsMenu?.classList.toggle("opacity-0");
    fsMenu?.classList.toggle("pointer-events-none");

    if (!fsMenu?.classList.contains("opacity-0")) {
      document.body.style.overflow = "hidden";
      fsItems.forEach((item) => item.classList.add("show"));
    } else {
      document.body.style.overflow = "";
      fsItems.forEach((item) => item.classList.remove("show"));
    }
  };

  hamburgerBtn?.addEventListener("click", toggleFsMenu);

  fsItems.forEach((item) => {
    item.addEventListener("click", () => {
      if (!fsMenu?.classList.contains("opacity-0")) {
        toggleFsMenu();
      }
    });
  });
</script>
