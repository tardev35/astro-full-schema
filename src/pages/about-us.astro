---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement2.astro";
import { pageGraph } from "../lib/schema";

const pageTitle = "เกี่ยวกับเรา WON22 เว็บสล็อตออนไลน์เว็บตรง ฝากถอนออโต้ ไม่ติดเทิร์น";

const pageHeading = "เกี่ยวกับเรา WON22 เว็บสล็อตออนไลน์เว็บตรง ฝากถอนออโต้ ไม่ติดเทิร์น ในยูสเดียว";

const pageDescription =
  "เกี่ยวกับเรา WON22 รวมข้อมูลเว็บสล็อตออนไลน์เว็บตรง ระบบฝากถอนออโต้จากหน้าเมมเบอร์ แนวทางไม่ติดเทิร์น การสมัครผ่านมือถือ และระบบสมาชิกที่ใช้ยูสเดียวตลอด";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox as="h1" title={pageHeading}>
    <p class="mb-4 text-left text-base leading-relaxed text-[#f8e3d2]">
      <strong class="text-[#fbbf24]">WON22</strong> เป็นเว็บสล็อตออนไลน์เว็บตรงที่รวมเกมจากหลายค่ายไว้ในยูสเดียว เข้าสู่ระบบครั้งเดียวแล้วเลือกเกม เช็กเครดิต หรือดูโปรที่เปิดอยู่ต่อได้จากหน้าเดียว
    </p>

    <p class="mb-4 text-left text-base leading-relaxed text-[#f8e3d2]">
      ระบบฝากถอนผูกอยู่กับบัญชีสมาชิก ทำรายการได้ตรงจากหน้าเมมเบอร์ และใช้ยูสเดิมได้ทั้งบนมือถือและคอมพิวเตอร์ โดยไม่ต้องเปิดบัญชีใหม่ตามเกมที่เปลี่ยนไป
    </p>

    <p class="text-left text-base leading-relaxed text-[#f8e3d2]">
      เปลี่ยนเกมกี่รอบก็ไม่ต้องเปลี่ยนบัญชีตาม ที่รวมไว้จุดเดียวจึงไม่ได้มีไว้ให้เมนูดูเยอะ แต่มีไว้ให้หาของที่ต้องใช้เจอตั้งแต่ครั้งแรก
    </p>
  </ContentBox>

  <ContentBox as="h2" title="WON22 รวมเกมสล็อตแบบไหนไว้ให้เลือกบ้าง">
    <p class="mb-4 text-left text-base leading-relaxed text-[#f8e3d2]">
      หมวดสล็อตของ WON22 มีทั้งเกมหมุนคลาสสิก เกมที่มีฟรีสปิน เกมโบนัสฟีเจอร์ และสล็อตรุ่นใหม่จากผู้ให้บริการหลายค่าย รวมอยู่ในหน้าเดียวกันทั้งหมด
    </p>

    <p class="mb-4 text-left text-base leading-relaxed text-[#f8e3d2]">
      โครงแบบนี้เหมาะทั้งกับคนที่มีเกมประจำอยู่แล้ว และคนที่ชอบเปลี่ยนเกมตามอารมณ์ อยากลองของใหม่ก็เลือกหมวดแล้วเข้าเล่นต่อจากยูสเดิมได้เลย
    </p>

    <p class="text-left text-base leading-relaxed text-[#f8e3d2]">
      เกมเยอะเป็นข้อดีก็ต่อเมื่อหาเจอ หน้าเกมจึงแยกตามค่ายและหมวดไว้ ไม่อย่างนั้นก็เหมือนมีเสื้อเต็มตู้แล้วหาตัวโปรดไม่เจอสักที
    </p>
  </ContentBox>

  <ContentBox as="h2" title="ฝากถอน WON22 ทำรายการจากหน้าเมมเบอร์อย่างไร">
    <p class="mb-4 text-left text-base leading-relaxed text-[#f8e3d2]">
      ระบบฝากถอนเชื่อมอยู่กับบัญชีสมาชิก ฝากเครดิต ถอนยอด และเช็กสถานะรายการทำได้จากจุดเดียว ไม่ต้องออกจากหน้าเว็บไปตามหลายช่องทางก่อนกลับเข้าเกม
    </p>

    <p class="mb-4 text-left text-base leading-relaxed text-[#f8e3d2]">
      ช่วงระหว่างเติมเครดิตกับเข้าเกมควรสั้นที่สุด เพราะไม่มีใครอยากเสียอารมณ์ไปกับเมนูการเงิน ระบบที่ดีทำงานของมันเงียบ ๆ แล้วปล่อยให้คนเล่นไปสนุกต่อ
    </p>

    <p class="text-left text-base leading-relaxed text-[#f8e3d2]">
      อีกเรื่องที่ควรย้ำไว้ รหัสผ่านและรหัส OTP ไม่ควรส่งต่อให้ใครไม่ว่ากรณีใด แม้แต่คนที่ทักมาแล้วอ้างตัวว่าเป็นทีมงานของเว็บ
    </p>
  </ContentBox>

  <ContentBox as="h2" title="แนวทาง ไม่ติดเทิร์น ของ WON22 หมายถึงอะไร">
    <p class="mb-4 text-left text-base leading-relaxed text-[#f8e3d2]">
      ไม่ติดเทิร์น หมายถึงเครดิตที่เข้าเงื่อนไขสามารถจัดการต่อได้ตามที่ระบบกำหนด โดยไม่ต้องนั่งปั่นยอดหลายรอบเพียงเพื่อให้ครบตัวเลขก่อนถอน
    </p>

    <p class="mb-4 text-left text-base leading-relaxed text-[#f8e3d2]">
      เงื่อนไขของแต่ละสิทธิ์ยังต้องอ่านอยู่ดี แต่ประเด็นคือควรอ่านรอบเดียวแล้วเข้าใจว่าเครดิตก้อนนั้นใช้อย่างไร ถอนอย่างไร และเหลืออยู่เท่าไร
    </p>

    <p class="text-left text-base leading-relaxed text-[#f8e3d2]">
      ยิ่งเงื่อนไขตรงไปตรงมา ยิ่งเล่นได้โดยไม่ต้องเปิดเครื่องคิดเลขวางไว้ข้าง ๆ ตลอดเวลา ตรงนี้ต่างหากที่ทำให้จัดการเครดิตได้คล่องขึ้น
    </p>
  </ContentBox>

  <ContentBox as="h2" title="สมัครสมาชิก WON22 ผ่านมือถือเริ่มต้นอย่างไร">
    <p class="mb-4 text-left text-base leading-relaxed text-[#f8e3d2]">
      การสมัครทำผ่านมือถือได้ตั้งแต่ต้นจนจบ กรอกข้อมูล เปิดบัญชี แล้วยืนยันตามขั้นตอนของระบบ จากนั้นใช้ยูสเดิมเข้าหน้าเมมเบอร์เพื่อดูเกม เครดิต และโปรที่เปิดอยู่
    </p>

    <p class="mb-4 text-left text-base leading-relaxed text-[#f8e3d2]">
      ขั้นตอนถูกวางให้จบจากเครื่องเดียว เพราะถ้าเปิดยูสแล้วยังต้องวิ่งหาโน้ตบุ๊กหรือกรอกข้อมูลซ้ำสามรอบ ก็คงเกินเรื่องไปหน่อยสำหรับปี 2026
    </p>

    <p class="text-left text-base leading-relaxed text-[#f8e3d2]">
      จำทางเข้าหลักที่ใช้ประจำไว้ จะกลับเข้าหน้าเมมเบอร์ได้เร็วขึ้น และช่วยลดความสับสนจากชื่อเว็บที่คล้ายกันบนหน้าผลค้นหา
    </p>
  </ContentBox>

  <ContentBox as="h2" title="โปรโมชั่นและระบบออโต้ของ WON22 เปิดไว้ให้ใช้ตอนไหน">
    <p class="mb-4 text-left text-base leading-relaxed text-[#f8e3d2]">
      โปรโมชั่นถูกจัดไว้ในหน้าสมาชิก ให้เลือกสิทธิ์ตามช่วงเวลาและรูปแบบการเล่น เช็กโปรที่เปิดอยู่ก่อน แล้วค่อยตัดสินใจว่าจะใช้กับเครดิตก้อนไหน
    </p>

    <p class="mb-4 text-left text-base leading-relaxed text-[#f8e3d2]">
      คนเล่นแต่ละแบบเหมาะกับโปรไม่เหมือนกัน สายหมุนยาวกับสายเล่นสั้น ๆ ใช้สิทธิ์คนละตัวได้ เลือกให้เข้ากับทุนตัวเองดีกว่ารับทุกอันเพราะเห็นคำว่าโบนัสแล้วมือไว
    </p>

    <p class="text-left text-base leading-relaxed text-[#f8e3d2]">
      ฝั่งระบบออโต้ดูแลรายการฝากถอนและอัปเดตเครดิตตลอดวัน สายดึกที่เข้าเกมหลังเที่ยงคืนจึงไม่ต้องนั่งรอคำตอบว่าแอดมินตื่นหรือยัง
    </p>
  </ContentBox>

  <ContentBox as="h2" title="WON22 เหมาะกับนักเล่นแบบไหน">
    <p class="mb-4 text-left text-base leading-relaxed text-[#f8e3d2]">
      เหมาะกับคนที่เล่นสล็อตเป็นหลัก เปลี่ยนเกมบ่อย และอยากให้เกมหลายค่าย เครดิต โปรโมชั่น กับระบบฝากถอนอยู่ในยูสเดียว โดยไม่ต้องจำหลายบัญชี
    </p>

    <p class="mb-4 text-left text-base leading-relaxed text-[#f8e3d2]">
      หน้าเมมเบอร์รวมเกม เครดิต โปร และประวัติรายการไว้จุดเดียว จึงย้อนดูได้ว่าทำรายการไหนไปแล้ว และกำลังใช้สิทธิ์โปรตัวไหนอยู่
    </p>

    <p class="text-left text-base leading-relaxed text-[#f8e3d2]">
      เปลี่ยนสล็อตได้บ่อยแต่ข้อมูลบัญชียังอยู่ที่เดิม ของสำคัญควรอยู่เป็นที่ โดยเฉพาะเครดิต เงินเราไม่ควรมีพรสวรรค์ด้านซ่อนหา
    </p>
  </ContentBox>

  <Navfoot />
</MainLayout>
