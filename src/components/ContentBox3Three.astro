---
const { titleleft, titleright, titlecenter } = Astro.props;
---

<section class="mx-auto mb-3 w-full max-w-7xl rounded-[15px] border-2 border-emerald-900/50 bg-[#050c0a]/90 p-8 px-4 text-center shadow-2xl">
  <div class="grid grid-cols-2 gap-5 md:grid-cols-3">
    <article class="flex flex-col gap-4">
      {
        titleleft && (
          <h2 class="mb-4 bg-gradient-to-b from-[#a7f3d0] to-[#10b981] bg-clip-text text-3xl font-black tracking-tight text-transparent drop-shadow-[0_0_8px_rgba(16,185,129,0.4)]">{titleleft}</h2>
        )
      }
      <div class="text-black">
        <slot name="left" />
      </div>
    </article>

    <article class="flex flex-col gap-4">
      {
        titlecenter && (
          <h2 class="mb-4 bg-gradient-to-b from-[#a7f3d0] to-[#10b981] bg-clip-text text-3xl font-black tracking-tight text-transparent drop-shadow-[0_0_8px_rgba(16,185,129,0.4)]">{titlecenter}</h2>
        )
      }
      <div class="text-black">
        <slot name="center" />
      </div>
    </article>

    <article class="flex flex-col gap-4">
      {
        titleright && (
          <h2 class="mb-4 bg-gradient-to-b from-[#a7f3d0] to-[#10b981] bg-clip-text text-3xl font-black tracking-tight text-transparent drop-shadow-[0_0_8px_rgba(16,185,129,0.4)]">{titleright}</h2>
        )
      }
      <div class="text-black">
        <slot name="right" />
      </div>
    </article>
  </div>
</section>
<style>
  .bg-red-gold-oklab {
    background-image: linear-gradient(in oklab to right, #1b8d3b, #399537, #27a544);
  }
</style>
