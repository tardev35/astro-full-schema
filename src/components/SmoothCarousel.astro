---
import { Picture } from "astro:assets";

import slide1 from "../assets/slide1.png";
import slide2 from "../assets/slide2.png";
import slide3 from "../assets/slide3.png";
import slide4 from "../assets/slide4.png";

const images = [
  {
    src: slide1,
    alt: "แบนเนอร์ WINSIAM88 คืนยอดเดิมพันทุกวัน Rolling 1% พร้อมข้อความ เล่นมาก รับคืนมาก รองรับสล็อต คาสิโนสด และกีฬา ฝากถอนออโต้ 24 ชม. ตรวจสอบสิทธิ์รับคืนได้เองผ่านระบบ และแถบท้าย WINSIAM88 คืนจริง เล่นต่อได้ลื่น",
  },
  {
    src: slide2,
    alt: "แบนเนอร์ WINSIAM88 ชวนเพื่อนมาเล่น รับ 2% ระบุว่าแนะนำเพื่อนสมัครผ่านลิงก์รับค่าคอมทันที ทุกยอดเดิมพันของเพื่อนมีสิทธิ์รับส่วนแบ่ง 2% เว็บเดียวครบทั้งสล็อต คาสิโนสด กีฬา และเกมยอดนิยม พร้อมข้อความ ยิ่งชวนมาก ยิ่งรับมาก และระบบออโต้ 24 ชม. ใช้งานง่ายบนมือถือ",
  },
  {
    src: slide3,
    alt: "แบนเนอร์ WINSIAM88 เว็บพนันระดับพรีเมียม ฝากถอนออโต้ รวดเร็ว เล่นง่าย รวมสล็อต คาสิโนสด กีฬา และเกมยอดนิยม พร้อมจุดเด่นระบบเสถียร 24 ชม. รองรับมือถือ เว็บตรงใช้งานลื่น สมัครง่ายไม่ยุ่งยาก และข้อความเริ่มเล่นได้ทันที",
  },
  {
    src: slide4,
    alt: "แบนเนอร์ WINSIAM88 โปรวงล้อ ลุ้นของรางวัลทุกวัน แสดงวงล้อรางวัลเครดิต 500 ถึง 5,000 พร้อมข้อความ ฝาก 100 ลุ้นของรางวัลพิเศษ ฝาก 1,000 รับสิทธิ์เพิ่ม เล่นง่าย ฝากไว ถอนสะดวก และเกมหลากหลายทั้งสล็อต คาสิโน และกีฬา",
  },
];

const COPIES = 3;
const slides = Array.from({ length: COPIES }, () => images).flat();
---

<div class="marquee mx-auto w-full max-w-[1301px] overflow-hidden px-4 py-5">
  <input id="carousel-pause" type="checkbox" class="peer sr-only" />
  <label
    for="carousel-pause"
    class="sr-only cursor-pointer peer-focus-visible:not-sr-only peer-focus-visible:mb-3 peer-focus-visible:inline-block peer-focus-visible:rounded-full peer-focus-visible:border peer-focus-visible:border-[#d4a017]/60 peer-focus-visible:px-4 peer-focus-visible:py-2 peer-focus-visible:text-sm peer-focus-visible:font-bold peer-focus-visible:text-[#f5cf4d]">
    หยุด / เล่นสไลด์ภาพ
  </label>

  <div class="marquee-track flex">
    {
      slides.map((slide, index) => {
        const isDuplicate = index >= images.length;
        return (
          <div class="marquee-slide" aria-hidden={isDuplicate ? "true" : undefined}>
            <Picture
              src={slide.src}
              alt={isDuplicate ? "" : slide.alt}
              class="block w-full rounded-xl border border-[#d4a017]/25 object-cover shadow-[0_10px_30px_rgba(212,160,23,0.18)]"
              width={slide.src.width}
              height={slide.src.height}
              loading={index < 2 ? "eager" : "lazy"}
              fetchpriority={index === 0 ? "high" : "auto"}
              decoding="async"
              widths={[200, 400, 600]}
              sizes="(max-width: 768px) 50vw, 33vw"
              formats={["avif", "webp"]}
              fallbackFormat="webp"
              quality={60}
            />
          </div>
        );
      })
    }
  </div>
</div>

<style>
  .marquee {
    --gap: 12px;
    --per-view: 2;
    --shift: calc(-200% - 24px);
  }

  @media (min-width: 768px) {
    .marquee {
      --gap: 16px;
      --per-view: 3;
      --shift: calc(-133.3333% - 21.3333px);
    }
  }

  .marquee-track {
    gap: var(--gap);
    width: 100%;
    animation: carousel-scroll 32s linear infinite;
    will-change: transform;
  }

  .marquee-slide {
    flex: 0 0 calc((100% - (var(--per-view) - 1) * var(--gap)) / var(--per-view));
  }

  @keyframes carousel-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(var(--shift));
    }
  }

  .marquee:hover .marquee-track,
  .marquee:focus-within .marquee-track,
  .marquee > input:checked ~ .marquee-track {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
    }
  }
</style>
