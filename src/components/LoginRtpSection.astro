---
import ContentBoxTwo from "./ContentBoxTwo.astro";
import { BRAND_NAME } from "../lib/brandProfile";

const steps = [
  {
    icon: "🎰",
    name: "สี่หมวดในทางเข้าเดียว",
    detail: "สล็อตแยกตามค่าย คาสิโนสด เกมยิงปลา และหวย กดเข้าสมัครเติมเงินแล้วแยกไปหมวดของตัวเองได้เลย",
    tag: "4 หมวด",
  },
  {
    icon: "📱",
    name: "เปิดผ่านเบราว์เซอร์ ไม่ต้องโหลดแอป",
    detail: "ใช้ได้ทั้ง iOS และ Android สมัคร ฝาก เล่น และถอนจบในมือถือเครื่องเดียว เปิดบนคอมก็ได้เหมือนกัน",
    tag: "iOS / Android",
  },
  {
    icon: "🔑",
    name: "ยูสเดิมใช้ได้ทุกเครื่อง",
    detail: "ล็อกอินด้วยยูสกับรหัสชุดเดิมจากเครื่องไหนก็ได้ ย้ายเครื่องไม่ต้องสมัครใหม่",
    tag: "ไม่ต้องสมัครซ้ำ",
  },
  {
    icon: "🎁",
    name: "โปรโมชั่นมีเงื่อนไขเทิร์น",
    detail: "ฝากรับโบนัสเพิ่ม 10% และโบนัสฝาก 50% ดูเทิร์นกับยอดถอนสูงสุดของแต่ละโปรในหน้าโปรโมชั่นก่อนรับ",
    tag: "ดูเงื่อนไขก่อน",
  },
  {
    icon: "💬",
    name: "เครดิตไม่เข้า อย่าเพิ่งโอนซ้ำ",
    detail: "แจ้งแอดมินผ่านช่องทางบนหน้าเว็บพร้อมเวลาที่โอนและยอดเงิน แอดมินจะหารายการของเราเจอง่ายขึ้น",
    tag: "ทักแอดมิน",
  },
  {
    icon: "🔒",
    name: "รหัสผ่านกับ OTP ไม่ส่งให้ใคร",
    detail: "ก่อนกรอกรหัสทุกครั้งมองชื่อเว็บบนแถบที่อยู่ให้แน่ใจว่าตรง ลิงก์ที่ส่งต่อกันในแชตมีหลายหน้าตา",
    tag: "ปลอดภัย",
  },
];
const chips = ["PG Soft", "Pragmatic Play", "JILI", "JDB", "Spadegaming", "Dream Gaming", "Pretty Gaming", "iOS และ Android"];
---

<ContentBoxTwo titleleft={`เข้าสู่ระบบ ${BRAND_NAME}`} titleright={`ระบบที่ ${BRAND_NAME} เตรียมไว้ในยูสเดียว`} label={`เข้าสู่ระบบ ${BRAND_NAME} และระบบที่ใช้ได้จากยูสเดียว`}>
  <div slot="left" class="flex h-full flex-col gap-4">
    <div class="relative overflow-hidden rounded-2xl border border-[#1a4a9c] bg-[#06204f] p-6 shadow-[0_10px_30px_rgba(0,0,0,0.35)]">
      <div class="mb-5 flex items-center gap-3">
        <span
          aria-hidden="true"
          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-gradient-to-b from-[#4da3ff] to-[#0554b8] text-xl font-black text-white italic shadow-[0_5px_15px_rgba(11,124,244,0.35)]">
          B
        </span>
        <div class="flex flex-col">
          <p class="text-base font-black text-white">ยินดีต้อนรับกลับสู่ {BRAND_NAME}</p>
          <span class="text-xs text-[#9fb8dc]">ล็อกอินด้วยยูสและรหัสเดิม เปลี่ยนเครื่องก็ไม่ต้องสมัครซ้ำ</span>
        </div>
      </div>

      <div class="flex flex-col gap-3.5">
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4">👤</span>
          <input
            type="text"
            aria-label="เบอร์โทรศัพท์หรือยูสเซอร์เนม"
            placeholder="เบอร์โทรศัพท์ / ยูสเซอร์เนม"
            class="w-full rounded-xl border border-[#1a4a9c] bg-[#0a2a66] py-3 pr-4 pl-12 text-white transition-all outline-none placeholder:text-[#9fb8dc] focus:border-[#4da3ff] focus:ring-1 focus:ring-[#4da3ff]/30"
          />
        </div>
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4">🔑</span>
          <input
            type="password"
            aria-label="รหัสผ่าน"
            placeholder="รหัสผ่าน"
            class="w-full rounded-xl border border-[#1a4a9c] bg-[#0a2a66] py-3 pr-4 pl-12 text-white transition-all outline-none placeholder:text-[#9fb8dc] focus:border-[#4da3ff] focus:ring-1 focus:ring-[#4da3ff]/30"
          />
        </div>

        <div class="flex items-center justify-between px-1 text-xs">
          <label class="flex items-center gap-2 text-[#9fb8dc]">
            <input type="checkbox" class="h-3.5 w-3.5 rounded border-[#1a4a9c] accent-[#0b7cf4]" />
            จดจำฉันไว้
          </label>
          <a href="/login/" class="text-[#9fb8dc] transition-colors hover:text-[#4da3ff]">ลืมรหัสผ่าน?</a>
        </div>

        <a
          href="/login/"
          class="mt-1 block w-full rounded-xl bg-gradient-to-b from-[#4da3ff] to-[#0554b8] p-3.5 text-center font-black text-white shadow-[0_10px_30px_rgba(11,124,244,0.45)] transition-all hover:scale-[1.02]">
          เข้าสู่ระบบ
        </a>

        <div class="flex items-center gap-3 py-1 text-xs text-[#9fb8dc]">
          <span class="h-px flex-1 bg-[#1a4a9c]"></span>
          หรือ
          <span class="h-px flex-1 bg-[#1a4a9c]"></span>
        </div>

        <a
          href="/line/"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] p-3 text-sm font-bold text-white shadow-md transition-all hover:scale-[1.02]">
          <span aria-hidden="true">💬</span> ทักไลน์ทีมงาน
        </a>

        <div class="mt-1 flex flex-wrap items-center justify-between gap-2 px-1">
          <div class="flex flex-wrap gap-2">
            <span class="rounded-full bg-[#043a80] px-2.5 py-1 text-[10px] font-bold text-white"><span aria-hidden="true">🔒</span> ไม่ส่งรหัสผ่านหรือ OTP ให้ใคร</span>
            <span class="rounded-full border border-[#1a4a9c] bg-[#0a2a66] px-2.5 py-1 text-[10px] font-bold text-[#4da3ff]"><span aria-hidden="true">📱</span> iOS และ Android</span>
          </div>
          <a href="/register/" class="text-xs font-bold text-[#ff5a60] transition-colors hover:text-white">สมัครสมาชิกใหม่</a>
        </div>
      </div>
    </div>
  </div>

  <div slot="right" class="h-full">
    <div class="flex h-full flex-col rounded-2xl border border-[#1a4a9c] bg-[#06204f] p-5 shadow-[0_10px_30px_rgba(0,0,0,0.35)]">
      <div class="mb-5 flex items-center justify-between gap-3">
        <div>
          <span class="text-xs font-bold tracking-wide text-[#9fb8dc]">สรุปสิ่งที่ {BRAND_NAME} เตรียมไว้ ตั้งแต่หน้าสมัครจนถึงหน้าเกม</span>
          <div class="text-2xl leading-normal font-black text-white sm:text-3xl">สี่หมวดทางเข้าเดียว <span class="text-[#ff5a60]">•</span> เล่นจบบนมือถือ</div>
        </div>
        <span class="flex items-center gap-1.5 self-start rounded-full border border-green-400/40 bg-[#0a2a66] px-2.5 py-1">
          <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-green-500"></span>
          <span class="text-[10px] font-bold tracking-widest text-green-400 uppercase">Live</span>
        </span>
      </div>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#9fb8dc] uppercase">
        <span>ระบบ / บริการในเว็บ</span>
        <span>จุดเด่น</span>
      </div>

      <div class="flex flex-1 flex-col gap-2.5">
        {
          steps.map((s) => (
            <div class="rounded-xl border border-[#1a4a9c] bg-[#0a2a66] px-3.5 py-2.5 transition-colors hover:border-[#2f7bff] hover:bg-[#043a80]">
              <div class="flex items-center justify-between gap-2 text-sm">
                <span class="flex min-w-0 items-center gap-2 font-bold text-white">
                  <span aria-hidden="true" class="w-5 shrink-0 text-center">
                    {s.icon}
                  </span>{" "}
                  <span class="truncate">{s.name}</span>
                </span>
                <span class="shrink-0 rounded-full bg-gradient-to-b from-[#ff5a60] to-[#b0121a] px-2.5 py-0.5 text-[10px] font-bold text-white">{s.tag}</span>
              </div>
              <div class="mt-1.5 text-xs tracking-wide text-[#9fb8dc]">{s.detail}</div>
            </div>
          ))
        }
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
        {chips.map((c) => <span class="rounded-full border border-[#1a4a9c] bg-[#0a2a66] px-3 py-1 text-[10px] font-bold text-[#4da3ff]">{c}</span>)}
      </div>

      <div class="mt-3 text-center text-[11px] tracking-wide text-[#9fb8dc]">
        เงื่อนไขของแต่ละโปรดูได้ในหน้าโปรโมชั่นก่อนรับ ไม่ส่งรหัสผ่านหรือ OTP ให้ใคร มีเรื่องติดขัดทักแอดมินผ่านช่องทางบนหน้าเว็บได้เลย
      </div>
    </div>
  </div>
</ContentBoxTwo>
