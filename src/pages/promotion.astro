---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";

import { Picture } from "astro:assets";

import pro1 from "../assets/slide1.png";
import pro2 from "../assets/slide2.png";
import pro3 from "../assets/slide3.png";
import pro4 from "../assets/slide4.png";
import pro5 from "../assets/slide5.png";
import { pageGraph } from "../lib/schema";

const pageTitle = "โปรโมชั่น VING999 รวมสิทธิ์สมาชิก โปรฝาก และโบนัสตามช่วงเวลา";

const pageHeading = "โปรโมชั่น VING999 รวมสิทธิ์สำหรับสมาชิก";

const pageDescription =
  "รวมภาพโปรโมชั่น VING999 ทั้งโปรสมาชิกใหม่ โปรฝากรับเพิ่ม และโบนัสตามช่วงเวลา ดูยอดรับกับเงื่อนไขเทิร์นบนภาพได้ครบ สมัครยูสเดียวใช้สิทธิ์ต่อจากหน้าเมมเบอร์";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: pro1.src,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageHeading} as="h1">
    <p class="mb-4 text-left text-base leading-relaxed text-[#dce3e8]">
      หากคุณกำลังมองหาโปรที่ดูจบในหน้าเดียวว่ารับอะไรได้บ้าง <strong class="text-[#bdcad2]">VING999</strong> รวมสิทธิ์สำหรับสมาชิกไว้ให้ครบ ทั้งโปรฝากรับเพิ่ม โปรสมาชิกใหม่
      และโบนัสที่เปิดตามช่วงเวลา
    </p>

    <p class="mb-8 text-left text-base leading-relaxed text-[#dce3e8]">
      ยอดรับ เงื่อนไขเทิร์น และเวลาที่ใช้ได้ อยู่บนภาพทุกใบ เลือกใบที่ตรงกับทุนของคุณ แล้วสมัครยูสเดียวใช้สิทธิ์ต่อจากหน้าเมมเบอร์ เพื่อประสบการณ์การเล่นที่คุ้มค่าและต่อเนื่องกว่าที่เคย
    </p>

    <div class="grid w-full grid-cols-1 gap-6 sm:grid-cols-2">
      <Picture
        src={pro1}
        alt="ภาพโปรโมชั่น VING999 พื้นแดงดำ พรีเซนเตอร์หญิงชุดเดรสกำมะหยี่สีแดงยืนข้างป้าย SLOT ข้อความบนภาพเขียนว่า โปรฝากสุดคุ้ม ฝาก 59฿ รับ 200฿ ทำเทิร์น 4 เท่า รวมทุน ฝากขั้นต่ำ 1 บาท พร้อมแถบไอคอนด้านล่าง สมัครง่ายรวดเร็วไม่กี่ขั้นตอน ฝาก-ถอนออโต้รวดเร็วทันใจ รองรับธนาคารและวอเลท โปรโมชั่นจัดเต็มทุกสัปดาห์ และปลอดภัยมั่นคงเชื่อถือได้"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class="mx-auto h-auto w-full rounded-xl border border-[#5a1a1e] object-contain shadow-[0_10px_30px_rgba(224,27,45,0.16)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#e01b2d]/50 hover:shadow-[0_15px_40px_rgba(224,27,45,0.26)]"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />

      <Picture
        src={pro2}
        alt="ภาพโปรโมชั่น VING999 พื้นแดงดำ พรีเซนเตอร์หญิงชุดแดงขาวถือเหรียญโลโก้ VING999 ข้อความบนภาพเขียนว่า โบนัสสุดคุ้ม! เวลา 12:00น. ถึง 15:00น. 15% ซื้อฟรีสปินได้ ทำเทิร์น 1 เท่า 2 เท่ารวมทุน รับได้วันละ 1 ครั้ง พร้อมแถบไอคอนด้านล่าง สมัครง่ายรวดเร็วไม่กี่ขั้นตอน ฝาก-ถอนออโต้รวดเร็วทันใจ รองรับธนาคารและวอเลท โปรโมชั่นจัดเต็มทุกสัปดาห์ และปลอดภัยมั่นคงเชื่อถือได้"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class="mx-auto h-auto w-full rounded-xl border border-[#5a1a1e] object-contain shadow-[0_10px_30px_rgba(224,27,45,0.16)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#e01b2d]/50 hover:shadow-[0_15px_40px_rgba(224,27,45,0.26)]"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />

      <Picture
        src={pro3}
        alt="ภาพโปรโมชั่น VING999 พื้นแดงดำพร้อมโลโก้โครเมียมแดง ข้อความบนภาพเขียนว่า โปรฝากสุดคุ้ม ฝาก 29฿ รับ 100฿ ทำเทิร์น 4 เท่า รวมทุน ฝากขั้นต่ำ 1 บาท พร้อมแถบไอคอนด้านล่าง สมัครง่ายรวดเร็วไม่กี่ขั้นตอน ฝาก-ถอนออโต้รวดเร็วทันใจ รองรับธนาคารและวอเลท โปรโมชั่นจัดเต็มทุกสัปดาห์ และปลอดภัยมั่นคงเชื่อถือได้"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class="mx-auto h-auto w-full rounded-xl border border-[#5a1a1e] object-contain shadow-[0_10px_30px_rgba(224,27,45,0.16)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#e01b2d]/50 hover:shadow-[0_15px_40px_rgba(224,27,45,0.26)]"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />

      <Picture
        src={pro4}
        alt="ภาพโปรโมชั่น VING999 พื้นแดงดำ พรีเซนเตอร์หญิงชุดขาวแดงถือไพ่ ข้อความบนภาพเขียนว่า โปรสมาชิกใหม่ ฝาก 49฿ รับ 150฿ ทำเทิร์น 4 เท่า รวมทุน พร้อมแถบไอคอนด้านล่าง สมัครง่ายรวดเร็วไม่กี่ขั้นตอน ฝาก-ถอนออโต้รวดเร็วทันใจ รองรับธนาคารและวอเลท โปรโมชั่นจัดเต็มทุกสัปดาห์ และปลอดภัยมั่นคงเชื่อถือได้"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class="mx-auto h-auto w-full rounded-xl border border-[#5a1a1e] object-contain shadow-[0_10px_30px_rgba(224,27,45,0.16)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#e01b2d]/50 hover:shadow-[0_15px_40px_rgba(224,27,45,0.26)]"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />

      <div class="sm:col-span-2 sm:mx-auto sm:w-[calc(50%_-_0.75rem)]">
        <Picture
          src={pro5}
          alt="ภาพโปรโมชั่น VING999 พื้นแดงดำ ข้อความบนภาพเขียนว่า สล็อตแตกง่าย VING999 เกมค่ายดัง ฝาก-ถอน ออโต้ รองรับ วอเลท ฝากขั้นต่ำ 1 บาท พร้อมแถบไอคอนด้านล่าง สมัครง่ายรวดเร็วไม่กี่ขั้นตอน ฝาก-ถอนออโต้รวดเร็วทันใจ รองรับธนาคารและวอเลท โปรโมชั่นจัดเต็มทุกสัปดาห์ และปลอดภัยมั่นคงเชื่อถือได้"
          loading="lazy"
          fetchpriority="low"
          widths={[200, 400, 600]}
          sizes="(max-width: 768px) 100vw, 50vw"
          class="mx-auto h-auto w-full rounded-xl border border-[#5a1a1e] object-contain shadow-[0_10px_30px_rgba(224,27,45,0.16)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#e01b2d]/50 hover:shadow-[0_15px_40px_rgba(224,27,45,0.26)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />
      </div>
    </div>

    <div class="mt-12 flex justify-center pb-4">
      <a
        href="/register"
        class="flex items-center justify-center rounded-lg border border-[#ff3b46]/45 bg-gradient-to-r from-[#ff3b46] via-[#e01b2d] to-[#8f0a13] px-10 py-3.5 text-lg font-black text-[#f2f5f7] shadow-[0_10px_30px_rgba(224,27,45,0.28)] transition-transform hover:scale-105 hover:shadow-[0_15px_40px_rgba(255,59,70,0.35)]">
        สมัครสมาชิก VING999
      </a>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
