---
const {
  message = "YOK789 สล็อตเว็บตรง รวมสล็อตกว่า 40 ค่าย เกมกว่า 4,000 รายการ คาสิโนสด หวย และกีฬา ไว้ในบัญชีเดียว • ฝากถอนออโต้ไวระดับ 1 วินาที ตรวจประวัติรายการได้เองทุกยอด • คืนยอดเสียสูงสุด 8% อ่านฐานคำนวณ รอบรับสิทธิ์ จำนวนเทิร์น และเพดานถอนก่อนกดรับทุกครั้ง • ตรวจชื่อเว็บและ HTTPS ให้ตรงก่อนล็อกอินที่ yok789-brand.com",
} = Astro.props;
---

<div class="mx-auto mt-6 max-w-[900px] px-2 md:px-0">
  <div class="relative flex h-[40px] items-center rounded-sm border-b-2 border-[#12b84f] bg-[#040a06] shadow-[0_2px_10px_rgba(0,0,0,0.8)]">
    <div class="absolute -top-3 left-4 flex items-center gap-1.5 rounded-sm bg-gradient-to-r from-[#0a6b2f] to-[#5cff9b] px-3 py-0.5 shadow-[0_4px_10px_rgba(18,184,79,0.5)]">
      <div aria-hidden="true" class="h-2 w-2 animate-pulse rounded-full bg-[#04140a]"></div>
      <span class="text-[10px] font-black tracking-widest text-[#04140a] md:text-xs">LIVE UPDATE</span>
    </div>

    <div class="ml-32 flex-1 overflow-hidden md:ml-40">
      <div class="ticker-track flex w-max gap-12 text-sm font-medium whitespace-nowrap text-[#d5f0dd]">
        <span>{message}</span>
        <span>{message}</span>
      </div>
    </div>
  </div>
</div>

<style>
  @keyframes scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(calc(-50% - 24px));
    }
  }

  .ticker-track {
    animation: scroll 26s linear infinite;
  }

  @media (prefers-reduced-motion: reduce) {
    .ticker-track {
      animation: none;
    }
  }
</style>
