---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#f5c542]/25 bg-[#0d0904]/92 p-8 text-left text-base leading-relaxed text-[#efe1c2] shadow-[0_10px_30px_rgba(245,197,66,0.12)] backdrop-blur-xl transition-all duration-500 hover:border-[#f5c542]/55 hover:shadow-[0_15px_40px_rgba(245,197,66,0.22)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#f5c542]/25 blur-[60px] transition-all duration-500 group-hover:bg-[#ffd75e]/30"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#bc7b14]/35 blur-[60px] transition-all duration-500 group-hover:bg-[#f5c542]/30"></div>

    {
      title && (
        <header class="mb-6 flex items-center gap-4 border-b border-[#f5c542]/25 pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffd75e] to-[#a3610c] shadow-[0_0_10px_rgba(245,197,66,0.45)]" />
          <HeadingTag class="bg-gradient-to-r from-[#ffe9a8] via-[#f5c542] to-[#bc7b14] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
