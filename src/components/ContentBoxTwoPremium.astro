---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
  label?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label } = Astro.props;

const sectionLabel = label ?? title ?? titleleft ?? titleright ?? "ข้อมูลประกอบ";
---

<section aria-label={sectionLabel} class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#5a2a12] bg-[#1a100c] p-8 text-[#f2e7de] shadow-[0_10px_30px_rgba(242,107,29,0.16)] transition-all duration-500 hover:border-[#f26b1d]/55 hover:shadow-[0_15px_40px_rgba(242,107,29,0.28)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 bg-gradient-to-br from-[#26150e] to-transparent"></div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#5a2a12] pb-4">
          <span aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffd77a] via-[#f26b1d] to-[#b3121b] shadow-[0_0_10px_rgba(242,107,29,0.45)]" />
          <HeadingTag class="bg-gradient-to-r from-[#f2e7de] via-[#ffd77a] to-[#ff9a4d] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-10 md:grid-cols-2">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f2e7de]">
        {
          titleleft && (
            <p class="flex items-center gap-3 border-b border-[#5a2a12] pb-3 text-xl leading-normal font-black tracking-widest text-[#ffd77a] uppercase">
              <span aria-hidden="true" class="h-6 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#f26b1d] to-[#cd4604] shadow-[0_0_10px_rgba(242,107,29,0.45)]" />
              {titleleft}
            </p>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f2e7de] md:border-l md:border-[#5a2a12] md:pl-10">
        {
          titleright && (
            <p class="flex items-center gap-3 border-b border-[#5a2a12] pb-3 text-xl leading-normal font-black tracking-widest text-[#ff9a4d] uppercase">
              <span aria-hidden="true" class="h-6 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffd77a] to-[#f5b942] shadow-[0_0_10px_rgba(245,185,66,0.45)]" />
              {titleright}
            </p>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
