---
const { titleleft, titleright } = Astro.props;
---

<section class="mx-auto mb-6 w-full max-w-7xl px-4 font-sans">
  <div
    class="relative w-full border border-cyan-500/20 bg-[#0a0f16]/95 p-8 text-white/90 shadow-[0_0_25px_rgba(6,182,212,0.1)] transition-all duration-300 hover:border-cyan-400/50 hover:shadow-[0_0_35px_rgba(6,182,212,0.25)]"
    style="clip-path: polygon(30px 0, 100% 0, 100% calc(100% - 30px), calc(100% - 30px) 100%, 0 100%, 0 30px);">
    <div class="absolute top-0 left-0 h-[2px] w-24 bg-gradient-to-r from-cyan-500 to-transparent"></div>
    <div class="absolute right-0 bottom-0 h-[2px] w-24 bg-gradient-to-l from-cyan-500 to-transparent"></div>
    <div class="absolute top-0 left-0 h-16 w-[2px] bg-gradient-to-b from-cyan-500 to-transparent"></div>
    <div class="absolute right-0 bottom-0 h-16 w-[2px] bg-gradient-to-t from-cyan-500 to-transparent"></div>

    <div class="grid grid-cols-1 gap-8 md:grid-cols-[3fr_7fr]">
      <article class="flex flex-col gap-4">
        {titleleft && <h2 class="border-b border-cyan-900/50 pb-2 text-xl font-black tracking-widest text-cyan-400 uppercase">// {titleleft}</h2>}
        <div class="text-sm leading-relaxed text-gray-300">
          <slot name="left" />
        </div>
      </article>

      <article class="flex flex-col gap-4 md:border-l md:border-cyan-900/30 md:pl-8">
        {titleright && <h2 class="border-b border-cyan-900/50 pb-2 text-xl font-black tracking-widest text-cyan-400 uppercase">// {titleright}</h2>}
        <div class="text-sm leading-relaxed text-gray-300">
          <slot name="right" />
        </div>
      </article>
    </div>
  </div>
</section>

<style>
  .font-sans {
    font-family: "Kanit", sans-serif;
  }
</style>
