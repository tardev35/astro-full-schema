---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement4.astro";

import { Picture } from "astro:assets";
import imgLine from "../assets/contact-line.webp";
import { pageGraph } from "../lib/schema";
import { BRAND_ADDRESS } from "../lib/brandProfile";

const pageTitle = "ติดต่อทีมงาน OSIRIS168 | แจ้งปัญหาผ่าน LINE Official ตลอด 24 ชม.";

const pageDescription =
  "ติดต่อทีมงาน OSIRIS168 แจ้งปัญหาฝากถอนออโต้ หรือสอบถามเรื่องยูสและโปรสมาชิกใหม่ ผ่าน LINE Official ตลอด 24 ชั่วโมง พร้อมที่อยู่ติดต่อ อีเมล และปุ่มสมัครสมาชิก";

const graph = pageGraph(Astro, {
  type: "ContactPage",
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ติดต่อเรา", path: "/contact-us" },
  ],
  org: {
    alternateName: "OSIRIS168 เว็บสล็อตระบบใหม่ปี 2026 รวมค่ายเกม ฝากถอนออโต้เต็มระบบ",
    contactPoints: [
      {
        contactType: "customer service",
        availableLanguage: ["Thai", "English"],
        path: "/line",
        description: "ติดต่อแอดมินผ่าน LINE Official",
      },
    ],
  },
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="ติดต่อทีมงาน OSIRIS168" as="h1">
    <Picture
      src={imgLine}
      alt="พนักงานหญิงผมยาวสีน้ำตาลลอนสวมชุดเลื่อมสีชมพูแขนยาวคอวี ยิ้มกอดอกอยู่หน้าวงกลมสีชมพู ด้านล่างเป็นแถบสีขาวที่มีโลโก้ LINE สีเขียวและคำว่า Support"
      loading="lazy"
      fetchpriority="low"
      widths={[200, 400, 600]}
      sizes="(max-width: 768px) 100vw, 400px"
      class="mx-auto h-auto w-full max-w-[400px] object-contain"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={60}
    />
    {
      BRAND_ADDRESS.lines.length > 0 && (
        <address aria-label={BRAND_ADDRESS.label} class="mt-8 mb-8 border-l-4 border-[#12c48f] pl-6 text-left text-base leading-relaxed text-[#dfeee6] not-italic">
          <p class="mb-1 font-bold text-[#e8b52c]">{BRAND_ADDRESS.label}</p>
          {BRAND_ADDRESS.lines.map((line) => (
            <span class="block">{line}</span>
          ))}
          {BRAND_ADDRESS.email && (
            <span class="mt-3 block">
              <span aria-hidden="true" class="mr-2">
                ✉️
              </span>
              <a href={`mailto:${BRAND_ADDRESS.email}`} class="font-bold text-[#ffdd8a] underline decoration-[#e8b52c]/60 underline-offset-4 transition-colors hover:text-[#f8ecc9]">
                {BRAND_ADDRESS.email}
              </a>
            </span>
          )}
        </address>
      )
    }

    <div class="flex flex-wrap justify-center gap-4">
      <a
        href="/register"
        aria-label="สมัครสมาชิก OSIRIS168"
        class="flex items-center justify-center rounded-lg border border-[#ffdd8a]/45 bg-gradient-to-b from-[#ffdd8a] to-[#e8b52c] px-8 py-3 font-bold text-[#0a1a15] shadow-[0_10px_30px_rgba(232,181,44,0.28)] transition-transform hover:scale-105 hover:shadow-[0_15px_40px_rgba(232,181,44,0.35)]">
        สมัครสมาชิก
      </a>

      <a
        href="/login"
        aria-label="เข้าสู่ระบบ OSIRIS168"
        class="flex items-center justify-center rounded-lg border border-[#12c48f]/45 bg-[#0d2a21] px-8 py-3 font-extrabold text-[#dfeee6] shadow-[0_4px_14px_rgba(18,196,143,0.16)] transition-transform hover:scale-105 hover:bg-[#12382c]">
        เข้าสู่ระบบ
      </a>

      <a
        href="/line"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="ติดต่อทีมงานผ่าน Line Official"
        class="flex items-center justify-center rounded-lg border border-green-300 bg-gradient-to-b from-green-400 to-green-700 px-8 py-3 font-bold text-white transition-transform hover:scale-105">
        ติดต่อผ่าน Line Official
      </a>
    </div>
  </ContentBox>
  <Navfoot />
</MainLayout>
