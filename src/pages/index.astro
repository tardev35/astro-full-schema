---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxCyberCut.astro";
import ContentBoxTwo from "../components/ContentBoxTwoCyberCut.astro";
import ContentBoxSevenThree from "../components/ContentBoxSevenThreeCyberCut.astro";
import ContentBoxThreeColums from "../components/ContentBox3ThreeCyberCut.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementCyber.astro";
import SmoothCarousel from "../components/SmoothCarousel.astro";
import ProviderGrid from "../components/ProviderGrid.astro";
import LatestWinners from "../components/LatestWinnersCyber.astro";
import Faq from "../components/Faq4.astro";

const currentPath = Astro.url.pathname;
const homePage = Astro.url.origin;
const logoUrl = homePage + "/logo.webp";

const webPageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: "MARANGS777 เว็บตรง API แท้ มีครบเกมสล็อตออนไลน์ ทางเข้าหลัก",
  description: "ทางเข้าหลัก MARANGS777 เว็บตรง API แท้ จากเซิร์ฟเวอร์จริง ไม่เสี่ยงโดนโกง จ่ายจริงไม่ล็อคยูส ฝากถอนออโต้ ทำงานเอง ไม่ผ่านแอดมิน สมัครที่นี่ปลอดภัย 100%",
  url: currentPath,
};
const webSiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "MARANGS777",
  alternateName: ["marangs777", "marangs777bkk", "marangs777 auto"],
  url: "https://marangs7777.com/",
};
const orgSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "MARANGS777",
  logo: logoUrl,
  url: homePage,
};
const allSchemas = [webPageSchema, orgSchema, webSiteSchema];

import { Picture } from "astro:assets";
import image1 from "../assets/slide2.jpg";
---

<MainLayout>
  <script type="application/ld+json" set:html={JSON.stringify(allSchemas)} />

  <Announcement />

  <ContentBox title="MARANGS777 เว็บตรง API แท้ มีครบเกมสล็อตออนไลน์ ทางเข้าหลัก">
    <p class="leading-relaxed">
      MARANGS777 เว็บตรงที่เปิดให้บริการสล็อตออนไลน์ ด้วยระบบ API แท้ 100% เชื่อมต่อตรงจากเซิร์ฟเวอร์แม่ของค่ายเกมสล็อต มีครบทุกค่าย ชั้นนำและมีคุณภาพ ทางเข้าหลัก
      การันตีความปลอดภัยและจ่ายจริงทุกยอดไม่มีผ่านเอเย่นต์ ไม่มีการปรับจูนค่า RTP (อัตราการจ่าย) MARANGS777 เรายึดถือมาตรฐานความโปร่งใสเป็นที่ตั้ง เราทำหน้าที่เป็นช่องทางเข้าถึงเกมมาตรฐานสากล
      จบปัญหาเรื่องการโดนล็อคยูส หรือเว็บปิดหนี
    </p>

    <div class="mt-8 flex flex-wrap justify-center gap-6">
      <a
        href="/login"
        class="group relative flex items-center justify-center px-10 py-3.5 font-black text-white transition-all hover:scale-105"
        style="clip-path: polygon(15% 0, 100% 0, 100% 70%, 85% 100%, 0 100%, 0 30%); background: #240046; border: 1px solid #9d4edd;">
        เข้าระบบเกม
      </a>
      <a
        href="/register"
        class="group relative flex items-center justify-center px-10 py-3.5 font-black text-[#10002b] shadow-[0_0_20px_rgba(255,215,0,0.5)] transition-all hover:scale-105"
        style="clip-path: polygon(15% 0, 100% 0, 100% 70%, 85% 100%, 0 100%, 0 30%); background: linear-gradient(to right, #ffcc33, #ffea00);">
        สมัครสมาชิก
      </a>
    </div>
  </ContentBox>
  <LatestWinners />
  <ProviderGrid />

  <ContentBoxThreeColums titleleft="AUTO_NEXUS" titlecenter="CASHBACK_5%" titleright="VIP_SUPPORT">
    <div slot="left">ระบบประมวลผล Cyber-Auto 3 วินาที แม่นยำ 100% รองรับทุกธนาคารชั้นนำ</div>
    <div slot="center">รับคืนยอดเสีย 5% ทุกสัปดาห์ ไม่ต้องทำเทิร์น ถอนได้ทันทีสูงสุด 100,000 บาท</div>
    <div slot="right">ดูแลระดับพระกาฬโดยทีมงานมืออาชีพ พร้อมแก้ไขทุกปัญหาตลอด 24 ชั่วโมง</div>
  </ContentBoxThreeColums>

  <ContentBoxTwo titleleft="MARANGS777 เว็บตรง API แท้ มาตรฐานที่เว็บเถื่อนเลียนแบบไม่ได้" titleright="ทางเข้าหลัก จากเซิร์ฟเวอร์จริง MARANGS777 สมัครที่นี่ปลอดภัย 100%">
    <div slot="left" class="text-white/80">
      <p>
        บนหน้าการค้นหาเว็บไซต์ ตลาดเดิมพันปัจจุบันมีหลายเว็บพยายามแอบอ้างชื่อ MARANGS777 ไปเปิดให้บริการเพื่อหลอกลวงสมาชิก แต่สิ่งที่พวกเว็บเถื่อนเหล่านั้นไม่มีทางเลียนแบบได้คือ "โครงสร้างระบบ API
        แท้" ที่เราใช้ขับเคลื่อนเว็บไซต์ เพราะการเชื่อมต่อตรงจากเซิร์ฟเวอร์หลัก (Direct API) ต้องใช้ต้นทุนและความน่าเชื่อถือสูง เว็บเอเย่นต์จึงทำได้แค่ก๊อปปี้ดีไซน์
        แต่ไม่สามารถเข้าถึงระบบการจ่ายเงินที่เสถียรและยุติธรรมแบบเราได้
      </p>
    </div>
    <div slot="right" class="text-white/80">
      <p>
        นี่คือหน้าเว็บหลักอย่างเป็นทางการ (Official Site) ของ MARANGS777 หากคุณต้องการเล่นเกมสล็อตและบาคาร่าที่ได้มาตรฐานที่สุด ให้สมัครสมาชิกผ่านหน้าเว็บนี้เท่านั้น
        เราปกป้องข้อมูลผู้ใช้งานด้วยระบบเข้ารหัสชั้นสูง (SSL) มั่นใจได้ว่าข้อมูลส่วนตัวของคุณจะถูกจัดเก็บเป็นความลับ 100% ไม่มีการนำไปขายต่อ หรือใช้ในทางที่ผิดเหมือนเว็บเอเย่นต์ทั่วไป
      </p>
    </div>
  </ContentBoxTwo>

  <ContentBoxSevenThree>
    <div slot="left" class="flex h-full flex-col justify-center">
      <Picture
        src={image1}
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600, 800]}
        sizes="(max-width: 768px) 100vw, 50vw"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
        alt="Vegus24 VIP Service"
        class="mx-auto h-auto w-full rounded-2xl border-2 border-yellow-500/30 shadow-[0_10px_30px_rgba(234,179,8,0.2)]"
      />
    </div>
    <div slot="right">
      <h3 class="text-purple-4000 mb-4 text-3xl font-black tracking-[0.2em] uppercase drop-shadow-[0_0_10px_rgba(157,78,221,0.3)]">ทำไมคุณถึงควรเข้าใช้งานผ่านทางเข้าหลักนี้เท่านั้น?</h3>
      <p>
        ถ้าคุณพบเจอช่องทางเข้าอื่นที่อ้างชื่อเรา แต่มีหน้าตาเว็บไม่เหมือนที่นี่ หรือมีความเงื่อนไขการสมัครที่ซับซ้อน ให้สันนิษฐานไว้ก่อนว่าเป็นเว็บแอบอ้าง การเข้าใช้งานผ่านทางเข้าหลักนี้เท่านั้น
        คือวิธีที่ปลอดภัยที่สุดในการทำกำไรและรักษาเงินของคุณ
      </p>

      <a
        href="/line"
        class="inline-flex items-center bg-[#00B900] px-8 py-3 font-bold text-white shadow-lg transition-transform hover:scale-105"
        style="clip-path: polygon(15% 0, 100% 0, 100% 70%, 85% 100%, 0 100%, 0 30%);">
        <span class="mr-2 text-xl">LINE</span> ติดต่อแอดมิน
      </a>
    </div>
  </ContentBoxSevenThree>
  <ContentBoxSevenThree titleleft="วิธีตรวจสอบ Marangs777 แท้ ไม่เสี่ยงโดนโกง (ทำไมต้องระวังเว็บแอบอ้าง?)" titleright="เจาะลึก เกมสล็อตออนไลน์ Marangs777 มาตรฐานสากล จ่ายจริงไม่ล็อคยูส">
    <div slot="left">
      <div class="border border-purple-500/30 bg-purple-900/20 p-4" style="clip-path: polygon(10% 0, 100% 0, 100% 90%, 90% 100%, 0 100%, 0 10%);">
        <p class="mb-2 text-xl font-black text-yellow-400">🔥 อย่าหลงเชื่อถ้าเจอเว็บอื่นที่อ้างชื่อ Marangs777 แล้วมีเงื่อนไขแปลกๆ ให้สังเกตจุดนี้:</p>
        <ul class="list-disc space-y-2 pl-5 text-gray-300">
          <li>ระบบสมัคร: ของจริงต้องเป็นระบบออโต้ ไม่ต้องให้แอดมินมาขอมือถือหรือรหัสผ่าน</li>
          <li>ความเร็วการถอน: ของจริงถอนไม่เกิน 3 วินาที ยอดต้องเข้าทันที ถ้ามีคำว่า "รอยอดตรวจสอบ" คือเว็บเอเย่นต์</li>
          <li>ช่องทางติดต่อ: ของจริงมีช่องทางเดียวที่ระบุชัดเจนบนหน้าเว็บนี้เท่านั้น ถ้าเจอเว็บไหนให้โอนเงินเข้าบัญชีบุคคลธรรมดาที่เปลี่ยนชื่อไปเรื่อยๆ นั่นคือเว็บปลอม</li>
        </ul>
      </div>
    </div>
    <div slot="right">
      <p class="leading-relaxed text-gray-300">
        ทำไมการเล่นผ่านเว็บตรงถึงสำคัญ? เพราะในเกมสล็อตระดับสากลจะมีค่าสถิติการจ่ายเงินที่แน่นอนตามอัลกอริทึมของค่ายเกม การเล่นที่ Marangs777 สำคัญคือ "ผลแพ้ชนะเป็นไปตามจริง"
        เราไม่จำเป็นต้องล็อคยูสเซอร์เพื่อกินทุนใคร ไม่ใช่แค่เรื่องของดวง แต่เป็นเรื่องของ "ความถูกต้องของระบบ" ที่นี่เราดึงเกมมาจากเซิร์ฟเวอร์หลักผ่านระบบ API แท้ของแต่ละค่ายเกม
        รองรับการเดิมพันในสเกลใหญ่ ยอดถอนหลักแสนหรือหลักล้านเราก็จ่ายให้ทันทีด้วยระบบออโต้
      </p>
    </div>
  </ContentBoxSevenThree>
  <SmoothCarousel />
  <ContentBox>
    <h2 class="mb-4 text-3xl font-black tracking-[0.2em] text-purple-400 uppercase drop-shadow-[0_0_10px_rgba(157,78,221,0.3)]">ระบบฝาก-ถอนออโต้ ระบบมันทำงานเอง ไม่ผ่านแอดมิน</h2>
    <p class="leading-relaxed">
      หัวใจสำคัญที่ทำให้ MARANGS777 ยืนหยัดมาได้นานคือ "ระบบอัตโนมัติ" เราตัดปัญหาเรื่องคนกลางออกไป 100% ลูกค้าสามารถทำรายการฝาก-ถอนได้ด้วยตัวเองตลอด 24 ชั่วโมง โดยไม่ต้องทักหาแอดมิน
      ไม่ต้องส่งสลิปให้ตรวจสอบ นี่คือระบบที่ออกแบบมาเพื่อความรวดเร็วและปลอดภัย ตัดช่องโหว่ของการดึงยอดหรือการโกงเงินที่มักเกิดขึ้นในเว็บเอเย่นต์ทั่วไปไปอย่างสิ้นเชิง หัวใจสำคัญที่ทำให้ MARANGS777
      ยืนหยัดมาได้นานคือ "ระบบอัตโนมัติ" เราตัดปัญหาเรื่องคนกลางออกไป 100% ลูกค้าสามารถทำรายการฝาก-ถอนได้ด้วยตัวเองตลอด 24 ชั่วโมง โดยไม่ต้องทักหาแอดมิน ไม่ต้องส่งสลิปให้ตรวจสอบ
      นี่คือระบบที่ออกแบบมาเพื่อความรวดเร็วและปลอดภัย ตัดช่องโหว่ของการดึงยอดหรือการโกงเงินที่มักเกิดขึ้นในเว็บเอเย่นต์ทั่วไปไปอย่างสิ้นเชิง
    </p>
  </ContentBox>

  <Faq />
  <Navfoot />

  <style>
    :global(.text-purple-gradient) {
      background: linear-gradient(to bottom, #d8b4fe 0%, #9d4edd 100%) !important;
      -webkit-background-clip: text !important;
      -webkit-text-fill-color: transparent !important;
    }
  </style>
</MainLayout>
