---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";
---

<section class="relative z-10 my-6 flex w-full justify-center px-4 font-sans">
  <div
    class="w-full max-w-[1400px] rounded-[25px] border border-[#153b26]/70 bg-[#08150d] p-8 text-left text-base leading-relaxed text-[#d5f0dd] shadow-[10px_10px_20px_#010603,-10px_-10px_20px_#0f2a1a]">
    {
      title && (
        <header class="mb-8 border-b border-[#12b84f]/25 pb-4 text-center">
          <HeadingTag
            class={`bg-gradient-to-r from-[#5cff9b] via-[#12b84f] to-[#0a6b2f] bg-clip-text ${headingSize} leading-normal font-black tracking-wide text-transparent`}>
            {title}
          </HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
