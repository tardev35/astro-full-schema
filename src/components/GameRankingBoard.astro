---
import { Picture } from "astro:assets";
import img1 from "../assets/providers/game1.avif";
import img2 from "../assets/providers/game2.avif";
import img3 from "../assets/providers/game3.avif";
import img4 from "../assets/providers/game4.avif";
import img5 from "../assets/providers/game5.avif";
import img6 from "../assets/providers/game6.avif";

const games = [
  {
    rank: 1,
    name: "PG Slot",
    type: "ค่ายที่สมาชิก AMD365 เปิดบ่อยที่สุด ภาพชัด เมนูไม่ซับซ้อน และหลายเกมออกแบบมาให้เหมาะกับหน้าจอมือถือ",
    menus: ["สายมือถือ", "เข้าใจง่าย"],
    players: 5124,
    img: img4,
  },
  {
    rank: 2,
    name: "Pragmatic Play",
    type: "กลุ่มเกมที่มีฟรีสปิน ตัวคูณ และรอบโบนัสชัดเจน เหมาะกับคนที่ชอบจังหวะเปลี่ยนระหว่างเกมหลักกับโบนัส",
    menus: ["ฟรีสปิน", "ตัวคูณ"],
    players: 3842,
    img: img5,
  },
  { rank: 3, name: "คาสิโนสด", type: "บาคาร่า รูเล็ต ไฮโล แบล็กแจ็ก และเกม Live อื่น ๆ เลือกโต๊ะจากหน้าเดียวโดยไม่ต้องเปลี่ยนบัญชีสมาชิก", menus: ["เกมโต๊ะ", "บรรยากาศสด"], players: 3517, img: img2 },
  { rank: 4, name: "Joker และค่ายอื่น ๆ", type: "วงล้อคลาสสิกที่คนไทยคุ้นมือ พร้อมค่ายอื่นในระบบให้สลับไปดูธีมและฟีเจอร์ใหม่ได้เรื่อย ๆ", menus: ["คลาสสิก", "ลองเกมใหม่"], players: 2905, img: img6 },
  {
    rank: 5,
    name: "กีฬาและ eSports",
    type: "ฟุตบอล บาสเกตบอล เทนนิส มวย และ eSports ตามรายการแข่งขันที่เปิดให้บริการในแต่ละช่วงเวลา",
    menus: ["หลายชนิดกีฬา", "ตามฤดูกาล"],
    players: 2431,
    img: img3,
  },
  {
    rank: 6,
    name: "หวยออนไลน์",
    type: "หวยรัฐบาลไทย หวยลาว หวยหุ้น หวยยี่กี และตลาดอื่น ๆ ตามรอบที่ระบบกำหนด ตรวจเวลาเปิด-ปิดก่อนทำรายการ",
    menus: ["เลือกตลาด", "ตามรอบ"],
    players: 2108,
    img: img1,
  },
];

const medal = (rank: number) => (rank === 1 ? "🥇" : rank === 2 ? "🥈" : rank === 3 ? "🥉" : null);
---

<section aria-label="หมวดเกมที่สมาชิก AMD365 เปิดเล่นบ่อย" class="mx-auto w-full max-w-[1300px] px-4 py-8 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <span aria-hidden="true" class="text-2xl">🏆</span>
    <p class="bg-gradient-to-r from-[#ffe9a8] via-[#fec93a] to-[#d4840e] bg-clip-text text-2xl font-black tracking-widest text-transparent uppercase">หมวดเกมที่สมาชิก AMD365 เปิดเล่นบ่อยที่สุด</p>
    <p class="max-w-3xl text-base leading-relaxed text-[#f4e8d2]">
      ทุกหมวดในตารางนี้อยู่หลังบัญชีสมาชิกเดียวกัน สลับจากสล็อตไปคาสิโนสด กีฬา หรือหวยได้โดยไม่ต้องสมัครยูสใหม่ ลำดับความนิยมขยับตามคนที่เข้ามาใช้งานในแต่ละช่วง
      ไม่ได้แปลว่าหมวดไหนให้อัตราจ่ายดีกว่าหมวดไหน รายการที่เปิดให้บริการจริงให้ยึดตามหน้าเมมเบอร์ก่อนทำรายการทุกครั้ง
    </p>
    <div class="mt-2 h-[3px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#fec93a] to-transparent"></div>
  </div>

  <div class="flex flex-col gap-3">
    {
      games.map((g) => {
        const top = g.rank === 1;
        return (
          <article
            class={`group relative flex items-center gap-3 overflow-hidden rounded-2xl border p-3 transition-all duration-300 hover:-translate-y-0.5 sm:gap-5 sm:p-4 ${
              top
                ? "border-[#fec93a]/75 bg-gradient-to-r from-[#33220a] via-[#221703] to-[#33220a] shadow-[0_15px_40px_rgba(254,201,58,0.22)]"
                : "border-[#fec93a]/35 bg-[#221703] shadow-[0_10px_30px_rgba(254,201,58,0.10)] hover:border-[#fec93a]/65 hover:shadow-[0_15px_40px_rgba(254,201,58,0.20)]"
            }`}>
            <div
              aria-hidden="true"
              class="pointer-events-none absolute top-1/2 -left-10 h-24 w-24 -translate-y-1/2 rounded-full bg-[#fec93a]/12 blur-[40px] transition-all duration-500 group-hover:bg-[#c9ccd4]/18"
            />

            <div class="relative z-10 flex w-8 shrink-0 flex-col items-center justify-center sm:w-12">
              {medal(g.rank) ? (
                <span class="text-2xl sm:text-3xl">
                  <span aria-hidden="true">{medal(g.rank)}</span>
                  <span class="sr-only">อันดับ {g.rank}</span>
                </span>
              ) : (
                <span class="text-xl font-black text-[#fec93a] sm:text-2xl">#{g.rank}</span>
              )}
            </div>

            <div class={`relative z-10 h-14 w-14 shrink-0 overflow-hidden rounded-xl border sm:h-16 sm:w-16 ${top ? "border-[#fec93a]/75" : "border-[#a06a09]/55"}`}>
              <Picture
                src={g.img}
                alt={`ภาพหน้าปกเกมประกอบรายการ ${g.name} บนกระดานหมวดเกมยอดนิยมของ AMD365`}
                formats={["avif", "webp"]}
                fallbackFormat="webp"
                loading="lazy"
                fetchpriority="low"
                widths={[100, 200]}
                quality={60}
                sizes="(max-width: 640px) 56px, 64px"
                decoding="async"
                class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-110"
              />
            </div>

            <div class="relative z-10 min-w-0 flex-1">
              <div class="flex items-center gap-2">
                <p class="truncate text-base font-black text-[#ffe9a8] sm:text-lg">{g.name}</p>
                {top && (
                  <span class="hidden shrink-0 rounded-full border border-[#fec93a]/55 bg-[#33220a] px-2 py-0.5 text-[9px] font-black tracking-wider text-[#ffe9a8] sm:inline">ยอดนิยมสูงสุด</span>
                )}
              </div>
              <p class="truncate text-[11px] text-[#cdbb93] sm:text-xs">{g.type}</p>

              <div class="mt-2 flex flex-wrap items-center gap-1.5">
                {g.menus.map((m) => (
                  <span class="rounded-full border border-[#a06a09]/55 bg-[#33220a] px-2.5 py-0.5 text-[10px] font-bold text-[#ffe9a8]">{m}</span>
                ))}
              </div>
            </div>

            <div class="relative z-10 hidden shrink-0 flex-col items-end gap-1 sm:flex">
              <span class="flex items-center gap-1.5 text-[11px] text-[#cdbb93]">
                <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#c9ccd4] shadow-[0_0_6px_rgba(201,204,212,0.7)]" />
                <span class="tabular-nums" data-players data-base={g.players}>
                  {g.players.toLocaleString("en-US")}
                </span>{" "}
                ออนไลน์
              </span>
              <a
                href="/register"
                class={`rounded-full px-4 py-1.5 text-xs font-black transition-transform hover:scale-105 ${
                  top
                    ? "bg-gradient-to-r from-[#ffe9a8] via-[#fec93a] to-[#d4840e] text-[#160e03] shadow-[0_10px_30px_rgba(254,201,58,0.28)]"
                    : "border border-[#a06a09]/60 bg-[#33220a] text-[#ffe9a8] hover:border-[#fec93a]/70 hover:bg-[#3c2606]"
                }`}>
                สมัครเข้าเล่น
              </a>
            </div>
          </article>
        );
      })
    }
  </div>
</section>

<script>
  import { startLiveCounters } from "../lib/liveCounter";

  startLiveCounters();
</script>
