---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#9c724a]/35 bg-[#1e0a06]/92 p-8 text-left text-base leading-relaxed text-[#f2ddc4] shadow-[0_10px_30px_rgba(168,31,26,0.16)] backdrop-blur-xl transition-all duration-500 hover:border-[#e9b949]/50 hover:shadow-[0_15px_40px_rgba(233,185,73,0.24)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#a81f1a]/25 blur-[60px] transition-all duration-500 group-hover:bg-[#e9b949]/25"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#5e0f06]/40 blur-[60px] transition-all duration-500 group-hover:bg-[#9c724a]/35"></div>

    {
      title && (
        <header class="mb-6 flex items-center gap-4 border-b border-[#9c724a]/35 pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#f8dc9a] to-[#a81f1a] shadow-[0_0_10px_rgba(233,185,73,0.5)]" />
          <HeadingTag class="bg-gradient-to-r from-[#f8dc9a] via-[#e9b949] to-[#a81f1a] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
