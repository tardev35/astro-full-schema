---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement2.astro";
import CtaRedirect from "../components/CtaRedirect.astro";
import { pageGraph } from "../lib/schema";

const pageTitle = "สมัครสมาชิก SUPREME888 | เปิดยูสใหม่ สล็อต ฝากถอนออโต้ เริ่ม 20 บาท";

const pageDescription =
  "หากคุณกำลังมองหาสล็อตที่ถอนได้เต็มทุกบิล SUPREME888 พร้อมมอบปุ่มสมัครสมาชิกเพียงปุ่มเดียว เปิดยูสบนมือถือ ฝากเริ่ม 20 บาท เพื่อเริ่มปั่นสล็อตหลายค่ายได้ทันที";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "สมัครสมาชิก", path: "/register" },
  ],
});

const targetUrl = "https://yoalink.com/22hs";
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="สมัครสมาชิก SUPREME888" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label="สมัครสมาชิก SUPREME888"
        class="group relative mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl bg-gradient-to-b from-[#ff4d55] to-[#d0121b] px-6 py-4 text-xl font-bold tracking-wide text-white shadow-[0_10px_30px_rgba(236,27,36,0.30)] transition-all duration-300 hover:scale-105 hover:brightness-110 hover:shadow-[0_15px_40px_rgba(236,27,36,0.45)]">
        สมัครสมาชิก SUPREME888
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="สมัครสมาชิก" />
</MainLayout>
