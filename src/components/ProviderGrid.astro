---
const providers = [
  { name: "สล็อตเว็บตรงสายเฮง", desc: "ระบบแท้ 100% จากต่างประเทศ ไม่ใช่เว็บเอเย่นต์ ไม่มีการล็อกยูสหรือปรับอัตราแพ้ชนะ", tag: "ระบบแท้", icon: "🐉" },
  { name: "ยูสเดียวเข้าได้ทุกแพลตฟอร์ม", desc: "ไอแพด มือถือ หรือคอมพิวเตอร์ ใช้ยูสเซอร์เดียวเข้าเล่นได้ทันที ไม่ต้องโหลดแอปให้รกเครื่อง", tag: "ยูสเดียว", icon: "🔑" },
  { name: "จ่ายไม่อั้น โอนครบทุกบาท", desc: "แตกหลักแสนหรือหลักล้านก็โอนให้ครบ ไม่มีผ่อนจ่าย และไม่หักค่าธรรมเนียมใดๆ", tag: "จ่ายครบ", icon: "💰" },
  { name: "ไม่มีขั้นต่ำ", desc: "ทุนมากหรือน้อยก็เริ่มได้ ฝากหลักสิบหรือหลักร้อยก็เข้าเล่นได้เหมือนสมาชิกทุกคน", tag: "ทุนน้อยเล่นได้", icon: "🧧" },
  { name: "ฝากถอน True Wallet", desc: "รองรับ True Money Wallet เต็มรูปแบบ ระบบออโต้ทำงานเหมือนช่องทางธนาคาร ตรวจสอบได้ทุกยอดธุรกรรม", tag: "วอเลท", icon: "⚡" },
  { name: "ค่า RTP มาตรฐานสากล", desc: "ทุกเกมรันด้วยค่า RTP (Return to Player) จากค่ายแม่โดยตรง วัดกันที่ดวงและจังหวะของผู้เล่น", tag: "RTP ค่ายแม่", icon: "🎰" },
  { name: "รวมค่ายดังลิขสิทธิ์แท้", desc: "PG SOFT, Pragmatic Play, Joker Gaming และอีกหลายค่าย ภาพสวย เสียงชัด เล่นลื่นไหล อัปเดตเกมใหม่ก่อนใคร", tag: "ครบจบ", icon: "🏮" },
];
---

<section aria-label="จุดเด่นของ GGHENG สล็อตเว็บตรงสายเฮง" class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#ffe9a3] via-[#ffd34d] to-[#ff8a70] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      สิ่งที่ <span class="text-[#ff8a70]">GGHENG</span> รวมไว้ในยูสเดียว
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#f5c542] to-transparent"></div>
  </div>

  <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4 lg:gap-5 xl:grid-cols-7">
    {
      providers.map((provider) => (
        <a
          href="/register/"
          class="group relative flex flex-col items-center justify-center overflow-hidden rounded-2xl border border-[#3a0a0d] bg-[#140202] p-5 shadow-[0_10px_30px_rgba(245,197,66,0.14)] transition-all duration-300 hover:-translate-y-2 hover:border-[#f5c542]/55 hover:bg-[#1f0405] hover:shadow-[0_15px_40px_rgba(245,197,66,0.28)]">
          <div class="pointer-events-none absolute inset-0 bg-[#f5c542]/8 opacity-0 transition-opacity duration-300 group-hover:opacity-100" />

          <div class="absolute top-2 right-2 z-10 rounded-full bg-gradient-to-r from-[#e11d1d] via-[#a31212] to-[#5a0a0a] px-2 py-0.5 text-[9px] font-black tracking-wide whitespace-nowrap text-white shadow-sm transition-transform duration-300 group-hover:scale-110">
            {provider.tag}
          </div>

          <div aria-hidden="true" class="mb-3 text-4xl transition-transform duration-300 group-hover:scale-125 group-hover:rotate-3">
            {provider.icon}
          </div>
          <p class="text-center text-sm font-black text-[#ffdf80] transition-colors group-hover:text-[#ffe9a3]">{provider.name}</p>
          <p class="mt-1 text-center text-[10px] text-[#d4b59a]">{provider.desc}</p>

          <span class="relative z-10 mt-4 block w-full rounded-full border border-[#5c0b13] bg-[#1f0405] py-1.5 text-center text-[11px] font-bold text-[#ffdf80] shadow-inner transition-colors duration-300 group-hover:border-transparent group-hover:bg-gradient-to-r group-hover:from-[#ffe9a3] group-hover:via-[#ffd34d] group-hover:to-[#c8901a] group-hover:text-[#140202]">
            สมัครเข้าเล่น
          </span>
        </a>
      ))
    }
  </div>
</section>
