---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import ContentBoxTwo from "../components/ContentBoxTwo.astro";
import ContentBoxSevenThree from "../components/ContentBoxSevenThree.astro";
import ContentBoxThreeColums from "../components/ContentBox3Three.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import SmoothCarousel from "../components/SmoothCarousel.astro";
import ProviderGrid from "../components/ProviderGrid.astro";
import LatestWinners from "../components/LatestWinners.astro";
import Faq from "../components/Faq.astro";

const currentPath = Astro.url.pathname;
const homePage = Astro.url.origin;
const logoUrl = homePage + "/logo.webp";

const webPageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: "SIXSLOT เว็บสล็อตคุณภาพ API แท้ ทุกค่าย แตกไว ถอนได้เต็ม 100%",
  description: "SIXSLOT เว็บสล็อตคุณภาพ ใช้ API แท้ จากเซิร์ฟเวอร์หลัก เสถียร ปลอดถัย เกมสล็อต รวมค่าย คัดเลือกเฉพาะ มาตรฐานสากล แตกไว สมดุลที่สุด ถอนได้เต็มทุกยอด",
  url: currentPath,
};

const webSiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "SIXSLOT",
  alternateName: ["sixslot", "SIXSLOTofficial", "SIXSLOTofficials", "SIXSLOT"],
  url: "https://sixslot.com/",
};

const orgSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "SIXSLOT",
  logo: logoUrl,
  url: homePage,
};

const allSchemas = [webPageSchema, orgSchema, webSiteSchema];
import { Picture } from "astro:assets";
import image1 from "../assets/slide1.jpg";
---

<MainLayout>
  <script type="application/ld+json" set:html={JSON.stringify(allSchemas)} />

  <Announcement message="🚀 SIXSLOT-BKK อัปเดตระบบใหม่! ฝาก-ถอน Auto ภายใน 3 วินาที รองรับ True Wallet" />

  <ContentBox title="SIXSLOT เว็บสล็อตคุณภาพ API แท้ ทุกค่าย แตกไว ถอนได้เต็ม 100%">
    <p class="leading-relaxed">
      <strong class="text-emerald-400">SIXSLOT</strong> เว็บสล็อตคุณภาพ มาตรฐานสากลที่ใช้กันทั่วโลก การเล่นสล็อตออนไลน์ด้วยระบบ <strong class="text-amber-400">API แท้</strong> ที่เชื่อมต่อกับผู้ผลิตเกมระดับโลกที่
      ผ่านการทดสอบว่าไม่เปาเปรียบผู้เล่น โดยตรง ไม่ผ่านเอเย่นต์ การันตีโอกาสชนะที่เป็นธรรม ในระดับสูงสุดด้วยค่า RTP มาตรฐานสากล ทุกยอดการเดิมพันคือความแม่นยำที่ตรวจสอบได้จริง พร้อมการจ่ายเงินที่รวดเร็วและมั่นคง
      จ่ายจริงครบทุกบาท 100%
    </p>

    <div class="mt-6 flex flex-wrap justify-center gap-4">
      <a
        href="/register"
        class="flex items-center justify-center rounded-xl bg-gradient-to-r from-emerald-600 to-green-500 px-10 py-3.5 font-black text-white shadow-[0_0_20px_rgba(16,185,129,0.4)] transition-transform hover:scale-105">
        สมัครสมาชิกฟรี
      </a>

      <a
        href="/login"
        class="flex items-center justify-center rounded-xl bg-gradient-to-r from-yellow-500 to-amber-400 px-10 py-3.5 font-black text-emerald-950 shadow-[0_0_20px_rgba(245,158,11,0.3)] transition-transform hover:scale-105">
        ทางเข้าเล่น
      </a>
    </div>
  </ContentBox>

  <ProviderGrid />
  <ContentBoxThreeColums titleleft="🔄 คืนยอดเสียทุกวัน" titlecenter="💰 คืนค่าคอมมิชชั่น" titleright="⚡ ฝาก-ถอน ออโต้">
    <div slot="left" class="text-sm text-white/70">เล่นเสียไม่ต้องเศร้า เรามีระบบคืนยอดเสียให้คุณทุกวัน กดรับได้เองทันที ยิ่งเล่นเยอะยิ่งได้คืนเยอะ ไม่มีอั้น!</div>
    <div slot="center" class="text-sm text-white/70">รับค่าคอมมิชชั่นจากการเล่นของคุณและเพื่อนที่แนะนำมา สร้างรายได้แบบ Passive Income ง่ายๆ ได้ทุกวัน</div>
    <div slot="right" class="text-sm text-white/70">ทำรายการรวดเร็วทันใจภายใน 3 วินาที ผ่านระบบออโต้ที่เสถียรที่สุด รองรับทุกธนาคารชั้นนำและ TrueMoney Wallet</div>
  </ContentBoxThreeColums>
  <LatestWinners />

  <ContentBoxTwo titleleft="SIXSLOT ระบบ API แท้ 100% จากเซิร์ฟเวอร์หลัก ปลอดภัย" titleright="เว็บเกมสล็อต รวมทุกค่าย คัดเลือกเฉพาะ มาตรฐานสากล">
    <div slot="left" class="space-y-4 text-white/80">
      <p>
        เว็บสล็อตคุณภาพสูงและปลอดภัย เราเลือกการเชื่อมต่อที่ถูกต้องที่สุด <strong class="text-amber-400">SIXSLOT</strong> ใช้ <strong class="text-emerald-400">ระบบ API แท้ 100%</strong> ที่ดึงข้อมูลจากเซิร์ฟเวอร์หลักของผู้พัฒนาเกมโดยตรง
        เพื่อให้ระบบมีความเสถียรและแม่นยำในระดับมาตรฐานสากล โดยไม่ต้องผ่านคนกลาง ไร้ปัญหาเครื่องค้างหรือการเชื่อมต่อที่ผิดพลาด มั่นใจได้ว่าการเล่นของคุณจะเป็นไปอย่างราบรื่น
      </p>
    </div>
    <div slot="right" class="text-white/80">
      <p>
        คัดกรองสิ่งที่ดีที่สุดมาไว้ในที่เดียว <strong class="text-emerald-400">SIXSLOT</strong> คือ <strong class="text-amber-400">เว็บเกมสล็อต</strong> ที่รวมทุกค่ายชั้นนำระดับโลก โดยเราคัดเลือกเฉพาะเกมที่มีใบรับรองและได้รับมาตรฐานสากล
        เพื่อให้มั่นใจในคุณภาพของระบบและตัวเกมที่ส่งตรงถึงมือคุณอย่างสมบูรณ์แบบที่สุด ให้สมาชิกได้รับประสบการณ์การเล่นที่ดีที่สุด ภาพคมชัด ระบบลื่นไหล
      </p>
    </div>
  </ContentBoxTwo>
  <SmoothCarousel />
  <ContentBoxSevenThree>
    <div slot="left" class="flex h-full flex-col justify-center">
      <Picture
        src={image1}
        alt="โปรโมชั่นสมัครสมาชิกใหม่ ฝากครั้งแรกรับโบนัสฟรี 60% สำหรับคาสิโน"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600]}
        sizes="(max-width: 768px) 100vw, 33vw"
        class="mx-auto h-auto w-full rounded-xl object-contain shadow-lg transition-transform duration-300 hover:-translate-y-1 hover:shadow-2xl"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />
    </div>
    <div slot="right">
      <h2 class="text-emerald-gradient mb-4 text-3xl font-black uppercase">SIXSLOT เว็บสล็อตเล่นง่าย แตกไว สมดุลระบบเป็นธรรมที่สุด</h2>
      <p class="mb-4 text-white/70">
        เว็บสล็อตเล่นง่าย และเข้าถึงรอบโบนัสได้ แตกไวที่สุดในปัจจุบัน เราให้ความสำคัญกับการจ่ายเงินรางวัลที่แม่นยำโดยใช้กลไกสมดุลระบบเป็นธรรมที่สุด เพื่อให้สมาชิกมั่นใจในทุกการเดิมพันผ่านทาง SIXSLOT
        ว่าทุกยอดจะได้รับความคุ้มค่าตามมาตรฐานการเดิมพันสากลไม่ต้องกังวลเรื่องการเอาเปรียบ
      </p>
      <h2 class="text-emerald-gradient mb-4 text-3xl font-black uppercase">ถอนได้เต็มทุกยอด ระบบออโต้แม่นยำที่สุด ใช้เวลาน้อยเพียง 5 วิ</h2>
      <p>
        สมาชิกสามารถถอนได้เต็มทุกยอดโดยไม่มีการหักค่าธรรมเนียมใดๆ ทั้งสิ้น เราใช้ระบบออโต้แม่นยำที่สุดในการประมวลผลข้อมูลเพื่อให้ยอดเงินเข้าสู่บัญชีของคุณทันที โดยใช้เวลาน้อยเพียง 5 วิ เท่านั้น
        ตอบโจทย์ความต้องการที่เน้นความไวและความถูกต้องในทุกรายการธุรกรรมผ่าน SIXSLOT การันตีความรวดเร็วในการจัดการด้านการเงินที่แม่นยำ
      </p>
    </div>
  </ContentBoxSevenThree>
  <ContentBox>
    <h2 class="text-emerald-gradient mb-4 text-3xl font-black uppercase">เข้าสู่ระบบ SIXSLOT เว็บสล็อตคุณภาพ เสถียรและการรองรับการใช้งานหนัก</h2>
    <p>
      มั่นใจทุกครั้งที่ใช้งาน ผ่านประสิทธิภาพการเชื่อมต่อ สู่ระบบ เว็บสล็อตคุณภาพที่แท้จริง SIXSLOT รองรับการใช้งานหนักที่สามารถจัดการข้อมูลจำนวนมากได้อย่างแม่นยำและรวดเร็ว
      ช่วยให้การเข้าถึงตัวเกมและบริการต่างๆ ของ SIXSLOT เป็นไปอย่างต่อเนื่อง ไม่มีสะดุด แม้ในช่วงเวลาที่มีผู้ใช้งานหนาแน่นที่สุดครับ
    </p>
  </ContentBox>
  <Navfoot />

  <style>
    :global(.text-emerald-gradient) {
      background: linear-gradient(to bottom, #34d399 0%, #10b981 100%) !important;
      -webkit-background-clip: text !important;
      -webkit-text-fill-color: transparent !important;
    }
  </style>
</MainLayout>
