---
const {
  message = "BUNNY555 รวมสล็อตค่ายใหญ่ทั้ง PG Slot และ JILI ไว้ในบัญชีเดียว เลือกค่ายแล้วเข้าเกมได้ทันที • โบนัสจัดไว้เป็นส่วนหนึ่งของระบบสมาชิก เช็กโปรที่เปิดอยู่ก่อนเลือกใช้ได้ทุกครั้ง • ฝากถอนผ่าน True Wallet จัดการเครดิตจากมือถือ ดูยอดและประวัติได้จากจุดเดียว • หน้าสมาชิกรวมเครดิต โบนัส และประวัติรายการไว้ในบัญชีเดียว • สมัครผ่านมือถือไม่กี่ขั้นตอน แล้วเข้าเลือกสล็อตต่อได้เลย • ทางเข้า BUNNY555 เว็บหลัก รองรับทั้งมือถือและคอมด้วยบัญชีเดิม",
} = Astro.props;

const SCROLL_PX_PER_SEC = 50;
const PX_PER_CHAR = 6.2;
const TRAILING_PX = 81;
const scrollSeconds = Math.max(12, Math.round((message.length * PX_PER_CHAR + TRAILING_PX) / SCROLL_PX_PER_SEC));
---

<div class="mx-auto w-full max-w-7xl px-4 py-4 font-sans">
  <div
    class="relative flex overflow-hidden rounded-full border border-[#f9c2d9] bg-[#ffffff]/92 shadow-[0_8px_20px_rgba(190,24,93,0.14)] backdrop-blur-lg transition-shadow duration-300 hover:shadow-[0_8px_25px_rgba(236,72,153,0.24)]">
    <div
      class="relative z-10 flex shrink-0 items-center justify-center rounded-full bg-gradient-to-r from-[#f472b6] via-[#ec4899] to-[#be185d] px-8 py-2.5 font-black text-white shadow-[4px_0_15px_rgba(236,72,153,0.28)]">
      <span aria-hidden="true" class="mr-2 text-lg">👑</span> ประกาศ
    </div>

    <div class="marquee-container relative flex-1 overflow-hidden py-2.5 pr-6">
      <div aria-hidden="true" class="pointer-events-none absolute top-0 left-0 z-10 h-full w-12 bg-gradient-to-r from-[#ffffff] to-transparent"></div>

      <div class="marquee-content inline-block pl-4 text-sm font-medium tracking-wide whitespace-nowrap text-[#7a1038]" style={`animation-duration:${scrollSeconds}s`}>
        <span class="mr-10 inline-flex items-center gap-3"><span aria-hidden="true" class="h-2 w-2 rounded-full bg-[#e8a020] shadow-[0_0_8px_rgba(232,160,32,0.55)]"></span>{message}</span>
        <span aria-hidden="true" class="mr-10 inline-flex items-center gap-3"><span class="h-2 w-2 rounded-full bg-[#e8a020] shadow-[0_0_8px_rgba(232,160,32,0.55)]"></span>{message}</span>
      </div>
    </div>
  </div>
</div>

<style>
  .marquee-content {
    animation: marquee 25s linear infinite;
  }
  .marquee-container:hover .marquee-content {
    animation-play-state: paused;
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee-content {
      animation: none;
    }
  }
  @keyframes marquee {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }
</style>
