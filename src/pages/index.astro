---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement5 from "../components/Announcement5.astro";
import ContentBox from "../components/ContentBox.astro";
import ContentBoxCyberCut from "../components/ContentBoxCyberCut.astro";
import ContentBoxFloatingBadge from "../components/ContentBoxFloatingBadge.astro";
import ContentBoxTwoCyberCut from "../components/ContentBoxTwoCyberCut.astro";
import ContentBoxTwoFloatingBadge from "../components/ContentBoxTwoFloatingBadge.astro";
import ContentBoxSevenThreeCyberCut from "../components/ContentBoxSevenThreeCyberCut.astro";
import ContentBoxSevenThreeFloatingBadge from "../components/ContentBoxSevenThreeFloatingBadge.astro";
import ProviderGridPremium from "../components/ProviderGridPremium.astro";
import GameRankingBoard from "../components/GameRankingBoard.astro";
import LatestWinners2 from "../components/LatestWinners2.astro";
import SmoothCarousel from "../components/SmoothCarousel.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import Faq4 from "../components/Faq4.astro";
import ReviewCardSumo2 from "../components/ReviewCardSumo2.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import imgAutoSystem from "../assets/slide2.png";
import imgMemberSystem from "../assets/slide3.png";

const pageTitle = "ANDAMAN168 ทางเข้าหลัก บาคาร่า สล็อต ฟุตบอล ระบบออโต้ 24 ชม.";

const pageDescription = "ANDAMAN168 รวมบาคาร่า สล็อต ฟุตบอล และคาสิโนไว้ในบัญชีสมาชิกเดียว พร้อมเกมใหม่ปี 2026 ระบบออโต้ฝากถอน 24 ชั่วโมง รวมเครดิต โปรโมชั่น และประวัติไว้จุดเดียว";

const announcement =
  "ANDAMAN168 รวมบาคาร่า สล็อต ฟุตบอล และคาสิโนไว้ในบัญชีสมาชิกเดียว • แต่ละหมวดแยกให้เห็นชัด เข้าเกมที่ต้องการได้โดยไม่ต้องไล่เปิดเมนูทีละชั้น • ระบบออโต้จัดการฝากถอนและเช็กยอดได้ตลอด 24 ชั่วโมง • หน้าสมาชิกรวมเครดิต โปรโมชั่น และประวัติรายการไว้จุดเดียว • สมัครผ่านมือถือไม่กี่ขั้นตอนแล้วเลือกเกมต่อได้ทันที";

const autoSystemAlt =
  "ภาพโปรโมชั่น ANDAMAN168 พื้นทะเลอันดามันสีฟ้ามีเกาะหินและใบมะพร้าว มุมบนซ้ายเป็นโลโก้ ANDAMAN168 ตัวอักษรฟ้าวางบนดวงอาทิตย์ทอง ถัดลงมาเป็นตัวอักษรขนาดใหญ่ว่า ANDAMAN168 ตามด้วยบรรทัด บาคาร่า สล็อต ฟุตบอล และสองแถบข้อความว่า ระบบออโต้ 24 ชม. กับ สมัครสมาชิก ฝากถอนผ่านมือถือ ด้านล่างซ้ายเป็นวงล้อลุ้นรางวัลใหญ่ที่มีช่องรางวัลเงินสด ทองคำหนัก 1 บาท iPhone 15 Pro Max สร้อยคอทองคำ และอั่งเปาโบนัส ถัดมาเป็นภาพโทรศัพท์ สร้อยคอทองคำ และทองแท่ง ด้านขวาเป็นพรีเซนเตอร์หญิงชุดสีน้ำเงินยืนคู่กับไพ่โพดำ พร้อมป้ายว่า ทางเข้าหลัก เล่นง่าย แถบล่างสุดเขียนว่า รวมเกมครบในบัญชีเดียว มั่นคง ปลอดภัย ระบบเสถียร ไม่สะดุด และ บริการรวดเร็ว มืออาชีพ";

const memberSystemAlt =
  "ภาพโปรโมชั่น ANDAMAN168 พื้นทะเลสีฟ้ามีเกาะและใบมะพร้าว มุมบนซ้ายเป็นโลโก้ ANDAMAN168 ตัวอักษรฟ้าวางบนดวงอาทิตย์ทอง ตรงกลางเป็นตัวอักษรทองขนาดใหญ่ว่า คืนยอดเสีย 10% ใต้ลงมาเป็นบรรทัด แนะนำเพื่อน รับค่าคอม 1% ตามด้วยสองแถบข้อความว่า ANDAMAN168 ทางเข้าหลัก ระบบออโต้ 24 ชม. และ บาคาร่า สล็อต ฟุตบอล เล่นผ่านมือถือ ด้านหลังเป็นวงล้อรูเล็ต ด้านหน้าเป็นพรีเซนเตอร์หญิงชุดทองยืนคู่กับกองเหรียญทอง ลูกเต๋า ไพ่ และชิปคาสิโน VIP";

const faqs = [
  {
    q: "ANDAMAN168 รวมบาคาร่า สล็อต ฟุตบอล และคาสิโนไว้ในบัญชีเดียวจริงไหม",
    a: "เว็บแบ่งบริการหลักเป็นบาคาร่า สล็อต ฟุตบอล และคาสิโน โดยทุกหมวดเข้าถึงได้จากบัญชีสมาชิกเดียว แต่ละหมวดถูกแยกให้เห็นชัด สมาชิกจึงเข้าเกมที่ต้องการได้โดยไม่ต้องไล่เปิดเมนูทีละชั้น และไม่ต้องสมัครแยกตามประเภทเกม",
  },
  {
    q: "เกมใหม่ปี 2026 ของ ANDAMAN168 เพิ่มตัวเลือกอะไรให้สมาชิกบ้าง",
    a: "เกมใหม่ปี 2026 ช่วยเพิ่มตัวเลือกในหมวดสล็อตและคาสิโน ทำให้มีทั้งเกมที่คุ้นเคยและเกมรูปแบบใหม่ให้สลับเล่นตามสไตล์ที่ชอบ โดยยังเข้าถึงผ่านบัญชีสมาชิกชุดเดิม ส่วนคนที่มีเกมประจำก็ยังเลือกหมวดเดิมได้ง่ายเหมือนเดิม",
  },
  {
    q: "ระบบออโต้ ANDAMAN168 ฝากถอนและเช็กยอดได้ตลอด 24 ชั่วโมงหรือไม่",
    a: "ระบบออโต้รองรับการจัดการฝากถอนและเครดิตผ่านหน้าสมาชิกตลอด 24 ชั่วโมง สมาชิกทำรายการและดูข้อมูลยอดของตัวเองได้จากระบบเดียว จะเข้าใช้งานช่วงกลางวันหรือดึกก็จัดการบัญชีต่อได้ตามเวลาที่สะดวก",
  },
  {
    q: "สมัครสมาชิก ANDAMAN168 ผ่านมือถือต้องทำกี่ขั้นตอน",
    a: "การสมัครเริ่มจากกรอกข้อมูลที่ระบบสมาชิกกำหนด ตั้งค่าบัญชี แล้วเข้าสู่หน้าหลักเพื่อใช้งานบริการต่าง ๆ ขั้นตอนถูกออกแบบให้ใช้บนมือถือได้สะดวก จึงไม่ต้องรอเปิดคอมเพื่อเริ่มสมัครหรือเข้าสู่ระบบ",
  },
  {
    q: "ทางเข้า ANDAMAN168 เปิดผ่านมือถือและคอมได้พร้อมกันไหม",
    a: "ทางเข้ารองรับการเปิดผ่านมือถือ แท็บเล็ต และคอมพิวเตอร์ สมาชิกใช้บัญชีเดิมเพื่อเข้าสู่ระบบ เลือกเกม จัดการเครดิต และดูข้อมูลสมาชิกได้ตามอุปกรณ์ที่ใช้อยู่ในขณะนั้น หน้าเว็บเปลี่ยนตามขนาดจอ แต่ข้อมูลยังอยู่ในระบบเดิม",
  },
];

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement5 message={announcement} />

  <ContentBoxCyberCut as="h1" title="ANDAMAN168 รวมคาสิโน เกมใหม่ และระบบสมาชิก เล่นผ่านมือถือได้ครบในบัญชีเดียว">
    <div>
      <p class="text-left text-base leading-relaxed text-[#dbeefb]">
        <strong class="text-[#fdb524]">ANDAMAN168</strong> รวมบาคาร่า สล็อต ฟุตบอล คาสิโน และเกมออนไลน์หลายแบบไว้ในบัญชีสมาชิกเดียว พร้อมระบบออโต้สำหรับจัดการฝากถอนและเครดิต สมาชิกจึงเลือกเกม ดูยอด จะเปิดผ่านมือถือหรือคอมก็ใช้งานต่อได้ตามอุปกรณ์ที่สะดวก
      </p>
      <p class="mt-3 text-left text-base leading-relaxed text-[#dbeefb]">
        ตั้งแต่สมัคร ANDAMAN168 เข้าสู่ระบบ เลือกเกม ไปจนถึงจัดการยอดถูกวางให้เดินต่อกันได้ตรง ๆ เข้าเว็บมาเล่นเกมก็ควรได้เลือกเกมไว ไม่ใช่เปิดมาแล้วต้องเริ่มเกมแรกด้วยการหาเมนู
      </p>
    </div>
  </ContentBoxCyberCut>

  <div class="relative z-10 mx-auto mb-10 flex flex-nowrap justify-center gap-3 px-4 sm:gap-6">
    <a
      href="/login"
      class="group relative flex flex-1 items-center justify-center rounded-full bg-gradient-to-r from-[#ffe999] via-[#fdb524] to-[#b06f00] px-4 py-3 text-sm font-black whitespace-nowrap text-[#04182f] shadow-[0_10px_30px_rgba(253,181,36,0.30)] transition-all duration-300 hover:-translate-y-1 hover:scale-105 hover:shadow-[0_15px_40px_rgba(253,181,36,0.42)] sm:flex-none sm:px-10 sm:py-3.5 sm:text-base">
      เข้าสู่ระบบ
    </a>

    <a
      href="/register"
      class="group relative flex flex-1 items-center justify-center rounded-full border border-[#7fe6ff]/70 bg-[#062a4f]/85 px-4 py-3 text-sm font-black whitespace-nowrap text-[#ffe999] backdrop-blur-sm transition-all duration-300 hover:scale-105 hover:border-[#7fe6ff] hover:bg-[#0a3a68]/85 hover:shadow-[0_15px_40px_rgba(33,212,242,0.40)] sm:flex-none sm:px-10 sm:py-3.5 sm:text-base">
      สมัครสมาชิก
    </a>
  </div>

  <ContentBox as="h2" title="ANDAMAN168 รวมบาคาร่า สล็อต ฟุตบอล และคาสิโนไว้ครบ">
    <div>
      <p class="text-left text-base leading-relaxed text-[#dbeefb]">
        ANDAMAN168 แบ่งบริการหลักเป็นบาคาร่า สล็อต ฟุตบอล และคาสิโน ทำให้สมาชิกเลือกเล่นหลายแนวผ่านบัญชีเดียวได้สะดวก แต่ละหมวดถูกแยกให้เห็นชัด จึงเข้าเกมที่ต้องการได้โดยไม่ต้องไล่เปิดเมนูทีละชั้น
      </p>
      <p class="mt-3 text-left text-base leading-relaxed text-[#dbeefb]">
        คนที่ชอบเปลี่ยนแนวระหว่างวันก็ใช้งานได้คล่องขึ้น ช่วงหนึ่งเล่นสล็อต อีกช่วงดูฟุตบอล หรืออยากเปลี่ยนไปคาสิโนก็เลือกต่อจากหน้าเดิมได้ ความชอบเปลี่ยนได้ทุกชั่วโมง
        แต่หน้าเว็บไม่จำเป็นต้องเปลี่ยนตามจนคนใช้ตามไม่ทัน
      </p>
    </div>
  </ContentBox>

  <ProviderGridPremium />

  <ContentBoxFloatingBadge as="h2" title="บาคาร่าและสล็อต ANDAMAN168 เลือกเกมใหม่ปี 2026 ได้แบบไหน">
    <div>
      <p class="text-left text-base leading-relaxed text-[#dbeefb]">
        ANDAMAN168 รวมบาคาร่าและสล็อตเป็นสองหมวดเด่น โดยสล็อตมีพื้นที่สำหรับเกมใหม่และเกมหลายสไตล์ ส่วนบาคาร่าเน้นการเลือกโต๊ะและรูปแบบเกมคาสิโนที่ต้องการ สมาชิกจึงเริ่มจากประเภทที่ถนัดได้ทันที
      </p>
      <p class="mt-3 text-left text-base leading-relaxed text-[#dbeefb]">
        เกมใหม่ปี 2026 ช่วยเพิ่มตัวเลือกให้คนที่ไม่อยากวนอยู่กับรายชื่อเดิม ส่วนคนที่มีเกมประจำก็ยังเลือกหมวดเดิมได้ง่าย มีของใหม่ไว้ลองเป็นเรื่องดี
        แต่ของเก่าที่ชอบก็ไม่ควรถูกซ่อนเหมือนถุงเท้าข้างที่หายไปในเครื่องซักผ้า
      </p>
    </div>
  </ContentBoxFloatingBadge>

  <GameRankingBoard />

  <ContentBoxTwoCyberCut as="h2" title="ฟุตบอล ANDAMAN168 เลือกรายการและตลาดที่สนใจได้สะดวกอย่างไร">
    <p slot="left" class="text-left text-base leading-relaxed text-[#dbeefb]">
      ฟุตบอล ANDAMAN168 เป็นอีกหมวดสำหรับสมาชิกที่ชอบติดตามการแข่งขันกีฬา โดยสามารถเลือกดูรายการและตลาดที่เปิดให้เล่นจากบัญชีเดียวกับสล็อตและคาสิโน ทำให้ไม่ต้องสลับระบบเมื่อเปลี่ยนจากเกมคาสิโนมาดูกีฬา
    </p>
    <p slot="right" class="text-left text-base leading-relaxed text-[#dbeefb]">
      การแยกฟุตบอลออกเป็นหมวดเฉพาะช่วยให้เข้าถึงรายการที่สนใจได้ง่ายขึ้น โดยเฉพาะวันที่มีหลายคู่แข่งขันพร้อมกัน สมาชิกจึงใช้เวลาเลือกคู่มากกว่าใช้เวลาเลื่อนหาเมนู เพราะวันบอลเยอะ ตารางก็แน่นพอแล้ว
      หน้าเว็บไม่ต้องมาแน่นแข่งด้วย
    </p>
  </ContentBoxTwoCyberCut>

  <ContentBoxSevenThreeCyberCut as="h2" titleright="ระบบออโต้ ANDAMAN168 ฝากถอนและเช็กยอดได้ตลอด 24 ชั่วโมง">
    <Picture
      slot="left"
      src={imgAutoSystem}
      alt={autoSystemAlt}
      loading="lazy"
      fetchpriority="low"
      widths={[200, 400, 600]}
      sizes="(max-width: 768px) 100vw, 30vw"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      class="mx-auto h-auto w-full rounded-2xl border border-[#21d4f2]/40 shadow-[0_10px_30px_rgba(33,212,242,0.30)]"
    />
    <div slot="right">
      <p class="text-left text-base leading-relaxed text-[#dbeefb]">
        ระบบออโต้ ANDAMAN168 รองรับการจัดการฝากถอนและเครดิตผ่านหน้าสมาชิกตลอด 24 ชั่วโมง สมาชิกสามารถทำรายการและดูข้อมูลยอดของตัวเองได้จากระบบเดียว ช่วยให้ขั้นตอนก่อนเข้าเกมไม่ถูกแยกออกเป็นหลายส่วน
      </p>
      <p class="mt-3 text-left text-base leading-relaxed text-[#dbeefb]">
        ข้อดีของระบบอัตโนมัติคือใช้งานตามเวลาที่สะดวกได้มากขึ้น ไม่ว่าจะเข้าใช้งานช่วงกลางวันหรือดึกก็ยังจัดการบัญชีต่อได้ เป้าหมายคือทำรายการให้เสร็จแล้วไปเลือกเกมต่อ
        เพราะคงไม่มีใครอยากใช้เวลาว่างมานั่งเดาว่าปุ่มฝากอยู่ตรงไหน
      </p>
    </div>
  </ContentBoxSevenThreeCyberCut>

  <LatestWinners2 />

  <ContentBoxCyberCut as="h2" title="สมัครสมาชิก ANDAMAN168 เริ่มต้นผ่านมือถือได้กี่ขั้นตอน">
    <div>
      <p class="text-left text-base leading-relaxed text-[#dbeefb]">
        การสมัคร ANDAMAN168 เริ่มจากกรอกข้อมูลที่ระบบสมาชิกกำหนด ตั้งค่าบัญชี และเข้าสู่หน้าหลักเพื่อใช้งานบริการต่าง ๆ หลังสร้างบัญชีแล้ว สมาชิกสามารถเข้าถึงบาคาร่า สล็อต ฟุตบอล คาสิโน
        และเมนูการเงินจากบัญชีเดียว
      </p>
      <p class="mt-3 text-left text-base leading-relaxed text-[#dbeefb]">
        ขั้นตอนถูกออกแบบให้ใช้บนมือถือได้สะดวก จึงไม่จำเป็นต้องรอเปิดคอมเพื่อเริ่มสมัครหรือเข้าสู่ระบบ กรอกข้อมูลให้ครบแล้วใช้งานต่อได้เลย ชีวิตออนไลน์มี OTP กับรหัสผ่านให้จำเยอะพอแล้ว
        ขั้นตอนสมัครไม่ควรเพิ่มข้อสอบอีกชุด
      </p>
    </div>
  </ContentBoxCyberCut>

  <ContentBoxSevenThreeFloatingBadge as="h2" title="ระบบสมาชิก ANDAMAN168 รวมเครดิต โปรโมชั่น และประวัติไว้จุดเดียว">
    <Picture
      slot="left"
      src={imgMemberSystem}
      alt={memberSystemAlt}
      loading="lazy"
      fetchpriority="low"
      widths={[200, 400, 600]}
      sizes="(max-width: 768px) 100vw, 30vw"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
