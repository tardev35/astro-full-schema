---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";

import { Picture } from "astro:assets";

import pro1 from "../assets/slide1.jpg";

import pro2 from "../assets/slide2.jpg";

import pro3 from "../assets/slide3.jpg";

import pro4 from "../assets/slide4.jpg";
---

<MainLayout
  title="โปรโมชั่น KONG24H รวมโปรเด็ดดวง คุ้มที่สุด"
  description="โปรโมชั่น KONG24H แหล่งรวมโปรเด็ดดวง คืนกำไรให้สมาชิกแบบจัดเต็ม แจกโบนัสต้อนรับ เครดิตฟรีรายวัน และเงินคืนยอดเสีย คุณระเบิดความมันส์กับคาสิโนระดับโลก">
  <Announcement />

  <ContentBox>
    <h1 class="mb-7 bg-gradient-to-b from-[#ffffff] to-[#b91c1c] bg-clip-text text-3xl font-black text-transparent drop-shadow-[0_0_8px_rgba(185,28,28,0.5)]">
      โปรโมชั่น KONG24H รวมโปรเด็ดดวง คุ้มที่สุด
    </h1>

    <div class="mx-auto grid w-full max-w-7xl grid-cols-1 gap-6 px-4 sm:grid-cols-2 lg:grid-cols-2 xl:grid-cols-2">
      <Picture
        src={pro1}
        alt="กิจกรรมแจกรางวัลรวม 30 ล้านบาท"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600, 800]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class="mx-auto h-auto w-full rounded-xl border border-red-900/50 object-contain shadow-lg transition-transform duration-300 hover:-translate-y-1 hover:border-red-500 hover:shadow-[0_10px_20px_rgba(185,28,28,0.4)]"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />
      <Picture
        src={pro2}
        alt="สมัครใหม่รับโบนัส 100% ทันที"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600, 800]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class="mx-auto h-auto w-full rounded-xl border border-red-900/50 object-contain shadow-lg transition-transform duration-300 hover:-translate-y-1 hover:border-red-500 hover:shadow-[0_10px_20px_rgba(185,28,28,0.4)]"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />
      <Picture
        src={pro3}
        alt="ต้อนรับสมาชิกใหม่แจก เครดิตฟรี 50"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600, 800]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class="mx-auto h-auto w-full rounded-xl border border-red-900/50 object-contain shadow-lg transition-transform duration-300 hover:-translate-y-1 hover:border-red-500 hover:shadow-[0_10px_20px_rgba(185,28,28,0.4)]"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />
      <Picture
        src={pro4}
        alt="สมัครใหม่รับโบนัส 60% ทันที"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600, 800]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class="mx-auto h-auto w-full rounded-xl border border-red-900/50 object-contain shadow-lg transition-transform duration-300 hover:-translate-y-1 hover:border-red-500 hover:shadow-[0_10px_20px_rgba(185,28,28,0.4)]"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />
    </div>

    <div class="mt-12 flex justify-center pb-4">
      <a
        href="/register"
        class="flex items-center justify-center rounded-lg bg-gradient-to-r from-red-700 to-red-900 px-10 py-3.5 text-lg font-black text-white shadow-[0_0_20px_rgba(185,28,28,0.6)] transition-transform hover:scale-105">
        รับโปรโมชั่นทันที
      </a>
    </div>
  </ContentBox>
</MainLayout>

<Navfoot />
