---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";

import { Picture } from "astro:assets";

import pro1 from "../assets/slide1.png";
import pro2 from "../assets/slide2.png";
import pro3 from "../assets/slide3.png";
import pro4 from "../assets/slide4.png";
import pro5 from "../assets/slide5.png";
import { pageGraph } from "../lib/schema";

const pageTitle = "โปรโมชั่น VODKAFUN | แนะนำเพื่อน แคชแบ็ก เช็คอิน วงล้อนำโชค";

const pageHeading = "โปรโมชั่น VODKAFUN รวมโบนัสแนะนำเพื่อน แคชแบ็ก และวงล้อนำโชค";

const pageDescription =
  "รวมโปรโมชั่น VODKAFUN ไว้ในหน้าเดียว แนะนำเพื่อนรับ 0.8% แคชแบ็ก 3% กระเป๋าโบนัส เช็คอินรายวัน และวงล้อนำโชค ดูรายละเอียดบนภาพแล้วสมัครสมาชิกรับสิทธิ์ได้เลย";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: pro1.src,
});

const promoClass =
  "mx-auto h-auto w-full rounded-xl border border-[#1d5c22] object-contain shadow-[0_10px_30px_rgba(200,252,4,0.14)] transition-all duration-300 hover:-translate-y-1 hover:border-[#c8fc04]/55 hover:shadow-[0_15px_40px_rgba(200,252,4,0.28)]";
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageHeading} as="h1">
    <p class="mb-4 text-left text-base leading-relaxed">
      หากคุณกำลังมองหาโปรโมชั่นที่ใช้ได้จริงทุกวัน <strong class="text-[#c8fc04]">VODKAFUN</strong> พร้อมมอบทั้งโบนัสแนะนำเพื่อน แคชแบ็กคืนยอดเสีย กระเป๋าโบนัส เช็คอินประจำวัน และวงล้อนำโชค รวมไว้ให้เลือกครบในหน้าเดียว
    </p>

    <p class="mb-8 text-left text-base leading-relaxed">
      แต่ละโปรโมชั่นมีเงื่อนไขและช่วงเวลารับสิทธิ์ต่างกัน ตรวจสอบรายละเอียดล่าสุดในระบบสมาชิกก่อนกดรับทุกครั้ง เพื่อให้ทุกยอดฝากของคุณได้สิทธิ์ครบตามที่ตั้งใจ
    </p>

    <div class="grid w-full grid-cols-1 gap-6 sm:grid-cols-2">
      <Picture
        src={pro1}
        alt="ภาพโปรโมชั่น VODKAFUN ข้อความว่า แนะนำเพื่อน รับโบนัส 0.8% สร้างรายได้ 100,000 ต่อเดือน พรีเซนเตอร์หญิงชุดดำเขียวผมไฮไลต์เขียวยืนคู่กัน ด้านหลังเป็นสนามสีเขียวเข้มพร้อมโลโก้ VODKAFUN"
        loading="lazy"
        fetchpriority="low"
        widths={[400, 600]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class={promoClass}
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />

      <Picture
        src={pro2}
        alt="ภาพโปรโมชั่น VODKAFUN ข้อความว่า CASHBACK 3% คืนยอดเสียทุกยอดฝาก เล่นถึง 50% ถอนได้เลย รับสิทธิ์ก่อน 23.59 น. ของทุกวัน พรีเซนเตอร์หญิงชุดดำเขียวผมไฮไลต์เขียว ด้านหลังเป็นสนามสีเขียวเข้มพร้อมโลโก้ VODKAFUN"
        loading="lazy"
        fetchpriority="low"
        widths={[400, 600]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class={promoClass}
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />

      <Picture
        src={pro3}
        alt="ภาพโปรโมชั่น VODKAFUN ข้อความว่า กระเป๋าโบนัส รวมยอดคืนยอดเสีย ค่าแนะนำเพื่อน และโบนัสเช็คอิน ถอนเครดิตเกมหรือเงินสด พรีเซนเตอร์หญิงชุดดำเขียวผมไฮไลต์เขียว ด้านหลังเป็นสนามสีเขียวเข้มพร้อมโลโก้ VODKAFUN"
        loading="lazy"
        fetchpriority="low"
        widths={[400, 600]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class={promoClass}
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />

      <Picture
        src={pro4}
        alt="ภาพโปรโมชั่น VODKAFUN ข้อความว่า เช็คอินประจำวัน รับรางวัลทุกวัน เช็คอินง่าย ลุ้นของรางวัลมากมาย พรีเซนเตอร์หญิงชุดดำเขียวผมไฮไลต์เขียว ด้านหลังเป็นสนามสีเขียวเข้มพร้อมโลโก้ VODKAFUN"
        loading="lazy"
        fetchpriority="low"
        widths={[400, 600]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class={promoClass}
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />

      <Picture
        src={pro5}
        alt="ภาพโปรโมชั่น VODKAFUN ข้อความว่า วงล้อนำโชค ลุ้นรับรางวัลมูลค่ามากกว่า 1 ล้านบาท ฝาก 500 บาท รับ 1 ตั๋วสุ่มวงล้อ พรีเซนเตอร์หญิงชุดดำเขียวผมไฮไลต์เขียวข้างวงล้อรางวัล ด้านหลังเป็นสนามสีเขียวเข้มพร้อมโลโก้ VODKAFUN"
        loading="lazy"
        fetchpriority="low"
        widths={[400, 600]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class={promoClass}
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />
    </div>

    <div class="mt-12 flex justify-center pb-4">
      <a
        href="/register/"
        class="flex items-center justify-center rounded-xl bg-gradient-to-r from-[#e6ff6a] via-[#c8fc04] to-[#7ee000] px-10 py-3.5 text-lg font-black text-[#0b2a05] shadow-[0_10px_30px_rgba(200,252,4,0.35)] transition-transform hover:scale-105 hover:shadow-[0_15px_40px_rgba(200,252,4,0.5)]">
        สมัครสมาชิก VODKAFUN
      </a>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
