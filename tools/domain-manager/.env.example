# Copy this file to ".env" (same folder) and fill in the real password.
# .env is gitignored — the password must NEVER be committed.
#
# This lets a machine with no SSH key to the hosting server add domains using
# the server's password instead.

VPS_HOST=45.32.122.181
VPS_USER=root
VPS_PASSWORD=changeme

# The aaPanel server is a different machine with its own root password, so it
# gets its own three keys rather than reusing the ones above. Leave the password
# empty and the uploader's "aaPanel" deploy option refuses to run and says why,
# instead of trying the wrong credentials against the wrong host.
AAPANEL_HOST=187.52.122.249
AAPANEL_USER=root
AAPANEL_PASSWORD=

# Optional overrides:
# PORT=3000
# HOST=127.0.0.1
