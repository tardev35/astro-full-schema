---
const reviews = [
  {
    name: "สมาชิกที่ใช้บัญชีเดียวจัดการทุกอย่าง",
    role: "รวมสล็อต คาสิโนสด และเครดิตไว้ที่เดียว",
    stars: 5,
    tag: "ระบบสมาชิกบัญชีเดียว",
    content:
      "ที่ถูกใจคือไม่ต้องเปิดหลายหน้าครับ เข้าสู่ระบบครั้งเดียวแล้วเลือกสล็อต เช็กเครดิต หรือย้อนดูประวัติรายการได้จากจุดเดียว วันไหนอยากเปลี่ยนไปเล่นเกมโต๊ะก็เปลี่ยนได้ทันที ใช้เครดิตชุดเดิมไม่ต้องสลับบัญชีให้ปวดหัว",
    avatar: "👑",
  },
  {
    name: "สมาชิกที่สลับไปเล่นคาสิโนสด",
    role: "เปลี่ยนบรรยากาศจากเกมหมุนไปเกมโต๊ะ",
    stars: 5,
    tag: "คาสิโนสดเรียลไทม์",
    content:
      "บางวันหมุนสล็อตจนเบื่อก็กดเข้าคาสิโนสดต่อได้เลยค่ะ บรรยากาศเกมโต๊ะแบบเรียลไทม์คนละอารมณ์กับเกมหมุน แต่ยังใช้บัญชีสมาชิกเดิม ไม่ต้องสมัครใหม่หรือย้ายเครดิตไปมาให้เสียเวลา",
    avatar: "🃏",
  },
  {
    name: "สมาชิกที่ทำรายการผ่านมือถือเป็นหลัก",
    role: "ฝากถอนด้วยระบบออโต้จากหน้าสมาชิก",
    stars: 5,
    tag: "ระบบออโต้ฝากถอน",
    content:
      "ผมทำรายการจากมือถืออย่างเดียวครับ ระบบออโต้ทำให้ขั้นตอนฝากถอนสั้นลง ไม่ต้องรอให้ใครมากดอนุมัติ พอรายการเชื่อมกับบัญชีสมาชิกก็เช็กเครดิตแล้วกลับเข้าเกมต่อได้จากหน้าเดียวเลย",
    avatar: "⚡",
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label="เสียงจากสมาชิก 888NEO" class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#ffe9a8] via-[#f5c542] to-[#ff5a4d] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      เสียงจากสมาชิก <span class="text-[#f5c542]">888NEO</span>
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#f5c542] to-transparent"></div>
  </div>

  <div class="mx-auto mb-8 flex max-w-md items-center justify-center gap-5 rounded-2xl border border-[#f5c542]/25 bg-[#1c0a06]/92 px-6 py-4 shadow-[0_10px_30px_rgba(11,5,3,0.5)] backdrop-blur-xl">
    <div class="flex flex-col items-center">
      <span class="bg-gradient-to-b from-[#ffe9a8] to-[#b8860b] bg-clip-text text-4xl leading-none font-black text-transparent">{average}</span>
      <span class="mt-1 text-[10px] font-bold tracking-widest text-[#f3e3c6]/70 uppercase">คะแนนเฉลี่ย</span>
    </div>
    <div class="h-12 w-px bg-[#2a1109]"></div>
    <div class="flex flex-col gap-1.5">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#f5c542]" : "text-[#2a1109]"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#f3e3c6]/70">คะแนนเฉลี่ย {average} จาก 5 ดาว จากการใช้งานจริงของสมาชิก {reviews.length} ด้าน</span>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
    {
      reviews.map((review) => (
        <article class="group relative isolate flex flex-col gap-4 overflow-hidden rounded-2xl border border-[#f5c542]/25 bg-[#1c0a06]/92 p-6 text-left shadow-[0_10px_30px_rgba(11,5,3,0.5)] backdrop-blur-xl transition-all duration-300 hover:-translate-y-1 hover:border-[#f5c542]/55 hover:shadow-[0_15px_40px_rgba(245,197,66,0.30)]">
          <span class="absolute inset-y-0 left-0 -z-10 w-1 bg-gradient-to-b from-[#ffe9a8] to-[#e01b1b] opacity-80 transition-opacity duration-300 group-hover:opacity-100" />
          <span class="pointer-events-none absolute -top-14 -right-14 -z-10 h-32 w-32 rounded-full bg-[#e01b1b]/45 blur-[50px] transition-all duration-300 group-hover:bg-[#f5c542]/25" />

          <div class="flex items-center justify-between gap-3">
            <span class="inline-flex items-center gap-1.5 rounded-full border border-[#f5c542]/25 bg-[#2a1109] px-3 py-1 text-[10px] font-bold tracking-widest text-[#f5c542] uppercase">
              <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#f5c542]" />
              {review.tag}
            </span>
            <span class="flex gap-0.5 text-sm">
              <span aria-hidden="true" class="flex gap-0.5">
                {Array.from({ length: 5 }).map((_, i) => (
                  <span class={i < review.stars ? "text-[#f5c542]" : "text-[#2a1109]"}>★</span>
                ))}
              </span>
              <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
            </span>
          </div>

          <p class="text-left text-base leading-relaxed text-[#f3e3c6]">{review.content}</p>

          <div class="mt-auto flex items-center gap-3 border-t border-[#2a1109] pt-4">
            <span
              aria-hidden="true"
              class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#f5c542]/30 bg-gradient-to-br from-[#ffe9a8] via-[#f5c542] to-[#8c0f12] text-xl shadow-inner transition-transform duration-300 group-hover:scale-110">
              {review.avatar}
            </span>
            <span class="flex flex-col">
              <span class="text-sm font-black text-[#f3e3c6] transition-colors group-hover:text-[#ffe9a8]">{review.name}</span>
              <span class="text-[10px] font-bold tracking-wider text-[#f3e3c6]/70 uppercase">{review.role}</span>
            </span>
          </div>
        </article>
      ))
    }
  </div>
</section>
