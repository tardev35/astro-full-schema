---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement3 from "../components/Announcement3.astro";
import { pageGraph } from "../lib/schema";

const pageTitle = "เกี่ยวกับเรา YIMSIAM889 สล็อตสยาม เว็บตรงไม่ผ่านเอเย่นต์";

const pageDescription =
  "เกี่ยวกับเรา YIMSIAM889 สล็อตสยาม เว็บตรงไม่ผ่านเอเย่นต์ ความบันเทิงฉบับไทยแท้ ยิ้มรับโปรสมาชิกใหม่ ฝากถอนอัตโนมัติ ทางเข้ารองรับทุกอุปกรณ์ เล่นได้ทุกที่";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement3 />

  <ContentBox as="h1" title={pageTitle}>
    <p class="mb-4 text-left text-base leading-relaxed text-[#f2ddc4]">
      YIMSIAM889 (ยิ้มสยาม889) คืออาณาจักรความบันเทิงที่ก่อร่างขึ้นจากคติสั้นๆ เพียงข้อเดียวขอรับ นั่นคือ “บริการด้วยใจ ยิ้มแย้มแจ่มใสแบบไทยแท้”
      เราไม่ได้ตั้งใจเปิดเป็นห้างสรรพสินค้าที่มีขายทุกสิ่งอย่าง แต่ตั้งใจทำ สล็อตสยาม ให้ดีจริงอยู่เรื่องเดียว คัดสรรเฉพาะเกมที่ถูกจริตพี่น้องชาวไทย เล่นง่าย กติกาไม่ซับซ้อนซ่อนเงื่อน
      เพราะเราเชื่อว่าความสนุกที่ดีไม่จำเป็นต้องวุ่นวาย ขอเพียงระบบชัดเจนและเชื่อถือได้ ท่านก็ยิ้มได้ในทุกการหมุนวงล้อแล้วขอรับ
    </p>

    <p class="text-left text-base leading-relaxed text-[#f2ddc4]">
      คำว่า “สยาม” ในชื่อของเราไม่ได้เป็นเพียงคำเรียกขานให้ไพเราะ หากแต่สะท้อนแนวคิดการให้บริการที่สุภาพ ไม่เร่ง ไม่กดดัน และให้เกียรติผู้เล่นทุกท่านเสมอกัน
      หน้าเว็บชุดนี้ทำหน้าที่เป็นหน้าข้อมูลและแนะนำ ออกแบบให้อ่านง่ายสบายตา เมนูภาษาไทยชัดเจน ไม่ต้องแปลไทยเป็นไทยอีกรอบ ท่านจึงหาสิ่งที่ต้องการเจอตั้งแต่ครั้งแรกที่เปิดเข้ามา
    </p>
  </ContentBox>

  <ContentBox as="h2" title="เว็บตรงแตกดีจริง เชื่อมสัญญาณจากค่ายแม่ ไม่ผ่านเอเย่นต์">
    <p class="mb-4 text-left text-base leading-relaxed text-[#f2ddc4]">
      เรื่องความซื่อสัตย์สุจริตนั้นเป็นสมบัติของผู้ดีขอรับ YIMSIAM889 ให้บริการในรูปแบบของเว็บตรง ไม่ผ่านเอเย่นต์หรือนายหน้าค้าความใดๆ ทั้งสิ้น
      เราเชื่อมต่อสัญญาณเกมโดยตรงจากค่ายผู้พัฒนา ระบบเกมจึงมีความเสถียรและยุติธรรมที่สุดเท่าที่จะเป็นไปได้ ทั้ง PG SOFT ที่ขึ้นชื่อเรื่องกราฟิก 3D อันวิจิตรบรรจง
      Joker Gaming ตำนานสล็อตยุคคลาสสิกที่ยังแจกรางวัลหนักอย่างสม่ำเสมอ และ Pragmatic Play ค่ายใหญ่ระดับโลกที่ฟีเจอร์แพรวพราวจ่ายหนักไม่มีกั๊ก ล้วนเป็นลิขสิทธิ์แท้ทั้งสิ้น
    </p>

    <p class="text-left text-base leading-relaxed text-[#f2ddc4]">
      คำว่า เว็บตรงแตกดีจริง ของเราจึงไม่ได้กล่าวเกินจริงแต่อย่างใด เพราะเมื่อระบบมันตรงไปตรงมา อัตราการชนะหรือค่า RTP ก็เป็นไปตามมาตรฐานสากลที่ค่ายแม่กำหนดมา
      ไม่มีใครมาแอบปรับหลังบ้านให้ท่านหงุดหงิดหัวใจ วัดกันที่ดวงและฝีมือล้วนๆ การแตกของเกมขึ้นอยู่กับจังหวะและการเล่นจริง โปร่งใส ตรวจสอบได้ทุกขั้นตอนขอรับ
    </p>
  </ContentBox>

  <ContentBox as="h2" title="ยิ้มรับโปรสมาชิกใหม่ ธุรกรรมว่องไวด้วยระบบอัตโนมัติ">
    <p class="mb-4 text-left text-base leading-relaxed text-[#f2ddc4]">
      การต้อนรับแขกบ้านแขกเมืองเป็นธรรมเนียมไทยแท้ขอรับ สำหรับท่านที่เพิ่งก้าวเข้ามาเป็นส่วนหนึ่งของครอบครัวเรา เราจึงจัดเตรียมของขวัญต้อนรับไว้ให้ได้ ยิ้มรับโปรสมาชิกใหม่ กันแบบแก้มปริ
      ไม่ว่าจะเป็นโบนัสเพิ่มทุนหรือสิทธิพิเศษต่างๆ ล้วนจัดสรรมาอย่างเหมาะสม เพื่อให้ท่านมีกระสุนในการเริ่มเล่นที่มากขึ้น เริ่มต้นความสนุกได้อย่างมั่นใจโดยไม่ต้องกังวลเรื่องทุนรอน
    </p>

    <p class="text-left text-base leading-relaxed text-[#f2ddc4]">
      ส่วนเรื่องเงินๆ ทองๆ นั้นต้องรอบคอบ แต่ก็ต้องรวดเร็วด้วยเช่นกัน ระบบฝาก-ถอนของเราจึงเป็นระบบอัตโนมัติเต็มรูปแบบ ท่านทำรายการได้ด้วยตัวเองผ่านแอปพลิเคชันธนาคารชั้นนำหรือทรูวอลเลท
      ไม่ต้องส่งสลิปให้แอดมินตรวจให้เสียเวลา ฝากปุ๊บเงินเข้าปั๊บ ถอนปุ๊บโอนเข้าบัญชีทันที ถูกต้อง แม่นยำ และปลอดภัยสูงสุด ให้ท่านสบายใจได้ว่าทุกบาททุกสตางค์จะถูกดูแลเป็นอย่างดี
    </p>
  </ContentBox>

  <ContentBox as="h2" title="ทางเข้าที่รองรับทุกอุปกรณ์ และคำแนะนำก่อนเริ่มเล่น">
    <p class="mb-4 text-left text-base leading-relaxed text-[#f2ddc4]">
      ในยุคสมัยนี้ความสะดวกสบายเป็นปัจจัยที่ต้องนำมาคิดพัฒนา ไม่ว่าท่านจะนอนเล่นเอกเขนกอยู่บนเรือน เดินทางไกล หรือพักผ่อนหย่อนใจที่ใด ก็เข้าถึงทางเข้าของ YIMSIAM889 ได้โดยง่าย
      รองรับทั้งโทรศัพท์มือถือ iOS และ Android รวมถึงคอมพิวเตอร์และแท็บเล็ต หน้าเว็บลื่นไหลไม่มีสะดุด ให้ท่านพกพาความสนุกติดตัวไปได้ทุกที่ทุกเวลา
    </p>

    <p class="text-left text-base leading-relaxed text-[#f2ddc4]">
      สิ่งที่เขียนไว้บนหน้านี้ตั้งใจให้อ่านแล้วนำไปตรวจสอบต่อได้จริง มิใช่ถ้อยคำโฆษณาลอยๆ เช่น เรื่องการจ่ายจริงควรดูจากสถานะการถอนและประวัติรายการในบัญชีของท่านเอง ไม่ใช่จากข้อความบนแบนเนอร์
      และควรตรวจชื่อเว็บไซต์กับการเชื่อมต่อแบบ HTTPS ทุกครั้งก่อนล็อกอิน ไม่ควรส่งรหัสผ่านหรือรหัส OTP ให้บุคคลอื่นไม่ว่ากรณีใด หากติดขัดตรงไหน ทักไลน์เข้ามาปรึกษากันได้เสมอขอรับ
    </p>
  </ContentBox>

  <Navfoot />
</MainLayout>
