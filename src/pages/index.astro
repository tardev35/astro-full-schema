---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement6 from "../components/Announcement6.astro";
import ContentBox from "../components/ContentBox.astro";
import ContentBoxNeumorphism from "../components/ContentBoxNeumorphism.astro";
import ContentBoxFloatingBadge from "../components/ContentBoxFloatingBadge.astro";
import ContentBoxTwoNeumorphism from "../components/ContentBoxTwoNeumorphism.astro";
import ContentBoxTwoFloatingBadge from "../components/ContentBoxTwoFloatingBadge.astro";
import ContentBoxSevenThreeNeumorphism from "../components/ContentBoxSevenThreeNeumorphism.astro";
import ContentBoxSevenThreeFloatingBadge from "../components/ContentBoxSevenThreeFloatingBadge.astro";
import ContentBoxSpecial from "../components/ContentBoxSpecial.astro";
import LottoGrid from "../components/LottoGrid.astro";
import ProviderGrid from "../components/ProviderGrid.astro";
import GameRankingBoard from "../components/GameRankingBoard.astro";
import LatestWinners4 from "../components/LatestWinners4.astro";
import SmoothCarousel from "../components/SmoothCarousel.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import Faq2 from "../components/Faq2.astro";
import ReviewCardSumo2 from "../components/ReviewCardSumo2.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import imgMarket from "../assets/slide1.png";
import imgMobile from "../assets/slide4.png";

const pageTitle = "POE888 หวยออนไลน์ แทงหวยไทยลาว เว็บสีฟ้า ตรวจผลไว ถอนง่าย";

const pageDescription =
  "POE888 รวมหวยไทย หวยลาว และตลาดหวยออนไลน์ไว้ในเว็บสีฟ้า พร้อมระบบสมาชิก ตรวจผลผ่านมือถือ ฝากถอนสะดวก และทางเข้าใช้งานได้ตลอดวัน";

const announcement =
  "POE888 เว็บสีฟ้า รวมหวยไทย หวยลาว หวยฮานอย และหวยมาเลย์ไว้ในบัญชีเดียว รองรับทั้งมือถือและคอม • หวยไทยเลือกเลขและจัดรายการไว้ในโพยก่อนยืนยัน ตรวจเลขและยอดรวมได้จากหน้าจอเดียว • หวยลาวแยกตลาดและรอบตามช่วงที่เปิดรับ เช็กข้อมูลของรายการก่อนส่งโพยได้ทุกครั้ง • แต่ละตลาดมีรอบและเวลาปิดรับต่างกัน ควรเช็กข้อมูลของงวดก่อนยืนยันโพย • หลังผลออกนำผลหวยมาเทียบกับเลขที่บันทึกไว้ในโพยได้จากบัญชีเดิม • ระบบสมาชิกรวมโพย เครดิต และประวัติรายการไว้ในพื้นที่เดียว • ฝากถอนและจัดการเครดิตผ่านหน้าบัญชี ตรวจสอบยอดที่เกี่ยวข้องได้จากระบบเดียว • นอกจากหวยยังมีหมวดเกมและกีฬาเป็นตัวเลือกเพิ่มเติมด้วยบัญชีเดียวกัน • ทางเข้า POE888 เว็บสีฟ้าใช้งานได้ทั้งมือถือและคอมด้วยบัญชีเดิม";

const marketAlt =
  "ภาพโปรโมชั่น POE888 พื้นหลังโทนน้ำเงินสดใส มีลูกบอลหวยหมายเลข 9 3 8 5 4 และ 7 กับสลากลอตเตอรี่ลอยอยู่รอบภาพ ด้านบนเป็นโลโก้ POE888 รูปหมีแพนด้าในตัวอักษร P พร้อมข้อความว่า โป888 ตรงกลางเป็นตัวอักษรทองขนาดใหญ่ว่า POE888 คู่กับคำว่า หวยออนไลน์ ถัดลงมาเป็นป้ายเขียนว่า แทงหวยไทย-ลาว ตรวจผลไว ถอนง่าย และ เว็บสีฟ้า ใช้งานง่าย จ่ายไว ใต้ลงมาเป็นป้ายสามช่องพร้อมไอคอนเขียนว่า ดูผลเร็ว ซื้อสะดวก และ เล่นได้ทุกวัน ด้านขวาเป็นพรีเซนเตอร์หญิงสวมชุดสีน้ำเงินสลับทองสกรีนคำว่า POE888 ถือสลากลอตเตอรี่คลี่เป็นพัด ด้านซ้ายล่างเป็นมาสคอตแพนด้าถือเหรียญทองพร้อมป้ายชื่อ POE888 แถวล่างสุดเป็นปุ่มธงสี่ตลาดเขียนว่า หวยไทย หวยลาว หวยฮานอย และ หวยมาเลย์";

const mobileAlt =
  "ภาพโปรโมชั่น POE888 พื้นหลังโทนน้ำเงิน มีลูกบอลหวยหมายเลข 9 10 1 11 และ 7 กับเหรียญทองกระจายอยู่ ด้านบนซ้ายเป็นโลโก้ POE888 รูปหมีแพนด้าในตัวอักษร P ตรงกลางเป็นตัวอักษรทองขนาดใหญ่ว่า POE888 คู่กับคำว่า หวยออนไลน์ ถัดลงมาเป็นป้ายเขียนว่า แทงหวยไทย-ลาว ตรวจผลไว ถอนง่าย และ เว็บสีฟ้า ใช้งานง่าย จ่ายไว ใต้ลงมาเป็นแถบเดียวพร้อมไอคอนเขียนว่า ดูผลเร็ว ถอนสะดวก และ เล่นได้ทุกวัน ด้านขวาเป็นพรีเซนเตอร์หญิงสวมชุดเชียร์สีน้ำเงินสลับเหลืองสกรีนคำว่า POE888 มือหนึ่งถือใบโพยหวยคลี่เป็นพัด อีกมือถือโทรศัพท์ที่เปิดหน้าแอป POE888 แสดงรายการตลาดหวย แถวล่างเป็นปุ่มธงสี่ตลาดวางบนเวทีสีฟ้าเขียนว่า หวยไทย หวยลาว หวยฮานอย และ หวยมาเลย์";

const faqs = [
  {
    q: "POE888 หวยออนไลน์ มีตลาดไหนให้เลือกแทงบ้าง",
    a: "POE888 วางหวยไทยและหวยลาวเป็นตลาดหลัก พร้อมพื้นที่สำหรับหวยออนไลน์ประเภทอื่นอย่างหวยฮานอยและหวยมาเลย์ ทำให้สมาชิกเลือกตลาดที่ติดตามและจัดโพยผ่านบัญชีเดียวได้ แต่ละตลาดมีรอบและเวลาปิดรับต่างกัน จึงควรเช็กข้อมูลของงวดก่อนยืนยันโพยทุกครั้ง",
  },
  {
    q: "หวยไทยและหวยลาวของ POE888 เลือกเลขและจัดโพยอย่างไร",
    a: "หวยไทย POE888 ให้สมาชิกเลือกเลขและจัดรายการที่ต้องการไว้ในโพยก่อนยืนยัน จึงตรวจเลขและยอดรวมอีกครั้งได้จากหน้าจอเดียว ส่วนหวยลาวแยกตลาดและรอบให้เลือกตามช่วงที่เปิดรับ พร้อมตรวจสอบข้อมูลของรายการก่อนส่งโพยผ่านมือถือได้เช่นกัน",
  },
  {
    q: "ตรวจผลหวยออนไลน์แล้วเช็กเลขที่แทงไว้ได้อย่างไร",
    a: "หลังผลออก สมาชิกสามารถนำผลหวยมาเทียบกับเลขที่บันทึกไว้ในโพย เพื่อดูผลของแต่ละรายการโดยไม่ต้องจำตัวเลขทั้งหมดเอง POE888 เก็บประวัติโพยไว้กับบัญชี ทำให้ย้อนดูรายการก่อนหน้าได้ง่ายแม้จะส่งโพยไว้หลายงวดหลายตลาด",
  },
  {
    q: "ระบบสมาชิกและการฝากถอนเครดิตของ POE888 อยู่ตรงไหน",
    a: "ระบบสมาชิก POE888 รวมโพย เครดิต และประวัติรายการไว้ในพื้นที่เดียว สมาชิกจึงตรวจสอบได้ว่ามีรายการไหนส่งแล้วหรือเคยใช้งานตลาดใดบ้าง ส่วนการจัดการเครดิตทำผ่านหน้าบัญชีได้โดยตรง พร้อมตรวจสอบรายการฝากถอนและยอดที่เกี่ยวข้องจากระบบเดียว",
  },
  {
    q: "ทางเข้า POE888 เว็บสีฟ้า ใช้งานผ่านมือถือและคอมอย่างไร",
    a: "ทางเข้า POE888 เว็บสีฟ้ารองรับทั้งมือถือและคอม สมาชิกใช้บัญชีเดิมเพื่อเข้าถึงตลาดหวย โพย ผลรางวัล และข้อมูลส่วนตัวได้จากจุดเดียว การใช้ทางเข้าหลักยังช่วยลดความสับสนจากชื่อเว็บไซต์ที่คล้ายกันบนผลค้นหา และนอกจากหวยยังมีหมวดเกมกับกีฬาเป็นตัวเลือกเพิ่มเติม",
  },
];

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement6 message={announcement} />

  <ContentBoxNeumorphism as="h1" title="POE888 เว็บสีฟ้า รวมหวยออนไลน์ ไทยลาว ตรวจผลและจัดการโพยในบัญชีเดียว">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#dbeafe]">
        <strong class="text-[#ffd93d]">POE888</strong> เน้นหวยออนไลน์เป็นหมวดหลัก รวมการเลือกเลข จัดโพย ตรวจผล และดูประวัติรายการไว้ในบัญชีเดียว รองรับมือถือ เหมาะกับคนที่ติดตามทั้งหวยไทยและหวยลาวเป็นประจำ
      </p>
      <p class="text-left text-base leading-relaxed text-[#dbeafe]">
        เว็บสีฟ้าจัดเมนูให้เข้าถึงตลาดหวยและข้อมูลสมาชิกได้จากจุดเดียว ลดการสลับหลายหน้า เพราะเรื่องตัวเลขซับซ้อนพอแล้ว หน้าเว็บไม่จำเป็นต้องมาช่วยเพิ่มโจทย์
      </p>
    </div>
  </ContentBoxNeumorphism>

  <ContentBoxSevenThreeNeumorphism as="h2" titleright="POE888 หวยออนไลน์ มีตลาดไหนให้เลือกแทงบ้าง">
    <Picture
      slot="left"
      src={imgMarket}
      alt={marketAlt}
      loading="lazy"
      fetchpriority="low"
      widths={[200, 400, 600]}
      sizes="(max-width: 768px) 100vw, 30vw"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      class="mx-auto h-auto w-full rounded-2xl border border-[#2e8bff]/40 shadow-[0_10px_30px_rgba(11,78,168,0.30)]"
    />
    <div slot="right" class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#dbeafe]">
        POE888 วางหวยไทยและหวยลาวเป็นตลาดหลัก พร้อมพื้นที่สำหรับหวยออนไลน์ประเภทอื่น ทำให้สมาชิกเลือกตลาดที่ติดตามและจัดโพยผ่านบัญชีเดียวได้
      </p>
      <p class="text-left text-base leading-relaxed text-[#dbeafe]">
        แต่ละตลาดมีรอบและเวลาปิดรับต่างกัน จึงควรเช็กข้อมูลของงวดก่อนยืนยันโพย คนเล่นหลายตลาดมีได้ แต่โพยไหนส่งแล้วต้องรู้ว่าไปอยู่ตลาดไหน
      </p>
    </div>
  </ContentBoxSevenThreeNeumorphism>

  <LottoGrid />

  <ContentBoxFloatingBadge as="h2" title="หวยไทย POE888 เลือกเลขและจัดโพยออนไลน์ได้ง่ายแค่ไหน">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#dbeafe]">
        หวยไทย POE888 ให้สมาชิกเลือกเลขและจัดรายการที่ต้องการไว้ในโพยก่อนยืนยัน ช่วยให้ตรวจเลขและยอดรวมอีกครั้งผ่านหน้าจอเดียว
      </p>
      <p class="text-left text-base leading-relaxed text-[#dbeafe]">
        คนมีเลขหลายชุดจึงจัดการง่ายกว่าจดกระดาษหลายใบ เลขเด็ดมีไว้ลุ้น ส่วนโพยควรเรียบร้อยไว้ก่อน เดี๋ยวถูกแล้วหาไม่เจอจะเสียทรง
      </p>
    </div>
  </ContentBoxFloatingBadge>

  <ContentBoxTwoNeumorphism as="h2" title="หวยลาว POE888 มีรอบให้ติดตามและตรวจผลอย่างไร">
    <p slot="left" class="text-left text-base leading-relaxed text-[#dbeafe]">
      หวยลาว POE888 แยกตลาดและรอบให้สมาชิกเลือกตามช่วงที่เปิดรับ พร้อมตรวจสอบข้อมูลของรายการก่อนส่งโพยผ่านมือถือได้
    </p>
    <p slot="right" class="text-left text-base leading-relaxed text-[#dbeafe]">
      หลังประกาศผลสามารถกลับมาเทียบกับรายการที่แทงไว้ได้จากบัญชีเดิม จบเป็นรอบ ๆ ชัดเจน ไม่ต้องเปิดสิบแท็บเพื่อจำว่าเลขชุดนี้ซื้อไว้ที่ไหน
    </p>
  </ContentBoxTwoNeumorphism>

  <ContentBoxSevenThreeFloatingBadge as="h2" title="เลือกเลขและเช็กโพยผ่านมือถือสะดวกแค่ไหน">
    <Picture
      slot="left"
      src={imgMobile}
      alt={mobileAlt}
      loading="lazy"
      fetchpriority="low"
      widths={[200, 400, 600]}
      sizes="(max-width: 768px) 100vw, 30vw"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      class="mx-auto h-auto w-full rounded-2xl border border-[#ffd93d]/40 shadow-[0_10px_30px_rgba(255,217,61,0.26)]"
    />
    <div slot="right" class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#dbeafe]">
        การเลือกเลขผ่านมือถือช่วยให้จัดโพย ตรวจรายการ และแก้ตัวเลขก่อนยืนยันได้จากหน้าจอเดียว เหมาะกับคนที่ติดตามหวยระหว่างวัน
      </p>
      <p class="text-left text-base leading-relaxed text-[#dbeafe]">
        ระบบของ POE888 เชื่อมโพยเข้ากับบัญชีสมาชิก จึงย้อนกลับมาเช็กรายการได้สะดวก มือถือมีไว้ทำชีวิตให้เบา ไม่ใช่ให้ถือเครื่องคิดเลขกับสมุดเพิ่มอีกสองชิ้น
      </p>
    </div>
  </ContentBoxSevenThreeFloatingBadge>

  <ContentBox as="h2" title="ตรวจผลหวยออนไลน์แล้วเช็กเลขที่แทงไว้ได้อย่างไร">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed text-[#dbeafe]">
        หลังผลออก สมาชิกสามารถนำผลหวยมาเทียบกับเลขที่บันทึกไว้ในโพย เพื่อดูผลของแต่ละรายการโดยไม่ต้องจำตัวเลขทั้งหมดเอง
      </p>
      <p class="text-left text-base leading-relaxed text-[#dbeafe]">
        POE888 เก็บประวัติโพยไว้กับบัญชี ทำให้ย้อนดูรายการก่อนหน้าได้ง่าย เลขสองสามตัวอาจจำได้ แต่พอหลายโพย ความมั่นใจของสมองมักแพ้หลักฐาน
      </p>
    </div>
  </ContentBox>

  <LatestWinners4 />

  <ContentBoxSpecial as="h2" title="ระบบสมาชิก POE888 รวมโพย เครดิต และประวัติรายการไว้ตรงไหน">
    <p slot="left" class="text-left text-base leading-relaxed text-[#dbeafe]">
      ระบบสมาชิก POE888 รวมโพย เครดิต และประวัติรายการไว้ในพื้นที่เดียว สมาชิกจึงตรวจสอบได้ว่ามีรายการไหนส่งแล้วหรือเคยใช้งานตลาดใดบ้าง
    </p>
    <p slot="right" class="text-left text-base leading-relaxed text-[#dbeafe]">
      การรวมข้อมูลช่วยให้คนเล่นหลายงวดจัดบัญชีตัวเองง่ายขึ้น ของสำคัญควรมีที่อยู่ชัด โดยเฉพาะโพยกับเงิน ไม่ควรใช้ระบบความจำล้วน ๆ
    </p>
  </ContentBoxSpecial>

  <LoginRtpSection />

  <ContentBoxTwoFloatingBadge as="h2" title="ฝากถอนและจัดการเครดิตผ่านบัญชีสมาชิกสะดวกอย่างไร">
