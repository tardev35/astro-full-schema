---
const {
  message = "ANKERSPIN รวมสล็อต คาสิโนสด กีฬา และระบบ Auto Wallet ไว้ในบัญชีเดียว • เว็บตรงลิขสิทธิ์แท้ วางบริการหลักไว้ครบทั้งสล็อต คาสิโนสด และกีฬาออนไลน์ • สล็อตรวมเกมหลายค่ายหลายสไตล์ แบ่งเป็นหมวดให้ค้นหาง่ายและเข้าเล่นต่อได้ทันที • คาสิโนสดมีบาคาร่า รูเล็ต และเกมโต๊ะ ใช้บัญชีสมาชิกชุดเดิมเข้าเล่นได้เลย • กีฬาออนไลน์เลือกคู่แข่งขันและรายการที่สนใจได้จากหน้าเดียว • ฝากถอน Auto Wallet เชื่อมเครดิตกับบัญชีสมาชิกโดยตรง รองรับการทำรายการตลอด 24 ชั่วโมง • ทางเข้าเว็บหลักรองรับทั้งมือถือและคอมด้วยข้อมูลสมาชิกเดิม",
} = Astro.props;
---

<div class="mx-auto w-full max-w-7xl px-4 py-3 font-sans">
  <div class="relative overflow-hidden rounded-md border border-[#ff6bb5]/45 bg-[#1f0611] shadow-[0_0_15px_rgba(255,45,143,0.18)]">
    <div aria-hidden="true" class="absolute top-0 -left-4 h-full w-8 -skew-x-12 bg-gradient-to-b from-[#ffa6d5] to-[#ff2d8f]"></div>
    <div aria-hidden="true" class="absolute top-0 -right-4 h-full w-8 -skew-x-12 bg-[#ff6bb5]/20"></div>

    <div class="flex items-center">
      <div class="relative z-10 flex w-12 shrink-0 items-center justify-center bg-gradient-to-b from-[#ffa6d5] to-[#ff2d8f] py-2.5">
        <span aria-hidden="true" class="animate-pulse text-lg drop-shadow-[0_0_5px_rgba(255,107,181,0.85)]">🔔</span>
      </div>

      <div class="marquee-container relative flex-1 overflow-hidden py-2.5 pr-6">
        <div aria-hidden="true" class="pointer-events-none absolute top-0 left-0 z-10 h-full w-8 bg-gradient-to-r from-[#1f0611] to-transparent"></div>
        <div aria-hidden="true" class="pointer-events-none absolute top-0 right-0 z-10 h-full w-12 bg-gradient-to-l from-[#1f0611] to-transparent"></div>

        <div class="marquee-content inline-block pl-4 text-sm font-bold tracking-wide whitespace-nowrap text-[#ffa6d5]">
          <span class="mr-8 inline-flex items-center gap-2"><span aria-hidden="true" class="h-1.5 w-1.5 rounded-full bg-[#ff2d8f] shadow-[0_0_5px_rgba(255,45,143,0.85)]"></span>{message}</span>
          <span class="mr-8 inline-flex items-center gap-2"><span aria-hidden="true" class="h-1.5 w-1.5 rounded-full bg-[#ff2d8f] shadow-[0_0_5px_rgba(255,45,143,0.85)]"></span>{message}</span>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .marquee-content {
    animation: marquee 25s linear infinite;
  }
  .marquee-container:hover .marquee-content {
    animation-play-state: paused;
  }
  @keyframes marquee {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee-content {
      animation: none;
    }
  }
</style>
