---
const { titleleft, titlecenter, titleright } = Astro.props;
---

<section class="mx-auto mb-10 w-full max-w-7xl px-4 font-sans">
  <div class="relative w-full overflow-hidden rounded-2xl bg-[#0a1128] p-8 text-white shadow-xl md:p-10">
    <div class="pointer-events-none absolute top-0 right-0 h-full w-1/3 skew-x-12 transform bg-gradient-to-l from-white/5 to-transparent"></div>

    <div class="relative z-10 grid grid-cols-1 gap-8 md:grid-cols-3">
      <article class="flex flex-col gap-3 border-b border-white/10 pb-8 md:border-r md:border-b-0 md:pr-8 md:pb-0">
        {
          titleleft && (
            <h3 class="flex items-center gap-2 text-lg font-black tracking-widest text-[#ffd60a] uppercase">
              <span class="text-xl">🏆</span> {titleleft}
            </h3>
          )
        }
        <div class="text-sm leading-relaxed text-gray-300"><slot name="left" /></div>
      </article>

      <article class="flex flex-col gap-3 border-b border-white/10 pb-8 md:border-r md:border-b-0 md:px-4 md:pb-0">
        {
          titlecenter && (
            <h3 class="flex items-center gap-2 text-lg font-black tracking-widest text-[#ffd60a] uppercase">
              <span class="text-xl">⚡</span> {titlecenter}
            </h3>
          )
        }
        <div class="text-sm leading-relaxed text-gray-300"><slot name="center" /></div>
      </article>

      <article class="flex flex-col gap-3 md:pl-8">
        {
          titleright && (
            <h3 class="flex items-center gap-2 text-lg font-black tracking-widest text-[#ffd60a] uppercase">
              <span class="text-xl">💰</span> {titleright}
            </h3>
          )
        }
        <div class="text-sm leading-relaxed text-gray-300"><slot name="right" /></div>
      </article>
    </div>
  </div>
</section>
<style>
  .font-sans {
    font-family: "Kanit", sans-serif;
  }
</style>
