---
import { Picture } from "astro:assets";
import BankStrip from "./BankStrip.astro";
import { BRAND_ADDRESS } from "../lib/brandProfile";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });
const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

const logoAlt = "โลโก้ PIGAUTO รูปหมูสีชมพูยิ้มอยู่กลางเฟืองล้อรถสีเงินเข้ม ใต้ภาพเป็นตัวอักษรสีขาวขอบดำว่า PIGAUTO";
---

<footer
  class="relative mt-16 w-full overflow-hidden rounded-t-[3rem] border-t border-[#f5c542]/40 bg-[#1c0403] pt-16 pb-8 font-sans text-[#f7e2e2] shadow-[0_-15px_40px_rgba(216,31,38,0.26)]">
  <div class="pointer-events-none absolute inset-x-0 -top-20 mx-auto h-[250px] w-full max-w-4xl rounded-full bg-[#d81f26]/20 blur-[100px]"></div>

  <div class="relative z-10 mx-auto w-full max-w-[1200px] px-6">
    <div class="mb-12 grid grid-cols-1 gap-12 md:grid-cols-12">
      <div class="flex flex-col gap-5 md:col-span-5">
        <a href="/" class="inline-block transition-transform duration-300 hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt={logoAlt}
                widths={[130, 260, 390]}
                sizes="130px"
                class="h-[65px] w-auto drop-shadow-[0_5px_15px_rgba(245,197,66,0.35)]"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <span class="bg-gradient-to-r from-[#fcd3de] to-[#a9761a] bg-clip-text text-4xl font-black tracking-widest text-transparent">
                PIG<span class="bg-gradient-to-r from-[#ffe9a8] to-[#f5c542] bg-clip-text text-transparent">AUTO</span>
              </span>
            )
          }
        </a>
        <p class="border-l-2 border-[#f5c542]/50 pl-4 text-sm leading-relaxed text-[#f7e2e2]/65">
          PIGAUTO ทางเข้าเว็บตรง เชื่อม API ตรงจากค่ายเกมแม่ ไร้ตัวกลาง สล็อตระบบออโต้เร็ว ฝากถอนไม่บังคับขั้นต่ำ รองรับทั้งบัญชีธนาคารและทรูมันนี่วอลเล็ท เข้าเล่นผ่านมือถือได้ทันที
          ไม่ต้องดาวน์โหลด
        </p>
        <div class="mt-4 flex gap-3">
          <span class="rounded-full border border-[#f5c542]/30 bg-[#d81f26]/25 px-4 py-1 text-xs font-medium text-[#ffe9a8] backdrop-blur-sm">ไม่บังคับขั้นต่ำ</span>
          <span class="rounded-full border border-[#f9a8bd]/30 bg-[#d81f26]/25 px-4 py-1 text-xs font-medium text-[#fcd3de] backdrop-blur-sm">ออโต้ 24 ชม.</span>
        </div>
      </div>

      <nav class="flex flex-col gap-4 md:col-span-3 lg:pl-8">
        <p class="text-lg font-black tracking-widest text-white uppercase drop-shadow-sm">เมนูลัด</p>
        <div class="h-[1px] w-12 bg-[#f5c542]"></div>
        <ul class="flex flex-col gap-3 text-sm font-medium text-[#f7e2e2]/65">
          <li><a href="/" class="transition-colors hover:text-[#ffe9a8]">หน้าหลัก</a></li>
          <li><a href="/promotion" class="transition-colors hover:text-[#ffe9a8]">โปรโมชั่น</a></li>
          <li><a href="/register" class="transition-colors hover:text-[#ffe9a8]">สมัครสมาชิก</a></li>
          <li><a href="/login" class="transition-colors hover:text-[#ffe9a8]">เข้าสู่ระบบ</a></li>
          <li><a href="/ทางเข้า" class="transition-colors hover:text-[#ffe9a8]">ทางเข้า</a></li>
          <li><a href="/ทดลองเล่น" class="transition-colors hover:text-[#ffe9a8]">ทดลองเล่น</a></li>
          <li><a href="/about-us" class="transition-colors hover:text-[#ffe9a8]">เกี่ยวกับเรา</a></li>
          <li><a href="/contact-us" class="transition-colors hover:text-[#ffe9a8]">ติดต่อเรา</a></li>
        </ul>
      </nav>

      <div class="flex flex-col gap-5 md:col-span-4">
        <p class="text-lg font-black tracking-widest text-white uppercase drop-shadow-sm">ฝ่ายดูแลสมาชิก</p>
        <div class="h-[1px] w-12 bg-[#f5c542]"></div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] py-3.5 font-bold text-white shadow-[0_5px_15px_rgba(0,185,0,0.3)] transition-all hover:-translate-y-1 hover:shadow-[0_8px_20px_rgba(0,185,0,0.4)]">
          ติดต่อแอดมิน LINE
        </a>

        {
          BRAND_ADDRESS.lines.length > 0 && (
            <address aria-label={BRAND_ADDRESS.label} class="mt-2 rounded-xl border border-white/15 bg-black/20 p-4 text-xs leading-relaxed not-italic opacity-90">
              <p class="mb-2 flex items-center gap-2 text-[11px] font-bold tracking-wider uppercase opacity-80">
                <span aria-hidden="true" class="text-sm">📍</span>
                {BRAND_ADDRESS.label}
              </p>
              {BRAND_ADDRESS.lines.map((line) => (
                <span class="block">{line}</span>
              ))}
              {BRAND_ADDRESS.email && (
                <a href={`mailto:${BRAND_ADDRESS.email}`} class="mt-3 inline-flex items-center gap-2 font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                  <span aria-hidden="true" class="text-sm">✉️</span>
                  {BRAND_ADDRESS.email}
                </a>
              )}
            </address>
          )
        }

        <div class="mt-4 text-xs font-medium tracking-widest text-[#ffe9a8]/55 uppercase">ช่องทางฝากถอนที่รองรับ</div>
        <BankStrip size={30} />
      </div>
    </div>

    <div class="flex flex-col items-center justify-between border-t border-[#a9761a]/40 pt-8 text-xs font-medium tracking-wide text-[#f7e2e2]/45 md:flex-row">
      <p>COPYRIGHT &copy; {new Date().getFullYear()} PIGAUTO. ALL RIGHTS RESERVED.</p>
      <div class="mt-4 flex gap-4 md:mt-0">
        <a href="/terms/" class="transition-colors hover:text-[#ffe9a8]">TERMS &amp; CONDITIONS</a>
        <a href="/privacy/" class="transition-colors hover:text-[#ffe9a8]">PRIVACY POLICY</a>
      </div>
    </div>
  </div>
</footer>
