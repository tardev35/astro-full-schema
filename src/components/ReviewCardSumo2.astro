---
const reviews = [
  {
    name: "สมาชิกที่ใช้บัญชีเดียวจัดการทุกอย่าง",
    role: "รวมสล็อต คาสิโนสด กีฬา และเครดิตไว้ที่เดียว",
    stars: 5,
    tag: "ระบบสมาชิกบัญชีเดียว",
    content:
      "ที่ถูกใจคือไม่ต้องเปิดหลายหน้าครับ เข้าสู่ระบบครั้งเดียวแล้วเลือกสล็อต เช็กเครดิต หรือย้อนดูประวัติรายการได้จากจุดเดียว วันไหนอยากเปลี่ยนไปเล่นเกมโต๊ะหรือดูคู่บอลก็เปลี่ยนได้ทันที ใช้เครดิตชุดเดิมไม่ต้องสลับบัญชีให้ปวดหัว",
    avatar: "⚓",
  },
  {
    name: "สมาชิกที่สลับไปเล่นคาสิโนสด",
    role: "เปลี่ยนบรรยากาศจากเกมหมุนไปบาคาร่าและรูเล็ต",
    stars: 5,
    tag: "คาสิโนสดเรียลไทม์",
    content:
      "บางวันหมุนสล็อตจนเบื่อก็กดเข้าคาสิโนสดต่อได้เลยค่ะ บาคาร่ากับรูเล็ตแบบเรียลไทม์คนละอารมณ์กับเกมหมุน แต่ยังใช้บัญชีสมาชิกเดิม ไม่ต้องสมัครใหม่หรือย้ายเครดิตไปมาให้เสียเวลา",
    avatar: "🎲",
  },
  {
    name: "สมาชิกที่ทำรายการผ่านมือถือเป็นหลัก",
    role: "ฝากถอนด้วย Auto Wallet จากหน้าสมาชิก",
    stars: 5,
    tag: "ฝากถอน Auto Wallet",
    content:
      "ผมทำรายการจากมือถืออย่างเดียวครับ ระบบออโต้ทำให้ขั้นตอนฝากถอนสั้นลง ไม่ต้องแจ้งสลิปหรือรอให้ใครมากดอนุมัติ พอรายการเชื่อมกับบัญชีสมาชิกก็เช็กเครดิตแล้วกลับเข้าเกมต่อได้จากหน้าเดียวเลย",
    avatar: "⚡",
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label="เสียงจากสมาชิก ANKERSPIN" class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#ffa6d5] via-[#ff2d8f] to-[#ff6bb5] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      เสียงจากสมาชิก <span class="text-[#ff2d8f]">ANKERSPIN</span>
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#ff2d8f] to-transparent"></div>
  </div>

  <div class="mx-auto mb-8 flex max-w-md items-center justify-center gap-5 rounded-2xl border border-[#ff2d8f]/25 bg-[#1f0611]/92 px-6 py-4 shadow-[0_10px_30px_rgba(13,2,7,0.5)] backdrop-blur-xl">
    <div class="flex flex-col items-center">
      <span class="bg-gradient-to-b from-[#ffa6d5] to-[#c2185b] bg-clip-text text-4xl leading-none font-black text-transparent">{average}</span>
      <span class="mt-1 text-[10px] font-bold tracking-widest text-[#f9dcec]/70 uppercase">คะแนนเฉลี่ย</span>
    </div>
    <div class="h-12 w-px bg-[#2c0a1a]"></div>
    <div class="flex flex-col gap-1.5">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#ff2d8f]" : "text-[#2c0a1a]"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#f9dcec]/70">คะแนนเฉลี่ย {average} จาก 5 ดาว จากการใช้งานจริงของสมาชิก {reviews.length} ด้าน</span>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
    {
      reviews.map((review) => (
        <article class="group relative isolate flex flex-col gap-4 overflow-hidden rounded-2xl border border-[#ff2d8f]/25 bg-[#1f0611]/92 p-6 text-left shadow-[0_10px_30px_rgba(13,2,7,0.5)] backdrop-blur-xl transition-all duration-300 hover:-translate-y-1 hover:border-[#ff2d8f]/55 hover:shadow-[0_15px_40px_rgba(255,45,143,0.30)]">
          <span class="absolute inset-y-0 left-0 -z-10 w-1 bg-gradient-to-b from-[#ffa6d5] to-[#a4126b] opacity-80 transition-opacity duration-300 group-hover:opacity-100" />
          <span class="pointer-events-none absolute -top-14 -right-14 -z-10 h-32 w-32 rounded-full bg-[#a4126b]/45 blur-[50px] transition-all duration-300 group-hover:bg-[#ff2d8f]/25" />

          <div class="flex items-center justify-between gap-3">
            <span class="inline-flex items-center gap-1.5 rounded-full border border-[#ff2d8f]/25 bg-[#2c0a1a] px-3 py-1 text-[10px] font-bold tracking-widest text-[#ff2d8f] uppercase">
              <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#ff2d8f]" />
              {review.tag}
            </span>
            <span class="flex gap-0.5 text-sm">
              <span aria-hidden="true" class="flex gap-0.5">
                {Array.from({ length: 5 }).map((_, i) => (
                  <span class={i < review.stars ? "text-[#ff2d8f]" : "text-[#2c0a1a]"}>★</span>
                ))}
              </span>
              <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
            </span>
          </div>

          <p class="text-left text-base leading-relaxed text-[#f9dcec]">{review.content}</p>

          <div class="mt-auto flex items-center gap-3 border-t border-[#2c0a1a] pt-4">
            <span
              aria-hidden="true"
              class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#ff2d8f]/30 bg-gradient-to-br from-[#ffa6d5] via-[#ff2d8f] to-[#8f0f52] text-xl shadow-inner transition-transform duration-300 group-hover:scale-110">
              {review.avatar}
            </span>
            <span class="flex flex-col">
              <span class="text-sm font-black text-[#f9dcec] transition-colors group-hover:text-[#ffa6d5]">{review.name}</span>
              <span class="text-[10px] font-bold tracking-wider text-[#f9dcec]/70 uppercase">{review.role}</span>
            </span>
          </div>
        </article>
      ))
    }
  </div>
</section>
