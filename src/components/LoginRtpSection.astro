---
import ContentBoxTwo from "./ContentBoxTwo.astro";

const steps = [
  { icon: "🔑", name: "เข้าสู่ระบบด้วยยูสเดิม", detail: "ใช้เบอร์โทรศัพท์หรือยูสเซอร์เนมที่สมัครไว้ เข้าได้ทั้งจากมือถือและคอม", tag: "ขั้นที่ 1" },
  { icon: "🃏", name: "เลือกห้องคาสิโนสดหรือโต๊ะบาคาร่า", detail: "เปิดดูห้องที่เปิดอยู่ก่อน แล้วค่อยเลือกโต๊ะที่ตรงกับสไตล์การเล่นของตัวเอง", tag: "ขั้นที่ 2" },
  { icon: "🎁", name: "เช็กโปรสมาชิกใหม่ที่เปิดอยู่", detail: "ดูยอดรับ เงื่อนไข เทิร์น และช่วงเวลาที่ใช้ได้จากหน้าสมาชิกก่อนกดรับ", tag: "ขั้นที่ 3" },
  { icon: "💳", name: "จัดการเครดิตผ่านระบบออโต้", detail: "ส่งรายการฝากถอนจากหน้าเดิม ดูยอดคงเหลือได้ก่อนกลับเข้าโต๊ะต่อ", tag: "ขั้นที่ 4" },
  { icon: "🧾", name: "ย้อนดูประวัติรายการ", detail: "เครดิต โปร และรายการฝากถอนรวมอยู่ในยูสเดียว ตรวจย้อนหลังได้เอง", tag: "ขั้นที่ 5" },
];

const chips = ["คาสิโนสด", "บาคาร่า", "สล็อต", "ฟุตบอล", "โปรสมาชิกใหม่", "ฝากถอนออโต้", "ยูสเดียว"];
---

<ContentBoxTwo titleleft="เข้าสู่ระบบ DOLLAR789" titleright="ลำดับการใช้งานบนหน้าสมาชิก" label="เข้าสู่ระบบ DOLLAR789 และลำดับการใช้งานบนหน้าสมาชิก">
  <div slot="left" class="flex h-full flex-col gap-4">
    <div class="relative overflow-hidden rounded-2xl border border-[#3b1a63] bg-[#150826] p-6 shadow-[0_10px_30px_rgba(168,85,247,0.18)]">
      <div aria-hidden="true" class="pointer-events-none absolute -top-10 -right-10 h-32 w-32 rounded-full bg-[#a855f7]/20 blur-[50px]"></div>

      <div class="relative z-10 mb-5 flex items-center gap-3">
        <span
          aria-hidden="true"
          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#3b1a63] bg-gradient-to-br from-[#c084fc] via-[#a855f7] to-[#4c1d95] text-xl shadow-inner">
          🃏
        </span>
        <div class="flex flex-col">
          <p class="text-base font-black text-[#ffe9a8]">เข้าสู่ระบบแล้วเลือกโต๊ะหรือเกมที่ชอบต่อได้ทันที</p>
          <span class="text-[11px] text-[#a894c9]">ยูสเดียวใช้เข้าคาสิโนสด บาคาร่า สล็อต และบอล เช็กเครดิต ดูโปร และย้อนดูประวัติรายการของ DOLLAR789 ได้จากหน้าเดียว</span>
        </div>
      </div>

      <div class="relative z-10 flex flex-col gap-3.5">
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#c084fc]">👤</span>
          <input
            type="text"
            placeholder="เบอร์โทรศัพท์ / ยูสเซอร์เนม"
            class="w-full rounded-xl border border-[#3b1a63] bg-[#0b011b] py-3 pr-4 pl-12 text-[#e7dcf7] transition-all outline-none placeholder:text-[#a894c9] focus:border-[#a855f7] focus:ring-1 focus:ring-[#a855f7]/40"
          />
        </div>
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#c084fc]">🔑</span>
          <input
            type="password"
            placeholder="รหัส PIN 4 หลัก"
            class="w-full rounded-xl border border-[#3b1a63] bg-[#0b011b] py-3 pr-4 pl-12 text-[#e7dcf7] transition-all outline-none placeholder:text-[#a894c9] focus:border-[#a855f7] focus:ring-1 focus:ring-[#a855f7]/40"
          />
        </div>

        <div class="flex items-center justify-between px-1 text-xs">
          <label class="flex items-center gap-2 text-[#a894c9]">
            <input type="checkbox" class="h-3.5 w-3.5 rounded border-[#3b1a63] bg-[#0b011b] accent-[#a855f7]" />
            จดจำฉันไว้
          </label>
          <a href="/login" class="text-[#a894c9] transition-colors hover:text-[#c084fc]">ลืมรหัส PIN?</a>
        </div>

        <button
          class="mt-1 w-full rounded-xl border border-[#a855f7]/50 bg-gradient-to-r from-[#ffd75e] via-[#f5c542] to-[#a3610c] p-3.5 font-black text-[#0b011b] shadow-[0_10px_30px_rgba(168,85,247,0.28)] transition-all hover:scale-[1.02] hover:shadow-[0_15px_40px_rgba(168,85,247,0.36)]">
          เข้าสู่ระบบ
        </button>

        <div class="flex items-center gap-3 py-1 text-[11px] text-[#a894c9]">
          <span class="h-px flex-1 bg-[#3b1a63]"></span>
          หรือ
          <span class="h-px flex-1 bg-[#3b1a63]"></span>
        </div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] p-3 text-sm font-bold text-white shadow-md transition-all hover:scale-[1.02]">
          <span aria-hidden="true">💬</span> ทักไลน์ทีมงานตลอด 24 ชั่วโมง
        </a>

        <div class="mt-1 flex items-center justify-between px-1">
          <div class="flex gap-2">
            <span class="rounded-full border border-[#3b1a63] bg-[#0b011b] px-2.5 py-1 text-[10px] font-bold text-[#c084fc]"><span aria-hidden="true">🔒</span> เข้ารหัสข้อมูล</span>
            <span class="rounded-full border border-[#a3610c]/60 bg-[#241206] px-2.5 py-1 text-[10px] font-bold text-[#ffe9a8]"><span aria-hidden="true">🕐</span> ใช้งานได้ตลอด 24 ชม.</span>
          </div>
          <a href="/register" class="text-xs font-bold text-[#a894c9] transition-colors hover:text-[#c084fc]">สมัครสมาชิกใหม่</a>
        </div>
      </div>
    </div>
  </div>

  <div slot="right" class="h-full">
    <div class="flex h-full flex-col rounded-2xl border border-[#3b1a63] bg-[#150826] p-5 shadow-[0_10px_30px_rgba(168,85,247,0.18)]">
      <div class="mb-5 flex items-center justify-between gap-3">
        <div>
          <span class="text-xs font-bold tracking-wide text-[#a894c9]">ลำดับการใช้งานที่ DOLLAR789 วางไว้บนหน้าสมาชิก หลังเข้าสู่ระบบด้วยยูสเดิม</span>
          <div class="bg-gradient-to-r from-[#c084fc] via-[#e9d5ff] to-[#f5c542] bg-clip-text text-2xl font-black text-transparent sm:text-3xl">คาสิโนสด • บาคาร่า • ระบบออโต้</div>
        </div>
        <span class="flex items-center gap-1.5 self-start rounded-full border border-green-500/40 bg-green-900/20 px-2.5 py-1">
          <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-green-400 shadow-[0_0_8px_rgba(74,222,128,0.7)]"></span>
          <span class="text-[10px] font-bold tracking-widest text-green-400 uppercase">Live</span>
        </span>
      </div>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#a894c9] uppercase">
        <span>ขั้นตอนการใช้งาน</span>
        <span>ลำดับ</span>
      </div>

      <div class="flex flex-1 flex-col gap-2.5">
        {
          steps.map((s) => (
            <div class="rounded-xl border border-[#3b1a63] bg-[#0b011b] px-3.5 py-2.5 transition-colors hover:border-[#a855f7]/60 hover:bg-[#1e0c33]">
              <div class="flex items-center justify-between gap-2 text-sm">
                <span class="flex min-w-0 items-center gap-2 font-bold text-[#e9d5ff]">
                  <span aria-hidden="true" class="w-5 shrink-0 text-center">
                    {s.icon}
                  </span>{" "}
                  <span class="truncate">{s.name}</span>
                </span>
                <span class="shrink-0 rounded-full border border-[#a855f7]/45 bg-[#1e0c33] px-2.5 py-0.5 text-[10px] font-bold text-[#ffe9a8]">{s.tag}</span>
              </div>
              <div class="mt-1.5 text-[11px] tracking-wide text-[#a894c9]">{s.detail}</div>
            </div>
          ))
        }
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
        {chips.map((c) => <span class="rounded-full border border-[#3b1a63] bg-[#0b011b] px-3 py-1 text-[10px] font-bold text-[#c084fc]">{c}</span>)}
      </div>

      <div class="mt-3 text-center text-[10px] tracking-wide text-[#a894c9]">
        ลำดับในตารางสรุปจากที่หน้าเว็บแสดงไว้ รายละเอียดของห้องเล่นและเงื่อนไขโปรจริงให้ยึดตามหน้าสมาชิกและหน้าโปรโมชั่นของ DOLLAR789 ก่อนเลือกใช้ทุกครั้ง หากติดขัดตรงไหนทักไลน์ทีมงานได้ตลอด 24 ชั่วโมง
      </div>
    </div>
  </div>
</ContentBoxTwo>
