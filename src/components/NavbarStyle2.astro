---
import { isActivePath } from "../lib/nav";
import { Picture } from "astro:assets";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });
const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;
const currentPath = Astro.url.pathname;
const isActive = (path: string) => isActivePath(currentPath, path);

const logoAlt =
  "โลโก้ WON22 ตัวอักษร WON สีทองมันวาววางบนริบบิ้นสีแดงเข้ม ใต้ลงมาเป็นเลข 22 สีขาวขอบแดงบนกองเหรียญทอง ด้านหลังเป็นวงล้อเสี่ยงโชคหลากสีและเหรียญทองปลิวออกสี่ทิศ";

const links = [
  { name: "หน้าแรก", path: "/", icon: "🏠" },
  { name: "โปรโมชั่น", path: "/promotion/", icon: "🎁" },
  { name: "สมัครสมาชิก", path: "/register/", icon: "📝" },
  { name: "เข้าสู่ระบบ", path: "/login/", icon: "🔑" },
  { name: "ทดลองเล่น", path: "/ทดลองเล่น/", icon: "🎰" },
  { name: "เกี่ยวกับเรา", path: "/about-us/", icon: "🔥" },
  { name: "ติดต่อเรา", path: "/contact-us/", icon: "💬" },
];

---

<div class="hidden w-full border-b border-[#fbbf24]/30 bg-gradient-to-r from-[#0d0502] via-[#2a1004] to-[#0d0502] px-4 py-1.5 font-sans text-xs font-bold text-[#f8e3d2]/80 lg:block">
  <div class="mx-auto flex max-w-[1400px] justify-between">
    <div class="flex gap-4">
      <span class="flex items-center gap-1"><span aria-hidden="true" class="text-[#fbbf24]">🎰</span> WON22 รวมสล็อตออนไลน์เว็บตรงไว้ในยูสเดียว</span>
      <span class="flex items-center gap-1 text-[#fbbf24]"><span aria-hidden="true" class="text-[#f97316]">⚡</span> ฝากถอนออโต้ ไม่ติดเทิร์น ตลอด 24 ชั่วโมง</span>
    </div>
    <div class="flex gap-4">
      <a href="/line/" class="flex items-center gap-1 transition-colors hover:text-[#fbbf24]">ติดต่อทีมงาน WON22 ผ่าน LINE Official</a>
    </div>
  </div>
</div>

<header class="sticky top-2 z-50 mt-2 w-full px-2 font-sans md:px-4">
  <nav
    class="relative mx-auto flex h-[75px] w-full max-w-[1400px] items-center justify-between rounded-[20px] border border-[#fbbf24]/40 bg-[#1c0d04]/95 px-4 shadow-[0_10px_30px_rgba(251,191,36,0.2)] xl:px-8">
    <a href="/" class="z-50 flex-shrink-0 transition-transform hover:scale-105">
      {
        mainLogo ? (
          <Picture
            src={mainLogo}
            alt={logoAlt}
            loading="eager"
            fetchpriority="high"
            widths={[100, 200, 300]}
            sizes="100px"
            class="h-[40px] w-auto drop-shadow-[0_0_10px_rgba(251,191,36,0.5)] xl:h-[45px]"
            formats={["avif", "webp"]}
            fallbackFormat="webp"
          />
        ) : (
          <span class="bg-gradient-to-b from-[#fde68a] to-[#b45309] bg-clip-text text-3xl font-black text-transparent drop-shadow-[0_0_8px_rgba(251,191,36,0.4)]">WON22</span>
        )
      }
    </a>

    <div class="hidden h-full items-center gap-3 lg:flex xl:gap-5">
      {
        links.map((item) => (
          <a
            href={item.path}
            class={`group relative flex h-full items-center gap-1.5 text-sm font-bold tracking-wide uppercase transition-colors ${isActive(item.path) ? "text-[#fbbf24] drop-shadow-[0_0_8px_rgba(251,191,36,0.4)]" : "text-[#f8e3d2]/80 hover:text-[#fde68a]"}`}>
            <span aria-hidden="true" class="text-base">
              {item.icon}
            </span>
            <span>{item.name}</span>
            <div
              class={`absolute bottom-[18px] left-0 h-[2px] w-full origin-center bg-gradient-to-r from-[#f97316] via-[#fbbf24] to-[#b45309] shadow-[0_0_8px_rgba(251,191,36,0.8)] transition-transform duration-300 ${isActive(item.path) ? "scale-x-100" : "scale-x-0 group-hover:scale-x-100"}`}
            />
          </a>
        ))
      }
    </div>

    <div class="z-50 flex items-center gap-3">
      <a
        href="/login/"
        class="hidden items-center justify-center gap-1.5 rounded-full border border-[#fbbf24]/50 bg-[#2a1207] px-5 py-2 text-sm font-bold text-[#fbbf24] shadow-sm transition-all hover:bg-[#fbbf24]/20 xl:flex">
        <span aria-hidden="true">🔑</span> เข้าสู่ระบบ
      </a>
      <a
        href="/register/"
        class="hidden items-center justify-center gap-1.5 rounded-full border border-[#fbbf24]/70 bg-gradient-to-r from-[#f97316] to-[#9a3412] px-5 py-2 text-sm font-black text-[#fde68a] shadow-[0_0_15px_rgba(249,115,22,0.45)] transition-all hover:scale-105 xl:flex">
        <span aria-hidden="true">📝</span> สมัครสมาชิก
      </a>

      <button
        id="hamburger-btn"
        class="relative flex h-[42px] w-[42px] flex-col items-center justify-center gap-[5px] rounded-full border border-[#fbbf24]/30 bg-gradient-to-b from-[#2a1207] to-[#140803] shadow-sm lg:hidden"
        aria-label="เปิดเมนูหลัก">
        <span class="line-1 h-[2px] w-5 origin-center rounded-full bg-[#fbbf24] transition-all duration-300"></span>
        <span class="line-2 h-[2px] w-5 origin-center rounded-full bg-[#fbbf24] transition-all duration-300"></span>
        <span class="line-3 h-[2px] w-5 origin-center rounded-full bg-[#fbbf24] transition-all duration-300"></span>
      </button>
    </div>
  </nav>

  <div id="fullscreen-menu" class="pointer-events-none fixed inset-0 z-[40] flex flex-col items-center justify-center bg-[#0d0502]/98 opacity-0 backdrop-blur-xl transition-opacity duration-500">
    <div class="flex w-full flex-col items-center space-y-4 px-6">
      {
        links.map((item) => (
          <a
            href={item.path}
            class={`fs-item flex items-center gap-3 text-2xl font-black tracking-widest uppercase transition-all duration-300 ${isActive(item.path) ? "text-[#fbbf24] drop-shadow-[0_0_10px_rgba(251,191,36,0.6)]" : "text-[#f8e3d2]/80 hover:text-[#fde68a]"}`}>
            <span aria-hidden="true" class="text-2xl">
              {item.icon}
            </span>
            {item.name}
          </a>
        ))
      }
      <div class="fs-item mt-4 flex w-full max-w-[280px] flex-col gap-4 pt-6">
        <a
          href="/register/"
          class="flex w-full items-center justify-center gap-2 rounded-full border border-[#fbbf24]/70 bg-gradient-to-r from-[#f97316] to-[#9a3412] py-3.5 text-lg font-black text-[#fde68a] shadow-[0_0_20px_rgba(249,115,22,0.5)]">
          <span aria-hidden="true">📝</span> สมัครสมาชิกใหม่
        </a>
        <a
          href="/login/"
          class="flex w-full items-center justify-center gap-2 rounded-full border-2 border-[#fbbf24]/50 bg-[#2a1207] py-3.5 text-lg font-bold text-[#fbbf24] transition-colors hover:bg-[#fbbf24]/20">
          <span aria-hidden="true">🔑</span> เข้าสู่ระบบ
        </a>
      </div>
    </div>
  </div>
</header>

<style is:global>
  #hamburger-btn.active .line-1 {
    transform: translateY(7px) rotate(45deg);
  }
  #hamburger-btn.active .line-2 {
    opacity: 0;
  }
  #hamburger-btn.active .line-3 {
    transform: translateY(-7px) rotate(-45deg);
  }
  .fs-item {
    opacity: 0;
    transform: translateY(20px);
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .fs-item.show {
    opacity: 1;
    transform: translateY(0);
  }
  .fs-item:nth-child(1) {
    transition-delay: 0.1s;
  }
  .fs-item:nth-child(2) {
    transition-delay: 0.15s;
  }
  .fs-item:nth-child(3) {
    transition-delay: 0.2s;
  }
  .fs-item:nth-child(4) {
    transition-delay: 0.25s;
  }
  .fs-item:nth-child(5) {
    transition-delay: 0.3s;
  }
  .fs-item:nth-child(6) {
    transition-delay: 0.35s;
  }
  .fs-item:nth-child(7) {
    transition-delay: 0.4s;
  }
  .fs-item:nth-child(8) {
    transition-delay: 0.45s;
  }

  @media (prefers-reduced-motion: reduce) {
    .fs-item {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  const hamburgerBtn = document.getElementById("hamburger-btn");
  const fsMenu = document.getElementById("fullscreen-menu");
  const fsItems = document.querySelectorAll(".fs-item");

  const toggleFsMenu = () => {
    hamburgerBtn?.classList.toggle("active");
    fsMenu?.classList.toggle("opacity-0");
    fsMenu?.classList.toggle("pointer-events-none");

    if (!fsMenu?.classList.contains("opacity-0")) {
      document.body.style.overflow = "hidden";
      fsItems.forEach((item) => item.classList.add("show"));
    } else {
      document.body.style.overflow = "";
      fsItems.forEach((item) => item.classList.remove("show"));
    }
  };

  hamburgerBtn?.addEventListener("click", toggleFsMenu);
  fsItems.forEach((item) => {
    item.addEventListener("click", () => {
      if (!fsMenu?.classList.contains("opacity-0")) toggleFsMenu();
    });
  });
</script>
