---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#f6c9c6] bg-white p-8 text-left text-base leading-relaxed text-[#2d1214] shadow-[0_10px_30px_rgba(230,0,18,0.10)] transition-all duration-500 hover:border-[#e60012]/45 hover:shadow-[0_15px_40px_rgba(230,0,18,0.18)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#e60012]/12 blur-[60px] transition-all duration-500 group-hover:bg-[#ff4b41]/20"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#d4a017]/16 blur-[60px] transition-all duration-500 group-hover:bg-[#f5c542]/24"></div>

    {
      title && (
        <header class="mb-6 flex items-center gap-4 border-b border-[#f6c9c6] pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#e60012] to-[#d4a017] shadow-[0_0_10px_rgba(230,0,18,0.35)]" />
          <HeadingTag class="text-2xl leading-normal font-black tracking-widest text-[#8a0208] uppercase">{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
