---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement6.astro";

import { Picture } from "astro:assets";

import pro1 from "../assets/slide1.webp";
import pro2 from "../assets/slide2.webp";
import pro3 from "../assets/slide3.webp";
import pro4 from "../assets/banner1.webp";
---

<MainLayout title="โปรโมชั่น BABYSHARK88 สล็อตเว็บนอกตรงแท้" description="รวมโปรโมชั่น BABYSHARK88 สล็อตเว็บนอกตรงแท้ต่างประเทศ RTP ตามลิขสิทธิ์ ฝากถอนออโต้ รองรับวอเล็ทเต็มระบบ">
  <Announcement />

  <ContentBox>
    <h1 class="mb-5 bg-gradient-to-r from-yellow-300 to-yellow-500 bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase drop-shadow-sm">โปรโมชั่น BABYSHARK88</h1>

    <div class="mx-auto grid w-full max-w-7xl grid-cols-1 gap-6 px-4 sm:grid-cols-2 lg:grid-cols-2 xl:grid-cols-2">
      <Picture
        src={pro1}
        alt="BABYSHARK88 RTP 99% เว็บนอกแท้ ไม่ปรับเรทกลางอากาศ"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600, 800]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class="mx-auto h-auto w-full rounded-xl border border-cyan-400/50 object-contain shadow-lg transition-transform duration-300 hover:-translate-y-1 hover:border-cyan-300 hover:shadow-[0_10px_20px_rgba(34,211,238,0.6)]"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />

      <Picture
        src={pro2}
        alt="ฝากถอนออโต้ 3-5 วินาที ไม่ผ่านแอดมิน ไม่ต้องส่งสลิป"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600, 800]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class="mx-auto h-auto w-full rounded-xl border border-cyan-400/50 object-contain shadow-lg transition-transform duration-300 hover:-translate-y-1 hover:border-cyan-300 hover:shadow-[0_10px_20px_rgba(34,211,238,0.6)]"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />

      <Picture
        src={pro3}
        alt="ปลอดภัยระดับสากล ไม่ใช้บัญชีม้า ไม่ใช้บัญชีส่วนตัว"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600, 800]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class="mx-auto h-auto w-full rounded-xl border border-cyan-400/50 object-contain shadow-lg transition-transform duration-300 hover:-translate-y-1 hover:border-cyan-300 hover:shadow-[0_10px_20px_rgba(34,211,238,0.6)]"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />

      <Picture
        src={pro4}
        alt="รองรับวอเล็ทเต็มระบบ สมัครง่าย ไม่ต้องยืนยันตัวตนหลายขั้นตอน"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600, 800]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class="mx-auto h-auto w-full rounded-xl border border-cyan-400/50 object-contain shadow-lg transition-transform duration-300 hover:-translate-y-1 hover:border-cyan-300 hover:shadow-[0_10px_20px_rgba(34,211,238,0.6)]"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />
    </div>
    <div class="mt-12 flex justify-center pb-4">
      <a
        href="/register"
        class="flex items-center justify-center rounded-full bg-gradient-to-r from-yellow-500 via-yellow-400 to-yellow-500 px-10 py-3.5 text-lg font-black text-[#042f3d] shadow-[0_5px_20px_rgba(251,191,36,0.4)] transition-all duration-300 hover:-translate-y-1 hover:scale-105 hover:shadow-[0_8px_25px_rgba(251,191,36,0.6)]">
        รับโปรโมชั่นทันที
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <style>
    :global(.text-purple-gradient) {
      background: linear-gradient(to bottom, #67e8f9 0%, #0891b2 100%) !important;
      -webkit-background-clip: text !important;
      -webkit-text-fill-color: transparent !important;
    }
  </style>
</MainLayout>
