---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";
import { pageGraph } from "../lib/schema";

const pageTitle = "เกี่ยวกับเรา PIGAUTO เว็บตรงสล็อตระบบออโต้ ไร้ตัวกลาง เชื่อม API ค่ายเกมแม่";

const pageDescription =
  "เกี่ยวกับเรา PIGAUTO เว็บตรงสล็อตระบบออโต้ที่เชื่อม API ตรงจากค่ายเกมแม่ ไร้ตัวกลาง ลิขสิทธิ์แท้ ฝากถอนอัตโนมัติในเสี้ยววินาที ไม่บังคับขั้นต่ำ รองรับวอเลท";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox as="h1" title={pageTitle}>
    <p class="mb-4 text-left text-base leading-relaxed text-[#f7e2e2]">
      <strong class="text-[#f5c542]">PIGAUTO</strong> คือเว็บตรงที่ให้บริการเฉพาะเกมสล็อตจาก PGSLOT และค่ายเกมชั้นนำอื่น โดยเชื่อมต่อระบบ API ตรงจากค่ายเกมแม่ ไม่ผ่านเอเย่นต์หรือนายหน้า
      แนวคิดของเราเรียบง่าย คือทำให้เว็บสล็อตทำงานเหมือนรถที่จูนมาดี ทุกส่วนประสานกัน เร็วแบบควบคุมได้ ไม่เร่ง ไม่สะดุด และปลอดภัยในทุกขั้นตอน
      ตั้งแต่การเปิดเกม การฝากถอน ไปจนถึงการดูแลข้อมูลของสมาชิก
    </p>

    <p class="text-left text-base leading-relaxed text-[#f7e2e2]">
      หน้านี้ทำหน้าที่เป็นหน้าข้อมูลและแนะนำตัว อธิบายว่าเราให้บริการอะไร วางระบบไว้อย่างไร และเหมาะกับผู้เล่นแบบไหน เพื่อให้อ่านแล้วนำไปเทียบกับสิ่งที่เห็นในหน้าสมาชิกจริงได้
      ส่วนรายละเอียดของโปรโมชั่นและเงื่อนไขของแต่ละรายการจะอยู่ในหน้าโปรโมชั่นโดยตรง จึงควรเปิดดูก่อนใช้สิทธิ์ทุกครั้ง
    </p>
  </ContentBox>

  <ContentBox as="h2" title="PIGAUTO เว็บตรงไร้ตัวกลาง เชื่อม API จากค่ายเกมแม่โดยตรง">
    <p class="mb-4 text-left text-base leading-relaxed text-[#f7e2e2]">
      เรานิยามคำว่าเว็บตรงด้วยวิธีที่ตรวจสอบได้ คือการเชื่อมต่อ API ตรงจากค่ายเกมแม่ หรือ Direct Server เปรียบเสมือนระบบส่งกำลังที่ถ่ายทอดพลังงานจากเครื่องยนต์ลงสู่ล้อได้เต็มร้อยเปอร์เซ็นต์
      โดยไม่มีการสูญเสียกำลังระหว่างทาง เมื่อไม่มีตัวกลางคั่นอยู่ ทุกการตอบสนองจึงแม่นยำและฉับไว ไม่มีชั้นของระบบภายนอกมาทำให้คำสั่งของคุณช้าลง
    </p>

    <p class="text-left text-base leading-relaxed text-[#f7e2e2]">
      ผลที่ตามมาคือเรื่องความมั่นใจ ทุกยอดเงินและทุกการเดิมพันอยู่ภายใต้การดูแลของระบบหลัก ไม่ได้ฝากไว้กับคนกลางที่คุณไม่รู้จัก
      สมาชิกจึงตรวจสอบยอดของตัวเองได้จากหน้าสมาชิกโดยตรง ไม่ต้องรอให้ใครยืนยันให้อีกทอดหนึ่ง และไม่ต้องลุ้นว่าตัวเลขที่เห็นตรงกับต้นทางหรือไม่
    </p>
  </ContentBox>

  <ContentBox as="h2" title="ระบบออโต้ของ PIGAUTO ฝากถอนจบในเสี้ยววินาที">
    <p class="mb-4 text-left text-base leading-relaxed text-[#f7e2e2]">
      หัวใจของเว็บคือระบบธุรกรรม เราจึงพัฒนาระบบออโต้ที่ประมวลผลยอดเงินให้ทันทีที่ทำรายการ ไม่ต้องแจ้งสลิปแล้วนั่งรอแอดมินตอบ ฝากเงินแล้วเครดิตเข้ากระเป๋าเกมทันที
      ถอนเงินแล้วยอดเด้งเข้าบัญชีในเสี้ยววินาที ขั้นตอนทั้งหมดทำได้เองจากหน้าสมาชิกตลอด 24 ชั่วโมง
    </p>

    <p class="text-left text-base leading-relaxed text-[#f7e2e2]">
      ระบบถูกออกแบบให้รองรับช่วงที่มีผู้ใช้งานพร้อมกันจำนวนมากโดยไม่หน่วงและไม่ค้าง เพราะเวลาที่ระบบควรทำงานหนักที่สุดคือเวลาที่คนใช้งานเยอะที่สุด
      เราจึงเผื่อกำลังของเซิร์ฟเวอร์ไว้สำหรับช่วงพีค ไม่ใช่ช่วงที่เว็บว่าง เพื่อให้คุณบริหารกระแสเงินสดของตัวเองได้อิสระและรวดเร็วในทุกช่วงเวลา
    </p>
  </ContentBox>

  <ContentBox as="h2" title="มาตรฐานลิขสิทธิ์แท้และการดูแลความปลอดภัยของข้อมูลสมาชิก">
    <p class="mb-4 text-left text-base leading-relaxed text-[#f7e2e2]">
      เกมทุกเกมที่เปิดให้บริการเป็นลิขสิทธิ์แท้จากค่ายเกมแม่ อัตราการจ่ายและค่า RTP จึงเป็นค่าที่ค่ายเกมตั้งไว้ ไม่มีการดัดแปลงระหว่างทาง
      เปรียบเหมือนรถที่แรงมาจากโรงงานโดยไม่ต้องโมดิฟาย รอบโบนัสจึงเข้าอย่างเป็นธรรมชาติและยุติธรรมกับผู้เล่นทุกคนเท่ากัน
    </p>

    <p class="text-left text-base leading-relaxed text-[#f7e2e2]">
      ด้านความปลอดภัย เราใช้เทคโนโลยีเข้ารหัสข้อมูลเพื่อปกป้องข้อมูลส่วนตัวและบัญชีธนาคารของสมาชิก เสมือนมีโครงสร้างนิรภัยห่อหุ้มไว้อีกชั้น
      ความเร็วที่ปราศจากการควบคุมคือหายนะ เราจึงให้น้ำหนักกับความนิ่งของระบบเท่ากับความเร็ว และขอย้ำเสมอว่าไม่ควรส่งรหัสผ่านหรือรหัส OTP ให้บุคคลอื่นไม่ว่ากรณีใด
    </p>
  </ContentBox>

  <ContentBox as="h2" title="ไม่บังคับขั้นต่ำ รองรับวอเลท และใช้งานได้ทุกอุปกรณ์">
    <p class="mb-4 text-left text-base leading-relaxed text-[#f7e2e2]">
      เราเปิดให้ฝากและถอนแบบไม่บังคับขั้นต่ำ จะเริ่มจากยอดเล็กเพื่อวอร์มระบบ หรือเพิ่มน้ำหนักเมื่อจังหวะเข้ามือก็ทำได้ทันที ทุกการตัดสินใจอยู่ที่ผู้เล่น
      ระบบออโต้ทำหน้าที่แค่รองรับให้ทุกคำสั่งทำงานตรงไปตรงมา รวดเร็ว และเสถียร เหมือนการขับรถที่คุณเลือกเกียร์เองและเลือกความเร็วเอง
    </p>

    <p class="text-left text-base leading-relaxed text-[#f7e2e2]">
      นอกจากบัญชีธนาคาร เรายังรองรับทรูมันนี่วอลเล็ท ซึ่งช่วยตัดความยุ่งยากของการเติมเครดิตออกไป ไม่ต้องกังวลเรื่องแอปธนาคารปิดปรับปรุงในช่วงกลางดึก
      หน้าเว็บใช้งานได้ทั้งบนโทรศัพท์ แท็บเล็ต และคอมพิวเตอร์ผ่านเบราว์เซอร์ ไม่ต้องติดตั้งโปรแกรมเพิ่ม บัญชีเดียวใช้ได้ทุกอุปกรณ์
      เพราะเวลาที่ควรลุ้นคือตอนอยู่ในเกม ไม่ใช่ตอนนั่งหาว่าปุ่มฝากอยู่ตรงไหน
    </p>
  </ContentBox>

  <Navfoot />
</MainLayout>
