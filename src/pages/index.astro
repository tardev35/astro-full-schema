---
import MainLayout from "../layouts/MainLayout.astro";
import AnnouncementPremium from "../components/AnnouncementPremium.astro";
import ContentBoxPremium from "../components/ContentBoxPremium.astro";
import ContentBoxNeumorphism from "../components/ContentBoxNeumorphism.astro";
import ContentBoxSpecial from "../components/ContentBoxSpecial.astro";
import ContentBoxTwoPremium from "../components/ContentBoxTwoPremium.astro";
import ContentBoxSevenThreePremium from "../components/ContentBoxSevenThreePremium.astro";
import ContentBoxSevenThreeNeumorphism from "../components/ContentBoxSevenThreeNeumorphism.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import ProviderGrid from "../components/ProviderGrid.astro";
import GameRankingBoard from "../components/GameRankingBoard.astro";
import ReviewCardSumo2 from "../components/ReviewCardSumo2.astro";
import LatestWinners3 from "../components/LatestWinners3.astro";
import SmoothCarousel from "../components/SmoothCarousel.astro";
import Faq3 from "../components/Faq3.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import imgCommission from "../assets/slide1.png";
import imgAllInOne from "../assets/slide3.png";

const pageTitle = "GODDUBAI สล็อตเว็บตรงระดับสุลต่าน ไม่มีขั้นต่ำ แตกหนัก อัตราจ่ายสูง";

const pageDescription =
  "GODDUBAI สล็อตเว็บตรงระดับสุลต่าน แท้100% ที่รวยและแฟร์ที่สุด แตกหนัก อัตราจ่ายสูง ฝากถอนไม่มีขั้นต่ำ ระบบ Auto ไวใน 3 วินาที รองรับทุกช่องทาง ปลอดภัยระดับ VIP";

const commissionAlt =
  "โปรโมชั่น GODDUBAI คำว่า COMMISSION สีขาว ใต้ลงมาเขียนว่า คืนทุกยอดเล่นตลอดทั้งวัน และตัวเลข 0.3% สีเขียวมรกตขนาดใหญ่บนแผ่นป้ายสีน้ำตาลทอง ถัดลงมาเขียนว่า เล่นถึง 50% ถอนได้เลย รับสิทธิ์ก่อน 23.59 น. ของทุกวัน และ ยิ่งเล่นเยอะ ยิ่งได้เยอะ มุมขวาบนเป็นโลโก้ GOD DUBAI รูปเส้นขอบฟ้าตึกดูไบสีดำบนดวงอาทิตย์สีส้ม ด้านซ้ายเป็นพรีเซนเตอร์หญิงผมสีเงินถือเหรียญทอง";

const allInOneAlt =
  "แบนเนอร์ GODDUBAI ป้ายสี่เหลี่ยมสีน้ำตาลทองเรียงลงมาด้านซ้ายเขียนว่า หวย บอล บาคาร่า สล็อต ด้านล่างเป็นข้อความสีเขียวมรกตว่า ครบจบในที่เดียว แถบล่างสุดไล่รายการ บอล คาสิโน สล็อต ยิงปลา ไก่ชน มวย ไฮโล รูเล็ต มุมขวาบนเป็นโลโก้ GOD DUBAI รูปเส้นขอบฟ้าตึกดูไบสีดำบนดวงอาทิตย์สีส้ม ตรงกลางเป็นพรีเซนเตอร์หญิงผมดำถือไพ่สองใบ";

const faqs = [
  {
    q: "GODDUBAI เป็นเว็บสล็อตตรงลิขสิทธิ์แท้หรือไม่ มีเอเย่นต์คั่นกลางหรือเปล่า",
    a: "ใช่ครับ GODDUBAI เป็นเว็บสล็อตตรงลิขสิทธิ์แท้ 100% เชื่อม API ตรงจากค่ายใหญ่ทั่วโลก ไม่มีเอเย่นต์ ไม่มีปรับเรทหลังบ้าน ทุกการสปินโปร่งใส ตรวจสอบได้",
  },
  {
    q: "ฝากถอนขั้นต่ำเท่าไหร่ ถอนแล้วถูกหักค่าบริการหรือไม่",
    a: "เว็บนี้ฝากถอนไม่มีขั้นต่ำ 1 บาทก็ฝากได้ ถอนเท่าไหร่ก็ถอนได้เต็ม ไม่มีหัก ไม่มีค่าบริการ",
  },
  {
    q: "ค่า RTP ของเกมที่ GODDUBAI ถูกปรับลดหรือไม่ อัตราจ่ายเป็นอย่างไร",
    a: "ทุกเกมของ GODDUBAI ใช้ค่า RTP ตามมาตรฐานสากล ไม่แต่ง ไม่ปรับ ไม่ลด อัตราจ่ายสูง ไหลดีเหมือนเจอบ่อน้ำมันส่วนตัว แตกหนักแตกจริงทุกเกม",
  },
  {
    q: "ระบบธุรกรรม Auto ของ GODDUBAI ใช้เวลานานแค่ไหน",
    a: "ใช้ระบบ Auto High-Speed เวอร์ชันใหม่ ใช้เวลาประมวลผลเฉลี่ย 1–3 วินาทีทั้งฝากและถอน เร็วกว่ารถสปอร์ตออกตัว",
  },
  {
    q: "สมัครสมาชิก GODDUBAI ต้องใช้ข้อมูลอะไรบ้าง ปลอดภัยหรือไม่",
    a: "ใช้เพียงข้อมูลพื้นฐานเท่าที่จำเป็น ไม่มีการขอข้อมูลเกินจำเป็น ไม่มีรบกวน ไม่มี SMS ขยะ หลังสมัครเสร็จพร้อมเข้าเล่นทันที",
  },
];

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <AnnouncementPremium />

  <ContentBoxPremium as="h1" title="GODDUBAI สล็อตเว็บตรงระดับสุลต่าน ไม่มีขั้นต่ำ แตกหนัก อัตราจ่ายสูง">
    <div>
      <p class="text-left text-base leading-relaxed text-[#f1e6d3]">
        <strong class="text-[#f7cf8a]">GODDUBAI</strong> สล็อตเว็บตรงระดับสุลต่าน ลิขสิทธิ์แท้ แตกหนัก อัตราจ่ายสูง ระบบเร็ว ไม่มีขั้นต่ำ รองรับวอเล็ท สมัครฟรี ปลอดภัย โปร่งใส
        มั่นคงแบบเว็บใหญ่ดูไบแท้ๆ
      </p>
      <p class="mt-3 text-left text-base leading-relaxed text-[#f1e6d3]">
        GODDUBAI ที่นี่เรายกระดับมาตรฐานวงการเดิมพันให้หรูหราและมั่งคั่งสมชื่อ เปรียบเสมือนคุณกำลังเดินเข้าสู่คาสิโนส่วนตัวระดับ VIP ระบบที่เสถียรที่สุด เพื่อให้คุณได้รับประสบการณ์
        ผู้เล่นจะรู้สึกถึง “คุณภาพระดับพรีเมียม” ตั้งแต่วินาทีแรกที่เข้ามาสมัครแล้วเล่นสล็อตสักหนึ่งหน แล้วท่านจะเข้าใจ
      </p>
    </div>
  </ContentBoxPremium>

  <GameRankingBoard />

  <ContentBoxSevenThreePremium titleright="ทำไมต้อง GODDUBAI “เว็บเจ้ามือ” ที่รวยและแฟร์ที่สุด">
    <Picture
      slot="left"
      src={imgCommission}
      alt={commissionAlt}
      loading="lazy"
      fetchpriority="low"
      widths={[200, 400, 600]}
      sizes="(max-width: 768px) 100vw, 30vw"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      class="mx-auto h-auto w-full rounded-2xl border border-[#e8a13c]/30 shadow-[0_10px_30px_rgba(232,161,60,0.24)]"
    />
    <div slot="right">
      <p class="text-left text-base leading-relaxed text-[#f1e6d3]">
        “เจ้ามือบางเว็บต้องใช้ลูกไม้ตุกติก” มาโกงผู้เล่น เพราะเงินหมุนไม่ถึง แต่ GODDUBAI ไม่จำเป็นต้องทำแบบนั้นเลย ฐานทุนเราหนาเกินพอจะรองรับยอดถอนหลักล้านต่อวัน
      </p>
      <p class="mt-3 text-left text-base leading-relaxed text-[#f1e6d3]">
        ความแตกต่างของเราคือ “สายป่าน” ที่ยาวเหยียดครับ เรามีสภาพคล่องทางการเงินสูงมาก ทำให้เรากล้าแจกโปรโมชั่น และกล้าจ่ายยอดถอนใหญ่ๆ โดยไม่ต้องรอรอบบิล
        ความมั่นคงนี้แหละคือสิ่งที่คุณจะหาไม่ได้จากเว็บเล็กๆ ทั่วไป
      </p>
    </div>
  </ContentBoxSevenThreePremium>

  <SmoothCarousel />

  <ContentBoxSevenThreeNeumorphism titleright="GODDUBAI สล็อตเว็บตรงระดับสุลต่าน มาตรฐานดูไบ ของแท้100%">
    <Picture
      slot="left"
      src={imgAllInOne}
      alt={allInOneAlt}
      loading="lazy"
      fetchpriority="low"
      widths={[200, 400, 600]}
      sizes="(max-width: 768px) 100vw, 30vw"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      class="mx-auto h-auto w-full rounded-2xl border border-[#e8a13c]/30 shadow-[0_10px_30px_rgba(232,161,60,0.24)]"
    />
    <div slot="right">
      <p class="text-left text-base leading-relaxed text-[#f1e6d3]">
        GODDUBAI ยึดมั่นในคุณภาพสูงสุด เรานำเข้าระบบ API แท้ (Direct API) จากค่ายเกมยักษ์ใหญ่ทั่วโลก ส่งตรงแสดงผลลัพธ์มาที่หน้าจอคุณโดยไม่ผ่านเอเย่นต์ ความเสถียรของ เว็บสล็อต
        GODDUBAI ที่นี่จึงเปรียบเหมือนถนนไฮเวย์ในดูไบที่เรียบกริบ ไม่มีสะดุด ไม่มีกระตุก
      </p>
      <p class="mt-3 text-left text-base leading-relaxed text-[#f1e6d3]">
        และที่สำคัญคือ “ความยุติธรรม” เราไม่มีการปรับแต่งค่าใดๆ หลังบ้าน เพื่อให้คุณมั่นใจได้ว่า ทุกการสปินคือโอกาสรับโชคใหญ่ที่ขาวสะอาดและตรวจสอบได้จริง
      </p>
    </div>
  </ContentBoxSevenThreeNeumorphism>

  <ProviderGrid />

  <ContentBoxNeumorphism as="h2" title="GODDUBAI ฝากถอนไม่มีขั้นต่ำ เริ่มต้นแบบยาจก จบแบบเศรษฐี">
    <div>
      <p class="text-left text-base leading-relaxed text-[#f1e6d3]">
        แม้ภาพลักษณ์เราจะดูหรูหรา แต่เราเปิดกว้างให้ทุกคนเข้าถึงได้ไม่แบ่งชนชั้น ที่ GODDUBAI เราให้คุณทำธุรกรรม ไม่มีขั้นต่ำ มีเงินติดบัญชีแค่ 1 บาท ก็สามารถฝากเข้ามา เพื่อเริ่มเล่นสล็อต
        แตกดี แตกย่อย เพราะคำว่า “ดวง” ไม่ได้เลือกข้างคนรวยเสมอไป คนทุนน้อยก็มีสิทธิ์เป็นเศรษฐีได้ที่นี่
      </p>
      <p class="mt-3 text-left text-base leading-relaxed text-[#f1e6d3]">
        คุณสามารถบริหารเงินหน้าตักได้อย่างอิสระ อยากฝากเท่าไหร่ อยากถอนตอนไหน จัดการได้เอง 100% ไม่มีเงื่อนไขผูกมัดให้ปวดหัว
      </p>
    </div>
  </ContentBoxNeumorphism>

  <ContentBoxSpecial as="h2" title="ระบบธุรกรรม Auto ไวกว่าซูเปอร์คาร์ รองรับทุกช่องทาง">
    <div slot="left">
      <p class="text-left text-base leading-relaxed text-[#f1e6d3]">
        ชีวิตเศรษฐี เวลาเป็นเงินเป็นทองครับ ระบบฝาก-ถอนของเราจึงต้องเร็วที่สุด เราใช้เทคโนโลยี ฝากถอน Auto High-Speed เวอร์ชันล่าสุด ที่ประมวลผลยอดเงินของคุณภายใน 3 วินาที
        เร็วกว่ารถสปอร์ตออกตัวซะอีก
      </p>
    </div>
    <div slot="right">
      <p class="text-left text-base leading-relaxed text-[#f1e6d3]">
        ไม่ว่าคุณจะใช้บัญชีธนาคารชั้นนำ หรือ True Money Wallet ระบบของเราก็รองรับครบถ้วน ทำรายการได้ตลอด 24 ชั่วโมง โดยไม่ต้องส่งสลิปให้แอดมินดู เงินเข้าปุ๊บ เล่นต่อได้ปั๊บ
        ความต่อเนื่องคือหัวใจสำคัญของการทำกำไร และเราไม่ยอมให้คุณเสียจังหวะแน่นอน
      </p>
    </div>
  </ContentBoxSpecial>

  <LatestWinners3 />

  <ContentBoxTwoPremium
    as="h2"
    title="สมัคร GODDUBAI ง่ายมาก ใช้ข้อมูลน้อย ปลอดภัยระดับ VIP"
    titleleft="กรอกแค่เท่าที่จำเป็น"
    titleright="เข้ารหัสระดับแอปธนาคาร">
    <p slot="left" class="text-left text-base leading-relaxed text-[#f1e6d3]">
      ขั้นตอนสมัครถูกทำให้เรียบง่ายที่สุด กรอกข้อมูลแค่เท่าที่จำเป็น ไม่มีการขอข้อมูลแปลก ๆ หรือสิ่งที่ทำให้ผู้เล่นรู้สึกล้ำเส้น
    </p>
    <p slot="right" class="text-left text-base leading-relaxed text-[#f1e6d3]">
      ข้อมูลทุกอย่างเข้ารหัสตามมาตรฐานเดียวกับแอปธนาคาร ไม่มีการขายข้อมูล ไม่มี SMS ขยะ ไม่มีการรบกวนใดๆ สมัครเสร็จพร้อมเข้าเล่นทันทีภายในไม่ถึง 10 วินาที
    </p>
  </ContentBoxTwoPremium>

  <LoginRtpSection />

  <div class="relative z-10 mx-auto mb-10 flex flex-nowrap justify-center gap-3 px-4 sm:gap-6">
    <a
      href="/login"
      class="group relative flex flex-1 items-center justify-center rounded-full bg-gradient-to-r from-[#f7cf8a] via-[#e8a13c] to-[#a8611a] px-4 py-3 text-sm font-black whitespace-nowrap text-[#091310] shadow-[0_10px_30px_rgba(232,161,60,0.3)] transition-all duration-300 hover:-translate-y-1 hover:scale-105 hover:shadow-[0_15px_40px_rgba(232,161,60,0.4)] sm:flex-none sm:px-10 sm:py-3.5 sm:text-base">
      เข้าสู่ระบบ
    </a>

    <a
      href="/register"
      class="group relative flex flex-1 items-center justify-center rounded-full border border-[#e8a13c]/70 bg-[#0f1d16]/85 px-4 py-3 text-sm font-black whitespace-nowrap text-[#f7cf8a] backdrop-blur-sm transition-all duration-300 hover:scale-105 hover:border-[#e8a13c] hover:bg-[#12251b]/85 hover:shadow-[0_15px_40px_rgba(232,161,60,0.35)] sm:flex-none sm:px-10 sm:py-3.5 sm:text-base">
      สมัครสมาชิก
    </a>
  </div>

  <Faq3 title="คำถามที่พบบ่อยเกี่ยวกับ GODDUBAI" faqs={faqs} />

  <ReviewCardSumo2 />

  <Navfoot />
</MainLayout>
