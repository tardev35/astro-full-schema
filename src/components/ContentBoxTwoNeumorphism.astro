---
const { titleleft, titleright } = Astro.props;
---

<section class="mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="w-full rounded-[25px] bg-[#1a0414] p-8 shadow-[10px_10px_20px_#0a0208,-10px_-10px_20px_#2b0722] transition-all duration-300 hover:shadow-[15px_15px_30px_#050104,-15px_-15px_30px_#3d0b31]">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f7e3f4]">
        {titleleft && <h2 class="text-2xl leading-normal font-black tracking-wide text-[#f5c451] drop-shadow-[0_0_10px_rgba(255,61,219,0.35)]">{titleleft}</h2>}
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f7e3f4] md:border-l md:border-[#ff3ddb]/20 md:pl-8">
        {titleright && <h2 class="text-2xl leading-normal font-black tracking-wide text-[#f5c451] drop-shadow-[0_0_10px_rgba(255,61,219,0.35)]">{titleright}</h2>}
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
