---
import { BRAND_NAME } from "../lib/brandProfile";

const reviews = [
  {
    name: "สมาชิกที่ไม่มีบัญชีธนาคาร",
    role: "ฝากถอนผ่านทรูวอเลท",
    stars: 5,
    content:
      "ไม่มีบัญชีธนาคารก็เริ่มได้ ใช้ทรูวอเลทฝากถอนแทน ขั้นต่ำแค่ 1 บาท โอนเสร็จระบบออโต้ปรับเครดิตให้เอง ไม่ต้องส่งสลิปให้ใครตรวจ ตอนถอนก็กดเองจากหน้าเว็บ",
    avatar: "👛",
  },
  {
    name: "สายปั่นที่สลับค่ายบ่อย",
    role: "สล็อตกระเป๋าเดียว",
    stars: 5,
    content:
      "เล่นสาวถ้ำของ PG Soft อยู่แล้วอยากไปต่อ Sugar Rush ก็กดเปลี่ยนได้เลย ทุกค่ายใช้กระเป๋าเดียว ไม่ต้องย้ายเครดิตไปมา ยอดเดิมใช้ต่อได้ทันที",
    avatar: "🎰",
  },
  {
    name: "สายบาคาร่าที่เล่นบนแท็บเล็ต",
    role: "คาสิโนสดผ่านเบราว์เซอร์",
    stars: 5,
    content:
      "ดูเค้าไพ่บนมือถือแล้วตัวเล็ก เลยย้ายไปเปิดบนแท็บเล็ตด้วยยูสเดิม เข้าผ่านเบราว์เซอร์ ไม่ต้องโหลดแอป โต๊ะ SA Gaming กับ Sexy Baccarat อยู่ในยูสเดียวกับสล็อต",
    avatar: "🃏",
  },
];

const sectionTitle = `เสียงจากสมาชิก ${BRAND_NAME}`;
---

<section aria-label={sectionTitle} class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="text-2xl leading-normal font-black tracking-wide text-white md:text-3xl">
      เสียงจาก <span class="text-[#ffd24d]">สมาชิก {BRAND_NAME}</span>
    </p>
    <div aria-hidden="true" class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-[#c77d00] via-[#fcaa04] to-[#2f9e1f]"></div>
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-3 lg:gap-8">
    {
      reviews.map((review) => (
        <article class="group relative isolate flex flex-col justify-between overflow-hidden rounded-3xl border border-[#2a6b2c] bg-[#0c2a12] p-8 shadow-[0_10px_30px_rgba(1,10,3,0.45)] transition-all duration-500 hover:-translate-y-1 hover:border-[#fcaa04]/60 hover:shadow-[0_15px_40px_rgba(252,170,4,0.16)]">
          <div aria-hidden="true" class="pointer-events-none absolute -top-10 -left-10 -z-10 h-32 w-32 rounded-full bg-[#2f9e1f]/25 blur-[50px] transition-all duration-500 group-hover:bg-[#fcaa04]/20" />

          <div class="flex flex-col gap-4">
            <div class="flex items-center justify-between border-b border-[#2a6b2c] pb-4">
              <span aria-hidden="true" class="font-serif text-4xl leading-none text-[#fcaa04]/60">
                "
              </span>
              <span class="flex gap-1 text-lg">
                <span aria-hidden="true" class="flex gap-1">
                  {Array.from({ length: 5 }).map((_, i) => (
                    <span class={i < review.stars ? "text-[#ffd24d]" : "text-[#2a6b2c]"}>★</span>
                  ))}
                </span>
                <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
              </span>
            </div>

            <p class="min-h-[100px] text-left text-base leading-relaxed text-[#e3eedf]">{review.content}</p>
          </div>

          <div class="mt-6 flex items-center gap-4 border-t border-[#2a6b2c] pt-4">
            <span
              aria-hidden="true"
              class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full border-2 border-[#2a6b2c] bg-gradient-to-br from-[#123a1a] to-[#072010] text-2xl shadow-[0_5px_15px_rgba(252,170,4,0.15)] transition-transform duration-300 group-hover:scale-110">
              {review.avatar}
            </span>
            <span class="flex flex-col">
              <span class="text-base font-black text-white transition-colors group-hover:text-[#ffd24d]">{review.name}</span>
              <span class="text-[11px] font-bold tracking-wider text-[#b5cbb0]">{review.role}</span>
            </span>
          </div>
        </article>
      ))
    }
  </div>
</section>
