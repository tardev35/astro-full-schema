---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;
const rightHeading = titleright ?? title;
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="w-full rounded-[25px] border border-[#cfe9f4] bg-white p-8 shadow-[8px_8px_18px_rgba(12,53,80,0.10),-6px_-6px_16px_#ffffff] transition-all duration-300 hover:border-[#8ed3ee] hover:shadow-[12px_12px_26px_rgba(0,164,212,0.18),-8px_-8px_20px_#ffffff]">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#23323f]">
        {titleleft && <p class="text-2xl leading-normal font-black text-[#a35000]">{titleleft}</p>}
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#23323f] md:border-l md:border-[#cfe9f4] md:pl-8">
        {rightHeading && <HeadingTag class="border-l-4 border-[#f7941d] pl-3 text-2xl leading-normal font-black text-[#0c3550]">{rightHeading}</HeadingTag>}
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
