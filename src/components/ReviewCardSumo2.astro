---
const reviews = [
  {
    name: "สมาชิกที่ลองเกมก่อนเปิดยูสจริง",
    role: "ใช้โหมดทดลองเล่นฟรีดูรูปแบบเกม",
    stars: 5,
    tag: "ทดลองเล่นฟรี",
    content:
      "ผมไม่ชอบลงเงินกับเกมที่ยังไม่รู้ว่าเล่นยังไงครับ พอที่นี่เปิดโหมดทดลองให้กดดูฟีเจอร์ก่อนก็ตัดสินใจง่ายขึ้นเยอะ ลองของ PG กับ JILI ไปหลายตัวแล้วค่อยเลือกที่ถูกใจมาเล่นจริง เครดิตในโหมดนี้เป็นของจำลอง ถอนไม่ได้ แต่ก็พอให้เห็นว่าเกมเดินยังไง",
    avatar: "🕹️",
  },
  {
    name: "สมาชิกที่สลับค่ายบ่อยระหว่างวัน",
    role: "เครดิตรวมอยู่ที่ Smart Wallet จุดเดียว",
    stars: 5,
    tag: "Smart Wallet",
    content:
      "เมื่อก่อนต้องคอยจำว่าเงินค้างอยู่ค่ายไหนค่ะ พอเครดิตมารวมที่กระเป๋าเดียวก็เปลี่ยนเกมได้เลย ไม่ต้องโยกเงินเองก่อนเข้าเกมใหม่ วันไหนอยากเล่นเกมไว วันไหนอยากนั่งรอรอบโบนัส ก็สลับได้ในบัญชีเดิม ไม่ต้องเปลี่ยนเว็บตามอารมณ์",
    avatar: "👛",
  },
  {
    name: "สมาชิกที่เปลี่ยนอุปกรณ์ระหว่างวัน",
    role: "ยูสเดิมใช้ได้ทั้งมือถือ แท็บเล็ต และคอม",
    stars: 5,
    tag: "เข้าสู่ระบบทุกอุปกรณ์",
    content:
      "กลางวันผมเปิดจากคอมที่ทำงาน กลับบ้านต่อจากมือถือครับ ล็อกอินด้วยยูสเดิมได้เลย ไม่ต้องสมัครใหม่ตามเครื่อง เกมที่เล่นค้างไว้กับยอดเครดิตยังอยู่ที่เดิม หน้าจอย่อขยายมาพอดี ไม่ต้องซูมหาปุ่มเหมือนบางเว็บ",
    avatar: "📱",
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label="เสียงจากสมาชิก RIEL38" class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#9d174d] via-[#db2777] to-[#7e22ce] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      เสียงจากสมาชิก <span class="text-[#db2777]">RIEL38</span>
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#ec4899] to-transparent"></div>
  </div>

  <div class="mx-auto mb-8 flex max-w-md items-center justify-center gap-5 rounded-2xl border border-[#f9a8d4] bg-white px-6 py-4 shadow-[0_10px_30px_rgba(236,72,153,0.14)]">
    <div class="flex flex-col items-center">
      <span class="bg-gradient-to-b from-[#db2777] to-[#7e22ce] bg-clip-text text-4xl leading-none font-black text-transparent">{average}</span>
      <span class="mt-1 text-[10px] font-bold tracking-widest text-[#8a5670] uppercase">คะแนนเฉลี่ย</span>
    </div>
    <div class="h-12 w-px bg-[#f9a8d4]"></div>
    <div class="flex flex-col gap-1.5">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#ec4899]" : "text-[#fbcfe8]"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#8a5670]">คะแนนเฉลี่ย {average} จาก 5 ดาว จากการใช้งานจริงของสมาชิก {reviews.length} ด้าน</span>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
    {
      reviews.map((review) => (
        <article class="group relative isolate flex flex-col gap-4 overflow-hidden rounded-2xl border border-[#f9a8d4] bg-white p-6 text-left shadow-[0_10px_30px_rgba(236,72,153,0.12)] transition-all duration-300 hover:-translate-y-1 hover:border-[#ec4899]/60 hover:shadow-[0_15px_40px_rgba(236,72,153,0.22)]">
          <span class="absolute inset-y-0 left-0 -z-10 w-1 bg-gradient-to-b from-[#ec4899] to-[#a855f7] opacity-80 transition-opacity duration-300 group-hover:opacity-100" />
          <span class="pointer-events-none absolute -top-14 -right-14 -z-10 h-32 w-32 rounded-full bg-[#ec4899]/12 blur-[50px] transition-all duration-300 group-hover:bg-[#a855f7]/18" />

          <div class="flex items-center justify-between gap-3">
            <span class="inline-flex items-center gap-1.5 rounded-full border border-[#fbcfe8] bg-[#fdf2f8] px-3 py-1 text-[10px] font-bold tracking-widest text-[#9d174d] uppercase">
              <span aria-hidden="true" class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#ec4899]" />
              {review.tag}
            </span>
            <span class="flex gap-0.5 text-sm">
              <span aria-hidden="true" class="flex gap-0.5">
                {Array.from({ length: 5 }).map((_, i) => (
                  <span class={i < review.stars ? "text-[#ec4899]" : "text-[#fbcfe8]"}>★</span>
                ))}
              </span>
              <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
            </span>
          </div>

          <p class="text-left text-base leading-relaxed text-[#5b2140]">{review.content}</p>

          <div class="mt-auto flex items-center gap-3 border-t border-[#fbcfe8] pt-4">
            <span
              aria-hidden="true"
              class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#f9a8d4] bg-gradient-to-br from-[#f472b6] via-[#ec4899] to-[#a855f7] text-xl shadow-inner transition-transform duration-300 group-hover:scale-110">
              {review.avatar}
            </span>
            <span class="flex flex-col">
              <span class="text-sm font-black text-[#9d174d] transition-colors group-hover:text-[#831843]">{review.name}</span>
              <span class="text-[10px] font-bold tracking-wider text-[#8a5670] uppercase">{review.role}</span>
            </span>
          </div>
        </article>
      ))
    }
  </div>
</section>
