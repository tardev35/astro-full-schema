---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";

import { Picture } from "astro:assets";

import pro1 from "../assets/slide1.png";
import pro2 from "../assets/slide2.png";
import pro3 from "../assets/slide3.png";
import pro4 from "../assets/slide4.png";
import { pageGraph } from "../lib/schema";

const pageTitle = "โปรโมชั่น ONEHENG89 รวมภาพโปรสล็อตเกมลิขสิทธิ์แท้ โบนัสสมาชิก และระบบออโต้";

const pageHeading = "โปรโมชั่น ONEHENG89";

const pageDescription =
  "รวมภาพโปรโมชั่น ONEHENG89 ไว้ในหน้าเดียว ทั้งโบนัสแนะนำสมาชิก คืนยอดเสียรายสัปดาห์ โบนัสฝากประจำวัน และสิทธิ์ที่ผูกกับระบบออโต้ อ่านเงื่อนไขบนภาพก่อนใช้สิทธิ์";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: pro1.src,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageHeading} as="h1">
    <p class="mb-8 text-left text-base leading-relaxed text-[#1b2c4a]">
      หน้านี้รวมภาพโปรโมชั่นที่ <strong class="text-[#0b3fb8]">ONEHENG89</strong> เปิดให้สมาชิกดูก่อนเลือกใช้ ทั้งโบนัสแนะนำสมาชิก คืนยอดเสียรายสัปดาห์ โบนัสฝาก และสิทธิ์ที่ผูกกับระบบออโต้ฝากถอน
      แต่ละรายการมีเงื่อนไข ค่ายเกมที่ร่วมรายการ และช่วงเวลาที่เปิดใช้งานต่างกัน โดยรายละเอียดทั้งหมดพิมพ์ไว้บนภาพแล้ว จึงควรอ่านให้ครบก่อนเลือกโปรที่เหมาะกับงบของตัวเอง
      จากนั้นสมัครสมาชิกจากปุ่มด้านล่างเพื่อเข้าสู่ระบบ เลือกเกมลิขสิทธิ์แท้จากค่ายดัง และจัดการเครดิตต่อได้จากบัญชีเดียว
      โบนัสมีไว้เพิ่มความคุ้ม ไม่ใช่เพิ่มงานอ่านเงื่อนไขระดับรายงานประจำปี
    </p>

    <div class="grid w-full grid-cols-1 gap-6 sm:grid-cols-2">
      <Picture
        src={pro1}
        alt="ภาพโปรโมชั่น ONEHENG89 โทนขาว น้ำเงิน เขียว หัวเรื่องว่า ONEHENG89 แนะนำสมาชิกวันนี้ มีแต่ได้กับได้ ถัดลงมาเป็นข้อความ โบนัสแนะนำสมาชิก 0.3% และ สะสมนานสูงสุด 1 เดือน ล้อมด้วยป้ายหกช่องเขียนว่า เว็บสล็อตโบนัสไหล เกมลิขสิทธิ์แท้ ระบบออโต้ 24 ชม. แนะนำง่ายได้ทุกคน ยิ่งเล่นเยอะยิ่งได้เยอะ และ มั่นคง ปลอดภัย 100% ด้านข้างเป็นพรีเซนเตอร์หญิงสวมชุดกีฬาสีขาวสลับน้ำเงิน"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class="mx-auto h-auto w-full rounded-xl border border-[#c7dcfb] object-contain shadow-[0_10px_30px_rgba(11,63,184,0.14)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#0b3fb8]/50 hover:shadow-[0_15px_40px_rgba(11,63,184,0.20)]"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />

      <Picture
        src={pro2}
        alt="ภาพโปรโมชั่น ONEHENG89 พื้นขาวน้ำเงิน หัวเรื่องว่า ศูนย์รวมสล็อตจากค่ายระดับประเทศ ถัดลงมาเขียนว่า รวมทุกค่ายดัง เล่นง่าย ได้จริง จ่ายเต็ม พร้อมป้ายสี่ช่องเขียนว่า รวมทุกค่าย ระบบออโต้ ฝาก-ถอนไว มั่นคง ปลอดภัย เชื่อถือได้ 100% และ ซัพพอร์ต 24 ชม. ด้านล่างเป็นแถบโลโก้ธนาคารและทรูมันนี่วอลเล็ท ด้านข้างเป็นพรีเซนเตอร์หญิงถือโทรศัพท์มือถือ"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class="mx-auto h-auto w-full rounded-xl border border-[#c7dcfb] object-contain shadow-[0_10px_30px_rgba(11,63,184,0.14)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#0b3fb8]/50 hover:shadow-[0_15px_40px_rgba(11,63,184,0.20)]"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />

      <Picture
        src={pro3}
        alt="ภาพโปรโมชั่น ONEHENG89 พื้นขาวเขียวน้ำเงิน หัวเรื่องว่า คืนทุนยอดเสีย ทุกสัปดาห์ 5% ถัดลงมาเขียนว่า ไม่ต้องทำเทิร์น ถอนเงินโบนัสได้ทันที และ รับเงินคืน 5% จากยอดเสียรวมทุกวันจันทร์ พร้อมป้ายสี่ช่องเขียนว่า เกมลิขสิทธิ์แท้ ฝาก-ถอน AUTO มั่นคง ปลอดภัย และ บริการดูแลตลอด 24 ชม. ด้านล่างเป็นแถบโลโก้ธนาคาร"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class="mx-auto h-auto w-full rounded-xl border border-[#c7dcfb] object-contain shadow-[0_10px_30px_rgba(11,63,184,0.14)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#0b3fb8]/50 hover:shadow-[0_15px_40px_rgba(11,63,184,0.20)]"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />

      <Picture
        src={pro4}
        alt="ภาพโปรโมชั่น ONEHENG89 พื้นขาวน้ำเงิน หัวเรื่องว่า ฝาก 100 รับ 50 ถัดลงมาเขียนว่า ทำยอด 750 ถอนได้ 500 เดิมพันได้เฉพาะค่าย PG และ JILI เท่านั้น และ เงื่อนไขเป็นไปตามที่กำหนด พร้อมป้ายสี่ช่องเขียนว่า ค่ายเกมดัง เล่นง่าย ถอนได้ไว ปลอดภัย 100% และ บริการ 24 ชม. ข้างกันเป็นการ์ดไลน์ไอดี @one89 ส่วนด้านหน้าเป็นพรีเซนเตอร์หญิงชุดน้ำเงินยืนคู่กับตัวการ์ตูนเพนกวินของค่าย PG"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class="mx-auto h-auto w-full rounded-xl border border-[#c7dcfb] object-contain shadow-[0_10px_30px_rgba(11,63,184,0.14)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#0b3fb8]/50 hover:shadow-[0_15px_40px_rgba(11,63,184,0.20)]"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />
    </div>

    <div class="mt-12 flex justify-center pb-4">
      <a
        href="/register"
        class="flex items-center justify-center rounded-lg border border-[#0b3fb8]/40 bg-gradient-to-r from-[#062c85] via-[#0b3fb8] to-[#16a34a] px-10 py-3.5 text-lg font-black text-white shadow-[0_10px_30px_rgba(11,63,184,0.14)] transition-transform hover:scale-105 hover:shadow-[0_15px_40px_rgba(22,163,74,0.18)]">
        สมัครสมาชิก ONEHENG89
      </a>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
