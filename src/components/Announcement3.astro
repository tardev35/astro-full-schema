---
const {
  message = "ONEHENG89 รวมสล็อตเกมลิขสิทธิ์แท้ โบนัส และระบบออโต้ไว้ในบัญชีเดียว • เลือกเกมจากหลายค่าย เช็กเครดิต และดูสิทธิ์โบนัสได้จากหน้าสมาชิกหน้าเดียว ทั้งมือถือและคอมพิวเตอร์ • ระบบออโต้รองรับการฝากถอนและตรวจข้อมูลบัญชีตลอด 24 ชั่วโมง • ทางเข้า ONEHENG89 เว็บหลัก ใช้บัญชีเดิมกลับเข้าเล่นต่อได้ทันที",
} = Astro.props;
---

<div class="mx-auto mt-4 max-w-[900px] px-4 md:px-0">
  <div
    class="relative flex h-[46px] items-center rounded-r-full border border-[#c7dcfb] bg-gradient-to-r from-[#e6efff] to-white py-2 pr-4 pl-12 shadow-[0_0_20px_rgba(11,63,184,0.10)] backdrop-blur-md">
    <div class="absolute top-1/2 -left-2 flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full border-[3px] border-[#0b3fb8] bg-white shadow-[0_0_15px_rgba(11,63,184,0.30)]">
      <span aria-hidden="true" class="animate-pulse text-xl">📢</span>
    </div>

    <div class="mr-4 h-full w-[1px] bg-[#0b3fb8]/25"></div>

    <div class="flex-1 overflow-hidden [mask-image:linear-gradient(90deg,transparent_0%,#000_5%,#000_95%,transparent_100%)]">
      <div class="flex w-max animate-[scroll_25s_linear_infinite] gap-12 text-sm font-bold whitespace-nowrap text-[#0a1c3a]">
        <span>{message}</span>
        <span>{message}</span>
      </div>
    </div>
  </div>
</div>

<style>
  @keyframes scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(calc(-50% - 24px));
    }
  }
</style>
