---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement.astro";
import { pageGraph } from "../lib/schema";

const pageTitle = "เกี่ยวกับเรา YIMSIAM88 สล็อตเว็บตรงไทยแท้ ทีมงานคนไทยดูแลเอง";

const pageDescription =
  "เกี่ยวกับเรา YIMSIAM88 สล็อตเว็บตรงไทยแท้ ทำเพื่อคนไทย โบนัสแตกตามธรรมชาติด้วย RNG มาตรฐานโลก จ่ายเต็มไม่มีหัก ฝากถอนออโต้ไม่มีขั้นต่ำ ทีมงานคนไทยดูแล 24 ชม.";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle}>
    <p class="mb-4 text-left text-base leading-relaxed text-[#f7e6d4]">
      YIMSIAM88 (ยิ้มสยาม88) เป็นสล็อตเว็บตรงไทยแท้ที่ตั้งใจทำให้มัน “ไทยแท้แบบมีมาตรฐาน” ครับ ไม่ได้ตั้งใจเป็นห้างสรรพสินค้าที่ขายทุกอย่าง แต่ตั้งใจทำสล็อตให้ดีจริงเรื่องเดียว
      หน้าเว็บของเราจึงเป็นเมนูภาษาไทยตัวใหญ่ชัดเจน จัดหมวดหมู่เกมให้หาง่ายเหมือนเดินเข้าเซเว่น อยากเล่นเกมไหน ค่ายอะไร จิ้มปุ๊บเจอเลย ไม่ต้องเดาว่าปุ่มไหนทำอะไร
      และทีมงานหลังบ้านก็คนไทยแท้ๆ คุยกันรู้เรื่อง เข้าใจมุก เข้าใจปัญหา ไม่ต้องมานั่งคุยกับบอทหรือคนต่างชาติที่ใช้ Google Translate ตอบ เราดูแลกันแบบพี่แบบน้อง สบายใจหายห่วง
    </p>

    <p class="mb-4 text-left text-base leading-relaxed text-[#f7e6d4]">
      เรื่องเกม ทุกเกมของเรารันด้วยระบบ RNG มาตรฐานโลก การแตกของโบนัสจึงเป็นไปอย่างเป็นธรรมชาติที่สุด บทจะแตกก็แตกจนร้องขอชีวิต บทจะเข้าฟรีสปินก็ไหลยาวเป็นหางว่าว
      คำว่าโบนัสแรงของเราคือแรงตามดวงและจังหวะเกมจริงๆ ไม่มีการกั๊กช่วงเวลา ไม่มีการปรับ % ให้เกลือเพื่อกินตังค์ท่าน เล่นได้คือได้ เล่นเสียคือเสียตามเกมแฟร์ๆ วัดกันที่ดวงและฝีมือล้วนๆ
      ส่วนเรื่องเงิน ระบบออโต้ของเราพัฒนามาให้ไวดั่งใจนึก กดถอนปุ๊บเงินเด้งเข้าบัญชีปั๊บภายในไม่กี่วินาที ไม่มีขั้นต่ำของจริง ฝาก 1 บาทก็เล่นได้ รองรับทุกช่องทางรวมถึง True Money Wallet
      และคำมั่นสัญญาของลูกผู้ชายคือ จ่ายเต็มไม่มีหัก จะถอนหลักร้อยหรือแจ็คพอตหลักล้าน เราโอนให้ครบทุกบาททุกสตางค์ ไม่หักเป็นค่าธรรมเนียมหรือค่าดำเนินการใดทั้งสิ้น
    </p>

    <p class="text-left text-base leading-relaxed text-[#f7e6d4]">
      เรื่องข้อมูลส่วนตัว เราเลือกเดินทางแบบไทยแท้ ใจกว้าง ไม่ล้ำเส้น ขอเท่าที่จำเป็นเพื่อยืนยันตัวตนเท่านั้น ไม่ต้องส่งบัตร ไม่ต้องถ่ายหน้า สมัครง่ายๆ ไวๆ แล้วเข้าเล่นได้เลยในไม่กี่วินาที
      หน้าเว็บชุดนี้ทำหน้าที่เป็นหน้าข้อมูลและแนะนำ ไม่ได้รับเดิมพันเอง ไม่ได้เก็บยอดเงินของใครไว้ และไม่ได้ทำรายการฝากถอนแทนผู้ใช้ สิ่งที่เขียนไว้จึงตั้งใจให้อ่านแล้วเอาไปตรวจต่อได้จริง
      เช่น คำว่าจ่ายจริงควรดูจากสถานะการถอนและประวัติรายการในบัญชีของตัวเอง ไม่ใช่จากข้อความบนแบนเนอร์ และควรตรวจชื่อเว็บไซต์กับการเชื่อมต่อ HTTPS ทุกครั้งก่อนล็อกอิน
      มีอะไรติดขัด ทักไลน์มาได้ตลอด 24 ชั่วโมง ไม่มีวันหยุดราชการ เพราะความสบายใจของท่านคือหน้าที่ของเราครับ
    </p>
  </ContentBox>

  <Navfoot />
</MainLayout>
