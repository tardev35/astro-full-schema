---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import { pageGraph } from "../lib/schema";

const pageTitle = "เกี่ยวกับเรา VING999 เว็บตรงอันดับ1 รวมสล็อตออนไลน์ เกมค่ายดัง ฝากถอนออโต้";

const pageHeading = "เกี่ยวกับเรา VING999 เว็บตรงอันดับ1 รวมสล็อตออนไลน์ เกมค่ายดัง และระบบออโต้ในยูสเดียว";

const pageDescription =
  "เกี่ยวกับเรา VING999 เว็บตรงอันดับ1 รวมสล็อตออนไลน์เกมค่ายดังในยูสเดียว ฝากถอนออโต้จากหน้าเมมเบอร์ รองรับธนาคารและ TrueWallet ฝากขั้นต่ำ 1 บาท เล่นผ่านมือถือ";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox as="h1" title={pageHeading}>
    <p class="mb-4 text-left text-base leading-relaxed text-[#dce3e8]">
      <strong class="text-[#bdcad2]">VING999</strong> เป็นเว็บตรงสำหรับสายสล็อตที่รวมเกมจากหลายค่ายไว้ในยูสเดียว เข้าสู่ระบบครั้งเดียวแล้วเลือกเกม เช็กเครดิต หรือดูโปรที่เปิดอยู่ได้จากหน้าเมมเบอร์เดียวกัน
    </p>

    <p class="mb-4 text-left text-base leading-relaxed text-[#dce3e8]">
      ระบบฝากถอนผูกอยู่กับบัญชีสมาชิก ทำรายการเองได้ตรงจากหน้าเมมเบอร์ รองรับทั้งบัญชีธนาคารและ TrueWallet และใช้ยูสเดิมได้ทั้งบนมือถือและคอมพิวเตอร์
    </p>

    <p class="mb-4 text-left text-base leading-relaxed text-[#dce3e8]">
      หน้าเมมเบอร์รวมเกม เครดิต โปร และประวัติรายการไว้จุดเดียว จึงย้อนดูได้ว่าทำอะไรไปแล้ว และกำลังใช้สิทธิ์ตัวไหนอยู่
    </p>

    <p class="text-left text-base leading-relaxed text-[#dce3e8]">เปลี่ยนเกมกี่รอบ บัญชีก็ยังเป็นใบเดิม</p>
  </ContentBox>

  <ContentBox as="h2" title="VING999 รวมสล็อตออนไลน์เกมแบบไหนไว้ให้เลือก">
    <p class="mb-4 text-left text-base leading-relaxed text-[#dce3e8]">
      หมวดสล็อตของ VING999 มีทั้งเกมหมุนคลาสสิก เกมฟรีสปิน เกมโบนัสฟีเจอร์ และเกมใหม่จากผู้ให้บริการหลายค่าย รวมอยู่ในหน้าเดียวกันทั้งหมด
    </p>

    <p class="mb-4 text-left text-base leading-relaxed text-[#dce3e8]">
      โครงแบบนี้เหมาะทั้งกับคนที่มีเกมประจำอยู่แล้ว และคนที่ชอบลองของใหม่ อยากเปลี่ยนแนวก็เลือกหมวดหรือเลือกค่าย แล้วเข้าเล่นต่อจากยูสเดิมได้ทันที
    </p>

    <p class="text-left text-base leading-relaxed text-[#dce3e8]">เกมเยอะเป็นข้อดีก็ต่อเมื่อหาเจอ หน้าเกมจึงแยกตามค่ายและหมวดไว้ให้</p>
  </ContentBox>

  <ContentBox as="h2" title="ฝากถอนออโต้ VING999 ทำรายการจากหน้าเมมเบอร์ยังไง">
    <p class="mb-4 text-left text-base leading-relaxed text-[#dce3e8]">
      ระบบฝากถอนเชื่อมอยู่กับบัญชีสมาชิก ฝากเครดิต ถอนยอด และเช็กสถานะรายการทำได้จากจุดเดียว ไม่ต้องออกจากหน้าเว็บไปตามหลายช่องทางก่อนกลับเข้าเกม
    </p>

    <p class="mb-4 text-left text-base leading-relaxed text-[#dce3e8]">
      ช่วงระหว่างเติมเครดิตกับเข้าเกมควรสั้นที่สุด ระบบที่ทำงานได้เองจึงมีผลกับสายที่เล่นดึก เพราะไม่ต้องรอคำตอบว่าใครออนอยู่บ้าง
    </p>

    <p class="text-left text-base leading-relaxed text-[#dce3e8]">รหัสผ่านและ OTP ไม่ควรส่งต่อให้ใคร แม้แต่คนที่ทักมาแล้วบอกว่าเป็นทีมงาน</p>
  </ContentBox>

  <ContentBox as="h2" title="VING999 รองรับธนาคารและ TrueWallet ช่องทางไหนบ้าง">
    <p class="mb-4 text-left text-base leading-relaxed text-[#dce3e8]">
      ช่องทางการเงินรองรับทั้งบัญชีธนาคารและ TrueWallet เลือกวิธีที่ถนัดได้จากระบบสมาชิก โดยไม่ต้องเปลี่ยนวิธีใช้เงินที่ใช้อยู่ทุกวัน
    </p>

    <p class="text-left text-base leading-relaxed text-[#dce3e8]">
      สายมือถือมักถนัดวอเลทเพราะทำรายการได้ไว ส่วนคนที่ผูกบัญชีธนาคารไว้เป็นหลักก็ใช้ต่อได้ตามปกติ ทั้งสองทางเข้าหน้าเมมเบอร์เดียวกัน
    </p>
  </ContentBox>

  <ContentBox as="h2" title="ฝากขั้นต่ำ 1 บาท ของ VING999 มีไว้ทำอะไร">
    <p class="mb-4 text-left text-base leading-relaxed text-[#dce3e8]">
      ยอดฝากขั้นต่ำระดับ 1 บาท ทำให้คนที่เพิ่งเปิดยูสลองดูระบบและหน้าเกมก่อนได้ ไม่ต้องใส่ทุนก้อนใหญ่ตั้งแต่ครั้งแรกเพื่อดูว่าเว็บใช้งานยังไง
    </p>

    <p class="text-left text-base leading-relaxed text-[#dce3e8]">เงินหนึ่งบาทไม่ได้พาไปไกล แต่พอจะบอกได้ว่าเว็บนี้เข้ามือเราหรือเปล่า</p>
  </ContentBox>

  <ContentBox as="h2" title="สมัครสมาชิก VING999 แล้วเข้าเล่นผ่านมือถือ">
    <p class="mb-4 text-left text-base leading-relaxed text-[#dce3e8]">
      การสมัครทำผ่านมือถือได้ตั้งแต่ต้นจนจบ กรอกข้อมูล เปิดบัญชี แล้วยืนยันตามขั้นตอนของระบบ จากนั้นใช้ยูสเดิมล็อกอินเข้าหน้าเมมเบอร์ได้เลย
    </p>

    <p class="mb-4 text-left text-base leading-relaxed text-[#dce3e8]">
      เปิดเกม เช็กเครดิต ดูโปรที่เปิดอยู่ และทำรายการฝากถอน อยู่ในเครื่องเดียวกันทั้งหมด ไม่ต้องกลับไปเปิดคอมเพื่อทำอะไรสักอย่างที่ค้างไว้
    </p>

    <p class="text-left text-base leading-relaxed text-[#dce3e8]">จำทางเข้าหลักที่ใช้ประจำไว้ จะได้ไม่ต้องเดาจากชื่อเว็บที่คล้ายกันบนหน้าผลค้นหา</p>
  </ContentBox>

  <ContentBox as="h2" title="VING999 เหมาะกับนักเล่นสล็อตแบบไหน">
    <p class="mb-4 text-left text-base leading-relaxed text-[#dce3e8]">
      เหมาะกับคนที่เล่นสล็อตเป็นหลัก เปลี่ยนเกมบ่อย และอยากให้เกมหลายค่าย เครดิต โปรโมชั่น กับระบบฝากถอนอยู่ในบัญชีเดียว โดยเฉพาะสายที่เข้าเล่นผ่านมือถือ
    </p>

    <p class="mb-4 text-left text-base leading-relaxed text-[#dce3e8]">
      โปรโมชั่นเปลี่ยนตามช่วงเวลา สิทธิ์ที่เปิดอยู่จึงดูได้จากหน้าโปร แล้วค่อยเลือกอันที่เข้ากับทุนและแนวเล่นของตัวเอง
    </p>

    <p class="text-left text-base leading-relaxed text-[#dce3e8]">เปลี่ยนสล็อตได้บ่อยเท่าที่อยาก แต่ของสำคัญอย่างเครดิตควรอยู่เป็นที่</p>
  </ContentBox>

  <Navfoot />
</MainLayout>
