        <div class="mt-4 text-center text-[10px] tracking-wide text-gray-500">ทุกค่ายเชื่อมตรงเซิร์ฟเวอร์แม่ ไม่ผ่านระบบปรับแต้ม</div>
      </div>
    </div>
  </ContentBoxTwo>

  <LatestWinners />

  <ContentBoxThreeColums titleleft="RTP คงเดิม ไม่ปรับลด" titlecenter="RNG แท้ ไม่ผ่านแอดมิน" titleright="จ่ายตรง ไม่ใช้บัญชีม้า">
