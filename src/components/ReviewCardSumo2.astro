---
const reviews = [
  {
    name: "สมาชิกที่ไล่ดูสล็อตหลายค่าย",
    role: "เริ่มจากเกมที่เข้าใจกติกาก่อนขยับยอดต่อรอบ",
    stars: 5,
    tag: "สล็อตกว่า 40 ค่าย",
    content:
      "ค่ายเยอะกับเกมหลายพันรายการช่วยเรื่องตัวเลือกจริง แต่แต่ละเกมต่างกันทั้งเดิมพันขั้นต่ำ ความผันผวน ฟรีสปิน และตัวคูณ วิธีที่ใช้แล้วไม่หลง คือเริ่มจากเกมที่เข้าใจกติกาและกำหนดยอดต่อรอบได้ก่อน แล้วค่อยไล่ดูค่ายอื่นทีละราย เกมดังช่วยให้หาข้อมูลง่ายขึ้นก็จริง แต่ยังไม่มีสิทธิ์พิเศษไปขอให้ระบบสุ่มเห็นใจผู้เล่น",
    avatar: "🎰",
  },
  {
    name: "สมาชิกที่เล่นทั้งหวยและกีฬา",
    role: "อ่านรายการซ้ำหนึ่งรอบก่อนกดยืนยันทุกครั้ง",
    stars: 5,
    tag: "หวยและกีฬา",
    content:
      "สองหมวดนี้ใช้ข้อมูลคนละชุด ฝั่งหวยต้องดูประเภทเลข งวด และเวลาปิดรับ ส่วนฝั่งกีฬาต้องดูคู่แข่งขัน ตลาดเดิมพัน ราคา และเวลาเริ่มแข่ง ที่ทำแล้วช่วยได้มากคืออ่านชื่อทีม เลขที่เลือก และวันที่แข่งขันซ้ำอีกหนึ่งรอบก่อนยืนยัน เพราะเลือกหมวดถูกแต่เลือกรายการผิด ระบบก็ไม่ได้ย้อนกลับมาถามว่าเมื่อกี้มือไวไปหรือเปล่า",
    avatar: "🎟️",
  },
  {
    name: "สมาชิกที่ใช้ระบบออโต้เป็นหลัก",
    role: "เก็บเลขอ้างอิงและสลิปถอนไว้ทุกรายการ",
    stars: 4,
    tag: "ฝากถอนออโต้และคืนยอดเสีย 8%",
    content:
      "ตัวเลขฝากถอน 1 วินาทีใช้สื่อความเร็วของระบบ แต่เวลาจริงยังขึ้นกับชื่อบัญชี ช่องทางธนาคาร และสถานะระบบในแต่ละช่วง ถ้าเครดิตยังไม่เข้าให้เปิดประวัติรายการก่อนกดซ้ำ ส่วนคืนยอดเสีย 8% ต้องดูว่าคิดจากยอดเสียสุทธิหรือยอดเดิมพันรวม ยอดเสียสุทธิ 1,000 บาท คิดที่ 8% ได้ 80 บาท แต่ยอดจริงอาจเปลี่ยนตามข้อยกเว้นของโปร",
    avatar: "🔁",
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label="เสียงจากสมาชิก YOK789" class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#5cff9b] via-[#12b84f] to-[#0a6b2f] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      เสียงจากสมาชิก <span class="text-[#ffd94a]">YOK789</span>
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#12b84f] to-transparent"></div>
  </div>

  <div class="mx-auto mb-8 flex max-w-md items-center justify-center gap-5 rounded-2xl border border-[#12b84f]/25 bg-[#08150d]/92 px-6 py-4 shadow-[0_10px_30px_rgba(18,184,79,0.18)] backdrop-blur-xl">
    <div class="flex flex-col items-center">
      <span class="bg-gradient-to-b from-[#5cff9b] to-[#0a6b2f] bg-clip-text text-4xl leading-none font-black text-transparent">{average}</span>
      <span class="mt-1 text-[10px] font-bold tracking-widest text-[#9dbfa8] uppercase">คะแนนเฉลี่ย</span>
    </div>
    <div class="h-12 w-px bg-[#153b26]"></div>
    <div class="flex flex-col gap-1.5">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#ffd94a]" : "text-[#153b26]"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#9dbfa8]">คะแนนเฉลี่ย {average} จาก 5 ดาว จากการใช้งานจริงของสมาชิก {reviews.length} ด้าน</span>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
    {
      reviews.map((review) => (
        <article class="group relative isolate flex flex-col gap-4 overflow-hidden rounded-2xl border border-[#12b84f]/25 bg-[#08150d]/92 p-6 text-left shadow-[0_10px_30px_rgba(18,184,79,0.18)] backdrop-blur-xl transition-all duration-300 hover:-translate-y-1 hover:border-[#12b84f]/50 hover:shadow-[0_15px_40px_rgba(18,184,79,0.3)]">
          <span class="absolute inset-y-0 left-0 -z-10 w-1 bg-gradient-to-b from-[#5cff9b] to-[#0a6b2f] opacity-80 transition-opacity duration-300 group-hover:opacity-100" />
          <span class="pointer-events-none absolute -top-14 -right-14 -z-10 h-32 w-32 rounded-full bg-[#0a6b2f]/45 blur-[50px] transition-all duration-300 group-hover:bg-[#12b84f]/45" />

          <div class="flex items-center justify-between gap-3">
            <span class="inline-flex items-center gap-1.5 rounded-full border border-[#12b84f]/25 bg-[#050d07] px-3 py-1 text-[10px] font-bold tracking-widest text-[#12b84f] uppercase">
              <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#ffd94a]" />
              {review.tag}
            </span>
            <span class="flex gap-0.5 text-sm">
              <span aria-hidden="true" class="flex gap-0.5">
                {Array.from({ length: 5 }).map((_, i) => (
                  <span class={i < review.stars ? "text-[#ffd94a]" : "text-[#153b26]"}>★</span>
                ))}
              </span>
              <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
            </span>
          </div>

          <p class="text-left text-base leading-relaxed text-[#d5f0dd]">{review.content}</p>

          <div class="mt-auto flex items-center gap-3 border-t border-[#153b26] pt-4">
            <span aria-hidden="true" class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#12b84f]/30 bg-gradient-to-br from-[#5cff9b] via-[#12b84f] to-[#0a6b2f] text-xl shadow-inner transition-transform duration-300 group-hover:scale-110">
              {review.avatar}
            </span>
            <span class="flex flex-col">
              <span class="text-sm font-black text-[#d5f0dd] transition-colors group-hover:text-[#5cff9b]">{review.name}</span>
              <span class="text-[10px] font-bold tracking-wider text-[#9dbfa8] uppercase">{review.role}</span>
            </span>
          </div>
        </article>
      ))
    }
  </div>
</section>
