---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";

import { Picture } from "astro:assets";

import pro1 from "../assets/slide1.png";
import pro2 from "../assets/slide2.png";
import pro3 from "../assets/slide3.png";
import { pageGraph } from "../lib/schema";

const pageTitle = "โปรโมชั่น MEEHAY569 สมาชิกใหม่ ฝาก 100 รับ 300 คืนยอดเสีย 0.2% ทุกวัน";

const pageHeading = "โปรโมชั่น MEEHAY569 สมาชิกใหม่ ฝาก 100 รับ 300 พร้อมคืนยอดเสียทุกวัน";

const pageDescription =
  "โปรโมชั่น MEEHAY569 สมาชิกใหม่ฝาก 100 รับ 300 ฝากครบ 500 รับเครดิตฟรี 50 คืนยอดเสีย 0.2% ทุกวันสูงสุด 5,000 บาท ฝากถอนทรูวอเลทออโต้ เริ่ม 1 บาท ตลอด 24 ชั่วโมง";

const announcementMessage =
  "MEEHAY569 สล็อตเว็บตรง ไม่ผ่านเอเย่นต์ • ฝากถอนทรูวอเลทออโต้ เริ่ม 1 บาท ตลอด 24 ชั่วโมง ไม่ต้องส่งสลิป • ทดลองเล่นสล็อตได้โดยไม่ต้องฝากเงินหรือสมัครก่อน • สมัครง่าย 4 ขั้นตอน เล่นได้ทั้งเว็บมือถือ แอป และคอม";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: pro1.src,
});

const promos = [
  {
    src: pro1,
    alt: "MEEHAY569 ฝากครบ 500 รับเครดิตฟรี 50 โปรลุ้นสนุก ใช้ได้จริง สมัครวันนี้คุ้มกว่า สำหรับสมาชิกที่ร่วมกิจกรรม ปุ่มรับสิทธิ์เลย",
  },
  {
    src: pro2,
    alt: "MEEHAY569 คืนยอดเสีย 0.2% ทุกวัน เล่นต่อได้แบบสบายใจ คืนไวทุกวัน สูงสุด 5,000 บาทต่อวัน ปุ่มรับโปรเลย",
  },
  {
    src: pro3,
    alt: "MEEHAY569 สมาชิกใหม่ ฝาก 100 รับ 300 สมัครง่าย รับไว โปรเริ่มต้นสุดคุ้ม ทำยอดตามเงื่อนไขก่อนถอน ปุ่มสมัครเลย",
  },
];

const promoClass =
  "mx-auto h-auto w-full rounded-xl border border-[#cfe9f4] object-contain shadow-[0_10px_30px_rgba(12,53,80,0.08)] transition-all duration-300 hover:-translate-y-1 hover:border-[#8ed3ee] hover:shadow-[0_15px_40px_rgba(0,164,212,0.18)]";
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement message={announcementMessage} />

  <ContentBox title={pageHeading} as="h1">
    <p class="mb-4 text-left text-base leading-relaxed">
      หากคุณกำลังมองหาโปรที่เริ่มได้จากงบเล็ก <strong class="font-bold text-[#a35000]">MEEHAY569</strong> พร้อมมอบโบนัสสมาชิกใหม่ เครดิตฟรีเมื่อฝากครบยอด และคืนยอดเสียทุกวัน คู่กับระบบฝากถอนทรูวอเลทออโต้ เพื่อให้คุณเล่นต่อได้อย่างสบายใจ
    </p>

    <p class="mb-8 text-left text-base leading-relaxed">
      แต่ละโปรมีเงื่อนไขของตัวเอง บางรายการต้องทำยอดตามเงื่อนไขก่อนถอน ซึ่งระบุไว้บนภาพแล้ว ไม่แน่ใจตรงไหนทักทีมงานผ่านช่องทางบนหน้าเว็บได้ก่อนรับสิทธิ์
    </p>

    <div class="grid w-full grid-cols-1 gap-6 sm:grid-cols-2">
      {
        promos.map((promo) => (
          <Picture
            src={promo.src}
            alt={promo.alt}
            loading="lazy"
            fetchpriority="low"
            widths={[400, 600]}
            sizes="(min-width: 1400px) 632px, (min-width: 640px) 46vw, 92vw"
            class={promoClass}
            decoding="async"
            formats={["avif", "webp"]}
            fallbackFormat="webp"
            quality={70}
          />
        ))
      }
    </div>

    <div class="mt-12 flex justify-center pb-4">
      <a
        href="/register/"
        class="flex items-center justify-center rounded-xl border-2 border-white bg-gradient-to-b from-[#ffd23f] via-[#ffb84d] to-[#f7941d] px-10 py-3.5 text-lg font-black text-[#4a1d00] shadow-[0_10px_30px_rgba(247,148,29,0.40)] transition-all hover:scale-105 hover:brightness-105 hover:shadow-[0_15px_40px_rgba(247,148,29,0.40)]">
        สมัครสมาชิก MEEHAY569
      </a>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
