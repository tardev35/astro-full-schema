---
const providers = [
  { name: "PG", desc: "ค่ายที่ปรากฏบนหน้าเว็บต้นแบบ เกมส่วนใหญ่ออกแบบให้เปิดผ่านมือถือได้ทันที", tag: "เล่นบนมือถือ", icon: "🎰" },
  { name: "JILI", desc: "รวมเกมรอบสั้นและเกมฟีเจอร์ ต่างกันที่จังหวะการจ่ายและตัวคูณ", tag: "รอบสั้น", icon: "🎲" },
  { name: "JOKER", desc: "มีทั้งเกมคลาสสิกและเกมที่ทำภาพใหม่ เลือกตามรูปแบบการเล่นที่ถนัด", tag: "คลาสสิกและใหม่", icon: "🃏" },
  { name: "SLOTXO", desc: "หมวดเกมแบ่งชัด ไล่ดูตามค่ายหรือเกมยอดนิยมได้โดยไม่ต้องเลื่อนยาว", tag: "หาเกมง่าย", icon: "💎" },
  { name: "HABANERO", desc: "เน้นเกมฟีเจอร์โบนัส ควรอ่านกติกาฟรีสปินหน้าเกมก่อนเริ่มหมุน", tag: "ฟีเจอร์แน่น", icon: "🔥" },
  { name: "เกมคลาสสิก", desc: "รูปแบบเข้าใจง่าย เหมาะกับการเริ่มจากงบเบา ๆ ก่อนขยับไปเกมฟีเจอร์", tag: "เริ่มต้นง่าย", icon: "🍒" },
  { name: "เกมใหม่สำหรับมือถือ", desc: "หมวดเกมใหม่ที่ออกแบบให้กดง่ายด้วยมือเดียวตั้งแต่หน้าแรก", tag: "อัปเดตต่อเนื่อง", icon: "📱" },
];
---

<section aria-label="ค่ายเกมและหมวดสล็อตที่ OKG777 ให้บริการ" class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#ffe94d] via-[#ffd400] to-[#ff4fd8] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      ค่ายเกมและหมวดสล็อตที่ <span class="text-[#ff4fd8]">OKG777</span> รวมไว้ในบัญชีเดียว
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#ffd400] to-transparent"></div>
  </div>

  <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4 lg:gap-5 xl:grid-cols-7">
    {
      providers.map((provider) => (
        <a
          href="/register"
          class="group relative flex flex-col items-center justify-center overflow-hidden rounded-2xl border border-[#ffd400]/25 bg-[#170733]/92 p-5 shadow-[0_10px_30px_rgba(255,212,0,0.18)] backdrop-blur-md transition-all duration-300 hover:-translate-y-2 hover:border-[#ffd400]/50 hover:bg-[#231045]/95 hover:shadow-[0_15px_40px_rgba(255,212,0,0.3)]">
          <div class="pointer-events-none absolute inset-0 bg-[#ff4fd8]/10 opacity-0 transition-opacity duration-300 group-hover:opacity-100" />

          <div class="absolute top-2 right-2 z-10 rounded-full bg-gradient-to-r from-[#ffe94d] via-[#ffd400] to-[#b8860a] px-2 py-0.5 text-[9px] font-black tracking-wide whitespace-nowrap text-[#1a0330] shadow-sm transition-transform duration-300 group-hover:scale-110">
            {provider.tag}
          </div>

          <div aria-hidden="true" class="mb-3 text-4xl transition-transform duration-300 group-hover:scale-125 group-hover:rotate-3">
            {provider.icon}
          </div>
          <p class="text-center text-sm font-black text-[#ece2fb] transition-colors group-hover:text-[#ffe94d]">{provider.name}</p>
          <p class="mt-1 text-center text-[10px] text-[#b9a8d8]">{provider.desc}</p>

          <span class="relative z-10 mt-4 block w-full rounded-full border border-[#ffd400]/25 bg-[#0d0320] py-1.5 text-center text-[11px] font-bold text-[#ffd400] shadow-inner transition-colors duration-300 group-hover:border-[#ffd400]/50 group-hover:bg-gradient-to-r group-hover:from-[#ffe94d] group-hover:via-[#ffd400] group-hover:to-[#b8860a] group-hover:text-[#1a0330]">
            เข้าดูเกม
          </span>
        </a>
      ))
    }
  </div>
</section>
