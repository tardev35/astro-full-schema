---
import { Picture } from "astro:assets";
import BankStrip from "./BankStrip.astro";
import { BRAND_ADDRESS } from "../lib/brandProfile";

const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.*", { eager: true });
const imagePaths = Object.keys(images);
const targetPath = imagePaths.find((path) => path.endsWith(".webp")) || imagePaths.find((path) => path.endsWith(".png")) || (imagePaths.length > 0 ? imagePaths[0] : null);
const mainLogo = targetPath ? images[targetPath].default : null;

const shortcuts = [
  { name: "หน้าแรก", path: "/" },
  { name: "โปรโมชั่น", path: "/promotion" },
  { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  { name: "ทางเข้า", path: "/ทางเข้า" },
  { name: "เกี่ยวกับเรา", path: "/about-us" },
  { name: "สมัครสมาชิก", path: "/register" },
];
---

<footer
  class="relative mt-12 w-full overflow-hidden rounded-t-[3rem] border-t-2 border-[#e0aa2e] bg-[#0a0704] pt-16 pb-8 font-sans text-[#efe0c4] shadow-[0_-10px_30px_rgba(224,170,46,0.20)]">
  <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 -top-20 mx-auto h-[200px] w-full max-w-4xl rounded-full bg-[#e0aa2e]/12 blur-[80px]"></div>

  <div class="relative z-10 mx-auto w-full max-w-[1400px] px-6">
    <div class="mb-12 grid grid-cols-1 gap-12 md:grid-cols-12">
      <div class="flex flex-col gap-4 md:col-span-5">
        <a href="/" class="inline-block max-w-max rounded-xl border border-[#e0aa2e]/35 bg-[#160f07] px-4 py-2 transition-transform duration-300 hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt="โลโก้ NORWAY89 ตราวงกลมสีทองสลักภาพเมืองและสะพาน มีวงเวียนเขียนแบบอยู่ด้านบนและล่าง ตรงกลางเป็นตัวอักษร NORWAY เหนือเลข 89"
                widths={[100, 200, 300]}
                sizes="100px"
                class="h-[50px] w-auto object-contain"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <span class="text-3xl font-black tracking-widest text-[#f5d488]">
                NORWAY<span class="text-[#e0aa2e]">89</span>
              </span>
            )
          }
        </a>
        <p class="mt-2 border-l-2 border-[#e0aa2e] pl-4 text-sm leading-relaxed text-[#d8cdb6]">
          NORWAY89 รวมบาคาร่า สล็อต บอล และหวยไว้ในบัญชีเดียว พร้อมระบบฝากถอนออโต้ และหน้าสมาชิกที่รวมเครดิต โปรโมชั่น และประวัติรายการไว้ครบ ใช้งานได้ทั้งบนมือถือและคอมพิวเตอร์
        </p>
        <div class="mt-2 flex gap-3">
          <span class="rounded-sm border border-[#e0aa2e]/35 bg-[#6b4310]/40 px-3 py-1 text-[10px] font-bold text-[#f5d488]">HTTPS / SSL</span>
          <span class="rounded-sm border border-[#d8cdb6]/30 bg-[#d8cdb6]/10 px-3 py-1 text-[10px] font-bold text-[#d8cdb6]">AUTO 24 HR</span>
        </div>
      </div>

      <nav class="flex flex-col gap-4 md:col-span-3 lg:pl-12">
        <p class="border-b border-[#e0aa2e]/30 pb-2 text-base font-black tracking-widest text-[#f5d488] uppercase">ทางลัด</p>
        <ul class="flex flex-col gap-3 text-sm font-medium text-[#d8cdb6]">
          {
            shortcuts.map((item) => (
              <li>
                <a href={item.path} class="flex items-center gap-2 transition-colors hover:text-[#f5d488]">
                  <span aria-hidden="true" class="text-[#e0aa2e]">
                    ▸
                  </span>{" "}
                  {item.name}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="flex flex-col gap-4 md:col-span-4">
        <p class="border-b border-[#e0aa2e]/30 pb-2 text-base font-black tracking-widest text-[#f5d488] uppercase">บริการลูกค้า 24 ชม.</p>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-md bg-gradient-to-r from-green-600 to-green-500 py-3 text-sm font-black text-white shadow-md transition-all hover:scale-[1.02]">
          <span aria-hidden="true">💬</span> ติดต่อแอดมิน (LINE)
        </a>

        {
          BRAND_ADDRESS.lines.length > 0 && (
            <address aria-label={BRAND_ADDRESS.label} class="mt-2 rounded-xl border border-white/15 bg-black/20 p-4 text-xs leading-relaxed not-italic opacity-90">
              <p class="mb-2 flex items-center gap-2 text-[11px] font-bold tracking-wider uppercase opacity-80">
                <span aria-hidden="true" class="text-sm">
                  📍
                </span>
                {BRAND_ADDRESS.label}
              </p>
              {BRAND_ADDRESS.lines.map((line) => (
                <span class="block">{line}</span>
              ))}
              {BRAND_ADDRESS.email && (
                <a href={`mailto:${BRAND_ADDRESS.email}`} class="mt-3 inline-flex items-center gap-2 font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                  <span aria-hidden="true" class="text-sm">
                    ✉️
                  </span>
                  {BRAND_ADDRESS.email}
                </a>
              )}
            </address>
          )
        }

        <div class="mt-2 text-xs font-bold text-[#a2957c]">รองรับทุกธนาคารและทรูมันนี่วอเลท:</div>
        <BankStrip size={32} />
      </div>
    </div>

    <div class="flex flex-col items-center justify-between border-t border-[#e0aa2e]/15 pt-6 text-xs font-medium text-[#a2957c] md:flex-row">
      <p>COPYRIGHT &copy; {new Date().getFullYear()} NORWAY89-BRAND.COM. ALL RIGHTS RESERVED.</p>
      <div class="mt-3 flex gap-4 md:mt-0">
        <a href="/terms/" class="transition-colors hover:text-[#f5d488]">เงื่อนไขข้อตกลง</a>
        <a href="/privacy/" class="transition-colors hover:text-[#f5d488]">นโยบายความเป็นส่วนตัว</a>
        <a href="#top" class="transition-colors hover:text-[#f5d488]">กลับขึ้นบน</a>
      </div>
    </div>
  </div>
</footer>
