---
import { Picture } from "astro:assets";
import BankStrip from "./BankStrip.astro";
import { BRAND_ADDRESS, BRAND_NAME } from "../lib/brandProfile";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });

const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

const quickLinks = [
  { name: "หน้าแรก", path: "/" },
  { name: "โปรโมชั่น", path: "/promotion/" },
  { name: "ทดลองเล่น", path: "/ทดลองเล่น/" },
  { name: "วิธีฝากถอน", path: "/วิธีฝากถอน/" },
  { name: "ทางเข้า", path: "/ทางเข้า/" },
  { name: "เกี่ยวกับเรา", path: "/about-us/" },
  { name: "สมัครสมาชิก", path: "/register/" },
  { name: "เข้าสู่ระบบ", path: "/login/" },
  { name: "ติดต่อเรา", path: "/contact-us/" },
];

const logoAlt = "โลโก้ VODKAFUN ขวดวอดก้าสีเขียวเข้มฝาเงินบนสาดสีเขียวมะนาวเรืองแสง ใต้ขวดเป็นคำว่า VODKA ตัวอักษรโครเมียมสีขาว และ FUN ตัวอักษรสีเขียวมะนาว";
---

<footer class="relative mt-32 w-full border-t border-[#c8fc04]/45 bg-[#020f03] pt-64 pb-6 font-sans text-[#d9f7d0] shadow-[0_-10px_30px_rgba(200,252,4,0.18)] md:pt-40">
  <div
    class="absolute -top-14 left-1/2 z-20 flex w-[92%] max-w-5xl -translate-x-1/2 flex-col items-center justify-between rounded-2xl border border-[#c8fc04]/50 bg-gradient-to-r from-[#06230a] via-[#0f4a14] to-[#06230a] p-6 shadow-[0_15px_40px_rgba(200,252,4,0.22)] md:-top-16 md:flex-row md:p-8">
    <div class="mb-5 flex flex-col text-center md:mb-0 md:text-left">
      <p class="text-xl font-black tracking-wide text-[#f3ffe9] uppercase italic drop-shadow-[0_2px_4px_rgba(2,15,3,0.6)] md:text-3xl">
        <span aria-hidden="true">🍾</span> เปิดยูส {BRAND_NAME} วันนี้ เล่นสล็อตเวอร์ชั่นใหม่ได้ทันที
      </p>
      <p class="mt-2 text-sm font-medium text-[#d9f7d0]/90 md:text-base">
        ยูสเดียวเลือกได้ทั้งสล็อต ยิงปลา กีฬา คาสิโน และหวย ฝากถอนระบบออโต้ รองรับทรูมันนี่วอเล็ต ใช้งานได้ทั้งมือถือ แท็บเล็ต และคอมพิวเตอร์
      </p>
    </div>

    <a
      href="/register/"
      class="group relative flex items-center justify-center overflow-hidden rounded-full border border-[#e6ff6a] bg-gradient-to-b from-[#e6ff6a] to-[#c8fc04] px-8 py-3.5 text-sm font-extrabold whitespace-nowrap text-[#0b2a05] shadow-[0_0_15px_rgba(200,252,4,0.5)] transition-all hover:scale-105 md:text-base">
      <span class="relative z-10">สมัครสมาชิกเลย <span aria-hidden="true">🚀</span></span>
      <div aria-hidden="true" class="absolute inset-0 translate-y-full bg-[#7ee000] transition-transform duration-300 group-hover:translate-y-0"></div>
    </a>
  </div>

  <div class="relative z-10 mx-auto max-w-[1200px] px-6">
    <div class="mb-10 grid grid-cols-1 gap-10 md:grid-cols-12 lg:gap-12">
      <div class="flex flex-col gap-6 md:col-span-12 lg:col-span-4">
        <a href="/" class="inline-block origin-left transition-transform hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt={logoAlt}
                widths={[100, 200, 300]}
                sizes="100px"
                loading="lazy"
                decoding="async"
                class="h-[60px] w-auto drop-shadow-[0_0_12px_rgba(200,252,4,0.5)]"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <p class="bg-gradient-to-b from-[#e6ff6a] to-[#3fc20a] bg-clip-text text-3xl font-black text-transparent drop-shadow-[0_0_8px_rgba(200,252,4,0.5)]">{BRAND_NAME}</p>
            )
          }
        </a>
        <p class="text-sm leading-relaxed text-[#d9f7d0]/85">
          {BRAND_NAME} สล็อตเวอร์ชั่นใหม่ รวมเกมครบครันไว้ในบัญชีเดียว ทั้งสล็อต ยิงปลา กีฬา คาสิโน และหวย ทำรายการฝากถอนผ่านระบบออโต้ รองรับทรูมันนี่วอเล็ตตามช่องทางที่เปิดให้บริการ
          ตรวจสอบสถานะรายการและประวัติธุรกรรมได้จากระบบสมาชิก
        </p>

        <div class="mt-2 flex flex-wrap gap-3">
          <a
            href="/line/"
            class="flex items-center gap-2 rounded-full border border-[#00B900]/40 bg-[#00B900]/15 px-4 py-2 text-xs font-bold text-[#8fe6a8] shadow-[0_0_10px_rgba(0,185,0,0.15)] transition-colors hover:bg-[#00B900] hover:text-white">
            <span aria-hidden="true" class="text-base">💬</span> LINE OFFICIAL
          </a>
        </div>

        {
          BRAND_ADDRESS.lines.length > 0 && (
            <address aria-label={BRAND_ADDRESS.label} class="mt-2 rounded-xl border border-white/15 bg-black/20 p-4 text-xs leading-relaxed not-italic opacity-90">
              <p class="mb-2 flex items-center gap-2 text-[11px] font-bold tracking-wider uppercase opacity-80">
                <span aria-hidden="true" class="text-sm">📍</span>
                {BRAND_ADDRESS.label}
              </p>
              {BRAND_ADDRESS.lines.map((line) => (
                <span class="block">{line}</span>
              ))}
              {BRAND_ADDRESS.email && (
                <a href={`mailto:${BRAND_ADDRESS.email}`} class="mt-3 inline-flex items-center gap-2 font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                  <span aria-hidden="true" class="text-sm">✉️</span>
                  {BRAND_ADDRESS.email}
                </a>
              )}
            </address>
          )
        }
      </div>

      <div class="md:col-span-6 lg:col-span-5">
        <p class="relative mb-5 inline-block text-lg font-bold tracking-wider text-[#f3ffe9] uppercase">
          ลิงก์ด่วน (Quick Links)
          <span aria-hidden="true" class="absolute -bottom-2 left-0 h-1 w-1/2 rounded-full bg-gradient-to-r from-[#e6ff6a] to-[#3fc20a] shadow-[0_0_8px_rgba(200,252,4,0.6)]"></span>
        </p>

        <div class="grid grid-cols-2 gap-x-4 gap-y-3 text-sm">
          {
            quickLinks.map((link) => (
              <a href={link.path} class="group flex items-center text-[#d9f7d0]/85 transition-colors hover:text-[#f3ffe9]">
                <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#c8fc04] transition-transform group-hover:rotate-45" />
                {link.name}
              </a>
            ))
          }
        </div>
      </div>

      <div class="md:col-span-6 lg:col-span-3">
        <p class="relative mb-5 inline-block text-lg font-bold tracking-wider text-[#f3ffe9] uppercase">
          ระบบการเงิน
          <span aria-hidden="true" class="absolute -bottom-2 left-0 h-1 w-1/2 rounded-full bg-gradient-to-r from-[#e6ff6a] to-[#3fc20a] shadow-[0_0_8px_rgba(200,252,4,0.6)]"></span>
        </p>

        <p class="mb-4 text-xs text-[#d9f7d0]/85">รองรับการฝากถอนผ่านแอปธนาคารชั้นนำและทรูมันนี่วอเล็ต ตรวจสอบข้อมูลบัญชี จำนวนเงิน และเงื่อนไขให้ถูกต้องก่อนยืนยันทุกครั้ง</p>

        <BankStrip size={30} />

        <div class="mt-3 flex h-10 items-center justify-center rounded border border-white/12 bg-[#06230a] transition-colors hover:border-[#c8fc04]/70" title="ตรวจรายการย้อนหลัง">
          <span class="flex items-center gap-1 text-xs font-bold text-[#d9f7d0]"><span aria-hidden="true" class="text-lg text-[#e6ff6a]">🧾</span> ตรวจประวัติธุรกรรมได้จากระบบสมาชิก</span>
        </div>
      </div>
    </div>

    <hr class="mb-6 border-white/15" />

    <div class="mb-6 hidden text-justify text-[10px] leading-relaxed text-[#d9f7d0]/65 md:block">
      {BRAND_NAME} รวมความบันเทิงจากเกมสล็อตเวอร์ชั่นใหม่ล่าสุดไว้กับเกมเดิมพันหลายประเภท ทั้งสล็อต ยิงปลา กีฬา คาสิโน และหวย ให้สมาชิกเลือกเล่นได้ตามความชอบภายในเว็บไซต์เดียว
      การสมัครสมาชิก เข้าสู่ระบบ และทำรายการฝากถอนผ่านระบบออโต้ออกแบบมาให้ไม่ซับซ้อน พร้อมรองรับทรูมันนี่วอเล็ตตามช่องทางที่เปิดให้บริการ ก่อนเข้าสู่ระบบควรตรวจสอบชื่อเว็บไซต์และ URL
      ให้ตรงกับช่องทางที่แบรนด์ประกาศ และไม่เปิดเผยรหัสผ่านหรือรหัสยืนยันให้บุคคลอื่น
    </div>

    <div class="flex flex-col items-center justify-between gap-4 border-t border-white/15 pt-6 text-xs text-[#d9f7d0]/75 md:flex-row">
      <p>&copy; {new Date().getFullYear()} <span class="font-bold tracking-wider text-[#f3ffe9] uppercase">{BRAND_NAME}</span>. All Rights Reserved.</p>

      <div class="flex items-center gap-6">
        <a href="/terms/" class="transition-colors hover:text-[#f3ffe9]">เงื่อนไขและข้อตกลง</a>
        <a href="/privacy/" class="transition-colors hover:text-[#f3ffe9]">นโยบายความเป็นส่วนตัว</a>

        <a
          href="#top"
          class="flex h-8 w-8 items-center justify-center rounded border border-white/25 bg-white/10 text-[#f3ffe9] transition-all hover:border-[#c8fc04] hover:bg-[#06230a] hover:shadow-[0_0_15px_rgba(200,252,4,0.5)]"
          aria-label="กลับขึ้นด้านบนสุดของหน้า">
          <span aria-hidden="true">↑</span>
        </a>
      </div>
    </div>
  </div>
</footer>
