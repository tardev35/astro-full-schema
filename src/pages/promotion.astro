---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxPremium.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement.astro";

import { Picture } from "astro:assets";

import pro1 from "../assets/slide1.png";
import pro2 from "../assets/slide2.png";
import pro3 from "../assets/slide3.png";
import pro4 from "../assets/slide4.png";
import { pageGraph } from "../lib/schema";

const pageDescription =
  "รวมข้อเสนอของ YIMSIAM88 สล็อตเว็บตรงไทยแท้ โบนัสแรงแตกบ่อยตามระบบ RNG มาตรฐานโลก จ่ายเต็มไม่มีหัก ฝากถอนออโต้ไม่มีขั้นต่ำ เติมผ่านวอเล็ทก็ได้ ตลอด 24 ชม.";

const graph = pageGraph(Astro, {
  name: "โปรโมชั่น YIMSIAM88 โบนัสแรงแตกบ่อย จ่ายเต็มไม่มีหัก",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: pro1.src,
});
---

<MainLayout title="โปรโมชั่น - YIMSIAM88" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="โปรโมชั่น YIMSIAM88" as="h1">
    <h2 class="mb-4 text-2xl leading-normal font-bold text-[#f6c475]">โบนัสแรงแตกบ่อย เป็นธรรมชาติ แล้วจ่ายเต็มไม่มีหัก</h2>

    <p class="mb-5 text-left text-base leading-relaxed text-[#f7e6d4]">
      สิ่งที่ <strong class="text-[#ffd98a]">YIMSIAM88</strong> เอามาเสนอพี่น้องชาวไทย ไม่ใช่ตัวเลขบนแบนเนอร์ครับ แต่เป็นเกมที่แฟร์จริง ทุกเกมของเรารันด้วยระบบ RNG มาตรฐานโลก
      โบนัสจึงแตกแบบเป็นธรรมชาติที่สุด บทจะแตกก็แตกจนร้องขอชีวิต บทจะเข้าฟรีสปินก็ไหลยาวเป็นหางว่าว เราไม่กั๊กช่วงเวลา ไม่ปรับเปอร์เซ็นต์ให้เกลือเพื่อกินตังค์ท่าน
      จะปั่นหลักสิบหรือหวดหลักพัน สิทธิ์ลุ้นรางวัลใหญ่ก็เท่ากันหมด เล่นได้คือได้ เล่นเสียคือเสียตามจังหวะเกมล้วน ๆ นี่แหละครับรสชาติของการเดิมพันที่แท้จริง วัดกันที่ดวงกับฝีมือ
      ไม่ใช่วัดกันที่เว็บว่าจะปล่อยให้ใครแตกวันไหน
    </p>

    <p class="mb-8 text-left text-base leading-relaxed text-[#f7e6d4]">
      แล้วพอถึงตาท่านชนะ พี่สยามขอยืนยันด้วยเกียรติลูกผู้ชายว่าเรา <strong class="text-[#ffd98a]">จ่ายเต็มไม่มีหัก</strong> ครับ ถอนหลักร้อยก็โอนครบ แจ็คพอตแตกหลักล้านก็โอนครบทุกบาททุกสตางค์
      ไม่มีหักค่าธรรมเนียม ไม่มีค่าดำเนินการ ไม่มีบรรทัดเล็ก ๆ ใต้ตัวเลขที่รอกินส่วนต่างของท่าน เงินที่ท่านหามาด้วยน้ำพักน้ำแรงและความเก่ง ก็สมควรได้กลับไปเต็มกระเป๋าครับ
    </p>

    <h2 class="mt-10 mb-4 text-2xl leading-normal font-bold text-[#f6c475]">ฝากถอนออโต้ไวดั่งใจนึก ไม่มีขั้นต่ำ สมัครง่ายไม่เรื่องมาก</h2>

    <p class="mb-5 text-left text-base leading-relaxed text-[#f7e6d4]">
      สมัยนี้จะให้นั่งส่งสลิปแล้วรอแอดมินตอบแชตข้ามวันมันไม่ทันกินครับ ระบบออโต้ของเราจึงพัฒนามาให้ไวดั่งใจนึก กดฝากปุ๊บเครดิตเข้าปั๊บ กดถอนปุ๊บเงินเด้งเข้าบัญชีภายในไม่กี่วินาที
      เร็วกว่าต้มมาม่าสุกอีกครับ เรื่องขั้นต่ำยิ่งง่าย อยากฝาก 1 บาทก็เล่นได้ อยากถอนกี่บาทก็ถอนได้ ไม่มีเงื่อนไขมัดมือ ไม่บังคับทำกิจกรรมก่อนถอน
      และรองรับทุกช่องทางที่คนไทยใช้จริง รวมถึง True Money Wallet ด้วย จะสายประหยัด สายซื้อฟรีสปิน หรือสายขำ ๆ คั่นเวลา YIMSIAM88 ก็เปิดไฟเขียวให้หมดครับ
    </p>

    <p class="mb-8 text-left text-base leading-relaxed text-[#f7e6d4]">
      ส่วนตอนสมัคร เราขอข้อมูลเท่าที่จำเป็นเพื่อยืนยันตัวตนเท่านั้น ไม่ต้องส่งบัตรประชาชน ไม่ต้องถ่ายหน้า ระบบเข้ารหัสข้อมูลตามมาตรฐานเว็บใหญ่ กรอกไม่กี่ช่องก็เข้าเล่นได้เลย
      และถ้าติดขัดตรงไหน ทักไลน์มาได้ตลอดครับ ทีมงานซัพพอร์ตของเราเป็นคนไทยแท้ ๆ ตอบเอง ไม่ใช้บอทวนคำถาม แสตนด์บายให้ตลอด 24 ชั่วโมง ไม่มีวันหยุดราชการ
      เพราะความสบายใจของท่าน คือหน้าที่ของเราครับ
    </p>

    <div class="grid w-full grid-cols-1 gap-6 sm:grid-cols-2">
      <Picture
        src={pro1}
        alt="แบนเนอร์ YIMSIAM88 ตัวอักษรทองบนเปลวไฟ พร้อมข้อความ แชทได้24ชม ตอบไว ไม่ใช้บอท เหนือชื่อแบรนด์เป็นโลโก้หน้าบันทรงไทยสีทอง ด้านขวาเป็นพรีเซ็นเตอร์หญิงชุดราตรีดำแดงถือไพ่คลี่เป็นพัด รอบภาพมีเหรียญทอง ชิปคาสิโน และไพ่ปลิวบนพื้นหลังลาวา"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600, 800]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class="mx-auto h-auto w-full rounded-xl border border-[#f6c475]/25 object-contain shadow-[0_10px_30px_rgba(255,122,24,0.18)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#ff7a18]/50 hover:shadow-[0_15px_40px_rgba(255,122,24,0.30)]"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />

      <Picture
        src={pro2}
        alt="แบนเนอร์ YIMSIAM88 ตัวอักษรทอง พร้อมข้อความ แตก10ล้าน จ่ายเต็มไม่มีหัก ด้านบนเป็นโลโก้หน้าบันทรงไทยสีทอง ทางซ้ายเป็นพรีเซ็นเตอร์หญิงชุดราตรีแดงทองยืนชี้มาที่ข้อความ มุมล่างขวาเป็นไพ่โพดำเรียง 10 J Q K A สีดำขลิบทอง ล้อมด้วยเหรียญทองและชิปคาสิโนบนพื้นหลังเปลวเพลิง"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600, 800]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class="mx-auto h-auto w-full rounded-xl border border-[#f6c475]/25 object-contain shadow-[0_10px_30px_rgba(255,122,24,0.18)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#ff7a18]/50 hover:shadow-[0_15px_40px_rgba(255,122,24,0.30)]"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />

      <Picture
        src={pro3}
        alt="แบนเนอร์ YIMSIAM88 ตัวอักษรทอง พร้อมข้อความ เติมผ่านวอเล็ทก็ได้ ไม่มีขั้นต่ำ กลางภาพเป็นโลโก้หน้าบันทรงไทยสีทอง ด้านขวาเป็นพรีเซ็นเตอร์หญิงชุดกี่เพ้าสีแดงถือไพ่คลี่เป็นพัด ด้านล่างมีไพ่ 10 J Q K A ลูกเต๋า ชิปคาสิโน และเหรียญทองบนพื้นหลังลาวาและเปลวไฟ"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600, 800]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class="mx-auto h-auto w-full rounded-xl border border-[#f6c475]/25 object-contain shadow-[0_10px_30px_rgba(255,122,24,0.18)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#ff7a18]/50 hover:shadow-[0_15px_40px_rgba(255,122,24,0.30)]"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />

      <Picture
        src={pro4}
        alt="แบนเนอร์ YIMSIAM88 ตัวอักษรทอง พร้อมข้อความ โบนัสแรงแตกบ่อย ไม่ล็อคยูส ทางซ้ายเป็นพรีเซ็นเตอร์หญิงชุดราตรีแดงปักลายทองยืนเท้าสะเอว มุมขวาบนเป็นโลโก้หน้าบันทรงไทยสีทอง รอบภาพมีเหรียญทอง ชิปคาสิโน และไพ่ บนพื้นหลังธารลาวาและเปลวเพลิง"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600, 800]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class="mx-auto h-auto w-full rounded-xl border border-[#f6c475]/25 object-contain shadow-[0_10px_30px_rgba(255,122,24,0.18)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#ff7a18]/50 hover:shadow-[0_15px_40px_rgba(255,122,24,0.30)]"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />
    </div>

    <div class="mt-12 flex justify-center pb-4">
      <a
        href="/register"
        class="flex items-center justify-center rounded-lg border border-[#f6c475]/60 bg-gradient-to-r from-[#ffd98a] via-[#ff7a18] to-[#8d2b09] px-10 py-3.5 text-lg font-black text-[#160604] shadow-[0_10px_30px_rgba(255,122,24,0.18)] transition-transform hover:scale-105 hover:shadow-[0_15px_40px_rgba(255,122,24,0.30)]">
        สมัครสมาชิก YIMSIAM88
      </a>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
