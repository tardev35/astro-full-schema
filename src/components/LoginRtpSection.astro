---
import ContentBoxTwoPremium from "./ContentBoxTwoPremium.astro";

const steps = [
  { icon: "📝", name: "สมัครฟรี ใช้เวลาไม่เกิน 10 วินาที", detail: "กรอกข้อมูลน้อย ไม่ต้องฝากก่อน รับยูสแล้วเข้าดูเกมได้ทันที ตั้งรหัสผ่านที่ไม่ซ้ำกับบัญชีอื่นของตัวเอง", tag: "ขั้นที่ 1" },
  { icon: "🔑", name: "เข้าสู่ระบบด้วยยูสเดียว", detail: "ยูสนี้เชื่อมทั้งการเล่น ยอดเงิน และประวัติการทำรายการไว้ด้วยกัน จึงควรเก็บข้อมูล Login ไว้กับตัวเอง", tag: "ขั้นที่ 2" },
  { icon: "🎰", name: "เลือกค่ายจาก API แท้", detail: "PG SOFT, Pragmatic Play, JILI, Joker, CQ9, Relax Gaming, Hacksaw อยู่ในกระเป๋าเดียว เลือกแล้วลุยได้เลย ไม่ต้องโยกเงิน", tag: "ขั้นที่ 3" },
  { icon: "⚡", name: "ฝากถอนออโต้เฉลี่ย 1–3 วินาที", detail: "รองรับธนาคารไทยและ True Money Wallet ตลอด 24 ชั่วโมง ไม่มีขั้นต่ำ เริ่มได้ตั้งแต่ 1 บาท", tag: "ขั้นที่ 4" },
  { icon: "💰", name: "ถอนเต็มจำนวน ไม่อั้น ไม่จำกัดรอบ", detail: "ยอดใหญ่แค่ไหนก็กดถอนได้เต็มจำนวน ดูยอดคงเหลือและเงื่อนไขของสิทธิ์ที่ใช้อยู่ได้ก่อนกดยืนยัน", tag: "ขั้นที่ 5" },
];
const chips = ["สล็อตเว็บตรง", "API แท้", "RTP เต็มระบบ", "แตกบ่อย", "ซุปเปอร์เมกะ", "ฝากถอนออโต้", "ไม่มีขั้นต่ำ", "กระเป๋าเดียว", "สมัครฟรี", "ใช้ได้ทุกอุปกรณ์"];
---

<ContentBoxTwoPremium
  titleleft="เข้าสู่ระบบ SUPERCLUB168"
  titleright="ลำดับการใช้งานตั้งแต่สมัครถึงถอนยอด"
  label="เข้าสู่ระบบ SUPERCLUB168 และลำดับการใช้งานตั้งแต่สมัครถึงถอนยอด">
  <div slot="left" class="flex h-full flex-col gap-4">
    <div class="relative overflow-hidden rounded-2xl border border-[#0e2150] bg-[#071230] p-6 shadow-[0_10px_30px_rgba(247,208,70,0.18)]">
      <div aria-hidden="true" class="pointer-events-none absolute -top-10 -right-10 h-32 w-32 rounded-full bg-[#f7d046]/18 blur-[50px]"></div>

      <div class="relative z-10 mb-5 flex items-center gap-3">
        <span
          aria-hidden="true"
          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#8f6a08] bg-gradient-to-br from-[#ffeeb8] via-[#ffd95e] to-[#c99a17] text-xl shadow-inner">
          👑
        </span>
        <div class="flex flex-col">
          <p class="text-base font-black text-[#ffe38a]">ล็อกอินแล้วจัดการทุกขั้นตอนได้จากยูสของตัวเอง</p>
          <span class="text-[11px] text-[#cdb888]">
            ยูสเดียวใช้ได้ทั้งการเข้าเล่นทุกค่ายและการทำรายการฝากถอน ตรวจยอดคงเหลือ ดูสถานะรายการ และย้อนดูประวัติการทำรายการได้จากหน้าเมมเบอร์
          </span>
        </div>
      </div>

      <div class="relative z-10 flex flex-col gap-3.5">
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#f7d046]">👤</span>
          <input
            type="text"
            placeholder="เบอร์โทรศัพท์ / ยูสเซอร์เนม"
            class="w-full rounded-xl border border-[#0e2150] bg-[#03091f] py-3 pr-4 pl-12 text-[#f5e7c2] transition-all outline-none placeholder:text-[#cdb888] focus:border-[#f7d046] focus:ring-1 focus:ring-[#f7d046]/50"
          />
        </div>
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#f7d046]">🔑</span>
          <input
            type="password"
            placeholder="รหัส PIN 4 หลัก"
            class="w-full rounded-xl border border-[#0e2150] bg-[#03091f] py-3 pr-4 pl-12 text-[#f5e7c2] transition-all outline-none placeholder:text-[#cdb888] focus:border-[#f7d046] focus:ring-1 focus:ring-[#f7d046]/50"
          />
        </div>

        <div class="flex items-center justify-between px-1 text-xs">
          <label class="flex items-center gap-2 text-[#cdb888]">
            <input type="checkbox" class="h-3.5 w-3.5 rounded border-[#0e2150] bg-[#03091f] accent-[#f7d046]" />
            จดจำฉันไว้
          </label>
          <a href="/login" class="text-[#cdb888] transition-colors hover:text-[#ffe38a]">ลืมรหัส PIN?</a>
        </div>

        <button
          class="mt-1 w-full rounded-xl border border-[#8f6a08] bg-gradient-to-r from-[#ffeeb8] via-[#ffd95e] to-[#c99a17] p-3.5 font-black text-[#03091f] shadow-[0_10px_30px_rgba(247,208,70,0.34)] transition-all hover:scale-[1.02] hover:shadow-[0_15px_40px_rgba(247,208,70,0.44)]">
          เข้าสู่ระบบ
        </button>

        <div class="flex items-center gap-3 py-1 text-[11px] text-[#cdb888]">
          <span class="h-px flex-1 bg-[#0e2150]"></span>
          หรือ
          <span class="h-px flex-1 bg-[#0e2150]"></span>
        </div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] p-3 text-sm font-bold text-white shadow-md transition-all hover:scale-[1.02]">
          <span aria-hidden="true">💬</span> ทักไลน์ทีมงานตลอด 24 ชั่วโมง
        </a>

        <div class="mt-1 flex items-center justify-between px-1">
          <div class="flex gap-2">
            <span class="rounded-full border border-[#0e2150] bg-[#03091f] px-2.5 py-1 text-[10px] font-bold text-[#ffe38a]"><span aria-hidden="true">🔒</span> ดูแลข้อมูลสมาชิก</span>
            <span class="rounded-full border border-[#63120a] bg-[#03091f] px-2.5 py-1 text-[10px] font-bold text-[#ff9a7a]"><span aria-hidden="true">📱</span> ใช้ได้ทุกอุปกรณ์</span>
          </div>
          <a href="/register" class="text-xs font-bold text-[#cdb888] transition-colors hover:text-[#ffe38a]">สมัครสมาชิกใหม่</a>
        </div>
      </div>
    </div>
  </div>

  <div slot="right" class="h-full">
    <div class="flex h-full flex-col rounded-2xl border border-[#0e2150] bg-[#071230] p-5 shadow-[0_10px_30px_rgba(247,208,70,0.18)]">
      <div class="mb-5 flex items-center justify-between gap-3">
        <div>
          <span class="text-xs font-bold tracking-wide text-[#cdb888]">ลำดับการใช้งานที่ SUPERCLUB168 วางไว้ ตั้งแต่เปิดยูสจนถอนยอดออก อยู่ในระบบออโต้ชุดเดียวกันทั้งหมด</span>
          <div class="bg-gradient-to-r from-[#ffeeb8] via-[#ffd95e] to-[#ff9a7a] bg-clip-text text-2xl font-black text-transparent sm:text-3xl">สมัคร • ล็อกอิน • เล่น • ถอน</div>
        </div>
        <span class="flex items-center gap-1.5 self-start rounded-full border border-green-400/40 bg-[#03091f] px-2.5 py-1">
          <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-green-400 shadow-[0_0_8px_rgba(74,222,128,0.7)]"></span>
          <span class="text-[10px] font-bold tracking-widest text-green-400 uppercase">Live</span>
        </span>
      </div>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#cdb888] uppercase">
        <span>ขั้นตอนการใช้งาน</span>
        <span>ลำดับ</span>
      </div>

      <div class="flex flex-1 flex-col gap-2.5">
        {
          steps.map((s) => (
            <div class="rounded-xl border border-[#0e2150] bg-[#03091f] px-3.5 py-2.5 transition-colors hover:border-[#f7d046]/55 hover:bg-[#0e2150]">
              <div class="flex items-center justify-between gap-2 text-sm">
                <span class="flex min-w-0 items-center gap-2 font-bold text-[#f5e7c2]">
                  <span aria-hidden="true" class="w-5 shrink-0 text-center">
                    {s.icon}
                  </span>{" "}
                  <span class="truncate">{s.name}</span>
                </span>
                <span class="shrink-0 rounded-full border border-[#63120a] bg-[#071230] px-2.5 py-0.5 text-[10px] font-bold text-[#ff9a7a]">{s.tag}</span>
              </div>
              <div class="mt-1.5 text-[11px] tracking-wide text-[#cdb888]">{s.detail}</div>
            </div>
          ))
        }
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
        {chips.map((c) => <span class="rounded-full border border-[#0e2150] bg-[#03091f] px-3 py-1 text-[10px] font-bold text-[#ffe38a]">{c}</span>)}
      </div>

      <div class="mt-3 text-center text-[10px] tracking-wide text-[#cdb888]">
        ลำดับในตารางสรุปจากที่หน้าเว็บแสดงไว้ เงื่อนไขการทำรายการ วงเงินต่อรายการ และข้อกำหนดของสิทธิ์ที่กำลังใช้งานให้ยึดตามคู่มือและหน้าเมมเบอร์ของ SUPERCLUB168 ก่อนทำรายการทุกครั้ง
        และอย่าบอกรหัสผ่านหรือ OTP กับใคร หากติดขัดตรงไหนทักไลน์ทีมงานได้ตลอด 24 ชั่วโมง
      </div>
    </div>
  </div>
</ContentBoxTwoPremium>
