---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import { pageGraph } from "../lib/schema";

const pageTitle = "เกี่ยวกับเรา PAYDAY24 เว็บสล็อตมั่นคง เว็บตรงลิขสิทธิ์แท้ จ่ายจริง 100%";

const pageHeading = "เกี่ยวกับเรา PAYDAY24 เว็บตรงลิขสิทธิ์แท้ ที่รวมเกมและกิจกรรมเครดิตไว้ในระบบเดียว";

const pageDescription =
  "เกี่ยวกับ PAYDAY24 เว็บตรงลิขสิทธิ์แท้ จ่ายจริง 100% รวมสล็อต PG Slot Joker Gaming Jili คาสิโนสด SA Gaming บาคาร่า หวย และแทงบอล พร้อมกิจกรรมรับเครดิตทุกวัน";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox as="h1" title={pageHeading}>
    <p class="mb-4 text-left text-base leading-relaxed text-[#ede4fb]">
      <strong class="text-[#ffe680]">PAYDAY24</strong> เริ่มจากโจทย์ง่าย ๆ ข้อเดียว คือทำให้คนที่ชอบความสนุกหลายแบบไม่ต้องย้ายเว็บทุกครั้งที่เปลี่ยนใจ สล็อต คาสิโนสด หวย และกีฬา จึงอยู่ในระบบสมาชิกเดียวกัน
    </p>

    <p class="mb-4 text-left text-base leading-relaxed text-[#ede4fb]">
      เราเป็นเว็บตรงลิขสิทธิ์แท้ ไม่ผ่านเอเย่นต์ เกมทุกเกมมาจากค่ายที่มีระบบของตัวเอง และทุกรายการฝากถอนวิ่งอยู่บนระบบออโต้ของเราเอง
    </p>

    <p class="text-left text-base leading-relaxed text-[#ede4fb]">เกมเยอะเป็นเรื่องพื้นฐานไปแล้ว ที่ยังต่างกันคือใช้งานจริงแล้วสะดุดตรงไหนบ้าง</p>
  </ContentBox>

  <ContentBox as="h2" title="จุดยืนของ PAYDAY24 เว็บตรงไม่ผ่านเอเย่นต์ที่จ่ายจริง 100%">
    <p class="mb-4 text-left text-base leading-relaxed text-[#ede4fb]">
      ทุกยอดฝากถอนเดินอยู่ในระบบของเราเอง ไม่มีคนกลางมาคั่นระหว่างสมาชิกกับเกมที่กำลังเล่นอยู่ เมื่อมีปัญหาจึงตามรายการย้อนหลังได้จากที่เดียว
    </p>

    <p class="mb-4 text-left text-base leading-relaxed text-[#ede4fb]">
      คำว่าจ่ายจริง 100% ไม่ได้เป็นแค่ประโยคบนแบนเนอร์ แต่หมายถึงยอดที่ถอนได้จริงตามเงื่อนไขที่แจ้งไว้ตั้งแต่ต้น และประวัติรายการที่สมาชิกเปิดดูเองได้จากหน้าเมมเบอร์
    </p>

    <p class="text-left text-base leading-relaxed text-[#ede4fb]">ความมั่นคงเป็นเรื่องที่พิสูจน์ด้วยรายการ ไม่ใช่ด้วยขนาดตัวหนังสือบนหน้าเว็บ</p>
  </ContentBox>

  <ContentBox as="h2" title="ค่ายสล็อตในระบบ PG Slot, Joker Gaming และ Jili">
    <p class="mb-4 text-left text-base leading-relaxed text-[#ede4fb]">
      หมวดสล็อตรวมเกมจาก PG Slot, Joker Gaming และ Jili ทั้งสามค่ายเปิดอยู่ในยูสเดียวกัน ไม่ต้องสมัครแยกและไม่ต้องโยกเครดิตข้ามระบบเมื่ออยากเปลี่ยนค่าย
    </p>

    <p class="mb-4 text-left text-base leading-relaxed text-[#ede4fb]">
      แต่ละค่ายมีจังหวะของตัวเอง PG Slot เด่นที่ภาพและเมนูที่อ่านง่ายบนมือถือ Joker Gaming มีเกมคลาสสิกให้เลือกเยอะ ส่วน Jili เหมาะกับคนที่ชอบรอบสั้นและสลับเกมบ่อย
    </p>

    <p class="mb-4 text-left text-base leading-relaxed text-[#ede4fb]">
      เกมในระบบมาพร้อมค่า RTP สูง มีทั้งเกมแตกง่าย แตกบ่อย และเกมที่เน้นตัวคูณให้เลือกตามสไตล์การหมุน
    </p>

    <p class="text-left text-base leading-relaxed text-[#ede4fb]">เกมฮิตกับเกมที่ถูกใจคุณ ไม่ใช่เกมเดียวกันเสมอไป</p>
  </ContentBox>

  <ContentBox as="h2" title="คาสิโนสดจาก SA Gaming กับบาคาร่าที่เลือกโต๊ะได้จากหน้าเดียว">
    <p class="mb-4 text-left text-base leading-relaxed text-[#ede4fb]">
      คาสิโนสดของ PAYDAY24 ส่งตรงจากสตูดิโอชั้นนำอย่าง SA Gaming ภาพและเสียงมาจากโต๊ะจริง มีดีลเลอร์อยู่ตรงหน้ากล้องตลอดรอบเกม
    </p>

    <p class="mb-4 text-left text-base leading-relaxed text-[#ede4fb]">
      บาคาร่าเป็นโต๊ะที่คนเข้ามากที่สุด เพราะกติกาไม่ซับซ้อนและรอบเกมสั้น เหมาะกับคนที่เพิ่งย้ายมาจากสล็อตแล้วอยากลองบรรยากาศอีกแบบโดยไม่ต้องเรียนกติกาใหม่ทั้งหมด
    </p>

    <p class="text-left text-base leading-relaxed text-[#ede4fb]">บางวันสล็อตไม่ใช่อารมณ์ โต๊ะสดก็อยู่ตรงนั้นให้เปลี่ยนได้ทันที</p>
  </ContentBox>

  <ContentBox as="h2" title="หวยออนไลน์อัปเดตทุกงวด และแทงบอลในราคานับบอลที่ดีที่สุด">
    <p class="mb-4 text-left text-base leading-relaxed text-[#ede4fb]">
      หวยออนไลน์อัปเดตทุกงวด เลือกตลาดและดูผลได้จากหน้าเดียวกับที่ใช้เล่นเกมอื่น ไม่ต้องเปิดยูสชุดใหม่เพียงเพราะเปลี่ยนจากหมุนสล็อตมาลุ้นเลข
    </p>

    <p class="mb-4 text-left text-base leading-relaxed text-[#ede4fb]">
      ฝั่งกีฬาเปิดแทงบอลออนไลน์ในราคานับบอลที่ดีที่สุด คนที่ตามลีกอยู่แล้วเปิดดูคู่ที่สนใจก่อนเกมเริ่ม แล้วกลับไปเล่นหมวดอื่นระหว่างรอผลได้จากบัญชีเดิม
    </p>

    <p class="text-left text-base leading-relaxed text-[#ede4fb]">ความหลากหลายมีไว้ให้เลือก ไม่ได้มีไว้ให้เล่นครบทุกอย่างในวันเดียว</p>
  </ContentBox>

  <ContentBox as="h2" title="กิจกรรมรับเครดิตของ PAYDAY24 และเงื่อนไขที่ไม่เหมือนกัน">
    <p class="mb-4 text-left text-base leading-relaxed text-[#ede4fb]">
      กิจกรรมรับเครดิตมีหลายแบบ ทั้งคืนยอดเสีย เช็กอินประจำวัน กงล้อ กรอกโค้ด และเครดิตฟรีที่เปิดตามช่วงเวลา
    </p>

    <p class="mb-4 text-left text-base leading-relaxed text-[#ede4fb]">
      สิ่งที่มองข้ามกันบ่อยคือแต่ละแบบใช้เงื่อนไขคนละชุด คืนยอดเสียผูกกับเงื่อนไขการใช้งานของบัญชี เช็กอินนับจากการกลับเข้ามารับสิทธิ์ตามรอบ ส่วนกงล้อเป็นการลุ้นของรางวัลจากกิจกรรม
    </p>

    <p class="mb-4 text-left text-base leading-relaxed text-[#ede4fb]">
      บางรายการต้องกดรับสิทธิ์หรือกรอกข้อมูลก่อน และบางโปรเปิดเฉพาะช่วงที่กำหนดไว้เท่านั้น
    </p>

    <p class="text-left text-base leading-relaxed text-[#ede4fb]">สิทธิ์ที่บัญชีมีวันนี้อาจไม่เหมือนเมื่อวาน เปิดหน้ากิจกรรมก่อนเริ่มเล่นเร็วกว่าเดา</p>
  </ContentBox>

  <ContentBox as="h2" title="ฝากถอนออโต้ รองรับ True Wallet กับความเร็วที่เราไม่ผูกไว้กับตัวเลข">
    <p class="mb-4 text-left text-base leading-relaxed text-[#ede4fb]">
      ระบบฝากถอนเป็นออโต้ และรองรับ True Wallet นอกเหนือจากบัญชีธนาคาร ทำรายการแล้วดูสถานะต่อได้เองจากหน้าเมมเบอร์
    </p>

    <p class="mb-4 text-left text-base leading-relaxed text-[#ede4fb]">
      ความเร็วของแต่ละรายการต่างกันตามช่องทาง เวลา และสถานะของระบบในขณะนั้น เราจึงไม่ผูกคำว่าโอนไวไว้กับเลขวินาทีตายตัว เพราะตัวเลขแบบนั้นไม่ได้จริงทุกรอบ
    </p>

    <p class="mb-4 text-left text-base leading-relaxed text-[#ede4fb]">
      สิ่งที่ระบบออโต้ทำได้จริงคือตัดขั้นตอนที่ไม่จำเป็นออก ฝาก ถอน แล้วกลับไปเลือกเกมต่อได้โดยไม่ต้องรอใครมากดอนุมัติทีละรายการ
    </p>

    <p class="text-left text-base leading-relaxed text-[#ede4fb]">เงินควรเดินตามเกมให้ทัน ไม่ใช่ให้คนเล่นนั่งเฝ้าหน้าจอรอจนความสนุกหมดก่อน</p>
  </ContentBox>

  <Navfoot />
</MainLayout>
