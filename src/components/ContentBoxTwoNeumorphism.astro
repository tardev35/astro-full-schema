---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;
---

<section class="mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="w-full rounded-[25px] border border-[#5a1a1e] bg-[#170a0b] p-8 shadow-[10px_10px_20px_#000000,-10px_-10px_20px_#2a1113] transition-all duration-300 hover:shadow-[15px_15px_30px_#000000,-15px_-15px_30px_#3a1518]">
    {
      title && (
        <header class="mb-8 border-b border-[#5a1a1e] pb-4 text-center">
          <HeadingTag class="bg-gradient-to-r from-[#ff3b46] via-[#f2f5f7] to-[#bdcad2] bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#dce3e8]">
        {titleleft && <p class="text-xl leading-normal font-black tracking-wide text-[#f2f5f7] drop-shadow-[0_0_10px_rgba(224,27,45,0.35)]">{titleleft}</p>}
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#dce3e8] md:border-l md:border-[#5a1a1e] md:pl-8">
        {titleright && <p class="text-xl leading-normal font-black tracking-wide text-[#f2f5f7] drop-shadow-[0_0_10px_rgba(224,27,45,0.35)]">{titleright}</p>}
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
