---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementCyber.astro";
import CtaRedirect from "../components/CtaRedirect.astro";
import { pageGraph } from "../lib/schema";

const pageDescription =
  "สมัครสมาชิก TEMMAX69 หน้าสมัครเว็บหลัก กดปุ่มเดียวเปิดบัญชีผ่านมือถือ รับโบนัสสมาชิกใหม่ เลือกเกมสล็อตใหม่ และฝากถอนผ่าน True Wallet ด้วยระบบออโต้ 24 ชั่วโมง";

const graph = pageGraph(Astro, {
  name: "สมัครสมาชิก TEMMAX69 เว็บหลัก",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "สมัครสมาชิก", path: "/register" },
  ],
});

const targetUrl = "https://yoalink.com/22hs";
---

<MainLayout title="สมัครสมาชิก TEMMAX69 | เปิดบัญชีเว็บสล็อตมาใหม่" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="สมัครสมาชิก TEMMAX69" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label="สมัครสมาชิก"
        class="group relative mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#c084fc]/60 bg-gradient-to-b from-[#c084fc] via-[#a855f7] to-[#4c1d95] px-6 py-4 text-xl font-bold tracking-wide text-[#070218] shadow-[0_10px_30px_rgba(168,85,247,0.35)] transition-all duration-300 hover:scale-105 hover:shadow-[0_15px_40px_rgba(34,211,238,0.30)]">
        สมัครสมาชิก
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="สมัครสมาชิก" />
</MainLayout>
