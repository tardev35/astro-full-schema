---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementCyber.astro";
import { pageGraph } from "../lib/schema";

const pageTitle = "เกี่ยวกับเรา GODKINGKONG เว็บตรงเกมสล็อตแตกหนัก เกมแท้จากค่ายแม่";

const pageDescription =
  "เกี่ยวกับเรา GODKINGKONG เว็บตรงเกมสล็อตแตกหนัก เกมแท้จากค่ายแม่ ไม่ปรับ RTP ไม่ล็อกยูส ทุนหนาจ่ายจบทุกยอด ฝากถอนออโต้ 3-5 วินาที รองรับวอเล็ทไม่มีขั้นต่ำ";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox as="h1" title={pageTitle}>
    <p class="mb-4 text-left text-base leading-relaxed text-[#ddf3e2]">
      GODKINGKONG คืออาณาจักรใหม่ของคนชอบเล่นสล็อต เราเปิดตัวขึ้นมาด้วยความตั้งใจข้อเดียวคือทำเว็บตรงที่สะท้อนคุณภาพระดับเจ้าป่าจริง ๆ
      ไม่ใช่เว็บที่มีทุกอย่างแล้วไม่ดีสักอย่าง ด้านเทคโนโลยีเราใช้ระบบออโต้เสถียรแบบเว็บนอก ฝากถอนเร็วเป็นอันดับต้น ๆ ของตลาด ไม่ล็อกยูส ไม่ปรับเรท
      และให้บริการเฉพาะเกมแท้ที่ค่า RTP เต็มจำนวนถูกต้องตามเซิร์ฟเวอร์นอกเท่านั้น
    </p>

    <p class="text-left text-base leading-relaxed text-[#ddf3e2]">
      หน้านี้ทำหน้าที่เป็นหน้าข้อมูลและแนะนำตัว อธิบายว่าเราเป็นใคร ยึดมาตรฐานอะไร และอะไรคือสิ่งที่เราทำต่างจากเว็บทั่วไปในตลาด
      เราเขียนไว้ให้อ่านแล้วนำไปตรวจสอบต่อได้จริง ไม่ใช่ถ้อยคำโฆษณาลอย ๆ เพราะการเลือกเว็บสล็อตเป็นเจ้ามือสักรายมันยากยิ่งกว่างมเข็ม
      และเรื่องเงินไม่ควรวัดกันที่ว่าใครพูดเก่งกว่า แต่ควรวัดกันที่ว่าใครทำได้จริงตามที่พูด
    </p>
  </ContentBox>

  <ContentBox as="h2" title="สถานะการเงินระดับคิงคอง จ่ายจบทุกบาท ไม่แบ่งจ่าย ไม่ผ่อนส่ง">
    <p class="mb-4 text-left text-base leading-relaxed text-[#ddf3e2]">
      เหตุผลที่เว็บหนึ่งกล้าให้โบนัสแรงในสิ่งที่คนอื่นไม่กล้า ไม่ได้อยู่ที่คำโฆษณา แต่อยู่ที่ยอดเงินสำรองในมือ GODKINGKONG มีทุนจดทะเบียนมหาศาล
      ที่ตั้งไว้เพื่อรองรับยอดถอนของสมาชิกโดยเฉพาะ ไม่ว่าคุณจะเป็นสายปั่นทุนน้อยที่เข้ามาวันละไม่กี่ร้อย หรือวาฬกระเป๋าหนักที่ถอนวันละหลักล้าน
      เราก็พร้อมจ่ายจบครบทุกบาทในรายการเดียว ไม่มีแบ่งจ่าย ไม่มีผ่อนส่ง
    </p>

    <p class="text-left text-base leading-relaxed text-[#ddf3e2]">
      เว็บที่สายป่านสั้นมักเริ่มถ่วงเวลาและตั้งเงื่อนไขเพิ่มทันทีที่มีคนถอนก้อนใหญ่พร้อมกันหลายราย เราไม่จำเป็นต้องเล่นเกมแบบนั้นเลย
      สภาพคล่องที่สูงพอคือสิ่งเดียวที่ทำให้เว็บหนึ่งกล้าแฟร์กับผู้เล่นได้ตลอดทั้งปี ไม่ใช่แฟร์เฉพาะช่วงที่ยอดยังไม่หนัก
      และเป็นเหตุผลที่เรากล้าคืนยอดเล่นและปล่อยโบนัสจริงโดยไม่ต้องแอบไปหักคืนทางอื่น
    </p>
  </ContentBox>

  <ContentBox as="h2" title="ลิขสิทธิ์แท้จากค่ายแม่ ไม่ดัดแปลงค่า RTP ไม่ล็อกยูส">
    <p class="mb-4 text-left text-base leading-relaxed text-[#ddf3e2]">
      เกมสล็อตทุกเกมที่เปิดให้เล่นบน GODKINGKONG ส่งตรงผ่าน API จากค่ายแม่ตัวจริงบน Official Server ไม่ใช่ของก๊อป ไม่ผ่านเอเย่นต์ และไม่ผ่านคนกลางชั้นใด
      เราไม่มีการดัดแปลงค่า RTP ใด ๆ ทั้งสิ้น สิ่งที่คุณเห็นบนหน้าจอจึงเป็นผลลัพธ์ชุดเดียวกับที่ค่ายผู้พัฒนาส่งออกมา ยุติธรรมแบบ 100%
      เหมือนบินไปนั่งกดตู้ถึงลาสเวกัสด้วยตัวเอง
    </p>

    <p class="text-left text-base leading-relaxed text-[#ddf3e2]">
      เราไม่ได้ขนเกมมาถมให้เต็มเว็บ แต่คัดเฉพาะค่ายที่มีสถิติการแตกดีตรงตามต้นฉบับและโบนัสเข้าบ่อยระดับ God Tier ทั้ง PG SOFT ค่ายมหาชนที่ภาพสวยฟีเจอร์แน่น
      Pragmatic Play สำหรับสายซื้อฟรีสปินที่อยากลุ้นตัวคูณโหด ๆ แบบไม่ต้องรอ และคู่คลาสสิกสุดเก๋าอย่าง Joker กับ SlotXO ที่ความขลังยังอยู่ครบ แตกทีมีสะดุ้ง
      ทั้งหมดรวมอยู่ในยูสเซอร์เดียว ไม่ต้องโยกเงินไปมาให้ปวดหัว
    </p>
  </ContentBox>

  <ContentBox as="h2" title="ฝากถอนออโต้ไม่เกิน 3-5 วินาที รองรับวอเล็ทไม่มีขั้นต่ำ">
    <p class="mb-4 text-left text-base leading-relaxed text-[#ddf3e2]">
      ผู้เล่นยุคใหม่เลือกวอเล็ทมากกว่าธนาคาร เราจึงรองรับทั้ง True Wallet และ Mobile Banking พร้อมเพย์ โดยทุกช่องทางวิ่งเร็วเท่ากันหมด
      ไม่มีช่องทางไหนถูกลดความสำคัญ และไม่มีขั้นต่ำผูกไว้ มีเงินติดวอเล็ทแค่ 1 บาทก็เข้ามาเป็นสมาชิกและได้รับการดูแลระดับ VIP เหมือนกันทุกคน
      อิสระทางการเงินตรงนี้คือสิ่งที่เราตั้งใจให้เป็นจุดยืนของเว็บ
    </p>

    <p class="text-left text-base leading-relaxed text-[#ddf3e2]">
      ทุกรายการฝากถอนทำงานแบบออโต้ฉับไว เงินเข้าออกไม่เกิน 3-5 วินาที ไม่ต้องส่งสลิปให้แอดมินตรวจ ไม่ต้องทักตามเงิน ไม่มีการถือดองยอด และไม่มีข้ออ้าง
      เรายืนยันตามสไตล์เจ้าป่าว่าเล่นได้เท่าไหร่ จ่ายเท่านั้น ไม่ต่อ ไม่กั๊ก ไม่โม้ เพราะความต่อเนื่องคือหัวใจของการทำกำไร และเราไม่ยอมให้คุณเสียจังหวะ
    </p>
  </ContentBox>

  <ContentBox as="h2" title="สมัครง่ายเหมือนดีดนิ้ว ไม่ต้องส่งบัตรประชาชน">
    <p class="mb-4 text-left text-base leading-relaxed text-[#ddf3e2]">
      การสมัครเป็นสมาชิก GODKINGKONG ง่ายแสนง่าย กรอกข้อมูลที่จำเป็นไม่กี่อย่าง ตั้งรหัส แล้วเลือกวิธีฝาก เพียงเท่านี้ก็เข้ามาเป็นส่วนหนึ่งของอาณาจักรสล็อตคิงคองได้ทันที
      ไม่ต้องส่งบัตรประชาชน ไม่ต้องถ่ายรูปหน้า และไม่มีการขอข้อมูลแปลก ๆ ที่ทำให้ผู้เล่นรู้สึกล้ำเส้น เพราะเว็บนี้สร้างมาเพื่อความรวดเร็วจริง ๆ
    </p>

    <p class="text-left text-base leading-relaxed text-[#ddf3e2]">
      มีอีกสองสามข้อที่อยากให้ช่วยกันดูแล เพราะความปลอดภัยต้องทำจากทั้งสองฝั่ง ชื่อบัญชีหรือวอเล็ทควรตรงกับชื่อผู้สมัคร และเบอร์โทรควรรับข้อความได้จริง
      เพราะระบบจะเร็วแค่ไหนก็ไม่มีประโยชน์ ถ้ากรอกชื่อบัญชีคลาดเคลื่อนตั้งแต่แรกแล้วต้องมาตามแก้ทีหลัง ก่อนล็อกอินทุกครั้งควรตรวจชื่อเว็บไซต์และการเชื่อมต่อแบบ HTTPS ให้ถูกต้อง
      และไม่ควรส่งรหัสผ่านหรือรหัส OTP ให้บุคคลอื่นไม่ว่ากรณีใด ทีมงานตัวจริงไม่มีความจำเป็นต้องขอสองสิ่งนี้
    </p>
  </ContentBox>

  <Navfoot />
</MainLayout>
