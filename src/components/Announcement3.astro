---
const {
  message = "888NEO รวมเกมสล็อตและคาสิโนสดไว้ในบัญชีเดียว เลือกหมวดที่อยากเล่นได้จากหน้าเดียว • ระบบออโต้ช่วยลดขั้นตอนฝากถอน ตรวจเครดิตและสถานะรายการได้จากหน้าสมาชิก • ทางเข้า 888NEO เว็บหลัก รองรับทั้งมือถือและคอมพิวเตอร์ด้วยข้อมูลสมาชิกเดิม",
} = Astro.props;
---

<div class="mx-auto mt-4 max-w-[900px] px-4 md:px-0">
  <div
    class="relative flex h-[46px] items-center rounded-r-full border border-[#f5c542]/40 bg-gradient-to-r from-[#8c0f12]/70 to-[#1c0403] py-2 pr-4 pl-12 shadow-[0_0_20px_rgba(245,197,66,0.16)] backdrop-blur-md">
    <div class="absolute top-1/2 -left-2 flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full border-[3px] border-[#f5c542] bg-[#1c0403] shadow-[0_0_15px_rgba(245,197,66,0.55)]">
      <span aria-hidden="true" class="animate-pulse text-xl">📢</span>
    </div>

    <div class="mr-4 h-full w-[1px] bg-[#f5c542]/30"></div>

    <div class="flex-1 overflow-hidden [mask-image:linear-gradient(90deg,transparent_0%,#000_5%,#000_95%,transparent_100%)]">
      <div class="flex w-max animate-[scroll_25s_linear_infinite] gap-12 text-sm font-bold whitespace-nowrap text-[#ffe9a8]">
        <span class="drop-shadow-[0_0_5px_rgba(245,197,66,0.5)]">{message}</span>
        <span class="drop-shadow-[0_0_5px_rgba(245,197,66,0.5)]">{message}</span>
      </div>
    </div>
  </div>
</div>

<style>
  @keyframes scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(calc(-50% - 24px));
    }
  }
</style>
