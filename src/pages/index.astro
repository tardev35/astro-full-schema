---
import MainLayout from "../layouts/MainLayout.astro";
import AnnouncementCyber from "../components/AnnouncementCyber.astro";
import ContentBoxCyberCut from "../components/ContentBoxCyberCut.astro";
import ContentBox from "../components/ContentBox.astro";
import ContentBoxFloatingBadge from "../components/ContentBoxFloatingBadge.astro";
import ContentBoxTwoCyberCut from "../components/ContentBoxTwoCyberCut.astro";
import ContentBoxSevenThreeCyberCut from "../components/ContentBoxSevenThreeCyberCut.astro";
import ContentBoxSevenThreeFloatingBadge from "../components/ContentBoxSevenThreeFloatingBadge.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import ProviderGrid from "../components/ProviderGrid.astro";
import GameRankingBoard from "../components/GameRankingBoard.astro";
import ReviewCardSumo2 from "../components/ReviewCardSumo2.astro";
import LatestWinners4 from "../components/LatestWinners4.astro";
import SmoothCarousel from "../components/SmoothCarousel.astro";
import Faq4 from "../components/Faq4.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import imgReferral from "../assets/slide1.png";
import imgCommission from "../assets/slide2.png";

const pageTitle = "GODKINGKONG เว็บตรงเกมสล็อตแตกหนัก โบนัสแรง จ่ายจริงทุกยอด";

const pageDescription =
  "GODKINGKONG เว็บตรงเกมสล็อตแตกหนัก รวมค่ายสล็อตแตกง่าย กล้าให้ โบนัสแรง จ่ายจริงทุกยอด รองรับวอเล็ทไม่มีขั้นต่ำ ฝากถอนออโต้ 3 วินาที สมัครง่ายเหมือนดีดนิ้ว";

const referralAlt =
  "โปรโมชั่น GODKINGKONG ข้อความสีขาวว่า แนะนำเพื่อน รับโบนัส และตัวเลข 0.8% ขนาดใหญ่ขอบสีเขียวนีออนบนแผ่นป้ายสีดำ ใต้ลงมาเขียนว่า สร้างรายได้ 100,000 ต่อเดือน มุมซ้ายบนเป็นโลโก้ godking kong รูปหัวกอริลลาสวมมงกุฎทอง ด้านขวาเป็นพรีเซนเตอร์หญิงชุดเลื่อมสีทอง ฉากหลังเป็นป่าสีเขียวนีออนและเหรียญทองปลิว";

const commissionAlt =
  "โปรโมชั่น GODKINGKONG คำว่า COMMISSION สีขาว ใต้ลงมาเขียนว่า คืนทุกยอดเล่นตลอดทั้งวัน และตัวเลข 0.3% สีเขียวนีออนขนาดใหญ่บนแผ่นป้ายสีดำ ถัดลงมาเขียนว่า เล่นถึง 50% ถอนได้เลย รับสิทธิ์ก่อน 23.59 น. ของทุกวัน และ ยิ่งเล่นเยอะ ยิ่งได้เยอะ ด้านบนเป็นโลโก้ godking kong รูปหัวกอริลลาสวมมงกุฎทอง ด้านซ้ายเป็นพรีเซนเตอร์หญิงถือไพ่สี่ใบ ฉากหลังเป็นป่าสีเขียวนีออน";

const faqs = [
  {
    q: "GODKINGKONG เป็นเว็บตรงลิขสิทธิ์แท้จริงไหม เกมส่งตรงจากค่ายแม่หรือเปล่า",
    a: "เกมสล็อตทุกเกมที่นี่ส่งตรงผ่าน API จากค่ายแม่ (Official Server) เป็นลิขสิทธิ์แท้ ไม่ใช่ของก๊อป และไม่มีการดัดแปลงค่า RTP ใดๆ คุณจะได้รับความยุติธรรมแบบ 100% เหมือนบินไปนั่งกดตู้ที่ลาสเวกัส",
  },
  {
    q: "ฝากถอนออโต้ของ GODKINGKONG ใช้เวลานานแค่ไหน ต้องทักตามเงินไหม",
    a: "ทุกรายการฝากถอนเป็นแบบออโต้ฉับไว เงินเข้าออกไม่เกิน 3–5 วินาที ไม่ต้องทักตามเงิน ไม่ถือดองยอด ไม่มีข้ออ้าง เล่นได้เท่าไหร่ จ่ายเท่านั้น ไม่ต่อ ไม่กั๊ก ไม่โม้",
  },
  {
    q: "ถอนยอดใหญ่ทีเดียวได้เลยหรือต้องแบ่งจ่ายเป็นรอบ",
    a: "เรามีทุนจดทะเบียนมหาศาลไว้รองรับยอดถอนโดยเฉพาะ ไม่ว่าจะเป็นสายปั่นทุนน้อยหรือวาฬกระเป๋าหนักที่ถอนวันละล้าน เราก็พร้อมจ่ายจบครบทุกบาท ไม่มีแบ่งจ่าย ไม่มีผ่อนส่ง",
  },
  {
    q: "มีค่ายสล็อตอะไรให้เล่นบ้าง ต้องโยกเงินระหว่างค่ายหรือไม่",
    a: "คัดค่ายสล็อตแตกง่ายระดับ God Tier มาให้ ทั้ง PG SOFT ที่ภาพสวยฟีเจอร์แน่น Pragmatic Play สำหรับสายซื้อฟรีสปิน และค่ายเก๋าอย่าง Joker & SlotXO ครบจบในยูสเซอร์เดียว ไม่ต้องโยกเงินให้ปวดหัว",
  },
  {
    q: "สมัครสมาชิก GODKINGKONG ต้องใช้เอกสารอะไรบ้าง รองรับวอเล็ทไหม",
    a: "กรอกข้อมูลที่จำเป็นไม่กี่อย่าง ตั้งรหัส แล้วเลือกวิธีฝาก ไม่ต้องส่งบัตรประชาชน ไม่ต้องถ่ายรูปหน้า รองรับทั้ง True Wallet และ Mobile Banking พร้อมเพย์ ฝากถอนไม่มีขั้นต่ำ 1 บาทก็เริ่มได้",
  },
];

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <AnnouncementCyber />

  <SmoothCarousel />

  <ContentBoxCyberCut as="h1" title="GODKINGKONG เว็บตรงเกมสล็อตแตกหนัก โบนัสแรง จ่ายจริงทุกยอด">
    <div>
      <p class="text-left text-base leading-relaxed text-[#ddf3e2]">
        <strong class="text-[#7bff9f]">GODKINGKONG</strong> เว็บตรงเกมสล็อตแตกหนัก เว็บใหม่ที่สะท้อนคุณภาพระดับเจ้าป่า ด้านเทคโนโลยีก็ไม่แพ้ใคร ใช้ระบบออโต้เสถียรแบบเว็บนอก
        ฝากถอนเร็วเป็นอันดับต้น ๆ ของตลาด ไม่ล็อกยูส ไม่ปรับเรท และมาพร้อมเกมแท้ค่า RTP เต็มจำนวนถูกต้อง ตามเซิร์ฟเวอร์นอก
      </p>
      <p class="mt-3 text-left text-base leading-relaxed text-[#ddf3e2]">
        GODKINGKONG อาณาจักรใหม่ของคนชอบเล่นสล็อต โบนัสแรง แตกหนัก แจกแบบไม่กลัวเจ๊ง จ่ายจริงทุกยอด ตรงเวลา น่าเชื่อถือจริง ถ้าให้ลอง
      </p>
    </div>
  </ContentBoxCyberCut>

  <ContentBoxSevenThreeFloatingBadge as="h2" title="ทำไม GODKINGKONG กล้าให้ โบนัสแรง ในสิ่งที่คนอื่นไม่กล้า">
    <Picture
      slot="left"
      src={imgReferral}
      alt={referralAlt}
      loading="lazy"
      fetchpriority="low"
      widths={[200, 400, 600]}
      sizes="(max-width: 768px) 100vw, 30vw"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      class="mx-auto h-auto w-full rounded-2xl border border-[#2fe35f]/30 shadow-[0_10px_30px_rgba(47,227,95,0.26)]"
    />
    <div slot="right">
      <p class="text-left text-base leading-relaxed text-[#ddf3e2]">
        การจะเลือก “เว็บสล็อตเป็นเจ้ามือ” ที่ไว้ใจได้สักรายมันยากยิ่งกว่างมเข็ม แต่เหตุผลที่คุณควรปักหลักที่นี่ GODKINGKONG เพราะเราคือ เว็บตรงเกมสล็อตแตกหนัก ที่ไม่ได้มีดีแค่คำโฆษณา
      </p>
      <p class="mt-3 text-left text-base leading-relaxed text-[#ddf3e2]">
        <strong class="text-[#7bff9f]">ลิขสิทธิ์แท้ ไม่ใช่ของก๊อป</strong> — เกมสล็อตทุกเกมที่นี่ ส่งตรงผ่าน API จากค่ายแม่ (Official Server) ไม่มีการดัดแปลงค่า RTP ใดๆ
        คุณจะได้รับความยุติธรรมแบบ 100% เหมือนบินไปนั่งกดตู้ที่ลาสเวกัส
      </p>
      <p class="mt-3 text-left text-base leading-relaxed text-[#ddf3e2]">
        <strong class="text-[#7bff9f]">สถานะการเงินระดับ “คิงคอง”</strong> — เรามีทุนจดทะเบียนมหาศาลเพื่อรองรับยอดถอนของคุณ ไม่ว่าคุณจะเป็นสายปั่นทุนน้อย
        หรือวาฬกระเป๋าหนักที่ถอนวันละล้าน เราก็พร้อมจ่ายจบ ครบทุกบาท ไม่มีแบ่งจ่าย ไม่มีผ่อนส่ง
      </p>
      <p class="mt-3 text-left text-base leading-relaxed text-[#ddf3e2]">
        <strong class="text-[#7bff9f]">ความสดใหม่</strong> — ด้วยความที่เป็นเว็บใหม่ เทคโนโลยีของเราจึงล้ำหน้ากว่าเว็บเก่าๆ หลายปีแสง ทั้งความลื่นไหล กราฟิก
        และฟีเจอร์เกมที่อัปเดตก่อนใครเพื่อน
      </p>
    </div>
  </ContentBoxSevenThreeFloatingBadge>

  <ContentBoxSevenThreeCyberCut as="h3" titleright="GODKINGKONG ฝากถอนออโต้ไว จ่ายจริง ไม่ยื้อยอด ไม่งอแง">
    <Picture
      slot="left"
      src={imgCommission}
      alt={commissionAlt}
      loading="lazy"
      fetchpriority="low"
      widths={[200, 400, 600]}
      sizes="(max-width: 768px) 100vw, 30vw"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      class="mx-auto h-auto w-full rounded-2xl border border-[#2fe35f]/30 shadow-[0_10px_30px_rgba(47,227,95,0.26)]"
    />
    <div slot="right">
      <p class="text-left text-base leading-relaxed text-[#ddf3e2]">
        ทุกรายการฝากถอน แบบออโต้ฉับไว เงินเข้าออกเร็ว ไม่เกิน 3–5 วินาที ไม่ต้องทักตามเงิน ไม่ถือดองยอด ไม่มีข้ออ้าง เรายืนยันตามสไตล์เจ้าป่า “เล่นได้เท่าไหร่ จ่ายเท่านั้น ไม่ต่อ ไม่กั๊ก
        ไม่โม้”
      </p>
    </div>
  </ContentBoxSevenThreeCyberCut>

  <ContentBox as="h2" title="รวมค่ายสล็อตแตกง่าย คัดเนื้อๆ เน้นๆ ระดับ God Tier">
    <div>
      <p class="text-left text-base leading-relaxed text-[#ddf3e2]">
        เราไม่ได้แค่ขนเกมมาถมให้เต็มเว็บ แต่ทีมงาน GODKINGKONG ให้บริการเกมสล็อตจากหลายค่ายอย่างถูกต้องลิขสิทธิ์เกมแท้ มีสถิติการแตกดีตรงตามต้นฉบับ โบนัสเข้าบ่อยที่สุด มาเสิร์ฟให้คุณถึงหน้าจอ
        ไม่ว่าจะเป็น PG SOFT ค่ายเกมมหาชน ภาพสวย ฟีเจอร์แน่น แตกหนักสะใจ Pragmatic Play สายซื้อฟรีสปินต้องค่ายนี้ ลุ้นตัวคูณโหดๆ แบบไม่ต้องรอ
      </p>
      <p class="mt-3 text-left text-base leading-relaxed text-[#ddf3e2]">
        หรือแม้แต่ ค่ายเกมสุดเก๋า Joker &amp; SlotXO ความคลาสสิกที่ยังคงขลัง แตกทีมีสะดุ้ง ไม่ว่าคุณจะชอบสไตล์ไหน เรามีให้ครบจบในยูสเซอร์เดียว ไม่ต้องโยกเงินให้ปวดหัว
      </p>
    </div>
  </ContentBox>

  <ProviderGrid />

  <GameRankingBoard />

  <ContentBoxTwoCyberCut
    as="h2"
    title="รองรับวอเล็ทไม่มีขั้นต่ำ เร็วกว่า เสถียรกว่า ใช้ง่ายกว่า"
    titleleft="ทุกช่องทางวิ่งเร็วเท่ากัน"
    titleright="1 บาทก็เป็น VIP ของเว็บเรา">
    <p class="text-left text-base leading-relaxed text-[#ddf3e2]">ผู้เล่นยุคใหม่เลือกวอเล็ทมากกว่าธนาคาร เราจึงรองรับทั้ง True Wallet หรือ Mobile Banking พร้อมเพย์</p>
    <p slot="left" class="text-left text-base leading-relaxed text-[#ddf3e2]">ทุกช่องทางวิ่งเร็วเหมือนกัน ไม่มีช่องทางไหนถูกลดความสำคัญ อิสระทางการเงินเต็มที่ ฝากตอนไหน ถอนตอนไหน จัดการได้เอง</p>
    <p slot="right" class="text-left text-base leading-relaxed text-[#ddf3e2]">
      ฝากถอน วอเล็ทไม่มีขั้นต่ำ 1 บาทก็เป็นลูกค้า VIP ของเว็บเรา GODKINGKONG ได้เหมือนกัน ถ้าฝากอย่างต่อเนื่อง
    </p>
  </ContentBoxTwoCyberCut>

  <ContentBoxFloatingBadge as="h2" title="สมัคร GODKINGKONG ง่ายและรวดเร็วเหมือนดีดนิ้ว">
    <div>
      <p class="text-left text-base leading-relaxed text-[#ddf3e2]">
        สมัครเป็นสมาชิก GODKINGKONG ง่ายแสนง่าย กรอกข้อมูลที่จำเป็นไม่กี่อย่าง ตั้งรหัส แล้วเลือกวิธีฝาก แค่นี้ก็เข้ามาเป็นส่วนหนึ่งของ อาณาจักรสล็อตคิงคองแห่งความสนุก ไม่ต้องส่งบัตรประชาชน
        ไม่ต้องถ่ายรูปหน้า เว็บนี้สร้างมาเพื่อความรวดเร็วจริง ๆ
      </p>
    </div>
  </ContentBoxFloatingBadge>

  <LoginRtpSection />

  <div class="relative z-10 mx-auto mb-10 flex flex-nowrap justify-center gap-3 px-4 sm:gap-6">
    <a
      href="/login"
      class="group relative flex flex-1 items-center justify-center rounded-full bg-gradient-to-r from-[#7bff9f] via-[#2fe35f] to-[#0b6b34] px-4 py-3 text-sm font-black whitespace-nowrap text-[#04170b] shadow-[0_10px_30px_rgba(47,227,95,0.30)] transition-all duration-300 hover:-translate-y-1 hover:scale-105 hover:shadow-[0_15px_40px_rgba(47,227,95,0.42)] sm:flex-none sm:px-10 sm:py-3.5 sm:text-base">
      เข้าสู่ระบบ
    </a>

    <a
      href="/register"
      class="group relative flex flex-1 items-center justify-center rounded-full border border-[#f0c43a]/70 bg-[#0a1a10]/85 px-4 py-3 text-sm font-black whitespace-nowrap text-[#f0c43a] backdrop-blur-sm transition-all duration-300 hover:scale-105 hover:border-[#f0c43a] hover:bg-[#0c1f13]/85 hover:shadow-[0_15px_40px_rgba(240,196,58,0.35)] sm:flex-none sm:px-10 sm:py-3.5 sm:text-base">
      สมัครสมาชิก
    </a>
  </div>

  <ContentBox as="h2" title="เสียงคำรามจาก ผู้ชนะที่แท้จริง">
    <div>
      <p class="text-left text-base leading-relaxed text-[#ddf3e2]">
        “GODKINGKONG คือที่สุดของเว็บสล็อตยุคนี้ครับ! แตกหนักสมชื่อราชาพงไพร ระบบฝากถอนไวเป็นสายฟ้าแลบ ไม่ต้องทนรอแอดมินตอบ แนะนำเลยครับสำหรับสายปั่นตัวจริง”
      </p>
      <p class="mt-3 text-left text-base leading-relaxed text-[#ddf3e2]">
        “ตามหาเว็บที่ RTP ตรงสเปคมานาน จบที่นี่เลยครับ เล่นค่าย PG เข้าฟรีสปินรัวมาก ไม่มีล็อคยูส ถอนเงินหลักแสนก็เข้าบัญชีภายใน 3 วินาที ปลอดภัย 100% ครับ”
      </p>
      <p class="mt-3 text-left text-base leading-relaxed text-[#ddf3e2]">
        “ทุนหลักสิบก็บวกหลักหมื่นได้ค่ะเว็บนี้! โปรโมชั่นเยอะมาก แถมระบบเสถียรสุดๆ เล่นในมือถือไม่สะดุดเลย หัก 1 ดาวเพราะอยากให้เพิ่มเกมยิงปลาค่ายใหม่ๆ อีกนิดค่ะ”
      </p>
    </div>
  </ContentBox>

  <LatestWinners4 />

  <Faq4 title="คำถามที่พบบ่อยเกี่ยวกับ GODKINGKONG" faqs={faqs} />

  <ReviewCardSumo2 />

  <Navfoot />
</MainLayout>
