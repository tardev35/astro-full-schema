---
const reviews = [
  {
    name: "สมาชิกที่ย้ายมาจากเว็บผ่านเอเย่นต์",
    role: "เทียบแล้วบอกว่าเว็บตรงระบบนิ่งกว่าจริง",
    stars: 5,
    tag: "เว็บตรงไม่ผ่านเอเย่นต์",
    content:
      "เคยเล่นเว็บที่ผ่านนายหน้ามาก่อน พอมาลอง YIMSIAM889 ที่เชื่อมสัญญาณตรงจากค่ายแม่ก็รู้สึกได้เลยขอรับว่าเกมนิ่งกว่า ไม่ค้างกลางวงล้อ อัตราการชนะก็เป็นไปตามค่า RTP ที่ค่ายกำหนด ไม่มีใครมาแอบปรับหลังบ้านให้หงุดหงิดหัวใจ วัดกันที่ดวงและฝีมือล้วนๆ ตรวจสอบย้อนหลังได้ทุกขั้นตอน สบายใจกว่าเยอะ",
    avatar: "🏛️",
  },
  {
    name: "สมาชิกใหม่ที่เพิ่งรับโปรต้อนรับ",
    role: "สมัครปุ๊บ รับสิทธิ์ปั๊บ ไม่ต้องรออนุมัติ",
    stars: 5,
    tag: "ยิ้มรับโปรสมาชิกใหม่",
    content:
      "เพิ่งก้าวเข้ามาเป็นสมาชิกได้ไม่นาน ได้ของขวัญต้อนรับชุดใหญ่ไปเต็มๆ ทั้งโบนัสเพิ่มทุนและสิทธิพิเศษที่ทางเว็บจัดสรรมาให้อย่างเหมาะสม ทำให้มีกระสุนเริ่มเล่นมากขึ้นโดยไม่ต้องกังวลเรื่องทุนรอน ขั้นตอนรับสิทธิ์ง่ายดายเพียงลัดนิ้วมือเดียว ไม่ต้องกรอกอะไรยาวเหมือนใบสมัครงาน ประทับใจการต้อนรับแบบไทยแท้ขอรับ",
    avatar: "🎁",
  },
  {
    name: "สมาชิกที่ถอนผ่านแอปธนาคารตอนดึก",
    role: "ทำรายการเองผ่านระบบอัตโนมัติ ไม่ต้องส่งสลิป",
    stars: 5,
    tag: "ธุรกรรมว่องไว",
    content:
      "ระบบฝากถอนของที่นี่เป็นอัตโนมัติเต็มรูปแบบขอรับ ทำรายการเองผ่านแอปธนาคารหรือทรูวอลเลทได้เลย ไม่ต้องส่งสลิปให้แอดมินดูให้เสียเวลา ฝากปุ๊บเงินเข้าปั๊บ ถอนปุ๊บโอนเข้าบัญชีทันที ยอดตรงเป๊ะทุกบาททุกสตางค์ แถมจะนอนเล่นอยู่บนเรือนหรือเดินทางไกล ก็เปิดทางเข้าผ่านมือถือได้ทั้ง iOS และ Android ไม่มีสะดุด",
    avatar: "⚡",
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label="เสียงจากสมาชิก YIMSIAM889" class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#f8dc9a] via-[#e9b949] to-[#a81f1a] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      เสียงจากสมาชิก <span class="text-[#e9b949]">YIMSIAM889</span>
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#e9b949] to-transparent"></div>
  </div>

  <div
    class="mx-auto mb-8 flex max-w-md items-center justify-center gap-5 rounded-2xl border border-[#e9b949]/25 bg-[#1e0a06]/92 px-6 py-4 shadow-[0_10px_30px_rgba(168,31,26,0.22)] backdrop-blur-xl">
    <div class="flex flex-col items-center">
      <span class="bg-gradient-to-b from-[#f8dc9a] to-[#9c724a] bg-clip-text text-4xl leading-none font-black text-transparent">{average}</span>
      <span class="mt-1 text-[10px] font-bold tracking-widest text-[#f2ddc4]/70 uppercase">คะแนนเฉลี่ย</span>
    </div>
    <div class="h-12 w-px bg-[#9c724a]/35"></div>
    <div class="flex flex-col gap-1.5">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#e9b949]" : "text-[#9c724a]/40"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#f2ddc4]/70">คะแนนเฉลี่ย {average} จาก 5 ดาว จากการใช้งานจริงของสมาชิก {reviews.length} ด้าน</span>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
    {
      reviews.map((review) => (
        <article class="group relative isolate flex flex-col gap-4 overflow-hidden rounded-2xl border border-[#e9b949]/25 bg-[#1e0a06]/92 p-6 text-left shadow-[0_10px_30px_rgba(168,31,26,0.22)] backdrop-blur-xl transition-all duration-300 hover:-translate-y-1 hover:border-[#e9b949]/50 hover:shadow-[0_15px_40px_rgba(233,185,73,0.3)]">
          <span class="absolute inset-y-0 left-0 -z-10 w-1 bg-gradient-to-b from-[#f8dc9a] to-[#9c724a] opacity-80 transition-opacity duration-300 group-hover:opacity-100" />
          <span class="pointer-events-none absolute -top-14 -right-14 -z-10 h-32 w-32 rounded-full bg-[#5e0f06]/50 blur-[50px] transition-all duration-300 group-hover:bg-[#a81f1a]/45" />

          <div class="flex items-center justify-between gap-3">
            <span class="inline-flex items-center gap-1.5 rounded-full border border-[#e9b949]/25 bg-[#140604] px-3 py-1 text-[10px] font-bold tracking-widest text-[#e9b949] uppercase">
              <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#a81f1a]" />
              {review.tag}
            </span>
            <span class="flex gap-0.5 text-sm">
              <span aria-hidden="true" class="flex gap-0.5">
                {Array.from({ length: 5 }).map((_, i) => (
                  <span class={i < review.stars ? "text-[#e9b949]" : "text-[#9c724a]/40"}>★</span>
                ))}
              </span>
              <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
            </span>
          </div>

          <p class="text-left text-base leading-relaxed text-[#f2ddc4]">{review.content}</p>

          <div class="mt-auto flex items-center gap-3 border-t border-[#9c724a]/35 pt-4">
            <span
              aria-hidden="true"
              class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#e9b949]/30 bg-gradient-to-br from-[#f8dc9a] via-[#e9b949] to-[#a81f1a] text-xl shadow-inner transition-transform duration-300 group-hover:scale-110">
              {review.avatar}
            </span>
            <span class="flex flex-col">
              <span class="text-sm font-black text-[#f2ddc4] transition-colors group-hover:text-[#f8dc9a]">{review.name}</span>
              <span class="text-[10px] font-bold tracking-wider text-[#f2ddc4]/70 uppercase">{review.role}</span>
            </span>
          </div>
        </article>
      ))
    }
  </div>
</section>
