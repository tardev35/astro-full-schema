---
import { Picture } from "astro:assets";
import BankStrip from "./BankStrip.astro";
import { BRAND_ADDRESS } from "../lib/brandProfile";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });
const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

const logoAlt =
  "โลโก้ OKHENG ตัวอักษร OK สีขาวบนกรอบมนสีแดงสด ถัดมาเป็นคำว่า Heng สีแดงและเลข 18 สีดำ ด้านซ้ายเป็นสัญลักษณ์เหรียญทองจีนสีแดงทอง";
---

<footer
  class="relative mt-16 w-full overflow-hidden rounded-t-[3rem] border-t border-[#ed0133]/45 bg-[#170206] pt-16 pb-8 font-sans text-[#f9dfe3] shadow-[0_-15px_40px_rgba(237,1,51,0.3)]">
  <div class="pointer-events-none absolute inset-x-0 -top-20 mx-auto h-[250px] w-full max-w-4xl rounded-full bg-[#ed0133]/25 blur-[100px]"></div>

  <div class="relative z-10 mx-auto w-full max-w-[1200px] px-6">
    <div class="mb-12 grid grid-cols-1 gap-12 md:grid-cols-12">
      <div class="flex flex-col gap-5 md:col-span-5">
        <a href="/" class="inline-block transition-transform duration-300 hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt={logoAlt}
                widths={[130, 260, 390]}
                sizes="130px"
                class="h-[65px] w-auto drop-shadow-[0_5px_15px_rgba(237,1,51,0.4)]"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <span class="bg-gradient-to-r from-[#ffdb7d] to-[#f0b429] bg-clip-text text-4xl font-black tracking-widest text-transparent">
                OK<span class="bg-gradient-to-r from-[#ff3d63] to-[#ed0133] bg-clip-text text-transparent">HENG</span>
              </span>
            )
          }
        </a>
        <p class="border-l-2 border-[#ed0133]/55 pl-4 text-sm leading-relaxed text-[#f9dfe3]/70">
          OKHENG รวมบาคาร่า คาสิโนสด และสล็อตลิขสิทธิ์จากหลายค่ายไว้ในยูสเดียว เชื่อมเกมด้วยระบบ API แท้ เครดิต โปร และประวัติรายการดูได้จากหน้าเมมเบอร์เดียวกัน พร้อมระบบฝากถอนออโต้ที่ทำรายการได้ตลอด 24 ชั่วโมง ใช้งานผ่านมือถือได้ตั้งแต่สมัครจนถึงเข้าโต๊ะ
        </p>
        <div class="mt-4 flex gap-3">
          <span class="rounded-full border border-[#1f5fd6]/45 bg-[#1f5fd6]/20 px-4 py-1 text-xs font-medium text-[#6fa8ff] backdrop-blur-sm">API แท้</span>
          <span class="rounded-full border border-[#f0b429]/35 bg-[#ed0133]/20 px-4 py-1 text-xs font-medium text-[#f0b429] backdrop-blur-sm">ออโต้ 24 ชม.</span>
        </div>
      </div>

      <nav class="flex flex-col gap-4 md:col-span-3 lg:pl-8">
        <p class="text-lg font-black tracking-widest text-[#ffdb7d] uppercase drop-shadow-sm">เมนูลัด</p>
        <div class="h-[1px] w-12 bg-[#ed0133]"></div>
        <ul class="flex flex-col gap-3 text-sm font-medium text-[#f9dfe3]/70">
          <li><a href="/" class="transition-colors hover:text-[#f0b429]">หน้าหลัก</a></li>
          <li><a href="/promotion" class="transition-colors hover:text-[#f0b429]">โปรโมชั่น</a></li>
          <li><a href="/register" class="transition-colors hover:text-[#f0b429]">สมัครสมาชิก</a></li>
          <li><a href="/login" class="transition-colors hover:text-[#f0b429]">เข้าสู่ระบบ</a></li>
          <li><a href="/ทางเข้า" class="transition-colors hover:text-[#f0b429]">ทางเข้า</a></li>
          <li><a href="/ทดลองเล่น" class="transition-colors hover:text-[#f0b429]">ทดลองเล่น</a></li>
          <li><a href="/about-us" class="transition-colors hover:text-[#f0b429]">เกี่ยวกับเรา</a></li>
          <li><a href="/contact-us" class="transition-colors hover:text-[#f0b429]">ติดต่อเรา</a></li>
        </ul>
      </nav>

      <div class="flex flex-col gap-5 md:col-span-4">
        <p class="text-lg font-black tracking-widest text-[#ffdb7d] uppercase drop-shadow-sm">ฝ่ายดูแลสมาชิก</p>
        <div class="h-[1px] w-12 bg-[#ed0133]"></div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] py-3.5 font-bold text-white shadow-[0_5px_15px_rgba(0,185,0,0.3)] transition-all hover:-translate-y-1 hover:shadow-[0_8px_20px_rgba(0,185,0,0.4)]">
          ติดต่อแอดมิน LINE
        </a>

        {
          BRAND_ADDRESS.lines.length > 0 && (
            <address aria-label={BRAND_ADDRESS.label} class="mt-2 rounded-xl border border-white/15 bg-black/20 p-4 text-xs leading-relaxed not-italic opacity-90">
              <p class="mb-2 flex items-center gap-2 text-[11px] font-bold tracking-wider uppercase opacity-80">
                <span aria-hidden="true" class="text-sm">📍</span>
                {BRAND_ADDRESS.label}
              </p>
              {BRAND_ADDRESS.lines.map((line) => (
                <span class="block">{line}</span>
              ))}
              {BRAND_ADDRESS.email && (
                <a href={`mailto:${BRAND_ADDRESS.email}`} class="mt-3 inline-flex items-center gap-2 font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                  <span aria-hidden="true" class="text-sm">✉️</span>
                  {BRAND_ADDRESS.email}
                </a>
              )}
            </address>
          )
        }

        <div class="mt-4 text-xs font-medium tracking-widest text-[#e0b6bd]/60 uppercase">ช่องทางฝากถอนที่รองรับ</div>
        <BankStrip size={30} />
      </div>
    </div>

    <div class="flex flex-col items-center justify-between border-t border-[#6b0d1e] pt-8 text-xs font-medium tracking-wide text-[#f9dfe3]/50 md:flex-row">
      <p>COPYRIGHT &copy; {new Date().getFullYear()} OKHENG. ALL RIGHTS RESERVED.</p>
      <div class="mt-4 flex gap-4 md:mt-0">
        <a href="/terms/" class="transition-colors hover:text-[#f0b429]">TERMS &amp; CONDITIONS</a>
        <a href="/privacy/" class="transition-colors hover:text-[#f0b429]">PRIVACY POLICY</a>
      </div>
    </div>
  </div>
</footer>
