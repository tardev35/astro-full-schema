---
const lottos = [
  { name: "หวยรัฐบาลไทย", close: "15:00 น.", reward: "บาทละ 900", icon: "🇹🇭" },
  { name: "หวยฮานอย", close: "18:00 น.", reward: "บาทละ 95", icon: "🇻🇳" },
  { name: "หวยลาวพัฒนา", close: "20:00 น.", reward: "บาทละ 95", icon: "🇱🇦" },
  { name: "หวยยี่กี 88 รอบ", close: "ทุก 15 นาที", reward: "บาทละ 95", icon: "⏱️" },
  { name: "หวยมาเลย์", close: "18:00 น.", reward: "บาทละ 95", icon: "🇲🇾" },
  { name: "หวยหุ้นไทย", close: "16:40 น.", reward: "บาทละ 95", icon: "📈" },
];
---

<div class="mx-auto w-full max-w-[1300px] px-4 py-6 font-sans sm:px-6 lg:px-8">
  <div class="mb-6 flex w-full flex-col items-center justify-center gap-2 text-center">
    <h2 class="bg-gradient-to-r from-yellow-300 to-yellow-600 bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase drop-shadow-sm">หวยออนไลน์ยอดฮิต</h2>
    <div class="mt-2 h-[2px] w-24 rounded-full bg-gradient-to-r from-transparent via-red-500 to-transparent"></div>
  </div>

  <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-6 lg:gap-4">
    {
      lottos.map((lotto) => (
        <div class="group relative flex cursor-pointer flex-col items-center justify-center overflow-hidden rounded-2xl border border-red-600/30 bg-[#2a0404] p-4 shadow-lg transition-all duration-300 hover:-translate-y-2 hover:border-yellow-500/50 hover:shadow-[0_10px_25px_rgba(251,191,36,0.2)]">
          <div class="mb-2 text-4xl drop-shadow-[0_0_10px_rgba(251,191,36,0.5)]">{lotto.icon}</div>
          <h3 class="text-center text-sm font-bold text-white group-hover:text-yellow-400">{lotto.name}</h3>
          <p class="mt-1 text-[10px] text-red-200">
            ปิดรับ: <span class="font-mono text-yellow-500">{lotto.close}</span>
          </p>
          <div class="mt-2 rounded-full border border-red-500/30 bg-red-900/50 px-3 py-1 text-[11px] font-bold text-yellow-400">{lotto.reward}</div>
        </div>
      ))
    }
  </div>
</div>
<style>
  .font-sans {
    font-family: "Kanit", sans-serif;
  }
</style>
