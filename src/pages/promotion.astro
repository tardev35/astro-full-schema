---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxCyberCut.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementCyber.astro";

import { Picture } from "astro:assets";

import pro1 from "../assets/slide1.jpg";
import pro2 from "../assets/slide2.jpg";
import pro3 from "../assets/slide3.jpg";
import pro4 from "../assets/slide4.jpg";
---

<MainLayout title="โปรโมชั่น MARANGS777" description="อัปเดต โปรโมชั่น MARANGS777">
  <Announcement />

  <ContentBox>
    <h1 class="mb-7 bg-gradient-to-b from-[#ffffff] to-[#920186] bg-clip-text text-3xl font-black text-transparent drop-shadow-[0_0_8px_rgba(157,78,221,0.3)]">โปรโมชั่น MARANGS777</h1>

    <div class="mx-auto grid w-full max-w-7xl grid-cols-1 gap-6 px-4 sm:grid-cols-2 lg:grid-cols-2 xl:grid-cols-2">
      <Picture
        src={pro1}
        alt="โปรโมชั่นวันเกิด รับทันที 1,000 บาท"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600, 800]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class="mx-auto h-auto w-full rounded-xl border border-[#9d4edd]/50 object-contain shadow-lg transition-transform duration-300 hover:-translate-y-1 hover:border-[#9d4edd] hover:shadow-[0_10px_20px_rgba(157,78,221,0.3)]"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />

      <Picture
        src={pro2}
        alt="โปรโมชั่นยอดฮิต ฝาก 50 รับ 100"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600, 800]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class="mx-auto h-auto w-full rounded-xl border border-[#10b981]/50 object-contain shadow-lg transition-transform duration-300 hover:-translate-y-1 hover:border-[#9d4edd] hover:shadow-[0_10px_20px_rgba(157,78,221,0.3)]"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />

      <Picture
        src={pro3}
        alt="แทงบาคาร่า 6 ไม้ ชนะติดกัน รับเงินทันที 1,000 บาท"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600, 800]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class="mx-auto h-auto w-full rounded-xl border border-[#10b981]/50 object-contain shadow-lg transition-transform duration-300 hover:-translate-y-1 hover:border-[#9d4edd] hover:shadow-[0_10px_20px_rgba(157,78,221,0.3)]"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />

      <Picture
        src={pro4}
        alt="ฝากแรกของวัน รับโบนัสฟรี 20%"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600, 800]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class="mx-auto h-auto w-full rounded-xl border border-[#10b981]/50 object-contain shadow-lg transition-transform duration-300 hover:-translate-y-1 hover:border-[#9d4edd] hover:shadow-[0_10px_20px_rgba(157,78,221,0.3)]"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />
    </div>
    <div class="mt-12 flex justify-center pb-4">
      <a
        href="/register"
        class="flex items-center justify-center rounded-lg bg-gradient-to-r from-red-700 to-red-900 px-10 py-3.5 text-lg font-black text-white shadow-[0_0_20px_rgba(185,28,28,0.6)] transition-transform hover:scale-105">
        รับโปรโมชั่นทันที
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <style>
    :global(.text-purple-gradient) {
      background: linear-gradient(to bottom, #d8b4fe 0%, #9d4edd 100%) !important;
      -webkit-background-clip: text !important;
      -webkit-text-fill-color: transparent !important;
    }
  </style>
</MainLayout>
