---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h2" } = Astro.props;
---

<section class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#6b2f0b] bg-[#241004] p-6 text-[#f8e3d2] shadow-[0_10px_30px_rgba(249,115,22,0.12)] transition-all duration-500 hover:border-[#f97316]/45 md:p-10">
    <div
      aria-hidden="true"
      class="pointer-events-none absolute top-0 left-1/2 -z-10 h-[2px] w-1/2 -translate-x-1/2 bg-gradient-to-r from-transparent via-[#f97316] to-transparent opacity-60 transition-opacity duration-500 group-hover:opacity-100">
    </div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#6b2f0b] pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#f97316] to-[#fbbf24] shadow-[0_0_10px_rgba(249,115,22,0.35)]" />
          <HeadingTag class="bg-gradient-to-r from-[#fb923c] via-[#ffeadb] to-[#fbbf24] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-2 lg:gap-10">
      <article
        class="relative flex gap-4 rounded-2xl border border-[#6b2f0b] bg-[#331608] p-6 text-left text-base leading-relaxed text-[#f8e3d2] transition-all duration-300 hover:-translate-y-2 hover:border-[#f97316]/45 hover:bg-[#4a2109] hover:shadow-[0_15px_40px_rgba(249,115,22,0.16)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#6b2f0b] bg-gradient-to-br from-[#fb923c] via-[#f97316] to-[#c2410c] text-2xl shadow-[0_5px_15px_rgba(249,115,22,0.20)]">
          📱
        </div>
        <slot name="left" />
      </article>

      <article
        class="relative flex gap-4 rounded-2xl border border-[#6b2f0b] bg-[#331608] p-6 text-left text-base leading-relaxed text-[#f8e3d2] transition-all duration-300 hover:-translate-y-2 hover:border-[#fbbf24]/45 hover:bg-[#4a2109] hover:shadow-[0_15px_40px_rgba(251,191,36,0.18)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#6b2f0b] bg-gradient-to-br from-[#fcd34d] via-[#fbbf24] to-[#b45309] text-2xl shadow-[0_5px_15px_rgba(251,191,36,0.20)]">
          ✅
        </div>
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
