---
const providers = [
  { name: "PG Slot", desc: "ค่ายสล็อตแตกง่าย แตกบ่อย ภาพชัด เมนูไม่ซับซ้อน หลายเกมออกแบบมาให้เล่นบนมือถือได้ลื่น", tag: "สายมือถือ", icon: "🎰" },
  { name: "Joker Gaming", desc: "วงล้อคลาสสิกที่คนไทยคุ้นมือ พร้อมเกมใหม่ที่ทยอยเปิดเพิ่มในระบบตามช่วงเวลา", tag: "คลาสสิก", icon: "🃏" },
  { name: "Jili", desc: "เกมจังหวะไว ฟีเจอร์โบนัสชัดเจน เหมาะกับคนที่ชอบสลับไปลองธีมใหม่บ่อย ๆ", tag: "ลองเกมใหม่", icon: "🎮" },
  { name: "SA Gaming", desc: "คาสิโนสดส่งตรงจากสตูดิโอ บาคาร่าเสมือนจริง เลือกโต๊ะจากหน้าเดียวได้เลย", tag: "บาคาร่าสด", icon: "🎴" },
  { name: "หวยออนไลน์", desc: "เลือกตลาดหวยได้จากยูสเดิม มีให้อัปเดตทุกงวด ตรวจรอบเปิด-ปิดก่อนทำรายการทุกครั้ง", tag: "อัปเดตทุกงวด", icon: "🔢" },
  { name: "กีฬาและแทงบอล", desc: "แทงบอลออนไลน์ในราคานับบอลที่ดีที่สุด ตามรายการแข่งขันที่เปิดให้บริการในช่วงนั้น", tag: "ราคานับบอล", icon: "⚽" },
  { name: "ฝากถอนออโต้", desc: "รองรับ True Wallet ทำรายการและดูสถานะของตัวเองได้จากหน้าเมมเบอร์ ไม่ต้องรอแจ้งสลิป", tag: "True Wallet", icon: "⏱️" },
];
---

<section aria-label="ค่ายเกมและบริการที่ PAYDAY24 รวมไว้ในยูสเดียว" class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#ffe680] via-[#fdc700] to-[#d99400] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      ค่ายเกมและบริการที่ <span class="text-[#fdc700]">PAYDAY24</span> รวมไว้ในยูสเดียว
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#fdc700] to-transparent"></div>
  </div>

  <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4 lg:gap-5 xl:grid-cols-7">
    {
      providers.map((provider) => (
        <a
          href="/register"
          class="group relative flex flex-col items-center justify-center overflow-hidden rounded-2xl border border-[#fdc700]/40 bg-[#1c0a30] p-5 shadow-[0_10px_30px_rgba(253,199,0,0.12)] transition-all duration-300 hover:-translate-y-2 hover:border-[#fdc700]/80 hover:bg-[#2c1247] hover:shadow-[0_15px_40px_rgba(253,199,0,0.24)]">
          <div class="pointer-events-none absolute inset-0 bg-[#a855f7]/8 opacity-0 transition-opacity duration-300 group-hover:opacity-100" />

          <div class="absolute top-2 right-2 z-10 rounded-full bg-gradient-to-r from-[#ffe680] via-[#fdc700] to-[#d99400] px-2 py-0.5 text-[9px] font-black tracking-wide whitespace-nowrap text-[#150726] shadow-sm transition-transform duration-300 group-hover:scale-110">
            {provider.tag}
          </div>

          <div aria-hidden="true" class="mb-3 text-4xl transition-transform duration-300 group-hover:scale-125 group-hover:rotate-3">
            {provider.icon}
          </div>
          <p class="text-center text-sm font-black text-[#ffe680] transition-colors group-hover:text-[#fdc700]">{provider.name}</p>
          <p class="mt-1 text-center text-[10px] text-[#c4b5e8]">{provider.desc}</p>

          <span class="relative z-10 mt-4 block w-full rounded-full border border-[#a86f00]/60 bg-[#2c1247] py-1.5 text-center text-[11px] font-bold text-[#ffe680] shadow-inner transition-colors duration-300 group-hover:border-transparent group-hover:bg-gradient-to-r group-hover:from-[#ffe680] group-hover:via-[#fdc700] group-hover:to-[#d99400] group-hover:text-[#150726]">
            สมัครเข้าเล่น
          </span>
        </a>
      ))
    }
  </div>
</section>
