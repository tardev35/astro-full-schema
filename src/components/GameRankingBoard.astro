---
import { Picture } from "astro:assets";
import img1 from "../assets/providers/game1.avif";
import img2 from "../assets/providers/game2.avif";
import img3 from "../assets/providers/game3.avif";
import img4 from "../assets/providers/game4.avif";
import img5 from "../assets/providers/game5.avif";
import img6 from "../assets/providers/game6.avif";

const games = [
  {
    rank: 1,
    name: "PG Soft",
    type: "ค่ายที่สมาชิก OSIRIS168 เปิดบ่อยที่สุด เกมลิขสิทธิ์แท้จากผู้พัฒนาโดยตรง ค่า RTP ตรงตามที่ค่ายตั้งไว้",
    menus: ["ลิขสิทธิ์แท้", "เล่นประจำ"],
    players: 5124,
    img: img4,
  },
  { rank: 2, name: "Pragmatic Play", type: "ค่ายใหญ่ระดับอินเตอร์ ฟีเจอร์แน่น จังหวะเกมนิ่ง เข้าเล่นเวลาไหนก็ยังลื่นไหลเหมือนเดิม", menus: ["ระดับอินเตอร์", "ฟีเจอร์แน่น"], players: 3842, img: img5 },
  { rank: 3, name: "JILI", type: "ค่ายที่มาแรงในฝั่งเอเชีย มีฟีเจอร์โบนัสให้ไล่เก็บแทบทุกช่วงเวลา เหมาะกับสายที่เล่นเป็นรอบสั้น", menus: ["ฟีเจอร์โบนัส", "มาแรง"], players: 3517, img: img2 },
  { rank: 4, name: "Joker", type: "วงล้อคลาสสิกที่คนไทยคุ้นมือที่สุด กติกาตรงไปตรงมา เข้าเล่นต่อจากยูสเดิมได้เลย", menus: ["คลาสสิก", "คุ้นมือ"], players: 2905, img: img6 },
  { rank: 5, name: "ค่ายใหม่ที่เพิ่งเข้าระบบปี 2026", type: "หมวดเกมเปิดใหม่สำหรับคนที่ชอบลองของใหม่ ใช้บัญชีเดิมเข้าเล่นได้โดยไม่ต้องเปิดยูสเพิ่ม", menus: ["ของใหม่", "หลายค่าย"], players: 2431, img: img3 },
  { rank: 6, name: "เกมที่เล่นค้างไว้และรายการโปรด", type: "กลับเข้าเกมที่เล่นค้างไว้ได้จากหน้าเมมเบอร์ ไม่ต้องไล่หาใหม่ทุกรอบที่ล็อกอิน", menus: ["เล่นประจำ", "รายการโปรด"], players: 2108, img: img1 },
];

const medal = (rank: number) => (rank === 1 ? "🥇" : rank === 2 ? "🥈" : rank === 3 ? "🥉" : null);
---

<section aria-label="ค่ายเกมลิขสิทธิ์แท้ที่สมาชิก OSIRIS168 เลือกเปิดเล่นบ่อย" class="mx-auto w-full max-w-[1300px] px-4 py-8 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <span aria-hidden="true" class="text-2xl">🏆</span>
    <p class="bg-gradient-to-r from-[#4ff0bb] via-[#f8ecc9] to-[#e8b52c] bg-clip-text text-2xl font-black tracking-widest text-transparent uppercase">
      ค่ายเกมลิขสิทธิ์แท้ที่สมาชิก OSIRIS168 เปิดเล่นบ่อยที่สุด
    </p>
    <p class="max-w-3xl text-base leading-relaxed text-[#dfeee6]">
      ทุกค่ายในตารางนี้อยู่หลังยูสเดียวกันและใช้เครดิตชุดเดียวกัน สลับจากค่ายที่คุ้นมือไปค่ายอื่นได้โดยไม่ต้องออกจากระบบ ลำดับความนิยมขยับตามคนที่เข้ามาใช้งานในแต่ละช่วง
      ไม่ได้แปลว่าค่ายไหนให้อัตราจ่ายดีกว่าค่ายไหน ทุกเกมทำงานตามค่า RTP ที่ค่ายตั้งไว้ เลือกจากสไตล์ที่ถนัดแล้วเข้าเล่นต่อได้เลย
    </p>
    <div class="mt-2 h-[3px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#e8b52c] to-transparent"></div>
  </div>

  <div class="flex flex-col gap-3">
    {
      games.map((g) => {
        const top = g.rank === 1;
        return (
          <article
            class={`group relative flex items-center gap-3 overflow-hidden rounded-2xl border p-3 transition-all duration-300 hover:-translate-y-0.5 sm:gap-5 sm:p-4 ${
              top
                ? "border-[#e8b52c]/60 bg-gradient-to-r from-[#123128] via-[#0f241d] to-[#123128] shadow-[0_15px_40px_rgba(232,181,44,0.26)]"
                : "border-[#064c39] bg-[#0f241d] shadow-[0_10px_30px_rgba(18,196,143,0.14)] hover:border-[#12c48f]/60 hover:shadow-[0_15px_40px_rgba(18,196,143,0.26)]"
            }`}>
            <div
              aria-hidden="true"
              class="pointer-events-none absolute top-1/2 -left-10 h-24 w-24 -translate-y-1/2 rounded-full bg-[#12c48f]/16 blur-[40px] transition-all duration-500 group-hover:bg-[#e8b52c]/22"
            />

            <div class="relative z-10 flex w-8 shrink-0 flex-col items-center justify-center sm:w-12">
              {medal(g.rank) ? (
                <span class="text-2xl sm:text-3xl">
                  <span aria-hidden="true">{medal(g.rank)}</span>
                  <span class="sr-only">อันดับ {g.rank}</span>
                </span>
              ) : (
                <span class="text-xl font-black text-[#4ff0bb] sm:text-2xl">#{g.rank}</span>
              )}
            </div>

            <div class={`relative z-10 h-14 w-14 shrink-0 overflow-hidden rounded-xl border sm:h-16 sm:w-16 ${top ? "border-[#e8b52c]/60" : "border-[#064c39]"}`}>
              <Picture
                src={g.img}
                alt={`ภาพหน้าปกเกมของค่าย ${g.name} บนกระดานค่ายเกมลิขสิทธิ์แท้ยอดนิยมของ OSIRIS168`}
                formats={["avif", "webp"]}
                fallbackFormat="webp"
                loading="lazy"
                fetchpriority="low"
                widths={[100, 200]}
                quality={60}
                sizes="(max-width: 640px) 56px, 64px"
                decoding="async"
                class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-110"
              />
            </div>

            <div class="relative z-10 min-w-0 flex-1">
              <div class="flex items-center gap-2">
                <p class="truncate text-base font-black text-[#f8ecc9] sm:text-lg">{g.name}</p>
                {top && (
                  <span class="hidden shrink-0 rounded-full border border-[#e8b52c]/50 bg-[#123128] px-2 py-0.5 text-[9px] font-black tracking-wider text-[#ffdd8a] sm:inline">ยอดนิยมสูงสุด</span>
                )}
              </div>
              <p class="truncate text-[11px] text-[#b9d6c9] sm:text-xs">{g.type}</p>

              <div class="mt-2 flex flex-wrap items-center gap-1.5">
                {g.menus.map((m) => (
                  <span class="rounded-full border border-[#064c39] bg-[#050d0b] px-2.5 py-0.5 text-[10px] font-bold text-[#b9d6c9]">{m}</span>
                ))}
              </div>
            </div>

            <div class="relative z-10 hidden shrink-0 flex-col items-end gap-1 sm:flex">
              <span class="flex items-center gap-1.5 text-[11px] text-[#b9d6c9]">
                <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#4ff0bb] shadow-[0_0_6px_rgba(79,240,187,0.7)]" />
                <span class="tabular-nums" data-players data-base={g.players}>
                  {g.players.toLocaleString("en-US")}
                </span>{" "}
                ออนไลน์
              </span>
              <a
                href="/register"
                class={`rounded-full px-4 py-1.5 text-xs font-black transition-transform hover:scale-105 ${
                  top
                    ? "bg-gradient-to-r from-[#ffdd8a] via-[#e8b52c] to-[#8a6314] text-[#0a1a15] shadow-[0_10px_30px_rgba(232,181,44,0.28)]"
                    : "border border-[#064c39] bg-[#050d0b] text-[#b9d6c9] hover:border-[#12c48f]/60 hover:bg-[#123128]"
                }`}>
                สมัครเข้าเล่น
              </a>
            </div>
          </article>
        );
      })
    }
  </div>
</section>

<script>
  import { startLiveCounters } from "../lib/liveCounter";

  startLiveCounters();
</script>
