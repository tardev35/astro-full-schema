---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement6.astro";
import { pageGraph } from "../lib/schema";

const pageTitle = "เกี่ยวกับเรา PIGAUTO สล็อตหมูเว็บตรง API แท้ ออโต้ 3 วิ ไม่มีขั้นต่ำ";

const pageHeading = "เกี่ยวกับเรา PIGAUTO สล็อตหมูเว็บตรงที่ต่อเกมผ่าน API แท้จากค่ายโดยตรง";

const pageDescription =
  "เกี่ยวกับเรา PIGAUTO สล็อตหมูเว็บตรงที่ต่อเกมผ่าน API แท้จากค่ายเกมโดยตรง ไม่ล็อกยูส ระบบออโต้ฝากถอน 3 วินาที รองรับทรูมันนี่วอเลท เริ่มที่ 1 บาท ไม่มีขั้นต่ำ";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox as="h1" title={pageHeading}>
    <p class="mb-4 text-left text-base leading-relaxed text-[#f7e4d4]">
      <strong class="text-[#ffe08a]">PIGAUTO</strong> เปิดตัวด้วยโจทย์ง่ายๆ ข้อเดียว คือทำให้ทุกอย่างที่คนเล่นต้องกดเอง เหลือเวลาไม่กี่วินาที
    </p>

    <p class="mb-4 text-left text-base leading-relaxed text-[#f7e4d4]">
      ชื่อเว็บบอกไว้ตรงๆ แล้วว่า AUTO ระบบสมัคร ฝาก และถอนจึงทำงานอัตโนมัติทั้งหมด ไม่มีขั้นตอนไหนที่ต้องรอคนมานั่งกดอนุมัติให้
    </p>

    <p class="text-left text-base leading-relaxed text-[#f7e4d4]">ส่วนคำว่าหมู มาจากความตั้งใจให้ใช้งานง่าย ไม่ได้มาจากโชคลาง</p>
  </ContentBox>

  <ContentBox as="h2" title="จุดเริ่มต้นของ PIGAUTO กับโจทย์ที่ตั้งไว้ตั้งแต่วันแรก">
    <p class="mb-4 text-left text-base leading-relaxed text-[#f7e4d4]">
      คนเล่นสล็อตทุกวันนี้เปิดเว็บจากมือถือเป็นหลัก เล่นสั้นลงแต่บ่อยขึ้น และเลิกอดทนกับเว็บที่ต้องกดหลายชั้นกว่าจะถึงหน้าเกม
    </p>

    <p class="mb-4 text-left text-base leading-relaxed text-[#f7e4d4]">
      โจทย์แรกจึงไม่ใช่การเพิ่มฟีเจอร์ แต่เป็นการตัดขั้นตอนที่ไม่จำเป็นออก ตั้งแต่สมัคร ฝากเงิน เข้าเกม ไปจนถึงตอนกดถอน
    </p>

    <p class="text-left text-base leading-relaxed text-[#f7e4d4]">เกมเยอะเป็นเรื่องพื้นฐานไปแล้ว ที่ยังต่างกันคือเข้าเกมง่ายแค่ไหน</p>
  </ContentBox>

  <ContentBox as="h2" title="เว็บตรง API แท้ หมายความว่าอย่างไรในทางปฏิบัติ">
    <p class="mb-4 text-left text-base leading-relaxed text-[#f7e4d4]">
      ทุกเกมในระบบเชื่อมกับค่ายผู้พัฒนาโดยตรงผ่าน API แท้ ไม่ได้ผ่านเอเย่นต์หรือระบบจำลองที่มาคั่นกลางอีกชั้น
    </p>

    <p class="mb-4 text-left text-base leading-relaxed text-[#f7e4d4]">
      ผลในทางปฏิบัติมีสองอย่าง อย่างแรกคือเกมเดินตามค่าที่ค่ายตั้งไว้จริง อย่างที่สองคือภาพและเสียงมาจากเซิร์ฟเวอร์ของค่ายเอง จึงลื่นเท่ากันทั้งบนมือถือและคอม
    </p>

    <p class="text-left text-base leading-relaxed text-[#f7e4d4]">เว็บตรงกับเว็บที่บอกว่าตรง ต่างกันตรงจุดที่ผู้เล่นมองไม่เห็นนี่เอง</p>
  </ContentBox>

  <ContentBox as="h2" title="ไม่ล็อกยูส กับเหตุผลที่โบนัสควรออกตามค่าของค่ายเกม">
    <p class="mb-4 text-left text-base leading-relaxed text-[#f7e4d4]">
      PIGAUTO ไม่มีนโยบายล็อกยูส และไม่มีปุ่มไหนในระบบที่ปรับเรทของผู้เล่นรายคนได้ เพราะค่าเหล่านั้นอยู่ฝั่งค่ายเกม ไม่ได้อยู่ฝั่งเว็บ
    </p>

    <p class="mb-4 text-left text-base leading-relaxed text-[#f7e4d4]">
      Big Win, Mega Win และฟรีสปินจึงออกตามค่าความผันผวนที่แต่ละค่ายประกาศไว้ ไม่มากกว่านั้นและไม่น้อยกว่านั้น
    </p>

    <p class="text-left text-base leading-relaxed text-[#f7e4d4]">สิ่งที่เว็บรับปากได้คือความสม่ำเสมอ ไม่ใช่ผลของรอบถัดไป</p>
  </ContentBox>

  <ContentBox as="h2" title="ระบบออโต้ 3 วินาที ที่ชื่อเว็บใช้เป็นคำมั่น">
    <p class="mb-4 text-left text-base leading-relaxed text-[#f7e4d4]">
      ฝากและถอนประมวลผลอัตโนมัติภายใน 3 วินาที ยอดเข้าทันที ไม่ต้องแคปสลิปส่งให้ใครดู และไม่ต้องรอคิวแอดมินตอนคนเล่นเยอะ
    </p>

    <p class="mb-4 text-left text-base leading-relaxed text-[#f7e4d4]">
      ระบบเปิดตลอด 24 ชั่วโมง ถอนตอนตีสามกับถอนตอนบ่ายสองใช้เวลาเท่ากัน เพราะไม่มีมนุษย์อยู่ในขั้นตอนนั้นตั้งแต่แรก
    </p>

    <p class="text-left text-base leading-relaxed text-[#f7e4d4]">ยอดใหญ่ก็ไม่ดองบิล สภาพคล่องเตรียมไว้รองรับอยู่แล้ว</p>
  </ContentBox>

  <ContentBox as="h2" title="รองรับทรูมันนี่วอเลท และไม่มีขั้นต่ำตั้งแต่ 1 บาท">
    <p class="mb-4 text-left text-base leading-relaxed text-[#f7e4d4]">
      ฝากได้ทั้งบัญชีธนาคารและทรูมันนี่วอเลท คนที่ไม่สะดวกผูกบัญชีธนาคารก็เติมจากแอปวอเลทเข้ามาได้ตรงๆ
    </p>

    <p class="mb-4 text-left text-base leading-relaxed text-[#f7e4d4]">
      ไม่มีขั้นต่ำทั้งฝากและถอน ระบบรับตั้งแต่ 1 บาท ทุนเท่าไรก็เริ่มได้ และจะถอนออกเท่าไรก็ไม่มียอดบังคับ
    </p>

    <p class="text-left text-base leading-relaxed text-[#f7e4d4]">ข้อนี้มีไว้ให้คนทุนน้อยได้เริ่มตามจังหวะของตัวเอง</p>
  </ContentBox>

  <ContentBox as="h2" title="ความปลอดภัยระดับเดียวกับแอปธนาคาร">
    <p class="mb-4 text-left text-base leading-relaxed text-[#f7e4d4]">
      ข้อมูลสมาชิกและบัญชีการเงินถูกเข้ารหัสด้วยมาตรฐานเดียวกับที่แอปธนาคารชั้นนำใช้ และแยกชั้นการเข้าถึงไว้หลายชั้น
    </p>

    <p class="mb-4 text-left text-base leading-relaxed text-[#f7e4d4]">
      ทีมงานที่ดูแลธุรกรรมเห็นเฉพาะข้อมูลเท่าที่จำเป็นกับงานตรงนั้น และไม่มีใครในระบบเห็นรหัสผ่านของผู้เล่น
    </p>

    <p class="text-left text-base leading-relaxed text-[#f7e4d4]">ส่วนที่เหลืออยู่ในมือคุณข้อเดียว อย่าบอกรหัสผ่านหรือ OTP ให้ใคร</p>
  </ContentBox>

  <ContentBox as="h2" title="ทีมงาน 24 ชั่วโมง กับงานที่ไม่ได้จบแค่ตอบแชท">
    <p class="mb-4 text-left text-base leading-relaxed text-[#f7e4d4]">
      ทีมซัพพอร์ตอยู่ตลอด 24 ชั่วโมง ทั้งพาสมาชิกใหม่ตั้งต้น แนะนำเกมที่เหมาะกับทุน และตามเรื่องธุรกรรมที่ค้างให้จนจบ
    </p>

    <p class="mb-4 text-left text-base leading-relaxed text-[#f7e4d4]">
      เคสที่ยากกว่านั้น เช่น บัคเกมหรือยอดไม่ปรับ ทีมงานส่งเรื่องเข้าระบบของค่ายเกมโดยตรง จึงได้คำตอบเร็วกว่าการรอผ่านคนกลาง
    </p>

    <p class="text-left text-base leading-relaxed text-[#f7e4d4]">เว็บที่คนกลับมาเล่นซ้ำ มักไม่ใช่เว็บที่พูดเก่งที่สุด แต่เป็นเว็บที่ไม่ทำให้เสียเวลา</p>
  </ContentBox>

  <Navfoot />
</MainLayout>
