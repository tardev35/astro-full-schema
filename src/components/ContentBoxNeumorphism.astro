---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-2xl";
---

<section class="relative z-10 my-6 flex w-full justify-center px-4 font-sans">
  <div
    class="w-full max-w-[1400px] rounded-[25px] border border-[#cfe9f4] bg-white p-8 text-left text-base leading-relaxed text-[#23323f] shadow-[8px_8px_18px_rgba(12,53,80,0.10),-6px_-6px_16px_#ffffff] md:p-10">
    {
      title && (
        <header class="mb-8 border-b border-[#cfe9f4] pb-5 text-center">
          <HeadingTag class={`${headingSize} leading-normal font-black tracking-wide text-[#0c3550]`}>{title}</HeadingTag>
          <span aria-hidden="true" class="mx-auto mt-4 block h-1.5 w-20 rounded-full bg-gradient-to-r from-[#4cc9f0] via-[#00a4d4] to-[#f7941d]" />
        </header>
      )
    }
    <slot />
  </div>
</section>
