---
const { titleleft, titlecenter, titleright } = Astro.props;
---

<section class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="group relative w-full overflow-hidden rounded-3xl border border-cyan-500/30 bg-[#050d16]/80 p-8 text-white/90 shadow-[0_10px_30px_rgba(0,0,0,0.8)] backdrop-blur-xl transition-all duration-500 hover:border-cyan-400/50 md:p-10">
    <div class="relative z-10 grid grid-cols-1 gap-8 md:grid-cols-3">
      <article class="flex flex-col gap-3 border-b border-cyan-900/50 pb-8 transition-all hover:-translate-y-1 md:border-r md:border-b-0 md:pr-8 md:pb-0">
        {
          titleleft && (
            <h3 class="flex items-center gap-2 text-lg font-black tracking-widest text-cyan-400 uppercase">
              <span class="text-2xl drop-shadow-[0_0_8px_rgba(6,182,212,0.8)]">🎯</span> {titleleft}
            </h3>
          )
        }
        <div class="text-sm leading-relaxed text-gray-400"><slot name="left" /></div>
      </article>

      <article class="flex flex-col gap-3 border-b border-cyan-900/50 pb-8 transition-all hover:-translate-y-1 md:border-r md:border-b-0 md:px-4 md:pb-0">
        {
          titlecenter && (
            <h3 class="flex items-center gap-2 text-lg font-black tracking-widest text-cyan-400 uppercase">
              <span class="text-2xl drop-shadow-[0_0_8px_rgba(6,182,212,0.8)]">⚡</span> {titlecenter}
            </h3>
          )
        }
        <div class="text-sm leading-relaxed text-gray-400"><slot name="center" /></div>
      </article>

      <article class="flex flex-col gap-3 transition-all hover:-translate-y-1 md:pl-8">
        {
          titleright && (
            <h3 class="flex items-center gap-2 text-lg font-black tracking-widest text-cyan-400 uppercase">
              <span class="text-2xl drop-shadow-[0_0_8px_rgba(6,182,212,0.8)]">🚀</span> {titleright}
            </h3>
          )
        }
        <div class="text-sm leading-relaxed text-gray-400"><slot name="right" /></div>
      </article>
    </div>
  </div>
</section>

<style>
  .font-sans {
    font-family: "Kanit", sans-serif;
  }
</style>
