---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import ContentBoxTwo from "../components/ContentBoxTwo.astro";
import ContentBoxSevenThree from "../components/ContentBoxSevenThree.astro";
import ContentBoxThreeColums from "../components/ContentBox3Three.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement4.astro";
import SmoothCarousel from "../components/SmoothCarousel.astro";
import ProviderGrid from "../components/ProviderGrid.astro";
import Faq from "../components/Faq2.astro";
import LatestWinners from "../components/LatestWinners.astro";

import { Picture } from "astro:assets";
import image1 from "../assets/pro1.webp";
//import image2 from "../assets/pro2.jpg";
import image3 from "../assets/slide4.jpg";
import banner1 from "../assets/banner1.webp";

const currentPath = Astro.url.pathname;
const homePage = Astro.url.origin;
const logoUrl = homePage + "/logo.webp";

const webPageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: "LOCKDOWN168 ยกระดับการเชื่อมต่อสู่ระบบคาสิโนออนไลน์ที่เสถียรที่สุด",
  description: "LOCKDOWN168 ทางเข้าหลัก สำรอง เข้าใช้งานได้จริง เชื่อมต่อสู่ระบบ คาสิโนออนไลน์ Full-Servic รวมเกมเดิมพันระดับพันล้าน อินเตอร์เฟซเพื่อการใช้งานบนมือถือ",
  url: currentPath,
};

const webSiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "LOCKDOWN168",
  alternateName: ["lockdown168", "lockdown168official", "lockdown168officials", "LOCKDOWN168"],
  url: "https://lockdown168officials.com/",
};

const orgSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "LOCKDOWN168",
  logo: logoUrl,
  url: homePage,
};

const allSchemas = [webPageSchema, orgSchema, webSiteSchema];
---

<MainLayout>
  <script type="application/ld+json" set:html={JSON.stringify(allSchemas)} />
  <Announcement />

  <ContentBox>
    <p>
      <h1 class="text-blue-gradient mb-2 text-2xl xl:text-4xl">LOCKDOWN168 ยกระดับการเชื่อมต่อสู่ระบบคาสิโนออนไลน์ที่เสถียรที่สุด</h1>
      ยินดีต้อนรับสู่ <strong class="text-lime-400">LOCKDOWN168</strong> ที่สุดแห่งนวัตกรรมการเชื่อมต่อ เข้ากับ ระบบคาสิโนที่เสถียรและไร้ขีดจำกัด เพื่อให้คุณเข้าใช้งานผ่าน ทางเข้าหลักและสำรอง ที่ได้รับการ
      อัปเดตใหม่ล่าสุด ได้ทันทีโดยไม่มีคำว่าสะดุด เราพร้อมมอบประสบการณ์แบบ Full-Service ที่ มัดรวมค่ายยักษ์ใหญ่ลิขสิทธิ์แท้ จากทั่วโลกมาให้คุณเลือกเล่นครบจบในที่เดียว พร้อมระบบจัดการธุรกรรมที่แม่นยำและ
      อินเตอร์เฟซบนมือถือ ที่ลื่นไหลที่สุด เพื่อให้มั่นใจว่าทุกการเดิมพันของคุณในปี 2026 จะเป็นไปอย่างรวดเร็วและต่อเนื่องที่สุดในทุกวินาที
    </p>

    <div class="mt-3.5 flex flex-wrap justify-center gap-4">
      <a
        href="/register"
        aria-label="สมัครสมาชิก"
        class="to-red to-red to-red flex items-center justify-center rounded-lg border border-gray-400 bg-gradient-to-b from-red-900 to-red-700 px-8 py-3 font-bold text-white transition-transform hover:scale-105">
        สมัครสมาชิก
      </a>

      <a
        href="/login"
        aria-label="เข้าเล่นเกม"
        class="flex items-center justify-center rounded-lg border border-yellow-600 bg-gradient-to-b from-yellow-200 to-yellow-500 px-8 py-3 font-extrabold text-black shadow-[0_0_15px_rgba(255,215,0,0.4)] transition-transform hover:scale-105">
        เข้าเล่นเกม
      </a>

      <a
        href="/line"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="ติดต่อเราผ่าน Line"
        class="flex items-center justify-center rounded-lg border border-green-300 bg-gradient-to-b from-green-400 to-green-700 px-8 py-3 font-bold text-white transition-transform hover:scale-105">
        ติดต่อเรา
      </a>
    </div>
  </ContentBox>
  <ProviderGrid />
  <ContentBoxTwo>
    <div slot="left">
      <h2 class="text-blue-gradient mb-4 text-2xl font-bold">ทางเข้าหลัก สำรอง Lockdown168: อัปเดตใหม่ล่าสุด เข้าใช้งานได้จริง 100%</h2>
      <p>
        <strong class="text-lime-400">LOCKDOWN168</strong> เราพัฒนาระบบตรวจสอบลิงก์อัจฉริยะ Real-time Link Monitoring ของเราที่ตรวจสอบสถานะการทำงานทุก 60 วินาที เพื่อรักษาความเสถียรของ ทางเข้าหลัก สำรอง
        ทั้งหมดได้รับการ อัปเดตใหม่ล่าสุด อยู่ตลอดเวลา ทีมวิศวกรของเราเฝ้าระวังสถานะเครือข่ายทุกนาทีเพื่อกำจัดปัญหาการเข้าถึงที่ล่าช้าหรือถูกปิดกั้น ส่งผลให้ทุกช่องทางที่ปรากฏบนหน้าเว็บไซต์นี้ เข้าใช้งานได้จริง
        100% ไม่ว่าคุณจะเชื่อมต่อผ่านอุปกรณ์หรือเครือข่ายใดก็ตาม
      </p>
    </div>
    <div slot="right">
      <h2 class="text-blue-gradient mb-4 text-2xl font-bold">คาสิโนออนไลน์ Full-Service บริการระดับมืออาชีพครบจบในที่เดียว</h2>
      <p>
        คาสิโนออนไลน์ Full-Service จะมอบประสบการณ์ที่ครอบคลุมทุกมิติการใช้งาน ไม่ว่าจะเป็นการจัดการบัญชีที่แม่นยำหรือ บริการระดับมืออาชีพ จากทีมซัพพอร์ตผู้เชี่ยวชาญที่พร้อมสแตนด์บายดูแลคุณตลอด 24
        ชั่วโมง ทุกความต้องการในการเดิมพันของคุณจึงถูกรวบรวมไว้ให้ <strong class="text-lime-400">LOCKDOWN 168</strong> ครบจบในที่เดียว เราจะเป็นมากกว่าแค่การเป็นผู้ให้บริการเกม เพื่อสร้างมาตรฐานความพึงพอใจที่ยั่งยืนที่สุดสำหรับสมาชิกของเรา
      </p>
    </div>
  </ContentBoxTwo>
  <ContentBox>
    <h2 class="text-blue-gradient mb-7 text-2xl font-semibold">LOCKDOWN 168 รวมเกมเดิมพันระดับพันล้าน มัดรวมทุกค่ายยักษ์ใหญ่ลิขสิทธิ์แท้ ไว้เพื่อคุณ</h2>
    <p>
      สำหรับการเลือกเกมบนคาสิโนออนไลน์สักเกม การที่สมาชิกมีตัวเลือกหลากหลายย่อมดีกว่า ไม่ว่าจะเป็น สล็อต บาคาร่า ยิงปลา กีฬา หวย <strong class="text-lime-400">LOCKDOWN 168</strong> เราเชื่อมต่อระบบโดยตรงผ่าน
      Official API กับ รวมเกมเดิมพันระดับพันล้าน จากทั่วทุกมุมโลกมาไว้ในแพลตฟอร์มเดียว โดยการ มัดรวมทุกค่าย ผู้พัฒนาซอฟต์แวร์ ยักษ์ใหญ่ลิขสิทธิ์แท้ เพื่อให้สมาชิกทุกท่าน ได้เล่นเกมที่มีอัตราการจ่ายรางวัล
      (RTP) ที่ได้มาตรฐานสากล ผ่านระบบเว็บตรงที่ไม่ผ่านเอเย่นต์ พร้อมอัปเดตเกมใหม่ล่าสุดเข้าสู่ระบบเพื่อให้คุณได้รับประสบการณ์ที่ล้ำหน้ากว่าใคร
    </p>
  </ContentBox>
  <SmoothCarousel />
  <LatestWinners />
  <ContentBox>
    <h2 class="text-blue-gradient mb-7 text-2xl font-semibold">ระบบฝาก ถอนออโต้ Lockdown168 รองรับทุกช่องทาง ทันใจใน 10 วินาที</h2>
    <p>
      หัวใจสำคัญของระบบการเงินในปี 2026 คือความรวดเร็วที่ปราศจากความผิดพลาด ระบบออโต้ของ <strong class="text-lime-400">Lockdown168</strong> ถูกปรับแต่งมาเพื่อประมวลผลธุรกรรมให้เสร็จสิ้นภายในเวลาไม่เกิน
      10 วินาที รองรับทุกสถาบันการเงินและวอลเล็ตยอดนิยมอย่างไร้ข้อจำกัด มั่นใจได้ในทุกยอดถอนด้วยสภาพคล่องที่มั่นคงและการตรวจสอบสถานะได้เองแบบ Real-time
    </p>
  </ContentBox>

  <ContentBoxSevenThree>
    <div slot="left">
      <div class="rounded-xl p-5">
        <Picture
          src={image3}
          alt="ทางเข้า Lockdown168 ล่าสุด"
          loading="lazy"
          fetchpriority="low"
          widths={[200, 400, 600, 800]}
          sizes="(max-width: 768px) 100vw, 33vw"
          class="mx-auto h-auto w-full max-w-[400px] object-contain shadow-xl"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
          fallbackFormat="webp"
        />
      </div>
    </div>
    <div slot="right">
      <h2 class="text-blue-gradient mb-7 text-2xl font-semibold">ประสบการณ์ Mobile-First 2026 อินเตอร์เฟซเพื่อการใช้งานบนมือถือที่สมบูรณ์ที่สุด</h2>
      <p class="mb-5">
        อินเตอร์เฟซของ <strong class="text-lime-400">Lockdown168</strong> ถูกรีดประสิทธิภาพให้ประมวลผลข้อมูลได้รวดเร็ว (Low Latency) แม้ในสภาวะอินเทอร์เน็ตที่จำกัด เพราะเราต้องมอมประสบการณ์ Mobile-First
        2026 ให้กลายเป็นมาตรฐานใหม่ที่เหนือกว่าทั่วไป หัวใจหลักคือการสร้างสรรค์ อินเตอร์เฟซ ที่มีความเรียบง่ายแต่แฝงด้วยเทคโนโลยีประมวลผลประสิทธิภาพสูง ซึ่งถูกเพื่อการใช้งานบนมือถือ โดยเฉพาะ เพื่อให้สมาชิกได้รับความคล่องตัวสูงสุด
        สามารถสลับเปลี่ยนค่ายเกมและเข้าถึงทุกฟีเจอร์สำคัญได้อย่างลื่นไหล รวดเร็ว
      </p>
    </div>
  </ContentBoxSevenThree>

  <Navfoot />
</MainLayout>
<style>
  .text-blue-gradient {
    background: linear-gradient(to bottom, #00b7ea 0%, #009ec3 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
</style>
