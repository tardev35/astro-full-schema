---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementCyber.astro";
import CtaRedirect from "../components/CtaRedirect.astro";
import { pageGraph } from "../lib/schema";

const pageDescription =
  "หน้าสมัครสมาชิก DOLLAR789 รวมปุ่มเปิดยูสใหม่ไว้จุดเดียว กดเพื่อไปยังหน้าสมัครของเว็บหลัก ทำผ่านมือถือได้ในไม่กี่ขั้นตอน แล้วใช้ยูสเดียวเล่นและฝากถอนออโต้";

const graph = pageGraph(Astro, {
  name: "สมัครสมาชิก DOLLAR789 คาสิโนสด บาคาร่า สล็อต",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "สมัครสมาชิก", path: "/register" },
  ],
});

const targetUrl = "https://yoalink.com/22hs";
---

<MainLayout title="สมัครสมาชิก DOLLAR789 | ปุ่มเปิดยูสใหม่ผ่านมือถือ รับโปรสมาชิกใหม่" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="สมัครสมาชิก DOLLAR789" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label="สมัครสมาชิก DOLLAR789"
        class="group relative mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#a3610c]/60 bg-gradient-to-b from-[#ffd75e] to-[#f5c542] px-6 py-4 text-xl font-bold tracking-wide text-[#0b011b] shadow-[0_10px_30px_rgba(245,197,66,0.20)] transition-all duration-300 hover:scale-105 hover:border-[#a855f7]/70 hover:shadow-[0_15px_40px_rgba(168,85,247,0.24)]">
        สมัครสมาชิก DOLLAR789
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="สมัครสมาชิก" />
</MainLayout>
