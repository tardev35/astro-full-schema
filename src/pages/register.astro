---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";
import CtaRedirect from "../components/CtaRedirect.astro";
import { pageGraph } from "../lib/schema";

const pageDescription =
  "หน้าสมัครสมาชิก ONEHENG89 รวมปุ่มเปิดบัญชีใหม่ไว้จุดเดียว กดแล้วไปยังหน้าสมัครของเว็บหลัก ใช้มือถือได้ในไม่กี่ขั้นตอน แล้วใช้บัญชีเดียวเลือกเกมและฝากถอนออโต้";

const graph = pageGraph(Astro, {
  name: "สมัครสมาชิก ONEHENG89 เว็บสล็อตลิขสิทธิ์แท้",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "สมัครสมาชิก", path: "/register" },
  ],
});

const targetUrl = "https://yoalink.com/22hs";
---

<MainLayout title="สมัครสมาชิก ONEHENG89 | ปุ่มเปิดบัญชีเว็บสล็อตผ่านมือถือ" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="สมัครสมาชิก ONEHENG89" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label="สมัครสมาชิก ONEHENG89"
        class="group relative mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#0f7a38]/60 bg-gradient-to-b from-[#16a34a] to-[#0f7a38] px-6 py-4 text-xl font-bold tracking-wide text-white shadow-[0_10px_30px_rgba(22,163,74,0.20)] transition-all duration-300 hover:scale-105 hover:border-[#0b3fb8]/70 hover:shadow-[0_15px_40px_rgba(11,63,184,0.24)]">
        สมัครสมาชิก ONEHENG89
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="สมัครสมาชิก" />
</MainLayout>
