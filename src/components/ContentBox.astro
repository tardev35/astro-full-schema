---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-[24px] border border-[#f1d9c4] bg-white p-8 pt-10 text-left text-base leading-relaxed text-[#2b2622] shadow-[0_10px_30px_rgba(31,22,17,0.08)] transition-shadow duration-500 hover:border-[#f0a868] hover:shadow-[0_16px_40px_rgba(244,123,32,0.18)] md:p-10 md:pt-12">
    <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-2 bg-[repeating-linear-gradient(135deg,#1f1611_0_10px,#f47b20_10px_22px)]"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-16 -bottom-16 -z-10 h-44 w-44 rounded-full bg-[#ffa94d]/15 blur-[50px] transition-colors duration-500 group-hover:bg-[#5aa9ff]/15"></div>

    {
      title && (
        <header class="mb-6 border-l-4 border-[#f47b20] pl-4">
          <HeadingTag class="text-2xl leading-normal font-black text-[#1f1611]">{title}</HeadingTag>
          <span aria-hidden="true" class="mt-2 block h-1 w-16 rounded-full bg-gradient-to-r from-[#f47b20] to-[#ffc94a]" />
        </header>
      )
    }
    <slot />
  </div>
</section>
