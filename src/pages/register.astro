---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement6.astro";
import CtaRedirect from "../components/CtaRedirect.astro";
import { pageGraph } from "../lib/schema";

const pageTitle = "สมัครสมาชิก TGA99 | เปิดยูสใหม่ สล็อต ฝากถอนออโต้ เริ่ม 20 บาท";

const pageDescription =
  "หน้าสมัครสมาชิก TGA99 มีปุ่มเดียวสำหรับกดเปิดยูสใหม่ กรอกข้อมูลไม่กี่ขั้นตอนบนมือถือ ฝากขั้นต่ำ 20 บาท ฝากถอนออโต้ทำเองได้ แล้วเริ่มเล่นสล็อตหลายค่ายได้ทันที";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "สมัครสมาชิก", path: "/register" },
  ],
});

const targetUrl = "https://yoalink.com/22hs";
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="สมัครสมาชิก TGA99" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label="สมัครสมาชิก TGA99"
        class="group relative mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-full border border-[#ffe08a]/60 bg-gradient-to-b from-[#ffe08a] via-[#f5c542] to-[#b07d12] px-6 py-4 text-xl font-black tracking-wide text-[#3a0535] shadow-[0_0_12px_rgba(245,197,66,0.35)] transition-all duration-300 hover:scale-105 hover:brightness-110 hover:shadow-[0_15px_40px_rgba(245,197,66,0.45)]">
        สมัครสมาชิก TGA99
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="สมัครสมาชิก" />
</MainLayout>
