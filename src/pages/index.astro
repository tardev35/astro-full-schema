---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/Announcement2.astro";
import ContentBox from "../components/ContentBox.astro";
import ContentBoxPremium from "../components/ContentBoxPremium.astro";
import ContentBoxSpecial from "../components/ContentBoxSpecial.astro";
import ContentBoxFloatingBadge from "../components/ContentBoxFloatingBadge.astro";
import ContentBoxTwoPremium from "../components/ContentBoxTwoPremium.astro";
import ContentBoxTwoFloatingBadge from "../components/ContentBoxTwoFloatingBadge.astro";
import ContentBoxSevenThreePremium from "../components/ContentBoxSevenThreePremium.astro";
import ContentBoxSevenThreeFloatingBadge from "../components/ContentBoxSevenThreeFloatingBadge.astro";
import FeatureHighlights from "../components/FeatureHighlights.astro";
import ProviderGrid from "../components/ProviderGrid.astro";
import GameRankingBoard from "../components/GameRankingBoard.astro";
import SmoothCarousel from "../components/SmoothCarousel.astro";
import LatestWinners4 from "../components/LatestWinners4.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import ReviewCardSumo2 from "../components/ReviewCardSumo2.astro";
import Faq from "../components/Faq.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import imgAllCategories from "../assets/slide2.png";
import imgSlotGames from "../assets/slide4.png";

const pageTitle = "AMD365 เว็บสล็อตครบทุกค่าย รวมคาสิโน กีฬา หวย ระบบออโต้โอนไว";

const pageDescription = "AMD365 รวมสล็อต คาสิโนสด กีฬา หวย และเกมออนไลน์ไว้ในบัญชีเดียว ฝากถอนออโต้โอนไว มีทดลองเล่น โปรโมชั่นสมาชิก รองรับมือถือ คอม และแท็บเล็ต";

const announcement =
  "AMD365 รวมสล็อต คาสิโนสด กีฬา eSports และหวยออนไลน์ไว้ในบัญชีสมาชิกเดียว เปลี่ยนหมวดเกมได้โดยไม่ต้องสมัครยูสใหม่ • ระบบฝากถอนออโต้เชื่อมอยู่กับหน้าเมมเบอร์ ตรวจยอดเครดิตและสถานะรายการได้เองทุกครั้ง • หมวดสล็อตรวมเกมจาก PG Slot, Pragmatic Play, Joker และค่ายอื่น ๆ ที่เปิดอยู่ในระบบ • คาสิโนสดมีบาคาร่า รูเล็ต ไฮโล แบล็กแจ็ก เลือกโต๊ะจากหน้าเดียวได้เลย • หมวดกีฬาไม่ได้มีแค่ฟุตบอล ยังมีบาสเกตบอล เทนนิส มวย และ eSports ตามรายการที่เปิดให้บริการ • หวยออนไลน์เลือกตลาดได้ตามรอบที่ระบบกำหนด ตรวจเวลาเปิด-ปิดของแต่ละตลาดก่อนทำรายการ • เกมที่รองรับ DEMO ลองดูฟีเจอร์และจังหวะเกมก่อนใช้เครดิตจริงได้";

const allCategoriesAlt =
  "ภาพโปรโมชั่น AMD365 โลโก้ AMD365 ขนาดใหญ่ พร้อมข้อความ เว็บสล็อตครบทุกค่าย รวมคาสิโน กีฬา หวย ระบบออโต้โอนไว และไอคอนสี่หมวด SLOT CASINO SPORTS LOTTERY โดยมีพรีเซนเตอร์หญิงยื่นมือออกมาด้านข้าง";

const slotGamesAlt =
  "ภาพโปรโมชั่น AMD365 ข้อความ สล็อตแตกง่าย ปั่นง่ายแตกไว ทุนหลักสิบแตกหลักแสน มีมาสคอตซูเปอร์ฮีโร่และตัวละครจากเกมสล็อต พร้อมหน้าจอมือถือแสดงยอด TotalWin 137,900.00 บนฉากหลังสีดำทอง";

const providerPoints = [
  {
    icon: "📱",
    title: "PG Slot เหมาะกับสายมือถือและเกมเข้าใจง่าย",
    description:
      "เกมจาก PG Slot มีจุดเด่นด้านภาพและรูปแบบการเล่นที่เรียนรู้ไม่ยาก หลายเกมถูกออกแบบให้เหมาะกับหน้าจอมือถือ จึงเหมาะกับสมาชิก AMD365 ที่ชอบเข้าเกมไวและต้องการเมนูไม่ซับซ้อน ทั้งสายเกมธีมเอเชีย เกมโบนัส หรือเกมที่มีฟีเจอร์พิเศษให้ลุ้นระหว่างทาง",
    accent: "gold" as const,
  },
  {
    icon: "🎁",
    title: "Pragmatic Play เหมาะกับสายโบนัสและฟรีสปิน",
    description:
      "Pragmatic Play เป็นอีกค่ายที่มีเกมสล็อตหลายแนว โดยเฉพาะกลุ่มเกมที่มีฟรีสปิน ตัวคูณ และรอบโบนัสชัดเจน คนที่ชอบเกมซึ่งมีจังหวะเปลี่ยนระหว่างเกมหลักกับโบนัสจะมีตัวเลือกค่อนข้างหลากหลาย และสามารถเปลี่ยนไปลองเกมอื่นใน AMD365 ได้ตามความชอบ",
    accent: "platinum" as const,
  },
  {
    icon: "🃏",
    title: "Joker และค่ายอื่น ๆ เพิ่มทางเลือกให้สายชอบลองเกมใหม่",
    description:
      "สำหรับคนที่ไม่ชอบอยู่กับเกมเดิมนาน ๆ หมวดสล็อต AMD365 ยังมีเกมจาก Joker และผู้ให้บริการอื่น ๆ ให้สลับเล่นได้หลายรูปแบบ จุดสำคัญคือไม่จำเป็นต้องเลือกจากชื่อค่ายอย่างเดียว สามารถดูธีม ฟีเจอร์ และรูปแบบโบนัสก่อนตัดสินใจได้เช่นกัน",
    accent: "gold" as const,
  },
];

const faqs = [
  {
    q: "AMD365 มีเกมสล็อตและคาสิโนในบัญชีเดียวกันไหม",
    a: "มีครับ AMD365 รวมสล็อต คาสิโนสด กีฬา หวย และหมวดเกมอื่น ๆ ไว้ภายใต้ระบบสมาชิกเดียว ทำให้สามารถเปลี่ยนหมวดโดยยังใช้บัญชีเดิมได้",
  },
  {
    q: "AMD365 ทดลองเล่นสล็อตฟรีก่อนสมัครได้ไหม",
    a: "AMD365 มีเกมที่รองรับโหมดทดลองเล่น ผู้ใช้สามารถดูรูปแบบเกมและฟีเจอร์ก่อนเลือกเล่นจริงได้ ทั้งนี้โหมด DEMO ขึ้นอยู่กับเกมและผู้ให้บริการแต่ละราย",
  },
  {
    q: "AMD365 รองรับ iPhone และ Android หรือไม่",
    a: "รองรับการใช้งานผ่านมือถือทั้ง iPhone และ Android รวมถึงแท็บเล็ตและคอมพิวเตอร์ โดยสามารถเข้าใช้งานผ่านเว็บเบราว์เซอร์ที่รองรับระบบ",
  },
  {
    q: "ระบบฝากถอนออโต้ AMD365 ใช้งานอย่างไร",
    a: "สมาชิกเข้าสู่หน้าเมมเบอร์ของ AMD365 เลือกเมนูฝากหรือถอน จากนั้นทำรายการตามช่องทางที่ระบบเปิดให้บริการ พร้อมตรวจสอบเครดิตและสถานะรายการจากบัญชีของตัวเอง",
  },
  {
    q: "AMD365 มีทั้งกีฬาและหวยออนไลน์หรือไม่",
    a: "มีครับ AMD365 มีทั้งหมวดกีฬา eSports และหวยออนไลน์ควบคู่กับสล็อตและคาสิโน โดยรายการที่เปิดให้บริการสามารถเปลี่ยนแปลงตามช่วงเวลาและตารางของแต่ละหมวดได้",
  },
];

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement message={announcement} />

  <ContentBoxPremium as="h1" title="AMD365 เว็บเกมออนไลน์ครบทุกความสนุก สล็อต คาสิโน กีฬา หวย ในบัญชีเดียว">
    <p class="text-left text-base leading-relaxed">
      AMD365 ออกแบบมาให้คนที่ชอบความสนุกหลายแบบเลือกได้จากบัญชีเดียว ไม่ว่าจะเป็นเกมสล็อต คาสิโนสด กีฬา eSports หรือหวยออนไลน์ ไม่ต้องเปลี่ยนเว็บตามประเภทเกมที่อยากเล่น ระบบสมาชิกเชื่อมเมนูเกม เครดิต
      โปรโมชั่น และฝากถอนออโต้ไว้ด้วยกัน ทำให้เวลาอยากเปลี่ยนจากสล็อตไปดูบอล หรือกลับมาลองเกมใหม่ ก็จัดการข้อมูลบัญชีจากหน้าเมมเบอร์เดียว
    </p>
  </ContentBoxPremium>

  <ContentBoxSevenThreePremium as="h2" title="AMD365 รวมสล็อต คาสิโน กีฬา และหวยไว้ด้วยกันสะดวกยังไง">
    <Picture
      slot="left"
      src={imgAllCategories}
      alt={allCategoriesAlt}
      loading="lazy"
      fetchpriority="low"
      widths={[240, 346, 480, 692]}
      sizes="(max-width: 767px) calc(100vw - 96px), 346px"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={70}
      class="mx-auto h-auto w-full rounded-2xl border border-[#fec93a]/45 shadow-[0_10px_30px_rgba(254,201,58,0.20)]"
    />

    <div slot="right" class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed">
        AMD365 รวมหมวดความบันเทิงหลักไว้ในระบบเดียว ตั้งแต่เกมสล็อต คาสิโนสด กีฬา eSports ไปจนถึงหวยออนไลน์ สมาชิกจึงสามารถเลือกเกมตามอารมณ์ในแต่ละวันได้โดยไม่ต้องสมัครบัญชีใหม่ทุกครั้ง
        วันนี้อยากหมุนสล็อต พรุ่งนี้อยากเช็กคู่บอล หรืออยากเปลี่ยนบรรยากาศไปบาคาร่า ก็เลือกจากบัญชีเดิมได้เลย
      </p>

      <p class="text-left text-base leading-relaxed">
        ข้อดีของการรวมหลายหมวดไม่ได้อยู่แค่คำว่า “ครบ” แต่คือการจัดการที่ต่อเนื่องกว่า เครดิต ประวัติรายการ โปรโมชั่น และข้อมูลสมาชิกยังอยู่ภายใต้บัญชี AMD365 เดิม
        ทำให้การเปลี่ยนหมวดเป็นเรื่องของการเลือกเกม ไม่ใช่การเริ่มต้นระบบใหม่ตั้งแต่ศูนย์ทุกครั้ง
      </p>
    </div>
  </ContentBoxSevenThreePremium>

  <ContentBoxSevenThreeFloatingBadge as="h2" title="สล็อต AMD365 มีเกมและค่ายแบบไหนให้เลือก">
    <Picture
      slot="left"
      src={imgSlotGames}
      alt={slotGamesAlt}
      loading="lazy"
      fetchpriority="low"
      widths={[240, 352, 480, 704]}
      sizes="(max-width: 767px) calc(100vw - 96px), 352px"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={70}
      class="mx-auto h-auto w-full rounded-2xl border border-[#fec93a]/45 shadow-[0_10px_30px_rgba(254,201,58,0.20)]"
    />

    <div slot="right" class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed">
        หมวดสล็อตของ AMD365 รวบรวมเกมจากผู้ให้บริการหลายค่าย มีทั้งเกมยอดนิยม เกมใหม่ สล็อตฟรีสปิน เกมที่เน้นตัวคูณ และเกมที่ออกแบบมาสำหรับการเล่นบนมือถือ
        จากข้อมูลหน้าเว็บสามารถพบค่ายที่นักเล่นสล็อตคุ้นชื่อ เช่น PG Slot, Pragmatic Play, Joker และผู้ให้บริการอื่น ๆ ที่เปิดอยู่ในระบบ
      </p>

      <p class="text-left text-base leading-relaxed">
        แต่ละค่ายมีสไตล์ต่างกันอย่างชัดเจน บางค่ายภาพสวยและเล่นง่าย บางค่ายเด่นเรื่องโบนัส บางเกมจังหวะเร็วเหมาะกับคนชอบเปลี่ยนเกมบ่อย AMD365 จึงไม่ได้บังคับให้คนเล่นวิ่งตามคำว่าเกมฮิตเพียงอย่างเดียว
        เพราะเกมที่สนุกที่สุดก็ควรเป็นเกมที่เข้ากับสไตล์ของคนเล่นด้วย
      </p>

      <FeatureHighlights items={providerPoints} />
    </div>
  </ContentBoxSevenThreeFloatingBadge>

  <ProviderGrid />

  <ContentBoxFloatingBadge as="h2" title="คาสิโนสด AMD365 ให้บรรยากาศเกมโต๊ะแบบไหน">
    <p class="mb-4 text-left text-base leading-relaxed">
      AMD365 คาสิโนสด เหมาะกับคนที่อยากเปลี่ยนจากสล็อตมาสัมผัสเกมโต๊ะมากขึ้น โดยมีหมวดอย่างบาคาร่า รูเล็ต ไฮโล แบล็กแจ็ก และเกม Live อื่น ๆ ตามรายการที่เปิดให้บริการ
      สมาชิกสามารถเลือกโต๊ะและประเภทเกมจากหน้าเดียวโดยไม่ต้องเปลี่ยนบัญชีสมาชิก
    </p>

    <p class="text-left text-base leading-relaxed">
      ความสนุกของคาสิโนสดต่างจากสล็อตตรงที่มีจังหวะเกมและบรรยากาศโต๊ะเข้ามาเป็นส่วนหนึ่งของประสบการณ์ AMD365 จึงจัดหมวดให้ค้นหาเกมได้ง่ายทั้งบนมือถือและคอม คนที่มีเกมประจำก็เข้าโต๊ะเดิมได้เร็ว
    </p>
  </ContentBoxFloatingBadge>

  <GameRankingBoard />

  <ContentBox as="h2" title="กีฬา AMD365 มีอะไรให้เลือกนอกจากฟุตบอล">
    <p class="mb-4 text-left text-base leading-relaxed">
      หมวดกีฬาใน AMD365 ไม่ได้จำกัดอยู่เฉพาะฟุตบอล แต่สามารถพบตัวเลือกจากกีฬาหลายประเภทตามรายการแข่งขันที่เปิดให้บริการ เช่น บาสเกตบอล เทนนิส มวย และ eSports
      ทำให้สมาชิกที่ติดตามหลายชนิดกีฬาไม่จำเป็นต้องเปลี่ยนแพลตฟอร์มตามฤดูกาลแข่งขัน
    </p>

    <p class="text-left text-base leading-relaxed">
      การรวมหมวดกีฬาไว้กับเกมประเภทอื่นทำให้ AMD365 เหมาะกับคนที่มีความสนใจมากกว่าหนึ่งอย่าง ช่วงก่อนแข่งอาจเปิดดูคู่กีฬา พอจบเกมก็กลับไปเล่นสล็อตหรือคาสิโนได้จากบัญชีเดิม
      ระบบควรตามพฤติกรรมคนเล่นให้ทัน เพราะความสนุกไม่ได้มีตารางเวลาราชการ
    </p>
  </ContentBox>

  <ContentBoxSpecial as="h2" title="หวยออนไลน์ AMD365 มีตลาดไหนให้เลือกบ้าง">
    <div slot="left" class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed">
        AMD365 หวยออนไลน์ เปิดทางเลือกให้สมาชิกที่ชอบลุ้นตัวเลขสามารถเลือกตลาดหวยจากระบบเดียวกับเกมประเภทอื่น โดยรายการที่เปิดให้บริการอาจมีทั้งหวยรัฐบาลไทย หวยลาว หวยหุ้น หวยยี่กี และตลาดอื่น ๆ
        ตามรอบที่ระบบกำหนด
      </p>
    </div>

    <div slot="right" class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed">
        ข้อดีของการรวมหมวดหวยไว้ใน AMD365 คือสมาชิกสามารถดูรายการและจัดการบัญชีจากหน้าเมมเบอร์เดิม ไม่ต้องสร้างยูสอีกชุดเพียงเพราะเปลี่ยนจากสล็อตมาลุ้นเลข
        สิ่งสำคัญคือควรตรวจรอบเปิด-ปิดและเงื่อนไขของแต่ละตลาดก่อนทำรายการทุกครั้ง เพราะแต่ละประเภทมีช่วงเวลาไม่เหมือนกัน
      </p>
    </div>
  </ContentBoxSpecial>

  <ContentBoxTwoPremium as="h2" title="ระบบฝากถอนออโต้ AMD365 โอนไวและใช้งานจากหน้าเมมเบอร์ยังไง" titleleft="ทำรายการจบในหน้าเมมเบอร์เดียว" titleright="โอนไวและแจ้งสถานะได้ชัดเจน">
    <div slot="left" class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed">
