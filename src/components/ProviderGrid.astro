---
const providers = [
  { name: "PG Slot", desc: "ค่ายเกมลิขสิทธิ์แท้ที่รวมไว้ในบัญชีเดียว มีเกมหลายธีมให้เลือกเปิดจากหน้าเดียว", tag: "ค่ายดัง", icon: "🎰" },
  { name: "JILI", desc: "อีกค่ายดังที่อยู่ในระบบเดียวกัน สลับไปเลือกเกมต่อได้โดยไม่ต้องออกจากบัญชี", tag: "ค่ายดัง", icon: "🎮" },
  { name: "เกมสล็อตหลายสไตล์", desc: "มีทั้งเกมคลาสสิก เกมโบนัส ฟรีสปิน และเกมฟีเจอร์ใหม่ ดูรูปแบบก่อนเข้าเล่นได้", tag: "หมวดเกม", icon: "🕹️" },
  { name: "โบนัสและสิทธิ์สมาชิก", desc: "สิทธิ์โบนัสจัดไว้ในระบบสมาชิก เช็กเงื่อนไขที่เปิดอยู่ก่อนเลือกใช้ได้ทุกครั้ง", tag: "สิทธิ์สมาชิก", icon: "🎁" },
  { name: "ระบบสมาชิก", desc: "รวมเครดิต โบนัส และประวัติรายการไว้ในพื้นที่เดียว ตรวจย้อนหลังได้โดยไม่ต้องเปิดหลายหน้า", tag: "บัญชีเดียว", icon: "🧾" },
  { name: "ฝากถอนระบบออโต้", desc: "ส่งรายการฝากถอนและดูยอดคงเหลือผ่านหน้าบัญชีได้ตลอด 24 ชั่วโมง", tag: "ช่องทางหลัก", icon: "💳" },
  { name: "ใช้งานผ่านมือถือ", desc: "สมัคร เข้าสู่ระบบ และเลือกเกมผ่านเบราว์เซอร์มือถือได้โดยไม่ต้องพึ่งคอม", tag: "ทุกอุปกรณ์", icon: "📱" },
];
---

<section aria-label="ค่ายเกมและบริการที่ ONEHENG89 รวมไว้ในบัญชีเดียว" class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#062c85] via-[#0b3fb8] to-[#16a34a] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      ค่ายเกมและบริการที่ <span class="text-[#16a34a]">ONEHENG89</span> รวมไว้ในบัญชีเดียว
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#0b3fb8] to-transparent"></div>
  </div>

  <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4 lg:gap-5 xl:grid-cols-7">
    {
      providers.map((provider) => (
        <a
          href="/register"
          class="group relative flex flex-col items-center justify-center overflow-hidden rounded-2xl border border-[#c7dcfb] bg-white p-5 shadow-[0_10px_30px_rgba(11,63,184,0.10)] transition-all duration-300 hover:-translate-y-2 hover:border-[#0b3fb8]/45 hover:bg-[#f3f8ff] hover:shadow-[0_15px_40px_rgba(11,63,184,0.18)]">
          <div class="pointer-events-none absolute inset-0 bg-[#0b3fb8]/5 opacity-0 transition-opacity duration-300 group-hover:opacity-100" />

          <div class="absolute top-2 right-2 z-10 rounded-full bg-gradient-to-r from-[#0b3fb8] via-[#3b74e8] to-[#16a34a] px-2 py-0.5 text-[9px] font-black tracking-wide whitespace-nowrap text-white shadow-sm transition-transform duration-300 group-hover:scale-110">
            {provider.tag}
          </div>

          <div aria-hidden="true" class="mb-3 text-4xl transition-transform duration-300 group-hover:scale-125 group-hover:rotate-3">
            {provider.icon}
          </div>
          <p class="text-center text-sm font-black text-[#0a1c3a] transition-colors group-hover:text-[#0b3fb8]">{provider.name}</p>
          <p class="mt-1 text-center text-[10px] text-[#5b7099]">{provider.desc}</p>

          <span class="relative z-10 mt-4 block w-full rounded-full border border-[#c7dcfb] bg-[#e6efff] py-1.5 text-center text-[11px] font-bold text-[#062c85] shadow-inner transition-colors duration-300 group-hover:border-[#16a34a]/50 group-hover:bg-gradient-to-r group-hover:from-[#0b3fb8] group-hover:via-[#3b74e8] group-hover:to-[#16a34a] group-hover:text-white">
            เข้าดูหมวดนี้
          </span>
        </a>
      ))
    }
  </div>
</section>
