---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement3 from "../components/Announcement3.astro";
import ContentBox from "../components/ContentBox.astro";
import ContentBoxPremium from "../components/ContentBoxPremium.astro";
import ContentBoxNeumorphism from "../components/ContentBoxNeumorphism.astro";
import ContentBoxSpecial from "../components/ContentBoxSpecial.astro";
import ContentBoxTwoPremium from "../components/ContentBoxTwoPremium.astro";
import ContentBoxSevenThreePremium from "../components/ContentBoxSevenThreePremium.astro";
import ProviderGridPremium from "../components/ProviderGridPremium.astro";
import GameRankingBoard from "../components/GameRankingBoard.astro";
import LatestWinners4 from "../components/LatestWinners4.astro";
import SmoothCarousel from "../components/SmoothCarousel.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import Faq3 from "../components/Faq3.astro";
import ReviewCardSumo2 from "../components/ReviewCardSumo2.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import imgAutoSystem from "../assets/slide2.png";
import imgNoMinimum from "../assets/slide1.png";
import imgHighPayout from "../assets/banner2.png";

const pageTitle = "PIGAUTO ทางเข้าเว็บตรง สล็อตระบบออโต้ เร็ว นิ่ง ปลอดภัย";

const pageDescription = "PIGAUTO ทางเข้าเว็บตรง สัมผัสเว็บแรงระดับพรีเมียม ปลอดภัย สล็อตระบบออโต้เร็ว ธุรกรรมในเสี้ยววินาที อัตราจ่ายสูง ไม่บังคับขั้นต่ำ รองรับ วอเลท";

const announcement =
  "PIGAUTO ทางเข้าเว็บตรง เชื่อมต่อ API ตรงจากค่ายเกมแม่ ไร้ตัวกลาง • สล็อตระบบออโต้ ฝากถอนจบในเสี้ยววินาที ไม่ต้องแจ้งสลิปรอแอดมิน • คัดเฉพาะเกม High Performance ค่า RTP สูงตามมาตรฐานลิขสิทธิ์แท้ แตกง่าย อัตราจ่ายสูง • ไม่บังคับขั้นต่ำ จะเริ่มยอดเล็กเพื่อวอร์มระบบหรือเพิ่มน้ำหนักเมื่อจังหวะเข้ามือก็ทำได้ทันที • รองรับ วอเลท TrueMoney Wallet เติมเครดิตง่ายและปลอดภัย";

const autoSystemAlt =
  "ภาพโปรโมชั่น PIGAUTO พื้นหลังสีแดงลายกิ่งดอกไม้จีน มีโคมไฟจีนสีแดงและเหรียญทองลอยอยู่ ด้านบนซ้ายเป็นโลโก้หมูสีชมพูบนเฟืองสีเงินพร้อมตัวอักษร PIGAUTO ตรงกลางเป็นตัวอักษรขาวขนาดใหญ่ว่า แนะนำเพื่อน รับโบนัส ถัดลงมาเป็นกล่องสีแดงที่มีตัวเลขทองขนาดใหญ่ว่า 0.8% ใต้ลงมาเขียนว่า สร้างรายได้ 100,000/เดือน ด้านขวาเป็นพรีเซนเตอร์หญิงชุดสูทสีทองยืนอยู่หน้าฉากสีแดง";

const noMinimumAlt =
  "ภาพโปรโมชั่น PIGAUTO พื้นหลังสีแดงลายกิ่งดอกไม้จีน มีโคมไฟจีนสีแดงและเหรียญทองลอยอยู่รอบภาพ ด้านบนเป็นโลโก้หมูสีชมพูบนเฟืองสีเงินพร้อมตัวอักษร PIGAUTO ถัดลงมาเป็นตัวอักษรขาวขนาดใหญ่ว่า COMMISSION และบรรทัด คืนทุกยอดเล่นตลอดทั้งวัน ตรงกลางเป็นกล่องสีแดงที่มีตัวเลขทองขนาดใหญ่ว่า 0.3% ใต้ลงมาเขียนว่า เล่นถึง 50% ถอนได้เลย ตามด้วยข้อความ สามารถกดรับง่ายๆ ที่หน้าเว็บได้เลยค่ะ และ รับสิทธิ์ก่อน 23.59 น. ของทุกวัน แถบล่างสุดเป็นตัวอักษรทองว่า ยิ่งเล่นเยอะ ยิ่งได้เยอะ ด้านซ้ายบนเป็นพรีเซนเตอร์หญิงชุดสีแดงปักลายทอง";

const highPayoutAlt =
  "ภาพประกอบ PIGAUTO เป็นฉากศาลเจ้าจีนหลังคาโค้ง มีเสามังกรทองสองข้างและโคมไฟจีนสีแดงแขวนเรียงกัน พื้นหลังสีแดงเข้มมีเหรียญจีนสีทองลอยอยู่ ตรงกลางเป็นป้ายนีออนกรอบสี่เหลี่ยมเขียนว่า PIGAUTO ด้วยตัวอักษรทองและแดง ใต้ลงมาเป็นตัวอักษรทองขนาดใหญ่ว่า PIGAUTO และบรรทัด แตกง่าย อัตราจ่ายสูง ด้านขวาเป็นผู้หญิงชุดฮั่นฝูสีแดงปักลายทอง สวมปิ่นปักผมทอง กำลังถือถาดที่มีทองแท่งและเหรียญทองวางอยู่เต็ม";

const faqs = [
  {
    q: "PIGAUTO เป็นเว็บตรงหรือไม่",
    a: "เป็นเว็บตรง 100% ครับ เราเชื่อมต่อ API ตรงจากค่ายเกมแม่ (Direct Server) ไร้ตัวกลาง เปรียบเสมือนระบบส่งกำลังของ Supercar ที่ถ่ายทอดพลังงานได้เต็มที่ เสถียร และปลอดภัยสูงสุดครับ",
  },
  {
    q: "ระบบฝากถอนออโต้เร็วแค่ไหน",
    a: "เร็วทะลุขีดครับ ระบบธุรกรรมของเราใช้ AI ประมวลผล ฝากปุ๊บเครดิตเข้าเหมือน Turbo Boost ถอนปุ๊บเงินเด้งเข้าบัญชีในเสี้ยววินาที รองรับ High Traffic ได้สบายๆ ครับ",
  },
  {
    q: "เกมสล็อตแตกง่ายจริงไหม",
    a: "จริงครับ เราคัดเฉพาะเกม High Performance ที่มีค่า RTP สูงตามมาตรฐานลิขสิทธิ์แท้ เปรียบเหมือนรถเครื่องแรงจากโรงงานโดยไม่ต้องดัดแปลง ทำให้โบนัสแตกง่ายและยุติธรรมครับ",
  },
  {
    q: "มีขั้นต่ำในการฝากถอนหรือไม่",
    a: "เราไม่บังคับขั้นต่ำครับ ท่านสามารถควบคุมจังหวะการเล่นได้อิสระ จะเริ่มยอดเล็กหรือใหญ่ก็ทำได้ทันที ระบบออโต้พร้อมตอบสนองทุกคำสั่งครับ",
  },
  {
    q: "รองรับ TrueMoney Wallet ไหม?",
    a: "รองรับครับ PIGAUTO ติดตั้งระบบรองรับ วอเลท เปรียบเสมือนเทคโนโลยีช่วยเหลือที่ทำให้ชีวิตง่ายขึ้น ตัดความยุ่งยาก เติมเครดิตได้ลื่นไหลและปลอดภัยครับ",
  },
];

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement3 message={announcement} />

  <ContentBoxPremium as="h1" title="PIGAUTO ทางเข้าเว็บตรง สล็อตระบบออโต้ เร็ว นิ่ง ปลอดภัย">
    <p class="text-left text-base leading-relaxed text-[#f7e2e2]">
      <strong class="text-[#f5c542]">PIGAUTO</strong> ทางเข้าเว็บตรง สล็อตระบบออโต้เร็ว เสถียร นิ่ง ปลอดภัย ระบบฝากถอนอัตโนมัติ ใช้งานลื่น รองรับทุกอุปกรณ์ เหมาะกับคนที่ต้องการความเร็วและความมั่นใจในการเล่น
      PIGAUTO ให้บริการแค่เกมสล็อต PGSLOT และค่ายอื่นๆ ทางเข้าเว็บตรง ที่มอบสมรรถนะระดับท็อป ไม่เด้งไม่หลุด โหลดไวมาก การทำธุรกรรมที่เร็ว ไปจนถึงความเสถียรของระบบ ทุกส่วนทำงานประสานกันเหมือนกลไกที่จูนมาดี
      เหมาะกับผู้เล่นที่ต้องการความเร็วแบบควบคุมได้ ไม่เร่ง ไม่สะดุด และปลอดภัยในทุกขั้นตอน
    </p>
  </ContentBoxPremium>

  <div class="relative z-10 mx-auto mb-10 flex flex-nowrap justify-center gap-3 px-4 sm:gap-6">
    <a
      href="/register"
      class="group relative flex flex-1 items-center justify-center rounded-full bg-gradient-to-r from-[#ffe9a8] via-[#f5c542] to-[#a9761a] px-4 py-3 text-sm font-black whitespace-nowrap text-[#1c0403] shadow-[0_10px_30px_rgba(245,197,66,0.30)] transition-all duration-300 hover:-translate-y-1 hover:scale-105 hover:shadow-[0_15px_40px_rgba(245,197,66,0.42)] sm:flex-none sm:px-10 sm:py-3.5 sm:text-base">
      สมัครสมาชิก PIGAUTO
    </a>

    <a
      href="/login"
      class="group relative flex flex-1 items-center justify-center rounded-full border border-[#d81f26]/80 bg-[#2e0806]/85 px-4 py-3 text-sm font-black whitespace-nowrap text-[#ffe9a8] backdrop-blur-sm transition-all duration-300 hover:scale-105 hover:border-[#f5c542] hover:bg-[#4a0d0a]/85 hover:shadow-[0_15px_40px_rgba(216,31,38,0.42)] sm:flex-none sm:px-10 sm:py-3.5 sm:text-base">
      เข้าสู่ระบบ
    </a>
  </div>

  <ContentBox as="h2" title="PIGAUTO ทางเข้าเว็บตรง ไร้ตัวกลาง สัมผัสเว็บแรงระดับพรีเมียม">
    <p class="text-left text-base leading-relaxed text-[#f7e2e2]">
      PIGAUTO เรานิยามคำว่า ทางเข้าเว็บตรง ในแบบฉบับของ Supercar คือการเชื่อมต่อระบบ API ตรงจากค่ายเกมแม่ (Direct Server)
      เปรียบเสมือนระบบส่งกำลังที่ถ่ายทอดพลังงานจากเครื่องยนต์ลงสู่ล้อได้เต็มร้อยเปอร์เซ็นต์ โดยไม่มีการสูญเสียกำลัง ระหว่างทาง ไร้ตัวกลาง เอนเอเย่นต์หรือนายหน้าออกไป
      เพื่อให้คุณได้สัมผัสกับมาตรฐานลิขสิทธิ์แท้ที่ “เสถียร” และ “คลีน” ที่สุด ทุกการตอบสนองจึงแม่นยำ ฉับไว มั่นใจได้เลยว่าทุกยอดเงินและทุกการเดิมพันของคุณ อยู่ภายใต้การดูแลของระบบหลัก (Main Server)
      ที่มีความมั่นคงและปลอดภัยสูงสุด
    </p>
  </ContentBox>

  <ProviderGridPremium />

  <ContentBoxSevenThreePremium as="h2" title="สล็อตระบบออโต้ PIGAUTO เร็ว ทะลุขีด ธุรกรรมในเสี้ยววินาที">
    <Picture
      slot="left"
      src={imgAutoSystem}
      alt={autoSystemAlt}
      loading="lazy"
      fetchpriority="low"
      widths={[200, 400, 600]}
      sizes="(max-width: 768px) 100vw, 30vw"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      class="mx-auto h-auto w-full rounded-2xl border border-[#f5c542]/40 shadow-[0_10px_30px_rgba(216,31,38,0.30)]"
    />
    <p slot="right" class="text-left text-base leading-relaxed text-[#f7e2e2]">
      หัวใจสำคัญของรถแข่งคือเครื่องยนต์ หัวใจของ PIGAUTO ก็คือระบบธุรกรรมครับ เราภูมิใจนำเสนอ สล็อตระบบออโต้เร็ว ที่ถูกพัฒนาขึ้นมาใหม่ล่าสุด ลืมการแจ้งสลิปที่ต้องรอแอดมินตอบไปได้เลย เพราะที่นี่เราใช้
      AI ประมวลผลยอดเงินของคุณทันทีที่ทำรายการ ฝากเงินปุ๊บ เครดิตพุ่งเข้ากระเป๋าเกมปั๊บเหมือนกดปุ่ม Turbo Boost ถอนเงินปุ๊บ ยอดเด้งเข้าบัญชีทันที ไม่ต้องรอนานให้เครื่องเย็น
      ระบบของเราออกแบบมาเพื่อรองรับ High Traffic หรือช่วงเวลาที่มีคนใช้งานพร้อมกันเยอะๆ ได้สบายๆ โดยไม่มีอาการหน่วงหรือค้าง ให้คุณบริหารจัดการกระแสเงินสดได้อย่างอิสระและรวดเร็วที่สุด
    </p>
  </ContentBoxSevenThreePremium>

  <LatestWinners4 />

  <ContentBoxNeumorphism as="h2" title="เร่งรอบความรวย PIGAUTO แตกง่าย อัตราจ่ายสูง">
    <div>
      <p class="text-left text-base leading-relaxed text-[#f7e2e2]">
        เร่งรอบความรวย เฉพาะเกม “High Performance” ที่มีค่า RTP (Return to Player) สูงตามมาตรฐานลิขสิทธิ์แท้จากค่ายแม่ PIGAUTO เปรียบเสมือนรถสปอร์ตที่เครื่องแรงมาจากโรงงานโดยไม่ต้องดัดแปลง ทำให้
        เกมสล็อต แตกง่าย และเข้าสู่รอบโบนัสได้อย่างเป็นธรรมชาติและยุติธรรมที่สุด เราไม่ต้องการให้คุณเสียเวลาวนรถเล่นนานๆ เกมที่เราเลือกมาให้บริการจึงมีความผันผวนที่เหมาะสม บทจะจ่ายก็จ่ายหนัก จ่ายไว
        เหมือนรอบเครื่องที่พุ่งทะยาน ให้คุณทำกำไรได้ถึงใจในเวลาอันสั้น ใครที่ชอบความสะใจบนพื้นฐานของมาตรฐานสากล มาลองสัมผัสความแรงของโบนัสที่นี่
      </p>
      <Picture
        src={imgHighPayout}
        alt={highPayoutAlt}
        loading="lazy"
        fetchpriority="low"
        widths={[400, 640, 1024]}
        sizes="(max-width: 768px) 100vw, 672px"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
        class="mx-auto mt-6 h-auto w-full max-w-2xl rounded-2xl border border-[#f5c542]/40 shadow-[0_10px_30px_rgba(216,31,38,0.30)]"
      />
    </div>
  </ContentBoxNeumorphism>

  <GameRankingBoard />

  <LoginRtpSection />

  <ContentBoxTwoPremium as="h2" title="PIGAUTO เว็บสล็อต ที่เหมือนช่วงล่างรถยนต์ดีๆ นิ่ง ปลอดภัย">
    <p slot="left" class="text-left text-base leading-relaxed text-[#f7e2e2]">
      ความเร็วที่ปราศจากการควบคุม คือหายนะครับ ที่ PIGAUTO เราให้ความสำคัญกับความปลอดภัยพอๆ กับความเร็ว ระบบ Server ของเราเปรียบเสมือนช่วงล่างที่ถูกเซตมาอย่างดี ให้ความ นิ่ง ปลอดภัย
      เกาะถนนแน่นหนึบไม่ว่าคุณจะเล่นหนักแค่ไหน
    </p>
    <p slot="right" class="text-left text-base leading-relaxed text-[#f7e2e2]">
      เราใช้เทคโนโลยีเข้ารหัสข้อมูลขั้นสูง เพื่อปกป้องข้อมูลส่วนตัวและบัญชีธนาคารของคุณ เสมือนมีโครงสร้างนิรภัย (Roll Cage) ห่อหุ้มไว้ มั่นใจได้เลยว่าทุกการเชื่อมต่อของคุณจะราบรื่น ไม่มีคำว่าเว็บล่ม
      หรือเกมเด้งกลางคันให้เสียอารมณ์ เราเตรียมความพร้อมเพื่อให้คุณเหยียบมิดไมล์ (เล่นสล็อตแจ็คพอตแตกสิบล้าน) ได้อย่างสบายใจ
    </p>
  </ContentBoxTwoPremium>

  <ContentBoxSevenThreePremium as="h2" title="ไม่บังคับขั้นต่ำ ให้คุณควบคุมจังหวะการเล่นสล็อตได้อิสระ">
    <Picture
      slot="left"
      src={imgNoMinimum}
      alt={noMinimumAlt}
      loading="lazy"
      fetchpriority="low"
      widths={[200, 400, 600]}
      sizes="(max-width: 768px) 100vw, 30vw"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      class="mx-auto h-auto w-full rounded-2xl border border-[#f5c542]/40 shadow-[0_10px_30px_rgba(245,197,66,0.26)]"
    />
    <p slot="right" class="text-left text-base leading-relaxed text-[#f7e2e2]">
      PIGAUTO เปิดให้ฝากและถอนแบบไม่บังคับขั้นต่ำ คุณจะเริ่มจากยอดเล็กเพื่อวอร์มระบบ หรือเพิ่มน้ำหนักเมื่อจังหวะเข้ามือก็ทำได้ทันที ทุกการตัดสินใจอยู่ที่คุณ ไม่ต้องเร่ง ไม่ต้องฝืน
