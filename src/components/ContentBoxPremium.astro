---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#f1d9c4] bg-white p-8 pt-10 text-left text-base leading-relaxed text-[#2b2622] shadow-[0_10px_30px_rgba(31,22,17,0.08)] transition-[border-color,box-shadow] duration-500 hover:border-[#f0a868] hover:shadow-[0_15px_40px_rgba(244,123,32,0.18)] md:p-10 md:pt-12">
    <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-1.5 bg-[repeating-linear-gradient(135deg,#1f1611_0_10px,#f47b20_10px_22px)]"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#ffa94d]/20 blur-[55px]"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#5aa9ff]/15 blur-[55px]"></div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#f1d9c4] pb-4">
          <span aria-hidden="true" class="h-9 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffc94a] via-[#f47b20] to-[#c85a0c] shadow-[0_0_10px_rgba(244,123,32,0.35)]" />
          <HeadingTag class={`${headingSize} leading-normal font-black tracking-wide text-[#1f1611]`}>{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
