---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
---

<section class="my-4 flex w-full justify-center px-4 font-sans">
  <div
    class="w-full max-w-7xl rounded-xl border-2 border-red-900/50 bg-[#050000]/90 p-8 text-center text-white/90 shadow-[0_0_20px_rgba(185,28,28,0.15),inset_0_0_15px_rgba(185,28,28,0.05)] backdrop-blur-md transition-all duration-300 hover:border-red-500/50 hover:shadow-[0_0_30px_rgba(185,28,28,0.3)]">
    {
      title && (
        <header class="mb-8">
          <HeadingTag class="bg-gradient-to-b from-[#ffffff] to-[#b91c1c] bg-clip-text text-3xl font-black tracking-tight text-transparent drop-shadow-[0_0_8px_rgba(185,28,28,0.6)] md:text-4xl">
            {title}
          </HeadingTag>
        </header>
      )
    }
    <div class="text-lg leading-relaxed text-red-50/80">
      <slot />
    </div>
  </div>
</section>
<style>
  .font-sans {
    font-family: "Kanit", sans-serif;
  }
</style>
