---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxCyberCut.astro";
import ContentBoxTwo from "../components/ContentBoxTwoCyberCut.astro";
import ContentBoxSevenThree from "../components/ContentBoxSevenThreeCyberCut.astro";
import ContentBoxThreeColums from "../components/ContentBox3ThreeCyberCut.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementCyber.astro";
import SmoothCarousel from "../components/SmoothCarousel.astro";
import ProviderGrid from "../components/ProviderGrid.astro";
import LatestWinners from "../components/LatestWinnersCyber.astro";
import Faq from "../components/Faq4.astro";

const currentPath = Astro.url.pathname;
const homePage = Astro.url.origin;
const logoUrl = homePage + "/logo.webp";

const webPageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: "S8P888 ทางเข้าตรง เว็บเดียวครบจบ สล็อต บาคาร่า แทงบอล ระบบ API แท้",
  description: "ทางเข้า S8P888 เว็บตรงไม่ผ่านเอเย่นต์ อันดับ 1 ของไทย รวมสล็อต บาคาร่า แทงบอล ครบวงจร จบทุกการเดิมพัน ระบบ API แท้ ปลอดภัย สมัครสมาชิกรับโบนัส100%",
  url: currentPath,
};
const webSiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "S8P888",
  alternateName: ["s8p888", "s8p888h", "s8p888 auto"],
  url: "https://s8p888-homepage.com/",
};
const orgSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "S8P888",
  logo: logoUrl,
  url: homePage,
};
const allSchemas = [webPageSchema, orgSchema, webSiteSchema];

import { Picture } from "astro:assets";
import image1 from "../assets/pro2.jpg";
---

<MainLayout>
  <script type="application/ld+json" set:html={JSON.stringify(allSchemas)} />

  <Announcement />

  <ContentBox title="S8P888 เว็บเดียวครบจบทุกการเดิมพัน สล็อต บาคาร่า แทงบอล หวย ด้วยระบบ API แท้มาตรฐานสากล">
    <p class="leading-relaxed">
      S8P888 ก้าวสู่การเป็นแพลตฟอร์มเดิมพันอันดับ 1 ในประเทศไทยที่การันตีคุณภาพด้วยการบริการที่เหนือระดับ เรายกระดับการเล่นเกมคาสิโนออนไลน์และเดิมพันกีฬาให้มีความโปร่งใส แม่นยำ และปลอดภัยสูงสุด
      ด้วยการเชื่อมต่อระบบ API แท้จากค่ายเกมระดับโลกโดยตรง สมาชิกทุกท่านจะได้สัมผัสประสบการณ์การเดิมพันแบบไร้รอยต่อ ครบจบในที่เดียวโดยไม่ต้องโยกเงินให้เสียเวลา
      พิสูจน์แล้วจากผู้ใช้งานจริงและเสียงชื่นชมจากลูกค้ากว่า 5,000 ราย ที่ยกให้เราเป็นเว็บที่ดูแลดีเยี่ยมที่สุด
    </p>

    <div class="mt-8 flex flex-wrap justify-center gap-6">
      <a
        href="/login"
        class="group relative flex items-center justify-center px-10 py-3.5 font-black text-white transition-all hover:scale-105 hover:shadow-[0_0_15px_rgba(16,185,129,0.3)]"
        style="clip-path: polygon(15% 0, 100% 0, 100% 70%, 85% 100%, 0 100%, 0 30%); background: #064e3b; border: 1px solid #10b981;">
        เข้าระบบเกม
      </a>

      <a
        href="/register"
        class="group relative flex items-center justify-center px-10 py-3.5 font-black text-[#01120a] shadow-[0_0_20px_rgba(255,215,0,0.4)] transition-all hover:scale-105"
        style="clip-path: polygon(15% 0, 100% 0, 100% 70%, 85% 100%, 0 100%, 0 30%); background: linear-gradient(to right, #ff9100, #ffea00);">
        สมัครสมาชิก
      </a>
    </div>
  </ContentBox>
  <ProviderGrid />
  <LatestWinners />
  <ContentBoxThreeColums titleleft="CORE_STABILITY" titlecenter="AUTO_TRANSFER" titleright="ENCRYPTED_VIP">
    <div slot="left">ระบบประมวลผลความเร็วสูง มั่นใจได้ในทุกการเดิมพัน ไม่มีสะดุด ปลอดภัย 100%</div>
    <div slot="center">ฝาก-ถอน อัตโนมัติด้วย AI อัจฉริยะ ทำรายการเพียง 3 วินาที รองรับทุกธนาคาร</div>
    <div slot="right">การดูแลระดับพรีเมียมจากทีมงานผู้เชี่ยวชาญ พร้อมความปลอดภัยข้อมูลขั้นสูงสุด</div>
  </ContentBoxThreeColums>

  <ContentBoxTwo titleleft="เจาะลึกประสบการณ์การเดิมพัน S8P888 จากการใช้งานจริง (Experience)" titleright="โปรโมชั่นและสิทธิพิเศษสำหรับสมาชิก S8P888">
    <div slot="left" class="text-white/80">
      <p>
        S8P888 ให้ความสำคัญกับการบริการลูกค้าเป็นอันดับ 1 (Call Center Support) จากเสียงตอบรับลูกค้ามากกว่า 5,000 คำชม เรามีทีมงานมืออาชีพสแตนด์บายดูแลคุณอย่างใกล้ชิด ไม่ว่าจะเป็นปัญหาเรื่องการใช้งาน
        การสอบถามโปรโมชั่น หรือการแก้ปัญหาทางเทคนิค เราแก้ไขให้คุณทันทีด้วยความเป็นมืออาชีพ อีกทั้งระบบการใช้งานของเรายังออกแบบมาให้รองรับมือถือทุกรุ่น เล่นลื่นไหลไม่มีสะดุด และที่สำคัญคือระบบ
        "กระเป๋าเดียว" ที่คุณไม่ต้องโยกเงินเข้า-ออกให้ยุ่งยากเหมือนเว็บอื่น
      </p>
    </div>
    <div slot="right" class="text-white/80">
      <p>
        เพื่อตอบแทนความไว้วางใจของลูกค้า เราเตรียมความคุ้มค่าไว้ให้คุณตั้งแต่วันแรกที่สมัคร:
        <ul>
          <li class="mb-2">รับโบนัสสมาชิกใหม่ 100%: สูงสุดถึง 5,000 บาท เพิ่มทุนให้คุณได้ลุ้นรางวัลใหญ่มากขึ้น</li>
          <li class="mb-2">ระบบแนะนำเพื่อน: สร้างรายได้ง่ายๆ ด้วยโปรแกรมแนะนำเพื่อน รับค่าคอมมิชชั่นสูงสุดถึง 9% พร้อมเครดิตเงินคืน 0.3% ในทุกยอดการเล่น รับได้ทุกวัน</li>
        </ul>
      </p>
    </div>
  </ContentBoxTwo>
  <ContentBoxThreeColums titleleft="สล็อตเว็บตรงแตกง่าย ลิขสิทธิ์แท้จากทุกค่ายดัง " titlecenter="บาคาร่าออนไลน์และคาสิโนสด " titleright="แทงบอลออนไลน์และหวยออนไลน์ ">
    <div slot="left">สนุกกับเกมสล็อตมากกว่า 5,000 เกม อัปเดตใหม่ล่าสุด โบนัสแตกง่าย จ่ายจริงทุกยอด</div>
    <div slot="center">สัมผัสบรรยากาศคาสิโนจริงผ่านการถ่ายทอดสดความคมชัดระดับ HD ดีลเลอร์มืออาชีพพร้อมให้บริการตลอด 24 ชม.</div>
    <div slot="right">อัปเดตราคาบอลเรียลไทม์ และหวยทุกประเภท จ่ายหนัก จ่ายจริง ระบบคำนวณเงินแม่นยำ</div>
  </ContentBoxThreeColums>
  <SmoothCarousel />

  <ContentBoxSevenThree>
    <div slot="left" class="flex h-full flex-col justify-center">
      <Picture
        src={image1}
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600, 800]}
        sizes="(max-width: 768px) 100vw, 50vw"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
        alt="Vegus24 VIP Service"
        class="mx-auto h-auto w-full rounded-2xl border-2 border-yellow-500/30 shadow-[0_10px_30px_rgba(234,179,8,0.2)]"
      />
    </div>
    <div slot="right">
      <h2 class="mb-4 text-3xl font-black tracking-[0.2em] text-emerald-300 uppercase drop-shadow-[0_0_10px_rgba(16,185,129,0.8)]">ระบบรักษาความปลอดภัยและมาตรฐานใบอนุญาตระดับเอเชียของ S8P888</h2>
      <p>
        ความปลอดภัยคือพันธกิจของเรา S8P888 ใช้ระบบเข้ารหัสข้อมูล SSL ขั้นสูง ปกป้องข้อมูลส่วนตัวของสมาชิกทุกคน ไม่มีการรั่วไหลทางการเงินและการเล่นอย่างแน่นอน
        เราดำเนินงานภายใต้มาตรฐานเว็บตรงระดับเอเชีย การันตีการถอนเงินได้จริง ไม่ว่าจะยอดเล็กหรือยอดใหญ่ เราจ่ายครบถ้วนตามเงื่อนไขที่โปร่งใส
      </p>

      <a href="/line" class="inline-flex items-center rounded-full bg-yellow-500 px-8 py-3 font-bold text-green-950 shadow-lg transition-transform hover:scale-105">
        <span class="mr-2 text-xl">LINE</span> ติดต่อแอดมิน
      </a>
    </div>
  </ContentBoxSevenThree>
  <ContentBox>
    <h2 class="mb-4 text-3xl font-black tracking-[0.2em] text-emerald-300 uppercase drop-shadow-[0_0_10px_rgba(16,185,129,0.8)]">S8P888 ทำไมถึงเป็นเว็บตรง API แท้ที่ได้รับความไว้วางใจสูงสุด</h2>
    <p class="leading-relaxed">
      การเลือกใช้ระบบ API แท้ คือหัวใจสำคัญที่ทำให้ S8P888 แตกต่าง เราไม่ได้เป็นเพียงเว็บไซต์ที่นำเกมมาลง แต่เราคือพาร์ทเนอร์โดยตรงกับค่ายเกมชั้นนำ ทำให้ค่า RTP (อัตราการจ่ายเงินรางวัล)
      ของทุกเกมเป็นไปตามมาตรฐานสากล ไม่มีการปรับแต่งผลการเล่นหลังบ้าน ระบบของเราออกแบบมาเพื่อรองรับผู้ใช้งานจำนวนมากด้วยความเสถียรสูงสุด คุณจึงมั่นใจได้ว่าทุกการวางเดิมพันคือความยุติธรรมและปลอดภัย
      100%
    </p>
  </ContentBox>
  <Faq />
  <Navfoot />

  <style>
    :global(.text-emerald-gradient) {
      background: linear-gradient(to bottom, #34d399 0%, #10b981 100%) !important;
      -webkit-background-clip: text !important;
      -webkit-text-fill-color: transparent !important;
    }
  </style>
</MainLayout>
