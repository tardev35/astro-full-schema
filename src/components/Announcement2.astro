---
const {
  message = "WON22 รวมเกมสล็อตออนไลน์เว็บตรงหลายค่ายไว้ในยูสเดียว เปลี่ยนเกมกี่รอบก็ไม่ต้องเปลี่ยนบัญชีตาม • ฝากถอนออโต้ทำรายการจากหน้าเมมเบอร์ได้ตลอด 24 ชั่วโมง เช็กสถานะเองได้ทุกรายการ • แนวทาง ไม่ติดเทิร์น ตามเงื่อนไขที่ระบบกำหนด จัดการเครดิตต่อได้โดยไม่ต้องปั่นยอดหลายรอบ • สมัครสมาชิกผ่านมือถือจบจากเครื่องเดียว แล้วใช้ยูสเดิมเข้าหน้าเมมเบอร์ได้เลย • โปรโมชั่นเปิดให้เลือกตามสไตล์เล่น ดูยอดรับ เทิร์น และช่วงเวลาก่อนกดรับทุกครั้ง • หน้าเมมเบอร์รวมเกม เครดิต โปร และประวัติรายการไว้จุดเดียว",
} = Astro.props;
---

<div class="relative mx-auto flex h-[42px] max-w-[900px] items-center overflow-hidden rounded-sm bg-[#0d0502] shadow-[0_4px_15px_rgba(0,0,0,0.5)]">
  <div class="relative z-10 flex h-full items-center bg-gradient-to-r from-[#9a3412] to-[#f97316] px-6 pl-4 [clip-path:polygon(0_0,100%_0,85%_100%,0_100%)] md:px-8">
    <div class="flex items-center gap-2">
      <span class="relative flex h-2.5 w-2.5">
        <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-[#fbbf24] opacity-75"></span>
        <span class="relative inline-flex h-2.5 w-2.5 rounded-full bg-[#fbbf24]"></span>
      </span>
      <span class="font-black tracking-widest text-[#1c0a02] italic drop-shadow-md">HOT</span>
    </div>
  </div>

  <div class="relative flex-1 overflow-hidden">
    <div class="absolute inset-y-0 left-0 z-10 w-8 bg-gradient-to-r from-[#0d0502] to-transparent"></div>
    <div class="absolute inset-y-0 right-0 z-10 w-8 bg-gradient-to-l from-[#0d0502] to-transparent"></div>

    <div class="marquee-track flex w-max animate-[scroll_20s_linear_infinite] items-center gap-10 pl-4 text-sm font-bold whitespace-nowrap text-[#f8e3d2]/90 md:text-base">
      <span>{message}</span>
      <span>{message}</span>
      <span>{message}</span>
    </div>
  </div>

  <div class="absolute bottom-0 left-0 h-[2px] w-full bg-gradient-to-r from-[#fbbf24] via-[#f97316] to-transparent"></div>
</div>

<style>
  @keyframes scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(calc(-33.33% - 13px));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
    }
  }
</style>
