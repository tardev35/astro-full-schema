---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement6.astro";
import { pageGraph } from "../lib/schema";

const pageTitle = "เกี่ยวกับเรา POE888 เว็บสีฟ้า รวมหวยออนไลน์ไทยลาวไว้ในบัญชีเดียว";

const pageDescription =
  "เกี่ยวกับเรา POE888 หน้ารวมข้อมูลเว็บสีฟ้าที่ให้บริการหวยออนไลน์ไทยและลาว อธิบายตลาดที่เปิดรับ ระบบสมาชิก การจัดโพย การตรวจผล และการจัดการเครดิตผ่านมือถือ";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox as="h1" title={pageTitle}>
    <p class="mb-4 text-left text-base leading-relaxed text-[#dbeafe]">
      <strong class="text-[#ffd93d]">POE888</strong> เป็นเว็บสีฟ้าที่วางหวยออนไลน์ไว้เป็นหมวดหลัก รวมการเลือกเลข จัดโพย ตรวจผล และดูประวัติรายการไว้ในบัญชีเดียว
      สมาชิกเข้าสู่ระบบครั้งเดียวแล้วเลือกตลาดที่ติดตาม ดูเครดิต หรือจัดการข้อมูลบัญชีต่อได้ทันที ทั้งบนมือถือและคอมพิวเตอร์ จึงสลับระหว่างหวยไทยกับหวยลาวได้โดยไม่ต้องเริ่มใหม่หลายรอบ
    </p>

    <p class="text-left text-base leading-relaxed text-[#dbeafe]">
      หน้านี้ทำหน้าที่เป็นหน้าข้อมูลและแนะนำตัว อธิบายว่าเราเปิดรับตลาดใดบ้าง วางระบบสมาชิกกับการจัดการเครดิตไว้อย่างไร และเหมาะกับคนเล่นหวยแบบไหน
      เพื่อให้อ่านแล้วนำไปเทียบกับสิ่งที่เห็นในหน้าสมาชิกจริงได้ เพราะเรื่องตัวเลขซับซ้อนพอแล้ว หน้าเว็บไม่จำเป็นต้องมาช่วยเพิ่มโจทย์
    </p>
  </ContentBox>

  <ContentBox as="h2" title="POE888 เปิดรับหวยออนไลน์ตลาดไหนบ้าง">
    <p class="mb-4 text-left text-base leading-relaxed text-[#dbeafe]">
      เราวางหวยไทยและหวยลาวไว้เป็นตลาดหลัก พร้อมพื้นที่สำหรับหวยออนไลน์ประเภทอื่นอย่างหวยฮานอยและหวยมาเลย์ สมาชิกจึงเลือกตลาดที่ติดตามอยู่แล้วส่งโพยผ่านบัญชีเดียวได้
      ทุกตลาดเข้าถึงได้จากเมนูหลักบนมือถือ ไม่ต้องเปิดหลายเว็บเพื่อเปลี่ยนไปดูอีกงวดหนึ่ง
    </p>

    <p class="text-left text-base leading-relaxed text-[#dbeafe]">
      แต่ละตลาดมีรอบและเวลาปิดรับต่างกัน จึงควรเช็กข้อมูลของงวดก่อนยืนยันโพยทุกครั้ง หน้าตลาดแบ่งไว้ชัดเพื่อให้เห็นว่ารอบไหนยังเปิดอยู่และรอบไหนปิดไปแล้ว
      เล่นหลายตลาดมีได้ แต่โพยไหนส่งแล้วต้องรู้ว่าไปอยู่ตลาดไหน
    </p>
  </ContentBox>

  <ContentBox as="h2" title="หวยไทยกับหวยลาวบน POE888 ใช้งานต่างกันอย่างไร">
    <p class="mb-4 text-left text-base leading-relaxed text-[#dbeafe]">
      ฝั่งหวยไทยเปิดให้เลือกเลขและจัดรายการที่ต้องการไว้ในโพยก่อนกดยืนยัน จึงตรวจทั้งเลขและยอดรวมได้อีกครั้งจากหน้าจอเดียว
      คนที่มีเลขหลายชุดจึงจัดการง่ายกว่าจดใส่กระดาษหลายใบ เลขเด็ดมีไว้ลุ้น ส่วนโพยควรเรียบร้อยไว้ก่อน เดี๋ยวถูกแล้วหาไม่เจอจะเสียทรง
    </p>

    <p class="text-left text-base leading-relaxed text-[#dbeafe]">
      ฝั่งหวยลาวแยกตลาดและรอบตามช่วงที่เปิดรับ สมาชิกจึงเลือกงวดที่ต้องการแล้วตรวจข้อมูลของรายการก่อนส่งโพยผ่านมือถือได้
      หลังประกาศผลก็กลับมาเทียบกับรายการที่แทงไว้จากบัญชีเดิม จบเป็นรอบ ๆ ชัดเจน ไม่ต้องเปิดสิบแท็บเพื่อจำว่าเลขชุดนี้ซื้อไว้ที่ไหน
    </p>
  </ContentBox>

  <ContentBox as="h2" title="ระบบสมาชิกของ POE888 ดูแลโพยและเครดิตอย่างไร">
    <p class="mb-4 text-left text-base leading-relaxed text-[#dbeafe]">
      หน้าสมาชิกรวมโพย เครดิต และประวัติรายการไว้ในพื้นที่เดียว ทำให้ตรวจสอบได้ว่ามีรายการไหนส่งไปแล้ว ใช้งานตลาดใดไว้บ้าง และยอดคงเหลือเป็นเท่าไร
      คนที่เล่นหลายงวดจึงจัดบัญชีของตัวเองได้เป็นระเบียบ ของสำคัญควรมีที่อยู่ชัด โดยเฉพาะโพยกับเงิน ไม่ควรใช้ระบบความจำล้วน ๆ
    </p>

    <p class="text-left text-base leading-relaxed text-[#dbeafe]">
      การสมัครสมาชิกทำผ่านมือถือได้ตั้งแต่กรอกข้อมูล ตั้งค่าบัญชี ไปจนถึงยืนยันตามขั้นตอนของระบบ หลังจากนั้นจึงเข้าสู่หน้าสมาชิกและเลือกตลาดที่ต้องการได้
      และขอย้ำเสมอว่าไม่ควรส่งรหัสผ่านหรือรหัส OTP ให้บุคคลอื่นไม่ว่ากรณีใด เพราะทีมงานจริงไม่มีความจำเป็นต้องขอสองสิ่งนี้
    </p>
  </ContentBox>

  <ContentBox as="h2" title="ตรวจผลหวยและฝากถอนของ POE888 ทำจากที่เดียวได้ไหม">
    <p class="mb-4 text-left text-base leading-relaxed text-[#dbeafe]">
      หลังผลออก สมาชิกนำผลหวยมาเทียบกับเลขที่บันทึกไว้ในโพยได้จากบัญชีเดิม จึงดูผลของแต่ละรายการโดยไม่ต้องจำตัวเลขทั้งหมดเอง
      ประวัติโพยถูกเก็บไว้กับบัญชี ทำให้ย้อนดูรายการก่อนหน้าได้ง่าย เลขสองสามตัวอาจจำได้ แต่พอหลายโพย ความมั่นใจของสมองมักแพ้หลักฐาน
    </p>

    <p class="text-left text-base leading-relaxed text-[#dbeafe]">
      ด้านการเงิน สมาชิกจัดการเครดิตสำหรับการใช้งานผ่านหน้าบัญชี พร้อมตรวจสอบรายการฝากถอนและยอดที่เกี่ยวข้องจากระบบเดียว
      เราจึงเชื่อมเรื่องเงินเข้ากับโพยและประวัติสมาชิกไว้ด้วยกัน ขั้นตอนยิ่งสั้นยิ่งดี เพราะเงินควรเดินเป็นระบบ เจ้าของเงินไม่จำเป็นต้องเดินตาม
    </p>
  </ContentBox>

  <ContentBox as="h2" title="POE888 เหมาะกับคนเล่นหวยแบบไหน">
    <p class="mb-4 text-left text-base leading-relaxed text-[#dbeafe]">
      POE888 เหมาะกับคนที่ติดตามหวยไทยและหวยลาวเป็นประจำ ต้องการเลือกเลข จัดโพย ตรวจผล รวมถึงดูประวัติรายการผ่านมือถือจากบัญชีเดียว
      คนที่เล่นหลายตลาดจึงไม่ต้องกระจายโพยไปหลายที่ เลือกตลาด เช็กเวลา ส่งรายการ แล้วกลับมาตรวจผลได้เป็นระบบ เลขจะกระจายได้ แต่ข้อมูลไม่ควรกระจายตาม
    </p>

    <p class="text-left text-base leading-relaxed text-[#dbeafe]">
      นอกจากหวย เรายังมีหมวดเกมและกีฬาเป็นตัวเลือกเสริมสำหรับคนที่อยากเปลี่ยนบรรยากาศ โดยยังผูกกับบัญชีสมาชิกชุดเดิม
      ส่วนทางเข้าเว็บหลักรองรับทั้งมือถือและคอม การใช้ช่องทางหลักช่วยลดความสับสนจากชื่อเว็บที่คล้ายกันบนผลค้นหา จำช่องทางให้ถูกหนึ่งครั้ง ดูดีกว่าสุ่มลิงก์ก่อนเริ่มแทงหวย
    </p>
  </ContentBox>

  <Navfoot />
</MainLayout>
