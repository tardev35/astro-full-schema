---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";
---

<section class="relative z-10 my-6 flex w-full justify-center px-4 font-sans">
  <div
    class="w-full max-w-[1400px] rounded-[25px] border border-[#2f8cff]/45 bg-[#061538] p-8 text-left text-base leading-relaxed text-[#d6e4ff] shadow-[10px_10px_20px_#010a1f,-10px_-10px_20px_#0a1f4d]">
    {
      title && (
        <header class="mb-8 border-b border-[#2f8cff]/40 pb-4 text-center">
          <HeadingTag class={`bg-gradient-to-r from-[#eaf4ff] via-[#9cc9ff] to-[#7cc0ff] bg-clip-text ${headingSize} leading-normal font-black tracking-wide text-transparent`}>{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
