---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h2" } = Astro.props;
---

<section class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#ec4899]/30 bg-[#ffffff]/92 p-6 text-[#7a1038] shadow-[0_10px_30px_rgba(236,72,153,0.14)] backdrop-blur-xl transition-all duration-500 hover:border-[#ec4899]/55 md:p-10">
    <div
      aria-hidden="true"
      class="pointer-events-none absolute top-0 left-1/2 -z-10 h-[2px] w-1/2 -translate-x-1/2 bg-gradient-to-r from-transparent via-[#ec4899] to-transparent opacity-60 transition-opacity duration-500 group-hover:opacity-100">
    </div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#f9c2d9] pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#f472b6] to-[#9d174d] shadow-[0_0_10px_rgba(236,72,153,0.4)]" />
          <HeadingTag class="bg-gradient-to-r from-[#ec4899] via-[#9d174d] to-[#be185d] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-2 lg:gap-10">
      <article
        class="relative flex gap-4 rounded-2xl border border-[#f9c2d9] bg-[#fff2f7]/95 p-6 text-left text-base leading-relaxed text-[#7a1038] transition-all duration-300 hover:-translate-y-2 hover:border-[#ec4899]/55 hover:bg-[#ffe4f0]/90 hover:shadow-[0_15px_40px_rgba(236,72,153,0.18)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#f9c2d9] bg-gradient-to-br from-[#f7c948] via-[#ec4899] to-[#9d174d] text-2xl shadow-[0_5px_15px_rgba(236,72,153,0.20)]">
          📱
        </div>
        <slot name="left" />
      </article>

      <article
        class="relative flex gap-4 rounded-2xl border border-[#f9c2d9] bg-[#fff2f7]/95 p-6 text-left text-base leading-relaxed text-[#7a1038] transition-all duration-300 hover:-translate-y-2 hover:border-[#ec4899]/55 hover:bg-[#ffe4f0]/90 hover:shadow-[0_15px_40px_rgba(236,72,153,0.18)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#f9c2d9] bg-gradient-to-br from-[#f472b6] via-[#be185d] to-[#9d174d] text-2xl shadow-[0_5px_15px_rgba(190,24,93,0.20)]">
          ✅
        </div>
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
