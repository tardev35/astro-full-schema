---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#5a1a1e] bg-[#170a0b]/92 p-8 text-left text-base leading-relaxed text-[#dce3e8] shadow-[0_10px_30px_rgba(224,27,45,0.16)] transition-all duration-500 hover:border-[#e01b2d]/60 hover:shadow-[0_15px_40px_rgba(224,27,45,0.26)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#e01b2d]/20 blur-[60px] transition-all duration-500 group-hover:bg-[#ff3b46]/28"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#bdcad2]/14 blur-[60px] transition-all duration-500 group-hover:bg-[#f2f5f7]/22"></div>

    {
      title && (
        <header class="mb-6 flex items-center gap-4 border-b border-[#5a1a1e] pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#e01b2d] to-[#bdcad2] shadow-[0_0_10px_rgba(224,27,45,0.45)]" />
          <HeadingTag class="bg-gradient-to-r from-[#ff3b46] via-[#f2f5f7] to-[#bdcad2] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
