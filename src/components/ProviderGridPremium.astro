---
import { Picture } from "astro:assets";
import img1 from "../assets/providers/game1.avif";
import img2 from "../assets/providers/game2.avif";
import img3 from "../assets/providers/game3.avif";
import img4 from "../assets/providers/game4.avif";
import img5 from "../assets/providers/game5.avif";
import img6 from "../assets/providers/game6.avif";

const providers = [
  { name: "PG Soft", users: "4,592", isHot: true, img: img1 },
  { name: "Joker Gaming", users: "2,184", isHot: true, img: img2 },
  { name: "JILI", users: "3,845", isHot: true, img: img3 },
  { name: "Evolution", users: "2,901", isHot: true, img: img4 },
  { name: "SA Gaming", users: "1,754", isHot: false, img: img5 },
  { name: "Sexy Baccarat", users: "3,245", isHot: true, img: img6 },
];
---

<section aria-label="ค่ายเกมบาคาร่าและสล็อตที่ ANDAMAN168 รวมไว้ในบัญชีเดียว" class="mx-auto w-full max-w-[1300px] px-4 py-8 font-sans sm:px-6 lg:px-8">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <span aria-hidden="true" class="text-2xl drop-shadow-[0_0_10px_rgba(253,181,36,0.8)]">🎰</span>
    <p class="bg-gradient-to-r from-[#ffe999] via-[#fdb524] to-[#7fe6ff] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase drop-shadow-sm">
      ค่ายเกมที่ <span class="text-[#fdb524]">ANDAMAN168</span> รวมไว้ในบัญชีเดียว
    </p>
    <div class="mt-2 h-[2px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#21d4f2] to-transparent"></div>
  </div>

  <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-6 lg:gap-6">
    {
      providers.map((p) => (
        <div class="group relative flex flex-col overflow-hidden rounded-2xl bg-[#04182f] shadow-[0_5px_15px_rgba(3,19,36,0.55)] transition-all duration-500 hover:-translate-y-2 hover:shadow-[0_15px_35px_rgba(33,212,242,0.32)]">
          <div class="pointer-events-none absolute inset-0 z-20 rounded-2xl border border-[#0a3a68] transition-all duration-500 group-hover:border-[#fdb524]/50 group-hover:shadow-[inset_0_0_20px_rgba(253,181,36,0.15)]" />

          <div class="absolute top-0 left-0 z-10 flex items-center gap-1.5 rounded-br-xl border-r border-b border-[#0a3a68] bg-[#031324]/80 px-3 py-1.5 text-[10px] font-medium text-[#7fe6ff] backdrop-blur-md transition-colors group-hover:text-[#ffe999]">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path fill-rule="evenodd" d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z" clip-rule="evenodd" />
            </svg>
            {p.users}
          </div>

          {p.isHot && (
            <div class="absolute top-0 right-0 z-10 flex items-center gap-1 rounded-bl-xl border-b border-l border-[#ffe999]/50 bg-gradient-to-r from-[#b06f00] to-[#fdb524] px-3 py-1.5 text-[10px] font-black tracking-wide text-[#04182f] shadow-md">
              <span aria-hidden="true" class="animate-pulse">
                🔥
              </span>{" "}
              HOT
            </div>
          )}

          <Picture
            src={p.img}
            alt={`ภาพหน้าปกเกมของค่าย ${p.name} ในตารางค่ายเกมของ ANDAMAN168`}
            formats={["avif", "webp"]}
            fallbackFormat="webp"
            loading="lazy"
            fetchpriority="low"
            widths={[200, 400]}
            sizes="(max-width: 640px) 45vw, (max-width: 1024px) 30vw, 200px"
            decoding="async"
            class="block aspect-square w-full object-cover opacity-90 transition-transform duration-700 group-hover:scale-110 group-hover:opacity-100"
          />

          <p class="relative z-10 border-t border-[#0a3a68] px-3 py-2 text-center text-xs font-bold text-[#dbeefb] transition-colors group-hover:text-[#ffe999]">{p.name}</p>

          <div
            aria-hidden="true"
            class="pointer-events-none absolute bottom-9 left-0 h-20 w-full bg-gradient-to-t from-[#21d4f2]/40 to-transparent opacity-0 transition-opacity duration-500 group-hover:opacity-100"
          />
        </div>
      ))
    }
  </div>
</section>
