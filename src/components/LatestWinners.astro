---
import kbankLogo from "../assets/banks/kbank.png";
import scbLogo from "../assets/banks/scb.png";
import krungsriLogo from "../assets/banks/krungsri.png";
import ktbLogo from "../assets/banks/ktb.png";
import { BRAND_NAME, brandFlag, brandPick } from "../lib/brandProfile";

const bankPool = [
  { name: "KBank", color: "bg-[#1155cc]", icon: kbankLogo.src },
  { name: "SCB", color: "bg-[#4e1c80]", icon: scbLogo.src },
  { name: "Krungsri", color: "bg-[#fcd34d]", icon: krungsriLogo.src },
  { name: "KTB", color: "bg-[#0ea5e9]", icon: ktbLogo.src },
];

const LETTERS = "abcdefghijklmnopqrstuvwxyz";
const pad = (n: number) => String(n).padStart(2, "0");
const pick = (salt: string, n: number) => brandPick(Astro.site, salt, n);
const digits = (salt: string, n: number) =>
  Array.from({ length: n }, (_, d) => pick(`${salt}-${d}`, 10)).join("");

const initialRows = Array.from({ length: 4 }, (_, i) => ({
  bank: bankPool[pick(`std-bank-${i}`, bankPool.length)],
  user: `${LETTERS.charAt(pick(`std-a-${i}`, 26))}${LETTERS.charAt(pick(`std-b-${i}`, 26))}***${digits(`std-u${i}`, 4)}`,
  amount: (15000 + pick(`std-amount-${i}`, 80001)).toLocaleString("en-US"),
  ref: digits(`std-ref${i}`, 8),
  time: `${pad(pick(`std-h-${i}`, 24))}:${pad(pick(`std-m-${i}`, 60))}:${pad(pick(`std-s-${i}`, 60))}`,
  pending: brandFlag(Astro.site, `std-pending-${i}`),
}));

const feedTitle = `รายการถอนเงินล่าสุดของสมาชิก ${BRAND_NAME}`;

const PENDING_CLASS = "bg-[#fff7e0] text-[#8a6508] animate-pulse border border-[#e0a91b]/60";
const DONE_CLASS = "bg-[#10b981]/15 text-[#047857] border border-[#10b981]/50";
---

<div class="mx-auto w-full max-w-[1300px] p-4 font-sans">
  <section
    aria-label={feedTitle}
    class="relative overflow-hidden rounded-[20px] border border-[#d6e2f7] bg-white px-4 py-8 shadow-[0_10px_30px_rgba(10,31,92,0.08)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute top-0 left-0 h-1.5 w-full bg-gradient-to-r from-[#1a5fe0] via-[#4d8ff5] to-[#e0a91b]"></div>

    <div class="relative z-10 mb-8 flex items-center justify-center gap-3">
      <span aria-hidden="true" class="text-2xl">💎</span>
      <p class="bg-gradient-to-r from-[#0a1f5c] via-[#1a5fe0] to-[#0b3a9e] bg-clip-text text-center text-xl leading-normal font-black tracking-wide text-transparent md:text-3xl">{feedTitle}</p>
      <span aria-hidden="true" class="text-2xl">💎</span>
    </div>

    <div data-winners-feed data-interval="5000" data-max-rows="4" class="relative z-10 flex flex-col">
      {
        initialRows.map((row) => (
          <div data-winner-row class="winner-row grid grid-rows-[1fr] transition-all duration-700 ease-in-out">
            <div class="overflow-hidden">
              <div class="mb-3 flex items-center justify-between rounded-xl border border-[#d6e2f7] bg-[#eef4ff] p-4 transition-all hover:border-[#9dbcf0] hover:bg-white">
                <div class="flex items-center gap-4">
                  <div class="relative flex h-11 w-11 shrink-0 items-center justify-center rounded-full border border-[#d6e2f7] bg-white shadow-sm">
                    <div data-winner-bank class={`flex h-9 w-9 items-center justify-center overflow-hidden rounded-full ${row.bank.color}`}>
                      <img data-winner-icon src={row.bank.icon} alt="" width="24" height="24" loading="lazy" decoding="async" class="h-6 w-6 object-contain" />
                    </div>
                  </div>
                  <div class="flex flex-col justify-center">
                    <div class="text-sm font-bold text-[#1f2a44] md:text-base">
                      User: <span data-winner-user class="tracking-wider text-[#1a5fe0]">{row.user}</span>
                    </div>
                    <div class="mt-0.5 text-[10px] text-[#4a5878] md:text-xs">
                      REF#<span data-winner-ref data-ref-length="8">{row.ref}</span> · <span data-winner-time>{row.time}</span>
                    </div>
                  </div>
                </div>
                <div class="flex flex-col items-end justify-center gap-1.5">
                  <div class="text-lg font-black tracking-tight text-[#8a6508] md:text-2xl">
                    <span data-winner-amount>{row.amount}</span> <span class="text-[10px] font-medium text-[#4a5878] md:text-xs">THB</span>
                  </div>
                  <div
                    data-winner-status
                    data-pending-text="กำลังทำรายการ..."
                    data-done-text="ถอนสำเร็จแล้ว"
                    data-pending-class={PENDING_CLASS}
                    data-done-class={DONE_CLASS}
                    class={`rounded-full px-3 py-1 text-[9px] font-medium md:text-[10px] ${row.pending ? PENDING_CLASS : DONE_CLASS}`}>
                    {row.pending ? "กำลังทำรายการ..." : "ถอนสำเร็จแล้ว"}
                  </div>
                </div>
              </div>
            </div>
          </div>
        ))
      }
    </div>

    <script type="application/json" data-winners-banks set:html={JSON.stringify(bankPool)} />
  </section>
</div>

<script>
  import { startWinnersFeed } from "../lib/winnersFeed";

  startWinnersFeed();
</script>

<style>
  .winner-row.is-entering {
    grid-template-rows: 0fr;
    opacity: 0;
    transform: translateY(-1rem);
  }

  @media (prefers-reduced-motion: reduce) {
    .winner-row {
      transition: none;
    }
  }
</style>
