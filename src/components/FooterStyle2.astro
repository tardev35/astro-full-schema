---
import { Picture } from "astro:assets";
import BankStrip from "./BankStrip.astro";
import { BRAND_ADDRESS } from "../lib/brandProfile";

const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });
const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;
---

<footer class="relative w-full overflow-hidden border-t-[3px] border-[#fec93a] bg-[#0e0902] pt-16 pb-8 text-white shadow-[0_-10px_30px_rgba(254,201,58,0.2)]">
  <div aria-hidden="true" class="pointer-events-none absolute top-0 right-0 h-96 w-96 rounded-full bg-[#fec93a]/12 blur-[100px]"></div>
  <div aria-hidden="true" class="pointer-events-none absolute bottom-0 left-0 h-96 w-96 rounded-full bg-[#c9ccd4]/18 blur-[100px]"></div>

  <div class="relative z-10 mx-auto w-full max-w-[1200px] px-6">
    <div class="mb-12 grid grid-cols-1 gap-10 md:grid-cols-2 lg:grid-cols-4 lg:gap-8">
      <div class="flex flex-col gap-5">
        <a href="/" class="inline-block origin-left transition-transform hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt="โลโก้ AMD365 ตัวอักษร Amd365 แบบเอียง ตัว A และเลข 365 เป็นสีทองเงาวาว ตัว md เป็นสีเงินโครม มีเส้นโค้งทองลากใต้ตัวอักษร และลูกเต๋าสีทองอยู่มุมขวาบน"
                widths={[110, 220, 330]}
                sizes="110px"
                class="h-[50px] w-auto drop-shadow-[0_0_15px_rgba(254,201,58,0.5)]"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <span class="bg-gradient-to-b from-[#ffe9a8] to-[#fec93a] bg-clip-text text-4xl font-black text-transparent drop-shadow-[0_0_10px_rgba(254,201,58,0.45)]">AMD365</span>
            )
          }
        </a>
        <p class="text-base leading-relaxed text-[#cdbb93]">
          AMD365 รวมสล็อต คาสิโนสด กีฬา eSports และหวยออนไลน์ไว้ในบัญชีสมาชิกเดียว เปลี่ยนหมวดเกมได้โดยไม่ต้องสมัครยูสใหม่ พร้อมระบบฝากถอนออโต้ที่ดูเครดิตและประวัติรายการได้จากหน้าเมมเบอร์เดียวกัน
        </p>
        <div class="mt-2 flex items-center gap-3">
          <div class="flex items-center gap-1.5 rounded border border-[#c9ccd4]/50 bg-[#c9ccd4]/10 px-3 py-1.5 text-xs font-bold text-[#e6e8ee] shadow-[0_0_10px_rgba(201,204,212,0.25)]">
            <span aria-hidden="true" class="text-base">🛡️</span> SSL/TLS 256-BIT
          </div>
          <div class="flex items-center gap-1.5 rounded border border-[#fec93a]/50 bg-[#a06a09]/25 px-3 py-1.5 text-xs font-bold text-[#fec93a]">
            <span aria-hidden="true" class="text-base">⚡</span> AUTO 24H
          </div>
        </div>
      </div>

      <nav aria-label="เมนูหลัก" class="flex flex-col gap-4 lg:pl-8">
        <p class="flex items-center gap-2 text-lg font-extrabold text-[#ffe9a8]">
          <span aria-hidden="true" class="h-6 w-1.5 rounded-full bg-gradient-to-b from-[#ffe9a8] to-[#a06a09]"></span> เมนูหลัก
        </p>
        <ul class="flex flex-col gap-3 text-sm">
          {
            [
              { name: "หน้าแรก", path: "/" },
              { name: "โปรโมชั่น", path: "/promotion/" },
              { name: "สมัครสมาชิก", path: "/register/" },
              { name: "เข้าสู่ระบบ", path: "/login/" },
              { name: "ทางเข้า", path: "/ทางเข้า/" },
              { name: "ทดลองเล่น", path: "/ทดลองเล่น/" },
              { name: "เกี่ยวกับเรา", path: "/about-us/" },
              { name: "ติดต่อเรา", path: "/contact-us/" },
            ].map((link) => (
              <li>
                <a href={link.path} class="group flex items-center text-[#cdbb93] transition-all hover:text-[#ffe9a8]">
                  <span aria-hidden="true" class="mr-2 -ml-4 text-[#fec93a] opacity-0 transition-all group-hover:ml-0 group-hover:opacity-100">
                    ➤
                  </span>
                  {link.name}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav aria-label="หมวดหมู่บริการ" class="flex flex-col gap-4">
        <p class="flex items-center gap-2 text-lg font-extrabold text-[#ffe9a8]">
          <span aria-hidden="true" class="h-6 w-1.5 rounded-full bg-gradient-to-b from-[#ffe9a8] to-[#a06a09]"></span> หมวดเกมและบริการ
        </p>
        <ul class="flex flex-col gap-3 text-sm">
          {
            ["สล็อตออนไลน์ (Slot)", "คาสิโนสด (Live Casino)", "กีฬาและ eSports (Sport)", "หวยออนไลน์ (Lottery)", "ฝากถอนออโต้ (Auto)"].map((game) => (
              <li>
                <a href="/register/" class="group flex items-center text-[#cdbb93] transition-all hover:text-[#ffe9a8]">
                  <span aria-hidden="true" class="mr-3 h-1.5 w-1.5 rounded-full bg-[#a06a09] transition-colors group-hover:bg-[#fec93a] group-hover:shadow-[0_0_8px_rgba(254,201,58,0.8)]" />
                  {game}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="flex flex-col gap-5">
        <p class="flex items-center gap-2 text-lg font-extrabold text-[#ffe9a8]">
          <span aria-hidden="true" class="h-6 w-1.5 rounded-full bg-gradient-to-b from-[#ffe9a8] to-[#a06a09]"></span> บริการลูกค้า
        </p>

        <a
          href="/line/"
          class="flex w-full items-center justify-center gap-2 rounded-lg bg-[#00B900] py-3 font-bold text-white shadow-[0_0_15px_rgba(0,185,0,0.3)] transition-transform hover:scale-105">
          <span class="text-xl font-black">LINE</span> @AMD365
        </a>

        {
          BRAND_ADDRESS.lines.length > 0 && (
            <address aria-label={BRAND_ADDRESS.label} class="mt-2 rounded-xl border border-white/15 bg-black/20 p-4 text-xs leading-relaxed not-italic opacity-90">
              <p class="mb-2 flex items-center gap-2 text-[11px] font-bold tracking-wider uppercase opacity-80">
                <span aria-hidden="true" class="text-sm">📍</span>
                {BRAND_ADDRESS.label}
              </p>
              {BRAND_ADDRESS.lines.map((line) => (
                <span class="block">{line}</span>
              ))}
              {BRAND_ADDRESS.email && (
                <a href={`mailto:${BRAND_ADDRESS.email}`} class="mt-3 inline-flex items-center gap-2 font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                  <span aria-hidden="true" class="text-sm">✉️</span>
                  {BRAND_ADDRESS.email}
                </a>
              )}
            </address>
          )
        }

        <div class="mt-2">
          <p class="mb-3 text-xs font-bold tracking-wider text-[#ffe9a8]/90 uppercase">รองรับทุกธนาคาร &amp; True Wallet</p>
          <BankStrip size={26} />
        </div>
      </div>
    </div>

    <div class="mb-6 flex flex-wrap justify-center gap-4 border-y border-[#fec93a]/25 py-6 opacity-60 grayscale transition-all duration-500 hover:opacity-100 hover:grayscale-0 md:gap-8">
      <span class="text-lg font-black text-gray-300 italic md:text-2xl">PG<span class="text-[#ffe9a8]">SOFT</span></span>
      <span class="text-lg font-black text-gray-300 italic md:text-2xl">PRAGMATIC<span class="text-[#ffe9a8]">PLAY</span></span>
      <span class="text-lg font-black text-gray-300 italic md:text-2xl">JOKER<span class="text-[#ffe9a8]">GAMING</span></span>
      <span class="text-lg font-black text-gray-300 italic md:text-2xl">EVO<span class="text-[#ffe9a8]">LUTION</span></span>
      <span class="text-lg font-black text-gray-300 italic md:text-2xl">MICRO<span class="text-[#ffe9a8]">GAMING</span></span>
    </div>

    <div class="flex flex-col items-center justify-between gap-4 text-xs text-[#cdbb93] md:flex-row">
      <p>&copy; {new Date().getFullYear()} <span class="font-bold text-[#fec93a]">AMD365</span>. All rights reserved. สล็อต คาสิโน กีฬา หวย ครบในบัญชีเดียว</p>
      <div class="flex gap-4">
        <a href="/terms/" class="transition-colors hover:text-[#ffe9a8]">เงื่อนไขการให้บริการ</a>
        <a href="/privacy/" class="transition-colors hover:text-[#ffe9a8]">นโยบายความเป็นส่วนตัว</a>
      </div>
    </div>
  </div>
</footer>

<style>
  footer a {
    text-decoration: none;
  }
  footer {
    font-family: var(--font-sans);
  }
</style>
