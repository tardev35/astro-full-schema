---
const providers = [
  { name: "สล็อตเว็บตรง", desc: "หมวดหลักของเว็บ รวมเกมหมุนไว้หลังยูสเดียว เปลี่ยนเกมกี่รอบก็ใช้บัญชีเดิม", tag: "เกมหลัก", icon: "🎰" },
  { name: "เกมค่ายดัง", desc: "รวมเกมจากผู้ให้บริการหลายค่ายไว้ในระบบเดียว สลับค่ายได้โดยใช้เครดิตชุดเดิม", tag: "หลายค่าย", icon: "🏷️" },
  { name: "เกมฟรีสปิน", desc: "เกมที่มีรอบหมุนฟรีในตัว เหมาะกับคนที่ชอบรอจังหวะฟีเจอร์มากกว่าหมุนรัวยาว", tag: "หมวดเกม", icon: "🌀" },
  { name: "สล็อตโบนัสฟีเจอร์", desc: "เกมที่มีฟีเจอร์โบนัสหลายชั้น เลือกจากหน้ารวมเกมแล้วเปิดเล่นต่อได้ทันที", tag: "หมวดเกม", icon: "🍀" },
  { name: "ฝากถอนออโต้", desc: "ส่งรายการฝากเข้า ถอนออก และเช็กสถานะได้เองจากหน้าเมมเบอร์ ไม่ต้องรอถามแอดมิน", tag: "ระบบออโต้", icon: "💳" },
  { name: "ธนาคารและ TrueWallet", desc: "เลือกช่องทางฝากถอนตามที่ถนัด ทั้งบัญชีธนาคารและวอเลท จากระบบสมาชิกเดียวกัน", tag: "ช่องทางเงิน", icon: "🏦" },
  { name: "โปรโมชั่นสมาชิก", desc: "ดูยอดรับ เทิร์น และช่วงเวลาที่ใช้ได้ก่อนเลือกสิทธิ์ให้เข้ากับสไตล์เล่นของตัวเอง", tag: "สิทธิ์สมาชิก", icon: "🎁" },
];
---

<section aria-label="หมวดเกมสล็อตและบริการที่ VING999 รวมไว้ในยูสเดียว" class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#ff3b46] via-[#f2f5f7] to-[#bdcad2] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      หมวดเกมสล็อตและบริการที่ <span class="text-[#e01b2d]">VING999</span> รวมไว้ในยูสเดียว
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#e01b2d] to-transparent"></div>
  </div>

  <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4 lg:gap-5 xl:grid-cols-7">
    {
      providers.map((provider) => (
        <a
          href="/register"
          class="group relative flex flex-col items-center justify-center overflow-hidden rounded-2xl border border-[#5a1a1e] bg-[#170a0b] p-5 shadow-[0_10px_30px_rgba(224,27,45,0.14)] transition-all duration-300 hover:-translate-y-2 hover:border-[#e01b2d]/60 hover:bg-[#220d0f] hover:shadow-[0_15px_40px_rgba(224,27,45,0.28)]">
          <div class="pointer-events-none absolute inset-0 bg-[#e01b2d]/8 opacity-0 transition-opacity duration-300 group-hover:opacity-100" />

          <div class="absolute top-2 right-2 z-10 rounded-full bg-gradient-to-r from-[#ff3b46] via-[#e01b2d] to-[#8f0a13] px-2 py-0.5 text-[9px] font-black tracking-wide whitespace-nowrap text-[#f2f5f7] shadow-sm transition-transform duration-300 group-hover:scale-110">
            {provider.tag}
          </div>

          <div aria-hidden="true" class="mb-3 text-4xl transition-transform duration-300 group-hover:scale-125 group-hover:rotate-3">
            {provider.icon}
          </div>
          <p class="text-center text-sm font-black text-[#f2f5f7] transition-colors group-hover:text-[#bdcad2]">{provider.name}</p>
          <p class="mt-1 text-center text-[10px] text-[#b3bec6]">{provider.desc}</p>

          <span class="relative z-10 mt-4 block w-full rounded-full border border-[#5a1a1e] bg-[#0a0506] py-1.5 text-center text-[11px] font-bold text-[#bdcad2] shadow-inner transition-colors duration-300 group-hover:border-[#e01b2d]/60 group-hover:bg-gradient-to-r group-hover:from-[#ff3b46] group-hover:via-[#e01b2d] group-hover:to-[#8f0a13] group-hover:text-[#f2f5f7]">
            เข้าดูหมวดนี้
          </span>
        </a>
      ))
    }
  </div>
</section>
