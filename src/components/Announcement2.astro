---
const {
  message = "AMD365 รวมสล็อต คาสิโนสด กีฬา eSports และหวยออนไลน์ไว้ในบัญชีสมาชิกเดียว เปลี่ยนหมวดเกมได้โดยไม่ต้องสมัครยูสใหม่ • ระบบฝากถอนออโต้เชื่อมอยู่กับหน้าเมมเบอร์ ตรวจยอดเครดิตและสถานะรายการได้เองทุกครั้ง • หมวดสล็อตรวมเกมจาก PG Slot, Pragmatic Play, Joker และค่ายอื่น ๆ ที่เปิดอยู่ในระบบ • คาสิโนสดมีบาคาร่า รูเล็ต ไฮโล แบล็กแจ็ก เลือกโต๊ะจากหน้าเดียวได้เลย • หมวดกีฬาไม่ได้มีแค่ฟุตบอล ยังมีบาสเกตบอล เทนนิส มวย และ eSports ตามรายการที่เปิดให้บริการ • หวยออนไลน์เลือกตลาดได้ตามรอบที่ระบบกำหนด ตรวจเวลาเปิด-ปิดของแต่ละตลาดก่อนทำรายการ • เกมที่รองรับ DEMO ลองดูฟีเจอร์และจังหวะเกมก่อนใช้เครดิตจริงได้",
} = Astro.props;
---

<div class="relative mx-auto flex h-[42px] max-w-[900px] items-center overflow-hidden rounded-sm bg-[#0e0902] shadow-[0_4px_15px_rgba(0,0,0,0.5)]">
  <div class="relative z-10 flex h-full items-center bg-gradient-to-r from-[#a06a09] to-[#d4840e] px-6 pl-4 [clip-path:polygon(0_0,100%_0,85%_100%,0_100%)] md:px-8">
    <div class="flex items-center gap-2">
      <span class="relative flex h-2.5 w-2.5">
        <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-[#fec93a] opacity-75"></span>
        <span class="relative inline-flex h-2.5 w-2.5 rounded-full bg-[#fec93a]"></span>
      </span>
      <span class="font-black tracking-widest text-[#160e03] italic drop-shadow-md">HOT</span>
    </div>
  </div>

  <div class="relative flex-1 overflow-hidden">
    <div class="absolute inset-y-0 left-0 z-10 w-8 bg-gradient-to-r from-[#0e0902] to-transparent"></div>
    <div class="absolute inset-y-0 right-0 z-10 w-8 bg-gradient-to-l from-[#0e0902] to-transparent"></div>

    <div class="marquee-track flex w-max animate-[scroll_20s_linear_infinite] items-center gap-10 pl-4 text-sm font-bold whitespace-nowrap text-[#f4e8d2]/90 md:text-base">
      <span>{message}</span>
      <span>{message}</span>
      <span>{message}</span>
    </div>
  </div>

  <div class="absolute bottom-0 left-0 h-[2px] w-full bg-gradient-to-r from-[#c9ccd4] via-[#fec93a] to-transparent"></div>
</div>

<style>
  @keyframes scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(calc(-33.33% - 13px));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
    }
  }
</style>
