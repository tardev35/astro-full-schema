---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";
import CtaRedirect from "../components/CtaRedirect.astro";
import { pageGraph } from "../lib/schema";

const pageTitle = "เข้าสู่ระบบ RIEL38 | ปุ่มล็อกอินเข้าหน้าเมมเบอร์ เว็บสล็อตมาใหม่";

const pageDescription =
  "เข้าสู่ระบบ RIEL38 กดปุ่มเดียวไปยังหน้าล็อกอินด้วยยูสเดิม เข้าเล่นสล็อตกว่า 2,000 เกมจาก 30+ ค่ายดัง เช็กเครดิตผ่าน Smart Wallet ได้จากหน้าเมมเบอร์จุดเดียว";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เข้าสู่ระบบ", path: "/login" },
  ],
});

const targetUrl = "https://yoalink.com/22hs";
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="เข้าสู่ระบบ RIEL38" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label="เข้าสู่ระบบ RIEL38"
        class="group relative mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#db2777]/60 bg-gradient-to-b from-[#f472b6] to-[#db2777] px-6 py-4 text-xl font-bold tracking-wide text-white shadow-[0_10px_30px_rgba(236,72,153,0.24)] transition-all duration-300 hover:scale-105 hover:border-[#f9a8d4]/70 hover:shadow-[0_15px_40px_rgba(236,72,153,0.35)]">
        เข้าสู่ระบบ RIEL38
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="เข้าสู่ระบบ" />
</MainLayout>
