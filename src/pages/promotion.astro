---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementCyber.astro";

import { Picture } from "astro:assets";

import pro1 from "../assets/slide1.png";
import pro2 from "../assets/slide2.png";
import pro3 from "../assets/slide3.png";
import pro4 from "../assets/slide4.png";
import pro5 from "../assets/slide5.png";
import { pageGraph } from "../lib/schema";

const pageTitle = "โปรโมชั่น AMBHENG88 รวมโปรสายเฮง โบนัสฝาก ค่าคอม พร้อมวิธีคำนวณ";

const pageHeading = "โปรโมชั่น AMBHENG88 รวมโปรสายเฮง เลือกให้เป็น คำนวณให้คุ้ม";

const pageDescription =
  "โปรโมชั่น AMBHENG88 รวมโบนัสฝาก โปรนาทีทอง ค่าคอม และแนะนำเพื่อน พร้อมสอนวิธีคำนวณโบนัส เทิร์น และยอดถอนก่อนกดรับสิทธิ์ พร้อมตัวอย่างคำนวณจากยอดฝากจริง";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: pro1.src,
});

const promoClass =
  "mx-auto h-auto w-full rounded-xl border border-[#4a1030] object-contain shadow-[0_10px_30px_rgba(255,45,142,0.16)] transition-all duration-300 hover:-translate-y-1 hover:border-[#ff2d8e]/55 hover:shadow-[0_15px_40px_rgba(255,45,142,0.28)]";
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageHeading} as="h1">
    <p class="mb-4 text-left text-base leading-relaxed">
      หากคุณกำลังมองหาโปรที่กดรับเองได้จากหน้าเว็บ <strong class="text-[#ff74b6]">AMBHENG88</strong> รวมโบนัสฝาก โปรฝากรับเพิ่ม สิทธิ์แนะนำเพื่อน และอัตราจ่ายพิเศษไว้ในภาพด้านล่างนี้ครบแล้ว
    </p>

    <p class="mb-8 text-left text-base leading-relaxed">
      ยอดรับ เงื่อนไขเทิร์น และยอดถอนสูงสุดระบุไว้บนภาพทุกใบ เลือกใบที่ตรงกับงบและสไตล์การเล่นของคุณ แล้วสมัครยูสเดียวใช้ได้ทุกสิทธิ์ เพื่อประสบการณ์ที่คุ้มค่ากว่าเดิม
    </p>

    <div class="grid w-full grid-cols-1 gap-6 sm:grid-cols-2">
      <Picture
        src={pro1}
        alt="ภาพโปรโมชั่น AMBHENG88 ฝากรับโบนัสเพิ่ม 10% พื้นม่วงเข้มขอบทอง มีเพชรสีชมพูเรืองแสงอยู่กลางภาพ ข้อความบนภาพระบุ โบนัส 10% มูลค่าสูงสุด 500 บาท ฝากขั้นต่ำ 100 บาทต่อบิล ทำเทิร์น 8 เท่า ถอนได้สูงสุด 5 เท่า พร้อมตรา VIP EXCLUSIVE"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class={promoClass}
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />

      <Picture
        src={pro2}
        alt="ภาพโปรโมชั่น AMBHENG88 โบนัสฝาก 50% โลโก้ AMBHENG88 อยู่กลางภาพ ล้อมด้วยไพ่ ชิปคาสิโน ตู้สล็อตเลข 777 และหีบสมบัติเหรียญทอง ข้อความบนภาพระบุ ฝาก 1,000 บาทขึ้นไป รับโบนัส 50% สูงสุด 10,000 บาท ทำเทิร์น 5 เท่า ถอนได้สูงสุด 2 เท่า"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class={promoClass}
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />

      <Picture
        src={pro3}
        alt="ภาพโปรโมชั่น AMBHENG88 อัตราจ่ายที่ดีที่สุด ฉากเมืองนีออนสีชมพู มีพรีเซนเตอร์หญิงผมชมพูยืนอยู่ข้างข้อความ 3 ตัว บาทละ 1,000 บาท และ 2 ตัว บาทละ 100 บาท"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class={promoClass}
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />

      <Picture
        src={pro4}
        alt="ภาพโปรโมชั่น AMBHENG88 ครบจบในที่เดียว พรีเซนเตอร์หญิงทำมือเป็นรูปหัวใจอยู่กลางภาพ ข้างกันเป็นปุ่มสี่ปุ่ม หวย บาคาร่า บอล และสล็อต แถบด้านล่างเป็นเครื่องหมายถูกเรียงกัน บอล คาสิโน สล็อต ยิงปลา ไก่ชน มวย ไฮโล รูเล็ต"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class={promoClass}
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />

      <Picture
        src={pro5}
        alt="ภาพโปรโมชั่น AMBHENG88 แนะนำเพื่อนรับโบนัส 0.8% พรีเซนเตอร์หญิงสองคนถือชิปคาสิโนและไพ่อยู่สองข้างของข้อความ พร้อมบรรทัดล่างที่เขียนว่า สร้างรายได้ 100,000 ต่อเดือน"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class={promoClass}
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />
    </div>

    <p class="mt-10 mb-4 text-left text-base leading-relaxed">
      โปรโมชั่น AMBHENG88 มีหลายรูปแบบ ทั้งโบนัสฝาก โปรช่วงเวลา ค่าคอมจากยอดเล่น และสิทธิ์แนะนำเพื่อน แต่ละโปรไม่ได้เหมาะกับทุกคนเหมือนกัน สายเฮงที่อยากใช้โบนัสให้คุ้มควรดูให้ครบทั้งเปอร์เซ็นต์ที่ได้รับ ยอดฝากขั้นต่ำ เทิร์นโอเวอร์ และเพดานถอน ไม่ใช่เลือกจากตัวเลขโบนัสที่ดูสูงเพียงอย่างเดียว
    </p>
    <p class="text-left text-base leading-relaxed">
      โปรโมชั่นบางรายการอาจเปิดเฉพาะบางช่วงเวลา หรือมีการปรับเงื่อนไขตามรอบแคมเปญ หากข้อมูลหน้าเว็บกับหน้ารับโปรไม่ตรงกัน แนะนำให้สอบถามแอดมินผ่านหน้าติดต่อก่อนฝากทุกครั้ง เพราะโปรจริงในระบบอาจเปลี่ยนเร็วกว่าการอัปเดตหน้าเว็บ โดยรายละเอียดด้านล่างเป็นชุดโปรโมชั่นล่าสุดที่นำมาใช้เป็นแนวทางคำนวณได้
    </p>
  </ContentBox>

  <ContentBox title="โปรฝาก AMBHENG88 รับเพิ่ม 10% สายเฮงต้องฝากเท่าไรถึงได้โบนัสเท่าไร" as="h2">
    <p class="mb-4 text-left text-base leading-relaxed">
      โปรฝากเพิ่ม 10% เหมาะกับสมาชิก AMBHENG88 ที่อยากเพิ่มทุนจากยอดฝากแบบคำนวณง่าย เริ่มต้นจากยอดฝากขั้นต่ำตามที่ระบบกำหนด และรับโบนัสได้สูงสุด 500 บาท สิ่งที่ควรดูไม่ใช่แค่คำว่า “ได้เพิ่ม 10%” แต่ต้องเช็กด้วยว่าโบนัสที่รับมานั้นมีเทิร์นและเพดานถอนเท่าไร
    </p>
    <h3 class="mt-8 mb-3 text-lg font-extrabold tracking-wide text-[#ff74b6]">วิธีคำนวณโบนัสฝาก 10%</h3>
    <p class="mb-4 text-left text-base leading-relaxed">
      สูตรง่าย ๆ คือ
    </p>
    <p class="mb-4 rounded-xl border border-[#4a1030] bg-[#280a1c]/60 px-5 py-4 text-center text-base font-bold tracking-wide text-[#ffe814]">ยอดฝาก × 10% = โบนัสที่ได้รับ</p>
    <p class="mb-4 text-left text-base leading-relaxed">
      ตัวอย่าง
    </p>
    <ul class="mb-4 list-inside list-disc space-y-1 text-base leading-relaxed marker:text-[#ff2d8e]">
      <li>ฝาก 100 บาท → โบนัส 10 บาท</li>
      <li>ฝาก 500 บาท → โบนัส 50 บาท</li>
      <li>ฝาก 1,000 บาท → โบนัส 100 บาท</li>
      <li>ฝาก 5,000 บาท → โบนัส 500 บาท</li>
    </ul>
    <p class="mb-4 text-left text-base leading-relaxed">
      ถ้าโบนัสสูงสุดกำหนดไว้ที่ 500 บาท ต่อให้ฝากมากกว่านั้น โบนัสก็จะไม่เพิ่มเกินเพดานที่ระบบกำหนด
    </p>
    <h3 class="mt-8 mb-3 text-lg font-extrabold tracking-wide text-[#ff74b6]">วิธีดูว่าโปรนี้คุ้มกับเราหรือไม่</h3>
    <p class="mb-4 text-left text-base leading-relaxed">
      อย่าดูแค่โบนัส ให้ดูพร้อมกัน 3 จุด
    </p>
    <p class="mb-4 rounded-xl border border-[#4a1030] bg-[#280a1c]/60 px-5 py-4 text-center text-base font-bold tracking-wide text-[#ffe814]">เงินฝาก + โบนัส / เทิร์นที่ต้องทำ / ยอดถอนสูงสุด</p>
    <p class="text-left text-base leading-relaxed">
      เช่น ฝาก 1,000 บาท ได้โบนัส 100 บาท เงินรวมเป็น 1,100 บาท ถ้าโปรกำหนดเทิร์น 8 เท่า สมาชิกควรคำนวณภาระยอดเล่นก่อนรับสิทธิ์ เพื่อดูว่าเหมาะกับสไตล์การเล่นของตัวเองหรือไม่
    </p>
  </ContentBox>

  <ContentBox title="นาทีทอง AMBHENG88 ฝากถูกเวลา รับเพิ่ม 10% เช้า–เย็น" as="h2">
    <p class="mb-4 text-left text-base leading-relaxed">
      สำหรับสายเฮงที่ชอบเลือกจังหวะฝาก โปรนาทีทองผ่าน AutoPeer แบ่งช่วงรับสิทธิ์เป็นรอบเช้าและรอบเย็น โดยรับโบนัสเพิ่ม 10% ตามยอดฝาก และมีเพดานโบนัสตามที่ระบบกำหนด จุดสำคัญคือ ฝากถูกช่องทางแต่ผิดเวลา หรือถูกเวลาแต่ผิดช่องทาง ก็อาจไม่ได้รับสิทธิ์
    </p>
    <h3 class="mt-8 mb-3 text-lg font-extrabold tracking-wide text-[#ff74b6]">วิธีเช็กโปรนาทีทองก่อนฝาก</h3>
    <p class="mb-4 text-left text-base leading-relaxed">
      ก่อนกดยืนยัน ให้เช็ก 3 อย่าง
    </p>
    <p class="mb-4 rounded-xl border border-[#4a1030] bg-[#280a1c]/60 px-5 py-4 text-center text-base font-bold tracking-wide text-[#ffe814]">เวลา → ช่องทาง AutoPeer → สถานะโปรโมชั่น</p>
    <p class="mb-4 text-left text-base leading-relaxed">
      ช่วงเวลาที่ใช้อยู่ล่าสุดคือรอบเช้า 09.00–13.00 น. และรอบเย็น 18.00–22.00 น. แต่เนื่องจากโปรประเภทนี้เปลี่ยนตามแคมเปญได้ จึงควรตรวจสอบในระบบหรือสอบถามแอดมินอีกครั้งก่อนฝาก
    </p>
    <h3 class="mt-8 mb-3 text-lg font-extrabold tracking-wide text-[#ff74b6]">ฝากนาทีทองเท่าไร ได้เพิ่มเท่าไร</h3>
    <p class="mb-4 text-left text-base leading-relaxed">
      ใช้สูตรเดียวกัน
    </p>
    <p class="mb-4 rounded-xl border border-[#4a1030] bg-[#280a1c]/60 px-5 py-4 text-center text-base font-bold tracking-wide text-[#ffe814]">ยอดฝาก × 10% = โบนัส</p>
    <p class="text-left text-base leading-relaxed">
      ตัวอย่าง ฝาก 300 บาท ได้เพิ่ม 30 บาท หรือฝาก 1,000 บาท ได้เพิ่ม 100 บาท โดยยอดโบนัสจริงต้องไม่เกินเพดานที่โปรโมชั่นกำหนด
    </p>
  </ContentBox>

  <ContentBox title="แนะนำเพื่อน AMBHENG88 รับค่าคอมสูงสุด 0.8% ยิ่งเพื่อนเล่นยิ่งมีสิทธิ์รับเพิ่ม" as="h2">
    <p class="mb-4 text-left text-base leading-relaxed">
      โปรแนะนำเพื่อนต่างจากโบนัสฝากตรงที่ไม่ได้รับจากยอดฝากของตัวเอง แต่คำนวณจากยอดเดิมพันของเพื่อนที่สมัครผ่านลิงก์แนะนำและทำตามเงื่อนไขครบ ระบบจึงจะนำยอดที่เข้าเกณฑ์มาคิดค่าคอมให้
    </p>
    <h3 class="mt-8 mb-3 text-lg font-extrabold tracking-wide text-[#ff74b6]">วิธีคำนวณค่าคอมแนะนำเพื่อน 0.8%</h3>
    <p class="mb-4 text-left text-base leading-relaxed">
      สูตร
    </p>
    <p class="mb-4 rounded-xl border border-[#4a1030] bg-[#280a1c]/60 px-5 py-4 text-center text-base font-bold tracking-wide text-[#ffe814]">ยอดเดิมพันที่เข้าเกณฑ์ × 0.8% = ค่าคอม</p>
    <p class="mb-4 text-left text-base leading-relaxed">
      ตัวอย่าง
    </p>
    <ul class="mb-4 list-inside list-disc space-y-1 text-base leading-relaxed marker:text-[#ff2d8e]">
      <li>ยอดเล่น 1,000 บาท → 8 บาท</li>
      <li>ยอดเล่น 10,000 บาท → 80 บาท</li>
      <li>ยอดเล่น 100,000 บาท → 800 บาท</li>
    </ul>
    <p class="text-left text-base leading-relaxed">
      ตัวเลขนี้เป็นการคำนวณตามอัตราสูงสุด 0.8% หากระบบแบ่งระดับสมาชิกหรือมีเงื่อนไขอื่น ควรเช็กอัตราจริงก่อนนำไปคำนวณ
    </p>
  </ContentBox>

  <ContentBox title="ค่าคอม AMBHENG88 0.3% สายเล่นต่อเนื่องคำนวณยอดคืนได้เอง" as="h2">
    <p class="mb-4 text-left text-base leading-relaxed">
      สำหรับสมาชิกที่มีรอบเล่นต่อเนื่อง ค่าคอม 0.3% เป็นอีกสิทธิ์ที่ควรดู เพราะคำนวณจากยอดเดิมพันที่มีผล ไม่ได้ดูว่ารอบนั้นชนะหรือแพ้เพียงอย่างเดียว เมื่อระบบตัดยอดแล้ว สมาชิกสามารถตรวจสอบเครดิตที่ได้รับตามช่วงเวลาที่กำหนด
    </p>
    <h3 class="mt-8 mb-3 text-lg font-extrabold tracking-wide text-[#ff74b6]">วิธีคำนวณค่าคอม 0.3%</h3>
    <p class="mb-4 text-left text-base leading-relaxed">
      สูตร
    </p>
    <p class="mb-4 rounded-xl border border-[#4a1030] bg-[#280a1c]/60 px-5 py-4 text-center text-base font-bold tracking-wide text-[#ffe814]">ยอดเดิมพันที่มีผล × 0.3% = ค่าคอมที่ได้รับ</p>
    <p class="mb-4 text-left text-base leading-relaxed">
      ตัวอย่าง
    </p>
    <ul class="mb-4 list-inside list-disc space-y-1 text-base leading-relaxed marker:text-[#ff2d8e]">
      <li>ยอดเล่น 10,000 บาท → 30 บาท</li>
      <li>ยอดเล่น 100,000 บาท → 300 บาท</li>
      <li>ยอดเล่น 1,000,000 บาท → 3,000 บาท</li>
    </ul>
    <p class="text-left text-base leading-relaxed">
      ตรงนี้ทำให้สมาชิกประเมินได้ตั้งแต่ก่อนกดรับว่า ยอดเล่นระดับไหนจะได้เครดิตคืนประมาณเท่าไร
    </p>
  </ContentBox>

  <ContentBox title="สายเฮงเลือกโปรอย่างไร ไม่ให้โบนัสเยอะแต่เงื่อนไขหนักเกินไป" as="h2">
    <p class="mb-4 text-left text-base leading-relaxed">
      โปรที่ให้เปอร์เซ็นต์สูงไม่ได้แปลว่าคุ้มที่สุดเสมอไป ก่อนรับโปรโมชั่น AMBHENG88 ควรเทียบโบนัสที่ได้ เทิร์นที่ต้องทำ เพดานถอน จำนวนครั้งที่รับได้ และเวลาที่เปิดรับสิทธิ์พร้อมกัน เพราะบางคนเหมาะกับโบนัสฝาก ขณะที่บางคนเล่นต่อเนื่องแล้วคุ้มกว่ากับค่าคอม
    </p>
    <p class="text-left text-base leading-relaxed">
