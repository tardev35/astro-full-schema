---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#8f1080]/80 bg-[#1a0414]/92 p-8 text-left text-base leading-relaxed text-[#f7e3f4] shadow-[0_10px_30px_rgba(255,61,219,0.22)] backdrop-blur-xl transition-all duration-500 hover:border-[#f5c451]/55 hover:shadow-[0_15px_40px_rgba(245,196,81,0.26)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#ff3ddb]/45 blur-[60px] transition-all duration-500 group-hover:bg-[#ffa3ee]/30"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#b07d1c]/40 blur-[60px] transition-all duration-500 group-hover:bg-[#f5c451]/25"></div>

    {
      title && (
        <header class="mb-6 flex items-center gap-4 border-b border-[#8f1080]/80 pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffe6a3] to-[#ff3ddb] shadow-[0_0_10px_rgba(245,196,81,0.5)]" />
          <HeadingTag class="bg-gradient-to-r from-[#ffe6a3] via-[#f5c451] to-[#ffa3ee] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
