---
export interface FeatureItem {
  icon: string;
  title: string;
  description: string;
  accent?: "gold" | "purple";
}

export interface Props {
  items: FeatureItem[];
  as?: "h3" | "h4" | "p";
}

const { items, as: HeadingTag = "h3" } = Astro.props;
---

<div class="mt-4 flex flex-col gap-5">
  {
    items.map((item) => {
      const isGold = item.accent !== "purple";
      return (
        <div
          class={`group flex flex-col items-start gap-4 rounded-2xl border p-6 transition-all duration-300 hover:-translate-y-1 sm:flex-row ${
            isGold
              ? "border-[#a86f00]/55 bg-[#2c1247] hover:border-[#fdc700]/70 hover:bg-[#331652] hover:shadow-[0_10px_20px_rgba(253,199,0,0.20)]"
              : "border-[#6d28d9] bg-[#241040] hover:border-[#a855f7]/70 hover:bg-[#331652] hover:shadow-[0_10px_20px_rgba(168,85,247,0.22)]"
          }`}>
          <div
            aria-hidden="true"
            class={`flex h-14 w-14 shrink-0 items-center justify-center rounded-xl text-3xl transition-transform duration-300 group-hover:scale-110 ${
              isGold
                ? "border border-[#ffe680]/55 bg-gradient-to-br from-[#ffe680] via-[#fdc700] to-[#a86f00] shadow-[0_0_15px_rgba(253,199,0,0.35)] group-hover:rotate-3"
                : "border border-[#c98bff]/45 bg-gradient-to-br from-[#a855f7] via-[#8b6fb8] to-[#6d28d9] shadow-[0_0_15px_rgba(168,85,247,0.35)]"
            }`}>
            {item.icon}
          </div>
          <div class="flex flex-col gap-2 text-left">
            <HeadingTag class={`text-xl leading-normal font-black tracking-wide ${isGold ? "text-[#ffe680]" : "text-[#c98bff]"}`}>{item.title}</HeadingTag>
            <p class="text-left text-base leading-relaxed text-[#ede4fb] transition-colors group-hover:text-[#ffe680]">{item.description}</p>
          </div>
        </div>
      );
    })
  }
</div>
