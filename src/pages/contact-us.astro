---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";

import { Picture } from "astro:assets";
import imgLine from "../assets/contact-line.webp";
import { pageGraph } from "../lib/schema";
import { BRAND_ADDRESS } from "../lib/brandProfile";

const pageTitle = "ติดต่อทีมงาน MEEHAY569 | สอบถามผ่าน LINE Official";

const pageDescription =
  "ติดต่อทีมงาน MEEHAY569 ผ่าน LINE Official เมื่อสมัครไม่ผ่าน ล็อกอินไม่ได้ หรือโอนทรูวอเลทแล้วเครดิตไม่ขึ้น อย่าเพิ่งโอนซ้ำ แจ้งเวลากับยอดเงินให้ทีมงานตรวจสอบ";

const announcementMessage =
  "MEEHAY569 สล็อตเว็บตรง ไม่ผ่านเอเย่นต์ • ฝากถอนทรูวอเลทออโต้ เริ่ม 1 บาท ตลอด 24 ชั่วโมง ไม่ต้องส่งสลิป • ทดลองเล่นสล็อตได้โดยไม่ต้องฝากเงินหรือสมัครก่อน • สมัครง่าย 4 ขั้นตอน เล่นได้ทั้งเว็บมือถือ แอป และคอม";

const graph = pageGraph(Astro, {
  type: "ContactPage",
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ติดต่อเรา", path: "/contact-us" },
  ],
  org: {
    contactPoints: [
      {
        contactType: "customer service",
        availableLanguage: ["Thai"],
        path: "/line",
        description: "ติดต่อทีมงาน MEEHAY569 ผ่าน LINE Official สอบถามการสมัครสมาชิก การเข้าสู่ระบบ และการฝากถอนทรูวอเลท",
      },
    ],
  },
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement message={announcementMessage} />

  <ContentBox title="ติดต่อทีมงาน MEEHAY569" as="h1">
    <div>
      <Picture
        src={imgLine}
        alt="ภาพช่องทางติดต่อทีมงาน MEEHAY569 ทาง LINE ไอคอนแอป LINE สีเขียวทรงสี่เหลี่ยมมุมมน มีกรอบข้อความสีครีมที่เขียนคำว่า LINE อยู่ตรงกลาง ด้านบนเป็นวงกลมลูกศรสีเขียวล้อมตัวเลข 24h และมีผู้หญิงผมดำรวบตึง สวมชุดราตรีซาตินสีเขียวเข้มเปิดไหล่ ใส่สร้อยคอสีทอง ยืนอยู่ทางขวาของภาพ"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600]}
        sizes="(max-width: 768px) 100vw, 400px"
        class="mx-auto h-auto w-full max-w-[400px] object-contain"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={60}
      />
      {
        BRAND_ADDRESS.lines.length > 0 && (
          <address aria-label={BRAND_ADDRESS.label} class="mt-8 mb-8 rounded-r-xl border-l-4 border-[#00a4d4] bg-[#e8f7fd] py-4 pr-4 pl-6 text-left text-base leading-relaxed text-[#5a6b7a] not-italic">
            <span class="mb-1 block font-bold text-[#0c3550]">{BRAND_ADDRESS.label}</span>
            {BRAND_ADDRESS.lines.map((line) => (
              <span class="block">{line}</span>
            ))}
            {BRAND_ADDRESS.email && (
              <span class="mt-3 block">
                <span aria-hidden="true" class="mr-2">
                  ✉️
                </span>
                <a href={`mailto:${BRAND_ADDRESS.email}`} class="font-bold text-[#006d99] underline underline-offset-4 transition-colors hover:text-[#a35000]">
                  {BRAND_ADDRESS.email}
                </a>
              </span>
            )}
          </address>
        )
      }

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/register/"
          aria-label="สมัครสมาชิก MEEHAY569"
          class="flex items-center justify-center rounded-xl border-2 border-white bg-gradient-to-b from-[#ffd23f] via-[#ffb84d] to-[#f7941d] px-8 py-3 font-black text-[#4a1d00] shadow-[0_10px_30px_rgba(247,148,29,0.40)] transition-all hover:scale-105 hover:brightness-110 hover:shadow-[0_15px_40px_rgba(247,148,29,0.50)]">
          สมัครสมาชิก
        </a>

        <a
          href="/login/"
          aria-label="เข้าสู่ระบบ MEEHAY569"
          class="flex items-center justify-center rounded-xl border-2 border-white bg-gradient-to-b from-[#19b2e0] to-[#0077b3] px-8 py-3 font-bold text-white shadow-[0_10px_30px_rgba(0,164,212,0.35)] transition-all hover:scale-105 hover:brightness-110 hover:shadow-[0_15px_40px_rgba(0,164,212,0.45)]">
          เข้าสู่ระบบ
        </a>

        <a
          href="/line/"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="ติดต่อทีมงาน MEEHAY569 ผ่าน Line Official"
          class="flex items-center justify-center rounded-xl border border-[#00B900]/70 bg-[#00B900] px-8 py-3 font-bold text-white shadow-[0_8px_24px_rgba(0,185,0,0.25)] transition-transform hover:scale-105 hover:bg-[#00a300]">
          ติดต่อผ่าน Line Official
        </a>
      </div>
    </div>
  </ContentBox>
  <Navfoot />
</MainLayout>
