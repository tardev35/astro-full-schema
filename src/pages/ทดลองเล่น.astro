---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement6.astro";

import { Picture } from "astro:assets";
import { itemList, pageGraph, schemaCtx } from "../lib/schema";
import image1 from "../assets/gamedemo7.webp";
import image2 from "../assets/gamedemo8.webp";
import image3 from "../assets/gamedemo9.webp";
import image4 from "../assets/gamedemo10.webp";
import image5 from "../assets/gamedemo11.webp";
import image6 from "../assets/gamedemo12.webp";
import image7 from "../assets/gamedemo13.webp";
import image8 from "../assets/gamedemo14.webp";
import image9 from "../assets/gamedemo15.webp";
import image10 from "../assets/gamedemo16.webp";
import image11 from "../assets/gamedemo17.webp";
import image12 from "../assets/gamedemo18.webp";

const demoGames = [
  { name: "AskmeSlot", src: image1, alt: "แบนเนอร์ค่าย askmeslot โลโก้โพดำสีทองที่มีสัญลักษณ์ไพ่อยู่ข้างใน คู่กับตัวการ์ตูนเด็กชายสวมหมวกแดงติดดาว กางแขนวิ่งบนถนนในเมืองยุโรปที่มีกังหันลม" },
  { name: "Popular Game", src: image2, alt: "แบนเนอร์ Popular Game ตัวอักษรทองนูนหน้าวงแหวนชิปคาสิโนสีทอง ขนาบด้วยกระต่ายถือหีบสมบัติกับแมวใส่แว่นกันแดด ท่ามกลางเหรียญทองและชิปที่ลอยฟุ้ง" },
  { name: "SlotXO", src: image3, alt: "แบนเนอร์ค่าย SLOTXO โลโก้ตู้สล็อตล้อมด้วยเหรียญทอง คู่กับนักรบโรมันผมขาวสวมมงกุฎใบลอเรลและเกราะทอง ยืนหน้าโคลอสเซียมกับทหารอีกสองนาย" },
  { name: "Skywind Group", src: image4, alt: "แบนเนอร์ค่าย Skywind Group โลโก้วงกลมสี่สีบนพื้นดำ คู่กับแมวกวักนำโชคสีขาวคาดกระพรวนทอง ยืนข้างไหทองและถุงเงินสีม่วงใต้ต้นซากุระ" },
  { name: "PG Soft", src: image5, alt: "แบนเนอร์ค่าย PG Pocket Games Soft โลโก้ตัวอักษรพิกเซลบนพื้นดำ คู่กับตัวละครหญิงนักรบผิวแทนสวมเครื่องประดับทองและหมวกขนนกสไตล์แอซเท็ก" },
  { name: "SBOBET", src: image6, alt: "แบนเนอร์ค่ายเกม SBOBET โลโก้ตัวอักษรขาวบนพื้นดำ คู่กับตัวการ์ตูนอนิเมะสาวหูจิ้งจอกผมบลอนด์ในชุดกิโมโนสีชมพู มือถืออมยิ้มเกลียวหลากสี" },
  { name: "Sexy Slot", src: image7, alt: "แบนเนอร์ค่าย Sexy Slot ตัวอักษรสีชมพูม่วงมีประกายวิบวับ คู่กับตัวการ์ตูนสาวผมน้ำตาลในชุดรัดรูปสีม่วง นั่งอยู่ในกรอบวงกลมที่ล้อมด้วยหัวใจสีชมพู" },
  { name: "JILI", src: image8, alt: "แบนเนอร์ค่ายเกม JILI ตัวอักษรทองบนพื้นดำ คู่กับนางเงือกผมแดงสวมเกราะเปลือกหอยสีทอง ยกหอยสังข์แนบหูอยู่ใต้ทะเลที่มีปลาการ์ตูนและปะการัง" },
  { name: "Ask Me Bet", src: image9, alt: "แบนเนอร์ค่ายเกม ask me bet โลโก้สามช่องสีขาวเขียวเหลืองบนพื้นดำ คู่กับหัวสิงโตเชิดสีแดงทองตาโต ใต้แถวโคมไฟสีแดงหน้าศาลเจ้า" },
  { name: "New Game", src: image10, alt: "แบนเนอร์ New Game ตัวอักษรสีขาวนูนกลางภาพ ขนาบด้วยตัวการ์ตูนฟักทองหัวไฟกับโครงกระดูกยิ้ม ยืนบนฟลอร์นีออนสีชมพูฟ้าที่เกลื่อนด้วยชิปและลูกเต๋า" },
  { name: "JOKER", src: image11, alt: "แบนเนอร์ค่ายเกม JOKER ตัวอักษรขาวทองบนพื้นดำ คู่กับนักรบโรมันสวมหมวกเหล็กติดขนนกและถือโล่ ยืนเคียงสิงโตกำลังคำรามกลางสนามประลอง" },
  { name: "AFB Gaming", src: image12, alt: "แบนเนอร์ค่ายเกม AFB Gaming โลโก้ตัวอักษรทองบนพื้นดำ คู่กับเทพซุสเคราขาวตาเรืองแสงสีฟ้า สวมมงกุฎใบลอเรลและกำไลทองหน้าวิหารกรีก" },
];

const gameList = demoGames.map((game) => ({ name: game.name, imagePath: game.src.src }));

const pageTitle = "ทดลองเล่นสล็อต PIGAUTO ลองหลายค่ายให้พอใจ ก่อนลงเครดิตจริง";

const pageHeading = "ทดลองเล่นสล็อตกับ PIGAUTO เลือกค่ายที่ชอบ แล้วลองให้พอใจก่อนลงเครดิตจริง";

const pageDescription =
  "ทดลองเล่นสล็อตฟรีกับ PIGAUTO เลือกค่ายที่สนใจ สมัครยูสเดียวใช้เวลาไม่กี่นาที แล้วเข้าโหมดทดลองของค่ายนั้น ดูฟีเจอร์และเดิมพันต่อรอบให้พอใจก่อนลงเครดิตจริง";

const ctx = schemaCtx(Astro);
const graph = pageGraph(Astro, {
  type: "CollectionPage",
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  ],
  extra: [
    itemList(ctx, {
      name: "ทดลองเล่นเกมของ PIGAUTO",
      alternateName: "PIGAUTO โหมดทดลองเล่นสล็อตลิขสิทธิ์แท้หลายค่ายบนมือถือก่อนลงเครดิตจริง",
      itemType: "Game",
      items: gameList,
    }),
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox as="h1" title={pageHeading}>
    <p class="mb-4 text-left text-base leading-relaxed text-[#f7e4d4]">
      หากคุณกำลังมองหาเว็บที่ได้ลองก่อนตัดสินใจ <strong class="text-[#ffe08a]">PIGAUTO</strong> พร้อมมอบโหมดทดลองจากค่ายดังที่ต่อตรงผ่าน API แท้ ทั้ง PG Soft, JILI, JOKER, SlotXO และ Skywind
    </p>

    <p class="mb-4 text-left text-base leading-relaxed text-[#f7e4d4]">
      เลือกค่ายที่สนใจจากด้านล่าง สมัครยูสเดียวใช้เวลาไม่กี่นาที แล้วเข้าไปลองโหมดทดลองของค่ายนั้นต่อได้จากหน้าเมมเบอร์
    </p>

    <p class="text-left text-base leading-relaxed text-[#f7e4d4]">เปิดจากมือถือ แท็บเล็ต หรือคอมก็ได้เหมือนกัน ใช้ยูสเดิมตัวเดียวทุกเครื่อง</p>
  </ContentBox>

  <ContentBox as="h2" title="ค่ายไหนสะดุดตา เลือกได้เลย PIGAUTO เปิดให้ลองครบทุกค่าย">
    <p class="mb-4 text-left text-base leading-relaxed text-[#f7e4d4]">
      ค่ายไหนก็ได้ที่ถูกตา เริ่มจากตรงนั้นเลย เพราะแต่ละค่ายมีจังหวะและฟีเจอร์เป็นของตัวเอง ทั้งสล็อตหมุนคลาสสิก เกมฟรีสปิน เกมโบนัส และยิงปลา
    </p>

    <p class="mb-4 text-left text-base leading-relaxed text-[#f7e4d4]">
      กดที่ภาพค่ายที่สนใจเพื่อไปยังขั้นตอนสมัคร เปิดยูสเสร็จก็เข้าใช้งานค่ายนั้นได้ทันที ทุกเกมเชื่อมตรงจากค่ายผู้พัฒนา จึงออกโบนัสตามค่ามาตรฐานของค่ายจริง
    </p>

    <p class="mb-8 text-left text-base leading-relaxed text-[#f7e4d4]">ยูสเดียวสลับได้ทุกค่าย ไม่ต้องเปิดบัญชีใหม่ทีละค่าย</p>
    <div class="mb-5 grid grid-cols-2 gap-5 sm:grid-cols-2 md:grid-cols-4">
      {
        demoGames.map((game) => (
          <div class="group/game relative mx-auto w-full max-w-[400px] overflow-hidden rounded-xl">
            <Picture
              src={game.src}
              alt={game.alt}
              loading="lazy"
              fetchpriority="low"
              widths={[200, 400, 600]}
              sizes="(max-width: 768px) 50vw, 25vw"
              class="block h-auto w-full object-cover shadow-[0_10px_30px_rgba(245,197,66,0.16)] transition-transform duration-300 group-hover/game:scale-105"
              decoding="async"
              formats={["avif", "webp"]}
              fallbackFormat="webp"
              quality={60}
            />
            <a
              href="/register"
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`สมัครสมาชิกเพื่อลองเล่น ${game.name} ที่ PIGAUTO`}
              class="absolute inset-0 flex items-center justify-center bg-[#1f0303]/85 opacity-0 transition-opacity duration-300 group-hover/game:opacity-100 focus-visible:opacity-100">
              <span class="rounded-full border border-[#b07d12]/60 bg-gradient-to-r from-[#ffe08a] via-[#f5c542] to-[#d99e1f] px-6 py-2 font-bold text-[#1f0303] shadow-[0_10px_30px_rgba(245,197,66,0.32)] transition-transform hover:scale-110">สมัครเพื่อลอง</span>
            </a>
          </div>
        ))
      }
    </div>
  </ContentBox>

  <ContentBox as="h2" title="ทดลองเล่นฟรีไม่จำกัดรอบ ลองให้พอใจก่อนใช้เครดิตจริง">
    <p class="mb-4 text-left text-base leading-relaxed text-[#f7e4d4]">
      เข้าโหมดทดลองแล้วหมุนได้ไม่จำกัดรอบ เพราะเป็นเครดิตสมมติล้วนๆ อยากลองผิดลองถูกกี่ครั้งก็ตามสบาย ไม่มีอะไรต้องเสี่ยงเลยสักบาท
    </p>

    <p class="mb-4 text-left text-base leading-relaxed text-[#f7e4d4]">
      ระหว่างลองก็ดูไปด้วยว่าเดิมพันต่อรอบเริ่มที่เท่าไร ฟีเจอร์เข้าง่ายแค่ไหน หนึ่งรอบกินเวลานานไหม แล้วเก็บไว้เป็นข้อมูลตอนเลือกเกมที่จะเล่นจริง
    </p>

    <p class="mb-4 text-left text-base leading-relaxed text-[#f7e4d4]">เครดิตในโหมดทดลองถอนไม่ได้ และไม่นับเป็นยอดเทิร์นของโปรใดๆ</p>

    <p class="text-left text-base leading-relaxed text-[#f7e4d4]">
      อีกอย่างคือไม่ใช่ทุกเกมที่มีปุ่มทดลอง ถ้าเกมที่อยากลองยังไม่เปิดโหมดนี้ ทักทีมงานที่ดูแลอยู่ตลอด 24 ชั่วโมงให้ช่วยแนะนำเกมใกล้เคียงได้
    </p>
  </ContentBox>

  <ContentBox as="h2" title="พร้อมเมื่อไหร่ สมัคร PIGAUTO ยูสเดียว เริ่มเล่นจริงได้ทันที">
    <p class="mb-4 text-left text-base leading-relaxed text-[#f7e4d4]">
      สมัครจบในไม่กี่นาที ไม่ต้องรอคุยกับแอดมิน แล้วได้ยูสเดียวที่ใช้ได้กับทุกค่ายในเว็บ
    </p>

    <p class="mb-4 text-left text-base leading-relaxed text-[#f7e4d4]">
      ฝากถอนเป็นระบบออโต้ ยอดเข้าภายใน 3 วินาที ไม่ต้องส่งสลิป รองรับทั้งบัญชีธนาคารและทรูมันนี่วอเลท เริ่มได้ตั้งแต่ 1 บาท ไม่มีขั้นต่ำ
    </p>

    <p class="mb-4 text-left text-base leading-relaxed text-[#f7e4d4]">อีกอย่างที่ควรติดตัวไว้เสมอ อย่าบอกรหัสผ่านหรือรหัส OTP ให้ใครทั้งนั้น</p>

    <p class="text-left text-base leading-relaxed text-[#f7e4d4]">
      เลือกค่ายที่ถูกใจแล้วเริ่มได้เลย เกมที่คุณคุ้นมือวันนี้ คือเกมที่พร้อมลงเครดิตจริงในรอบถัดไป เพื่อประสบการณ์การเล่นที่คุ้มค่าและต่อเนื่องกว่าที่เคย
    </p>
  </ContentBox>

  <Navfoot />
</MainLayout>
