---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#6b0d1e] bg-[#2a0509]/92 p-8 text-left text-base leading-relaxed text-[#f9dfe3] shadow-[0_10px_30px_rgba(237,1,51,0.16)] transition-all duration-500 hover:border-[#ed0133]/60 hover:shadow-[0_15px_40px_rgba(237,1,51,0.26)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#ed0133]/20 blur-[60px] transition-all duration-500 group-hover:bg-[#ff3d63]/28"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#f0b429]/16 blur-[60px] transition-all duration-500 group-hover:bg-[#ffdb7d]/24"></div>

    {
      title && (
        <header class="mb-6 flex items-center gap-4 border-b border-[#6b0d1e] pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ed0133] to-[#f0b429] shadow-[0_0_10px_rgba(237,1,51,0.45)]" />
          <HeadingTag class="bg-gradient-to-r from-[#ff3d63] via-[#ffdb7d] to-[#f0b429] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
