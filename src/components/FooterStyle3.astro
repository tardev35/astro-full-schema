---
import { Picture } from "astro:assets";
import BankStrip from "./BankStrip.astro";
import { BRAND_ADDRESS } from "../lib/brandProfile";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });

const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

const quickLinks = [
  { name: "หน้าแรก", path: "/" },
  { name: "ทดลองเล่นเกมฟรี", path: "/ทดลองเล่น" },
  { name: "โปรโมชั่นสมาชิกใหม่", path: "/promotion" },
  { name: "ทางเข้าล่าสุด", path: "/ทางเข้า" },
  { name: "เกี่ยวกับเรา", path: "/about-us" },
  { name: "สมัครสมาชิก", path: "/register" },
  { name: "เข้าสู่ระบบ", path: "/login" },
  { name: "ติดต่อแอดมิน", path: "/contact-us" },
];

const logoAlt = "โลโก้ VING999 ตัวอักษร VING สีโครเมียมเงินวางในวงแหวนโลหะ ใต้ลงมาเป็นเลข 999 สีแดงพร้อมเส้นความเร็วสีแดงพุ่งไปทางขวา";
---

<footer class="relative mt-32 w-full border-t border-[#bdcad2]/25 bg-[#0e0708] pt-64 pb-6 font-sans text-[#dce3e8] shadow-[0_-10px_30px_rgba(143,10,19,0.35)] md:pt-40">
  <div
    class="absolute -top-14 left-1/2 z-20 flex w-[92%] max-w-5xl -translate-x-1/2 flex-col items-center justify-between rounded-2xl border border-[#bdcad2]/35 bg-gradient-to-r from-[#1c0a0c] via-[#8f0a13] to-[#1c0a0c] p-6 shadow-[0_15px_40px_rgba(224,27,45,0.3)] md:-top-16 md:flex-row md:p-8">
    <div class="mb-5 flex flex-col text-center md:mb-0 md:text-left">
      <p class="text-xl font-black tracking-wide text-white uppercase italic drop-shadow-[0_2px_4px_rgba(10,5,6,0.6)] md:text-3xl">
        <span aria-hidden="true">🎰</span> พร้อมหมุนสล็อตเว็บตรงกับ VING999 แล้วหรือยัง?
      </p>
      <p class="mt-2 text-sm font-medium text-[#dce3e8]/90 md:text-base">
        สมัครยูสเดียวได้เกมค่ายดังครบทุกหมวด เปลี่ยนเกมกี่รอบก็ใช้เครดิตชุดเดิม พร้อมระบบฝากถอนออโต้ที่รองรับทั้งบัญชีธนาคารและ TrueWallet จบได้จากหน้าเมมเบอร์
      </p>
    </div>

    <a
      href="/register"
      class="group relative flex items-center justify-center overflow-hidden rounded-full border border-[#bdcad2] bg-gradient-to-b from-[#f2f5f7] to-[#bdcad2] px-8 py-3.5 text-sm font-extrabold whitespace-nowrap text-[#1c0a0c] shadow-[0_0_15px_rgba(189,202,210,0.45)] transition-all hover:scale-105 md:text-base">
      <span class="relative z-10">สมัครสมาชิกเลย <span aria-hidden="true">🚀</span></span>
      <div aria-hidden="true" class="absolute inset-0 translate-y-full bg-[#e01b2d] transition-transform duration-300 group-hover:translate-y-0"></div>
    </a>
  </div>

  <div class="relative z-10 mx-auto max-w-[1200px] px-6">
    <div class="mb-10 grid grid-cols-1 gap-10 md:grid-cols-12 lg:gap-12">
      <div class="flex flex-col gap-6 md:col-span-12 lg:col-span-4">
        <a href="/" class="inline-block origin-left transition-transform hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt={logoAlt}
                widths={[100, 200, 300]}
                sizes="100px"
                height={45}
                loading="lazy"
                decoding="async"
                class="h-[45px] w-auto rounded-md bg-white/95 px-1.5 py-1 drop-shadow-[0_0_12px_rgba(224,27,45,0.55)]"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <p class="bg-gradient-to-b from-white to-[#bdcad2] bg-clip-text text-3xl font-black text-transparent drop-shadow-[0_0_8px_rgba(189,202,210,0.5)]">VING999</p>
            )
          }
        </a>
        <p class="text-sm leading-relaxed text-[#dce3e8]/80">
          VING999 รวมสล็อตออนไลน์จากหลายค่ายไว้ในยูสเดียว แบ่งหมวดให้กลับเกมประจำหรือหาเกมใหม่ได้เร็ว เครดิต โปรโมชั่น และประวัติรายการอยู่ในหน้าเมมเบอร์เดียวกัน
          พร้อมระบบฝากถอนออโต้ที่รองรับทั้งบัญชีธนาคารและ TrueWallet ทำรายการและตามสถานะได้เอง
        </p>

        <div class="mt-2 flex flex-wrap gap-3">
          <a
            href="/line"
            class="flex items-center gap-2 rounded-full border border-[#00B900]/40 bg-[#00B900]/15 px-4 py-2 text-xs font-bold text-[#8fe6a8] shadow-[0_0_10px_rgba(0,185,0,0.15)] transition-colors hover:bg-[#00B900] hover:text-white">
            <span aria-hidden="true" class="text-base">💬</span> LINE OFFICIAL
          </a>
        </div>

        {
          BRAND_ADDRESS.lines.length > 0 && (
            <address aria-label={BRAND_ADDRESS.label} class="mt-2 rounded-xl border border-white/15 bg-black/20 p-4 text-xs leading-relaxed not-italic opacity-90">
              <p class="mb-2 flex items-center gap-2 text-[11px] font-bold tracking-wider uppercase opacity-80">
                <span aria-hidden="true" class="text-sm">📍</span>
                {BRAND_ADDRESS.label}
              </p>
              {BRAND_ADDRESS.lines.map((line) => (
                <span class="block">{line}</span>
              ))}
              {BRAND_ADDRESS.email && (
                <a href={`mailto:${BRAND_ADDRESS.email}`} class="mt-3 inline-flex items-center gap-2 font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                  <span aria-hidden="true" class="text-sm">✉️</span>
                  {BRAND_ADDRESS.email}
                </a>
              )}
            </address>
          )
        }
      </div>

      <div class="md:col-span-6 lg:col-span-5">
        <p class="relative mb-5 inline-block text-lg font-bold tracking-wider text-white uppercase">
          ลิงก์ด่วน (Quick Links)
          <span aria-hidden="true" class="absolute -bottom-2 left-0 h-1 w-1/2 rounded-full bg-gradient-to-r from-[#bdcad2] to-[#e01b2d] shadow-[0_0_8px_rgba(189,202,210,0.6)]"></span>
        </p>

        <div class="grid grid-cols-2 gap-x-4 gap-y-3 text-sm">
          {
            quickLinks.map((link) => (
              <a href={link.path} class="group flex items-center text-[#dce3e8]/80 transition-colors hover:text-[#f2f5f7]">
                <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#e01b2d] transition-transform group-hover:rotate-45" />
                {link.name}
              </a>
            ))
          }
        </div>
      </div>

      <div class="md:col-span-6 lg:col-span-3">
        <p class="relative mb-5 inline-block text-lg font-bold tracking-wider text-white uppercase">
          ระบบการเงิน
          <span aria-hidden="true" class="absolute -bottom-2 left-0 h-1 w-1/2 rounded-full bg-gradient-to-r from-[#bdcad2] to-[#e01b2d] shadow-[0_0_8px_rgba(189,202,210,0.6)]"></span>
        </p>

        <p class="mb-4 text-xs text-[#dce3e8]/80">รองรับการฝาก-ถอนผ่านแอปธนาคารชั้นนำและทรูมันนี่วอลเล็ท โดยควรใช้บัญชีชื่อเดียวกับข้อมูลที่สมัครไว้</p>

        <BankStrip size={30} />

        <div class="mt-3 flex h-10 items-center justify-center rounded border border-white/10 bg-[#1c0a0c] transition-colors hover:border-[#bdcad2]/60" title="ตรวจรายการย้อนหลัง">
          <span class="flex items-center gap-1 text-xs font-bold text-[#dce3e8]"><span aria-hidden="true" class="text-lg text-[#bdcad2]">🧾</span> เก็บเลขรายการไว้ตรวจสอบได้</span>
        </div>
      </div>
    </div>

    <hr class="mb-6 border-white/15" />

    <div class="mb-6 hidden text-justify text-[10px] leading-relaxed text-[#dce3e8]/65 md:block">
      VING999 เว็บตรงอันดับ1 สำหรับสายสล็อต รวมเกมค่ายดังหลายแนวไว้ในยูสเดียว เลือกได้ทั้งสล็อตคลาสสิก เกมฟรีสปิน เกมโบนัสฟีเจอร์ และเกมใหม่ สลับค่ายได้โดยใช้เครดิตและบัญชีเดิม
      ระบบฝากถอนออโต้รองรับบัญชีธนาคารและ TrueWallet ฝากขั้นต่ำ 1 บาท ตรวจเครดิต โปรโมชั่น และประวัติรายการได้จากหน้าเมมเบอร์ ทางเข้า VING999 รองรับโทรศัพท์ แท็บเล็ต และคอมพิวเตอร์ด้วยยูสเดิม
    </div>

    <div class="flex flex-col items-center justify-between gap-4 border-t border-white/15 pt-6 text-xs text-[#dce3e8]/70 md:flex-row">
      <p>&copy; {new Date().getFullYear()} <span class="font-bold tracking-wider text-white uppercase">VING999</span>. All Rights Reserved.</p>

      <div class="flex items-center gap-6">
        <a href="/terms/" class="transition-colors hover:text-white">เงื่อนไขและข้อตกลง</a>
        <a href="/privacy/" class="transition-colors hover:text-white">นโยบายความเป็นส่วนตัว</a>

        <a
          href="#top"
          class="flex h-8 w-8 items-center justify-center rounded border border-white/20 bg-white/10 text-white transition-all hover:border-[#bdcad2] hover:bg-[#1c0a0c] hover:shadow-[0_0_15px_rgba(189,202,210,0.5)]"
          aria-label="กลับขึ้นด้านบนสุดของหน้า">
          <span aria-hidden="true">↑</span>
        </a>
      </div>
    </div>
  </div>
</footer>
