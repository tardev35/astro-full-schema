---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#f6c475]/30 bg-[#24100a]/92 p-8 text-[#f7e6d4] shadow-[0_10px_30px_rgba(11,3,1,0.85)] backdrop-blur-xl transition-all duration-500 hover:border-[#f6c475]/55 hover:shadow-[0_15px_40px_rgba(246,196,117,0.24)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 bg-gradient-to-br from-[#8d2b09]/45 to-transparent opacity-70"></div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#f6c475]/30 pb-4">
          <span aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffd98a] via-[#ff7a18] to-[#8d2b09] shadow-[0_0_10px_rgba(255,122,24,0.5)]" />
          <HeadingTag class="bg-gradient-to-r from-[#ffd98a] via-[#f6c475] to-[#ff7a18] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-10 md:grid-cols-2">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f7e6d4]">
        {
          titleleft && (
            <h2 class="flex items-center gap-3 border-b border-[#f6c475]/30 pb-3 text-xl leading-normal font-black tracking-widest text-[#ffd98a] uppercase">
              <span aria-hidden="true" class="h-6 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffd98a] via-[#f6c475] to-[#8d2b09] shadow-[0_0_10px_rgba(246,196,117,0.45)]" />
              {titleleft}
            </h2>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f7e6d4] md:border-l md:border-[#5a2a12] md:pl-10">
        {
          titleright && (
            <h2 class="flex items-center gap-3 border-b border-[#f6c475]/30 pb-3 text-xl leading-normal font-black tracking-widest text-[#ffd98a] uppercase">
              <span aria-hidden="true" class="h-6 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffd98a] via-[#f6c475] to-[#8d2b09] shadow-[0_0_10px_rgba(246,196,117,0.45)]" />
              {titleright}
            </h2>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
