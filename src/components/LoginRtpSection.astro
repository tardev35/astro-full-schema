---
import ContentBoxTwo from "./ContentBoxTwo.astro";

const menus = [
  { icon: "🀄", name: "Mahjong Ways 2", detail: "เกมฟรีสปินตัวคูณสะสม เข้ารอบโบนัสได้เป็นธรรมชาติ ไม่ต้องวนรถเล่นนาน", tag: "RTP 96.95%" },
  { icon: "🐂", name: "Fortune Ox", detail: "ความผันผวนกำลังดี บทจะจ่ายก็จ่ายหนัก จ่ายไว เหมาะกับรอบสั้น", tag: "RTP 96.75%" },
  { icon: "🧧", name: "Caishen Wins", detail: "ธีมจีนตรุษจีน มีสัญลักษณ์ไวลด์แจกตัวคูณ เล่นต่อเนื่องได้ยาว ๆ", tag: "RTP 96.72%" },
  { icon: "🐱", name: "Lucky Neko", detail: "แถวขยายตัวคูณ เป็นเกมยอดฮิตของคนที่ชอบลุ้นรอบโบนัสใหญ่", tag: "RTP 96.73%" },
  { icon: "🏺", name: "Treasures of Aztec", detail: "ผันผวนสูง กองรางวัลใหญ่ สำหรับคนที่อยากเหยียบมิดไมล์รอบเดียว", tag: "RTP 96.71%" },
  { icon: "🌵", name: "Wild Bandito", detail: "ซื้อฟีเจอร์ฟรีสปินได้ทันที ตัดเวลาปั่นรอรอบโบนัสออกไป", tag: "RTP 96.72%" },
  { icon: "🦌", name: "Ways of the Qilin", detail: "เกมไลน์จ่ายหลายทาง จังหวะแตกถี่ เหมาะกับการวอร์มระบบด้วยยอดเล็ก", tag: "RTP 96.73%" },
];

const chips = ["PGSLOT", "เว็บตรง API ค่ายแม่", "ระบบออโต้", "แตกง่าย", "ไม่บังคับขั้นต่ำ", "รองรับ วอเลท", "เล่นผ่านมือถือ"];
---

<ContentBoxTwo titleleft="เข้าสู่ระบบ PIGAUTO" titleright="ตารางเกม RTP สูงที่ PIGAUTO คัดมาให้" label="เข้าสู่ระบบ PIGAUTO และตารางเกมสล็อตค่า RTP สูง">
  <div slot="left" class="flex h-full flex-col gap-4">
    <div class="relative overflow-hidden rounded-2xl border border-[#d81f26]/45 bg-[#1c0403]/92 p-6 shadow-[0_10px_30px_rgba(10,2,1,0.65)] backdrop-blur-md">
      <div aria-hidden="true" class="pointer-events-none absolute -top-10 -right-10 h-32 w-32 rounded-full bg-[#d81f26]/45 blur-[50px]"></div>

      <div class="relative z-10 mb-5 flex items-center gap-3">
        <span
          aria-hidden="true"
          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#f5c542]/40 bg-gradient-to-br from-[#ffe9a8] via-[#f5c542] to-[#a9761a] text-xl shadow-inner">
          🐷
        </span>
        <div class="flex flex-col">
          <p class="text-base font-black text-[#f5c542]">เข้าสู่ระบบแล้วเร่งรอบต่อได้ทันที</p>
          <span class="text-[11px] text-[#f7e2e2]/70">บัญชีเดียวใช้เลือกเกม ฝากถอนออโต้ และดูประวัติรายการของ PIGAUTO ได้ครบจากจุดเดียว</span>
        </div>
      </div>

      <div class="relative z-10 flex flex-col gap-3.5">
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#f5c542]">👤</span>
          <input
            type="text"
            placeholder="เบอร์โทรศัพท์ / ยูสเซอร์เนม"
            class="w-full rounded-xl border border-[#d81f26]/60 bg-[#2e0806]/95 py-3 pr-4 pl-12 text-[#f7e2e2] transition-all outline-none placeholder:text-[#f7e2e2]/50 focus:border-[#f5c542] focus:ring-1 focus:ring-[#f5c542]/50"
          />
        </div>
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#f5c542]">🔑</span>
          <input
            type="password"
            placeholder="รหัส PIN 4 หลัก"
            class="w-full rounded-xl border border-[#d81f26]/60 bg-[#2e0806]/95 py-3 pr-4 pl-12 text-[#f7e2e2] transition-all outline-none placeholder:text-[#f7e2e2]/50 focus:border-[#f5c542] focus:ring-1 focus:ring-[#f5c542]/50"
          />
        </div>

        <div class="flex items-center justify-between px-1 text-xs">
          <label class="flex items-center gap-2 text-[#f7e2e2]/70">
            <input type="checkbox" class="h-3.5 w-3.5 rounded border-[#d81f26]/60 bg-[#2e0806] accent-[#d81f26]" />
            จดจำฉันไว้
          </label>
          <a href="/login" class="text-[#f7e2e2]/70 transition-colors hover:text-[#ffe9a8]">ลืมรหัส PIN?</a>
        </div>

        <button
          class="mt-1 w-full rounded-xl border border-[#f5c542]/40 bg-gradient-to-r from-[#ffe9a8] via-[#f5c542] to-[#a9761a] p-3.5 font-black text-[#1c0403] shadow-[0_10px_30px_rgba(245,197,66,0.30)] transition-all hover:scale-[1.02] hover:shadow-[0_15px_40px_rgba(245,197,66,0.40)]">
          เข้าสู่ระบบ
        </button>

        <div class="flex items-center gap-3 py-1 text-[11px] text-[#f7e2e2]/60">
          <span class="h-px flex-1 bg-[#d81f26]/60"></span>
          หรือ
          <span class="h-px flex-1 bg-[#d81f26]/60"></span>
        </div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] p-3 text-sm font-bold text-white shadow-md transition-all hover:scale-[1.02]">
          <span aria-hidden="true">💬</span> ทักไลน์ทีมงานตลอด 24 ชั่วโมง
        </a>

        <div class="mt-1 flex items-center justify-between px-1">
          <div class="flex gap-2">
            <span class="rounded-full border border-[#f5c542]/30 bg-[#2e0806] px-2.5 py-1 text-[10px] font-bold text-[#f5c542]"><span aria-hidden="true">🔒</span> เข้ารหัสข้อมูล</span>
            <span class="rounded-full border border-[#f9a8bd]/50 bg-[#2e0806]/80 px-2.5 py-1 text-[10px] font-bold text-[#f9a8bd]"><span aria-hidden="true">🕐</span> ฝากถอนออโต้</span>
          </div>
          <a href="/register" class="text-xs font-bold text-[#f7e2e2]/70 transition-colors hover:text-[#ffe9a8]">สมัครสมาชิกใหม่</a>
        </div>
      </div>
    </div>
  </div>

  <div slot="right" class="h-full">
    <div class="flex h-full flex-col rounded-2xl border border-[#d81f26]/45 bg-[#1c0403]/92 p-5 shadow-[0_10px_30px_rgba(10,2,1,0.65)] backdrop-blur-md">
      <div class="mb-5 flex items-center justify-between gap-3">
        <div>
          <span class="text-xs font-bold tracking-wide text-[#f7e2e2]/70">เกม High Performance ที่ PIGAUTO เปิดให้เล่น พร้อมค่า RTP ตามที่ค่ายเกมแม่ประกาศ</span>
          <div class="bg-gradient-to-r from-[#ffe9a8] via-[#f5c542] to-[#f9a8bd] bg-clip-text text-3xl font-black text-transparent sm:text-4xl">RTP สูง • แตกง่าย จ่ายไว</div>
        </div>
        <span class="flex items-center gap-1.5 self-start rounded-full border border-green-500/40 bg-green-900/40 px-2.5 py-1">
          <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-green-500 shadow-[0_0_8px_rgba(34,197,94,0.7)]"></span>
          <span class="text-[10px] font-bold tracking-widest text-green-300 uppercase">Live</span>
        </span>
      </div>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#f7e2e2]/60 uppercase">
        <span>เกมสล็อตลิขสิทธิ์แท้</span>
        <span>ค่า RTP</span>
      </div>

      <div class="flex flex-1 flex-col gap-2.5">
        {
          menus.map((m) => (
            <div class="rounded-xl border border-[#d81f26]/45 bg-[#2e0806]/95 px-3.5 py-2.5 transition-colors hover:border-[#f5c542]/50 hover:bg-[#4a0d0a]">
              <div class="flex items-center justify-between gap-2 text-sm">
                <span class="flex min-w-0 items-center gap-2 font-bold text-[#f7e2e2]">
                  <span aria-hidden="true" class="w-5 shrink-0 text-center">
                    {m.icon}
                  </span>{" "}
                  <span class="truncate">{m.name}</span>
                </span>
                <span class="shrink-0 rounded-full border border-[#f5c542]/40 bg-[#1c0403] px-2.5 py-0.5 text-[10px] font-bold text-[#f5c542]">{m.tag}</span>
              </div>
              <div class="mt-1.5 text-[11px] tracking-wide text-[#f7e2e2]/70">{m.detail}</div>
            </div>
          ))
        }
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
        {chips.map((c) => <span class="rounded-full border border-[#d81f26]/45 bg-[#2e0806] px-3 py-1 text-[10px] font-bold text-[#f9a8bd]">{c}</span>)}
      </div>

      <div class="mt-3 text-center text-[10px] tracking-wide text-[#f7e2e2]/60">
        ค่า RTP ในตารางสรุปจากที่ค่ายเกมแม่ประกาศไว้ เป็นค่าเฉลี่ยระยะยาวไม่ใช่ผลของรอบใดรอบหนึ่ง เงื่อนไขจริงให้ยึดตามหน้าเกมของ PIGAUTO หากติดขัดตรงไหนทักไลน์ทีมงานได้ตลอด 24 ชั่วโมง
      </div>
    </div>
  </div>
</ContentBoxTwo>
