---
const { message = "⚽ FINNBET แจ้งข่าวสาร เลขเด็ด เลขดัง จ่ายสูงกว่าทุกเว็บ ไม่มีปิดเลข รองรับการฝาก-ถอนทุกธนาคาร 24 ชั่วโมง" } = Astro.props;
---

<div class="w-full border-b border-[#ffd60a]/30 bg-[#0a1128] py-2 font-sans">
  <div class="mx-auto flex w-full max-w-[1600px] items-center px-4">
    <div class="flex shrink-0 items-center justify-center rounded-sm bg-[#ffd60a] px-4 py-1 text-xs font-black tracking-wider text-[#0a1128] uppercase">
      <span class="mr-2 animate-pulse">🔥</span> ด่วน!
    </div>

    <div class="marquee-container relative ml-4 flex-1 overflow-hidden py-1 pr-6">
      <div class="pointer-events-none absolute top-0 left-0 z-10 h-full w-8 bg-gradient-to-r from-[#0a1128] to-transparent"></div>

      <div class="marquee-content inline-block pl-4 text-sm font-medium tracking-wide whitespace-nowrap text-white">
        <span class="mr-8 inline-flex items-center gap-2"><span class="h-1.5 w-1.5 rounded-full bg-[#ffd60a]"></span>{message}</span>
        <span class="mr-8 inline-flex items-center gap-2"><span class="h-1.5 w-1.5 rounded-full bg-[#ffd60a]"></span>{message}</span>
      </div>
    </div>
  </div>
</div>

<style>
  .font-sans {
    font-family: "Kanit", sans-serif;
  }
  .marquee-content {
    animation: marquee 20s linear infinite;
  }
  .marquee-container:hover .marquee-content {
    animation-play-state: paused;
  }
  @keyframes marquee {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }
</style>
