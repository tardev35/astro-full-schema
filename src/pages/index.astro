---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/AnnouncementCyber.astro";
import ContentBox from "../components/ContentBox.astro";
import ContentBoxNeumorphism from "../components/ContentBoxNeumorphism.astro";
import ContentBoxFloatingBadge from "../components/ContentBoxFloatingBadge.astro";
import ContentBoxTwoNeumorphism from "../components/ContentBoxTwoNeumorphism.astro";
import ContentBoxTwoFloatingBadge from "../components/ContentBoxTwoFloatingBadge.astro";
import ContentBoxSevenThree from "../components/ContentBoxSevenThree.astro";
import ContentBoxSevenThreeNeumorphism from "../components/ContentBoxSevenThreeNeumorphism.astro";
import GameRankingBoard from "../components/GameRankingBoard.astro";
import FeatureHighlights from "../components/FeatureHighlights.astro";
import SmoothCarousel from "../components/SmoothCarousel.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import LatestWinnersPremium from "../components/LatestWinnersPremium.astro";
import ProviderGrid from "../components/ProviderGrid.astro";
import ReviewCardSumo2 from "../components/ReviewCardSumo2.astro";
import Faq4 from "../components/Faq4.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import imgAutoWallet from "../assets/slide4.png";
import imgFootball from "../assets/slide3.png";

const pageTitle = "DOLLAR789 คาสิโนสด บาคาร่า เว็บใหญ่มั่นคง สมัครรับโปรสมาชิกใหม่";

const pageDescription =
  "DOLLAR789 รวมคาสิโนสด บาคาร่า สล็อต และฟุตบอล พร้อมระบบสมาชิก ฝากถอนออโต้ รองรับมือถือ สมัครง่าย เช็กโปรสมาชิกใหม่และเข้าใช้งานได้ตลอดวัน";

const announcement =
  "DOLLAR789 รวมคาสิโนสด บาคาร่า สล็อต และฟุตบอลไว้ในยูสเดียว เลือกเกมต่อได้จากหน้าเดิม • หน้าสมาชิกรวมเครดิต โปร และประวัติรายการไว้จุดเดียว เช็กสถานะได้เอง • ระบบฝากถอนออโต้ทำรายการได้ตลอด 24 ชั่วโมง ทั้งมือถือและคอมพิวเตอร์ • โปรสมาชิกใหม่ดูยอดรับ เงื่อนไข และเทิร์นได้ก่อนกดรับทุกครั้ง • ทางเข้า DOLLAR789 ใช้ยูสเดิมสลับอุปกรณ์ได้ ไม่ต้องเริ่มใหม่";

const autoWalletAlt =
  "ภาพโปรโมชั่น DOLLAR789 โทนม่วงเข้มสลับทอง ด้านบนเป็นโลโก้ DOLLAR789 สีทอง ถัดลงมาเป็นตัวอักษรขนาดใหญ่ว่า ฝาก-ถอน ระบบออโต้ ตรงกลางเป็นกระเป๋าสตางค์หนังสีน้ำตาลที่มีบัตรเสียบอยู่และเหรียญทองกองรอบ ๆ ด้านขวาเป็นพรีเซนเตอร์หญิงสวมสูทสีม่วง ด้านล่างมีป้ายเขียนว่า Auto Wallet เล่นง่าย บริการ 24 ชั่วโมง และ มั่นคง ปลอดภัย จ่ายจริง 100%";

const footballAlt =
  "ภาพโปรโมชั่น DOLLAR789 โทนม่วงเข้มสลับทอง ด้านบนเป็นโลโก้ DOLLAR789 สีทอง ถัดลงมาเป็นตัวอักษรขนาดใหญ่สีม่วงสลับขาวว่า แทงบอลออนไลน์ พร้อมป้ายเขียนว่า คาสิโนสด บาคาร่าสด เว็บใหญ่มั่นคง สมัครรับโปรสมาชิกใหม่ และ เริ่มต้น 10 บาท ด้านขวาเป็นพรีเซนเตอร์หญิงสวมชุดวอร์มสีม่วงยืนอยู่ข้างลูกฟุตบอลเรืองแสง มีเหรียญทองกองอยู่ด้านล่าง";

const trustPoints = [
  {
    icon: "💰",
    title: "เครดิตขึ้นตรง",
    description: "หลังทำรายการฝาก เครดิตจะไปแสดงอยู่ในหน้าสมาชิกให้เช็กได้เอง ไม่ต้องเดาว่ายอดเข้าแล้วหรือยังก่อนกลับเข้าโต๊ะ",
    accent: "gold" as const,
  },
  {
    icon: "🧾",
    title: "ประวัติรายการหาเจอ",
    description: "รายการย้อนหลังทั้งฝาก ถอน และโปรที่เคยรับ อยู่ในหน้าเดียวกับเครดิต เปิดดูตอนไหนก็ไล่ย้อนได้ครบ",
    accent: "blue" as const,
  },
  {
    icon: "💳",
    title: "ฝากถอนอยู่จุดเดียว",
    description: "ไม่ต้องสลับหน้าไปมาเพื่อทำรายการ ฝาก ถอน และดูยอดคงเหลือรวมอยู่ในพื้นที่เดียวกันของหน้าสมาชิก",
    accent: "gold" as const,
  },
  {
    icon: "📱",
    title: "เปลี่ยนเครื่องข้อมูลอยู่ครบ",
    description: "สลับจากมือถือไปคอมด้วยยูสเดิม เครดิต โปร และประวัติรายการยังอยู่ที่เดิม ไม่ต้องเริ่มนับหนึ่งใหม่",
    accent: "blue" as const,
  },
];

const faqs = [
  {
    q: "คาสิโนสด DOLLAR789 มีโต๊ะแบบไหนเหมาะกับสายเล่นจริง",
    a: "คาสิโนสด DOLLAR789 เน้นห้องเล่นแบบเรียลไทม์ โดยมีบาคาร่าเป็นตัวหลัก เหมาะทั้งคนที่มีโต๊ะประจำและสายชอบไล่ดูหลายห้องก่อนลงเดิมพัน ก่อนเข้าโต๊ะก็เลือกบรรยากาศและรูปแบบที่ตัวเองถนัดได้ ไม่ต้องรีบตามคนอื่น เซียนจริงไม่ได้เข้าโต๊ะเร็วที่สุด แต่รู้ว่าตัวเองกำลังจะเล่นอะไร",
  },
  {
    q: "บาคาร่า DOLLAR789 เลือกโต๊ะยังไงให้ตรงสไตล์",
    a: "สายบาคาร่าแต่ละคนเล่นไม่เหมือนกัน บางคนชอบโต๊ะไหลไว บางคนดูเค้าไพ่ก่อน บางคนแค่ต้องการห้องที่ภาพชัดและเข้าเดิมพันง่าย ตัวเลือกโต๊ะจึงสำคัญพอ ๆ กับจำนวนเกม DOLLAR789 ทำให้สมาชิกเปิดดูห้องแล้วสลับโต๊ะจากยูสเดิมได้ ถ้าโต๊ะนี้ไม่ใช่ก็ย้าย ไม่ต้องฝืนโต๊ะเพียงเพราะนั่งมานานแล้ว",
  },
  {
    q: "โปรสมาชิกใหม่ DOLLAR789 ต้องดูตรงไหนก่อนกดรับ",
    a: "โปรสมาชิกใหม่ควรดูทั้งยอดรับ เงื่อนไข เทิร์น และช่วงเวลาที่ใช้ได้ก่อนกด เพราะคำว่าโบนัสเยอะไม่ได้แปลว่าเหมาะกับทุกยูส DOLLAR789 มีพื้นที่โปรให้สมาชิกเช็กสิทธิ์ก่อนใช้งาน เลือกโปรให้เข้ากับแนวเล่นของตัวเองดีกว่ารับทุกอันจนสุดท้ายจำไม่ได้ว่าเครดิตก้อนไหนติดเงื่อนไขอะไร",
  },
  {
    q: "สมัครสมาชิก DOLLAR789 ผ่านมือถือใช้เวลานานไหม",
    a: "สมัครผ่านมือถือเริ่มจากกรอกข้อมูล เปิดยูส และยืนยันตามระบบ หลังจากนั้นก็ล็อกอินเข้าหน้าสมาชิกเพื่อดูเกม เครดิต และโปรที่ใช้งานได้ ยุคนี้ถ้าสมัครเว็บยังต้องนั่งเปิดคอมสามรอบก็คงเหนื่อยเกิน DOLLAR789 จึงเหมาะกับคนที่ใช้มือถือเป็นหลักและอยากจบทุกอย่างจากเครื่องเดียว",
  },
  {
    q: "ฝากถอนออโต้ของ DOLLAR789 ช่วยสายเล่นยังไง",
    a: "ระบบออโต้ช่วยลดช่วงรอระหว่างฝากเข้า เครดิตขึ้น และเข้าเกม รวมถึงตอนถอนออก สมาชิกจึงเช็กยอดและทำรายการจากหน้าเดียวได้สะดวกขึ้น เวลาอยากเปลี่ยนโต๊ะหรือพักเกม ไม่มีใครอยากมานั่งไล่ถามว่ารายการถึงไหนแล้ว ระบบการเงินที่ดีควรอยู่หลังฉากและทำงานของมันไปเงียบ ๆ",
  },
  {
    q: "ทางเข้า DOLLAR789 ควรใช้แบบไหนเวลาเล่นบนมือถือ",
    a: "คนที่เล่นผ่านมือถือควรจำทางเข้าหลักหรือหน้าล็อกอินที่ใช้อยู่ประจำ เพื่อเข้าหน้าสมาชิก เช็กเครดิต และกลับเกมเดิมได้ไว DOLLAR789 รองรับทั้งมือถือและคอมด้วยยูสเดียว สลับอุปกรณ์ได้โดยไม่ต้องเริ่มใหม่ทุกครั้ง เรื่องง่าย ๆ แบบนี้แหละที่พอเว็บทำพลาดแล้วคนเล่นหงุดหงิดที่สุด",
  },
];

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement message={announcement} />

  <ContentBoxNeumorphism as="h1" title="DOLLAR789 รวมคาสิโนสด บาคาร่า เกมออนไลน์ และระบบสมาชิกไว้ในยูสเดียว">
    <p class="mb-4 text-left text-base leading-relaxed">
      <strong class="text-[#f5c542]">DOLLAR789</strong> เหมาะกับสายที่เข้ามาแล้วอยากเลือกเกมได้เลย ทั้งคาสิโนสด บาคาร่า สล็อต และบอล ทุกอย่างอยู่ในยูสเดียว เครดิต โปร และประวัติรายการก็ดูจากหน้าเมมเบอร์ได้
      ไม่ต้องสลับเว็บไปมาให้เสียจังหวะ
    </p>

    <p class="text-left text-base leading-relaxed">
      ระบบฝากถอนออโต้ช่วยให้เติมเครดิตหรือถอนออกได้จากมือถือ ส่วนใครชอบสลับจากโต๊ะสดไปเล่นสล็อตก็ทำได้ต่อเนื่อง เกมเยอะไม่ใช่เรื่องใหม่ปี 2026 แต่หาเกมเจอไวต่างหากที่คนเล่นเริ่มเรื่องมากขึ้น
    </p>
  </ContentBoxNeumorphism>

  <ContentBox as="h2" title="DOLLAR789 คาสิโนสด มีโต๊ะไหนเหมาะกับสายเล่นจริง">
    <p class="mb-4 text-left text-base leading-relaxed">
      คาสิโนสด DOLLAR789 เน้นห้องเล่นแบบเรียลไทม์ โดยมีบาคาร่าเป็นตัวหลัก เหมาะทั้งคนที่มีโต๊ะประจำและสายชอบไล่ดูหลายห้องก่อนลงเดิมพัน
    </p>

    <p class="text-left text-base leading-relaxed">
      ก่อนเข้าโต๊ะก็เลือกบรรยากาศและรูปแบบที่ตัวเองถนัดได้ ไม่ต้องรีบตามคนอื่น เซียนจริงไม่ได้เข้าโต๊ะเร็วที่สุด แต่รู้ว่าตัวเองกำลังจะเล่นอะไร
    </p>
  </ContentBox>

  <ContentBoxTwoNeumorphism as="h2" title="บาคาร่า DOLLAR789 เลือกโต๊ะยังไงให้ตรงสไตล์">
    <p slot="left" class="text-left text-base leading-relaxed">
      สายบาคาร่าแต่ละคนเล่นไม่เหมือนกัน บางคนชอบโต๊ะไหลไว บางคนดูเค้าไพ่ก่อน บางคนแค่ต้องการห้องที่ภาพชัดและเข้าเดิมพันง่าย เพราะฉะนั้นตัวเลือกโต๊ะสำคัญพอ ๆ กับจำนวนเกม
    </p>
    <p slot="right" class="text-left text-base leading-relaxed">
      DOLLAR789 ทำให้สมาชิกเปิดดูห้องแล้วสลับโต๊ะจากยูสเดิมได้ ถ้าโต๊ะนี้ไม่ใช่ก็ย้าย คนเล่นมานานรู้ดีว่าอย่าฝืนโต๊ะเพียงเพราะนั่งมานานแล้ว
    </p>
  </ContentBoxTwoNeumorphism>

  <GameRankingBoard />

  <ContentBox as="h2" title="เว็บใหญ่มั่นคง คนเล่นปี 2026 ดูจากอะไรบ้าง">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed">
        คนเล่นยุคนี้ไม่ได้ดูแค่หน้าเว็บสวย แต่ดูว่าเครดิตขึ้นตรงไหม ประวัติรายการหาเจอไหม ฝากถอนอยู่จุดเดียวหรือเปล่า และเวลาเปลี่ยนเครื่องข้อมูลยังอยู่ครบไหม
      </p>

      <p class="text-left text-base leading-relaxed">
        DOLLAR789 รวมข้อมูลสำคัญไว้ในหน้าเมมเบอร์ ทั้งเครดิต โปร และรายการย้อนหลัง ทำให้เช็กสถานะตัวเองได้ง่ายกว่าเดิม เงินอยู่ตรงไหนต้องรู้ เกมอยู่ตรงไหนค่อยว่ากัน
      </p>

      <FeatureHighlights items={trustPoints} />
    </div>
  </ContentBox>

  <ContentBoxTwoFloatingBadge as="h2" title="โปรสมาชิกใหม่ DOLLAR789 ดูตรงไหนก่อนกดรับ">
    <p slot="left" class="text-left text-base leading-relaxed">
      โปรสมาชิกใหม่ควรดูทั้งยอดรับ เงื่อนไข เทิร์น และช่วงเวลาที่ใช้ได้ก่อนกด เพราะคำว่า “โบนัสเยอะ” ไม่ได้แปลว่าเหมาะกับทุกยูส
    </p>
    <p slot="right" class="text-left text-base leading-relaxed">
      DOLLAR789 มีพื้นที่โปรให้สมาชิกเช็กสิทธิ์ก่อนใช้งาน เลือกโปรให้เข้ากับแนวเล่นของตัวเองดีกว่ารับทุกอันจนสุดท้ายจำไม่ได้ว่าเครดิตก้อนไหนติดเงื่อนไขอะไร
    </p>
  </ContentBoxTwoFloatingBadge>

  <SmoothCarousel />

  <ContentBoxFloatingBadge as="h2" title="สมัครสมาชิกผ่านมือถือ ใช้เวลานานไหม">
    <p class="mb-4 text-left text-base leading-relaxed">
      สมัครผ่านมือถือเริ่มจากกรอกข้อมูล เปิดยูส และยืนยันตามระบบ หลังจากนั้นก็ล็อกอินเข้าเมมเบอร์เพื่อดูเกม เครดิต และโปรที่ใช้งานได้
    </p>

    <p class="text-left text-base leading-relaxed">
      ยุคนี้ถ้าสมัครเว็บยังต้องนั่งเปิดคอมสามรอบก็คงเหนื่อยเกิน DOLLAR789 จึงเหมาะกับคนที่ใช้มือถือเป็นหลักและอยากจบทุกอย่างจากเครื่องเดียว
    </p>
  </ContentBoxFloatingBadge>

  <LoginRtpSection />

  <ContentBoxSevenThree as="h2" titleright="ฝากถอนออโต้ช่วยสายเล่นยังไง">
    <Picture
      slot="left"
      src={imgAutoWallet}
      alt={autoWalletAlt}
      loading="lazy"
      fetchpriority="low"
      widths={[240, 400, 600]}
      sizes="(max-width: 767px) calc(100vw - 64px), 380px"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      class="mx-auto h-auto w-full rounded-2xl border border-[#a855f7]/40 shadow-[0_10px_30px_rgba(168,85,247,0.24)]"
    />

    <div slot="right" class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed">
        ระบบออโต้ช่วยลดช่วงรอระหว่าง ฝากเข้า → เครดิตขึ้น → เข้าเกม รวมถึงตอนถอนออก สมาชิกจึงเช็กยอดและทำรายการจากหน้าเดียวได้สะดวกขึ้น
      </p>
      <p class="text-left text-base leading-relaxed">
        เวลาอยากเปลี่ยนโต๊ะหรือพักเกม ไม่มีใครอยากมานั่งไล่ถามว่ารายการถึงไหนแล้ว ระบบการเงินที่ดีควรอยู่หลังฉากและทำงานของมันไปเงียบ ๆ
      </p>
    </div>
  </ContentBoxSevenThree>

  <LatestWinnersPremium />

  <ContentBoxSevenThreeNeumorphism as="h2" title="สล็อตและฟุตบอลมีไว้สำหรับวันที่ไม่อยากนั่งโต๊ะสด">
    <Picture
      slot="left"
      src={imgFootball}
