---
import ContentBoxTwo from "./ContentBoxTwo.astro";

const steps = [
  { icon: "🕹️", name: "ลองก่อนด้วยโหมดทดลองเล่นฟรี", detail: "ดูรูปแบบเกมและฟีเจอร์ด้วยเครดิตจำลอง เครดิตส่วนนี้ถอนไม่ได้และไม่นับเป็นยอดเทิร์น", tag: "ขั้นที่ 1" },
  { icon: "📝", name: "เปิดยูสจริงจากเครื่องที่ถนัด", detail: "สมัครและยืนยันข้อมูลจบได้ในเครื่องเดียว จะเริ่มจากมือถือ แท็บเล็ต หรือคอมก็ได้", tag: "ขั้นที่ 2" },
  { icon: "🔑", name: "เข้าสู่ระบบด้วยยูสเดิมทุกอุปกรณ์", detail: "เปลี่ยนเครื่องระหว่างวันได้ ข้อมูลบัญชี เกม และเครดิตยังตามไปเหมือนเดิม", tag: "ขั้นที่ 3" },
  { icon: "👛", name: "รวมเครดิตไว้ที่ Smart Wallet", detail: "ไม่ต้องมีหน้ากระเป๋าเงินหลายชุดตามจำนวนค่าย ยอดอยู่ที่บัญชีหลักจุดเดียว", tag: "ขั้นที่ 4" },
  { icon: "🎰", name: "สลับค่ายเกมได้โดยไม่เสียจังหวะ", detail: "PG Soft, Pragmatic Play, JILI และ Joker Gaming อยู่หลังบัญชีเดียวกัน เปลี่ยนแล้วเข้าเกมต่อได้เลย", tag: "ขั้นที่ 5" },
];

const chips = ["2,000+ เกม", "30+ ค่าย", "ทดลองเล่นฟรี", "Smart Wallet", "ระบบ AI หลังบ้าน", "PG Soft", "Pragmatic Play", "JILI"];
---

<ContentBoxTwo titleleft="เข้าสู่ระบบ RIEL38" titleright="ลำดับการใช้งานตั้งแต่ทดลองเล่นถึงสลับค่าย" label="เข้าสู่ระบบ RIEL38 และลำดับการใช้งานตั้งแต่ทดลองเล่นถึงสลับค่าย">
  <div slot="left" class="flex h-full flex-col gap-4">
    <div class="relative overflow-hidden rounded-2xl border border-[#f9a8d4] bg-[#fff5fa] p-6 shadow-[0_10px_30px_rgba(236,72,153,0.14)]">
      <div aria-hidden="true" class="pointer-events-none absolute -top-10 -right-10 h-32 w-32 rounded-full bg-[#ec4899]/14 blur-[50px]"></div>

      <div class="relative z-10 mb-5 flex items-center gap-3">
        <span
          aria-hidden="true"
          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#f9a8d4] bg-gradient-to-br from-[#f472b6] via-[#ec4899] to-[#db2777] text-xl shadow-inner">
          🎰
        </span>
        <div class="flex flex-col">
          <p class="text-base font-black text-[#9d174d]">ล็อกอินแล้วเลือกค่ายที่อยากเล่นต่อได้ทันที</p>
          <span class="text-[11px] text-[#8a5670]">
            ยูสเดียวใช้เข้าได้กว่า 30 ค่าย ทั้ง PG Soft, Pragmatic Play, JILI และ Joker Gaming เครดิตอยู่ที่ Smart Wallet จุดเดียว เช็กยอด ดูโปรโมชั่น และย้อนดูประวัติการใช้งานได้จากหน้าเมมเบอร์
          </span>
        </div>
      </div>

      <div class="relative z-10 flex flex-col gap-3.5">
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#ec4899]">👤</span>
          <input
            type="text"
            placeholder="เบอร์โทรศัพท์ / ยูสเซอร์เนม"
            class="w-full rounded-xl border border-[#f9a8d4] bg-white py-3 pr-4 pl-12 text-[#5b2140] transition-all outline-none placeholder:text-[#8a5670] focus:border-[#ec4899] focus:ring-1 focus:ring-[#ec4899]/40"
          />
        </div>
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#ec4899]">🔑</span>
          <input
            type="password"
            placeholder="รหัส PIN 4 หลัก"
            class="w-full rounded-xl border border-[#f9a8d4] bg-white py-3 pr-4 pl-12 text-[#5b2140] transition-all outline-none placeholder:text-[#8a5670] focus:border-[#ec4899] focus:ring-1 focus:ring-[#ec4899]/40"
          />
        </div>

        <div class="flex items-center justify-between px-1 text-xs">
          <label class="flex items-center gap-2 text-[#8a5670]">
            <input type="checkbox" class="h-3.5 w-3.5 rounded border-[#f9a8d4] bg-white accent-[#ec4899]" />
            จดจำฉันไว้
          </label>
          <a href="/login" class="text-[#8a5670] transition-colors hover:text-[#db2777]">ลืมรหัส PIN?</a>
        </div>

        <button
          class="mt-1 w-full rounded-xl border border-[#ec4899]/50 bg-gradient-to-r from-[#f472b6] via-[#ec4899] to-[#a855f7] p-3.5 font-black text-white shadow-[0_10px_30px_rgba(236,72,153,0.28)] transition-all hover:scale-[1.02] hover:shadow-[0_15px_40px_rgba(236,72,153,0.35)]">
          เข้าสู่ระบบ
        </button>

        <div class="flex items-center gap-3 py-1 text-[11px] text-[#8a5670]">
          <span class="h-px flex-1 bg-[#f9a8d4]"></span>
          หรือ
          <span class="h-px flex-1 bg-[#f9a8d4]"></span>
        </div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] p-3 text-sm font-bold text-white shadow-md transition-all hover:scale-[1.02]">
          <span aria-hidden="true">💬</span> ทักไลน์ทีมงานตลอด 24 ชั่วโมง
        </a>

        <div class="mt-1 flex items-center justify-between px-1">
          <div class="flex gap-2">
            <span class="rounded-full border border-[#f9a8d4] bg-[#fce7f3] px-2.5 py-1 text-[10px] font-bold text-[#9d174d]"><span aria-hidden="true">🔒</span> เข้ารหัสข้อมูล</span>
            <span class="rounded-full border border-[#e9d5ff] bg-[#f3e8ff] px-2.5 py-1 text-[10px] font-bold text-[#7e22ce]"><span aria-hidden="true">🕐</span> ใช้งานได้ตลอด 24 ชม.</span>
          </div>
          <a href="/register" class="text-xs font-bold text-[#8a5670] transition-colors hover:text-[#db2777]">สมัครสมาชิกใหม่</a>
        </div>
      </div>
    </div>
  </div>

  <div slot="right" class="h-full">
    <div class="flex h-full flex-col rounded-2xl border border-[#f9a8d4] bg-[#fff5fa] p-5 shadow-[0_10px_30px_rgba(236,72,153,0.14)]">
      <div class="mb-5 flex items-center justify-between gap-3">
        <div>
          <span class="text-xs font-bold tracking-wide text-[#8a5670]">ลำดับการใช้งานที่ RIEL38 วางไว้ ตั้งแต่ลองเกมด้วยเครดิตจำลองจนสลับค่ายด้วยเครดิตจริง อยู่ในบัญชีเดียวกันทั้งหมด</span>
          <div class="bg-gradient-to-r from-[#9d174d] via-[#db2777] to-[#7e22ce] bg-clip-text text-2xl font-black text-transparent sm:text-3xl">ทดลองเล่น • เปิดยูส • เข้าสู่ระบบ • สลับค่าย</div>
        </div>
        <span class="flex items-center gap-1.5 self-start rounded-full border border-[#ec4899]/45 bg-[#fce7f3] px-2.5 py-1">
          <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#ec4899] shadow-[0_0_8px_rgba(236,72,153,0.6)]"></span>
          <span class="text-[10px] font-bold tracking-widest text-[#9d174d] uppercase">Live</span>
        </span>
      </div>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#8a5670] uppercase">
        <span>ขั้นตอนการใช้งาน</span>
        <span>ลำดับ</span>
      </div>

      <div class="flex flex-1 flex-col gap-2.5">
        {
          steps.map((s) => (
            <div class="rounded-xl border border-[#fbcfe8] bg-white px-3.5 py-2.5 transition-colors hover:border-[#ec4899]/60 hover:bg-[#fdf2f8]">
              <div class="flex items-center justify-between gap-2 text-sm">
                <span class="flex min-w-0 items-center gap-2 font-bold text-[#5b2140]">
                  <span aria-hidden="true" class="w-5 shrink-0 text-center">
                    {s.icon}
                  </span>{" "}
                  <span class="truncate">{s.name}</span>
                </span>
                <span class="shrink-0 rounded-full border border-[#e9d5ff] bg-[#f3e8ff] px-2.5 py-0.5 text-[10px] font-bold text-[#7e22ce]">{s.tag}</span>
              </div>
              <div class="mt-1.5 text-[11px] tracking-wide text-[#8a5670]">{s.detail}</div>
            </div>
          ))
        }
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
        {chips.map((c) => <span class="rounded-full border border-[#fbcfe8] bg-white px-3 py-1 text-[10px] font-bold text-[#9d174d]">{c}</span>)}
      </div>

      <div class="mt-3 text-center text-[10px] tracking-wide text-[#8a5670]">
        ลำดับในตารางสรุปจากที่หน้าเว็บแสดงไว้ รายละเอียดของค่ายเกม เงื่อนไขเครดิต และโปรโมชั่นที่เปิดอยู่จริงให้ยึดตามหน้าเมมเบอร์ของ RIEL38 ก่อนทำรายการทุกครั้ง ไม่ใช่ทุกเกมที่เปิดโหมดทดลองให้เล่น
        และอย่าบอกรหัสผ่านหรือ OTP กับใคร หากติดขัดตรงไหนทักไลน์ทีมงานได้ตลอด 24 ชั่วโมง
      </div>
    </div>
  </div>
</ContentBoxTwo>
