---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import CtaRedirect from "../components/CtaRedirect.astro";
import { pageGraph } from "../lib/schema";

const pageTitle = "สมัครสมาชิก VODKAFUN | ปุ่มเปิดบัญชีใหม่ สล็อตเวอร์ชั่นใหม่ รวมเกมครบ";

const pageDescription =
  "หากคุณกำลังมองหาสล็อตเวอร์ชั่นใหม่ที่รวมเกมครบครัน VODKAFUN พร้อมมอบปุ่มสมัครสมาชิกเพียงปุ่มเดียว เพื่อเปิดบัญชีใหม่ รับโปรโมชั่น และฝากถอนออโต้ได้ทุกอุปกรณ์";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "สมัครสมาชิก", path: "/register" },
  ],
});

const targetUrl = "https://yoalink.com/jk5w";
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="สมัครสมาชิก VODKAFUN" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label="สมัครสมาชิก VODKAFUN"
        class="group relative mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl bg-gradient-to-r from-[#e6ff6a] via-[#c8fc04] to-[#7ee000] px-6 py-4 text-xl font-bold tracking-wide text-[#0b2a05] shadow-[0_10px_30px_rgba(200,252,4,0.35)] transition-all duration-300 hover:scale-105 hover:shadow-[0_15px_40px_rgba(200,252,4,0.5)]">
        สมัครสมาชิก VODKAFUN
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="สมัครสมาชิก" />
</MainLayout>
