---
export interface FeatureItem {
  icon: string;
  title: string;
  description: string;
  accent?: "gold" | "blue";
}

export interface Props {
  items: FeatureItem[];
}

const { items } = Astro.props;
---

<div class="mt-4 flex flex-col gap-5">
  {
    items.map((item) => {
      const isGold = item.accent === "gold";
      return (
        <div
          class={`group flex flex-col items-start gap-4 rounded-2xl border border-purple-900/30 bg-[#171717]/50 p-6 transition-all duration-300 hover:-translate-y-1 sm:flex-row ${
            isGold
              ? "hover:border-yellow-500/50 hover:bg-[#1a1505] hover:shadow-[0_10px_20px_rgba(250,204,21,0.1)]"
              : "hover:border-purple-500/50 hover:bg-[#100022] hover:shadow-[0_10px_20px_rgba(157,78,221,0.15)]"
          }`}>
          <div
            class={`flex h-14 w-14 shrink-0 items-center justify-center rounded-xl text-3xl transition-transform duration-300 group-hover:scale-110 ${
              isGold
                ? "border border-yellow-300/50 bg-gradient-to-br from-yellow-400 to-yellow-600 shadow-[0_0_15px_rgba(250,204,21,0.4)] group-hover:rotate-3"
                : "border border-purple-400/50 bg-gradient-to-br from-purple-600 to-purple-800 shadow-[0_0_15px_rgba(157,78,221,0.4)]"
            }`}>
            {item.icon}
          </div>
          <div class="flex flex-col gap-2">
            <h3
              class={`text-xl font-black tracking-wide drop-shadow-sm ${
                isGold
                  ? "bg-gradient-to-r from-yellow-300 to-yellow-500 bg-clip-text text-transparent"
                  : "bg-gradient-to-r from-white to-gray-300 bg-clip-text text-transparent transition-colors group-hover:text-yellow-400"
              }`}>
              {item.title}
            </h3>
            <p class="text-sm leading-relaxed text-gray-400 transition-colors group-hover:text-gray-300">{item.description}</p>
          </div>
        </div>
      );
    })
  }
</div>
