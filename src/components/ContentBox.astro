---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#0a2258] bg-[#000b24] p-8 text-left text-base leading-relaxed text-[#dbe9ff] shadow-[0_10px_30px_rgba(11,131,250,0.16)] transition-all duration-500 hover:border-[#0b83fa]/55 hover:shadow-[0_15px_40px_rgba(11,131,250,0.28)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#0b83fa]/16 blur-[60px] transition-all duration-500 group-hover:bg-[#6cc5ff]/26"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#e8202a]/14 blur-[60px] transition-all duration-500 group-hover:bg-[#ff8080]/22"></div>

    {
      title && (
        <header class="mb-6 flex items-center gap-4 border-b border-[#0a2258] pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#0b83fa] to-[#e8202a] shadow-[0_0_10px_rgba(11,131,250,0.45)]" />
          <HeadingTag class="text-2xl leading-normal font-black tracking-widest text-[#6cc5ff] uppercase">{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
