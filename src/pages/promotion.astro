---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "./components/ContentBox.astro";
import Navfoot from "./components/Navfoot.astro";
import Announcement from "./components/Announcement.astro";

import { Picture } from "astro:assets";
import image1 from "../assets/kikipro1.webp";
import image2 from "../assets/kikipro2.webp";
import image3 from "../assets/kikipro3.webp";
import image4 from "../assets/kikipro4.webp";
import image5 from "../assets/kikipro5.webp";
import image6 from "../assets/kikipro6.webp";
import image7 from "../assets/kikipro7.webp";
import image8 from "../assets/kikipro8.webp";
import image9 from "../assets/kikipro9.webp";
import image10 from "../assets/kikipro10.webp";
import image11 from "../assets/kikipro11.webp";
import image12 from "../assets/kikipro12.webp";
---

<MainLayout
  title="โปรโมชั่น KIKI49 คืนยอดเสีย แจกเครดิตฟรี ถอนไม่อั้น ไม่ติดเทิร์นโหด"
  ,
  description="รวมโปรโมชั่น KIKI49 แจกเครดิตฟรี และทีเด็ดคือโปรคืนยอดเสีย เอาไว้เป็นทุนแก้ตัวได้ เงื่อนไขแฟร์ ไม่บังคับทำเทิร์นโหดหืดขึ้นคอ เล่นได้เท่าไหร่กดถอนไปเลย">
  <Announcement />
  <ContentBox>
    <h1 class="mb-7 text-3xl">โปรโมชั่น KIKI49 คืนยอดเสีย แจกเครดิตฟรี ถอนไม่อั้น ไม่ติดเทิร์นโหด</h1>

    <div class="mb-5 grid grid-cols-2 gap-5 md:grid-cols-3">
      <div class="flex flex-col gap-4">
        <Picture
          src={image1}
          alt="กิจกรรมแนะนำเพื่อน KIKI49 รับโบนัสสูงสุด 10,000 บาท"
          loading="lazy"
          fetchpriority="low"
          widths={[200, 400, 600]}
          sizes="(max-width: 768px) 100vw, 33vw"
          class="mx-auto h-auto w-full max-w-[400px] object-contain shadow-xl"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={60}
        />
      </div>

      <div class="flex flex-col gap-4">
        <Picture
          src={image2}
          alt="โปรโมชั่น KIKI49 แจกรางวัลใหญ่ประจำเดือน รวมมูลค่ากว่า 1,000,000 บาท"
          loading="lazy"
          fetchpriority="low"
          widths={[200, 400, 600]}
          sizes="(max-width: 768px) 100vw, 33vw"
          class="mx-auto h-auto w-full max-w-[400px] object-contain shadow-xl"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />
      </div>

      <div class="flex flex-col gap-4">
        <Picture
          src={image3}
          alt="โปรโมชั่นสะสมเพชร KIKI49 แลกรางวัลใหญ่ iPhone ทองคำ และรถมอเตอร์ไซค์"
          loading="lazy"
          fetchpriority="low"
          widths={[200, 400, 600]}
          sizes="(max-width: 768px) 100vw, 33vw"
          class="mx-auto h-auto w-full max-w-[400px] object-contain shadow-xl"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />
      </div>

      <div class="flex flex-col gap-4">
        <Picture
          src={image3}
          alt="สะสมเพชรแลกรางวัลใหญ่กับ KIKI49 ยิ่งเล่นยิ่งได้เพชร"
          loading="lazy"
          fetchpriority="low"
          widths={[200, 400, 600]}
          sizes="(max-width: 768px) 100vw, 33vw"
          class="mx-auto h-auto w-full max-w-[400px] object-contain shadow-xl"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />
      </div>
      <div class="flex flex-col gap-4">
        <Picture
          src={image4}
          alt="แทงบอลออนไลน์กับ KIKI49 คืนยอดคอมมิชชั่น 0.3% ทุกบิล ค่าน้ำดีที่สุด"
          loading="lazy"
          fetchpriority="low"
          widths={[200, 400, 600]}
          sizes="(max-width: 768px) 100vw, 33vw"
          class="mx-auto h-auto w-full max-w-[400px] object-contain shadow-xl"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />
      </div>
      <div class="flex flex-col gap-4">
        <Picture
          src={image5}
