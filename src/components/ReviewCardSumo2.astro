---
const reviews = [
  {
    name: "สมาชิกที่ย้ายมาจากเว็บผ่านเอเย่นต์",
    role: "เทียบแล้วบอกว่าเกมส่งตรงจากค่ายแม่ต่างกันจริง",
    stars: 5,
    tag: "ลิขสิทธิ์แท้ ไม่ใช่ของก๊อป",
    content:
      "เคยเล่นเว็บที่รับเกมต่อมาอีกทอดจนรู้สึกว่าจังหวะเกมเพี้ยนไปจากที่เคยเล่น พอมาลอง GODKINGKONG ที่ส่งตรงผ่าน API จากค่ายแม่แบบ Official Server ก็เห็นความต่างเลยครับ ค่า RTP เต็มจำนวนถูกต้องตามเซิร์ฟเวอร์นอก ไม่มีการดัดแปลงค่าใดๆ ฟีเจอร์มาตามสถิติของเกมจริง เล่นแล้วสบายใจกว่ากันเยอะ",
    avatar: "🦍",
  },
  {
    name: "สมาชิกสายถอนยอดใหญ่ประจำสัปดาห์",
    role: "ถอนก้อนโตแล้วไม่โดนแบ่งจ่ายสักครั้ง",
    stars: 5,
    tag: "จ่ายจริงทุกยอด ไม่แบ่งจ่าย",
    content:
      "จุดที่ผมให้คะแนนเต็มคือเรื่องจ่ายครับ ทุนของเว็บหนาจริงตามที่ประกาศไว้ ถอนหลักแสนก็จบในรายการเดียว ไม่มีแบ่งจ่าย ไม่มีผ่อนส่ง ไม่ต้องทักตามเงินให้เสียเวลา ระบบออโต้ตัดยอดเองภายในไม่กี่วินาที เล่นได้เท่าไหร่ก็จ่ายเท่านั้น ไม่ต่อ ไม่กั๊ก สมกับที่เรียกตัวเองว่าเจ้าป่า",
    avatar: "👑",
  },
  {
    name: "สมาชิกทุนน้อยที่เพิ่งสมัครใหม่",
    role: "สมัครเองจบในไม่กี่นาที ไม่ต้องส่งเอกสาร",
    stars: 5,
    tag: "วอเล็ทไม่มีขั้นต่ำ",
    content:
      "สมัครเองหน้าเว็บได้เลยค่ะ กรอกข้อมูลไม่กี่ช่อง ตั้งรหัส แล้วเลือกวิธีฝาก ไม่ต้องส่งบัตรประชาชน ไม่ต้องถ่ายรูปหน้า ใช้ทรูวอเล็ทฝากได้ไม่มีขั้นต่ำ เริ่มจากหลักบาทก็เข้าเล่นได้จริง เล่นในมือถือลื่นไม่สะดุด กราฟิกคมกว่าเว็บเก่าที่เคยใช้อยู่หลายขุม",
    avatar: "⚡",
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label="เสียงจากสมาชิก GODKINGKONG" class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#7bff9f] via-[#2fe35f] to-[#f0c43a] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      เสียงจากสมาชิก <span class="text-[#2fe35f]">GODKINGKONG</span>
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#2fe35f] to-transparent"></div>
  </div>

  <div
    class="mx-auto mb-8 flex max-w-md items-center justify-center gap-5 rounded-2xl border border-[#2fe35f]/25 bg-[#0a1a10]/92 px-6 py-4 shadow-[0_10px_30px_rgba(5,15,9,0.5)] backdrop-blur-xl">
    <div class="flex flex-col items-center">
      <span class="bg-gradient-to-b from-[#7bff9f] to-[#0b6b34] bg-clip-text text-4xl leading-none font-black text-transparent">{average}</span>
      <span class="mt-1 text-[10px] font-bold tracking-widest text-[#ddf3e2]/70 uppercase">คะแนนเฉลี่ย</span>
    </div>
    <div class="h-12 w-px bg-[#0b6b34]/60"></div>
    <div class="flex flex-col gap-1.5">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#f0c43a]" : "text-[#0b6b34]/60"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#ddf3e2]/70">คะแนนเฉลี่ย {average} จาก 5 ดาว จากการใช้งานจริงของสมาชิก {reviews.length} ด้าน</span>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
    {
      reviews.map((review) => (
        <article class="group relative isolate flex flex-col gap-4 overflow-hidden rounded-2xl border border-[#2fe35f]/25 bg-[#0a1a10]/92 p-6 text-left shadow-[0_10px_30px_rgba(5,15,9,0.5)] backdrop-blur-xl transition-all duration-300 hover:-translate-y-1 hover:border-[#2fe35f]/55 hover:shadow-[0_15px_40px_rgba(47,227,95,0.30)]">
          <span class="absolute inset-y-0 left-0 -z-10 w-1 bg-gradient-to-b from-[#7bff9f] to-[#0b6b34] opacity-80 transition-opacity duration-300 group-hover:opacity-100" />
          <span class="pointer-events-none absolute -top-14 -right-14 -z-10 h-32 w-32 rounded-full bg-[#0d4a26]/60 blur-[50px] transition-all duration-300 group-hover:bg-[#2fe35f]/25" />

          <div class="flex items-center justify-between gap-3">
            <span class="inline-flex items-center gap-1.5 rounded-full border border-[#2fe35f]/25 bg-[#050f09] px-3 py-1 text-[10px] font-bold tracking-widest text-[#2fe35f] uppercase">
              <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#f0c43a]" />
              {review.tag}
            </span>
            <span class="flex gap-0.5 text-sm">
              <span aria-hidden="true" class="flex gap-0.5">
                {Array.from({ length: 5 }).map((_, i) => (
                  <span class={i < review.stars ? "text-[#f0c43a]" : "text-[#0b6b34]/60"}>★</span>
                ))}
              </span>
              <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
            </span>
          </div>

          <p class="text-left text-base leading-relaxed text-[#ddf3e2]">{review.content}</p>

          <div class="mt-auto flex items-center gap-3 border-t border-[#0b6b34]/60 pt-4">
            <span
              aria-hidden="true"
              class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#2fe35f]/30 bg-gradient-to-br from-[#7bff9f] via-[#2fe35f] to-[#0b6b34] text-xl shadow-inner transition-transform duration-300 group-hover:scale-110">
              {review.avatar}
            </span>
            <span class="flex flex-col">
              <span class="text-sm font-black text-[#ddf3e2] transition-colors group-hover:text-[#7bff9f]">{review.name}</span>
              <span class="text-[10px] font-bold tracking-wider text-[#ddf3e2]/70 uppercase">{review.role}</span>
            </span>
          </div>
        </article>
      ))
    }
  </div>
</section>
