---
export interface Props {
  title?: string;
  titleleft?: string;
  titleright?: string;
}
const { title, titleleft, titleright } = Astro.props;
const rightHeading = titleright ?? title;
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="w-full rounded-[25px] border border-[#153b26]/70 bg-[#08150d] p-8 shadow-[10px_10px_20px_#010603,-10px_-10px_20px_#0f2a1a] transition-all duration-300 hover:shadow-[15px_15px_30px_#000201,-15px_-15px_30px_#143723]">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#d5f0dd]">
        {titleleft && <h2 class="text-2xl leading-normal font-black text-[#12b84f]">{titleleft}</h2>}
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#d5f0dd] md:border-l md:border-[#153b26] md:pl-8">
        {rightHeading && <h2 class="text-2xl leading-normal font-black text-[#12b84f]">{rightHeading}</h2>}
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
