---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#7f1d1d] bg-[#280707] p-8 text-[#f7e2d6] shadow-[0_10px_30px_rgba(239,68,68,0.12)] transition-all duration-500 hover:border-[#ef4444]/45 hover:shadow-[0_15px_40px_rgba(239,68,68,0.18)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 bg-gradient-to-br from-[#5c1414] to-transparent opacity-70"></div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#7f1d1d] pb-4">
          <span aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ef4444] via-[#f87171] to-[#f5c542] shadow-[0_0_10px_rgba(239,68,68,0.35)]" />
          <HeadingTag class="bg-gradient-to-r from-[#f87171] via-[#fff5e6] to-[#f5c542] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-10 md:grid-cols-2">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f7e2d6]">
        {
          titleleft && (
            <p class="flex items-center gap-3 border-b border-[#7f1d1d] pb-3 text-xl leading-normal font-black tracking-widest text-[#ffe9a8] uppercase">
              <span aria-hidden="true" class="h-6 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ef4444] to-[#f5c542] shadow-[0_0_10px_rgba(239,68,68,0.30)]" />
              {titleleft}
            </p>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f7e2d6] md:border-l md:border-[#7f1d1d] md:pl-10">
        {
          titleright && (
            <p class="flex items-center gap-3 border-b border-[#7f1d1d] pb-3 text-xl leading-normal font-black tracking-widest text-[#ffe9a8] uppercase">
              <span aria-hidden="true" class="h-6 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#f5c542] to-[#ef4444] shadow-[0_0_10px_rgba(245,197,66,0.30)]" />
              {titleright}
            </p>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
