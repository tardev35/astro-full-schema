---
import { Picture } from "astro:assets";
import BankStrip from "./BankStrip.astro";

const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });
const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;
---

<footer class="relative w-full overflow-hidden border-t-[3px] border-[#12b84f] bg-[#040a06] pt-16 pb-8 text-white shadow-[0_-10px_30px_rgba(18,184,79,0.2)]">
  <div aria-hidden="true" class="pointer-events-none absolute top-0 right-0 h-96 w-96 rounded-full bg-[#12b84f]/12 blur-[100px]"></div>
  <div aria-hidden="true" class="pointer-events-none absolute bottom-0 left-0 h-96 w-96 rounded-full bg-[#8a6510]/30 blur-[100px]"></div>

  <div class="relative z-10 mx-auto w-full max-w-[1200px] px-6">
    <div class="mb-12 grid grid-cols-1 gap-10 md:grid-cols-2 lg:grid-cols-4 lg:gap-8">
      <div class="flex flex-col gap-5">
        <a href="/" class="inline-block origin-left transition-transform hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt="โลโก้ YOK789 สล็อตเว็บตรง คาสิโน หวย กีฬา"
                widths={[110, 220, 330]}
                sizes="110px"
                class="h-[50px] w-auto drop-shadow-[0_0_15px_rgba(18,184,79,0.5)]"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <span class="bg-gradient-to-b from-[#5cff9b] to-[#0a6b2f] bg-clip-text text-4xl font-black text-transparent drop-shadow-[0_0_10px_rgba(18,184,79,0.45)]">YOK789</span>
            )
          }
        </a>
        <p class="text-base leading-relaxed text-[#b7cfbe]">
          YOK789 สล็อตเว็บตรง รวมสล็อตกว่า 40 ค่าย เกมกว่า 4,000 รายการ คาสิโนสด หวย และกีฬา ไว้ในบัญชีเดียว พร้อมระบบฝากถอนออโต้ที่รองรับ PromptPay TrueMoney Wallet และธนาคารไทยหลายแห่ง ตลอด 24 ชั่วโมง
        </p>
        <div class="mt-2 flex items-center gap-3">
          <div class="flex items-center gap-1.5 rounded border border-[#12b84f]/50 bg-[#12b84f]/10 px-3 py-1.5 text-xs font-bold text-[#5cff9b] shadow-[0_0_10px_rgba(18,184,79,0.25)]">
            <span aria-hidden="true" class="text-base">🛡️</span> SSL/TLS 256-BIT
          </div>
          <div class="flex items-center gap-1.5 rounded border border-[#ffd94a]/50 bg-[#8a6510]/25 px-3 py-1.5 text-xs font-bold text-[#ffd94a]">
            <span aria-hidden="true" class="text-base">⚡</span> AUTO 24H
          </div>
        </div>
      </div>

      <nav aria-label="Quick Links" class="flex flex-col gap-4 lg:pl-8">
        <p class="flex items-center gap-2 text-lg font-extrabold text-[#5cff9b]">
          <span aria-hidden="true" class="h-6 w-1.5 rounded-full bg-gradient-to-b from-[#5cff9b] to-[#0a6b2f]"></span> เมนูหลัก
        </p>
        <ul class="flex flex-col gap-3 text-sm">
          {
            [
              { name: "หน้าแรก", path: "/" },
              { name: "โปรโมชั่น", path: "/promotion" },
              { name: "ทางเข้า", path: "/ทางเข้า" },
              { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
              { name: "เกี่ยวกับเรา", path: "/about-us" },
              { name: "ติดต่อเรา", path: "/contact-us" },
            ].map((link) => (
              <li>
                <a href={link.path} class="group flex items-center text-[#b7cfbe] transition-all hover:text-[#5cff9b]">
                  <span aria-hidden="true" class="mr-2 -ml-4 text-[#12b84f] opacity-0 transition-all group-hover:ml-0 group-hover:opacity-100">
                    ➤
                  </span>
                  {link.name}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav aria-label="Game Categories" class="flex flex-col gap-4">
        <p class="flex items-center gap-2 text-lg font-extrabold text-[#5cff9b]">
          <span aria-hidden="true" class="h-6 w-1.5 rounded-full bg-gradient-to-b from-[#5cff9b] to-[#0a6b2f]"></span> หมวดหมู่เกม
        </p>
        <ul class="flex flex-col gap-3 text-sm">
          {
            ["สล็อตออนไลน์ (Slot)", "คาสิโนสด (Live Casino)", "เดิมพันกีฬา (Sportsbook)", "หวยออนไลน์ (Lottery)", "เกมยิงปลา (Fishing)"].map((game) => (
              <li>
                <a href="/register" class="group flex items-center text-[#b7cfbe] transition-all hover:text-[#5cff9b]">
                  <span aria-hidden="true" class="mr-3 h-1.5 w-1.5 rounded-full bg-[#8a6510] transition-colors group-hover:bg-[#ffd94a] group-hover:shadow-[0_0_8px_rgba(255,217,74,0.8)]" />
                  {game}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="flex flex-col gap-5">
        <p class="flex items-center gap-2 text-lg font-extrabold text-[#5cff9b]">
          <span aria-hidden="true" class="h-6 w-1.5 rounded-full bg-gradient-to-b from-[#5cff9b] to-[#0a6b2f]"></span> บริการลูกค้า
        </p>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-lg bg-[#00B900] py-3 font-bold text-white shadow-[0_0_15px_rgba(0,185,0,0.3)] transition-transform hover:scale-105">
          <span class="text-xl font-black">LINE</span> @YOK789
        </a>

        <div class="mt-2">
          <p class="mb-3 text-xs font-bold tracking-wider text-[#5cff9b]/90 uppercase">รองรับทุกธนาคาร &amp; True Wallet</p>
          <BankStrip size={26} />
        </div>
      </div>
    </div>

    <div class="mb-6 flex flex-wrap justify-center gap-4 border-y border-[#12b84f]/25 py-6 opacity-60 grayscale transition-all duration-500 hover:opacity-100 hover:grayscale-0 md:gap-8">
      <span class="text-lg font-black text-gray-300 italic md:text-2xl">PG<span class="text-[#5cff9b]">SOFT</span></span>
      <span class="text-lg font-black text-gray-300 italic md:text-2xl">PRAGMATIC<span class="text-[#5cff9b]">PLAY</span></span>
      <span class="text-lg font-black text-gray-300 italic md:text-2xl">EVO<span class="text-[#5cff9b]">LUTION</span></span>
      <span class="text-lg font-black text-gray-300 italic md:text-2xl">JILI<span class="text-[#5cff9b]">GAMES</span></span>
      <span class="text-lg font-black text-gray-300 italic md:text-2xl">MICRO<span class="text-[#5cff9b]">GAMING</span></span>
    </div>

    <div class="flex flex-col items-center justify-between gap-4 text-xs text-[#8fa896] md:flex-row">
      <p>&copy; {new Date().getFullYear()} <span class="font-bold text-[#5cff9b]">YOK789</span>. All rights reserved. สล็อตเว็บตรง คืนยอดเสีย 8% ฝากถอนออโต้</p>
      <div class="flex gap-4">
        <a href="/terms/" class="transition-colors hover:text-[#5cff9b]">เงื่อนไขการให้บริการ</a>
        <a href="/privacy/" class="transition-colors hover:text-[#5cff9b]">นโยบายความเป็นส่วนตัว</a>
      </div>
    </div>
  </div>
</footer>

<style>
  footer a {
    text-decoration: none;
  }
  footer {
    font-family: var(--font-sans);
  }
</style>
