---
const { title, as: HeadingTag = "h1" } = Astro.props;
---

<section class="my-6 flex w-full justify-center px-4 font-sans">
  <div class="w-full max-w-7xl rounded-[25px] bg-[#141414] p-8 text-center text-white/90 shadow-[10px_10px_20px_#080808,-10px_-10px_20px_#202020]">
    {
      title && (
        <header class="mb-8">
          <HeadingTag class="text-3xl font-black text-white drop-shadow-md md:text-4xl">{title}</HeadingTag>
        </header>
      )
    }

    <div class="text-lg leading-relaxed text-gray-400">
      <slot />
    </div>
  </div>
</section>
<style>
  .font-sans {
    font-family: "Kanit", sans-serif;
  }
</style>
