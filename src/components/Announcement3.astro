---
const {
  message = "RIEL38 เว็บสล็อตมาใหม่ รวมเกมไว้กว่า 2,000 เกมจาก 30+ ค่ายดังในบัญชีเดียว • ทดลองเล่นฟรีทุกค่ายก่อนเปิดยูสจริง ดูรูปแบบเกมและฟีเจอร์ให้พอใจแล้วค่อยลงเครดิต • Smart Wallet รวมเครดิตไว้จุดเดียว สลับค่ายกี่รอบก็ไม่ต้องโยกเงินเอง • ระบบ AI หลังบ้านช่วยดูเกมที่เล่นบ่อย เทียบ RTP และสรุปโบนัสให้จากหน้าเมมเบอร์ • เข้าสู่ระบบด้วยยูสเดิมได้จากมือถือ แท็บเล็ต และคอมพิวเตอร์ • โปรฝาก 39 รับรวม 69 เทิร์น 1 เท่า ถอนได้สูงสุด 300 บาท",
} = Astro.props;
---

<div class="mx-auto mt-4 max-w-[900px] px-4 md:px-0">
  <div
    class="relative flex h-[46px] items-center rounded-r-full border border-[#f9a8d4] bg-gradient-to-r from-[#fce7f3] to-white py-2 pr-4 pl-12 shadow-[0_0_20px_rgba(236,72,153,0.14)] backdrop-blur-md">
    <div class="absolute top-1/2 -left-2 flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full border-[3px] border-[#ec4899] bg-white shadow-[0_0_15px_rgba(236,72,153,0.35)]">
      <span aria-hidden="true" class="animate-pulse text-xl">📢</span>
    </div>

    <div class="mr-4 h-full w-[1px] bg-[#ec4899]/25"></div>

    <div class="flex-1 overflow-hidden [mask-image:linear-gradient(90deg,transparent_0%,#000_5%,#000_95%,transparent_100%)]">
      <div class="flex w-max animate-[scroll_25s_linear_infinite] gap-12 text-sm font-bold whitespace-nowrap text-[#5b2140]">
        <span>{message}</span>
        <span>{message}</span>
      </div>
    </div>
  </div>
</div>

<style>
  @keyframes scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(calc(-50% - 24px));
    }
  }
</style>
