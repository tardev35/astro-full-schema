---
import { Picture } from "astro:assets";

const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.*", { eager: true });
const imagePaths = Object.keys(images);
const targetPath = imagePaths.find((path) => path.endsWith(".webp")) || imagePaths.find((path) => path.endsWith(".png")) || (imagePaths.length > 0 ? imagePaths[0] : null);
const mainLogo = targetPath ? images[targetPath].default : null;
---

<footer class="relative mt-12 w-full overflow-hidden rounded-t-[2.5rem] border-t border-green-500/30 bg-[#01140d] pt-16 pb-8 font-sans text-white shadow-[0_-10px_30px_rgba(0,0,0,0.8)]">
  <div class="pointer-events-none absolute inset-x-0 -top-20 mx-auto h-[150px] w-full max-w-4xl rounded-full bg-green-500/5 blur-[80px]"></div>

  <div class="relative z-10 mx-auto w-full max-w-[1400px] px-6">
    <div class="mb-12 grid grid-cols-1 gap-12 md:grid-cols-12">
      <div class="flex flex-col gap-4 md:col-span-5">
        <a href="/" class="inline-block transition-transform duration-300 hover:scale-105">
          {
            mainLogo ? (
              <Picture src={mainLogo} alt="LOTTO432 Logo" class="h-[50px] w-auto drop-shadow-[0_0_8px_rgba(34,197,94,0.4)]" formats={["avif", "webp"]} fallbackFormat="webp" />
            ) : (
              <h2 class="text-3xl font-black tracking-widest text-white">
                LOTTO<span class="text-green-500">432</span>
              </h2>
            )
          }
        </a>
        <p class="mt-2 border-l-2 border-yellow-500 pl-4 text-sm leading-relaxed text-green-100/60">
          LOTTO432 ศูนย์รวมหวยออนไลน์และสล็อตคาสิโนที่ปลอดภัยและได้รับความนิยมสูงสุดในประเทศไทย ระบบลื่นไหล มั่นคง มั่งคั่ง มอบประสบการณ์ระดับพรีเมียมให้คุณทุกวินาที
        </p>
        <div class="mt-2 flex gap-3">
          <span class="rounded-sm border border-green-500/30 bg-[#021c13] px-3 py-1 text-[10px] font-bold text-green-400">SECURE WEBSITE</span>
          <span class="rounded-sm border border-yellow-500/30 bg-yellow-500/10 px-3 py-1 text-[10px] font-bold text-yellow-400">VIP GUARANTEE</span>
        </div>
      </div>

      <nav class="flex flex-col gap-4 md:col-span-3 lg:pl-12">
        <h3 class="border-b border-green-500/20 pb-2 text-base font-black tracking-widest text-white uppercase">เมนูการใช้งาน</h3>
        <ul class="flex flex-col gap-3 text-sm font-medium text-green-100/60">
          <li><a href="/" class="transition-colors hover:text-yellow-400">หน้าแรก</a></li>
          <li><a href="/ตรวจหวย" class="transition-colors hover:text-yellow-400">ตรวจผลรางวัล</a></li>
          <li><a href="/แนวทาง" class="transition-colors hover:text-yellow-400">แนวทางหวยเด็ด</a></li>
          <li><a href="/promotion" class="transition-colors hover:text-yellow-400">โปรโมชั่นพิเศษ</a></li>
          <li><a href="/contact" class="transition-colors hover:text-yellow-400">ติดต่อฝ่ายซัพพอร์ต</a></li>
        </ul>
      </nav>

      <div class="flex flex-col gap-4 md:col-span-4">
        <h3 class="border-b border-green-500/20 pb-2 text-base font-black tracking-widest text-white uppercase">ฝ่ายบริการลูกค้า</h3>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-md bg-gradient-to-r from-[#00b900] to-[#009900] py-3 text-sm font-black text-white shadow-md transition-all hover:-translate-y-0.5">
          💬 แชทสดผ่าน LINE Official (24 ชม.)
        </a>

        <div class="mt-2 text-xs font-bold text-green-300/40">ระบบการเงินอัตโนมัติรองรับ:</div>
        <div class="flex flex-wrap gap-2 opacity-80">
          <div class="rounded border border-white/5 bg-white/5 px-2 py-1 font-mono text-[10px]">KBANK</div>
          <div class="rounded border border-white/5 bg-white/5 px-2 py-1 font-mono text-[10px]">SCB</div>
          <div class="rounded border border-white/5 bg-white/5 px-2 py-1 font-mono text-[10px]">KTB</div>
          <div class="rounded border border-white/5 bg-white/5 px-2 py-1 font-mono text-[10px]">BBL</div>
          <div class="rounded border border-white/5 bg-white/5 px-2 py-1 font-mono text-[10px]">TRUE WALLET</div>
        </div>
      </div>
    </div>

    <div class="flex flex-col items-center justify-between border-t border-green-900/40 pt-6 text-xs font-medium text-green-100/30 md:flex-row">
      <p>COPYRIGHT &copy; {new Date().getFullYear()} LOTTO432. ALL RIGHTS RESERVED.</p>
      <div class="mt-3 flex gap-4 md:mt-0">
        <a href="/" class="transition-colors hover:text-white">เงื่อนไขข้อตกลง</a>
        <a href="/" class="transition-colors hover:text-white">นโยบายความเป็นส่วนตัว</a>
      </div>
    </div>
  </div>
</footer>
<style>
  .font-sans {
    font-family: "Kanit", sans-serif;
  }
</style>
