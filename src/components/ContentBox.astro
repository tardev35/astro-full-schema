---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#4a1030] bg-[#170512] p-8 text-left text-base leading-relaxed text-[#f3e3ee] shadow-[0_10px_30px_rgba(255,45,142,0.16)] transition-all duration-500 hover:border-[#ff2d8e]/55 hover:shadow-[0_15px_40px_rgba(255,45,142,0.28)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#ff2d8e]/16 blur-[60px] transition-all duration-500 group-hover:bg-[#ff74b6]/26"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#ffe814]/14 blur-[60px] transition-all duration-500 group-hover:bg-[#fff27a]/22"></div>

    {
      title && (
        <header class="mb-6 flex items-center gap-4 border-b border-[#4a1030] pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ff2d8e] to-[#ffe814] shadow-[0_0_10px_rgba(255,45,142,0.45)]" />
          <HeadingTag class="text-2xl leading-normal font-black tracking-widest text-[#ffe814] uppercase">{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
