---
export interface Props {
  titleleft?: string;
  titleright?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { titleleft, titleright, as: HeadingTag = "h2" } = Astro.props;
---

<section class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-t-4 border-[#1a4a9c] border-t-[#0b7cf4] bg-[#041a45] p-8 text-[#dbe9ff] shadow-[0_10px_30px_rgba(0,0,0,0.35)] transition-all duration-500 hover:border-[#2f7bff] hover:border-t-[#4da3ff] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -right-20 -z-10 h-40 w-40 rounded-full bg-[#0b7cf4]/15 blur-[60px] transition-all duration-500 group-hover:bg-[#0b7cf4]/25">
    </div>
    <div aria-hidden="true" class="pointer-events-none absolute -bottom-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#e8202a]/12 blur-[60px] transition-all duration-500 group-hover:bg-[#e8202a]/18">
    </div>

    <div class="grid grid-cols-1 gap-8 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 border-b border-[#1a4a9c] pb-6 text-center text-base font-medium text-[#9fb8dc] md:border-r md:border-b-0 md:pr-6 md:pb-0 md:text-left">
        {titleleft && <p class="text-center text-4xl leading-normal font-black tracking-wider text-[#4da3ff] uppercase md:text-left">{titleleft}</p>}
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#dbe9ff] md:pl-6">
        {titleright && <HeadingTag class="flex items-center gap-2 text-2xl leading-normal font-black text-white">{titleright}</HeadingTag>}
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
