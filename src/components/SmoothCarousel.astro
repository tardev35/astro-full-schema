---
import { Picture } from "astro:assets";

import slide1 from "../assets/slide1.png";
import slide2 from "../assets/slide2.png";
import slide3 from "../assets/slide3.png";
import slide4 from "../assets/slide4.png";

const images = [
  {
    src: slide1,
    alt: "แบนเนอร์ OKG777 หัวข้อ รีวิวสล็อต OKG777 เกมใหม่ + ค่ายดัง พร้อมโลโก้ OKG777 และพรีเซนเตอร์ชี้ไปที่ตารางเกม 12 เกม ได้แก่ Dragon Fortune, Lucky Panda, Golden Treasure, Wild Safari, Crystal Gems, Mermaid's Pearl, Joker's Fiesta, Sweet Bonanza, Pharaoh's Riches, Buffalo Blitz, Fortune Mouse และ Magic Wizard ด้านซ้ายมีป้าย เกมใหม่ หลายค่าย เล่นง่าย และแถบท้ายระบุค่าย PG JILI JOKER SLOTXO HABANERO",
  },
  {
    src: slide2,
    alt: "แบนเนอร์ OKG777 บนพื้นเมืองนีออนสีม่วง ข้อความ สมาชิกใหม่ OKG777 รับฟรี 18 บาท เป็นตัวเลขขนาดใหญ่ พร้อมป้าย เครดิตฟรี 38 บาท ชวนเพื่อนรับ 88 บาท และคืนยอดเสีย 8% มีไพ่ ลูกเต๋า และชิปคาสิโนประกอบ ด้านล่างระบุ สล็อต คาสิโน กีฬา และข้อความ เช็กเงื่อนไขก่อนรับสิทธิ์",
  },
  {
    src: slide3,
    alt: "แบนเนอร์ OKG777 หัวข้อ รีวิวสล็อต OKG777 รวมเกมใหม่และค่ายดัง พร้อมบรรทัดรอง เล่นง่าย ครบทั้งสล็อต คาสิโน กีฬา และตารางเกม 8 เกม ได้แก่ เกมตกปลา แมวทองนำโชค สมบัติอารยธรรม จักรวรรดิโรมัน มหาเทพโอลิมปัส ไฮโลไฮเฮง มาจองเฮงๆ และเทพเจ้าโชคลาภ ปิดท้ายด้วยข้อความ สมาชิกใหม่รับฟรี 18 บาท",
  },
  {
    src: slide4,
    alt: "แบนเนอร์ OKG777 ข้อความ สมาชิกใหม่ OKG777 รับฟรี 18 บาท เป็นตัวอักษรทองขนาดใหญ่ พร้อมป้าย คืนยอดเสีย 8% และ ฝากถอนออโต้ 24 ชม. มีเหรียญทองและลูกเต๋ากระจายรอบภาพ แถบท้ายระบุ สล็อต คาสิโน กีฬา บัญชีเดียว",
  },
];

const COPIES = 3;
const slides = Array.from({ length: COPIES }, () => images).flat();
---

<div class="marquee mx-auto w-full max-w-[1301px] overflow-hidden px-4 py-5">
  <input id="carousel-pause" type="checkbox" class="peer sr-only" />
  <label
    for="carousel-pause"
    class="sr-only cursor-pointer peer-focus-visible:not-sr-only peer-focus-visible:mb-3 peer-focus-visible:inline-block peer-focus-visible:rounded-full peer-focus-visible:border peer-focus-visible:border-[#ffd400]/60 peer-focus-visible:px-4 peer-focus-visible:py-2 peer-focus-visible:text-sm peer-focus-visible:font-bold peer-focus-visible:text-[#ffe94d]">
    หยุด / เล่นสไลด์ภาพ
  </label>

  <div class="marquee-track flex">
    {
      slides.map((slide, index) => {
        const isDuplicate = index >= images.length;
        return (
          <div class="marquee-slide" aria-hidden={isDuplicate ? "true" : undefined}>
            <Picture
              src={slide.src}
              alt={isDuplicate ? "" : slide.alt}
              class="block w-full rounded-xl border border-[#ffd400]/25 object-cover shadow-[0_10px_30px_rgba(255,212,0,0.18)]"
              width={slide.src.width}
              height={slide.src.height}
              loading="lazy"
              fetchpriority="low"
              decoding="async"
              widths={[200, 400, 600]}
              sizes="(max-width: 768px) 50vw, 33vw"
              formats={["avif", "webp"]}
              fallbackFormat="webp"
              quality={60}
            />
          </div>
        );
      })
    }
  </div>
</div>

<style>
  .marquee {
    --gap: 12px;
    --per-view: 2;
    --shift: calc(-200% - 24px);
  }

  @media (min-width: 768px) {
    .marquee {
      --gap: 16px;
      --per-view: 3;
      --shift: calc(-133.3333% - 21.3333px);
    }
  }

  .marquee-track {
    gap: var(--gap);
    width: 100%;
    animation: carousel-scroll 32s linear infinite;
    will-change: transform;
  }

  .marquee-slide {
    flex: 0 0 calc((100% - (var(--per-view) - 1) * var(--gap)) / var(--per-view));
  }

  @keyframes carousel-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(var(--shift));
    }
  }

  .marquee:hover .marquee-track,
  .marquee:focus-within .marquee-track,
  .marquee > input:checked ~ .marquee-track {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
    }
  }
</style>
