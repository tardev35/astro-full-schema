---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";
import CtaRedirect from "../components/CtaRedirect.astro";
import { pageGraph } from "../lib/schema";

const pageDescription =
  "สมัครสมาชิก PIGAUTO หน้าสมัครเว็บหลัก กดปุ่มเดียวเริ่มสร้างบัญชีผ่านมือถือ เข้าเล่นสล็อตเว็บตรงระบบออโต้ ฝากถอนอัตโนมัติ ไม่บังคับขั้นต่ำ รองรับทรูวอลเล็ท";

const graph = pageGraph(Astro, {
  name: "สมัครสมาชิก PIGAUTO เว็บหลัก",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "สมัครสมาชิก", path: "/register" },
  ],
});

const targetUrl = "https://yoalink.com/22hs";
---

<MainLayout title="สมัครสมาชิก PIGAUTO | เปิดบัญชีเว็บตรงสล็อตออโต้" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="สมัครสมาชิก PIGAUTO" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label="สมัครสมาชิก"
        class="group relative mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#f5c542]/60 bg-gradient-to-b from-[#ffe9a8] via-[#f5c542] to-[#a9761a] px-6 py-4 text-xl font-bold tracking-wide text-[#1c0403] shadow-[0_10px_30px_rgba(245,197,66,0.24)] transition-all duration-300 hover:scale-105 hover:shadow-[0_15px_40px_rgba(245,197,66,0.4)]">
        สมัครสมาชิก
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="สมัครสมาชิก" />
</MainLayout>
