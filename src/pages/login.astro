---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";
import CtaRedirect from "../components/CtaRedirect.astro";
import { pageGraph } from "../lib/schema";

const pageTitle = "เข้าสู่ระบบ 777RUAY | ล็อกอินด้วยยูสเดิม เล่นสล็อตออนไลน์ต่อได้ทุกเครื่อง";

const pageDescription =
  "หากคุณกำลังมองหาทางเล่นต่อจากเครื่องไหนก็ได้ 777RUAY พร้อมให้สมาชิกเดิมล็อกอินด้วยยูสและรหัสเดิมผ่านเบราว์เซอร์ ไม่ต้องสมัครซ้ำ เพื่อปั่นสล็อตออนไลน์ต่อได้ทันที";

const announcementMessage =
  "777RUAY สล็อตออนไลน์ เล่นผ่านเบราว์เซอร์ได้ทั้ง iOS และ Android ไม่ต้องโหลดแอป • ฝากถอนออโต้ตลอด 24 ชั่วโมง ไม่ต้องแนบสลิป • สมัคร ฝาก เล่น และถอนจบบนมือถือเครื่องเดียว • มีเรื่องติดขัดติดต่อแอดมินผ่านช่องทางบนหน้าเว็บ";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เข้าสู่ระบบ", path: "/login" },
  ],
});

const targetUrl = "https://yoalink.com/22hs";
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement message={announcementMessage} />

  <ContentBox title="เข้าสู่ระบบ 777RUAY" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label="เข้าสู่ระบบ 777RUAY"
        class="group relative mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-full border-2 border-[#b07d12]/40 bg-gradient-to-b from-[#ffd45c] via-[#e0a91b] to-[#b07d12] px-6 py-4 text-xl font-bold tracking-wide text-[#0a1f5c] shadow-[0_0_15px_rgba(224,169,27,0.40)] transition-all duration-300 hover:scale-105 hover:brightness-110 hover:shadow-[0_15px_40px_rgba(224,169,27,0.40)]">
        เข้าสู่ระบบ 777RUAY
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="เข้าสู่ระบบ" />
</MainLayout>
