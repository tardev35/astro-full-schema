---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement2.astro";
import { pageGraph } from "../lib/schema";

const pageTitle = "เกี่ยวกับ SUPREME888 เว็บสล็อตจ่ายเต็มทุกยอด ฝากถอนออโต้ทำเองได้ เล่นจบบนมือถือ";

const pageHeading = "เกี่ยวกับ SUPREME888 สล็อตที่จ่ายเต็มทุกยอด ฝากถอนออโต้กดเองได้ และมีแอดมินดูแล 24 ชม.";

const pageDescription =
  "รู้จัก SUPREME888 เว็บสล็อตจ่ายเต็มทุกยอดไม่หักเปอร์เซ็นต์ ฝากถอนออโต้เริ่ม 20 บาทผ่านทุกธนาคารและ TrueMoney Wallet เกมหลายค่าย เล่นบนมือถือ แอดมินดูแล 24 ชม.";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});

const linkClass = "font-bold text-[#b5121a] underline underline-offset-4 hover:text-[#ec1b24]";
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox as="h1" title={pageHeading}>
    <p class="mb-4 text-left text-base leading-relaxed">
      <strong class="text-[#b5121a]">SUPREME888</strong> เป็นเว็บสล็อตที่เราตั้งใจทำไม่กี่เรื่อง แต่ทำให้ชัดทุกเรื่อง ยอดถอนต้องเข้าเต็ม ฝากถอนต้องกดเองได้ เกมต้องมีให้เลือกหลายค่าย และต้องมีคนรับเรื่องตลอด 24 ชั่วโมงครับ
    </p>

    <p class="mb-4 text-left text-base leading-relaxed">
      เราคือทีมแอดมินของ SUPREME888 เวลาคนใหม่ทักมา เรื่องแรกที่อยากรู้มักเป็นเรื่องเงิน ว่าถอนแล้วได้ครบไหม และต้องรอนานแค่ไหน เราเลยเล่าเว็บนี้จากเรื่องเงินก่อนเรื่องเกม
    </p>

    <p class="text-left text-base leading-relaxed">เว็บที่ดีไม่จำเป็นต้องมีทุกอย่าง แค่เรื่องที่บอกไว้ต้องเป็นจริงทุกครั้งที่กด</p>
  </ContentBox>

  <ContentBox as="h2" title="SUPREME888 จ่ายเต็มทุกยอดไม่หักเปอร์เซ็นต์ ส่วนโปรสมาชิกใหม่มีเงื่อนไขให้อ่านก่อนรับ">
    <p class="mb-4 text-left text-base leading-relaxed">
      ยอดที่กดถอนได้จะโอนเข้าบัญชีเต็มจำนวน เราไม่หักเปอร์เซ็นต์จากบิลไหนเลย บิลเล็กหรือบิลใหญ่ใช้กติกาเดียวกัน ถอนก้อนใหญ่ได้โดยไม่ต้องกังวลว่าจะโดนหักหัวคิวครับ
    </p>

    <p class="mb-4 text-left text-base leading-relaxed">
      คนเปิดยูสครั้งแรกมีโปรสมาชิกใหม่รอรับอยู่ รายละเอียดทั้งหมดอยู่ใน<a href="/promotion/" class={linkClass}>หน้าโปรโมชั่น</a> ก่อนรับลองเปิดดูว่าโปรมีเงื่อนไขยอดฝากไหม ต้องทำเทิร์นก่อนถอนหรือเปล่า และนับยอดจากเกมไหน
    </p>

    <p class="text-left text-base leading-relaxed">ยอดถอนเต็มจำนวนคือกติกาของเว็บ เงื่อนไขโปรคือกติกาของโปรแต่ละตัว อ่านแยกกันแล้วจะไม่สับสนตอนกดถอน</p>
  </ContentBox>

  <ContentBox as="h2" title="ฝากถอนออโต้ของ SUPREME888 เริ่ม 20 บาท ทำรายการเองได้ทั้ง 24 ชั่วโมง">
    <p class="mb-4 text-left text-base leading-relaxed">
      ฝากเริ่มที่ 20 บาท ถอนเริ่มที่ 50 บาท ใช้ได้ทุกธนาคารและ TrueMoney Wallet ทั้งขาฝากและขาถอน พอยอดเข้า ระบบปรับเครดิตให้เองในไม่กี่วินาที ไม่ต้องส่งสลิปให้แอดมินดูครับ
    </p>

    <p class="mb-4 text-left text-base leading-relaxed">
      ขาถอนกดเองได้ตลอด 24 ชั่วโมง ถอนตอนดึกก็ไม่ต้องรอใครตื่นมาอนุมัติ ถ้าโอนแล้วเครดิตยังไม่ขึ้น อย่าเพิ่งโอนซ้ำ ขั้นตอนเต็มอยู่ที่หน้า <a href="/วิธีฝากถอน/" class={linkClass}>วิธีฝากถอน</a>
    </p>

    <p class="text-left text-base leading-relaxed">ระบบออโต้ทำให้รายการเร็ว ส่วนเวลากับยอดที่จดไว้คือสิ่งที่ทำให้ตามเรื่องเจอเร็ว</p>
  </ContentBox>

  <ContentBox as="h2" title="เกมสล็อตหลายค่ายในเว็บเดียว เลือกจากกลไกก่อนดูหน้าปก">
    <p class="mb-4 text-left text-base leading-relaxed">
      เกมบน SUPREME888 มาจากค่ายที่สายปั่นไทยเปิดบ่อย ทั้ง PG Soft, Pragmatic Play, JILI และ Joker Gaming อยากสลับค่ายก็สลับได้ในเว็บเดียว ไม่ต้องย้ายไปเปิดยูสที่อื่นครับ
    </p>

    <p class="mb-4 text-left text-base leading-relaxed">
      เราไม่แนะนำเกมด้วยชื่อเดียว เราแนะนำให้ดูกลไกก่อน รอบฟรีสปินเข้าแบบไหน ตัวคูณทำงานตอนไหน เกมนั้นมีปุ่มซื้อฟีเจอร์หรือเปล่า แล้วคัดไว้สองสามเกมที่จังหวะตรงกับทุนของตัวเอง
    </p>

    <p class="text-left text-base leading-relaxed">เกมที่ใช่คือเกมที่จังหวะเข้ากับทุนในกระเป๋า ไม่ใช่เกมที่หน้าปกสวยที่สุด</p>
  </ContentBox>

  <ContentBox as="h2" title="เล่นจบบนมือถือ ทั้ง iOS และ Android ผ่านเบราว์เซอร์ ไม่ต้องโหลดแอป">
    <p class="mb-4 text-left text-base leading-relaxed">
      ทุกขั้นตอนของ SUPREME888 จบได้ในมือถือเครื่องเดียว ตั้งแต่สมัคร ฝากเครดิต ดูโปร เปิดเกม ไปจนถึงกดถอน ใช้ได้ทั้ง iOS และ Android ผ่านเบราว์เซอร์ในเครื่อง ไม่ต้องโหลดแอปเพิ่มครับ
    </p>

    <p class="mb-4 text-left text-base leading-relaxed">
      คนใหม่เริ่มที่หน้า <a href="/register/" class={linkClass}>สมัครสมาชิก</a> แล้วกรอกตามขั้นตอนที่ระบบแสดง ส่วนสมาชิกเดิมที่เปลี่ยนเครื่อง เข้าผ่าน <a href="/ทางเข้า/" class={linkClass}>ทางเข้า SUPREME888</a> แล้วล็อกอินด้วยยูสและรหัสเดิม ไม่ต้องสมัครซ้ำ
    </p>

    <p class="text-left text-base leading-relaxed">เปลี่ยนเครื่องได้ ยูสยังเป็นของเดิม สิ่งที่ต้องพกไปด้วยมีแค่รหัสที่จำไว้เอง</p>
  </ContentBox>

  <ContentBox as="h2" title="แอดมิน SUPREME888 รับเรื่องตลอด 24 ชม. ทุกเรื่องที่ระบบออโต้ตอบให้ไม่ได้">
    <p class="mb-4 text-left text-base leading-relaxed">
      บางเรื่องระบบออโต้ตอบให้ไม่ได้ เช่น ล็อกอินไม่ผ่าน เครดิตไม่ขึ้นหลังโอน ถอนค้างสถานะนานผิดปกติ หรือโปรไม่โชว์ เรื่องแบบนี้ต้องคนคุยกับคน และแอดมินของเรารับเคสตลอด 24 ชั่วโมงครับ
    </p>

    <p class="mb-4 text-left text-base leading-relaxed">
      ทักได้ทาง <a href="/line/" class={linkClass}>LINE Official</a> หรือดูช่องทางทั้งหมดที่หน้า <a href="/contact-us/" class={linkClass}>ติดต่อเรา</a> แจ้งชื่อยูส เวลาที่ทำรายการ และยอดเงินมาด้วยกัน และไม่ต้องส่งรหัสผ่านหรือ OTP ให้ใครทั้งนั้น
    </p>

    <p class="text-left text-base leading-relaxed">ยิ่งข้อมูลที่ทักมาครบ เรายิ่งไม่ต้องถามกลับ และเรื่องก็จบได้เร็วขึ้น</p>
  </ContentBox>

  <Navfoot />
</MainLayout>
