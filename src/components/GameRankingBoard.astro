---
import { Picture } from "astro:assets";
import img1 from "../assets/providers/game1.avif";
import img2 from "../assets/providers/game2.avif";
import img3 from "../assets/providers/game3.avif";
import img4 from "../assets/providers/game4.avif";
import img5 from "../assets/providers/game5.avif";
import img6 from "../assets/providers/game6.avif";

const games = [
  {
    rank: 1,
    name: "สล็อตหมุนคลาสสิก",
    type: "หมวดที่สมาชิก VING999 เปิดบ่อยที่สุด วงล้อคุ้นมือ กติกาตรงไปตรงมา เข้าเล่นต่อจากยูสเดิมได้เลย",
    menus: ["วงล้อคลาสสิก", "เล่นประจำ"],
    players: 5124,
    img: img4,
  },
  { rank: 2, name: "สล็อตฟรีสปิน", type: "เกมที่มีรอบหมุนฟรีอยู่ในตัว เหมาะกับคนที่ชอบรอจังหวะฟีเจอร์มากกว่าหมุนรัวยาว", menus: ["ฟรีสปิน", "รอฟีเจอร์"], players: 3842, img: img5 },
  { rank: 3, name: "สล็อตโบนัสฟีเจอร์", type: "หมวดเกมที่มีฟีเจอร์โบนัสหลายชั้น เลือกเกมจากหน้ารวมแล้วเปิดเล่นได้ทันที", menus: ["เกมโบนัส", "หลายฟีเจอร์"], players: 3517, img: img2 },
  { rank: 4, name: "เกมค่ายดังเปิดใหม่", type: "เกมที่เพิ่งเข้าระบบจากผู้ให้บริการหลายค่าย สำหรับสายที่ชอบลองของใหม่โดยใช้บัญชีเดิม", menus: ["ของใหม่", "หลายค่าย"], players: 2905, img: img6 },
  { rank: 5, name: "สล็อตแยกตามธีม", type: "ไล่ดูเกมจากธีมที่ชอบได้จากหน้ารวม เกมเยอะจะมีประโยชน์ก็ต่อเมื่อกดหาแล้วเจอ", menus: ["ตามธีม", "หาง่าย"], players: 2431, img: img3 },
  { rank: 6, name: "เกมที่เล่นล่าสุดและรายการโปรด", type: "กลับไปเปิดเกมที่เคยเล่นได้ทันทีจากหน้าเมมเบอร์ VING999 ไม่ต้องไล่หาใหม่ทุกรอบ", menus: ["เล่นประจำ", "รายการโปรด"], players: 2108, img: img1 },
];

const medal = (rank: number) => (rank === 1 ? "🥇" : rank === 2 ? "🥈" : rank === 3 ? "🥉" : null);
---

<section aria-label="หมวดเกมสล็อตที่สมาชิก VING999 เลือกเปิดเล่นบ่อย" class="mx-auto w-full max-w-[1300px] px-4 py-8 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <span aria-hidden="true" class="text-2xl">🏆</span>
    <p class="bg-gradient-to-r from-[#ff3b46] via-[#f2f5f7] to-[#bdcad2] bg-clip-text text-2xl font-black tracking-widest text-transparent uppercase">หมวดเกมสล็อตที่สมาชิก VING999 เปิดเล่นบ่อยที่สุด</p>
    <p class="max-w-3xl text-base leading-relaxed text-[#dce3e8]">
      ทุกหมวดในตารางนี้อยู่หลังยูสเดียวกันและใช้เครดิตชุดเดียวกัน เปลี่ยนจากสล็อตคลาสสิกไปเกมฟรีสปินของอีกค่ายได้โดยไม่ต้องออกจากระบบ ลำดับความนิยมขยับตามคนที่เข้ามาใช้งานในแต่ละช่วง
      ไม่ได้แปลว่าหมวดไหนให้อัตราจ่ายดีกว่าหมวดไหน เลือกจากสไตล์ที่ถนัดแล้วเข้าเล่นต่อจากหน้าเมมเบอร์ได้เลย
    </p>
    <div class="mt-2 h-[3px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#e01b2d] to-transparent"></div>
  </div>

  <div class="flex flex-col gap-3">
    {
      games.map((g) => {
        const top = g.rank === 1;
        return (
          <article
            class={`group relative flex items-center gap-3 overflow-hidden rounded-2xl border p-3 transition-all duration-300 hover:-translate-y-0.5 sm:gap-5 sm:p-4 ${
              top
                ? "border-[#e01b2d]/60 bg-gradient-to-r from-[#220d0f] via-[#170a0b] to-[#1c1013] shadow-[0_15px_40px_rgba(224,27,45,0.26)]"
                : "border-[#5a1a1e] bg-[#170a0b] shadow-[0_10px_30px_rgba(224,27,45,0.14)] hover:border-[#e01b2d]/60 hover:shadow-[0_15px_40px_rgba(224,27,45,0.26)]"
            }`}>
            <div
              aria-hidden="true"
              class="pointer-events-none absolute top-1/2 -left-10 h-24 w-24 -translate-y-1/2 rounded-full bg-[#e01b2d]/16 blur-[40px] transition-all duration-500 group-hover:bg-[#bdcad2]/20"
            />

            <div class="relative z-10 flex w-8 shrink-0 flex-col items-center justify-center sm:w-12">
              {medal(g.rank) ? (
                <span class="text-2xl sm:text-3xl">
                  <span aria-hidden="true">{medal(g.rank)}</span>
                  <span class="sr-only">อันดับ {g.rank}</span>
                </span>
              ) : (
                <span class="text-xl font-black text-[#ff3b46] sm:text-2xl">#{g.rank}</span>
              )}
            </div>

            <div class={`relative z-10 h-14 w-14 shrink-0 overflow-hidden rounded-xl border sm:h-16 sm:w-16 ${top ? "border-[#e01b2d]/60" : "border-[#5a1a1e]"}`}>
              <Picture
                src={g.img}
                alt={`ภาพหน้าปกเกมของหมวด ${g.name} บนกระดานหมวดเกมสล็อตยอดนิยมของ VING999`}
                formats={["avif", "webp"]}
                fallbackFormat="webp"
                loading="lazy"
                fetchpriority="low"
                widths={[100, 200]}
                quality={60}
                sizes="(max-width: 640px) 56px, 64px"
                decoding="async"
                class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-110"
              />
            </div>

            <div class="relative z-10 min-w-0 flex-1">
              <div class="flex items-center gap-2">
                <p class="truncate text-base font-black text-[#f2f5f7] sm:text-lg">{g.name}</p>
                {top && (
                  <span class="hidden shrink-0 rounded-full border border-[#e01b2d]/50 bg-[#220d0f] px-2 py-0.5 text-[9px] font-black tracking-wider text-[#bdcad2] sm:inline">ยอดนิยมสูงสุด</span>
                )}
              </div>
              <p class="truncate text-[11px] text-[#b3bec6] sm:text-xs">{g.type}</p>

              <div class="mt-2 flex flex-wrap items-center gap-1.5">
                {g.menus.map((m) => (
                  <span class="rounded-full border border-[#5a1a1e] bg-[#0a0506] px-2.5 py-0.5 text-[10px] font-bold text-[#bdcad2]">{m}</span>
                ))}
              </div>
            </div>

            <div class="relative z-10 hidden shrink-0 flex-col items-end gap-1 sm:flex">
              <span class="flex items-center gap-1.5 text-[11px] text-[#b3bec6]">
                <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-green-400 shadow-[0_0_6px_rgba(74,222,128,0.7)]" />
                <span class="tabular-nums" data-players data-base={g.players}>
                  {g.players.toLocaleString("en-US")}
                </span>{" "}
                ออนไลน์
              </span>
              <a
                href="/register"
                class={`rounded-full px-4 py-1.5 text-xs font-black transition-transform hover:scale-105 ${
                  top
                    ? "bg-gradient-to-r from-[#ff3b46] via-[#e01b2d] to-[#8f0a13] text-[#f2f5f7] shadow-[0_10px_30px_rgba(224,27,45,0.28)]"
                    : "border border-[#5a1a1e] bg-[#0a0506] text-[#bdcad2] hover:border-[#e01b2d]/60 hover:bg-[#220d0f]"
                }`}>
                เข้าดูหมวดนี้
              </a>
            </div>
          </article>
        );
      })
    }
  </div>
</section>

<script>
  import { startLiveCounters } from "../lib/liveCounter";

  startLiveCounters();
</script>
