---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementCyber.astro";
import { pageGraph } from "../lib/schema";

const pageTitle = "เกี่ยวกับ TG787 | คาสิโนสดและสล็อตเว็บตรง ฝากถอนไม่มีขั้นต่ำ";

const pageHeading = "เกี่ยวกับ TG787 คาสิโนออนไลน์ถ่ายทอดสดควบคู่สล็อตเว็บตรง";

const pageDescription =
  "รู้จัก TG787 เว็บตรงที่เปิดคาสิโนออนไลน์ถ่ายทอดสดจาก WM Casino และ Dream Gaming คู่กับสล็อต ฝากถอนไม่มีขั้นต่ำ ระบบออโต้เสร็จใน 3 นาที เล่นผ่านเบราว์เซอร์";

const announcementMessage =
  "TG787 คาสิโนออนไลน์ถ่ายทอดสดควบคู่สล็อตเว็บตรง • ฝากถอนไม่มีขั้นต่ำ ระบบออโต้ทำรายการเสร็จใน 3 นาที ตลอด 24 ชั่วโมง • ล็อกอินยูสเดิมได้ทุกเครื่องทั้ง iOS และ Android ผ่านเบราว์เซอร์ • ติดปัญหาการใช้งานติดต่อแอดมินผ่านช่องทางบนหน้าเว็บได้ทันที";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});

const bodyClass = "mb-4 text-left text-base leading-relaxed text-[#2b2622]";
const closerClass = "text-left text-base leading-relaxed text-[#2b2622]";
const brandClass = "font-bold text-[#a84a06]";
const linkClass = "font-bold text-[#1557b0] underline underline-offset-4 transition-colors hover:text-[#a84a06]";
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement message={announcementMessage} />

  <ContentBox as="h1" title={pageHeading}>
    <p class={bodyClass}>
      <strong class={brandClass}>TG787</strong> เป็นเว็บตรงที่เปิดคาสิโนออนไลน์ถ่ายทอดสดไว้คู่กับหมวดสล็อต คุณเข้าดูโต๊ะไพ่สดหรือเปลี่ยนไปหมุนวงล้อได้จากหน้าเว็บเดียวกัน ผ่านเบราว์เซอร์บนมือถือที่ใช้อยู่แล้ว
    </p>

    <p class={bodyClass}>
      ระบบฝากถอนของเราไม่มีขั้นต่ำและทำรายการแบบออโต้ เสร็จใน 3 นาทีตลอด 24 ชั่วโมง ส่วนเรื่องที่ติดขัดระหว่างใช้งาน มีแอดมินรับเรื่องผ่านช่องทางบนหน้าเว็บ
    </p>

    <p class={closerClass}>หน้าเว็บเดียว แต่เลือกจังหวะเล่นได้สองแบบ</p>
  </ContentBox>

  <ContentBox as="h2" title="คาสิโนสดจาก WM Casino และ Dream Gaming ที่เห็นการแจกไพ่จริง">
    <p class={bodyClass}>
      ห้องคาสิโนออนไลน์ของ <strong class={brandClass}>TG787</strong> เปิดโต๊ะสดจากค่าย WM Casino และ Dream Gaming (DG) สิ่งที่คุณเห็นบนจอคือดีลเลอร์แจกไพ่จริงผ่านภาพสด ตั้งแต่ไพ่ใบแรกจนจบตา
    </p>

    <p class={bodyClass}>
      บาคาร่าให้คุณอ่านเค้าไพ่ก่อนวางฝั่งผู้เล่น เจ้ามือ หรือเสมอ ไฮโลให้ทายสูงต่ำ แต้มรวม หรือตอง ส่วนแบล็คแจ็คให้คุณตัดสินใจเองว่าจะขอไพ่เพิ่มหรือหยุด
    </p>

    <p class={closerClass}>จังหวะหน้าโต๊ะดูได้ด้วยตาตัวเอง ก่อนวางเดิมพันทุกครั้ง</p>
  </ContentBox>

  <ContentBox as="h2" title="สล็อตระบบร่วงหล่นและตัวคูณจาก PG Soft, Pragmatic Play และ JILI">
    <p class={bodyClass}>
      หมวดสล็อตของ <strong class={brandClass}>TG787</strong> รวมเกมที่จ่ายรางวัลด้วยกลไกต่างกัน Wild Bandito ของ PG Soft มาในธีมโจรเม็กซิกัน ใช้ระบบร่วงหล่น และตัวคูณเพิ่มทุกครั้งที่ชนะต่อเนื่องในสปินเดียว
    </p>

    <p class={bodyClass}>
      The Dog House ของ Pragmatic Play เด่นที่สัญลักษณ์ไวลด์ตัวคูณ และในรอบฟรีสปินไวลด์จะค้างอยู่จนจบรอบ ส่วน Golden Empire ของ JILI ผสานระบบร่วงหล่นกับตัวคูณไว้ในธีมอาณาจักรทอง
    </p>

    <p class={closerClass}>ธีมต่างกันได้มาก แต่สิ่งที่แยกเกมออกจากกันจริงคือกลไก</p>
  </ContentBox>

  <ContentBox as="h2" title="เว็บตรง TG787 เล่นผ่านเบราว์เซอร์ ล็อกอินยูสเดิมได้ทุกเครื่อง">
    <p class={bodyClass}>
      ที่ <strong class={brandClass}>TG787</strong> การ<a href="/register/" class={linkClass}>สมัคร</a> ฝาก เล่น และถอนทำจนจบได้บนมือถือเครื่องเดียวผ่านเบราว์เซอร์ โดยไม่ต้องโหลดแอป จึงไม่ต้องเผื่อพื้นที่ในเครื่องหรือรอติดตั้งอะไรเพิ่ม
    </p>

    <p class={bodyClass}>
      เมื่อมียูสเซอร์แล้ว คุณนำรหัสเดิมไปล็อกอินผ่าน<a href="/ทางเข้า/" class={linkClass}>ทางเข้า TG787</a>ได้ทุกเครื่องทั้ง iOS และ Android โดยไม่ต้องสมัครซ้ำ และก่อนกรอกรหัสทุกครั้ง ตรวจชื่อเว็บบนแถบที่อยู่ให้ตรงก่อน
    </p>

    <p class={closerClass}>เปลี่ยนเครื่องได้ทุกเมื่อ ยูสเซอร์ยังเป็นชุดเดิม</p>
  </ContentBox>

  <ContentBox as="h2" title="ฝากถอนไม่มีขั้นต่ำ ระบบออโต้ทำรายการเสร็จใน 3 นาที">
    <p class={bodyClass}>
      การเงินของ <strong class={brandClass}>TG787</strong> ใช้ระบบฝากถอนไม่มีขั้นต่ำ คุณแบ่งงบเป็นก้อนเล็กตามรอบที่เล่นได้ และระบบออโต้ทำรายการเสร็จใน 3 นาที เปิดรับตลอด 24 ชั่วโมง
    </p>

    <p class={bodyClass}>
      เมื่อโอนแล้ว ระบบปรับเครดิตให้เองโดยไม่ต้องแนบสลิปแจ้งแอดมิน ขั้นตอนของแต่ละขาและสิ่งที่ต้องทำเมื่อเครดิตไม่ขึ้นอยู่ที่หน้า<a href="/วิธีฝากถอน/" class={linkClass}>วิธีฝากถอน</a>
    </p>

    <p class={closerClass}>ยอดเข้าออกแต่ละครั้ง คุณเป็นคนกำหนดเอง</p>
  </ContentBox>

  <ContentBox as="h2" title="ติดต่อแอดมิน TG787 เมื่อติดขัด และเรื่องที่ต้องเก็บไว้กับตัว">
    <p class={bodyClass}>
      ถ้าล็อกอินไม่ได้ เครดิตไม่ขึ้น หรือมีรายการค้าง ติดต่อแอดมินผ่านช่องทางบนหน้าเว็บหรือหน้า<a href="/contact-us/" class={linkClass}>ติดต่อเรา</a>ได้ทันที ทีมงานของเราดูแลเรื่องที่ติดขัดระหว่างใช้งาน
    </p>

    <p class={bodyClass}>
      ถ้าฝากแล้วเครดิตไม่ขึ้น อย่าโอนซ้ำ ให้แจ้งเวลากับยอดที่ทำรายการเพื่อให้เจ้าหน้าที่ตรวจสอบ ส่วนรหัสผ่านกับ OTP เป็นของคุณคนเดียว ห้ามบอกผู้อื่นแม้จะอ้างว่าเป็นทีมงาน
    </p>

    <p class={closerClass}>เวลากับยอดคือข้อมูลสองอย่างที่ใช้ตามรายการให้เจอ</p>
  </ContentBox>

  <Navfoot />
</MainLayout>
