---
import { Picture } from "astro:assets";
import img1 from "../assets/providers/game1.avif";
import img2 from "../assets/providers/game2.avif";
import img3 from "../assets/providers/game3.avif";
import img4 from "../assets/providers/game4.avif";
import img5 from "../assets/providers/game5.avif";
import img6 from "../assets/providers/game6.avif";

const games = [
  {
    rank: 1,
    name: "สล็อตลิขสิทธิ์แท้",
    type: "หมวดที่สมาชิกเปิดบ่อยที่สุด ทุกเกมมาจากค่ายผู้พัฒนาโดยตรง ทำงานตามต้นฉบับ ไม่มีการปรับแต่งเปอร์เซ็นต์แพ้ชนะ",
    menus: ["ค่ายโดยตรง", "RTP ต้นฉบับ"],
    players: 5124,
    img: img4,
  },
  {
    rank: 2,
    name: "บาคาร่า",
    type: "เกมไพ่จังหวะสั้น รอบเร็ว เหมาะกับคนที่อยากสลับจากสล็อตมาเปลี่ยนบรรยากาศโดยใช้ยูสเดิม",
    menus: ["โต๊ะสด", "รอบสั้น"],
    players: 3842,
    img: img5,
  },
  { rank: 3, name: "คาสิโนสด", type: "ถ่ายทอดจากสตูดิโอจริง มีดีลเลอร์เปิดไพ่ให้เห็นทุกตา เลือกโต๊ะได้จากหน้าเดียวไม่ต้องเปลี่ยนยูส", menus: ["สตูดิโอจริง", "ดีลเลอร์สด"], players: 3517, img: img6 },
  { rank: 4, name: "ยิงปลา", type: "เกมจังหวะไวที่เล่นพร้อมกันหลายคนในห้องเดียว ระบบเดินต่อเนื่อง ไม่สะดุดกลางเกม", menus: ["ห้องรวม", "จังหวะไว"], players: 2905, img: img2 },
  {
    rank: 5,
    name: "รูเล็ต",
    type: "วงล้อคลาสสิกที่อ่านสถิติย้อนหลังได้จากหน้าโต๊ะ เหมาะกับคนที่ชอบวางแผนก่อนลงเดิมพัน",
    menus: ["คลาสสิก", "ดูสถิติ"],
    players: 2431,
    img: img1,
  },
  {
    rank: 6,
    name: "ไฮโล",
    type: "เกมลูกเต๋าที่คนไทยคุ้นมือ กติกาไม่ซับซ้อน รอบจบไว เข้าเล่นได้จากเมนูเดียวกับสล็อต",
    menus: ["กติกาง่าย", "รอบจบไว"],
    players: 2108,
    img: img3,
  },
];

const medal = (rank: number) => (rank === 1 ? "🥇" : rank === 2 ? "🥈" : rank === 3 ? "🥉" : null);
---

<section aria-label="หมวดเกมที่สมาชิก TOPGAMEVIP เปิดเล่นบ่อย" class="mx-auto w-full max-w-[1300px] px-4 py-8 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <span aria-hidden="true" class="text-2xl">🏆</span>
    <p class="bg-gradient-to-r from-[#8a0208] via-[#e60012] to-[#8a6410] bg-clip-text text-2xl font-black tracking-widest text-transparent uppercase">
      หมวดเกมที่สมาชิก TOPGAMEVIP เปิดเล่นบ่อยที่สุด
    </p>
    <p class="max-w-3xl text-base leading-relaxed text-[#2d1214]">
      ทุกหมวดในตารางนี้อยู่หลังยูสเดียวกัน สลับจากสล็อตไปโต๊ะสดหรือเกมอื่นได้โดยไม่ต้องสมัครใหม่ ลำดับความนิยมขยับตามคนที่เข้ามาใช้งานในแต่ละช่วง ไม่ได้แปลว่าหมวดไหนจ่ายดีกว่าหมวดไหน
      รายการที่เปิดให้บริการจริงให้ยึดตามหน้าเมมเบอร์ก่อนทำรายการทุกครั้ง
    </p>
    <div class="mt-2 h-[3px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#e60012] to-transparent"></div>
  </div>

  <div class="flex flex-col gap-3">
    {
      games.map((g) => {
        const top = g.rank === 1;
        return (
          <article
            class={`group relative flex items-center gap-3 overflow-hidden rounded-2xl border p-3 transition-all duration-300 hover:-translate-y-0.5 sm:gap-5 sm:p-4 ${
              top
                ? "border-[#e60012]/45 bg-gradient-to-r from-[#ffe9e7] via-white to-[#ffe9e7] shadow-[0_15px_40px_rgba(230,0,18,0.18)]"
                : "border-[#f6c9c6] bg-white shadow-[0_10px_30px_rgba(230,0,18,0.10)] hover:border-[#e60012]/35 hover:shadow-[0_15px_40px_rgba(230,0,18,0.16)]"
            }`}>
            <div
              aria-hidden="true"
              class="pointer-events-none absolute top-1/2 -left-10 h-24 w-24 -translate-y-1/2 rounded-full bg-[#e60012]/10 blur-[40px] transition-all duration-500 group-hover:bg-[#d4a017]/16"
            />

            <div class="relative z-10 flex w-8 shrink-0 flex-col items-center justify-center sm:w-12">
              {medal(g.rank) ? (
                <span class="text-2xl sm:text-3xl">
                  <span aria-hidden="true">{medal(g.rank)}</span>
                  <span class="sr-only">อันดับ {g.rank}</span>
                </span>
              ) : (
                <span class="text-xl font-black text-[#e60012] sm:text-2xl">#{g.rank}</span>
              )}
            </div>

            <div class={`relative z-10 h-14 w-14 shrink-0 overflow-hidden rounded-xl border sm:h-16 sm:w-16 ${top ? "border-[#e60012]/45" : "border-[#f6c9c6]"}`}>
              <Picture
                src={g.img}
                alt={`ภาพหน้าปกเกมประกอบรายการหมวด ${g.name} บนกระดานหมวดเกมยอดนิยมของ TOPGAMEVIP`}
                formats={["avif", "webp"]}
                fallbackFormat="webp"
                loading="lazy"
                fetchpriority="low"
                widths={[100, 200]}
                quality={60}
                sizes="(max-width: 640px) 56px, 64px"
                decoding="async"
                class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-110"
              />
            </div>

            <div class="relative z-10 min-w-0 flex-1">
              <div class="flex items-center gap-2">
                <p class="truncate text-base font-black text-[#8a0208] sm:text-lg">{g.name}</p>
                {top && (
                  <span class="hidden shrink-0 rounded-full border border-[#f6c9c6] bg-[#ffe9e7] px-2 py-0.5 text-[9px] font-black tracking-wider text-[#8a0208] sm:inline">ยอดนิยมสูงสุด</span>
                )}
              </div>
              <p class="truncate text-[11px] text-[#6f4b4d] sm:text-xs">{g.type}</p>

              <div class="mt-2 flex flex-wrap items-center gap-1.5">
                {g.menus.map((m) => (
                  <span class="rounded-full border border-[#f6c9c6] bg-[#fff7f6] px-2.5 py-0.5 text-[10px] font-bold text-[#8a0208]">{m}</span>
                ))}
              </div>
            </div>

            <div class="relative z-10 hidden shrink-0 flex-col items-end gap-1 sm:flex">
              <span class="flex items-center gap-1.5 text-[11px] text-[#6f4b4d]">
                <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-green-600 shadow-[0_0_6px_rgba(22,163,74,0.6)]" />
                <span class="tabular-nums" data-players data-base={g.players}>
                  {g.players.toLocaleString("en-US")}
                </span>{" "}
                ออนไลน์
              </span>
              <a
                href="/register"
                class={`rounded-full px-4 py-1.5 text-xs font-black transition-transform hover:scale-105 ${
                  top
                    ? "bg-gradient-to-r from-[#ff4b41] via-[#e60012] to-[#b30009] text-white shadow-[0_10px_30px_rgba(230,0,18,0.28)]"
                    : "border border-[#f6c9c6] bg-[#ffe9e7] text-[#8a0208] hover:border-[#e60012]/45 hover:bg-[#fff7f6]"
                }`}>
                สมัครเข้าเล่น
              </a>
            </div>
          </article>
        );
      })
    }
  </div>
</section>

<script>
  import { startLiveCounters } from "../lib/liveCounter";

  startLiveCounters();
</script>
