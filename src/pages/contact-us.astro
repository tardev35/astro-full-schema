---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";

import { Picture } from "astro:assets";
import imgLine from "../assets/contact-line.webp";
import { pageGraph } from "../lib/schema";
import { BRAND_ADDRESS } from "../lib/brandProfile";

const pageTitle = "ติดต่อทีมงาน RIEL38 | แจ้งปัญหาผ่าน LINE Official ตลอด 24 ชม.";

const pageDescription =
  "ติดต่อทีมงาน RIEL38 แจ้งปัญหาฝากถอน สอบถามเรื่องยูส Smart Wallet หรือโปรสมาชิกใหม่ ผ่าน LINE Official ตลอด 24 ชม. พร้อมที่อยู่ติดต่อ อีเมล และปุ่มสมัครสมาชิก";

const graph = pageGraph(Astro, {
  type: "ContactPage",
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ติดต่อเรา", path: "/contact-us" },
  ],
  org: {
    alternateName: "RIEL38 เว็บสล็อตมาใหม่ รวมกว่า 2,000 เกมจาก 30+ ค่ายดัง รองรับ Smart Wallet",
    contactPoints: [
      {
        contactType: "customer service",
        availableLanguage: ["Thai", "English"],
        path: "/line",
        description: "ติดต่อแอดมินผ่าน LINE Official",
      },
    ],
  },
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="ติดต่อทีมงาน RIEL38" as="h1">
    <Picture
      src={imgLine}
      alt="พนักงานหญิงผมยาวสีน้ำตาลลอนสวมชุดเลื่อมสีชมพูแขนยาวคอวี ยิ้มกอดอกอยู่หน้าวงกลมสีชมพู ด้านล่างเป็นแถบสีขาวที่มีโลโก้ LINE สีเขียวและคำว่า Support"
      loading="lazy"
      fetchpriority="low"
      widths={[200, 400, 600]}
      sizes="(max-width: 768px) 100vw, 400px"
      class="mx-auto h-auto w-full max-w-[400px] object-contain"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={60}
    />
    {
      BRAND_ADDRESS.lines.length > 0 && (
        <address aria-label={BRAND_ADDRESS.label} class="mt-8 mb-8 border-l-4 border-[#ec4899] pl-6 text-left text-base leading-relaxed text-[#5b2140] not-italic">
          <p class="mb-1 font-bold text-[#9d174d]">{BRAND_ADDRESS.label}</p>
          {BRAND_ADDRESS.lines.map((line) => (
            <span class="block">{line}</span>
          ))}
          {BRAND_ADDRESS.email && (
            <span class="mt-3 block">
              <span aria-hidden="true" class="mr-2">
                ✉️
              </span>
              <a href={`mailto:${BRAND_ADDRESS.email}`} class="font-bold text-[#db2777] underline decoration-[#f9a8d4] underline-offset-4 transition-colors hover:text-[#9d174d]">
                {BRAND_ADDRESS.email}
              </a>
            </span>
          )}
        </address>
      )
    }

    <div class="flex flex-wrap justify-center gap-4">
      <a
        href="/register"
        aria-label="สมัครสมาชิก RIEL38"
        class="flex items-center justify-center rounded-lg border border-[#db2777]/45 bg-gradient-to-r from-[#f472b6] via-[#ec4899] to-[#a855f7] px-8 py-3 font-bold text-white shadow-[0_10px_30px_rgba(236,72,153,0.28)] transition-transform hover:scale-105 hover:shadow-[0_15px_40px_rgba(236,72,153,0.35)]">
        สมัครสมาชิก
      </a>

      <a
        href="/login"
        aria-label="เข้าสู่ระบบ RIEL38"
        class="flex items-center justify-center rounded-lg border border-[#f9a8d4] bg-[#fce7f3] px-8 py-3 font-extrabold text-[#9d174d] shadow-[0_4px_14px_rgba(236,72,153,0.16)] transition-transform hover:scale-105 hover:bg-[#fbcfe8]">
        เข้าสู่ระบบ
      </a>

      <a
        href="/line"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="ติดต่อทีมงานผ่าน Line Official"
        class="flex items-center justify-center rounded-lg border border-green-300 bg-gradient-to-b from-green-400 to-green-700 px-8 py-3 font-bold text-white transition-transform hover:scale-105">
        ติดต่อผ่าน Line Official
      </a>
    </div>
  </ContentBox>
  <Navfoot />
</MainLayout>
