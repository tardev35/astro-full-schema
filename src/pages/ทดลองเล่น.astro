---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";

import { Picture } from "astro:assets";
import { itemList, pageGraph, schemaCtx } from "../lib/schema";
import pgCover from "../assets/gamedemo11.webp";
import jiliCover from "../assets/gamedemo14.webp";
import popularCover from "../assets/gamedemo8.webp";
import newCover from "../assets/gamedemo16.webp";

const demoGames = [
  {
    name: "PG Soft",
    games: "Wild Bandito",
    src: pgCover,
    alt: "แบนเนอร์ค่าย PG Pocket Games Soft โลโก้ตัวอักษรพิกเซลบนพื้นดำ คู่กับตัวละครหญิงสวมมงกุฎขนนกสีชมพูและเครื่องประดับทองสไตล์แอซเท็ก บนฉากแสงสีทอง",
  },
  {
    name: "JILI",
    games: "Fortune Gems",
    src: jiliCover,
    alt: "แบนเนอร์ค่ายเกม JILI ตัวอักษรทองบนพื้นดำ คู่กับนางเงือกผมแดงสวมเกราะเปลือกหอยสีทอง ยกหอยสังข์แนบหู ท่ามกลางปลาการ์ตูนใต้น้ำ",
  },
  {
    name: "เกมยอดนิยม",
    games: "เกมฮิตจาก PG Soft, Pragmatic Play และ JILI",
    src: popularCover,
    alt: "แบนเนอร์ Popular Game ตัวอักษรทองนูนหน้าวงแหวนชิปสีทอง ขนาบด้วยกระต่ายใส่หูฟังยืนข้างหีบสมบัติกับแมวใส่แว่นกันแดด ท่ามกลางกองเหรียญทองและชิปที่ลอยฟุ้ง",
  },
  {
    name: "เกมใหม่",
    games: "เกมใหม่จากค่ายในเว็บ",
    src: newCover,
    alt: "แบนเนอร์ New Game ตัวอักษรสีขาวนูนกลางภาพ ขนาบด้วยตัวการ์ตูนฟักทองหัวไฟสวมหมวกคาวบอยกับโครงกระดูกยิ้ม ยืนบนฟลอร์นีออนสีชมพูฟ้าที่เกลื่อนด้วยชิปและลูกเต๋า",
  },
];

const gameList = demoGames.map((game) => ({ name: game.name, imagePath: game.src.src }));

const pageTitle = "ทดลองเล่นสล็อต MEEHAY569 ลอง PG Soft Pragmatic Play JILI ก่อนเล่นจริง";

const pageHeading = "ทดลองเล่นสล็อต MEEHAY569 ลองก่อนได้ ไม่ต้องฝากเงินหรือสมัคร";

const pageDescription =
  "ทดลองเล่นสล็อต MEEHAY569 ลอง Wild Bandito, Gates of Olympus และ Fortune Gems ได้โดยไม่ต้องฝากเงินหรือสมัครก่อน ดูฟีเจอร์ให้พอใจ แล้วค่อยเล่นจริงจาก 1 บาท";

const announcementMessage =
  "MEEHAY569 สล็อตเว็บตรง ไม่ผ่านเอเย่นต์ • ฝากถอนทรูวอเลทออโต้ เริ่ม 1 บาท ตลอด 24 ชั่วโมง ไม่ต้องส่งสลิป • ทดลองเล่นสล็อตได้โดยไม่ต้องฝากเงินหรือสมัครก่อน • สมัครง่าย 4 ขั้นตอน เล่นได้ทั้งเว็บมือถือ แอป และคอม";

const linkClass = "font-bold text-[#006d99] underline underline-offset-4 transition-colors hover:text-[#a35000]";

const brandClass = "font-bold text-[#a35000]";

const ctx = schemaCtx(Astro);
const graph = pageGraph(Astro, {
  type: "CollectionPage",
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  ],
  extra: [
    itemList(ctx, {
      name: "ทดลองเล่นเกมสล็อตของ MEEHAY569",
      alternateName: "MEEHAY569 ทดลองเล่นสล็อต PG Soft, Pragmatic Play และ JILI ก่อนเล่นจริง",
      itemType: "Game",
      items: gameList,
    }),
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement message={announcementMessage} />

  <ContentBox as="h1" title={pageHeading}>
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed">
        หากคุณกำลังมองหาที่ลองสล็อตก่อนจ่ายจริง <strong class={brandClass}>MEEHAY569</strong> พร้อมเปิดโหมดทดลองเล่นให้ลองได้โดยไม่ต้องฝากเงินหรือสมัครก่อน เพื่อให้คุณได้เห็นฟีเจอร์และจังหวะของเกมก่อนตัดสินใจ
      </p>
      <p class="text-left text-base leading-relaxed">
        เลือกลองได้ทั้งเกมของ PG Soft, Pragmatic Play และ JILI หมุนดูได้ตามสบาย ไม่มีใครเร่ง ลองจนรู้ว่าเกมไหนเข้ามือ แล้วค่อยเริ่มเล่นจริงในวันที่คุณพร้อม
      </p>
      <p class="text-left text-base leading-relaxed">
        จะลองบนหน้าเว็บมือถือได้ทุกระบบ ดาวน์โหลดแอปไว้ในเครื่อง หรือเปิดบนคอมจอใหญ่ก็ได้เหมือนกัน สะดวกแบบไหนก็ลองแบบนั้น
      </p>
    </div>
  </ContentBox>

  <ContentBox as="h2" title="ลอง Wild Bandito, Gates of Olympus และ Fortune Gems ก่อนเล่นจริงกับ MEEHAY569">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed">
        Wild Bandito ของ PG Soft ใช้ระบบร่วงหล่น ตัวคูณจะขยับขึ้นทุกครั้งที่ชนะต่อเนื่องในสปินเดียว ลองหมุนดูสักพักแล้วคุณจะเห็นว่าจังหวะต่อคอมโบของเกมนี้สนุกแค่ไหน
      </p>
      <p class="text-left text-base leading-relaxed">
        สายที่ไม่อยากลุ้นเส้นไลน์ ลอง Gates of Olympus ของ Pragmatic Play ที่จ่ายแบบไม่ต้องเรียงไลน์ แถมมีลูกแก้วตัวคูณตกลงมาทบยอดชนะ ลองดูเองว่ารอบที่ลูกแก้วโผล่มาลุ้นแค่ไหน
      </p>
      <p class="text-left text-base leading-relaxed">
        ชอบกระดานเล็กดูง่าย Fortune Gems ของ JILI เป็นวงล้อ 3×3 ที่มีวงตัวคูณแยกอยู่ทางขวา หมุนไม่กี่รอบก็เห็นว่าวงขวาทำงานอย่างไร เหมาะกับคนที่อยากเริ่มจากเกมเรียบง่าย
      </p>
      <p class="text-left text-base leading-relaxed">
        ภาพของแต่ละค่ายด้านล่างพาไปหน้า<a href="/register/" class={linkClass}>สมัครสมาชิก</a> ไว้สำหรับวันที่คุณลองจนเจอเกมที่ใช่แล้ว สมัครได้ใน 4 ขั้นตอน ใช้เบอร์โทรที่รับ OTP ได้ ไม่ต้องมีบัญชีธนาคาร
      </p>
      <div class="mt-4 mb-5 grid grid-cols-2 gap-5 md:grid-cols-4">
        {
          demoGames.map((game) => (
            <div class="group/game relative mx-auto w-full max-w-[400px] overflow-hidden rounded-xl border border-[#cfe9f4] bg-white shadow-[0_10px_30px_rgba(12,53,80,0.08)] transition-colors duration-300 hover:border-[#8ed3ee]">
              <Picture
                src={game.src}
                alt={game.alt}
                loading="lazy"
                fetchpriority="low"
                widths={[200, 400, 600]}
                sizes="(min-width: 1400px) 305px, (min-width: 768px) 22vw, 45vw"
                class="block h-auto w-full object-cover transition-transform duration-300 group-hover/game:scale-105"
                decoding="async"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
                quality={60}
              />
              <div class="bg-[#e8f7fd] px-3 py-2 text-center">
                <p class="text-sm font-bold text-[#0c3550]">{game.name}</p>
                <p class="text-xs text-[#5a6b7a]">{game.games}</p>
              </div>
              <a
                href="/register/"
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`สมัครสมาชิก MEEHAY569 เพื่อเล่น ${game.name}`}
                class="absolute inset-0 flex items-center justify-center bg-[#0c3550]/80 opacity-0 transition-opacity duration-300 group-hover/game:opacity-100 focus-visible:opacity-100">
                <span class="rounded-xl border-2 border-white bg-gradient-to-b from-[#ffd23f] via-[#ffb84d] to-[#f7941d] px-6 py-2 font-black text-[#4a1d00] shadow-[0_10px_30px_rgba(247,148,29,0.40)] transition-transform hover:scale-110 hover:brightness-105">สมัครสมาชิก</span>
              </a>
            </div>
          ))
        }
      </div>
    </div>
  </ContentBox>

  <ContentBox as="h2" title="ทดลองเล่นสล็อตฟรี หมุนลองให้พอใจก่อนใช้เงินจริง">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed">
        ลองให้พอใจก่อนใช้เงินจริง ดูว่าเบทต่ำสุดต่อรอบเท่าไร ฟีเจอร์ตัวคูณทำงานตอนไหน แล้วเก็บเกมที่เข้ากับทุนของคุณไว้สองสามเกม ตั้งแต่ยังไม่ต้องจ่ายสักบาท
      </p>
      <p class="text-left text-base leading-relaxed">
        วันไหนอยากพักจากวงล้อ <strong class={brandClass}>MEEHAY569</strong> ก็มีบาคาร่า ไฮโล รูเล็ต และเสือมังกรอยู่ในเว็บเดียวกัน สลับไปลุ้นทีละตาได้โดยไม่ต้องไปหาที่อื่น
      </p>
      <p class="text-left text-base leading-relaxed">
        เรื่องที่ขอบอกให้ชัดตั้งแต่ต้น เครดิตในโหมดทดลองถอนออกมาไม่ได้ และไม่นับเป็นยอดเทิร์นของโปรโมชั่นใด มีไว้ให้รู้จักเกมก่อนเล่นจริงเท่านั้น
      </p>
      <p class="text-left text-base leading-relaxed">
        อีกข้อคือไม่ใช่ทุกเกมที่มีโหมดทดลอง ขึ้นอยู่กับค่ายผู้พัฒนาแต่ละราย ถ้าเกมที่หมายตาไว้ยังลองไม่ได้ <a href="/contact-us/" class={linkClass}>ทักทีมงาน</a>ให้ช่วยแนะนำเกมแนวใกล้เคียงได้เลย
      </p>
    </div>
  </ContentBox>

  <ContentBox as="h2" title="พร้อมเมื่อไหร่ สมัครสมาชิก MEEHAY569 แล้วเริ่มเล่นจริงจาก 1 บาท">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed">
        หากคุณกำลังมองหาเว็บที่เริ่มได้โดยไม่ต้องมีบัญชีธนาคาร <strong class={brandClass}>MEEHAY569</strong> พร้อมให้ฝากถอนผ่านทรูวอเลทด้วยระบบออโต้ เริ่มที่ 1 บาท ตลอด 24 ชั่วโมง เพื่อเล่นจริงกับเกมที่ลองจนคุ้นมือได้จากงบเล็ก
      </p>
      <p class="text-left text-base leading-relaxed">
        ระบบปรับเครดิตให้เอง ไม่ต้องส่งสลิป ขั้นตอนเต็มอยู่ที่หน้า<a href="/วิธีฝากถอน/" class={linkClass}>วิธีฝากถอน</a> ถ้าโอนแล้วเครดิตยังไม่ขึ้น อย่าเพิ่งโอนซ้ำ แจ้งเวลากับยอดผ่านช่องทางบนหน้าเว็บ และรหัสผ่านกับ OTP ห้ามบอกใครทั้งสิ้น
      </p>
      <p class="text-left text-base leading-relaxed">
        ก่อนเริ่มทุกครั้งลองตั้งงบที่เสียได้ไว้ก่อน สล็อตคือความบันเทิง ลองให้สนุกก่อน แล้วค่อยเล่นจริงในจังหวะที่คุณพร้อม
      </p>
      <div class="flex flex-col items-center justify-center gap-4 pt-2 sm:flex-row">
        <a
          href="/register/"
          class="inline-flex w-full max-w-[320px] items-center justify-center gap-2 rounded-xl border-2 border-white bg-gradient-to-b from-[#ffd23f] via-[#ffb84d] to-[#f7941d] px-8 py-3.5 text-lg font-black tracking-wide text-[#4a1d00] shadow-[0_10px_30px_rgba(247,148,29,0.40)] transition duration-300 hover:scale-105 hover:brightness-105">
          <span aria-hidden="true">🎰</span> สมัครสมาชิก MEEHAY569
        </a>

        <a
          href="/login/"
          class="inline-flex w-full max-w-[320px] items-center justify-center gap-2 rounded-xl border-2 border-white bg-gradient-to-b from-[#19b2e0] to-[#0077b3] px-8 py-3.5 text-lg font-bold tracking-wide text-white shadow-[0_10px_30px_rgba(0,164,212,0.35)] transition duration-300 hover:scale-105 hover:brightness-110">
          เข้าสู่ระบบ
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
