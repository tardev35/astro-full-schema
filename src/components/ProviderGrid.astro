---
const providers = [
  { name: "บาคาร่าห้องสด", desc: "โต๊ะสดหลายค่าย ต่างกันที่ภาษา วงเงิน และความเร็วรอบ", tag: "เกมโต๊ะยอดนิยม", icon: "🎴" },
  { name: "รูเล็ตและเกมโต๊ะ", desc: "จังหวะรอบไม่เท่ากันในแต่ละโต๊ะ เลือกจากวงเงินที่รับได้ก่อน", tag: "ดูจังหวะรอบ", icon: "🎡" },
  { name: "สล็อตหลายค่าย", desc: "ดูเดิมพันเริ่มต้น ความผันผวน และฟีเจอร์โบนัสก่อนลงเครดิต", tag: "เริ่มจากงบจริง", icon: "🎰" },
  { name: "กีฬาและบอลสด", desc: "ตรวจคู่แข่งขัน ตลาด และราคาปัจจุบันให้ครบก่อนส่งบิล", tag: "เช็กราคาก่อนส่ง", icon: "⚽" },
  { name: "เกมยิงปลาและอาร์เคด", desc: "รอบสั้น จบไว เหมาะกับการลองระบบก่อนขยับวงเงิน", tag: "รอบสั้น", icon: "🐟" },
  { name: "ระบบกระเป๋าเดียว", desc: "เครดิตใช้ร่วมกันได้ทุกหมวด ไม่ต้องโยกยอดหรือสมัครแยกค่าย", tag: "บัญชีเดียวจบ", icon: "👛" },
  { name: "คืนยอดเดิมพัน 1%", desc: "ตรวจฐานคำนวณ รอบคำนวณ จำนวนเทิร์น และเพดานถอนก่อนกดรับ", tag: "อ่านเงื่อนไข", icon: "🔁" },
];
---

<section aria-label="คาสิโนกว่า 13 ค่ายและหมวดเกมที่รวมไว้ในบัญชีเดียว" class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#f5cf4d] via-[#d4a017] to-[#9a7112] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      คาสิโนกว่า 13 ค่ายและหมวดเกมที่ <span class="text-[#a3e635]">WINSIAM88</span> รวมไว้ในบัญชีเดียว
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#d4a017] to-transparent"></div>
  </div>

  <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4 lg:gap-5 xl:grid-cols-7">
    {
      providers.map((provider) => (
        <a
          href="/register"
          class="group relative flex flex-col items-center justify-center overflow-hidden rounded-2xl border border-[#d4a017]/25 bg-[#0b1408]/92 p-5 shadow-[0_10px_30px_rgba(212,160,23,0.18)] backdrop-blur-md transition-all duration-300 hover:-translate-y-2 hover:border-[#d4a017]/50 hover:bg-[#122010]/95 hover:shadow-[0_15px_40px_rgba(212,160,23,0.3)]">
          <div class="pointer-events-none absolute inset-0 bg-[#a3e635]/10 opacity-0 transition-opacity duration-300 group-hover:opacity-100" />

          <div class="absolute top-2 right-2 z-10 rounded-full bg-gradient-to-r from-[#f5cf4d] via-[#d4a017] to-[#9a7112] px-2 py-0.5 text-[9px] font-black tracking-wide whitespace-nowrap text-[#0f1a06] shadow-sm transition-transform duration-300 group-hover:scale-110">
            {provider.tag}
          </div>

          <div aria-hidden="true" class="mb-3 text-4xl transition-transform duration-300 group-hover:scale-125 group-hover:rotate-3">
            {provider.icon}
          </div>
          <p class="text-center text-sm font-black text-[#dfeacf] transition-colors group-hover:text-[#f5cf4d]">{provider.name}</p>
          <p class="mt-1 text-center text-[10px] text-[#a3e635]">{provider.desc}</p>

          <span class="relative z-10 mt-4 block w-full rounded-full border border-[#d4a017]/25 bg-[#071005] py-1.5 text-center text-[11px] font-bold text-[#d4a017] shadow-inner transition-colors duration-300 group-hover:border-[#d4a017]/50 group-hover:bg-gradient-to-r group-hover:from-[#f5cf4d] group-hover:via-[#d4a017] group-hover:to-[#9a7112] group-hover:text-[#0f1a06]">
            เข้าดูเกม
          </span>
        </a>
      ))
    }
  </div>
</section>
