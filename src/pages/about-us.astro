---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement2.astro";
import { pageGraph } from "../lib/schema";

const pageTitle = "เกี่ยวกับเรา WINNOW168 เว็บตรงรวมบาคาร่า สล็อต คาสิโน และกีฬาในบัญชีเดียว";

const pageDescription =
  "เกี่ยวกับเรา WINNOW168 เว็บตรงที่รวมบาคาร่า สล็อต คาสิโนสด และกีฬาไว้ในบัญชีเดียว พร้อมระบบฝากถอนออโต้ตลอด 24 ชั่วโมง และทางเข้าที่ใช้งานได้ทุกอุปกรณ์";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox as="h1" title={pageTitle}>
    <p class="mb-4 text-left text-base leading-relaxed text-[#f2dede]">
      WINNOW168 เป็นเว็บตรงที่รวมบาคาร่าออนไลน์ สล็อต คาสิโนสด กีฬา และเกมยอดนิยมไว้ในบัญชีเดียว อยากเปลี่ยนจากบาคาร่าไปสล็อต หรือพักจากสล็อตไปดูกีฬา
      ก็สลับหมวดได้จากหน้าเดิม เข้าเว็บเดียวแล้วเลือกเล่นตามอารมณ์ ไม่ต้องกดออกเข้าใหม่ให้เสียเวลา จุดที่เราให้ความสำคัญคือหน้าเว็บที่รองรับมือถือ
      ระบบฝากถอนอัตโนมัติ และบริการตลอด 24 ชั่วโมง พร้อมตัวเลือกเกมหลายแนวในที่เดียว
    </p>

    <p class="text-left text-base leading-relaxed text-[#f2dede]">
      หน้านี้ทำหน้าที่เป็นหน้าข้อมูลและแนะนำตัว อธิบายว่าเว็บนี้ให้บริการอะไร จัดหน้าเว็บอย่างไร และเหมาะกับผู้ใช้แบบไหน เพื่อให้อ่านแล้วนำไปเทียบกับสิ่งที่เห็นในหน้าสมาชิกจริงได้
      รายละเอียดของโปรโมชั่นและเงื่อนไขแต่ละรายการจะอยู่ในหน้ารายการของโปรนั้นโดยตรง จึงควรเปิดดูก่อนใช้สิทธิ์ทุกครั้ง
    </p>
  </ContentBox>

  <ContentBox as="h2" title="WINNOW168 รวมบาคาร่า สล็อต คาสิโน และกีฬาไว้ในบัญชีเดียวอย่างไร">
    <p class="mb-4 text-left text-base leading-relaxed text-[#f2dede]">
      สมาชิกเข้าถึงบาคาร่า สล็อต คาสิโนสด กีฬา และเกมประเภทอื่นผ่านบัญชีเดียว เครดิต โปรโมชั่น และประวัติรายการจึงรวมอยู่ในหน้าสมาชิกเดียวกัน
      อยากเล่นหมวดไหนก็เลือกต่อได้เลย ไม่ต้องตั้งค่าบัญชีใหม่ทุกครั้ง และไม่ต้องจำรหัสผ่านหลายชุดจนงงเอง
    </p>

    <p class="text-left text-base leading-relaxed text-[#f2dede]">
      เมนูของเราแยกเกมตามประเภท ทำให้มองหาเกมได้ง่ายขึ้น คนที่ชอบสลับหลายแนวจึงใช้งานสะดวกกว่าเว็บที่เมนูแน่นจนต้องเลื่อนหากันเหมือนหาร้านในห้างวันหยุด
      แต่ละส่วนยังเชื่อมต่อกันเป็นระบบ ตั้งแต่เลือกเกม ตรวจเครดิต ไปจนถึงดูประวัติรายการ ทุกอย่างอยู่ในทางเดินเดียวกัน หน้าเว็บจึงไม่พาเดินอ้อม
    </p>
  </ContentBox>

  <ContentBox as="h2" title="ระบบฝากถอนออโต้ที่ทำรายการได้ตลอด 24 ชั่วโมง">
    <p class="mb-4 text-left text-base leading-relaxed text-[#f2dede]">
      WINNOW168 ชูระบบฝากถอนอัตโนมัติที่รองรับการทำรายการตลอด 24 ชั่วโมง สมาชิกเติมเครดิต ถอนเงิน และดูสถานะรายการผ่านหน้าบัญชีได้โดยตรง
      ช่วยให้จัดการยอดได้ตามเวลาที่สะดวก บางคนเข้าช่วงกลางวัน บางคนเพิ่งว่างหลังเที่ยงคืน ขั้นตอนจึงออกแบบให้ทำได้ตลอดวัน ไม่ต้องรอเวลาเปิดทำการเหมือนยืนรอร้านเปิดหน้าห้าง
    </p>

    <p class="text-left text-base leading-relaxed text-[#f2dede]">
      เว็บใช้คำว่าไม่มีขั้นต่ำเป็นจุดขายสำหรับการเริ่มต้นด้วยยอดที่เข้าถึงง่าย แต่สมาชิกควรดูในหน้ารายการว่าเงื่อนไขครอบคลุมยอดฝาก ยอดถอน หรือการเดิมพันหมวดใด
      เพราะแต่ละบริการอาจกำหนดไม่เหมือนกัน ข้อดีของยอดเริ่มต้นต่ำคือช่วยให้ทดลองหน้าเว็บและเลือกเกมที่ชอบได้โดยไม่ต้องใส่เงินก้อนใหญ่ตั้งแต่ครั้งแรก
    </p>
  </ContentBox>

  <ContentBox as="h2" title="ทางเข้า WINNOW168 และการล็อกอินผ่านทุกอุปกรณ์">
    <p class="mb-4 text-left text-base leading-relaxed text-[#f2dede]">
      ทางเข้าของเรารองรับโทรศัพท์ แท็บเล็ต และคอมพิวเตอร์ สมาชิกใช้บัญชีเดิมเพื่อเข้าสู่ระบบ ดูโปรโมชั่น เลือกเกม และตรวจประวัติรายการได้จากอุปกรณ์ที่อยู่ใกล้มือ
      การใช้บัญชีเดียวทำให้เปลี่ยนอุปกรณ์ได้ง่ายขึ้น วันนี้เปิดผ่านมือถือ พรุ่งนี้ใช้คอมก็เข้าเมนูเดิมได้ ไม่ต้องสร้างบัญชีใหม่ทุกเครื่อง
    </p>

    <p class="text-left text-base leading-relaxed text-[#f2dede]">
      บาคาร่าและสล็อตเปิดเล่นผ่านเบราว์เซอร์มือถือได้โดยไม่ต้องเปิดคอมพิวเตอร์หรือโหลดโปรแกรมเพิ่ม หน้าเว็บออกแบบให้รองรับจอเล็ก ปุ่มจึงไม่ล้นและเมนูไม่เล่นซ่อนหา
      ทั้งนี้ความเร็วยังขึ้นอยู่กับมือถือ เบราว์เซอร์ และสัญญาณอินเทอร์เน็ตของแต่ละคนด้วย จึงอาจไม่เท่ากันทุกเครื่อง
    </p>
  </ContentBox>

  <ContentBox as="h2" title="WINNOW168 เหมาะกับผู้ใช้ที่ชอบเกมเดิมพันรูปแบบใด">
    <p class="mb-4 text-left text-base leading-relaxed text-[#f2dede]">
      WINNOW168 เหมาะกับคนที่ชอบบาคาร่า สล็อต คาสิโน และกีฬา แต่ต้องการรวมทุกหมวดไว้ในบัญชีเดียว รวมถึงคนที่เล่นผ่านมือถือเป็นหลักและต้องการระบบฝากถอนอัตโนมัติที่ใช้งานได้ตลอดวัน
      ภาพรวมของเราเน้นความครบและการเข้าถึงง่าย เหมาะกับทั้งสายโต๊ะสด สายสล็อต และคนที่ชอบเปลี่ยนหมวดตามอารมณ์
    </p>

    <p class="text-left text-base leading-relaxed text-[#f2dede]">
      สำหรับสมาชิกใหม่มีโปรโมชั่นฝาก 100 รับเครดิตรวม 150 ตามช่วงกิจกรรม ซึ่งช่วยให้มีงบเลือกเกมและลองใช้งานระบบได้มากกว่ายอดฝากเริ่มต้น
      ก่อนใช้สิทธิ์ควรอ่านรายละเอียดในหน้าเดียวกันให้ครบ ทั้งเกมที่ร่วมรายการ จำนวนรอบเดิมพัน และยอดถอนสูงสุด เพราะโบนัสกับเงื่อนไขควรอยู่ด้วยกันเสมอ
    </p>
  </ContentBox>

  <Navfoot />
</MainLayout>
