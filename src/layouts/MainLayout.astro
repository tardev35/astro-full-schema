---
import { Image } from "astro:assets";
import Bg from "../assets/bg.png";
import "../styles/global.css";
import NavbarStyle6 from "../components/NavbarStyle6.astro";
import Footer from "../components/FooterStyle3.astro";

const bannerImages = import.meta.glob<{ default: ImageMetadata }>("../assets/banner*.{png,webp,jpg,jpeg}", { eager: true });
const bannerPaths = Object.keys(bannerImages);
const preferredBannerPath = bannerPaths.find((path) => /banner1\.(png|webp|jpg|jpeg)$/.test(path));
const webpBannerPath = bannerPaths.find((path) => path.endsWith(".webp"));
const mainBannerPath = preferredBannerPath ?? webpBannerPath ?? bannerPaths[0];
const mainBanner = mainBannerPath ? bannerImages[mainBannerPath].default : null;

const {
  title = "คู่มือ MAFIA168 กติกาเกม วิธีเล่น โปรโมชั่น การสมัคร",
  description = "คู่มือการใช้งานเว็บ MAFIA168 กติกาการเล่นเกม โปรโมชั่น วิธีฝากถอน ขั้นตอนการสมัคร คำแนะนำอื่นๆ ติดต่อไลน์",
  robots = "index, follow",
  ImageOg = "/slide3.webp",
} = Astro.props;

const currentPath = Astro.url.pathname;
const canonicalURL = new URL(currentPath, Astro.site);
const ogImageURL = new URL(ImageOg, Astro.site);
const ogSiteName = "MAFIA168";
---

<html lang="th">
  <head>
    <meta charset="utf-8" />
    <meta name="google-site-verification" content="THWudFWFF0XOm6rXgwUIGavBdxyu7lmo9oQ1XaoA15M" />
    <meta name="robots" content={robots} />
    <meta name="googlebot" content={robots} />
    <title>{title}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="preload" href="/fonts/kanit-v17-latin_thai-regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/kanit-v17-latin_thai-700.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/kanit-v17-latin_thai-600.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="mafia168" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:site_name" content={ogSiteName} />
    <meta property="og:locale" content="th_TH" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <style is:global>
      html,
      body {
        overflow-x: hidden;
        max-width: 100%;
      }
      body {
        background-size: cover;
        background-position: center;
        background-attachment: fixed;
        background-repeat: no-repeat;
        margin: 0;
        background-color: #ffffff;
        font-weight: 400;
        font-family: "Kanit", sans-serif !important;
      }
    </style>
  </head>

  <body class="relative flex min-h-screen w-full flex-col">
    <Image
      src={Bg}
      alt="Website Background"
      loading="eager"
      widths={[412, 768, 1024, 1900]}
      sizes="100vw"
      format="avif"
      class="fixed inset-0 -z-50 h-full w-full object-cover"
      quality="low"
      decoding="sync"
    />

    <NavbarStyle6 />

    <div class="mb-2.5 flex w-full items-center justify-center">
      <Image
        src={mainBanner!}
        alt="MAFIA168 banner"
        loading="eager"
        fetchpriority="high"
        widths={[412, 768, 1900]}
        sizes="(max-width: 768px) 412px, 100vw"
        class="mx-auto h-auto w-full max-w-full object-contain shadow-xl"
        decoding="sync"
        format="avif"
        quality={60}
      />
    </div>

    <main class="w-full flex-1">
      <article>
        <slot />
      </article>
    </main>

    <Footer />
  </body>
</html>
