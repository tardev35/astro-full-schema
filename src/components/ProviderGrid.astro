---
const providers = [
  { name: "บาคาร่า", desc: "หมวดหลักของเว็บ เลือกโต๊ะตามจังหวะที่ถนัด ย้ายห้องได้เมื่อบรรยากาศไม่ใช่", tag: "เกมหลัก", icon: "🎴" },
  { name: "คาสิโนสด", desc: "ห้องเล่นแบบเรียลไทม์ เปิดดูบรรยากาศห้องก่อนเลือกลงเดิมพันได้จากหน้าเดียว", tag: "เล่นสด", icon: "🃏" },
  { name: "สล็อตลิขสิทธิ์", desc: "รวมสล็อตลิขสิทธิ์จากผู้ให้บริการหลายค่าย เลือกค่ายหรือหมวดก่อนแล้วค่อยเปิดเกม", tag: "หลายค่าย", icon: "🎰" },
  { name: "เกมโบนัสและฟรีสปิน", desc: "สล็อตที่มีรอบโบนัสในตัว สำหรับสายที่ชอบรอฟีเจอร์มากกว่าหมุนรัวยาว", tag: "หมวดเกม", icon: "🍀" },
  { name: "ระบบ API แท้", desc: "เชื่อมเกมจากหลายค่ายเข้ากับบัญชีสมาชิกเดียว เปลี่ยนค่ายกลางทางได้โดยไม่ต้องสมัครใหม่", tag: "ระบบเชื่อมเกม", icon: "🔗" },
  { name: "โปรสมาชิกใหม่", desc: "ดูยอดรับ เงื่อนไข เทิร์น และช่วงเวลาที่ใช้ได้ก่อนกดรับได้ทุกครั้ง", tag: "สิทธิ์สมาชิก", icon: "🎁" },
  { name: "ฝากถอนออโต้", desc: "ส่งรายการผ่านทรูวอลเล็ตหรือธนาคารชั้นนำ ถอนได้จริงสูงสุด 10 ล้านบาทจากหน้าเมมเบอร์", tag: "ช่องทางหลัก", icon: "💳" },
];
---

<section aria-label="หมวดเกมและบริการที่ OKHENG รวมไว้ในยูสเดียว" class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#ff3d63] via-[#f9dfe3] to-[#f0b429] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      หมวดเกมและบริการที่ <span class="text-[#f0b429]">OKHENG</span> รวมไว้ในยูสเดียว
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#ed0133] to-transparent"></div>
  </div>

  <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4 lg:gap-5 xl:grid-cols-7">
    {
      providers.map((provider) => (
        <a
          href="/register"
          class="group relative flex flex-col items-center justify-center overflow-hidden rounded-2xl border border-[#6b0d1e] bg-[#2a0509] p-5 shadow-[0_10px_30px_rgba(237,1,51,0.14)] transition-all duration-300 hover:-translate-y-2 hover:border-[#ed0133]/60 hover:bg-[#3a070f] hover:shadow-[0_15px_40px_rgba(237,1,51,0.28)]">
          <div class="pointer-events-none absolute inset-0 bg-[#ed0133]/8 opacity-0 transition-opacity duration-300 group-hover:opacity-100" />

          <div class="absolute top-2 right-2 z-10 rounded-full bg-gradient-to-r from-[#ff3d63] via-[#ed0133] to-[#7a0119] px-2 py-0.5 text-[9px] font-black tracking-wide whitespace-nowrap text-[#ffdb7d] shadow-sm transition-transform duration-300 group-hover:scale-110">
            {provider.tag}
          </div>

          <div aria-hidden="true" class="mb-3 text-4xl transition-transform duration-300 group-hover:scale-125 group-hover:rotate-3">
            {provider.icon}
          </div>
          <p class="text-center text-sm font-black text-[#ffdb7d] transition-colors group-hover:text-[#f0b429]">{provider.name}</p>
          <p class="mt-1 text-center text-[10px] text-[#e0b6bd]">{provider.desc}</p>

          <span class="relative z-10 mt-4 block w-full rounded-full border border-[#6b0d1e] bg-[#170206] py-1.5 text-center text-[11px] font-bold text-[#ff3d63] shadow-inner transition-colors duration-300 group-hover:border-[#f0b429]/60 group-hover:bg-gradient-to-r group-hover:from-[#ffdb7d] group-hover:via-[#f0b429] group-hover:to-[#a8710c] group-hover:text-[#170206]">
            เข้าดูหมวดนี้
          </span>
        </a>
      ))
    }
  </div>
</section>
