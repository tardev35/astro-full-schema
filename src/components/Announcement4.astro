---
const { message = "🔴 ถ่ายทอดสดฟุตบอลพรีเมียร์ลีกคืนนี้ แมนยู พบ ลิเวอร์พูล ค่าน้ำดีที่สุดในไทย!" } = Astro.props;
---

<div class="mx-auto mt-6 max-w-[900px] px-2 md:px-0">
  <div class="relative flex h-[40px] items-center rounded-sm border-b-2 border-red-600 bg-[#111] shadow-[0_2px_10px_rgba(0,0,0,0.8)]">
    <div class="absolute -top-3 left-4 flex items-center gap-1.5 rounded-sm bg-red-600 px-3 py-0.5 shadow-[0_4px_10px_rgba(220,38,38,0.5)]">
      <div class="h-2 w-2 animate-pulse rounded-full bg-white"></div>
      <span class="text-[10px] font-black tracking-widest text-white md:text-xs">LIVE STREAM</span>
    </div>

    <div class="ml-32 flex-1 overflow-hidden md:ml-40">
      <div class="flex w-max animate-[scroll_22s_linear_infinite] gap-12 text-sm font-medium whitespace-nowrap text-white/90">
        <span>{message}</span>
        <span>{message}</span>
      </div>
    </div>
  </div>
</div>

<style>
  @keyframes scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(calc(-50% - 24px));
    }
  }
</style>
