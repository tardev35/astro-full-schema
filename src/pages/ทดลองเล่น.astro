---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement4.astro";

import { Picture } from "astro:assets";
import { itemList, pageGraph, schemaCtx } from "../lib/schema";
import image1 from "../assets/gamedemo7.webp";
import image2 from "../assets/gamedemo8.webp";
import image3 from "../assets/gamedemo9.webp";
import image4 from "../assets/gamedemo10.webp";
import image5 from "../assets/gamedemo11.webp";
import image6 from "../assets/gamedemo12.webp";
import image7 from "../assets/gamedemo13.webp";
import image8 from "../assets/gamedemo14.webp";
import image9 from "../assets/gamedemo15.webp";
import image10 from "../assets/gamedemo16.webp";
import image11 from "../assets/gamedemo17.webp";
import image12 from "../assets/gamedemo18.webp";

const demoGames = [
  { name: "AskmeSlot", src: image1, alt: "แบนเนอร์ค่าย askmeslot โลโก้โพดำสีทองที่มีสัญลักษณ์ไพ่อยู่ข้างใน คู่กับตัวการ์ตูนเด็กชายสวมหมวกแดงติดดาว กางแขนวิ่งบนถนนในเมืองยุโรปที่มีกังหันลม" },
  { name: "Popular Game", src: image2, alt: "แบนเนอร์ Popular Game ตัวอักษรทองนูนหน้าวงแหวนชิปคาสิโนสีทอง ขนาบด้วยกระต่ายถือหีบสมบัติกับแมวใส่แว่นกันแดด ท่ามกลางเหรียญทองและชิปที่ลอยฟุ้ง" },
  { name: "SlotXO", src: image3, alt: "แบนเนอร์ค่าย SLOTXO โลโก้ตู้สล็อตล้อมด้วยเหรียญทอง คู่กับนักรบโรมันผมขาวสวมมงกุฎใบลอเรลและเกราะทอง ยืนหน้าโคลอสเซียมกับทหารอีกสองนาย" },
  { name: "Skywind Group", src: image4, alt: "แบนเนอร์ค่าย Skywind Group โลโก้วงกลมสี่สีบนพื้นดำ คู่กับแมวกวักนำโชคสีขาวคาดกระพรวนทอง ยืนข้างไหทองและถุงเงินสีม่วงใต้ต้นซากุระ" },
  { name: "PG Soft", src: image5, alt: "แบนเนอร์ค่าย PG Pocket Games Soft โลโก้ตัวอักษรพิกเซลบนพื้นดำ คู่กับตัวละครหญิงนักรบผิวแทนสวมเครื่องประดับทองและหมวกขนนกสไตล์แอซเท็ก" },
  { name: "SBOBET", src: image6, alt: "แบนเนอร์ค่ายเกม SBOBET โลโก้ตัวอักษรขาวบนพื้นดำ คู่กับตัวการ์ตูนอนิเมะสาวหูจิ้งจอกผมบลอนด์ในชุดกิโมโนสีชมพู มือถืออมยิ้มเกลียวหลากสี" },
  { name: "Sexy Slot", src: image7, alt: "แบนเนอร์ค่าย Sexy Slot ตัวอักษรสีชมพูม่วงมีประกายวิบวับ คู่กับตัวการ์ตูนสาวผมน้ำตาลในชุดรัดรูปสีม่วง นั่งอยู่ในกรอบวงกลมที่ล้อมด้วยหัวใจสีชมพู" },
  { name: "JILI", src: image8, alt: "แบนเนอร์ค่ายเกม JILI ตัวอักษรทองบนพื้นดำ คู่กับนางเงือกผมแดงสวมเกราะเปลือกหอยสีทอง ยกหอยสังข์แนบหูอยู่ใต้ทะเลที่มีปลาการ์ตูนและปะการัง" },
  { name: "Ask Me Bet", src: image9, alt: "แบนเนอร์ค่ายเกม ask me bet โลโก้สามช่องสีขาวเขียวเหลืองบนพื้นดำ คู่กับหัวสิงโตเชิดสีแดงทองตาโต ใต้แถวโคมไฟสีแดงหน้าศาลเจ้า" },
  { name: "New Game", src: image10, alt: "แบนเนอร์ New Game ตัวอักษรสีขาวนูนกลางภาพ ขนาบด้วยตัวการ์ตูนฟักทองหัวไฟกับโครงกระดูกยิ้ม ยืนบนฟลอร์นีออนสีชมพูฟ้าที่เกลื่อนด้วยชิปและลูกเต๋า" },
  { name: "JOKER", src: image11, alt: "แบนเนอร์ค่ายเกม JOKER ตัวอักษรขาวทองบนพื้นดำ คู่กับนักรบโรมันสวมหมวกเหล็กติดขนนกและถือโล่ ยืนเคียงสิงโตกำลังคำรามกลางสนามประลอง" },
  { name: "AFB Gaming", src: image12, alt: "แบนเนอร์ค่ายเกม AFB Gaming โลโก้ตัวอักษรทองบนพื้นดำ คู่กับเทพซุสเคราขาวตาเรืองแสงสีฟ้า สวมมงกุฎใบลอเรลและกำไลทองหน้าวิหารกรีก" },
];

const gameList = demoGames.map((game) => ({ name: game.name, imagePath: game.src.src }));

const pageTitle = "ทดลองเล่น OSIRIS168 ลองสล็อตหลายค่ายก่อนเริ่มเล่นด้วยเครดิตจริง";

const pageHeading = "ทดลองเล่น OSIRIS168 ลองสล็อตลิขสิทธิ์แท้หลายค่ายให้พอใจก่อนเริ่มด้วยเครดิตจริง";

const pageDescription =
  "อยากลองสล็อตให้หายสงสัยก่อนลงเครดิตจริง OSIRIS168 รวมค่ายเกมดังไว้ให้เลือกทดลองเล่นในยูสเดียว ดูเดิมพันต่อรอบและฟีเจอร์ของแต่ละเกมจนพอใจ แล้วค่อยเริ่มเล่นจริง";

const ctx = schemaCtx(Astro);
const graph = pageGraph(Astro, {
  type: "CollectionPage",
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  ],
  extra: [
    itemList(ctx, {
      name: "ทดลองเล่นเกมของ OSIRIS168",
      alternateName: "OSIRIS168 โหมดทดลองเกมลิขสิทธิ์แท้หลายค่ายบนมือถือก่อนเล่นด้วยเครดิตจริง",
      itemType: "Game",
      items: gameList,
    }),
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox as="h1" title={pageHeading}>
    <p class="mb-4 text-left text-base leading-relaxed text-[#dfeee6]">
      หากคุณกำลังมองหาที่ลองสล็อตให้หายสงสัยก่อนลงเครดิตจริง <strong class="text-[#e8b52c]">OSIRIS168</strong> เปิดค่ายเกมดังไว้ให้เลือกลองหลายค่ายในที่เดียว ทั้ง PG Soft, Joker,
      JILI และ SLOTXO
    </p>

    <p class="mb-4 text-left text-base leading-relaxed text-[#dfeee6]">
      เลือกค่ายที่สนใจแล้วกดเข้าไปเปิดยูส ใช้เวลาไม่กี่วินาที จากนั้นเข้าโหมดทดลองของค่ายนั้นต่อได้จากหน้าเมมเบอร์ เปิดผ่านเบราว์เซอร์บนมือถือ แท็บเล็ต หรือคอมก็ได้เหมือนกัน
    </p>

    <p class="text-left text-base leading-relaxed text-[#dfeee6]">
      ลองจนเจอเกมที่ใช่และจังหวะที่ถูกมือ เพื่อให้รอบแรกที่ลงเครดิตจริงเป็นเกมที่คุณรู้จักมันดีอยู่แล้ว
    </p>
  </ContentBox>

  <ContentBox as="h2" title="เลือกค่ายที่สะดุดตา แล้วเข้าไปลองกับ OSIRIS168 ได้เลย">
    <p class="mb-4 text-left text-base leading-relaxed text-[#dfeee6]">
      เริ่มจากค่ายไหนก็ได้ที่ถูกใจ แต่ละค่ายมีธีมและฟีเจอร์เป็นของตัวเอง ทั้งสล็อตหมุนคลาสสิก เกมฟรีสปิน และเกมโบนัสฟีเจอร์ที่จังหวะไม่เหมือนกันสักค่าย
    </p>

    <p class="mb-4 text-left text-base leading-relaxed text-[#dfeee6]">
      กดที่ภาพค่ายที่สนใจเพื่อไปยังขั้นตอนสมัคร เปิดยูสเสร็จก็เข้าใช้งานค่ายนั้นได้ทันที ทุกเกมเป็นลิขสิทธิ์แท้จากผู้พัฒนาโดยตรงและทำงานตามค่า RTP จริง
    </p>

    <p class="mb-8 text-left text-base leading-relaxed text-[#dfeee6]">ยูสเดียวสลับได้ทุกค่าย ไม่ต้องเปิดบัญชีใหม่ทุกครั้งที่อยากเปลี่ยนแนว</p>
    <div class="mb-5 grid grid-cols-2 gap-5 sm:grid-cols-2 md:grid-cols-4">
      {
        demoGames.map((game) => (
          <div class="group/game relative mx-auto w-full max-w-[400px] overflow-hidden rounded-xl">
            <Picture
              src={game.src}
              alt={game.alt}
              loading="lazy"
              fetchpriority="low"
              widths={[200, 400, 600]}
              sizes="(max-width: 768px) 50vw, 25vw"
              class="block h-auto w-full object-cover shadow-[0_10px_30px_rgba(18,196,143,0.16)] transition-transform duration-300 group-hover/game:scale-105"
              decoding="async"
              formats={["avif", "webp"]}
              fallbackFormat="webp"
              quality={60}
            />
            <a
              href="/register"
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`สมัครสมาชิกเพื่อเล่น ${game.name} ที่ OSIRIS168`}
              class="absolute inset-0 flex items-center justify-center bg-[#050d0b]/85 opacity-0 transition-opacity duration-300 group-hover/game:opacity-100 focus-visible:opacity-100">
              <span class="rounded-full border border-[#12c48f]/60 bg-gradient-to-r from-[#ffdd8a] via-[#e8b52c] to-[#8a6314] px-6 py-2 font-bold text-[#03251c] shadow-[0_10px_30px_rgba(18,196,143,0.32)] transition-transform hover:scale-110">เล่นเลย</span>
            </a>
          </div>
        ))
      }
    </div>
  </ContentBox>

  <ContentBox as="h2" title="ทดลองเล่นฟรีไม่จำกัดรอบ ลองให้พอใจก่อนใช้เครดิตจริง">
    <p class="mb-4 text-left text-base leading-relaxed text-[#dfeee6]">
      พอเข้าถึงโหมดทดลองแล้วหมุนได้ไม่จำกัดรอบ เพราะเป็นเครดิตสมมติล้วน ๆ อยากลองผิดลองถูกกี่ครั้งก็ตามสบาย ไม่มีอะไรต้องเสี่ยงเลยสักบาท
    </p>

    <p class="mb-4 text-left text-base leading-relaxed text-[#dfeee6]">
      ระหว่างลองก็ดูไปด้วยว่าเดิมพันต่อรอบเริ่มที่เท่าไร ฟีเจอร์เข้าง่ายแค่ไหน หนึ่งรอบกินเวลานานไหม แล้วเก็บไว้เป็นข้อมูลตอนเลือกเกมที่จะเล่นจริง
    </p>

    <p class="mb-4 text-left text-base leading-relaxed text-[#dfeee6]">เครดิตในโหมดทดลองถอนไม่ได้ และไม่นับเป็นยอดเทิร์นของโปรใด ๆ</p>

    <p class="text-left text-base leading-relaxed text-[#dfeee6]">
      อีกอย่างคือไม่ใช่ทุกเกมที่มีปุ่มทดลอง ถ้าเกมที่อยากลองยังไม่เปิดโหมดนี้ สมัครสมาชิกแล้วเข้าไปดูของจริงได้เลย
    </p>
  </ContentBox>

  <ContentBox as="h2" title="พร้อมเมื่อไหร่ สมัครสมาชิก OSIRIS168 แล้วเริ่มเล่นจริงได้ทันที">
    <p class="mb-4 text-left text-base leading-relaxed text-[#dfeee6]">
      สมัครเสร็จในไม่กี่วินาที ไม่ต้องคุยกับแอดมิน แล้วได้ยูสเดียวที่ครอบคลุมเกมทุกค่ายในเว็บ
    </p>

    <p class="mb-4 text-left text-base leading-relaxed text-[#dfeee6]">
      หน้าเมมเบอร์รวมเกม เครดิต โปรโมชั่น และประวัติรายการไว้จุดเดียว ส่วนระบบฝากถอนเป็นออโต้ ส่งรายการเองได้จากมือถือแล้วกลับเข้าเกมต่อได้เลย
    </p>

    <p class="mb-4 text-left text-base leading-relaxed text-[#dfeee6]">
      ก่อนลงเดิมพันรอบแรก ตั้งงบต่อรอบที่รับไหวไว้ก่อน แล้วเปิดหน้าโปรโมชั่นดูว่าสิทธิ์ที่เปิดอยู่ให้ยอดเท่าไร เทิร์นเท่าไร
    </p>

    <p class="mb-4 text-left text-base leading-relaxed text-[#dfeee6]">อีกอย่างที่ควรติดตัวไว้เสมอ อย่าบอกรหัสผ่านหรือรหัส OTP ให้ใครทั้งนั้น</p>

    <p class="text-left text-base leading-relaxed text-[#dfeee6]">
      เลือกค่ายที่ถูกใจแล้วเปิดยูสได้เลย เพื่อให้เกมที่ลองจนคุ้นมือ กลายเป็นเกมที่คุณเล่นจริงในรอบถัดไป
    </p>
  </ContentBox>

  <Navfoot />
</MainLayout>
