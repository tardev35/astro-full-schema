---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement6.astro";
import { pageGraph } from "../lib/schema";

const pageTitle = "เกี่ยวกับเรา NORWAY89 เว็บตรงรวมบาคาร่า สล็อต บอล และหวยในบัญชีเดียว";

const pageDescription =
  "เกี่ยวกับเรา NORWAY89 เว็บตรงที่รวมบาคาร่า สล็อต บอล และหวยไว้ในระบบเดียว ทำความรู้จักแนวทางดูแลสมาชิก ระบบฝากถอนออโต้ และการจัดหมวดเกมให้ใช้งานง่ายบนมือถือ";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox as="h1" title={pageTitle}>
    <p class="mb-4 text-left text-base leading-relaxed text-[#efe0c4]">
      NORWAY89 เป็นเว็บตรงที่รวมบาคาร่า สล็อต บอล หวย และเกมออนไลน์หลายสไตล์ไว้ในบัญชีเดียว เปิดเข้ามาแล้วเลือกหมวดที่ชอบได้เลย
      อยากเปลี่ยนจากบาคาร่าไปสล็อต หรือพักจากสล็อตไปดูตารางบอลก็สลับได้จากหน้าเดิม สิ่งที่เราให้ความสำคัญคือหน้าเว็บที่รองรับมือถือ ระบบฝากถอนออโต้
      และหน้าสมาชิกที่รวมเครดิต โปรโมชั่น และประวัติรายการไว้ครบในที่เดียว
    </p>

    <p class="text-left text-base leading-relaxed text-[#efe0c4]">
      หน้านี้ทำหน้าที่เป็นหน้าข้อมูลและแนะนำตัว อธิบายว่าเว็บนี้ให้บริการอะไร จัดหน้าเว็บอย่างไร และเหมาะกับผู้ใช้แบบไหน เพื่อให้อ่านแล้วนำไปเทียบกับสิ่งที่เห็นในหน้าสมาชิกจริงได้
      รายละเอียดของโปรโมชั่นและเงื่อนไขแต่ละรายการจะอยู่ในหน้ารายการของโปรนั้นโดยตรง จึงควรเปิดดูก่อนใช้สิทธิ์ทุกครั้ง
    </p>
  </ContentBox>

  <ContentBox as="h2" title="สี่หมวดเกมหลักที่ NORWAY89 รวมไว้ในระบบเดียว">
    <p class="mb-4 text-left text-base leading-relaxed text-[#efe0c4]">
      เมนูของเราแบ่งเป็นบาคาร่า สล็อต บอล และหวย บาคาร่ารวมโต๊ะคาสิโนออนไลน์ไว้เป็นหมวดชัด เลือกเกมและวงเงินที่เหมาะกับตัวเองก่อนเข้าเล่นได้
      สล็อตมีหลายธีมและหลายรูปแบบ ตั้งแต่เกมเล่นง่ายไปจนถึงเกมที่มีฟรีสปิน โบนัส และฟีเจอร์พิเศษ ส่วนหมวดบอลและหวยเปิดไว้สำหรับคนที่ไม่ได้เล่นเฉพาะคาสิโน
      จะดูรายการกีฬา เลือกตลาดที่สนใจ หรือเข้าเล่นหวยก็ทำผ่านบัญชีเดียวกัน
    </p>

    <p class="text-left text-base leading-relaxed text-[#efe0c4]">
      การแยกหมวดแบบนี้ทำให้หาเกมที่ถูกใจได้เร็วขึ้น คนที่ชอบเปลี่ยนแนวระหว่างวันจึงเลือกได้อิสระ เช้าเช็กบอล เย็นเล่นสล็อต ค่ำไปบาคาร่าได้หมด
      ความชอบเปลี่ยนได้ ส่วนบัญชีไม่ต้องเปลี่ยนตามให้วุ่น และไม่ต้องเดินอ้อมผ่านสล็อตครึ่งเว็บกว่าจะเจอของที่หา
    </p>
  </ContentBox>

  <ContentBox as="h2" title="ระบบฝากถอนออโต้ที่จัดการเครดิตได้สะดวกตลอดวัน">
    <p class="mb-4 text-left text-base leading-relaxed text-[#efe0c4]">
      NORWAY89 ใช้ระบบฝากถอนออโต้ ทำให้การเติมเครดิตและถอนยอดจบเป็นขั้นตอนสั้น สมาชิกดูสถานะรายการและประวัติย้อนหลังได้จากหน้าบัญชีโดยตรง
      ไม่ต้องคุยหลายขั้นตอนก่อนเข้าเล่น ทำรายการเสร็จก็กลับไปเลือกเกมต่อได้ทันที
    </p>

    <p class="text-left text-base leading-relaxed text-[#efe0c4]">
      ระบบออโต้ช่วยลดเวลารอเป็นหลัก สมาชิกจึงจัดการยอดได้ตามเวลาที่สะดวก บางคนเข้าช่วงกลางวัน บางคนเพิ่งว่างหลังเที่ยงคืน ขั้นตอนก็เป็นชุดเดียวกัน
      ความตื่นเต้นควรอยู่ในเกม ไม่ใช่อยู่ตอนลุ้นว่ารายการจะเดินถึงไหน
    </p>
  </ContentBox>

  <ContentBox as="h2" title="ทางเข้าและระบบสมาชิกที่รวมข้อมูลไว้จุดเดียว">
    <p class="mb-4 text-left text-base leading-relaxed text-[#efe0c4]">
      ทางเข้าของเรารองรับโทรศัพท์ แท็บเล็ต และคอมพิวเตอร์ สมาชิกเข้าสู่ระบบผ่านเบราว์เซอร์แล้วเลือกเกมหรือจัดการบัญชีได้ตามอุปกรณ์ที่ใช้อยู่
      หน้าเว็บออกแบบให้เมนูสำคัญเข้าถึงง่ายบนจอเล็ก ทั้งเข้าสู่ระบบ เกม โปรโมชั่น และฝากถอน มือถือมีพื้นที่น้อยอยู่แล้ว เมนูจึงไม่ควรเล่นซ่อนหาเพิ่มอีกหนึ่งเกม
    </p>

    <p class="text-left text-base leading-relaxed text-[#efe0c4]">
      หลังเข้าสู่ระบบ ยอดเครดิต โปรโมชั่น และประวัติการทำรายการจะอยู่ในบัญชีเดียวกันทั้งหมด จึงดูข้อมูลสำคัญได้จากหน้าเดียวโดยไม่ต้องเปิดหลายส่วนเพื่อไล่หายอดย้อนหลัง
      การรวมข้อมูลไว้เป็นชุดเดียวช่วยให้จัดการบัญชีง่ายขึ้น โดยเฉพาะคนที่เล่นหลายหมวดในวันเดียว
    </p>
  </ContentBox>

  <ContentBox as="h2" title="NORWAY89 เหมาะกับผู้ใช้แบบไหน">
    <p class="mb-4 text-left text-base leading-relaxed text-[#efe0c4]">
      NORWAY89 เหมาะกับคนที่ชอบบาคาร่า สล็อต บอล และหวย แต่ต้องการใช้งานทั้งหมดจากบัญชีเดียว รวมถึงคนที่เล่นผ่านมือถือเป็นหลักและอยากได้ระบบฝากถอนออโต้ที่ทำรายการได้ตลอดวัน
      ภาพรวมของเราเน้นเกมครบ ใช้งานง่าย และขั้นตอนไม่เยอะ จึงตอบโจทย์ทั้งสายคาสิโน สายสล็อต สายกีฬา และสายตัวเลข
    </p>

    <p class="text-left text-base leading-relaxed text-[#efe0c4]">
      การสมัครเน้นขั้นตอนที่เข้าใจง่าย กรอกข้อมูลสมาชิก ตั้งค่าบัญชี แล้วเข้าหน้าหลักเพื่อเลือกหมวดเกมได้จากเมนูเดียว สมัครครั้งเดียวให้จบ
      เพราะชีวิตประจำวันมีฟอร์มให้กรอกเยอะพอแล้ว ส่วนเงื่อนไขของโปรโมชั่นแต่ละรายการยังคงต้องอ่านจากหน้ารายการของโปรนั้นก่อนกดรับเสมอ
    </p>
  </ContentBox>

  <Navfoot />
</MainLayout>
