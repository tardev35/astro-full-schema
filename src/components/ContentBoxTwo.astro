---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
  label?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label } = Astro.props;

const sectionLabel = label ?? title ?? titleleft ?? titleright ?? "ข้อมูลประกอบ";
---

<section aria-label={sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#fec93a]/40 bg-[#221703]/92 p-8 text-[#f4e8d2] shadow-[0_10px_30px_rgba(254,201,58,0.14)] backdrop-blur-xl transition-all duration-500 hover:border-[#fec93a]/75 md:p-10">
    {
      title && (
        <header class="mb-6 flex items-center gap-4 border-b border-[#fec93a]/25 pb-4">
          <span aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffe9a8] to-[#c9ccd4] shadow-[0_0_10px_rgba(254,201,58,0.45)]" />
          <HeadingTag class="bg-gradient-to-r from-[#ffe9a8] via-[#fec93a] to-[#d4840e] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f4e8d2]">
        {
          titleleft && (
            <p class="flex items-center gap-3 border-b border-[#fec93a]/25 pb-3 text-xl leading-normal font-black tracking-widest text-[#ffe9a8] uppercase">
              <span
                aria-hidden="true"
                class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#ffe9a8]/60 bg-gradient-to-br from-[#ffe9a8] via-[#fec93a] to-[#a06a09] text-sm text-[#160e03] shadow-[0_5px_15px_rgba(254,201,58,0.28)]">
                🔐
              </span>
              {titleleft}
            </p>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f4e8d2]">
        {
          titleright && (
            <p class="flex items-center gap-3 border-b border-[#fec93a]/25 pb-3 text-xl leading-normal font-black tracking-widest text-[#ffe9a8] uppercase">
              <span
                aria-hidden="true"
                class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#e6e8ee]/50 bg-gradient-to-br from-[#c9ccd4] via-[#8b93a3] to-[#5c6472] text-sm text-[#160e03] shadow-[0_5px_15px_rgba(201,204,212,0.32)]">
                📊
              </span>
              {titleright}
            </p>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
