---
const {
  // No leading emoji in the message. The badge to its left already shows one,
  // and a decorative glyph baked into a text prop cannot be marked aria-hidden
  // from here — it would be read out ahead of the sentence, three times over,
  // once per marquee copy.
  message = "TGA99 สล็อต คาสิโนสด หวย ยิงปลา บัญชีเดียว • ฝากถอนออโต้ตลอด 24 ชั่วโมง ฝากขั้นต่ำ 20 บาท ถอนขั้นต่ำ 50 บาท • โอนได้จากทุกธนาคารและทรูวอเลท ไม่ต้องแนบสลิป • สลับหมวดเล่นต่อได้ทันที ไม่ต้องโยกเครดิต",
} = Astro.props;

const SCROLL_PX_PER_SEC = 50;
const PX_PER_CHAR = 6.2;
const TRAILING_PX = 81;
const scrollSeconds = Math.max(12, Math.round((message.length * PX_PER_CHAR + TRAILING_PX) / SCROLL_PX_PER_SEC));
---

<div class="mx-auto max-w-[900px] p-2">
  <div
    class="group relative flex h-[50px] items-center overflow-hidden rounded-full border border-[#c13fc4]/45 bg-gradient-to-b from-[#31103a] via-[#1c0620] to-[#31103a] p-1 shadow-[0_5px_20px_rgba(193,63,196,0.25),inset_0_1px_1px_rgba(255,255,255,0.08)]">
    <div aria-hidden="true" class="pointer-events-none absolute -top-6 left-10 h-16 w-16 rounded-full bg-[#c13fc4]/25 blur-[30px]"></div>
    <div aria-hidden="true" class="pointer-events-none absolute right-16 -bottom-6 h-16 w-16 rounded-full bg-[#f5c542]/20 blur-[30px]"></div>

    <div
      class="relative z-10 flex h-full shrink-0 items-center gap-1.5 rounded-full border border-[#ffe08a]/45 bg-gradient-to-b from-[#ffe08a] via-[#f5c542] to-[#b07d12] px-3.5 shadow-[inset_0_1px_1px_rgba(255,255,255,0.6)] md:px-4">
      <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#3a0535] shadow-[0_0_6px_rgba(58,5,53,0.8)]"></span>
      <span class="text-xs font-black tracking-wider text-[#3a0535] uppercase md:text-sm"><span aria-hidden="true">👑</span> TGA99</span>
    </div>

    <div class="marquee-window relative z-10 flex-1 overflow-hidden px-4">
      <div class="marquee-track flex w-max gap-10 text-sm font-bold whitespace-nowrap text-[#ead9ec]" style={`animation-duration:${scrollSeconds}s`}>
        <span>{message}</span>
        <span aria-hidden="true" class="text-[#f5c542]/85">✨</span>
        <span aria-hidden="true">{message}</span>
        <span aria-hidden="true" class="text-[#f5c542]/85">✨</span>
        <span aria-hidden="true">{message}</span>
        <span aria-hidden="true" class="text-[#f5c542]/85">✨</span>
      </div>
    </div>

    <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 bottom-0 h-[2px] bg-gradient-to-r from-transparent via-[#e061e3]/70 to-transparent opacity-70"></div>
  </div>
</div>

<style>
  .marquee-track {
    animation: announcement6-scroll 48s linear infinite;
  }
  .marquee-window:hover .marquee-track {
    animation-play-state: paused;
  }
  @keyframes announcement6-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-33.3333%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
    }
  }
</style>
