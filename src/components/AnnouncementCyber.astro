---
const {
  message = "VODKAFUN สล็อตเว็บตรงเว็บใหญ่ ลิขสิทธิ์แท้ 100% ส่งตรงจากค่ายแม่ผ่าน API แบบเรียลไทม์ • สมัครฟรี ไม่ต้องฝากก่อน ได้ยูสแล้วเข้าชมเกมได้ทันที • ฝากถอนออโต้ ไม่มีขั้นต่ำ รองรับแอปธนาคารและ True Money Wallet • รวม PG SOFT, Pragmatic Play และ Joker Gaming ในกระเป๋าเดียว • คอมมิชชั่นคืนทุกยอดเล่น 0.3% และแนะนำเพื่อนรับ 0.8% ดูเงื่อนไขที่หน้าโปรโมชั่น",
} = Astro.props;
---

<div class="mx-auto w-full max-w-7xl px-4 py-3 font-sans">
  <div
    class="relative flex overflow-hidden border border-[#ff3dc8]/50 bg-[#120633]/90 shadow-[0_0_15px_rgba(255,61,200,0.3)] backdrop-blur-md"
    style="clip-path: polygon(15px 0, 100% 0, calc(100% - 15px) 100%, 0 100%);">
    <div
      class="relative z-10 flex shrink-0 items-center justify-center bg-gradient-to-r from-[#ff3dc8] to-[#1be5f4] px-6 py-2.5 font-black text-[#14042e]"
      style="clip-path: polygon(0 0, 100% 0, calc(100% - 10px) 100%, 0 100%);">
      ประกาศ
    </div>

    <div class="marquee-container relative flex-1 overflow-hidden py-2.5 pr-6">
      <div class="pointer-events-none absolute top-0 left-0 z-10 h-full w-8 bg-gradient-to-r from-[#120633] to-transparent"></div>

      <div class="marquee-content inline-block pl-4 text-sm font-bold tracking-widest whitespace-nowrap text-[#ece6ff]">
        <span class="mr-8 inline-flex items-center gap-2"><span aria-hidden="true" class="h-2 w-2 bg-[#1be5f4] shadow-[0_0_8px_rgba(27,229,244,1)]"></span>{message}</span>
        <span class="mr-8 inline-flex items-center gap-2"><span aria-hidden="true" class="h-2 w-2 bg-[#1be5f4] shadow-[0_0_8px_rgba(27,229,244,1)]"></span>{message}</span>
      </div>
    </div>
  </div>
</div>

<style>
  .marquee-content {
    animation: marquee 20s linear infinite;
  }
  .marquee-container:hover .marquee-content {
    animation-play-state: paused;
  }
  @keyframes marquee {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee-content {
      animation: none;
    }
  }
</style>
