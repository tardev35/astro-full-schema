---
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";
---

<section class="my-6 flex w-full justify-center px-4 font-sans">
  <div class="w-full max-w-[1400px] rounded-[25px] bg-[#0d1420] p-8 text-center text-white/90 shadow-[10px_10px_20px_#05080f,-10px_-10px_20px_#141c2e]">
    {
      title && (
        <header class="mb-8">
          <HeadingTag class={`bg-gradient-to-r from-cyan-200 to-blue-500 bg-clip-text ${headingSize} font-black text-transparent drop-shadow-md`}>{title}</HeadingTag>
        </header>
      )
    }

    <div class="text-lg leading-relaxed text-blue-100/70">
      <slot />
    </div>
  </div>
</section>
<style>
  .font-sans {
    font-family: "Kanit", sans-serif;
  }
</style>
