---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";
import { pageGraph } from "../lib/schema";

const pageTitle = "เกี่ยวกับเรา PIGAUTO เว็บสล็อตออโต้แท้ ไม่มีขั้นต่ำ รองรับวอลเล็ท";

const pageHeading = "เกี่ยวกับเรา PIGAUTO เว็บสล็อตออโต้แท้ ไม่มีขั้นต่ำ รองรับวอลเล็ทเต็มระบบ";

const pageDescription =
  "เกี่ยวกับเรา PIGAUTO หน้ารวมข้อมูลเว็บสล็อตออโต้แท้ ไม่มีขั้นต่ำ รองรับวอลเล็ท พร้อมคาสิโนสด บาคาร่า หน้าเมมเบอร์ และระบบฝากถอนออโต้ไว้ในยูสเดียว รองรับมือถือ";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox as="h1" title={pageHeading}>
    <p class="mb-4 text-left text-base leading-relaxed text-[#f7e2d6]">
      <strong class="text-[#f5c542]">PIGAUTO</strong> รวมสล็อตออโต้ คาสิโนสด บาคาร่า และระบบฝากถอนไว้ในยูสเดียว เข้าสู่ระบบครั้งเดียวแล้วเลือกค่าย เช็กเครดิต หรือดูโปรที่เปิดอยู่ต่อได้ทันที
    </p>

    <p class="mb-4 text-left text-base leading-relaxed text-[#f7e2d6]">
      ไม่มีขั้นต่ำในการเข้าเล่น รองรับวอลเล็ทเต็มระบบ และใช้ยูสเดิมได้ทั้งบนมือถือและคอมพิวเตอร์
    </p>

    <p class="text-left text-base leading-relaxed text-[#f7e2d6]">
      ที่รวมไว้จุดเดียวไม่ใช่เพราะอยากให้เมนูดูเยอะ แต่เพราะการสลับเว็บกลางรอบปั่นคือจังหวะที่คนเล่นเสียไปเปล่า ๆ
    </p>
  </ContentBox>

  <ContentBox as="h2" title="PIGAUTO วางสล็อตออโต้ไว้เป็นหมวดหลักอย่างไร">
    <p class="mb-4 text-left text-base leading-relaxed text-[#f7e2d6]">
      สล็อตคือหมวดหลักของ PIGAUTO ค่ายถูกจัดเรียงให้ไล่ดูต่อเนื่องได้จากหน้าเดียว กดเข้าเกมได้เลยโดยไม่ต้องออกไปหาลิงก์ค่ายจากที่อื่น
    </p>

    <p class="mb-4 text-left text-base leading-relaxed text-[#f7e2d6]">
      สายปั่นแต่ละคนถนัดคนละแบบ บางคนไล่เปลี่ยนค่ายทั้งคืน บางคนอยู่กับเกมเดิมจนจำจังหวะได้
    </p>

    <p class="text-left text-base leading-relaxed text-[#f7e2d6]">
      ตัวเลือกค่ายจึงสำคัญพอ ๆ กับจำนวนเกมที่นับได้ในหน้ารวม เพราะเกมที่ไม่เคยเปิดเล่นก็เป็นแค่ตัวเลขบนหน้าเว็บ
    </p>
  </ContentBox>

  <ContentBox as="h2" title="เข้าสู่ระบบ PIGAUTO แล้วใช้งานหน้าเมมเบอร์ส่วนไหนได้บ้าง">
    <p class="mb-4 text-left text-base leading-relaxed text-[#f7e2d6]">
      หลังเข้าสู่ระบบ เปิดค่ายสล็อต เข้าห้องคาสิโนสด ดูเครดิต และเช็กโปรได้จากหน้าเดียว ด้วยยูสเดิมทั้งบนมือถือและคอมพิวเตอร์
    </p>

    <p class="mb-4 text-left text-base leading-relaxed text-[#f7e2d6]">
      เมนูสำคัญวางไว้ให้กดถึงได้เร็ว เพราะการล็อกอินควรเป็นประตูเข้าเกม ไม่ใช่ด่านทดสอบความอดทน
    </p>

    <p class="mb-4 text-left text-base leading-relaxed text-[#f7e2d6]">
      หน้าเมมเบอร์รวมเครดิต โปร และประวัติรายการไว้ที่เดียว จึงย้อนดูได้ว่าทำรายการไหนไปแล้วและใช้สิทธิ์โปรใดอยู่
    </p>

    <p class="text-left text-base leading-relaxed text-[#f7e2d6]">
      คนเล่นดูจากตรงนี้เป็นหลักว่าเครดิตขึ้นตรงไหมและรายการย้อนหลังหาเจอไหม เงินอยู่ตรงไหนต้องรู้ก่อน เกมอยู่ตรงไหนค่อยว่ากัน
    </p>
  </ContentBox>

  <ContentBox as="h2" title="คาสิโนสดและบาคาร่าของ PIGAUTO เปิดไว้ให้สายไหน">
    <p class="mb-4 text-left text-base leading-relaxed text-[#f7e2d6]">
      คาสิโนสดเป็นหมวดรองที่เปิดไว้ให้วันที่ไม่อยากปั่นสล็อต มีบาคาร่าเป็นตัวหลัก และไล่ดูหลายห้องก่อนเลือกโต๊ะได้
    </p>

    <p class="mb-4 text-left text-base leading-relaxed text-[#f7e2d6]">
      บางคนมีโต๊ะประจำ บางคนดูเค้าไพ่ก่อน บางคนแค่อยากได้ห้องที่ภาพชัดและกดเดิมพันง่าย
    </p>

    <p class="text-left text-base leading-relaxed text-[#f7e2d6]">
      โต๊ะนี้ไม่ใช่ก็ย้ายได้จากยูสเดิม ไม่ต้องเปิดบัญชีใหม่และไม่ต้องโอนเครดิตข้ามเว็บ
    </p>
  </ContentBox>

  <ContentBox as="h2" title="ฝากถอนออโต้และวอลเล็ทของ PIGAUTO ทำงานอย่างไร">
    <p class="mb-4 text-left text-base leading-relaxed text-[#f7e2d6]">
      ระบบออโต้ลดช่วงรอระหว่างฝากเข้า เครดิตขึ้น และเข้าเกม รวมถึงตอนถอนออก ส่งรายการและเช็กยอดได้จากหน้าเดียวตลอด 24 ชั่วโมง
    </p>

    <p class="mb-4 text-left text-base leading-relaxed text-[#f7e2d6]">
      รองรับวอลเล็ทเต็มระบบ จึงทำรายการจบได้จากมือถือเครื่องเดียวโดยไม่ต้องสลับแอปธนาคารไปมา
    </p>

    <p class="mb-4 text-left text-base leading-relaxed text-[#f7e2d6]">
      เวลาอยากพักเกมหรือเปลี่ยนค่าย ไม่มีใครอยากมานั่งไล่ถามว่ารายการถึงไหนแล้ว ระบบการเงินที่ดีควรอยู่หลังฉากและทำงานของมันไปเงียบ ๆ
    </p>

    <p class="text-left text-base leading-relaxed text-[#f7e2d6]">
      และขอย้ำไว้ตรงนี้ ไม่ควรส่งรหัสผ่านหรือรหัส OTP ให้บุคคลอื่นไม่ว่ากรณีใด
    </p>
  </ContentBox>

  <ContentBox as="h2" title="สมัครสมาชิกและทางเข้าผ่านมือถือใช้เวลานานไหม">
    <p class="mb-4 text-left text-base leading-relaxed text-[#f7e2d6]">
      สมัครผ่านมือถือเริ่มจากกรอกข้อมูล เปิดยูส และยืนยันตามขั้นตอนของระบบ จากนั้นล็อกอินเข้าหน้าเมมเบอร์เพื่อดูเกม เครดิต และโปรที่ใช้ได้
    </p>

    <p class="mb-4 text-left text-base leading-relaxed text-[#f7e2d6]">
      โครงแบบนี้เหมาะกับคนที่ใช้มือถือเป็นหลักและอยากจบทุกอย่างจากเครื่องเดียว
    </p>

    <p class="mb-4 text-left text-base leading-relaxed text-[#f7e2d6]">
      จำทางเข้าหลักที่ใช้อยู่ประจำไว้ จะกลับเข้าหน้าเมมเบอร์และกลับค่ายเดิมได้ไว ทั้งยังช่วยลดความสับสนจากชื่อเว็บคล้ายกันบนผลค้นหา
    </p>

    <p class="text-left text-base leading-relaxed text-[#f7e2d6]">
      ส่วนความเร็วในการโหลดเกมขึ้นอยู่กับเครื่อง เบราว์เซอร์ และสัญญาณอินเทอร์เน็ตของแต่ละคน
    </p>
  </ContentBox>

  <ContentBox as="h2" title="PIGAUTO เหมาะกับนักเล่นแบบไหน">
    <p class="mb-4 text-left text-base leading-relaxed text-[#f7e2d6]">
      เหมาะกับสายปั่นสล็อตที่ไม่ได้เล่นอย่างเดียว อยากมีคาสิโนสด โปร และระบบฝากถอนอยู่ในยูสเดียว โดยเน้นใช้งานผ่านมือถือเป็นหลัก
    </p>

    <p class="mb-4 text-left text-base leading-relaxed text-[#f7e2d6]">
      เลือกค่ายที่ถูกใจ เช็กโปรที่เหมาะกับงบ แล้วจัดการเครดิตต่อได้จากที่เดียว
    </p>

    <p class="mb-4 text-left text-base leading-relaxed text-[#f7e2d6]">
      หลายค่ายมีไว้เลือก ส่วนหลายบัญชีส่วนใหญ่มีไว้ลืมรหัส ยูสเดียวจึงจบง่ายกว่าเกือบทุกกรณี
    </p>

    <p class="text-left text-base leading-relaxed text-[#f7e2d6]">
      เลือกเกมที่สนุกกับตัวเองก่อน แล้วค่อยให้ระบบที่เหลือทำงานตามหน้าที่ของมันไป
    </p>
  </ContentBox>

  <Navfoot />
</MainLayout>
