---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/Announcement5.astro";
import ContentBox from "../components/ContentBox.astro";
import ContentBoxNeumorphism from "../components/ContentBoxNeumorphism.astro";
import ContentBoxSpecial from "../components/ContentBoxSpecial.astro";
import ContentBoxSevenThreeFloatingBadge from "../components/ContentBoxSevenThreeFloatingBadge.astro";
import ContentBoxTwoNeumorphism from "../components/ContentBoxTwoNeumorphism.astro";
import ContentBoxSevenThreeNeumorphism from "../components/ContentBoxSevenThreeNeumorphism.astro";
import Faq4 from "../components/Faq4.astro";
import SmoothCarousel from "../components/SmoothCarousel.astro";
import ProviderGridPremium from "../components/ProviderGridPremium.astro";
import LatestWinners2 from "../components/LatestWinners2.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import ReviewCardSumo from "../components/ReviewCardSumo.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import imgDeposit from "../assets/slide1.png";
import imgSignup from "../assets/slide3.png";

const pageTitle = "MEEHAY569 สล็อตเว็บตรง ฝากถอนทรูวอเลท 1 บาท ทดลองเล่นก่อนสมัคร";

const pageDescription =
  "MEEHAY569 สล็อตเว็บตรง ไม่ผ่านเอเย่นต์ ฝากถอนทรูวอเลทออโต้เริ่ม 1 บาท ทดลองเล่นสล็อตก่อนตัดสินใจ มือใหม่หรือสายทุนน้อยก็เริ่มได้ สมัครง่าย 4 ขั้นตอน";

const h1Title = "MEEHAY569 สล็อตเว็บตรง ฝากถอนทรูวอเลท 1 บาท ทดลองเล่นก่อนสมัคร";

const announcementMessage =
  "MEEHAY569 สล็อตเว็บตรง ไม่ผ่านเอเย่นต์ • ฝากถอนทรูวอเลทออโต้ เริ่ม 1 บาท ตลอด 24 ชั่วโมง ไม่ต้องส่งสลิป • ทดลองเล่นสล็อตได้โดยไม่ต้องฝากเงินหรือสมัครก่อน • สมัครง่าย 4 ขั้นตอน เล่นได้ทั้งเว็บมือถือ แอป และคอม";

const depositAlt =
  "โลโก้ MEEHAY569 ตัวอักษรสีฟ้าเลข 569 สีทอง ฝากครบ 500 รับเครดิตฟรี 50 โปรลุ้นสนุก ใช้ได้จริง สมัครวันนี้คุ้มกว่า สำหรับสมาชิกที่ร่วมกิจกรรม ปุ่มรับสิทธิ์เลย พรีเซนเตอร์ชุดเลื่อมสีเงิน กบเขียว มังกรข้างวงล้อ 777 และเหรียญทองบนท้องฟ้า";

const signupAlt =
  "โลโก้ MEEHAY569 ตัวอักษรสีฟ้าเลข 569 สีทอง สมาชิกใหม่ ฝาก 100 รับ 300 สมัครง่าย รับไว โปรเริ่มต้นสุดคุ้ม ทำยอดตามเงื่อนไขก่อนถอน ปุ่มสมัครเลย พรีเซนเตอร์ชุดเลื่อมสีเงิน กบเขียวสวมมงกุฎชูนิ้วโป้งและถ้วยรางวัลสีทอง";

const faqTitle = "FAQ สิ่งที่คนถามก่อนเล่นสล็อตเว็บตรงกับเรา";

const faqs = [
  {
    q: "เล่นสล็อตเวลาไหนแตกดี?",
    a: "ไม่มีเวลาตายตัว แต่ละสปินเป็นผลสุ่ม กลางวันหรือกลางคืนจึงลุ้นเหมือนกัน เลือกเวลาที่คุณเล่นได้สบายจะดีกว่าครับ",
  },
  {
    q: "มือใหม่หัดเล่นสล็อตเริ่มยังไงดี?",
    a: "เริ่มจากโหมดทดลองเล่นก่อน เลือกเกมที่กติกาเข้าใจง่าย ดูว่าฟีเจอร์ทำงานแบบไหน แล้วค่อยเริ่มเล่นจริงจากยอดเล็กครับ",
  },
  {
    q: "สมัคร MEEHAY569 ต้องใช้อะไรบ้าง?",
    a: "ใช้เบอร์โทรศัพท์ที่รับ OTP ได้ แล้วทำตามขั้นตอนบนเว็บจนฝากเงินเข้าระบบ รหัส OTP ห้ามบอกใครครับ",
  },
  {
    q: "ไม่มีบัญชีธนาคาร เล่นได้จริงไหม?",
    a: "ได้ ใช้ทรูวอเลทฝากถอนแทนบัญชีธนาคารได้ เริ่มที่ 1 บาท และทำรายการเองได้ตลอด 24 ชั่วโมงครับ",
  },
];

const graph = pageGraph(Astro, {
  name: h1Title,
  description: pageDescription,
  faqs,
});

const body = "text-left text-base leading-relaxed text-[#23323f]";
const brandMark = "font-bold text-[#a35000]";
const inlineLink = "font-bold text-[#006d99] underline underline-offset-4 transition-colors hover:text-[#a35000]";
const slideFrame = "mx-auto h-auto w-full max-w-md rounded-2xl border border-[#cfe9f4] shadow-[0_10px_30px_rgba(0,164,212,0.18)]";
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement message={announcementMessage} />

  <ContentBoxNeumorphism as="h1" title={h1Title}>
    <p class={body}>
      <strong class={brandMark}>MEEHAY569</strong> (มีเฮ) สล็อตเว็บตรง สร้างมาให้คนที่ไม่มีบัญชีธนาคาร มีทุนไม่มาก หรืออยากลองเกมก่อนจ่ายจริง เราให้บริการแบบไม่ผ่านเอเย่นต์ ฝากถอนทรูวอเลทด้วยระบบออโต้ เริ่มได้ที่ 1 บาท ตลอด 24 ชั่วโมง
    </p>
    <p class={`mt-4 ${body}`}>
      คุณ<a href="/ทดลองเล่น/" class={inlineLink}>ทดลองเล่นสล็อต</a>ได้โดยไม่ต้องฝากเงินหรือสมัครก่อน มีเกมจาก PG Soft, Pragmatic Play และ JILI ให้เลือก ส่วนใครอยากพักจากวงล้อก็มีบาคาร่า ไฮโล รูเล็ต และเสือมังกรรออยู่
    </p>
  </ContentBoxNeumorphism>

  <SmoothCarousel />

  <ContentBoxSpecial as="h2" title="MEEHAY569 สล็อตเว็บตรง ไม่ผ่านเอเย่นต์ คุยกับเราได้โดยตรง" iconleft="🤝" iconright="📱">
    <p slot="left" class={body}>
      คนกลางยิ่งน้อย เรื่องยิ่งง่าย! เคยเล่นผ่านตัวแทนแล้วพอมีปัญหาก็ไม่รู้ว่าต้องไปถามใคร ที่นี่คุณสมัครและเล่นกับเราโดยตรง ไม่ต้องผ่านเอเย่นต์ เวลาจะฝาก ถอน หรือสอบถามอะไรจึงมีปลายทางเดียว
    </p>
    <p slot="right" class={body}>
      การเข้าเล่นก็เลือกได้ตามถนัด เปิดผ่านหน้าเว็บบนมือถือได้ทุกระบบ หรือจะดาวน์โหลดแอปไว้ในเครื่องก็ได้ ถ้าอยู่หน้าคอมก็เล่นบนจอใหญ่ได้เหมือนกัน ส่วนสมาชิกเดิมกลับมาที่<a href="/ทางเข้า/" class={inlineLink}>ทางเข้า</a> <strong class={brandMark}>MEEHAY569</strong> แล้วล็อกอินด้วยยูสเดิมได้ทุกเครื่อง
    </p>
  </ContentBoxSpecial>

  <ContentBoxSevenThreeFloatingBadge as="h2" title="ฝากถอนทรูวอเลทกับ MEEHAY569 ออโต้ ไม่มีบัญชีธนาคารก็เริ่มเล่นได้">
    <Picture
      slot="left"
      src={imgDeposit}
      alt={depositAlt}
      loading="lazy"
      fetchpriority="low"
      widths={[280, 380, 480, 600]}
      sizes="(max-width: 543px) calc(100vw - 96px), (max-width: 767px) 448px, (max-width: 1311px) calc(30vw - 41px), 353px"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={70}
      class={slideFrame}
    />

    <div slot="right" class="flex flex-col gap-4">
      <p class={body}>
        ไม่มีบัญชีก็ไม่ใช่ปัญหา คุณใช้ทรูวอเลท (TrueMoney Wallet) ฝากถอนกับเราได้เลย โดยไม่ต้องมีบัญชีธนาคาร ระบบเป็นออโต้ คุณทำรายการเองได้ตลอด 24 ชั่วโมง ระบบปรับเครดิตให้เอง ไม่ต้องส่งสลิป
      </p>
      <p class={body}>
        ยอดเริ่มต้นอยู่ที่ 1 บาท คุณจึงเริ่มจากเงินก้อนเล็กเพื่อลองระบบก่อนได้ ถ้าโอนแล้วเครดิตยังไม่ขึ้น อย่าเพิ่งโอนซ้ำ ให้แจ้งเวลากับยอดผ่าน<a href="/contact-us/" class={inlineLink}>ช่องทางบนหน้าเว็บ</a> เราจะได้ตามจากรายการนั้นให้ตรงจุด
      </p>
    </div>
  </ContentBoxSevenThreeFloatingBadge>

  <LatestWinners2 />

  <ContentBoxTwoNeumorphism as="h2" title="ทดลองเล่นสล็อตก่อน แล้วค่อยเลือกสล็อตออนไลน์ที่เข้ามือคุณ">
    <div slot="left" class="flex flex-col gap-4">
      <p class={body}>
        ลองก่อนดีกว่าเดา ชื่อเกมบอกได้แค่ธีม แต่จังหวะข้างในต้องลองเอง <a href="/ทดลองเล่น/" class={inlineLink}>โหมดทดลองเล่นสล็อต</a>ของเราเปิดให้ลองได้โดยไม่ต้องฝากเงินหรือสมัครก่อน คุณจึงดูฟีเจอร์ของเกมได้ตามสบาย
      </p>
      <p class={body}>
        จะเริ่มจาก Wild Bandito ของ PG Soft ที่ใช้ระบบร่วงหล่น ตัวคูณเพิ่มทุกครั้งที่ชนะต่อเนื่องในสปินเดียว ก็ได้ หรือไปที่ Gates of Olympus ของ Pragmatic Play ที่จ่ายแบบไม่ต้องเรียงไลน์ มีลูกแก้วตัวคูณตกลงมาทบยอดชนะ ถ้าชอบเกมกระดานเล็ก Fortune Gems ของ JILI เป็นวงล้อ 3×3 ที่มีวงตัวคูณแยกอยู่ทางขวา
      </p>
    </div>
    <p slot="right" class={body}>
      วันไหนอยากเปลี่ยนจากการกดสปินมาลุ้นทีละตา เรามีบาคาร่า ไฮโล รูเล็ต และเสือมังกรอยู่ในเว็บเดียวกัน คุณจึงไม่ต้องไปหาที่อื่นเพิ่ม
    </p>
  </ContentBoxTwoNeumorphism>

  <ProviderGridPremium />

  <ContentBoxSevenThreeNeumorphism as="h2" title="มือใหม่หรือสายทุนน้อย เริ่มกับ MEEHAY569 ได้ใน 4 ขั้นตอน">
    <Picture
      slot="left"
      src={imgSignup}
      alt={signupAlt}
      loading="lazy"
      fetchpriority="low"
      widths={[280, 380, 480, 600]}
      sizes="(max-width: 543px) calc(100vw - 96px), (max-width: 767px) 448px, (max-width: 1431px) calc(30vw - 38px), 391px"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={70}
      class={slideFrame}
    />

    <div slot="right" class="flex flex-col gap-4">
      <p class={body}>
        ลองเกมก่อนได้ พร้อมเมื่อไหร่ค่อยสมัคร ถ้าคุณเพิ่งเริ่มเล่นสล็อตออนไลน์ โหมดทดลองช่วยให้เห็นหน้าตาเกมก่อนใช้เงินจริง ถ้าทุนไม่มาก ยอดเริ่มต้น 1 บาทก็ทำให้คุณไม่ต้องฝากเกินแผน
      </p>
      <p class={body}>
        พอพร้อมก็ไปต่อได้เลย <a href="/line/" class={inlineLink}>แอดไลน์</a>หรือ<a href="/register/" class={inlineLink}>กดปุ่มสมัคร</a>บนเว็บ กรอกเบอร์โทรศัพท์ ใส่ OTP ที่ได้รับ แล้วฝากเงินเข้าระบบ ส่วนเงื่อนไขสิทธิพิเศษดูได้ที่<a href="/promotion/" class={inlineLink}>หน้าโปรโมชั่น</a> ก่อนเริ่มลองตั้งงบที่เสียได้ไว้ก่อน เพราะสล็อตคือความบันเทิง ไม่ใช่ทางหารายได้
      </p>
    </div>
  </ContentBoxSevenThreeNeumorphism>

  <Faq4 title={faqTitle} faqs={faqs} />

  <ContentBox>
    <p class={body}>
      <strong class={brandMark}>MEEHAY569</strong> รวมสล็อตเว็บตรงไว้สำหรับคนที่ไม่อยากเริ่มด้วยขั้นตอนยุ่งยาก คุยกับเว็บโดยตรง <a href="/วิธีฝากถอน/" class={inlineLink}>เติมและถอนผ่านทรูวอเลท</a> ลองเกมก่อนเล่นจริง มือใหม่หรือคนทุนน้อยก็เริ่มได้โดยไม่ต้องรีบ ลองเกมที่สนใจก่อน แล้วค่อย<a href="/register/" class={inlineLink}>สมัคร</a>เมื่อพร้อมเล่นจริง
    </p>
  </ContentBox>

  <LoginRtpSection />

  <ReviewCardSumo />

  <Navfoot />
</MainLayout>
