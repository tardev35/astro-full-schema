---
import { Picture } from "astro:assets";

const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.*", { eager: true });
const imagePaths = Object.keys(images);
const targetPath = imagePaths.find((path) => path.endsWith(".webp")) || imagePaths.find((path) => path.endsWith(".png")) || (imagePaths.length > 0 ? imagePaths[0] : null);
const mainLogo = targetPath ? images[targetPath].default : null;

const currentPath = Astro.url.pathname;
const isActive = (path: string) => {
  if (path === "/") return currentPath === "/";
  return currentPath.startsWith(path);
};
---

<header class="sticky top-0 z-[100] w-full font-sans">
  <nav class="relative mx-auto flex h-[70px] w-full items-center justify-between bg-[#0a1128] shadow-lg xl:px-4">
    <a href="/" class="z-[110] flex h-full items-center px-4 transition-transform hover:scale-105">
      {
        mainLogo ? (
          <Picture src={mainLogo} alt="FINNBET Logo" loading="eager" class="h-[40px] w-auto xl:h-[45px]" formats={["avif", "webp"]} fallbackFormat="webp" />
        ) : (
          <h1 class="text-3xl font-black tracking-widest text-white">
            <span class="text-[#ffd60a]">FINN</span>BET
          </h1>
        )
      }
    </a>

    <div class="hidden h-full flex-1 items-center justify-center lg:flex">
      {
        [
          { name: "หน้าแรก", path: "/" },
          { name: "ตรวจหวย", path: "/ตรวจหวย" },
          { name: "แนวทางหวย", path: "/แนวทาง" },
          { name: "โปรโมชั่น", path: "/promotion" },
          { name: "ติดต่อเรา", path: "/contact-us" },
        ].map((item) => (
          <a
            href={item.path}
            class={`flex h-full items-center px-6 text-sm font-bold tracking-wide transition-colors ${isActive(item.path) ? "bg-[#ffd60a] text-[#0a1128]" : "text-white hover:text-[#ffd60a]"}`}>
            {item.name}
          </a>
        ))
      }
    </div>

    <div class="z-[110] flex items-center gap-3 pr-4">
      <a href="/login" class="hidden rounded-md bg-[#ffd60a] px-5 py-2 text-sm font-bold text-[#0a1128] transition-all hover:opacity-90 lg:flex">เข้าสู่ระบบ</a>
      <a href="/register" class="hidden rounded-md border border-white/20 bg-white/10 px-5 py-2 text-sm font-bold text-white transition-all hover:bg-white/20 lg:flex">สมัครสมาชิก</a>

      <button id="hamburger-btn" class="relative flex h-[40px] w-[40px] flex-col items-center justify-center gap-[5px] rounded-md border border-white/20 bg-transparent lg:hidden" aria-label="Menu">
        <span class="line-1 h-[2px] w-5 origin-center rounded-full bg-white transition-all duration-300"></span>
        <span class="line-2 h-[2px] w-5 origin-center rounded-full bg-white transition-all duration-300"></span>
        <span class="line-3 h-[2px] w-5 origin-center rounded-full bg-white transition-all duration-300"></span>
      </button>
    </div>
  </nav>

  <div
    id="mobile-menu"
    class="pointer-events-none absolute top-[70px] left-0 w-full origin-top -translate-y-4 scale-y-95 flex-col border-b border-[#0a1128] bg-[#0a1128] px-6 pt-4 pb-8 opacity-0 shadow-xl transition-all duration-300 lg:hidden">
    <div class="flex flex-col gap-1">
      {
        [
          { name: "หน้าแรก", path: "/" },
          { name: "ตรวจหวย", path: "/ตรวจหวย" },
          { name: "แนวทางหวย", path: "/แนวทาง" },
          { name: "โปรโมชั่น", path: "/promotion" },
          { name: "ติดต่อเรา", path: "/contact-us" },
        ].map((item) => (
          <a
            href={item.path}
            class={`flex items-center rounded-md px-4 py-3 text-base font-bold transition-colors ${isActive(item.path) ? "bg-[#ffd60a] text-[#0a1128]" : "text-white hover:bg-white/10"}`}>
            {item.name}
          </a>
        ))
      }
    </div>
    <div class="mt-6 flex flex-col gap-3">
      <a href="/register" class="flex w-full justify-center rounded-md bg-[#ffd60a] py-3 text-lg font-black text-[#0a1128] shadow-md">สมัครสมาชิก</a>
      <a href="/login" class="flex w-full justify-center rounded-md border border-white/30 bg-transparent py-3 text-lg font-bold text-white">เข้าสู่ระบบ</a>
    </div>
  </div>
</header>

<style is:global>
  nav,
  header {
    font-family: "Kanit", sans-serif !important;
  }
  #hamburger-btn.active .line-1 {
    transform: translateY(7px) rotate(45deg);
  }
  #hamburger-btn.active .line-2 {
    opacity: 0;
  }
  #hamburger-btn.active .line-3 {
    transform: translateY(-7px) rotate(-45deg);
  }
  #mobile-menu.show {
    opacity: 1;
    transform: translateY(0) scaleY(100%);
    pointer-events: auto;
  }
</style>

<script>
  const hamburgerBtn = document.getElementById("hamburger-btn");
  const mobileMenu = document.getElementById("mobile-menu");
  hamburgerBtn?.addEventListener("click", () => {
    hamburgerBtn.classList.toggle("active");
    mobileMenu?.classList.toggle("show");
  });
</script>
