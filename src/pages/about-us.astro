---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import { pageGraph } from "../lib/schema";

const pageTitle = "เกี่ยวกับ MEEHAY569 สล็อตเว็บตรง ไม่ผ่านเอเย่นต์ ฝากถอนทรูวอเลทออโต้";

const pageHeading = "เกี่ยวกับ MEEHAY569 สล็อตเว็บตรงที่เริ่มได้แม้ไม่มีบัญชีธนาคาร";

const pageDescription =
  "รู้จัก MEEHAY569 สล็อตเว็บตรงไม่ผ่านเอเย่นต์ ฝากถอนทรูวอเลทออโต้เริ่ม 1 บาท ไม่ต้องมีบัญชีธนาคาร ทดลองเล่นเกมจาก PG Soft, Pragmatic Play และ JILI ได้ก่อนสมัคร";

const announcementMessage =
  "MEEHAY569 สล็อตเว็บตรง ไม่ผ่านเอเย่นต์ • ฝากถอนทรูวอเลทออโต้ เริ่ม 1 บาท ตลอด 24 ชั่วโมง ไม่ต้องส่งสลิป • ทดลองเล่นสล็อตได้โดยไม่ต้องฝากเงินหรือสมัครก่อน • สมัครง่าย 4 ขั้นตอน เล่นได้ทั้งเว็บมือถือ แอป และคอม";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});

const bodyClass = "mb-4 text-left text-base leading-relaxed text-[#23323f]";
const closerClass = "text-left text-base leading-relaxed text-[#23323f]";
const brandClass = "font-bold text-[#a35000]";
const linkClass = "font-bold text-[#006d99] underline underline-offset-4 transition-colors hover:text-[#a35000]";
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement message={announcementMessage} />

  <ContentBox as="h1" title={pageHeading}>
    <p class={bodyClass}>
      <strong class={brandClass}>MEEHAY569</strong> เป็นสล็อตเว็บตรงที่ทำมาให้คนที่ไม่มีบัญชีธนาคาร คนที่มีทุนไม่มาก และคนที่อยากลองเกมก่อนจ่ายเงินจริง ทั้งสามกลุ่มเริ่มต้นได้โดยไม่ต้องผ่านขั้นตอนยุ่งยาก
    </p>

    <p class={bodyClass}>
      ฝากถอนใช้ทรูวอเลทแทนบัญชีธนาคาร ยอดเริ่มต้นอยู่ที่ 1 บาท โหมดทดลองเล่นเปิดให้ลองได้ก่อนสมัคร และทุกเรื่องคุยกับเว็บได้โดยตรง เพราะเราให้บริการแบบไม่ผ่านเอเย่นต์
    </p>

    <p class={closerClass}>เริ่มง่ายไม่ได้แปลว่าต้องรีบ</p>
  </ContentBox>

  <ContentBox as="h2" title="เล่นกับ MEEHAY569 โดยตรง ไม่มีเอเย่นต์คั่นกลาง">
    <p class={bodyClass}>
      ที่ <strong class={brandClass}>MEEHAY569</strong> คุณสมัครและเล่นกับเว็บโดยตรง ไม่ต้องผ่านตัวแทน เวลาจะฝาก ถอน หรือสอบถามเรื่องใด ข้อความจึงไปถึงปลายทางเดียว ไม่ต้องส่งต่อกันหลายทอด
    </p>

    <p class={bodyClass}>
      คนที่เคยเล่นผ่านเอเย่นต์มักเจอปัญหาเดียวกัน พอมีเรื่องติดขัดก็ไม่รู้ว่าต้องไปถามใคร ที่นี่ช่องทางบนหน้า <a href="/contact-us/" class={linkClass}>ติดต่อเรา</a> คือที่เดียวที่ต้องจำ
    </p>

    <p class={closerClass}>ถามที่ต้นทาง ก็ได้คำตอบจากต้นทาง</p>
  </ContentBox>

  <ContentBox as="h2" title="ฝากถอนทรูวอเลทออโต้ เริ่ม 1 บาท ไม่ต้องมีบัญชีธนาคาร">
    <p class={bodyClass}>
      การเงินของ <strong class={brandClass}>MEEHAY569</strong> ใช้ทรูวอเลท (TrueMoney Wallet) ทั้งขาฝากและขาถอน ด้วยระบบออโต้ที่คุณทำรายการเองได้ตลอด 24 ชั่วโมง คนที่ไม่มีบัญชีธนาคารจึงเริ่มเล่นได้เหมือนคนอื่น
    </p>

    <p class={bodyClass}>
      ระบบปรับเครดิตให้เองโดยไม่ต้องส่งสลิป ยอดเริ่มต้นอยู่ที่ 1 บาท จะลองระบบด้วยเงินก้อนเล็กก่อนก็ได้ ขั้นตอนแต่ละขาและสิ่งที่ต้องทำเมื่อเครดิตไม่ขึ้นอยู่ที่หน้า <a href="/วิธีฝากถอน/" class={linkClass}>วิธีฝากถอน</a>
    </p>

    <p class={closerClass}>เงินก้อนแรกไม่จำเป็นต้องเป็นก้อนใหญ่</p>
  </ContentBox>

  <ContentBox as="h2" title="ทดลองเล่นสล็อตจาก PG Soft, Pragmatic Play และ JILI ได้ก่อนสมัคร">
    <p class={bodyClass}>
      <a href="/ทดลองเล่น/" class={linkClass}>โหมดทดลองเล่นสล็อต</a>เปิดให้ลองได้โดยไม่ต้องฝากเงินหรือสมัครก่อน เกมมาจากสามค่าย คือ PG Soft, Pragmatic Play และ JILI แต่ละค่ายมีกลไกและจังหวะเกมของตัวเอง
    </p>

    <p class={bodyClass}>
      Wild Bandito ของ PG Soft ใช้ระบบร่วงหล่น ตัวคูณเพิ่มขึ้นทุกครั้งที่ชนะต่อเนื่องในสปินเดียว ส่วน Gates of Olympus ของ Pragmatic Play จ่ายแบบไม่ต้องเรียงไลน์ มีลูกแก้วตัวคูณตกลงมาทบยอดชนะ
    </p>

    <p class={bodyClass}>
      Fortune Gems ของ JILI เป็นวงล้อ 3×3 ที่มีวงตัวคูณแยกอยู่ทางขวา ส่วนวันที่อยากพักจากวงล้อ เว็บเดียวกันนี้มีบาคาร่า ไฮโล รูเล็ต และเสือมังกรให้ลุ้นกันทีละตา
    </p>

    <p class={closerClass}>ธีมดูได้จากหน้าปก กลไกรู้ได้ตอนกดหมุน</p>
  </ContentBox>

  <ContentBox as="h2" title="เข้าเล่น MEEHAY569 ได้ทั้งเว็บบนมือถือ แอป และคอม">
    <p class={bodyClass}>
      หน้าเว็บของ <strong class={brandClass}>MEEHAY569</strong> เปิดบนมือถือได้ทุกระบบ ใครอยากมีไว้ในเครื่องก็ดาวน์โหลดแอปได้ ส่วนคนที่นั่งอยู่หน้าคอมก็เล่นบนจอใหญ่ได้เหมือนกัน เลือกได้ตามที่ถนัด
    </p>

    <p class={bodyClass}>
      สมาชิกเดิมกลับมาที่ <a href="/ทางเข้า/" class={linkClass}>ทางเข้า MEEHAY569</a> แล้วล็อกอินด้วยยูสเดิมได้ทุกเครื่อง จะเปลี่ยนโทรศัพท์เครื่องใหม่หรือสลับไปเล่นบนคอมก็ไม่ต้องสมัครซ้ำ
    </p>

    <p class={closerClass}>เครื่องเปลี่ยนได้ ยูสยังเป็นของเดิม</p>
  </ContentBox>

  <ContentBox as="h2" title="สมัคร MEEHAY569 ใน 4 ขั้นตอน และตั้งงบไว้ก่อนเริ่มเล่น">
    <p class={bodyClass}>
      การสมัครมีสี่ขั้น แอดไลน์หรือกดปุ่ม<a href="/register/" class={linkClass}>สมัครสมาชิก</a>บนเว็บ กรอกเบอร์โทรศัพท์ ใส่ OTP ที่ได้รับ แล้วฝากเงินเข้าระบบ รหัส OTP กับรหัสผ่านเป็นของคุณคนเดียว ห้ามบอกใคร
    </p>

    <p class={bodyClass}>
      เงื่อนไขของสิทธิพิเศษแต่ละรายการดูได้ที่หน้า<a href="/promotion/" class={linkClass}>โปรโมชั่น</a> ส่วนถ้าโอนแล้วเครดิตยังไม่ขึ้น อย่าเพิ่งโอนซ้ำ ให้แจ้งเวลากับยอดผ่านช่องทางบนหน้าเว็บ ทีมงานจะได้ตามจากรายการนั้นให้ตรงจุด
    </p>

    <p class={closerClass}>สล็อตคือความบันเทิง ไม่ใช่ทางหารายได้ งบที่ตั้งไว้ก่อนกดสปินแรกจึงสำคัญกว่าเกมที่เลือก</p>
  </ContentBox>

  <Navfoot />
</MainLayout>
