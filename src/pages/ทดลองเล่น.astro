---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement4.astro";

import { Picture } from "astro:assets";
import { itemList, pageGraph, schemaCtx } from "../lib/schema";
import pgCover from "../assets/gamedemo11.webp";
import jiliCover from "../assets/gamedemo14.webp";
import popularCover from "../assets/gamedemo8.webp";
import newCover from "../assets/gamedemo16.webp";

const demoGames = [
  {
    name: "PG Soft",
    games: "Treasures of Aztec · Fortune Tiger",
    src: pgCover,
    alt: "แบนเนอร์ค่าย PG Pocket Games Soft โลโก้ตัวอักษรพิกเซลบนพื้นดำ คู่กับตัวละครหญิงนักรบผิวแทนสวมเครื่องประดับทองและหมวกขนนกสไตล์แอซเท็ก",
  },
  {
    name: "JILI",
    games: "Super Ace · Boxing King",
    src: jiliCover,
    alt: "แบนเนอร์ค่ายเกม JILI ตัวอักษรทองบนพื้นดำ คู่กับนางเงือกผมแดงสวมเกราะเปลือกหอยสีทอง ยกหอยสังข์แนบหูอยู่ใต้ทะเลที่มีปลาการ์ตูนและปะการัง",
  },
  {
    name: "เกมยอดนิยม",
    games: "เกมที่คนเปิดเล่นบ่อยจากทุกค่าย",
    src: popularCover,
    alt: "แบนเนอร์ Popular Game ตัวอักษรทองนูนหน้าวงแหวนชิปคาสิโนสีทอง ขนาบด้วยกระต่ายถือหีบสมบัติกับแมวใส่แว่นกันแดด ท่ามกลางเหรียญทองและชิปที่ลอยฟุ้ง",
  },
  {
    name: "เกมใหม่",
    games: "เกมที่เพิ่งเข้าจากค่ายในเว็บ",
    src: newCover,
    alt: "แบนเนอร์ New Game ตัวอักษรสีขาวนูนกลางภาพ ขนาบด้วยตัวการ์ตูนฟักทองหัวไฟกับโครงกระดูกยิ้ม ยืนบนฟลอร์นีออนสีชมพูฟ้าที่เกลื่อนด้วยชิปและลูกเต๋า",
  },
];

const gameList = demoGames.map((game) => ({ name: game.name, imagePath: game.src.src }));

const pageTitle = "ทดลองเล่นสล็อต BABYSHARK8899 ลอง PG Soft Pragmatic Play และ JILI ก่อนเล่นจริง";

const pageHeading = "ทดลองเล่นสล็อต BABYSHARK8899 หมุนลองให้คุ้นมือก่อนใช้เครดิตจริง";

const pageDescription =
  "ทดลองเล่นสล็อต BABYSHARK8899 สมัครยูสเดียวแล้วเข้าโหมดทดลองของ PG Soft, Pragmatic Play และ JILI บนมือถือ ดูจังหวะฟรีสปินและตัวคูณให้คุ้นมือก่อนใช้เครดิตจริง";

const linkClass = "font-bold text-[#4da3ff] underline underline-offset-4 transition-colors hover:text-[#ff5a60]";

const ctx = schemaCtx(Astro);
const graph = pageGraph(Astro, {
  type: "CollectionPage",
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  ],
  extra: [
    itemList(ctx, {
      name: "ทดลองเล่นเกมสล็อตของ BABYSHARK8899",
      alternateName: "BABYSHARK8899 โหมดทดลองเล่นสล็อตหลายค่ายบนมือถือ ก่อนใช้เครดิตจริงด้วยยูสเดียว",
      itemType: "Game",
      items: gameList,
    }),
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox as="h1" title={pageHeading}>
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed">
        หากกำลังมองหาที่หมุนสล็อตให้คุ้นมือก่อนลงเครดิตจริง <strong class="text-[#4da3ff]">BABYSHARK8899</strong> พร้อมพาเราเข้าโหมดทดลองของ PG Soft, Pragmatic Play และ JILI เพื่อให้รู้จังหวะฟรีสปินและตัวคูณก่อนตัดสินใจ
      </p>
      <p class="text-left text-base leading-relaxed">
        กดที่ภาพค่ายด้านล่างจะไปหน้าสมัครสมาชิกก่อน สมัครครั้งเดียวได้ยูสไว้เข้าโหมดทดลองจากหน้าสมาชิกได้เลย ไม่ต้องเปิดยูสแยกทีละค่าย
      </p>
      <p class="text-left text-base leading-relaxed">
        ทุกขั้นเปิดผ่านเบราว์เซอร์บนมือถือได้ทันที ทั้ง iOS และ Android ไม่ต้องโหลดแอป จะลองตอนพักเที่ยงหรือก่อนนอนก็จบในเครื่องเดียว
      </p>
    </div>
  </ContentBox>

  <ContentBox as="h2" title="เลือกค่ายที่ชอบ สมัคร BABYSHARK8899 ยูสเดียว แล้วสลับลองได้ทุกค่ายในเว็บเดียว">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed">
        ที่นี่แยกสล็อตตามค่าย และแต่ละค่ายมีกลไกของตัวเอง Treasures of Aztec ของ PG Soft เป็นเกมร่วงหล่นที่ตัวคูณเพิ่มเมื่อชนะต่อเนื่อง ส่วน Fortune Tiger วงล้อ 3×3 ไม่มีฟรีสปินแต่มีสุ่มหมุนซ้ำ
      </p>
      <p class="text-left text-base leading-relaxed">
        ฝั่ง Pragmatic Play มี Starlight Princess ที่ตัวคูณสุ่มออกในเกมหลัก กับ The Dog House ที่ไวลด์ค้างจนจบฟรีสปิน ส่วน JILI มี Super Ace ธีมไพ่ และ Boxing King ที่ไวลด์ขยายเต็มแถว
      </p>
      <p class="text-left text-base leading-relaxed">
        ปุ่มบนภาพเขียนว่าสมัครเพื่อลอง เพราะจะพาไปหน้า <a href="/register/" class={linkClass}>สมัครสมาชิก</a> ก่อน สมัครครั้งเดียวใช้ได้ทุกค่ายที่นี่ เบื่อค่ายหนึ่งก็สลับไปอีกค่ายได้โดยไม่ต้องเปิดยูสใหม่
      </p>
      <div class="mt-4 mb-5 grid grid-cols-2 gap-5 md:grid-cols-4">
        {
          demoGames.map((game) => (
            <div class="group/game relative mx-auto w-full max-w-[400px] overflow-hidden rounded-xl border border-[#1a4a9c] bg-[#0a2a66] shadow-[0_10px_30px_rgba(0,0,0,0.35)] transition-colors duration-300 hover:border-[#2f7bff]">
              <Picture
                src={game.src}
                alt={game.alt}
                loading="lazy"
                fetchpriority="low"
                widths={[200, 400, 600]}
                sizes="(max-width: 768px) 50vw, 25vw"
                class="block h-auto w-full object-cover transition-transform duration-300 group-hover/game:scale-105"
                decoding="async"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
                quality={60}
              />
              <div class="px-3 py-2 text-center">
                <p class="text-sm font-bold text-white">{game.name}</p>
                <p class="text-xs text-[#9fb8dc]">{game.games}</p>
              </div>
              <a
                href="/register/"
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`สมัครสมาชิก BABYSHARK8899 เพื่อลองเล่น ${game.name}`}
                class="absolute inset-0 flex items-center justify-center bg-[#010d28]/80 opacity-0 transition-opacity duration-300 group-hover/game:opacity-100 focus-visible:opacity-100">
                <span class="rounded-xl bg-gradient-to-b from-[#4da3ff] to-[#0554b8] px-6 py-2 font-bold text-white shadow-[0_10px_30px_rgba(11,124,244,0.35)] transition-transform hover:scale-110 hover:brightness-110">สมัครเพื่อลอง</span>
              </a>
            </div>
          ))
        }
      </div>
    </div>
  </ContentBox>

  <ContentBox as="h2" title="ทดลองเล่นสล็อตฟรี หมุนลองให้พอใจก่อนใช้เครดิตจริง">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed">
        โหมดทดลองใช้เครดิตสมมติทั้งหมด หมุนลองกี่รอบก็ได้ตามสบาย ไม่มีใครเร่ง และไม่ต้องฝากก่อนจนกว่าเราจะพร้อมเล่นจริง
      </p>
      <p class="text-left text-base leading-relaxed">
        ระหว่างหมุนลองสังเกตว่าเบทต่ำสุดต่อรอบเท่าไร รอบฟรีสปินเข้าแบบไหน ตัวคูณทำงานตอนไหน แล้วคัดไว้สองสามเกมที่ตรงกับทุนของตัวเองตั้งแต่ยังไม่ลงเครดิตจริง
      </p>
      <p class="text-left text-base leading-relaxed">
        หน้าเกมและกติกาตอนทดลองเป็นชุดเดียวกับตอนเล่นจริง ต่างกันแค่เครดิตที่ใช้หมุน จังหวะที่จับได้วันนี้จึงพกไปใช้ได้ทันทีเมื่อถึงรอบเล่นจริง
      </p>
      <p class="text-left text-base leading-relaxed">
        โหมดทดลองที่นี่เปิดไว้ฝั่งสล็อต ส่วนคาสิโนสด ยิงปลา และหวยเล่นด้วยเครดิตจริงจากยูสเดียวกัน จะข้ามไปหมวดไหนก็ไม่ต้องสมัครเพิ่ม
      </p>
      <p class="text-left text-base leading-relaxed">
        เรื่องที่ขอบอกให้ชัดตั้งแต่ต้น เครดิตในโหมดทดลองถอนออกมาไม่ได้ และไม่นับเป็นยอดเทิร์นของโปรโมชั่นใดทั้งสิ้น มีไว้ให้ทำความรู้จักเกมอย่างเดียว
      </p>
      <p class="text-left text-base leading-relaxed">
        อีกข้อคือไม่ใช่ทุกเกมที่มีปุ่มทดลอง ขึ้นอยู่กับค่ายผู้พัฒนาแต่ละราย ถ้าเกมที่หมายตาไว้ยังไม่เปิดให้ลอง <a href="/contact-us/" class={linkClass}>ทักแอดมิน</a> ให้ช่วยแนะนำเกมแนวใกล้เคียงได้เลย
      </p>
    </div>
  </ContentBox>

  <ContentBox as="h2" title="พร้อมเมื่อไหร่ สมัครสมาชิก BABYSHARK8899 แล้วเริ่มเล่นจริงได้ทันที">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed">
        เมื่อเจอเกมที่ถูกใจ เริ่มเล่นจริงได้เลยด้วยยูสเดิม ไม่ต้องสมัครซ้ำ ตั้งงบของวันนั้นไว้ก่อนเปิดเกม แล้วเริ่มจากเบทเล็กเพื่อจับจังหวะ ทุนจะอยู่ได้นานกว่า
      </p>
      <p class="text-left text-base leading-relaxed">
        สมัคร ฝาก เล่น และถอนจบในมือถือเครื่องเดียว ถ้าโอนแล้วเครดิตยังไม่เข้า อย่าเพิ่งโอนซ้ำ แจ้งแอดมินพร้อมเวลาและยอด ขั้นตอนเต็มอยู่ที่หน้า <a href="/วิธีฝากถอน/" class={linkClass}>วิธีฝากถอน</a>
      </p>
      <p class="text-left text-base leading-relaxed">
        โปรโมชั่นแต่ละตัวมีเงื่อนไขเทิร์นของตัวเอง เปิด <a href="/promotion/" class={linkClass}>หน้าโปรโมชั่น</a> ดูบนภาพก่อนรับว่าต้องทำเทิร์นกี่เท่าและถอนได้สูงสุดเท่าไร จะได้วางแผนตั้งแต่ก่อนฝาก
      </p>
      <p class="text-left text-base leading-relaxed">
        อีกเรื่องที่ควรติดตัวไว้เสมอ รหัสผ่านกับ OTP ไม่ส่งให้ใครทั้งสิ้น แม้คนนั้นจะอ้างว่าเป็นทีมงานก็ตาม และก่อนกรอกรหัสทุกครั้งมองชื่อเว็บบนแถบที่อยู่ให้แน่ใจว่าตรง
      </p>
      <p class="text-left text-base leading-relaxed">
        เลือกค่ายที่ถูกใจแล้วเริ่มได้เลย เกมที่ลองจนคุ้นมือวันนี้ คือเกมที่เรารู้จังหวะและกติกาดีแล้วเมื่อถึงรอบเล่นจริง เพื่อการเล่นที่มั่นใจและต่อเนื่องกว่าที่เคย
      </p>
      <div class="flex flex-col items-center justify-center gap-4 pt-2 sm:flex-row">
        <a
          href="/register/"
          class="inline-flex w-full max-w-[320px] items-center justify-center gap-2 rounded-xl bg-gradient-to-b from-[#4da3ff] to-[#0554b8] px-8 py-3.5 text-lg font-black tracking-wide text-white shadow-[0_10px_30px_rgba(11,124,244,0.35)] transition duration-300 hover:scale-105 hover:brightness-110">
          <span aria-hidden="true">🎰</span> สมัครสมาชิก BABYSHARK8899
        </a>

        <a
          href="/login/"
          class="inline-flex w-full max-w-[320px] items-center justify-center gap-2 rounded-xl bg-gradient-to-b from-[#ff5a60] to-[#b0121a] px-8 py-3.5 text-lg font-bold tracking-wide text-white shadow-[0_10px_30px_rgba(232,32,42,0.35)] transition duration-300 hover:scale-105 hover:brightness-110">
          เข้าสู่ระบบ
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
