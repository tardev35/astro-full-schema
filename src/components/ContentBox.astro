---
//
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
---

<section class="my-4 flex w-full justify-center px-4 font-sans">
  <div
    class="w-full max-w-7xl rounded-[20px] border-2 border-emerald-900/50 bg-[#050c0a]/90 p-8 text-center text-white/90 shadow-[0_0_20px_rgba(16,185,129,0.1),inset_0_0_15px_rgba(16,185,129,0.05)] backdrop-blur-sm transition-all duration-300 hover:border-emerald-500/50 hover:shadow-[0_0_30px_rgba(16,185,129,0.2)]">
    {
      title && (
        <header class="mb-8">
          <HeadingTag class="bg-gradient-to-b from-[#a7f3d0] to-[#10b981] bg-clip-text text-3xl font-black tracking-tight text-transparent drop-shadow-[0_0_8px_rgba(16,185,129,0.4)] md:text-4xl">
            {title}
          </HeadingTag>
        </header>
      )
    }

    <div class="text-lg leading-relaxed text-white/80">
      <slot />
    </div>
  </div>
</section>

<style>
  .font-sans {
    font-family: "Kanit", sans-serif;
  }
</style>
