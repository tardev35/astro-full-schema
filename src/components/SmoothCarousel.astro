---
import { Picture } from "astro:assets";

import slide3 from "../assets/slide3.png";
import slide4 from "../assets/slide4.png";

const images = [
  {
    src: slide3,
    alt: "ภาพโปรโมชั่น 888NEO พื้นหลังโทนดำทองมีชิปคาสิโนและเหรียญทอง ด้านบนเป็นโลโก้ 888NEO และข้อความว่า สมัครง่าย เล่นผ่านมือถือ ตรงกลางเป็นตัวอักษรขนาดใหญ่ว่า เว็บสล็อต คาสิโนสด ถัดลงมาเขียนว่า ระบบออโต้ ฝากถอนสะดวก ใต้ลงมาเป็นป้ายสามช่องเขียนว่า รวมเกมสล็อต, คาสิโนสด และ เข้าเล่นง่าย 24 ชม. ด้านล่างเป็นโลโก้ 888NEO อีกครั้งคู่กับปุ่มสีแดงเขียนว่า สมัครสมาชิก",
  },
  {
    src: slide4,
    alt: "ภาพโปรโมชั่น 888NEO พื้นหลังโทนดำทองมีไหทองคำและเหรียญทองกองอยู่ ด้านบนเป็นตัวอักษรว่า 888NEO สล็อตเกมฮิต ถัดลงมาเขียนว่า คาสิโนสด ระบบออโต้ เล่นผ่านมือถือ ตรงกลางเป็นภาพโทรศัพท์ที่เปิดวงล้อสล็อตพร้อมข้อความว่า WIN 8,888.00 รอบข้างเป็นป้ายเขียนว่า เริ่มต้น 1 บาท, ฝากถอนเร็ว 24 ชม. และ สมัครง่าย เล่นได้ทันที",
  },
];

const COPIES = 3;
const slides = Array.from({ length: COPIES }, () => images).flat();
---

<div class="marquee mx-auto w-full max-w-7xl overflow-hidden px-4 py-5">
  <input id="carousel-pause" type="checkbox" class="peer sr-only" />
  <label
    for="carousel-pause"
    class="sr-only cursor-pointer peer-focus-visible:not-sr-only peer-focus-visible:mb-3 peer-focus-visible:inline-block peer-focus-visible:rounded-full peer-focus-visible:border peer-focus-visible:border-[#f5c542]/60 peer-focus-visible:px-4 peer-focus-visible:py-2 peer-focus-visible:text-sm peer-focus-visible:font-bold peer-focus-visible:text-[#ffe9a8]">
    หยุด / เล่นสไลด์ภาพ
  </label>

  <div class="marquee-track flex">
    {
      slides.map((slide, index) => {
        const isDuplicate = index >= images.length;
        return (
          <div class="marquee-slide" aria-hidden={isDuplicate ? "true" : undefined}>
            <Picture
              src={slide.src}
              alt={isDuplicate ? "" : slide.alt}
              class="block w-full rounded-xl border border-[#f5c542]/40 object-cover shadow-[0_10px_30px_rgba(224,27,27,0.30)]"
              width={slide.src.width}
              height={slide.src.height}
              loading="lazy"
              fetchpriority="low"
              decoding="async"
              widths={[300, 360, 420, 480, 540, 600]}
              sizes="(max-width: 767px) calc(100vw - 32px), (max-width: 1279px) calc((100vw - 48px) / 2), 403px"
              formats={["avif", "webp"]}
              fallbackFormat="webp"
              quality={60}
            />
          </div>
        );
      })
    }
  </div>
</div>

<style>
  .marquee {
    --gap: 12px;
    --per-view: 1;
    --shift: calc(-200% - 24px);
  }

  @media (min-width: 768px) {
    .marquee {
      --gap: 16px;
      --per-view: 2;
      --shift: calc(-100% - 16px);
    }
  }

  @media (min-width: 1280px) {
    .marquee {
      --gap: 20px;
      --per-view: 3;
      --shift: calc(-66.6667% - 13.3333px);
    }
  }

  .marquee-track {
    gap: var(--gap);
    width: 100%;
    animation: carousel-scroll 24s linear infinite;
    will-change: transform;
  }

  .marquee-slide {
    flex: 0 0 calc((100% - (var(--per-view) - 1) * var(--gap)) / var(--per-view));
  }

  @keyframes carousel-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(var(--shift));
    }
  }

  .marquee:hover .marquee-track,
  .marquee:focus-within .marquee-track,
  .marquee > input:checked ~ .marquee-track {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
    }
  }
</style>
