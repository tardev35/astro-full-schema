---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import CtaRedirect from "../components/CtaRedirect.astro";
import { pageGraph } from "../lib/schema";

const pageDescription =
  "สมัครสมาชิก VING999 เปิดยูสใหม่ผ่านมือถือจบในไม่กี่นาที กดปุ่มเดียวไปยังหน้าสมัคร แล้วใช้ยูสเดียวเล่นสล็อตออนไลน์เว็บตรงหลายค่าย ฝากขั้นต่ำ 1 บาท ฝากถอนออโต้";

const graph = pageGraph(Astro, {
  name: "สมัครสมาชิก VING999 สล็อตออนไลน์เว็บตรง ฝากขั้นต่ำ 1 บาท",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "สมัครสมาชิก", path: "/register" },
  ],
});

const targetUrl = "https://yoalink.com/22hs";
---

<MainLayout title="สมัครสมาชิก VING999 | ปุ่มเปิดยูสใหม่ผ่านมือถือ สล็อตเว็บตรง" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="สมัครสมาชิก VING999" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label="สมัครสมาชิก VING999"
        class="group relative mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#7d8b95]/60 bg-gradient-to-b from-[#f2f5f7] to-[#bdcad2] px-6 py-4 text-xl font-bold tracking-wide text-[#0a0506] shadow-[0_10px_30px_rgba(189,202,210,0.20)] transition-all duration-300 hover:scale-105 hover:border-[#e01b2d]/70 hover:shadow-[0_15px_40px_rgba(224,27,45,0.28)]">
        สมัครสมาชิก VING999
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="สมัครสมาชิก" />
</MainLayout>
