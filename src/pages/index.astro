---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "./components/ContentBox.astro";
import ContentBoxTwo from "./components/ContentBoxTwo.astro";
import ContentBoxSevenThree from "./components/ContentBoxSevenThree.astro";
import ContentBoxThreeColums from "./components/ContentBox3Three.astro";
import Navfoot from "./components/Navfoot.astro";
import Footer from "./components/Footer.astro";
import Announcement from "./components/Announcement.astro";
import SmoothCarousel from "./components/SmoothCarousel.astro";

import { Picture } from "astro:assets"; // ใช้ Picture component จาก Astro เพื่อจัดการรูปภาพ
import image1 from "../assets/BETFLIK4Ubn600-2.jpg";
import image2 from "../assets/BETFLIK4Ubn600-3.jpg";
import image3 from "../assets/BETFLIK4Ubn6001.jpg";

const currentPath = Astro.url.pathname;
const homePage = Astro.url.origin;
const logoUrl = homePage + "/betflik4u-logo.webp";

const webPageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: "BETFLIK4U คาสิโนเว็บตรง อันดับ 1 ทางเข้า เกมAPIแท้ แตกง่าย 2026",
  description: "BETFLIK4U คาสิโนเว็บตรง อันดับ 1 ทางเข้า ล่าสุด 2026  เข้าเล่นบนหน้าเว็บและมือถือ ที่เสถียร เว็บสล็อตพรีเมียม เกมAPIแท้ แตกง่าย ระบบอัตโนมัติ ไม่มีขั้นต่ำ",
  url: currentPath,
};

const orgSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "BETFLIK4U",
  logo: logoUrl,
  url: homePage,
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: "BETFLIK4U เป็นเว็บตรงจริงไหม?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "BETFLIK4U เป็นคาสิโนเว็บตรง อันดับ 1 หรือ 'เว็บแม่' ที่บริหารงานเอง 100% ไม่ผ่านเอเย่นต์ ทำให้มีความมั่นคงทางการเงินสูงและไม่มีการปรับลดอัตราชนะของผู้เล่น เป็นบริการสล็อตออโต้ที่เร็วแรงที่สุด ให้บริการฝากถอนตรง มั่นคง และเฉียบคม",
      },
    },
    {
      "@type": "Question",
      name: "BETFLIK4U เป็นเว็บตรงจริงไหม?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "BETFLIK4U เป็นคาสิโนเว็บตรง อันดับ 1 หรือ 'เว็บแม่' ที่บริหารงานเอง 100% ไม่ผ่านเอเย่นต์ ทำให้มีความมั่นคงทางการเงินสูงและไม่มีการปรับลดอัตราชนะของผู้เล่น เป็นบริการสล็อตออโต้ที่เร็วแรงที่สุด ให้บริการฝากถอนตรง มั่นคง และเฉียบคม",
      },
    },
    {
      "@type": "Question",
      name: "ระบบฝาก-ถอน ของ BETFLIK4U รวดเร็วแค่ไหน?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "เราใช้ระบบอัตโนมัติที่นำ AI เข้ามาช่วยประมวลผล ทำให้การฝาก-ถอนเงินรวดเร็วภายใน 3 วินาที รองรับทั้งบัญชีธนาคารและ True Money Wallet",
      },
    },
    {
      "@type": "Question",
      name: "มีขั้นต่ำในการฝากเงินหรือไม่?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "BETFLIK4U ไม่มีขั้นต่ำในการฝากเงิน เริ่มต้นเพียง 1 บาทก็สามารถเข้าร่วมสนุกกับเกม API แท้จากค่ายดังระดับโลกได้ทันที",
      },
    },
  ],
};

const allSchemas = [webPageSchema, orgSchema, faqSchema];
---

<MainLayout>
  <script type="application/ld+json" set:html={JSON.stringify(allSchemas)} />
  <Announcement />

  <ContentBox>
    <p class="text-gray-200">
      <h1 class="mb-2 text-4xl text-white">BETFLIK4U คาสิโนเว็บตรง อันดับ 1 ทางเข้า เกมAPIแท้ แตกง่าย 2026</h1>
      <strong class="text-green-500">BETFLIK4U คาสิโนเว็บตรง อันดับ 1</strong> ที่สมบูรณ์แบบที่สุดในปี 2026 เราไม่ใช่แค่ผู้ให้บริการหน้าใหม่ แต่เราคือ "เว็บตรง" ที่สั่งสมประสบการณ์ผ่านการให้บริการมานาน
      ครองใจนักเดิมพันจากรากฐานที่มั่นคงมาตลอดหลายปี เกม API แท้ ส่งตรงจากค่ายเกมระดับโลก มั่นใจได้ว่าทุกการสปินคือโอกาสทำโบนัสที่ แตกง่าย หยุดเสี่ยงกับเว็บเอเย่นต์ที่ไม่ได้มาตรฐาน แล้วเริ่มต้นก้าวสำคัญไปกับ
      ทางเข้า BETFLIK4U ล่าสุดที่เสถียรที่สุดและพร้อมมอบประสบการณ์ระดับพรีเมียมให้คุณทุกวัน
    </p>

    <div class="mt-3.5 flex flex-wrap justify-center gap-4">
      <a
        href="/signup"
        aria-label="สมัครสมาชิก"
        class="to-red to-red to-red flex items-center justify-center rounded-lg border border-gray-400 bg-gradient-to-b from-red-900 to-red-700 px-8 py-3 font-bold text-white transition-transform hover:scale-105">
        สมัครสมาชิก
      </a>

      <a
        href="/signup"
        aria-label="เข้าเล่นเกม"
        class="flex items-center justify-center rounded-lg border border-yellow-600 bg-gradient-to-b from-yellow-200 to-yellow-500 px-8 py-3 font-extrabold text-black shadow-[0_0_15px_rgba(255,215,0,0.4)] transition-transform hover:scale-105">
        เข้าเล่นเกม
      </a>

      <a
        href="/line"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="ติดต่อเราผ่าน Line"
        class="flex items-center justify-center rounded-lg border border-green-300 bg-gradient-to-b from-green-400 to-green-700 px-8 py-3 font-bold text-white transition-transform hover:scale-105">
        ติดต่อเรา
      </a>
    </div>
  </ContentBox>

  <SmoothCarousel />

  <ContentBox>
    <h2 class="mb-4 text-2xl font-bold">ทำไม BETFLIK4U ถึงเป็น คาสิโนเว็บตรง อันดับ 1 ที่น่าเชื่อถือที่สุด</h2>
    <p>
      เหตุผลที่ทำให้ <strong>BETFLIK4U</strong> ได้รับความไว้วางใจจนขึ้นแท่น <strong>คาสิโนเว็บตรง อันดับ 1</strong> คือสถานะความเป็น "เว็บแม่" ที่บริหารงานเอง 100% โดยไม่ผ่านเอเย่นต์ ไม่ผ่านตัวแทนหรือคนกลางใดๆ
      สิ่งนี้ทำให้เราสามารถรักษามาตรฐานความปลอดภัยและความมั่นคงทางการเงินไว้ได้อย่างเหนียวแน่น จุดเด่นที่ต่างจากเว็บทั่วไปคือระบบหลังบ้านที่เชื่อมต่อตรงกับค่ายเกมระดับโลก ทำให้เราไม่มีความจำเป็นและไม่สามารถ
      "ปรับลดอัตราชนะ" ของผู้เล่นได้เลย ชนะเท่าไหร่ ถอนได้เท่านั้น เราจ่ายจริงทุกยอดด้วยระบบอัตโนมัติที่แม่นยำ เพื่อให้ทุกการเดิมพันของคุณจบลงที่ผลกำไรที่จับต้องได้จริงและความสบายใจสูงสุด
    </p>
  </ContentBox>

  <ContentBoxTwo>
    <div slot="left">
      <h2 class="mb-7 text-2xl font-semibold text-amber-500">ทางเข้า BETFLIK4U ล่าสุด 2026 รองรับทุกระบบ เข้าเล่นได้ทุกที่</h2>
      <p>
        ความลื่นไหลในการเข้าถึงคือสิ่งที่เราให้ความสำคัญสูงสุด <strong>ทางเข้า BETFLIK4U</strong> ล่าสุด ประจำปี 2026 จึงถูกออกแบบมาให้มีการอัปเดตลิงก์สม่ำเสมอโดยทีมงานผู้เชี่ยวชาญ เพื่อป้องกันปัญหาลิงก์เสียหรือการถูกปิดกั้น
        คุณสามารถเข้าเล่นผ่านเว็บเบราว์เซอร์ได้ทันทีโดยไม่ต้องเสียเวลาดาวน์โหลดแอปพลิเคชันให้ยุ่งยากหรือหนักเครื่อง ระบบของเราถูกพัฒนาด้วยเทคโนโลยี HTML5 ที่รองรับการใช้งานผ่านมือถือทุกรุ่นและคอมพิวเตอร์ทุกสเปก
        ทำให้คุณสามารถสนุกไปกับเกมเดิมพันที่ชื่นชอบได้ทุกที่ทุกเวลาอย่างไม่มีสะดุด
      </p>
    </div>

    <div slot="right">
      <h2 class="mb-7 text-2xl font-semibold text-amber-500">เจาะลึกความล้ำสมัยของ เกมAPIแท้ แตกง่าย ไม่มีการปรับอัตราชนะ</h2>
      <p>
        <strong>เกม API แท้</strong> ของ <strong>BETFLIK4U</strong> เป็นลิขสิทธิ์สัญญาณตรงมาจากค่ายเกมชั้นนำระดับโลก ระบบนี้ช่วยยืนยันว่าตัวเกมจะไม่มีการดัดแปลงผลลัพธ์หรือ "ล็อกยูสเซอร์" แต่อย่างใด ทุกการเดิมพันของคุณจะเป็นไปตามค่า
        RTP (Return to Player) มาตรฐานสากล ทำให้เกมมีโอกาสโบนัส แตกง่าย และจ่ายรางวัลตามจริง อัลกอริทึมที่มีความเที่ยงธรรมนี้ช่วยให้นักเดิมพันมีโอกาสคว้าแจ็คพอตใหญ่ได้ในทุกครั้งที่กดสปิน ไม่ว่าจะเล่นโหมดปกติหรือซื้อฟรีสปินก็ตาม
      </p>
    </div>
  </ContentBoxTwo>

  <ContentBoxSevenThree>
    <div slot="left">
      <h2 class="mb-7 text-2xl font-semibold">ระบบ ฝาก-ถอน อัตโนมัติ รวดเร็ว รองรับวอเลท (Wallet) ไม่มีขั้นต่ำ</h2>
      <p class="mb-5">
        <strong>BETFLIK4U</strong> มาพร้อมระบบฝาก-ถอน อัตโนมัติที่นำ AI เข้ามาช่วยประมวลผล ทำให้เงินเข้าบัญชีไวภายในเวลาเพียง 3 วินาที คุณสามารถทำรายการได้เองแบบ 24 ชั่วโมง ที่นี่มี ไม่มีขั้นต่ำ เริ่มต้นเพียง
        1 บาทก็ร่วมสนุกได้ทันที พร้อมรองรับทุกธนาคารชั้นนำในไทยและ <strong>True Money Wallet</strong> ตอบโจทย์นักเดิมพันยุคใหม่ที่ต้องการความคล่องตัวและระบบที่เชื่อถือได้จริง
      </p>
      <h2 class="mb-7 text-2xl font-semibold text-amber-500"></h2>
      รีวิว BETFLIK4U เว็บสล็อตพรีเมียม เข้าเล่นบนหน้าเว็บและมือถือ เสถียรที่สุด
      <p>
        จากการใช้งานจริงของผู้เล่นทั่วประเทศ ต่างพูดเป็นเสียงเดียวกันว่า BETFLIK4U คือสัญลักษณ์ของความพรีเมียม หน้าเว็บไซต์ถูกออกแบบมาให้มีความสวยงาม ทันสมัย และใช้งานง่ายมาก (User-Friendly)
        ความเสถียรของระบบถือเป็นจุดเด่นอันดับต้นๆ ที่ทำให้เราได้รับคำชมอย่างต่อเนื่อง เกมไม่ค้าง ไม่หลุดขณะเข้าสู่ช่วงสำคัญ ช่วยให้ทุกนาทีการเดิมพันของคุณมีค่า
      </p>
    </div>

    <div slot="right">
      <div class="rounded-xl bg-white/10 p-5">
        <Picture
          src={image1}
          alt="ทางเข้า BETFLIK4U"
          loading="lazy"
          fetchpriority="low"
          widths={[200, 400, 600]}
          sizes="(max-width: 768px) 100vw, 33vw"
          class="mx-auto h-auto w-full max-w-[400px] object-contain shadow-xl"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
          fallbackFormat="webp"
        />
      </div>
    </div>
  </ContentBoxSevenThree>

  <ContentBoxThreeColums>
    <div slot="left">
      <div class="p-5">
        <Picture
          src={image1}
          alt="BETFLIK4U คาสิโนเว็บตรง"
          loading="lazy"
          fetchpriority="low"
          widths={[200, 400, 600]}
          sizes="(max-width: 768px) 100vw, 33vw"
          class="mx-auto h-auto w-full max-w-[700px] object-contain shadow-xl"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={60}
        />
      </div>
    </div>

    <div slot="center">
      <div class="p-5">
        <Picture
          src={image2}
          alt="BETFLIK4U 2026"
          loading="lazy"
          fetchpriority="low"
          widths={[200, 400, 600]}
          sizes="(max-width: 768px) 100vw, 33vw"
          class="mx-auto h-auto w-full max-w-[700px] object-contain shadow-xl"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={60}
        />
      </div>
    </div>

    <div slot="right">
      <div class="p-5">
        <Picture
          src={image3}
          alt="เกมAPIแท้"
          loading="lazy"
          fetchpriority="low"
          widths={[200, 400, 600]}
          sizes="(max-width: 768px) 100vw, 33vw"
          class="mx-auto h-auto w-full max-w-[700px] object-contain shadow-xl"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={60}
        />
      </div>
    </div>
  </ContentBoxThreeColums>
  <Footer />
  <Navfoot />
</MainLayout>
