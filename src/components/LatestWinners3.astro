---
import { getImage } from "astro:assets";
import kbankLogo from "../assets/banks/kbank.png";
import scbLogo from "../assets/banks/scb.png";
import krungsriLogo from "../assets/banks/krungsri.png";
import ktbLogo from "../assets/banks/ktb.png";
import ttbLogo from "../assets/banks/ttb.png";
import trueWalletLogo from "../assets/bank-footer/TRUEWALLET.png";
import { BRAND_NAME, brandFlag, brandPick } from "../lib/brandProfile";

const trueWalletIcon = await getImage({ src: trueWalletLogo, width: 48, height: 48, format: "webp", quality: 80 });

const bankPool = [
  { name: "KBank", color: "bg-[#1155cc]", icon: kbankLogo.src },
  { name: "SCB", color: "bg-[#4e1c80]", icon: scbLogo.src },
  { name: "Krungsri", color: "bg-[#fcd34d]", icon: krungsriLogo.src },
  { name: "KTB", color: "bg-[#0ea5e9]", icon: ktbLogo.src },
  { name: "TTB", color: "bg-[#1279be]", icon: ttbLogo.src },
  { name: "TrueMoney Wallet", color: "bg-[#ffffff]", icon: trueWalletIcon.src },
];

const AMOUNT_MIN = 500;
const AMOUNT_MAX = 48000;

const LETTERS = "abcdefghijklmnopqrstuvwxyz";
const pickFrom = (chars: string, salt: string) => chars.charAt(brandPick(Astro.site, salt, chars.length));

const initialRows = Array.from({ length: 5 }, (_, i) => ({
  bank: bankPool[brandPick(Astro.site, `winner-bank-${i}`, bankPool.length)],
  user: `${pickFrom(LETTERS, `winner-a-${i}`)}${pickFrom(LETTERS, `winner-b-${i}`)}***${[0, 1, 2, 3].map((d) => brandPick(Astro.site, `winner-d${i}-${d}`, 10)).join("")}`,
  amount: (AMOUNT_MIN + brandPick(Astro.site, `winner-amount-${i}`, AMOUNT_MAX - AMOUNT_MIN + 1)).toLocaleString("en-US"),
  pending: brandFlag(Astro.site, `winner-pending-${i}`),
}));

const feedTitle = `รายการถอนล่าสุดของสมาชิก ${BRAND_NAME}`;
const pendingText = "กำลังตรวจสอบรายการ";
const doneText = "โอนสำเร็จแล้ว";
const pendingClass = "border-[#fcaa04]/50 bg-[#123a1a] text-[#ffd24d]";
const doneClass = "border-[#4ade80]/45 bg-[#072010] text-[#4ade80]";
---

<div class="mx-auto w-full max-w-[900px] p-4 font-sans">
  <section
    aria-label={feedTitle}
    class="relative isolate overflow-hidden rounded-[30px] border border-[#2a6b2c] bg-[#072010] px-4 py-8 shadow-[0_10px_30px_rgba(1,10,3,0.5)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-1 bg-gradient-to-r from-[#c77d00] via-[#fcaa04] to-[#2f9e1f]"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -top-16 -right-10 -z-10 h-40 w-40 rounded-full bg-[#fcaa04]/12 blur-[60px]"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -bottom-16 -left-10 -z-10 h-40 w-40 rounded-full bg-[#2f9e1f]/18 blur-[60px]"></div>

    <div class="mb-8 text-center">
      <p class="bg-gradient-to-r from-white via-[#ffe9a8] to-[#fcaa04] bg-clip-text text-xl font-black text-transparent md:text-3xl">{feedTitle}</p>
      <p class="mt-2 text-left text-base leading-relaxed text-[#e3eedf] md:text-center">
        ถอนกดเองจากหน้าเว็บด้วยระบบออโต้ เข้าทรูวอเลทหรือบัญชีทุกธนาคาร ขั้นต่ำ 1 บาท ตัวเลขด้านล่างเป็นข้อมูลตัวอย่างสำหรับแสดงรูปแบบรายการเท่านั้น
      </p>
    </div>

    <div
      data-winners-feed
      data-interval="3500"
      data-max-rows="5"
      data-amount-min={AMOUNT_MIN}
      data-amount-max={AMOUNT_MAX}
      data-pending-chance="0.4"
      data-user-style="letters"
      data-user-digits="4"
      class="ml-4 border-l-2 border-[#2a6b2c] pl-6 md:ml-8 md:pl-8">
      {
        initialRows.map((row) => (
          <div data-winner-row class="relative mb-6 transition-all duration-500 ease-out motion-reduce:transition-none [&.is-entering]:-translate-x-4 [&.is-entering]:opacity-0">
            <div aria-hidden="true" class="absolute top-2 -left-[35px] h-4 w-4 rounded-full border-2 border-[#072010] bg-[#fcaa04] shadow-[0_0_10px_rgba(252,170,4,0.6)] md:-left-[43px]" />

            <div class="flex items-center gap-4 rounded-[20px] border border-[#2a6b2c] bg-gradient-to-r from-[#123a1a] to-[#072010] p-4 transition-colors hover:border-[#fcaa04]/50">
              <div data-winner-bank class={`flex h-10 w-10 shrink-0 items-center justify-center rounded-full ${row.bank.color}`}>
                <img data-winner-icon src={row.bank.icon} alt="" width="24" height="24" loading="lazy" decoding="async" class="h-6 w-6 object-contain" />
              </div>

              <div class="min-w-0 flex-1">
                <div class="text-sm text-[#b5cbb0]">
                  ยูสเซอร์:{" "}
                  <span data-winner-user class="font-bold text-white">
                    {row.user}
                  </span>
                </div>
                <div class="text-xl font-black text-[#ffd24d]">
                  <span data-winner-amount>{row.amount}</span> THB
                </div>
              </div>

              <div
                data-winner-status
                data-pending-text={pendingText}
                data-done-text={doneText}
                data-pending-class={pendingClass}
                data-done-class={doneClass}
                class={`hidden shrink-0 rounded-full border px-3 py-1 text-[10px] tracking-widest md:block ${row.pending ? pendingClass : doneClass}`}>
                {row.pending ? pendingText : doneText}
              </div>
            </div>
          </div>
        ))
      }
    </div>

    <script type="application/json" data-winners-banks set:html={JSON.stringify(bankPool)} />
  </section>
</div>

<script>
  import { startWinnersFeed } from "../lib/winnersFeed";

  startWinnersFeed();
</script>
