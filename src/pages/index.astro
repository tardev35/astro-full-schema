---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxFloatingBadge.astro";
import ContentBoxTwo from "../components/ContentBoxTwoFloatingBadge.astro";
import ContentBoxSevenThree from "../components/ContentBoxSevenThreeFloatingBadge.astro";
import ContentBoxThreeColums from "../components/ContentBox3ThreeFloatingBadge.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import SmoothCarousel from "../components/SmoothCarousel.astro";
import ProviderGrid from "../components/ProviderGrid.astro";
import LatestWinners from "../components/LatestWinners.astro";

const currentPath = Astro.url.pathname;
const homePage = Astro.url.origin;
const logoUrl = homePage + "/logo.webp";

const webPageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: "VEGUS24 ทางเข้าเว็บตรง เวกัสคาสิโน สล็อต AUTO รองรับ True Wallet ",
  description: "VEGUS24 ทางเข้าเว็บตรง อัปเดตล่าสุด สล็อตแตกง่าย เวกัสคาสิโน API แท้ ระบบออโต้ ไว 3 วิ รองรับ True Wallet ไม่มีขั้นต่ำ ถอนหลักล้านโอนจ่ายเต็ม",
  url: currentPath,
};
const webSiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "VEGUS24",
  alternateName: ["vegus24", "vegus24h", "vegus24 auto"],
  url: "https://vegus24r.com/",
};
const orgSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "VEGUS24",
  logo: logoUrl,
  url: homePage,
};
const allSchemas = [webPageSchema, orgSchema, webSiteSchema];

import { Picture } from "astro:assets";
import image1 from "../assets/slide2.jpg";
---

<MainLayout>
  <script type="application/ld+json" set:html={JSON.stringify(allSchemas)} />

  <Announcement />

  <ContentBox title="VEGUS24 ทางเข้าเว็บตรง เวกัสคาสิโน สล็อต AUTO รองรับ True Wallet">
    <p class="leading-relaxed">
      <strong class="text-[#10b981]">VEGUS24</strong> เว็บตรงลิขสิทธิ์แท้ (API ตรง) ทางเข้า ล่าสุด เล่น เวกัสคาสิโน หรือ สล็อต ไม่ผ่านเอเย่นต์ ตัดปัญหาเว็บสะดุด โดนบิด หรือล็อคยูสเซอร์ รวมสล็อตแตกหนักและคาสิโนสดไว้ในยูสเดียว
      ให้ความสะบายใจเพราะทุกยอดด้วย<strong class="text-yellow-400">ระบบฝาก-ถอนออโต้</strong> ทำรายการไวใน 3 วินาที ไม่มีบัญชีธนาคารก็เติมเครดิตได้ รองรับ True Wallet ไม่มีขั้นต่ำ แตกหมื่นหรือถอนหลักล้านเราก็โอนจ่ายเต็ม
      100%
    </p>

    <div class="mt-8 flex flex-wrap justify-center gap-5">
      <a
        href="/login"
        class="flex items-center justify-center rounded-full border-2 border-yellow-500 bg-[#062b15] px-10 py-3.5 font-black text-yellow-400 shadow-[0_0_20px_rgba(234,179,8,0.3)] transition-transform hover:scale-105 hover:bg-[#021207]">
        เข้าสู่ระบบ
      </a>
      <a
        href="/register"
        class="flex items-center justify-center rounded-full border border-[#34d399] bg-gradient-to-r from-[#10b981] to-[#047857] px-10 py-3.5 font-black text-white shadow-[0_0_20px_rgba(16,185,129,0.5)] transition-transform hover:scale-105">
        สมัครสมาชิก
      </a>
    </div>
  </ContentBox>

  <LatestWinners />

  <ProviderGrid />

  <ContentBoxThreeColums titleleft="🟢 เว็บใหญ่สายเขียว" titlecenter="⚡ ฝาก-ถอน เร็ว" titleright="📱 เล่นง่ายทุกระบบ">
    <div slot="left" class="text-sm text-green-100/80">มั่นคง ปลอดภัย 100% การันตีด้วยฐานลูกค้าที่มากที่สุดในไทย จ่ายจริงทุกยอดการเดิมพัน</div>
    <div slot="center" class="text-sm text-green-100/80">ระบบออโต้ที่ดีที่สุดในตอนนี้ ทำรายการรวดเร็วทันใจ รองรับทุกธนาคารและทรูวอเลท</div>
    <div slot="right" class="text-sm text-green-100/80">ไม่ต้องโหลดแอป รองรับทั้ง iOS และ Android ภาพคมชัดระดับ Full HD ไม่มีสะดุด</div>
  </ContentBoxThreeColums>

  <ContentBoxTwo titleleft="ทางเข้าเล่น VEGUS24 อัปเดตล่าสุด เว็บตรงไม่ผ่านเอเย่นต์" titleright="เวกัสคาสิโน และ สล็อต แตกง่าย ลิขสิทธิ์แท้ทุกค่าย">
    <div slot="left" class="text-white/80">
      <p>
        <strong class="text-yellow-400">ทางเข้าเล่น VEGUS24</strong> (Vegus24r) อัปเดตลิงก์ใหม่ ใช้งานได้จริง 100% หมดปัญหาลิงก์เสียหรือโดนบล็อก ไม่ต้องดาวน์โหลดแอปให้หนักเครื่อง รองรับมือถือทุกรุ่น (iOS
        และ Android) ล็อกอินปุ๊บเข้าถึงหน้าล็อบบี้เกมได้ทันที การันตีเล่นกับเว็บแม่ ไม่ผ่านเอเย่นต์ ไม่โดนโกงแน่นอน
      </p>
    </div>
    <div slot="right" class="text-white/80">
      <p>
        รวมเกม เวกัสคาสิโน และ สล็อตเว็บตรง ไว้ในที่เดียว <strong class="text-[#10b981]">VEGUS24</strong> ยูสเดียวเล่นได้ครบทุกค่าย ไม่ต้องโยกกระเป๋าเงินให้เสียเวลา
      </p>
      <ul class="list-disc pl-5">
        <li class="mb-2">สล็อตลิขสิทธิ์แท้ (API ตรง): แตกง่าย อัตราจ่ายสูง (RTP มาตรฐาน) ปั่นสปินเข้าฟรีเกมบ่อย แตกหนักแค่ไหนก็จ่ายเต็ม ไม่มีการล็อคยูสเซอร์</li>
        <li class="mb-2">คาสิโนสด: บาคาร่า รูเล็ต ไฮโล ส่งตรงภาพสตรีมมิ่งจากคาสิโนจริง ภาพชัด ลื่นไหล แทงขั้นต่ำหลักสิบก็ทำกำไรได้</li>
      </ul>
    </div>
  </ContentBoxTwo>

  <SmoothCarousel />

  <ContentBoxSevenThree>
    <div slot="left" class="flex h-full flex-col justify-center">
      <Picture
        src={image1}
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600, 800]}
        sizes="(max-width: 768px) 100vw, 50vw"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
        alt="Vegus24 VIP Service"
        class="mx-auto h-auto w-full rounded-2xl border-2 border-yellow-500/30 shadow-[0_10px_30px_rgba(234,179,8,0.2)]"
      />
    </div>
    <div slot="right">
      <h2 class="text-emerald-gradient mb-4 text-3xl font-black uppercase">ระบบฝาก-ถอน AUTO ไม่มีขั้นต่ำ รองรับ True Wallet (ทรูวอเลท)</h2>
      <p class="mb-6 text-white/80">
        <strong class="text-yellow-400">ระบบฝาก-ถอนออโต้</strong> ฝากปุ๊บเงินเข้าปั๊บ ถอนยอดใหญ่ได้ทันทีภายใน 3 วินาที ไม่ต้องรอคิวส่งสลิปให้แอดมิน ทุนน้อยก็เล่นได้สบายเพราะ <strong
          class="text-[#10b981]">
          VEGUS24
        </strong> เราให้สิทธิ์ฝากถอนไม่มีขั้นต่ำ (1 บาทก็ฝากได้) ไม่ต้องง้อบัญชีธนาคาร: รองรับการเติมเครดิตผ่านแอป TrueMoney Wallet ตลอด 24 ชั่วโมง สะดวก รวดเร็ว แอปธนาคารล่มก็เข้าเล่นเกมได้
      </p>
      <a href="/line" class="inline-flex items-center rounded-full bg-yellow-500 px-8 py-3 font-bold text-green-950 shadow-lg transition-transform hover:scale-105">
        <span class="mr-2 text-xl">LINE</span> ติดต่อแอดมิน
      </a>
    </div>
  </ContentBoxSevenThree>
  <ContentBoxTwo titleleft="สมัครสมาชิก และ ติดต่อเรา VEGUS24 บริการตลอด 24 ชั่วโมง" titleright="มาตรฐานบริการ VEGUS24 เว็บตรงลิขสิทธิ์แท้ มั่นคง ปลอดภัย 100%">
    <div slot="left" class="text-white/80">
      <p>
        <strong class="text-[#10b981]">สมัครสมาชิกฟรี</strong> เปิดยูสเซอร์ใหม่ไม่มีค่าธรรมเนียม ทำรายการง่ายด้วยตัวเองผ่านหน้าเว็บ หากติดปัญหา ลืมรหัสผ่าน หรืออยากได้โปรโมชั่นเด็ดๆ ทักแชทหาแอดมินคนไทยผ่าน
        Line Official ได้ตลอด 24 ชม. เราใช้ทีมงานคนจริงดูแล (ไม่ใช่บอท) ตอบไว แก้ปัญหาจบ พร้อมซัพพอร์ตระดับ VIP
      </p>
    </div>
    <div slot="right" class="text-white/80">
      <p>
        <strong class="text-yellow-400">มาตรฐานบริการเว็บตรง ลิขสิทธิ์แท้ VEGUS24</strong> คือความมั่นคง ดังนั้น การันตีด้วยฐานการเงินระดับเอเชีย เล่นได้หลักร้อยหรือสล็อตแตกหลักล้าน เราพร้อมโอนจ่ายเต็มจำนวนในบิลเดียว
        ไม่หักเปอร์เซ็นต์ ข้อมูลลูกค้าเก็บเป็นความลับสูงสุด เล่นง่าย ได้เงินจริง ปลอดภัย 100% จบทุกความกังวล เล่นกับเว็บของเราอย่างสบายใจ
      </p>
    </div>
  </ContentBoxTwo>
  <ContentBox>
    <h2 class="text-emerald-gradient mb-4 text-3xl font-black uppercase">รวมโปรเด็ดดวงและสิทธิพิเศษสำหรับสมาชิก KONG24H</h2>
    <p>
      คุณสามารถเข้าถึงความสนุกกับ KONG24H ได้อย่างสะดวกสบายผ่าน <strong class="text-amber-400">ทางเข้า เว็บเดิมพัน</strong> ที่ทีมงานของเราคอยอัปเดตลิงก์ใหม่ล่าสุดอยู่เสมอ เพื่อป้องกันปัญหาลิงก์เสียหรือโดนบล็อก
      รองรับการใช้งานตลอด 24 ชั่วโมงในทุกแพลตฟอร์ม ระบบมือถือ รองรับทั้ง iOS และ Android เล่นผ่านเบราว์เซอร์ได้ทันทีโดยไม่ต้องดาวน์โหลดแอปพลิเคชัน ระบบคอมพิวเตอร์: รองรับทั้ง Windows และ Mac หน้าจอปรับขนาดอัตโนมัติ
      (Responsive Design) สวยงาม เต็มตา ทุกอุปกรณ์
    </p>
  </ContentBox>
  <Navfoot />

  <style>
    :global(.text-emerald-gradient) {
      background: linear-gradient(to bottom, #34d399 0%, #10b981 100%) !important;
      -webkit-background-clip: text !important;
      -webkit-text-fill-color: transparent !important;
    }
  </style>
</MainLayout>
