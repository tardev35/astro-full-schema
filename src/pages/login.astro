---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement4.astro";
import CtaRedirect from "../components/CtaRedirect.astro";
import { pageGraph } from "../lib/schema";

const pageTitle = "เข้าสู่ระบบ BABYSHARK8899 | ปุ่มเข้าหน้าสมาชิกด้วยยูสเดิม";

const pageDescription =
  "หน้าเข้าสู่ระบบ BABYSHARK8899 มีปุ่มเดียวสำหรับกดไปหน้าล็อกอินของสมาชิก ใช้ยูสกับรหัสผ่านชุดเดิมได้จากทุกเครื่อง เล่นสล็อต คาสิโนสด ยิงปลา และหวยต่อบนมือถือ";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เข้าสู่ระบบ", path: "/login" },
  ],
});

const targetUrl = "https://yoalink.com/gf78";
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="เข้าสู่ระบบ BABYSHARK8899" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label="เข้าสู่ระบบ BABYSHARK8899"
        class="group relative mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-full bg-gradient-to-b from-[#4da3ff] to-[#0554b8] px-6 py-4 text-xl font-bold tracking-wide text-white shadow-[0_0_15px_rgba(11,124,244,0.45)] transition-all duration-300 hover:scale-105 hover:brightness-110 hover:shadow-[0_15px_40px_rgba(11,124,244,0.45)]">
        เข้าสู่ระบบ BABYSHARK8899
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="เข้าสู่ระบบ" />
</MainLayout>
