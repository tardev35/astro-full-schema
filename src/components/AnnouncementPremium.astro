---
const {
  message =
    "OHO555 เว็บตรงไม่ผ่านเอเย่นต์ สล็อตกระเป๋าเดียวทุกค่าย คาสิโนสดยูสเดียวกับสล็อต ฝากถอนขั้นต่ำ 1 บาท ผ่านทรูวอเลทหรือทุกธนาคาร สมาชิกใหม่รับโบนัส 50% สูงสุด 500 มีแอดมินดูแลตลอด 24 ชั่วโมง",
} = Astro.props;

const SCROLL_PX_PER_SEC = 50;
const PX_PER_CHAR = 6.2;
const TRAILING_PX = 81;
const scrollSeconds = Math.max(12, Math.round((message.length * PX_PER_CHAR + TRAILING_PX) / SCROLL_PX_PER_SEC));
---

<div class="mx-auto w-full max-w-7xl px-4 py-4 font-sans">
  <div
    class="relative flex overflow-hidden rounded-full border border-[#fcaa04]/45 bg-[#04160a]/92 shadow-[0_8px_20px_rgba(1,10,3,0.55)] transition-shadow duration-300 hover:shadow-[0_8px_25px_rgba(252,170,4,0.25)]">
    <div
      class="relative z-10 flex shrink-0 items-center justify-center rounded-full bg-gradient-to-r from-[#ffe08a] via-[#fcaa04] to-[#c77d00] px-8 py-2.5 font-black text-[#1a1000] shadow-[4px_0_15px_rgba(252,170,4,0.28)]">
      <span aria-hidden="true" class="mr-2 text-lg">📣</span> ประกาศ
    </div>

    <div class="marquee-container relative flex-1 overflow-hidden py-2.5 pr-6">
      <div aria-hidden="true" class="pointer-events-none absolute top-0 left-0 z-10 h-full w-12 bg-gradient-to-r from-[#04160a] to-transparent"></div>

      <div class="marquee-content inline-block pl-4 text-sm font-medium tracking-wide whitespace-nowrap text-[#e3eedf]" style={`animation-duration:${scrollSeconds}s`}>
        <span class="mr-10 inline-flex items-center gap-3"><span aria-hidden="true" class="h-2 w-2 rounded-full bg-[#5ccf3f] shadow-[0_0_8px_rgba(92,207,63,0.6)]"></span>{message}</span>
        <span aria-hidden="true" class="mr-10 inline-flex items-center gap-3"><span class="h-2 w-2 rounded-full bg-[#5ccf3f] shadow-[0_0_8px_rgba(92,207,63,0.6)]"></span>{message}</span>
      </div>
    </div>
  </div>
</div>

<style>
  .marquee-content {
    animation: marquee 25s linear infinite;
  }
  .marquee-container:hover .marquee-content {
    animation-play-state: paused;
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee-content {
      animation: none;
    }
  }
  @keyframes marquee {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }
</style>
