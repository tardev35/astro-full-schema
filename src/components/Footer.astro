---
import { Picture } from "astro:assets";
import BankStrip from "./BankStrip.astro";
import { BRAND_ADDRESS } from "../lib/brandProfile";

const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.*", { eager: true });
const imagePaths = Object.keys(images);
const targetPath = imagePaths.find((path) => path.endsWith(".webp")) || imagePaths.find((path) => path.endsWith(".png")) || (imagePaths.length > 0 ? imagePaths[0] : null);
const mainLogo = targetPath ? images[targetPath].default : null;

const shortcuts = [
  { name: "หน้าแรก", path: "/" },
  { name: "โปรโมชั่น", path: "/promotion/" },
  { name: "ทดลองเล่น", path: "/ทดลองเล่น/" },
  { name: "วิธีฝากถอน", path: "/วิธีฝากถอน/" },
  { name: "ทางเข้า", path: "/ทางเข้า/" },
  { name: "สมัครสมาชิก", path: "/register/" },
  { name: "เข้าสู่ระบบ", path: "/login/" },
  { name: "เกี่ยวกับเรา", path: "/about-us/" },
  { name: "ติดต่อเรา", path: "/contact-us/" },
];

const logoAlt = "โลโก้ 777RUAY ตัวอักษรภาษาอังกฤษสีทองนูนแบบสามมิติ ขอบทองเข้มเงาวาว";
---

<footer
  class="relative isolate mt-12 w-full overflow-hidden rounded-t-[3rem] border-t-4 border-[#e0a91b] bg-[#071640] pt-16 pb-8 font-sans text-[#dbe6fb] shadow-[0_-10px_30px_rgba(10,31,92,0.18)]">
  <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 -top-24 -z-10 mx-auto h-[220px] w-full max-w-4xl rounded-full bg-[#1a5fe0]/25 blur-[80px]"></div>

  <div class="mx-auto w-full max-w-[1400px] px-6">
    <div class="mb-12 grid grid-cols-1 gap-12 md:grid-cols-12">
      <div class="flex flex-col gap-4 md:col-span-5">
        <a href="/" class="inline-block max-w-max rounded-2xl border border-[#ffd45c]/40 bg-[#0a1f5c] px-5 py-3 transition-transform duration-300 hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt={logoAlt}
                widths={[100, 200, 300]}
                sizes="100px"
                class="h-[46px] w-auto object-contain"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <span class="text-3xl font-black tracking-widest text-[#ffd45c]">777RUAY</span>
            )
          }
        </a>
        <p class="mt-2 border-l-2 border-[#e0a91b] pl-4 text-sm leading-relaxed text-[#9fb3dc]">
          777RUAY สล็อตออนไลน์ที่เปิดเล่นผ่านเบราว์เซอร์ได้ทั้งมือถือและคอม รวมเกมจาก PG Soft, Pragmatic Play, JILI และ Habanero ระบบฝากถอนออโต้ปรับเครดิตให้เองตลอด 24 ชั่วโมงโดยไม่ต้องแนบสลิป
        </p>
        <div class="mt-2 flex gap-3">
          <span class="rounded-md border border-[#ffd45c]/40 bg-[#ffd45c]/10 px-3 py-1 text-[10px] font-bold text-[#ffd45c]">HTTPS / SSL</span>
          <span class="rounded-md border border-[#4d8ff5]/50 bg-[#1a5fe0]/20 px-3 py-1 text-[10px] font-bold text-[#cfe0ff]">AUTO 24 HR</span>
        </div>
      </div>

      <nav aria-label="ทางลัดในเว็บไซต์" class="flex flex-col gap-4 md:col-span-3 lg:pl-12">
        <p class="border-b border-[#ffd45c]/30 pb-2 text-base font-black tracking-widest text-[#ffd45c] uppercase">ทางลัด</p>
        <ul class="flex flex-col gap-3 text-sm font-medium text-[#9fb3dc]">
          {
            shortcuts.map((item) => (
              <li>
                <a href={item.path} class="flex items-center gap-2 transition-colors hover:text-[#ffd45c]">
                  <span aria-hidden="true" class="text-[#e0a91b]">
                    ▸
                  </span>
                  <span>{item.name}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="flex flex-col gap-4 md:col-span-4">
        <p class="border-b border-[#ffd45c]/30 pb-2 text-base font-black tracking-widest text-[#ffd45c] uppercase">ติดต่อแอดมิน</p>

        <a
          href="/line/"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-green-600 to-green-500 py-3 text-sm font-black text-white shadow-md transition-all hover:scale-[1.02]">
          <span aria-hidden="true">💬</span>
          <span>ติดต่อแอดมิน (LINE)</span>
        </a>

        {
          BRAND_ADDRESS.lines.length > 0 && (
            <address aria-label={BRAND_ADDRESS.label} class="mt-2 rounded-xl border border-white/15 bg-black/20 p-4 text-xs leading-relaxed not-italic opacity-90">
              <p class="mb-2 flex items-center gap-2 text-[11px] font-bold tracking-wider uppercase opacity-80">
                <span aria-hidden="true" class="text-sm">📍</span>
                {BRAND_ADDRESS.label}
              </p>
              {BRAND_ADDRESS.lines.map((line) => (
                <span class="block">{line}</span>
              ))}
              {BRAND_ADDRESS.email && (
                <a href={`mailto:${BRAND_ADDRESS.email}`} class="mt-3 inline-flex items-center gap-2 font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                  <span aria-hidden="true" class="text-sm">✉️</span>
                  {BRAND_ADDRESS.email}
                </a>
              )}
            </address>
          )
        }

        <p class="mt-2 text-xs font-bold text-[#9fb3dc]">ช่องทางฝากถอน</p>
        <BankStrip size={32} />
      </div>
    </div>

    <div class="flex flex-col items-center justify-between gap-3 border-t border-[#ffd45c]/15 pt-6 text-xs font-medium text-[#9fb3dc] md:flex-row">
      <p>COPYRIGHT &copy; {new Date().getFullYear()} 777RUAY. ALL RIGHTS RESERVED.</p>
      <div class="flex gap-4">
        <a href="/terms/" class="transition-colors hover:text-[#ffd45c]">เงื่อนไขข้อตกลง</a>
        <a href="/privacy/" class="transition-colors hover:text-[#ffd45c]">นโยบายความเป็นส่วนตัว</a>
        <a href="#top" class="transition-colors hover:text-[#ffd45c]">กลับขึ้นบน</a>
      </div>
    </div>
  </div>
</footer>
