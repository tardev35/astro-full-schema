---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#6b2020] bg-[#280707]/92 p-8 text-left text-base leading-relaxed text-[#f7e2d6] shadow-[0_10px_30px_rgba(239,68,68,0.16)] transition-all duration-500 hover:border-[#ef4444]/60 hover:shadow-[0_15px_40px_rgba(239,68,68,0.26)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#ef4444]/20 blur-[60px] transition-all duration-500 group-hover:bg-[#f87171]/28"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#f5c542]/16 blur-[60px] transition-all duration-500 group-hover:bg-[#ffd75e]/24"></div>

    {
      title && (
        <header class="mb-6 flex items-center gap-4 border-b border-[#6b2020] pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ef4444] to-[#f5c542] shadow-[0_0_10px_rgba(239,68,68,0.45)]" />
          <HeadingTag class="bg-gradient-to-r from-[#f87171] via-[#ffe2d8] to-[#f5c542] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
