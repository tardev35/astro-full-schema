---
import { Picture } from "astro:assets";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });
const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;
const currentPath = Astro.url.pathname;
const isActive = (path: string) => {
  if (path === "/") return currentPath === "/";
  return currentPath.startsWith(path);
};
---

<div class="hidden w-full border-b border-yellow-600/30 bg-gradient-to-r from-[#2b0404] via-[#5c0a0a] to-[#2b0404] px-4 py-1.5 font-sans text-xs font-bold text-yellow-100/80 lg:block">
  <div class="mx-auto flex max-w-7xl justify-between">
    <div class="flex gap-4">
      <span class="flex items-center gap-1"><span class="text-yellow-400">👑</span> KONG24H เว็บใหญ่อันดับ 1</span>
      <span class="flex items-center gap-1 text-green-400"><span class="text-green-500">✔</span> ฝาก-ถอน ออโต้ 24 ชม.</span>
    </div>
    <div class="flex gap-4">
      <a href="/line" class="flex items-center gap-1 transition-colors hover:text-white">ติดต่อแอดมิน LINE: @KONG24H</a>
    </div>
  </div>
</div>

<header class="sticky top-2 z-50 mt-2 w-full px-2 font-sans md:px-4">
  <nav
    class="relative mx-auto flex h-[75px] w-full max-w-7xl items-center justify-between rounded-[20px] border border-yellow-500/40 bg-[#1a0202]/90 px-4 shadow-[0_10px_30px_rgba(234,179,8,0.15)] backdrop-blur-lg xl:px-8">
    <a href="/" class="z-50 flex-shrink-0 transition-transform hover:scale-105">
      {
        mainLogo ? (
          <Picture
            src={mainLogo}
            alt="KONG24H Logo"
            loading="eager"
            fetchpriority="high"
            class="h-[40px] w-auto drop-shadow-[0_0_10px_rgba(234,179,8,0.5)] xl:h-[45px]"
            formats={["avif", "webp"]}
            fallbackFormat="webp"
          />
        ) : (
          <h1 class="bg-gradient-to-b from-[#fef08a] to-[#ca8a04] bg-clip-text text-3xl font-black text-transparent drop-shadow-[0_0_8px_rgba(234,179,8,0.4)]">KONG24H</h1>
        )
      }
    </a>

    <div class="hidden h-full items-center gap-6 lg:flex xl:gap-8">
      {
        [
          { name: "หน้าแรก", path: "/" },
          { name: "โปรโมชั่น", path: "/promotion" },
          { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
          { name: "ทางเข้า", path: "/ทางเข้า" },
          { name: "ติดต่อเรา", path: "/contact-us" },
        ].map((item) => (
          <a
            href={item.path}
            class={`group relative flex h-full items-center text-sm font-bold tracking-wide uppercase transition-colors xl:text-base ${isActive(item.path) ? "text-yellow-400 drop-shadow-[0_0_8px_rgba(234,179,8,0.4)]" : "text-red-50/80 hover:text-yellow-400"}`}>
            <span>{item.name}</span>
            <div
              class={`absolute bottom-[18px] left-0 h-[2px] w-full origin-center bg-yellow-400 shadow-[0_0_8px_rgba(234,179,8,0.8)] transition-transform duration-300 ${isActive(item.path) ? "scale-x-100" : "scale-x-0 group-hover:scale-x-100"}`}
            />
          </a>
        ))
      }
    </div>

    <div class="z-50 flex items-center gap-3">
      <a
        href="/login"
        class="hidden items-center justify-center rounded-full border border-yellow-500/50 bg-[#3d0606] px-6 py-2 text-sm font-bold text-yellow-400 shadow-sm transition-all hover:bg-yellow-500/20 lg:flex">
        เข้าสู่ระบบ
      </a>
      <a
        href="/register"
        class="hidden items-center justify-center rounded-full bg-gradient-to-r from-yellow-300 via-yellow-500 to-yellow-600 px-6 py-2 text-sm font-black text-red-950 shadow-[0_0_15px_rgba(234,179,8,0.4)] transition-all hover:scale-105 lg:flex">
        สมัครสมาชิก
      </a>

      <button
        id="hamburger-btn"
        class="relative flex h-[42px] w-[42px] flex-col items-center justify-center gap-[5px] rounded-full border border-yellow-500/30 bg-gradient-to-b from-[#3d0606] to-[#1a0202] shadow-sm lg:hidden"
        aria-label="Menu">
        <span class="line-1 h-[2px] w-5 origin-center rounded-full bg-yellow-400 transition-all duration-300"></span>
        <span class="line-2 h-[2px] w-5 origin-center rounded-full bg-yellow-400 transition-all duration-300"></span>
        <span class="line-3 h-[2px] w-5 origin-center rounded-full bg-yellow-400 transition-all duration-300"></span>
      </button>
    </div>
  </nav>

  <div id="fullscreen-menu" class="pointer-events-none fixed inset-0 z-[40] flex flex-col items-center justify-center bg-[#1a0202]/98 opacity-0 backdrop-blur-xl transition-opacity duration-500">
    <div class="flex w-full flex-col items-center space-y-5 px-6">
      {
        [
          { name: "หน้าแรก", path: "/" },
          { name: "โปรโมชั่น", path: "/promotion" },
          { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
          { name: "ทางเข้า", path: "/ทางเข้า" },
          { name: "ติดต่อเรา", path: "/contact-us" },
        ].map((item) => (
          <a
            href={item.path}
            class={`fs-item text-2xl font-black tracking-widest uppercase transition-all duration-300 ${isActive(item.path) ? "text-yellow-400 drop-shadow-[0_0_10px_rgba(234,179,8,0.6)]" : "text-white/80 hover:text-white"}`}>
            {item.name}
          </a>
        ))
      }
      <div class="fs-item mt-4 flex w-full max-w-[280px] flex-col gap-4 pt-6">
        <a
          href="/register"
          class="flex w-full items-center justify-center rounded-full bg-gradient-to-r from-yellow-400 to-yellow-600 py-3.5 text-lg font-black text-red-950 shadow-[0_0_20px_rgba(234,179,8,0.5)]">
          สมัครสมาชิกใหม่
        </a>
        <a
          href="/login"
          class="flex w-full items-center justify-center rounded-full border-2 border-yellow-500/50 bg-[#3d0606] py-3.5 text-lg font-bold text-yellow-400 transition-colors hover:bg-yellow-500/20">
          เข้าสู่ระบบ
        </a>
      </div>
    </div>
  </div>
</header>

<style is:global>
  nav,
  header,
  div {
    font-family: "Kanit", sans-serif !important;
  }
  /* Hamburger Animation */
  #hamburger-btn.active .line-1 {
    transform: translateY(7px) rotate(45deg);
  }
  #hamburger-btn.active .line-2 {
    opacity: 0;
  }
  #hamburger-btn.active .line-3 {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* FS Menu Animation */
  .fs-item {
    opacity: 0;
    transform: translateY(20px);
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .fs-item.show {
    opacity: 1;
    transform: translateY(0);
  }
  .fs-item:nth-child(1) {
    transition-delay: 0.1s;
  }
  .fs-item:nth-child(2) {
    transition-delay: 0.15s;
  }
  .fs-item:nth-child(3) {
    transition-delay: 0.2s;
  }
  .fs-item:nth-child(4) {
    transition-delay: 0.25s;
  }
  .fs-item:nth-child(5) {
    transition-delay: 0.3s;
  }
  .fs-item:nth-child(6) {
    transition-delay: 0.35s;
  }
</style>

<script>
  const hamburgerBtn = document.getElementById("hamburger-btn");
  const fsMenu = document.getElementById("fullscreen-menu");
  const fsItems = document.querySelectorAll(".fs-item");

  const toggleFsMenu = () => {
    hamburgerBtn?.classList.toggle("active");
    fsMenu?.classList.toggle("opacity-0");
    fsMenu?.classList.toggle("pointer-events-none");

    if (!fsMenu?.classList.contains("opacity-0")) {
      document.body.style.overflow = "hidden";
      fsItems.forEach((item) => item.classList.add("show"));
    } else {
      document.body.style.overflow = "";
      fsItems.forEach((item) => item.classList.remove("show"));
    }
  };

  hamburgerBtn?.addEventListener("click", toggleFsMenu);
  fsItems.forEach((item) => {
    item.addEventListener("click", () => {
      if (!fsMenu?.classList.contains("opacity-0")) toggleFsMenu();
    });
  });
</script>
