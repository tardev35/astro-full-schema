---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import { pageGraph } from "../lib/schema";

const pageTitle = "วิธีฝากถอน MEEHAY569 ผ่านทรูวอเลทออโต้ เริ่ม 1 บาท ไม่ต้องส่งสลิป";

const pageHeading = "วิธีฝากถอน MEEHAY569 ผ่านทรูวอเลท ระบบออโต้ ไม่ต้องมีบัญชีธนาคาร";

const pageDescription =
  "วิธีฝากถอน MEEHAY569 ผ่านทรูวอเลทด้วยระบบออโต้ เริ่ม 1 บาท ไม่ต้องมีบัญชีธนาคารและไม่ต้องส่งสลิป ทำรายการเองได้ตลอด 24 ชั่วโมง พร้อมวิธีแจ้งเมื่อเครดิตไม่ขึ้น";

const announcementMessage =
  "MEEHAY569 สล็อตเว็บตรง ไม่ผ่านเอเย่นต์ • ฝากถอนทรูวอเลทออโต้ เริ่ม 1 บาท ตลอด 24 ชั่วโมง ไม่ต้องส่งสลิป • ทดลองเล่นสล็อตได้โดยไม่ต้องฝากเงินหรือสมัครก่อน • สมัครง่าย 4 ขั้นตอน เล่นได้ทั้งเว็บมือถือ แอป และคอม";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "วิธีฝากถอน", path: "/วิธีฝากถอน" },
  ],
});

const bodyClass = "mb-4 text-left text-base leading-relaxed text-[#23323f]";
const closerClass = "text-left text-base leading-relaxed text-[#23323f]";
const brandClass = "font-bold text-[#a35000]";
const linkClass = "font-bold text-[#006d99] underline underline-offset-4 transition-colors hover:text-[#a35000]";
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement message={announcementMessage} />

  <ContentBox as="h1" title={pageHeading}>
    <p class={bodyClass}>
      ที่ <strong class={brandClass}>MEEHAY569</strong> การฝากและถอนทำผ่านทรูวอเลท (TrueMoney Wallet) ด้วยระบบออโต้ คุณไม่ต้องมีบัญชีธนาคาร มีวอเลทอย่างเดียวก็เติมเครดิตและถอนออกได้เองตลอด 24 ชั่วโมง
    </p>

    <p class={closerClass}>
      ระบบปรับเครดิตให้เองโดยไม่ต้องส่งสลิป และยอดเริ่มต้นอยู่ที่ 1 บาท คนที่อยากลองระบบก่อนจึงเริ่มจากเงินก้อนเล็กได้ ไม่ต้องฝากเกินแผนตั้งแต่ครั้งแรก
    </p>
  </ContentBox>

  <ContentBox as="h2" title="สมัครสมาชิก MEEHAY569 ด้วยเบอร์โทรศัพท์ก่อนฝากครั้งแรก">
    <p class={bodyClass}>
      การฝากครั้งแรกคือขั้นสุดท้ายของการสมัคร แอดไลน์หรือกดปุ่ม<a href="/register/" class={linkClass}>สมัครสมาชิก</a>บนเว็บ กรอกเบอร์โทรศัพท์ที่รับ OTP ได้ ใส่ OTP ที่ได้รับ แล้วฝากเงินเข้าระบบผ่านทรูวอเลท
    </p>

    <p class={closerClass}>
      สมาชิกเดิมไม่ต้องสมัครซ้ำ กลับมาที่<a href="/ทางเข้า/" class={linkClass}>ทางเข้า MEEHAY569</a> แล้วล็อกอินด้วยยูสเดิมได้ทุกเครื่อง รหัส OTP กับรหัสผ่านห้ามบอกใคร แม้คนที่ทักมาจะอ้างว่าเป็นทีมงานก็ตาม
    </p>
  </ContentBox>

  <ContentBox as="h2" title="ฝากเงินผ่านทรูวอเลท ระบบปรับเครดิตให้เองโดยไม่ต้องส่งสลิป">
    <p class={bodyClass}>
      <a href="/login/" class={linkClass}>เข้าสู่ระบบ</a>แล้วทำรายการฝากจากทรูวอเลทตามขั้นตอนที่หน้าเว็บแสดง เมื่อโอนเสร็จ ระบบออโต้จะปรับยอดเครดิตในยูสให้เอง คุณไม่ต้องแคปหน้าจอส่งสลิปให้ใครตรวจ
    </p>

    <p class={bodyClass}>
      ยอดเริ่มต้นอยู่ที่ 1 บาท จะเติมก้อนเล็กเพื่อลองระบบก่อนก็ได้ และจะเติมตอนดึกหรือช่วงเช้าตรู่ก็ทำรายการเองได้ เพราะระบบเปิดรับตลอด 24 ชั่วโมง
    </p>

    <p class={closerClass}>ยอดแรกเล็กแค่ไหนก็ได้ ขอให้ตรงกับแผนที่ตั้งไว้</p>
  </ContentBox>

  <ContentBox as="h2" title="ถอนเงินเข้าทรูวอเลท ทำรายการเองได้ตลอด 24 ชั่วโมง">
    <p class={bodyClass}>
      ขาถอนใช้ทรูวอเลทเหมือนขาฝาก คุณทำรายการถอนผ่านหน้าเว็บด้วยยูสของตัวเอง ด้วยระบบออโต้ชุดเดียวกัน จึงไม่ต้องมีบัญชีธนาคารมารองรับยอดที่ถอนออก
    </p>

    <p class={bodyClass}>
      ระบบเปิดรับรายการตลอด 24 ชั่วโมง จะถอนหลังเที่ยงคืนหรือช่วงเช้ามืดก็ทำรายการเองได้จากเครื่องที่ใช้เล่นอยู่ ไม่ต้องรอให้ถึงช่วงเวลาใดเป็นพิเศษ
    </p>

    <p class={closerClass}>เงินเข้าทางไหน ก็ออกทางเดียวกัน</p>
  </ContentBox>

  <ContentBox as="h2" title="โอนแล้วเครดิตไม่ขึ้น อย่าเพิ่งโอนซ้ำ แจ้งเวลากับยอดให้ทีมงาน">
    <div class="flex flex-col gap-4">
      <p class={closerClass}>
        ถ้าโอนแล้วเครดิตยังไม่ขึ้น อย่าเพิ่งโอนซ้ำ จดเวลาที่ทำรายการกับยอดเงินไว้ แล้วแจ้งผ่านช่องทางบนหน้าเว็บหรือหน้า<a href="/contact-us/" class={linkClass}>ติดต่อเรา</a> ทีมงานจะได้ตามจากรายการนั้นให้ตรงจุด
      </p>

      <p class={closerClass}>
        เวลากับยอดคือข้อมูลสองอย่างที่ใช้หารายการเจอ ส่วนการโอนซ้ำเพราะใจร้อนหนึ่งครั้ง อาจทำให้ต้องตามเงินสองก้อนแทนที่จะตามแค่ก้อนเดียว
      </p>

      <div class="flex flex-col items-center justify-center gap-4 pt-4 sm:flex-row">
        <a
          href="/login/"
          aria-label="เข้าสู่ระบบ MEEHAY569 เพื่อฝากถอน"
          class="inline-flex w-full max-w-[320px] items-center justify-center gap-2 rounded-xl border-2 border-white bg-gradient-to-b from-[#19b2e0] to-[#0077b3] px-8 py-3.5 text-lg font-bold tracking-wide text-white shadow-[0_10px_30px_rgba(0,164,212,0.35)] transition duration-300 hover:scale-105 hover:brightness-110">
          <span aria-hidden="true">💳</span> เข้าสู่ระบบเพื่อฝากถอน
        </a>

        <a
          href="/register/"
          aria-label="สมัครสมาชิก MEEHAY569"
          class="inline-flex w-full max-w-[320px] items-center justify-center gap-2 rounded-xl border-2 border-white bg-gradient-to-b from-[#ffd23f] via-[#ffb84d] to-[#f7941d] px-8 py-3.5 text-lg font-black tracking-wide text-[#4a1d00] shadow-[0_10px_30px_rgba(247,148,29,0.40)] transition duration-300 hover:scale-105 hover:brightness-110">
          <span aria-hidden="true">📝</span> สมัครสมาชิก MEEHAY569
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
