---

---

<section class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="group relative w-full overflow-hidden rounded-3xl border border-purple-500/30 bg-[#0a001a]/80 p-6 text-white/90 shadow-[0_10px_30px_rgba(0,0,0,0.8)] backdrop-blur-xl transition-all duration-500 hover:border-purple-400/40 md:p-10">
    <div
      class="pointer-events-none absolute top-0 left-1/2 h-[2px] w-1/2 -translate-x-1/2 bg-gradient-to-r from-transparent via-purple-400 to-transparent opacity-50 shadow-[0_0_15px_rgba(157,78,221,0.8)] transition-opacity duration-500 group-hover:opacity-100">
    </div>

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-2 lg:gap-10">
      <article
        class="relative flex flex-col gap-4 rounded-2xl border border-white/5 bg-[#150029]/60 p-6 transition-all duration-300 hover:-translate-y-2 hover:border-purple-400/50 hover:bg-[#100022] hover:shadow-[0_15px_30px_rgba(157,78,221,0.15)]">
        <div class="flex items-start gap-4 border-b border-purple-900/50 pb-4">
          <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-purple-400/30 bg-gradient-to-br from-purple-500 to-purple-700 text-2xl shadow-[0_0_10px_rgba(157,78,221,0.5)]">
            👤
          </div>
          <div class="bg-gradient-to-r from-white to-gray-300 bg-clip-text text-xl leading-tight font-black text-transparent drop-shadow-sm">
            <slot name="title-left" />
          </div>
        </div>
        <div class="text-sm leading-relaxed text-gray-400">
          <slot name="content-left" />
        </div>
      </article>

      <article
        class="relative flex flex-col gap-4 rounded-2xl border border-white/5 bg-[#150029]/60 p-6 transition-all duration-300 hover:-translate-y-2 hover:border-yellow-500/50 hover:bg-[#1a1505] hover:shadow-[0_15px_30px_rgba(250,204,21,0.15)]">
        <div class="flex items-start gap-4 border-b border-purple-900/50 pb-4">
          <div
            class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-yellow-300/50 bg-gradient-to-br from-yellow-400 to-yellow-600 text-2xl shadow-[0_0_10px_rgba(250,204,21,0.5)]">
            🎁
          </div>
          <div class="bg-gradient-to-r from-yellow-300 to-yellow-500 bg-clip-text text-xl leading-tight font-black text-transparent drop-shadow-sm">
            <slot name="title-right" />
          </div>
        </div>
        <div class="text-sm leading-relaxed text-gray-400">
          <slot name="content-right" />
        </div>
      </article>
    </div>
  </div>
</section>
<style>
  .font-sans {
    font-family: "Kanit", sans-serif;
  }
</style>
