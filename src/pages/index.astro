---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/Announcement4.astro";
import ContentBox from "../components/ContentBox.astro";
import ContentBoxNeumorphism from "../components/ContentBoxNeumorphism.astro";
import ContentBoxFloatingBadge from "../components/ContentBoxFloatingBadge.astro";
import ContentBoxTwo from "../components/ContentBoxTwo.astro";
import ContentBoxTwoNeumorphism from "../components/ContentBoxTwoNeumorphism.astro";
import ContentBoxSevenThree from "../components/ContentBoxSevenThree.astro";
import ContentBoxSevenThreeNeumorphism from "../components/ContentBoxSevenThreeNeumorphism.astro";
import FeatureHighlights from "../components/FeatureHighlights.astro";
import ProviderGrid from "../components/ProviderGrid.astro";
import GameRankingBoard from "../components/GameRankingBoard.astro";
import SmoothCarousel from "../components/SmoothCarousel.astro";
import LatestWinners2 from "../components/LatestWinners2.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import ReviewCardSumo2 from "../components/ReviewCardSumo2.astro";
import Faq4 from "../components/Faq4.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import imgProviders from "../assets/slide3.png";
import imgNewMemberPromo from "../assets/slide1.png";
import imgAutoSystem from "../assets/banner2.png";

const pageTitle = "OSIRIS168 เว็บสล็อตระบบใหม่ รวมค่ายเกม 2026 มีโปรสมาชิกใหม่";

const pageDescription = "OSIRIS168 เว็บสล็อตระบบใหม่ปี 2026 รวมค่ายเกม โปรสมาชิกใหม่ osiris 168 ธีมเทพเจ้าโอไซริให้โชค ฝากถอนออโต้เต็มระบบ เล่นผ่านมือถือ ไม่ต้องโหลดapp";

const announcement =
  "OSIRIS168 เว็บสล็อตระบบใหม่ปี 2026 รวมสล็อตหลายค่ายไว้ในระบบเดียว เลือกตามค่าย ธีม หรือโบนัสได้โดยไม่ต้องเปิดบัญชีใหม่ • ระบบใหม่ลดขั้นตอนตั้งแต่ล็อกอิน เลือกเกม เช็กเครดิต ไปจนถึงกลับเข้าเกมที่เล่นค้างไว้ • หมวดเกมปี 2026 มีทั้งสล็อตเปิดใหม่และตัวฮิตเดิมให้สลับกันเล่น • โปรสมาชิกใหม่ osiris 168 เข้าไปดูสิทธิ์ โบนัส และรายละเอียดได้จากหน้าเมมเบอร์ก่อนเลือกใช้ • ระบบออโต้เชื่อมฝากถอนเข้ากับหน้าเมมเบอร์ ส่งรายการและเช็กสถานะได้จากจุดเดียว • เล่นผ่านมือถือได้เลย ไม่ต้องโหลดapp เปิดเบราว์เซอร์แล้วล็อกอินด้วยยูสเดิม • ธีมเทพเจ้าโอไซริให้โชคใช้กับทั้งเว็บ เปิดเข้ามาก็รู้ว่าอยู่เว็บไหน";

const providersAlt =
  "ภาพโปรโมชั่น OSIRIS168 เว็บสล็อตระบบใหม่ปี 2026 สมัครใหม่รับโบนัส 100% สูงสุด 10,000 บาท รวมค่ายเกมดัง PG Pragmatic Play Joker Habanero Play'n GO พร้อมไอคอนสี่ช่องว่า เล่นผ่านมือถือไม่ต้องโหลดapp ฝากถอนออโต้เต็มระบบ 24 ชม. เกมสล็อตคุณภาพสูง และโปรสมาชิกใหม่คุ้มทุกยูส ด้านขวาเป็นพรีเซนเตอร์หญิงชุดอียิปต์ทอง";

const newMemberPromoAlt =
  "ภาพโปรโมชั่น OSIRIS168 โปรเปิดยูสใหม่ เริ่มฝาก 50 รับเพิ่ม 150 โบนัสต้อนรับสมาชิกใหม่ ปุ่มเช็กโปรล่าสุด พรีเซนเตอร์หญิงชุดอียิปต์ดำทองชี้ไปที่ข้อความ ล้อมด้วยเหรียญทองบนพื้นหลังวิหารสีเขียวเข้ม บรรทัดล่างว่า เล่นผ่านมือถือสะดวก ระบบออโต้เต็มรูปแบบ";

const autoSystemAlt =
  "แบนเนอร์ OSIRIS168 พื้นหลังห้องเก็บสมบัติอียิปต์โทนเขียวทอง ตรงกลางเป็นด้วงปีกทองประดับหยกเขียวเหนือโลโก้ OSIRIS168 ข้อความตัวใหญ่ว่า เกมสล็อตออนไลน์แจกหนัก และ ฝากถอนทันใจ บริการสุดเลิศ ขนาบด้วยพรีเซนเตอร์หญิงชุดดำทอง รูปปั้นอนูบิสทอง เหรียญทอง และหน้าจอมือถือที่ขึ้นคำว่า SUPER MEGA WIN กับ BIG WIN";

const newSystemPoints = [
  {
    icon: "🔑",
    title: "ล็อกอินในไม่กี่ขั้นตอน",
    description: "เข้าหน้าเมมเบอร์ด้วยยูสเดิมได้จากทั้งมือถือและคอม เมนูหลักอยู่จุดเดิมทุกครั้ง ไม่ต้องจำว่าปุ่มสำคัญซ่อนอยู่ชั้นไหน",
    accent: "gold" as const,
  },
  {
    icon: "🎰",
    title: "เลือกเกมจากหน้าเดียว",
    description: "หน้าเกมจัดให้เลือกตามค่าย ธีม หรือโบนัสได้ในที่เดียว กดเข้าเกมต่อได้โดยไม่ต้องย้อนกลับหลายชั้นเมนู",
    accent: "jade" as const,
  },
  {
    icon: "💳",
    title: "เช็กเครดิตได้ทันที",
    description: "ยอดเครดิตและประวัติรายการอยู่บนหน้าเมมเบอร์ ดูก่อนตัดสินใจเล่นต่อได้โดยไม่ต้องสลับหน้าไปมา",
    accent: "gold" as const,
  },
  {
    icon: "🔄",
    title: "กลับเข้าเกมที่เล่นค้างไว้",
    description: "เกมที่เปิดค้างไว้รอบก่อนกลับไปเล่นต่อได้จากรายการเดิม ไม่ต้องไล่หาใหม่ทุกครั้งที่ล็อกอินเข้ามา",
    accent: "jade" as const,
  },
];

const faqs = [
  {
    q: "OSIRIS168 รวมค่ายเกมสล็อตไว้แบบไหน",
    a: "รวมเกมสล็อตจากหลายผู้ให้บริการไว้ในระบบเดียว เลือกตามค่าย ธีม โบนัส หรือสไตล์ที่ชอบได้ โดยไม่ต้องเปิดบัญชีใหม่ตามแต่ละค่าย และใช้เครดิตชุดเดิมข้ามค่ายได้",
  },
  {
    q: "โปรสมาชิกใหม่ osiris 168 ดูได้จากตรงไหน",
    a: "หลังเปิดยูสแล้วเข้าไปดูสิทธิ์ โบนัส และรายละเอียดของแคมเปญที่เปิดอยู่ได้จากหน้าเมมเบอร์ก่อนเลือกใช้ โปรที่เปิดใช้งานจะต่างกันไปตามช่วงเวลา",
  },
  {
    q: "ระบบฝากถอนออโต้ของ OSIRIS168 ทำงานยังไง",
    a: "ระบบออโต้เชื่อมการฝากถอนเข้ากับหน้าเมมเบอร์ ส่งรายการ ดูเครดิต และเช็กสถานะได้จากจุดเดียว ก่อนกลับไปเล่นสล็อตต่อโดยไม่ต้องวิ่งหลายหน้า",
  },
  {
    q: "เล่น OSIRIS168 บนมือถือต้องโหลดแอปไหม",
    a: "ไม่ต้องโหลดapp เปิดผ่านเว็บเบราว์เซอร์อย่าง Chrome หรือ Safari แล้วล็อกอินด้วยยูสเดิมได้เลย เข้าเกม เช็กเครดิต และทำรายการได้ครบจากมือถือเครื่องเดียว",
  },
  {
    q: "หน้าเมมเบอร์ osiris 168 รวมอะไรไว้บ้าง",
    a: "เป็นจุดรวมเครดิต โปรโมชั่น ประวัติรายการ และทางเข้าเกมจากหลายค่าย ทำให้เช็กข้อมูลของตัวเองได้จากหน้าเดียวโดยไม่ต้องสลับไปมาระหว่างเมนู",
  },
  {
    q: "สมัคร OSIRIS168 ผ่านมือถือทำยังไง",
    a: "สมัครผ่านมือถือได้ตั้งแต่เปิดบัญชี ยืนยันข้อมูล ไปจนถึงล็อกอินเข้าหน้าเมมเบอร์ หลังจากนั้นก็เลือกสล็อต ดูเครดิต หรือเช็กโปรโมชั่นต่อได้จากเครื่องเดิม",
  },
];

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement message={announcement} />

  <ContentBox as="h1" title="OSIRIS168 เว็บสล็อตระบบใหม่ 2026 รวมค่ายเกม พร้อมธีมเทพเจ้าโอไซริให้โชค">
    <p class="mb-4 text-left text-base leading-relaxed">
      OSIRIS168 ปรับเว็บสล็อตให้เข้ากับสายเล่นปี 2026 ทั้งหน้าเกมที่เลือกค่ายง่าย ระบบสมาชิกที่รวมเครดิตกับโปรโมชั่น และการใช้งานผ่านมือถือ ux ui เข้าใจง่าย ภาพจำของแบรนด์ยังหยิบคอนเซปต์ osiris 168 และ
      เทพเจ้าโอไซริให้โชค มาทำให้เว็บมีบุคลิกต่างจากสล็อตทั่วไป
    </p>

    <p class="text-left text-base leading-relaxed">
      ระบบฝากถอนออโต้ช่วยจัดการเครดิตจากหน้าเมมเบอร์ ส่วนสล็อตหลายค่ายก็เลือกเล่นต่อได้ทันที เว็บปี 2026 เกมเยอะเป็นพื้นฐาน แต่ต้องเข้าเกมง่าย แตกง่าย ยั่งยืนระยะยาว
    </p>
  </ContentBox>

  <ContentBoxTwo as="h2" title="OSIRIS168 ระบบใหม่ปี 2026 ทำให้สายสล็อตเล่นง่ายขึ้นตรงไหน">
    <div slot="left" class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed">
        ระบบใหม่ของ OSIRIS168 ลดขั้นตอนตั้งแต่ล็อกอิน เลือกเกม เช็กเครดิต ไปจนถึงกลับเข้าเกมที่เล่นค้างไว้ เมนูหลักถูกจัดให้เข้าถึงได้ทั้งมือถือและคอม ไม่ต้องจำว่าปุ่มสำคัญซ่อนอยู่ชั้นไหน
      </p>
      <p class="text-left text-base leading-relaxed">
        ฝั่งดีไซน์ใช้คาแรกเตอร์ osiris 168 และแนวคิด เทพเจ้าโอไซริให้โชค เป็นธีมเชื่อมหน้าเว็บเข้าด้วยกัน ทำให้ภาพจำของแบรนด์ชัดขึ้น เปิดเข้ามาก็รู้ว่าอยู่เว็บไหน ไม่ใช่หน้าตาคล้ายกันจนต้องดู URL ซ้ำ
      </p>
    </div>

    <FeatureHighlights slot="right" items={newSystemPoints} />
  </ContentBoxTwo>

  <ContentBoxSevenThree as="h2" titleright="osiris 168 รวมสล็อตหลายค่ายให้เปลี่ยนเกมได้ง่ายแค่ไหน">
    <Picture
      slot="left"
      src={imgProviders}
      alt={providersAlt}
      loading="lazy"
      fetchpriority="low"
      widths={[240, 400, 600]}
      sizes="(max-width: 767px) calc(100vw - 64px), 380px"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      class="mx-auto h-auto w-full rounded-2xl border border-[#064c39] shadow-[0_10px_30px_rgba(18,196,143,0.24)]"
    />

    <div slot="right" class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed">
        osiris 168 รวมเกมสล็อตจากหลายผู้ให้บริการไว้ในระบบเดียว สมาชิกจึงเลือกเกมตามค่าย ธีม โบนัส หรือสไตล์ที่ตัวเองชอบได้โดยไม่ต้องเปิดบัญชีใหม่ตามแต่ละค่าย
      </p>
      <p class="text-left text-base leading-relaxed">
        บางวันเกมประจำกำลังเข้ามือก็เล่นต่อ บางวันอยากเปลี่ยนบรรยากาศก็เปิดค่ายใหม่ได้เลย จุดนี้เข้ากับคอนเซปต์ เทพเจ้าโอไซริให้โชค ที่ใช้สร้างสีสันให้หน้าเกม แต่สุดท้ายสายสล็อตยังเลือกจังหวะของตัวเองเหมือนเดิม
      </p>
    </div>
  </ContentBoxSevenThree>

  <ProviderGrid />

  <ContentBoxNeumorphism as="h2" title="เกมใหม่ OSIRIS168 ปี 2026 มีอะไรให้สายชอบลองของใหม่">
    <p class="mb-4 text-left text-base leading-relaxed">
      หมวดเกมปี 2026 ของ OSIRIS168 เหมาะกับคนที่ชอบไล่สล็อตเปิดใหม่ ฟีเจอร์โบนัสใหม่ และเกมที่ออกแบบมาให้เล่นบนมือถือได้เต็มจอมากขึ้น โดยยังมีเกมเดิมสำหรับคนที่ไม่อยากเปลี่ยนของคุ้นมือ
    </p>

    <p class="text-left text-base leading-relaxed">
      หน้าเกมของ osiris 168 จึงมีทั้งฝั่งของใหม่และตัวฮิตให้สลับกันเล่น คอนเซปต์ เทพเจ้าโอไซริให้โชค ช่วยเติมภาพลักษณ์แบรนด์ ส่วนเกมไหนจะเข้ามือจริงก็ให้คนเล่นลองแล้วตัดสินกันเอง แบบนี้แฟร์กว่า
    </p>
  </ContentBoxNeumorphism>

  <GameRankingBoard />

  <ContentBoxSevenThreeNeumorphism as="h2" title="โปรสมาชิกใหม่ osiris 168 มีอะไรให้เช็กหลังเปิดยูส">
    <Picture
      slot="left"
      src={imgNewMemberPromo}
      alt={newMemberPromoAlt}
      loading="lazy"
      fetchpriority="low"
      widths={[240, 400, 600]}
      sizes="(max-width: 767px) calc(100vw - 64px), 360px"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      class="mx-auto h-auto w-full rounded-2xl border border-[#064c39] shadow-[0_10px_30px_rgba(18,196,143,0.24)]"
    />

    <div slot="right" class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed">
        osiris 168 มีพื้นที่โปรโมชั่นสำหรับสมาชิกใหม่ตามแคมเปญที่เปิดใช้งานในแต่ละช่วง หลังสมัครสามารถเข้าไปดูสิทธิ์ โบนัส และรายละเอียดของโปรจากหน้าเมมเบอร์ได้ก่อนเลือกใช้
      </p>
      <p class="text-left text-base leading-relaxed">
        ธีม เทพเจ้าโอไซริให้โชค สามารถนำมาเชื่อมกับโปรเปิดยูสใหม่ได้พอดี ทำให้แคมเปญมีภาพจำมากกว่าการแปะคำว่าโบนัสเฉย ๆ แต่คนเล่นควรเลือกโปรตามทุนและสไตล์ตัวเอง โปรเยอะไม่จำเป็นต้องรับทุกอันเหมือนบุฟเฟต์
      </p>
    </div>
  </ContentBoxSevenThreeNeumorphism>

  <SmoothCarousel />

  <ContentBoxTwoNeumorphism as="h2" title="สมัคร OSIRIS168 ผ่านมือถือแล้วเข้าเกมต่อได้เลยไหม">
    <p slot="left" class="text-left text-base leading-relaxed">
      การสมัคร OSIRIS168 ทำผ่านมือถือได้ตั้งแต่เปิดบัญชี ยืนยันข้อมูล ไปจนถึงล็อกอินเข้าหน้าเมมเบอร์ หลังจากนั้นก็เลือกสล็อต ดูเครดิต หรือเช็กโปรโมชั่นต่อได้จากเครื่องเดิม
    </p>

    <div slot="right" class="flex flex-col gap-5">
      <p class="text-left text-base leading-relaxed">
        หน้าใช้งานของ osiris 168 ถูกวางให้เหมาะกับพฤติกรรมคนเล่นปี 2026 ที่มือถือเป็นเครื่องหลัก ส่วนธีม เทพเจ้าโอไซริให้โชค ทำหน้าที่สร้างบรรยากาศให้เว็บ ไม่ได้มาขวาง UX จนกดอะไรไม่เจอ
      </p>

      <a
        href="/register"
        class="inline-flex w-fit items-center gap-2 rounded-full border border-[#e8b52c]/60 bg-gradient-to-r from-[#4ff0bb] via-[#12c48f] to-[#0a8f68] px-7 py-3 text-sm font-black tracking-widest text-[#03251c] uppercase shadow-[0_10px_30px_rgba(18,196,143,0.28)] transition-transform duration-300 hover:scale-105">
        <span aria-hidden="true">📝</span> สมัครสมาชิก OSIRIS168
      </a>
    </div>
  </ContentBoxTwoNeumorphism>

