---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;
---

<section class="mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="w-full rounded-[25px] bg-[#04173f] p-8 shadow-[10px_10px_20px_#010817,-10px_-10px_20px_#062459] transition-all duration-300 hover:shadow-[15px_15px_30px_#010817,-15px_-15px_30px_#083066]">
    {
      title && (
        <header class="mb-8 border-b border-[#ffd93d]/25 pb-4 text-center">
          <HeadingTag class="bg-gradient-to-r from-[#ffe98a] via-[#ffd93d] to-[#5aa9ff] bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#dbeafe]">
        {titleleft && <p class="text-xl leading-normal font-black tracking-wide text-[#ffd93d] drop-shadow-[0_0_10px_rgba(46,139,255,0.35)]">{titleleft}</p>}
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#dbeafe] md:border-l md:border-[#2e8bff]/25 md:pl-8">
        {titleright && <p class="text-xl leading-normal font-black tracking-wide text-[#ffd93d] drop-shadow-[0_0_10px_rgba(46,139,255,0.35)]">{titleright}</p>}
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
