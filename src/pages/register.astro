---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import CtaRedirect from "../components/CtaRedirect.astro";
import { pageGraph } from "../lib/schema";

const pageDescription = "หน้าสมัครสมาชิก SCLASS88 สล็อตแท้เว็บตรง รวมปุ่มเปิดบัญชีใหม่ไว้จุดเดียว สมัครผ่านมือถือได้ในไม่กี่ขั้นตอน แล้วใช้บัญชีเดียวเลือกเกมค่ายใหญ่ และฝากถอนออโต้";

const graph = pageGraph(Astro, {
  name: "สมัครสมาชิก SCLASS88 สล็อตแท้เว็บตรง",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "สมัครสมาชิก", path: "/register" },
  ],
});

const targetUrl = "https://yoalink.com/22hs";
---

<MainLayout title="สมัครสมาชิก SCLASS88 | ปุ่มเปิดบัญชีสล็อตแท้เว็บตรงผ่านมือถือ" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="สมัครสมาชิก SCLASS88" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label="สมัครสมาชิก SCLASS88"
        class="group relative mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#a3610c]/50 bg-gradient-to-b from-[#f5c542] to-[#e0a81e] px-6 py-4 text-xl font-bold tracking-wide text-[#1a1206] shadow-[0_10px_30px_rgba(224,168,30,0.20)] transition-all duration-300 hover:scale-105 hover:border-[#ffd75e]/70 hover:shadow-[0_15px_40px_rgba(224,168,30,0.28)]">
        สมัครสมาชิก SCLASS88
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="สมัครสมาชิก" />
</MainLayout>
