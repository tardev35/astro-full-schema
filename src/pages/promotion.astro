---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementCyber.astro";

import { Picture } from "astro:assets";

import pro1 from "../assets/slide1.png";
import pro2 from "../assets/slide2.png";
import pro3 from "../assets/slide3.png";
import pro4 from "../assets/slide4.png";
import { pageGraph } from "../lib/schema";

const pageTitle = "โปรโมชั่น – VODKAFUN";

const pageHeading = "โปรโมชั่น VODKAFUN คืนคอมมิชชั่นทุกวัน แนะนำเพื่อนรับโบนัสเพิ่ม";

const pageDescription =
  "รวมโปรโมชั่น VODKAFUN สล็อตเว็บตรงเว็บใหญ่ คอมมิชชั่นคืนทุกยอดเล่น 0.3% แนะนำเพื่อนรับโบนัส 0.8% หวยจ่ายบาทละ 1000 ดูเงื่อนไขจากภาพได้ทุกใบ สมัครฟรีวันนี้";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: pro1.src,
});

const promoClass =
  "mx-auto h-auto w-full rounded-xl border border-[#1f0b4d] object-contain shadow-[0_10px_30px_rgba(255,61,200,0.16)] transition-all duration-300 hover:-translate-y-1 hover:border-[#ff3dc8]/55 hover:shadow-[0_15px_40px_rgba(255,61,200,0.28)]";
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageHeading} as="h1">
    <p class="mb-4 text-left text-base leading-relaxed">
      หากคุณกำลังมองหาโปรที่ได้คืนจริงทุกวัน ไม่ใช่แค่ตอนสมัคร <strong class="text-[#ff8fe0]">VODKAFUN</strong> พร้อมเสิร์ฟคอมมิชชั่นคืนทุกยอดเล่น 0.3% ตลอดทั้งวัน กดรับสิทธิ์ที่หน้าเว็บได้ก่อน 23.59 น. ของทุกวัน
    </p>

    <p class="mb-8 text-left text-base leading-relaxed">
      ชวนเพื่อนมาสนุกด้วยกันก็รับโบนัสแนะนำเพื่อน 0.8% ต่อเนื่อง เงื่อนไขของแต่ละโปรระบุไว้บนภาพครบถ้วน สมัครยูสเดียวใช้ได้ทุกสิทธิ์ เพื่อประสบการณ์การเล่นที่คุ้มค่าและต่อเนื่องกว่าที่เคย
    </p>

    <div class="grid w-full grid-cols-1 gap-6 sm:grid-cols-2">
      <Picture
        src={pro1}
        alt="VODKAFUN Commission คืนทุกยอดเล่นตลอดทั้งวัน 0.3% เล่นถึง 50% ถอนได้เลย รับสิทธิ์ก่อน 23.59 น. ของทุกวัน"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class={promoClass}
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />

      <Picture
        src={pro2}
        alt="VODKAFUN แนะนำเพื่อน รับโบนัส 0.8% สร้างรายได้ 100,000/เดือน"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class={promoClass}
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />

      <Picture
        src={pro3}
        alt="VODKAFUN ครบจบในที่เดียว หวย บอล บาคาร่า สล็อต คาสิโน ยิงปลา ไก่ชน มวย ไฮโล รูเล็ต"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class={promoClass}
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />

      <Picture
        src={pro4}
        alt="VODKAFUN หวย อัตราจ่ายที่ดีที่สุด 3 ตัวบาทละ 1000 2 ตัวบาทละ 100 รัฐบาล ลาว ฮานอย หุ้น ยี่กี"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class={promoClass}
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />
    </div>

    <div class="mt-12 flex justify-center pb-4">
      <a
        href="/register/"
        class="flex items-center justify-center rounded-lg border border-[#0aa4c4] bg-gradient-to-r from-[#9bf2fb] via-[#1be5f4] to-[#0aa4c4] px-10 py-3.5 text-lg font-black text-[#14042e] shadow-[0_10px_30px_rgba(27,229,244,0.24)] transition-transform hover:scale-105 hover:shadow-[0_15px_40px_rgba(27,229,244,0.34)]">
        สมัครสมาชิก VODKAFUN
      </a>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
