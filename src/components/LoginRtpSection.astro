---
import ContentBoxTwo from "./ContentBoxTwo.astro";

const steps = [
  { icon: "🏛️", name: "เว็บตรง ไม่ผ่านเอเย่นต์", detail: "เชื่อมต่อสัญญาณเกมโดยตรงจากค่ายแม่ ระบบเกมจึงเสถียร ตรงไปตรงมา และตรวจสอบได้ทุกขั้นตอน", tag: "ตรงจากค่ายแม่" },
  { icon: "⚖️", name: "RTP ตามมาตรฐานสากล", detail: "อัตราการชนะเป็นไปตามค่าที่ค่ายกำหนด ไม่มีใครมาแอบปรับหลังบ้าน วัดกันที่ดวงและฝีมือล้วนๆ", tag: "โปร่งใส" },
  { icon: "🎰", name: "ค่ายเกมลิขสิทธิ์แท้", detail: "PG SOFT, Joker Gaming และ Pragmatic Play เลือกเล่นได้ครบ เมนูภาษาไทยชัดเจน กติกาไม่ซับซ้อนซ่อนเงื่อน", tag: "3 ค่ายหลัก" },
  { icon: "⚡", name: "ฝากถอนระบบอัตโนมัติ", detail: "ทำรายการเองผ่านแอปพลิเคชันธนาคารชั้นนำหรือทรูวอลเลท ไม่ต้องส่งสลิปให้แอดมินดูให้เสียเวลา", tag: "ว่องไว" },
  { icon: "📱", name: "ทางเข้ารองรับทุกอุปกรณ์", detail: "ใช้ได้ทั้ง iOS และ Android รวมถึงคอมพิวเตอร์และแท็บเล็ต หน้าเว็บอ่านง่าย สบายตา เล่นได้ลื่นไหล", tag: "ทุกอุปกรณ์" },
];
const chips = ["สล็อตสยาม", "เว็บตรงแตกดีจริง", "ไม่ผ่านเอเย่นต์", "RTP มาตรฐานสากล", "ยิ้มรับโปรสมาชิกใหม่", "ระบบอัตโนมัติ", "ทรูวอลเลท", "iOS และ Android"];
---

<ContentBoxTwo
  titleleft="เข้าสู่ระบบ YIMSIAM889"
  titleright="ระบบและบริการที่ YIMSIAM889 จัดไว้ให้ครบจากบัญชีเดียว"
  label="เข้าสู่ระบบ YIMSIAM889 และระบบที่ใช้ได้จากบัญชีเดียว">
  <div slot="left" class="flex h-full flex-col gap-4">
    <div class="relative overflow-hidden rounded-2xl border border-[#16357a] bg-[#061538] p-6 shadow-[0_10px_30px_rgba(47,140,255,0.18)]">
      <div aria-hidden="true" class="pointer-events-none absolute -top-10 -right-10 h-32 w-32 rounded-full bg-[#2f8cff]/18 blur-[50px]"></div>

      <div class="relative z-10 mb-5 flex items-center gap-3">
        <span
          aria-hidden="true"
          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#2f8cff] bg-gradient-to-br from-[#eaf4ff] via-[#9cc9ff] to-[#4d9dff] text-xl shadow-inner">
          🏛️
        </span>
        <div class="flex flex-col">
          <p class="text-base font-black text-[#9cc9ff]">ยินดีต้อนรับกลับสู่เรือนยิ้มสยามขอรับ</p>
          <span class="text-[11px] text-[#93a9d6]">บัญชีเดียวใช้เลือกเกม ฝากถอนผ่านระบบอัตโนมัติ และดูสถานะกับประวัติธุรกรรมของ YIMSIAM889 ได้ครบจากหน้าบัญชี</span>
        </div>
      </div>

      <div class="relative z-10 flex flex-col gap-3.5">
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#7cc0ff]">👤</span>
          <input
            type="text"
            aria-label="เบอร์โทรศัพท์หรือยูสเซอร์เนม"
            placeholder="เบอร์โทรศัพท์ / ยูสเซอร์เนม"
            class="w-full rounded-xl border border-[#16357a] bg-[#020b24] py-3 pr-4 pl-12 text-[#d6e4ff] transition-all outline-none placeholder:text-[#93a9d6] focus:border-[#2f8cff] focus:ring-1 focus:ring-[#2f8cff]/50"
          />
        </div>
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#7cc0ff]">🔑</span>
          <input
            type="password"
            aria-label="รหัส PIN 4 หลัก"
            placeholder="รหัส PIN 4 หลัก"
            class="w-full rounded-xl border border-[#16357a] bg-[#020b24] py-3 pr-4 pl-12 text-[#d6e4ff] transition-all outline-none placeholder:text-[#93a9d6] focus:border-[#2f8cff] focus:ring-1 focus:ring-[#2f8cff]/50"
          />
        </div>

        <div class="flex items-center justify-between px-1 text-xs">
          <label class="flex items-center gap-2 text-[#93a9d6]">
            <input type="checkbox" class="h-3.5 w-3.5 rounded border-[#16357a] bg-[#020b24] accent-[#2f8cff]" />
            จดจำฉันไว้
          </label>
          <a href="/login/" class="text-[#93a9d6] transition-colors hover:text-[#eaf4ff]">ลืมรหัส PIN?</a>
        </div>

        <button
          type="button"
          class="mt-1 w-full rounded-xl border border-[#2f8cff] bg-gradient-to-r from-[#eaf4ff] via-[#9cc9ff] to-[#4d9dff] p-3.5 font-black text-[#03133c] shadow-[0_10px_30px_rgba(47,140,255,0.4)] transition-all hover:scale-[1.02] hover:shadow-[0_15px_40px_rgba(47,140,255,0.5)]">
          เข้าสู่ระบบ
        </button>

        <div class="flex items-center gap-3 py-1 text-[11px] text-[#93a9d6]">
          <span class="h-px flex-1 bg-[#16357a]"></span>
          หรือ
          <span class="h-px flex-1 bg-[#16357a]"></span>
        </div>

        <a
          href="/line/"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] p-3 text-sm font-bold text-white shadow-md transition-all hover:scale-[1.02]">
          <span aria-hidden="true">💬</span> ทักไลน์ทีมงานคนไทย
        </a>

        <div class="mt-1 flex items-center justify-between px-1">
          <div class="flex gap-2">
            <span class="rounded-full border border-[#16357a] bg-[#020b24] px-2.5 py-1 text-[10px] font-bold text-[#9cc9ff]"><span aria-hidden="true">🔒</span> ระบบมั่นคง ปลอดภัย</span>
            <span class="rounded-full border border-[#16357a] bg-[#020b24] px-2.5 py-1 text-[10px] font-bold text-[#eaf4ff]"><span aria-hidden="true">📱</span> รองรับทุกอุปกรณ์</span>
          </div>
          <a href="/register/" class="text-xs font-bold text-[#93a9d6] transition-colors hover:text-[#eaf4ff]">สมัครสมาชิกใหม่</a>
        </div>
      </div>
    </div>
  </div>

  <div slot="right" class="h-full">
    <div class="flex h-full flex-col rounded-2xl border border-[#16357a] bg-[#061538] p-5 shadow-[0_10px_30px_rgba(47,140,255,0.18)]">
      <div class="mb-5 flex items-center justify-between gap-3">
        <div>
          <span class="text-xs font-bold tracking-wide text-[#93a9d6]">สรุปสิ่งที่ยิ้มสยาม889 จัดเตรียมไว้ให้ท่าน ตั้งแต่หน้าเกมจนถึงหน้าฝากถอน</span>
          <div class="bg-gradient-to-r from-[#eaf4ff] via-[#9cc9ff] to-[#7cc0ff] bg-clip-text text-2xl leading-normal font-black text-transparent sm:text-3xl">สล็อตสยาม • เว็บตรงแตกดีจริง</div>
        </div>
        <span class="flex items-center gap-1.5 self-start rounded-full border border-green-400/40 bg-[#020b24] px-2.5 py-1">
          <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-green-400 shadow-[0_0_8px_rgba(74,222,128,0.7)]"></span>
          <span class="text-[10px] font-bold tracking-widest text-green-400 uppercase">Live</span>
        </span>
      </div>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#93a9d6] uppercase">
        <span>ระบบ / บริการในเว็บ</span>
        <span>จุดเด่น</span>
      </div>

      <div class="flex flex-1 flex-col gap-2.5">
        {
          steps.map((s) => (
            <div class="rounded-xl border border-[#16357a] bg-[#020b24] px-3.5 py-2.5 transition-colors hover:border-[#2f8cff]/55 hover:bg-[#0a1f4d]">
              <div class="flex items-center justify-between gap-2 text-sm">
                <span class="flex min-w-0 items-center gap-2 font-bold text-[#dbeaff]">
                  <span aria-hidden="true" class="w-5 shrink-0 text-center">
                    {s.icon}
                  </span>{" "}
                  <span class="truncate">{s.name}</span>
                </span>
                <span class="shrink-0 rounded-full border border-[#16357a] bg-[#061538] px-2.5 py-0.5 text-[10px] font-bold text-[#eaf4ff]">{s.tag}</span>
              </div>
              <div class="mt-1.5 text-[11px] tracking-wide text-[#93a9d6]">{s.detail}</div>
            </div>
          ))
        }
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
        {chips.map((c) => <span class="rounded-full border border-[#16357a] bg-[#020b24] px-3 py-1 text-[10px] font-bold text-[#9cc9ff]">{c}</span>)}
      </div>

      <div class="mt-3 text-center text-[10px] tracking-wide text-[#93a9d6]">
        รายละเอียดของแต่ละบริการสรุปจากที่ YIMSIAM889 แจ้งไว้บนหน้าเว็บ เงื่อนไขการทำรายการให้ยึดตามหน้าบัญชีของท่านก่อนทำรายการทุกครั้ง และอย่าบอกรหัสผ่านหรือ OTP กับใคร
        หากติดขัดตรงไหนทักไลน์ทีมงานคนไทยได้เลยขอรับ
      </div>
    </div>
  </div>
</ContentBoxTwo>
