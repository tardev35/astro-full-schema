---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement4.astro";

import { Picture } from "astro:assets";
import pro1 from "../assets/pro1.webp";
import pro2 from "../assets/pro2.webp";
import pro3 from "../assets/pro3.webp";
import pro4 from "../assets/pro4.webp";
import pro5 from "../assets/pro5.webp";
import pro6 from "../assets/pro6.webp";
import pro7 from "../assets/pro7.webp";
import pro8 from "../assets/pro8.webp";
import pro9 from "../assets/pro9.webp";
import pro10 from "../assets/pro10.webp";
import pro11 from "../assets/pro11.webp";
---

<MainLayout
  title="โปรโมชั่น LOCKDOWN168 ปลดล็อกสิทธิพิเศษ โบนัส Full-Service"
  ,
  description="โปรโมชั่น LOCKDOWN168 เพื่อสมาชิกปี โดยเฉพาะ พบกับระบบคืนยอดเสียแม่นยำและกิจกรรม Exclusive สำหรับ VIP เงื่อนไข ปราศจากข้อผูกมัดที่ซับซ้อน">
  <Announcement />
  <ContentBox>
    <h1 class="mb-7 text-3xl">โปรโมชั่น LOCKDOWN168 ปลดล็อกสิทธิพิเศษ โบนัส Full-Service</h1>

    <div class="mx-auto grid w-full max-w-7xl grid-cols-1 gap-6 px-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-2">
      <Picture
        src={pro1}
        alt="โปรโมชั่นสมัครสมาชิกใหม่ ฝากครั้งแรกรับโบนัสฟรี 60% สำหรับคาสิโน"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600]}
        sizes="(max-width: 768px) 100vw, 33vw"
        class="mx-auto h-auto w-full rounded-xl object-contain shadow-lg transition-transform duration-300 hover:-translate-y-1 hover:shadow-2xl"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />

      <Picture
        src={pro2}
        alt="แจกโบนัสรายวัน ยอดฝากแรกรับโบนัสฟรี 20% สำหรับคาสิโน"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600]}
        sizes="(max-width: 768px) 100vw, 33vw"
        class="mx-auto h-auto w-full rounded-xl object-contain shadow-lg transition-transform duration-300 hover:-translate-y-1 hover:shadow-2xl"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />

      <Picture
        src={pro3}
        alt="โปรโมชั่นสมัครสมาชิกใหม่ ฝากครั้งแรกรับโบนัสฟรี 60% สำหรับสล็อต"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600]}
        sizes="(max-width: 768px) 100vw, 33vw"
        class="mx-auto h-auto w-full rounded-xl object-contain shadow-lg transition-transform duration-300 hover:-translate-y-1 hover:shadow-2xl"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />

      <Picture
        src={pro4}
        alt="แจกโบนัสทุกยอด ทุกยอดฝากรับโบนัสฟรี 20% สำหรับสล็อต"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600]}
        sizes="(max-width: 768px) 100vw, 33vw"
        class="mx-auto h-auto w-full rounded-xl object-contain shadow-lg transition-transform duration-300 hover:-translate-y-1 hover:shadow-2xl"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />

      <Picture
        src={pro5}
