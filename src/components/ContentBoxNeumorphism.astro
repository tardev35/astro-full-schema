---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";
---

<section class="relative z-10 my-6 flex w-full justify-center px-4 font-sans">
  <div
    class="w-full max-w-[1400px] rounded-[25px] border border-[#f5c542]/45 bg-[#1f0405] p-8 text-left text-base leading-relaxed text-[#f7e6d0] shadow-[10px_10px_20px_#0f0101,-10px_-10px_20px_#3a0a0d]">
    {
      title && (
        <header class="mb-8 border-b border-[#f5c542]/40 pb-4 text-center">
          <HeadingTag class={`bg-gradient-to-r from-[#ffe9a3] via-[#ffd34d] to-[#f5c542] bg-clip-text ${headingSize} leading-normal font-black tracking-wide text-transparent`}>{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
