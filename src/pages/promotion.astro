---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";

import { Picture } from "astro:assets";

import pro1 from "../assets/slide1.png";
import pro2 from "../assets/slide2.png";
import pro3 from "../assets/slide3.png";
import { pageGraph } from "../lib/schema";

const pageTitle = "โปรโมชั่น OHO555 โบนัสสมาชิกใหม่ 50% คืนยอดเสีย 5% คืนค่าคอมบาคาร่า 0.6%";

const pageHeading = "โปรโมชั่น OHO555 โบนัสสมาชิกใหม่ 50% พร้อมคืนยอดเสียทุกวัน";

const pageDescription =
  "โปรโมชั่น OHO555 สมาชิกใหม่รับโบนัส 50% ฝาก 100 รับ 50 คืนยอดเสีย 5% สูงสุด 2,000 บาท คืนค่าคอมบาคาร่า 0.6% เลือกโปรที่ใช่หรือไม่รับก็ได้ ฝากถอนขั้นต่ำ 1 บาท";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: pro1.src,
});

const promos = [
  {
    src: pro1,
    alt: "OHO555 สายบาคาร่า ทุกการเดิมพัน ได้หรือเสีย คืนค่าคอม 0.6% คืนไม่อั้น รับได้ตลอด คุ้มทุกไม้ เล่นต่อได้ รับสิทธิ์เลย",
  },
  {
    src: pro2,
    alt: "OHO555 คืนยอดเสีย 5% สูงสุด 2,000 บาท รับคืนทุกวัน เล่นได้แบบสบายใจ คืนไวทุกวัน รับโปรเลย",
  },
  {
    src: pro3,
    alt: "OHO555 ต้อนรับสมาชิกใหม่ รับโบนัส 50% ฝาก 100 รับ 50 ทำเทิร์น 3 เท่า เฉพาะสล็อตเท่านั้น JACKPOT สมัครเลย",
  },
];

const promoClass =
  "mx-auto h-auto w-full rounded-xl border border-[#2a6b2c] object-contain shadow-[0_10px_30px_rgba(1,10,3,0.45)] transition-all duration-300 hover:border-[#fcaa04]/60 hover:shadow-[0_15px_40px_rgba(252,170,4,0.18)] motion-safe:hover:-translate-y-1";

const brandClass = "font-bold text-[#ffc93c]";
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageHeading} as="h1">
    <p class="mb-4 text-left text-base leading-relaxed">
      หากคุณกำลังมองหาความคุ้มค่าตั้งแต่ยอดฝากแรก <strong class={brandClass}>OHO555</strong> พร้อมมอบโบนัสสมาชิกใหม่ 50% สิทธิ์คืนยอดเสียรายวัน และค่าคอมบาคาร่าที่คืนให้ทุกการเดิมพัน รวมไว้ให้เลือกในหน้าเดียว
    </p>

    <p class="mb-8 text-left text-base leading-relaxed">
      แต่ละโปรมียอดรับและเงื่อนไขเทิร์นต่างกันตามที่ระบุไว้บนภาพ เลือกโปรที่เข้ากับสไตล์การเล่นของคุณ หรือจะไม่รับโปรแล้วเล่นด้วยยอดฝากล้วนก็ได้ เพื่อการเล่นที่คุ้มค่าและคุมงบได้ตามใจ
    </p>

    <div class="grid w-full grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        promos.map((promo) => (
          <div class="sm:max-lg:last:odd:col-span-2 sm:max-lg:last:odd:mx-auto sm:max-lg:last:odd:w-1/2">
            <Picture
              src={promo.src}
              alt={promo.alt}
              loading="lazy"
              fetchpriority="low"
              widths={[400, 600]}
              sizes="(min-width: 1432px) 424px, (min-width: 1024px) 29vw, (min-width: 640px) 46vw, calc(100vw - 96px)"
              class={promoClass}
              decoding="async"
              formats={["avif", "webp"]}
              fallbackFormat="webp"
              quality={70}
            />
          </div>
        ))
      }
    </div>

    <div class="mt-12 flex justify-center pb-4">
      <a
        href="/register/"
        style="background-image: linear-gradient(in oklab to bottom, #ff4b4b, #d81e1e 55%, #9e0c12);"
        class="flex items-center justify-center rounded-xl border-2 border-[#ffd24d] px-10 py-3.5 text-lg font-black text-white shadow-[0_8px_22px_rgba(216,30,30,0.40)] transition-all hover:scale-105 hover:brightness-110 hover:shadow-[0_15px_40px_rgba(252,170,4,0.30)]">
        สมัครสมาชิก OHO555
      </a>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
