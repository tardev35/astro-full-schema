---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";
import { pageGraph } from "../lib/schema";

const pageTitle = "เกี่ยวกับเรา PIGAUTO เว็บสล็อตออโต้ไม่มีขั้นต่ำ ฝากถอนตรงไม่ผ่านคนกลาง";

const pageHeading = "เกี่ยวกับเรา PIGAUTO เว็บสล็อตออโต้ไม่มีขั้นต่ำ ฝากถอนตรง ไม่ผ่านคนกลาง";

const pageDescription =
  "เกี่ยวกับเรา PIGAUTO เว็บสล็อตออโต้ไม่มีขั้นต่ำ ที่วางระบบฝากถอนตรงไม่ผ่านคนกลาง รองรับวอเล็ทเต็มระบบ และรวมเกมลิขสิทธิ์แท้จากค่ายใหญ่ระดับสากลไว้ในยูสเดียว";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox as="h1" title={pageHeading}>
    <p class="mb-4 text-left text-base leading-relaxed text-[#f7e2d6]">
      <strong class="text-[#f5c542]">PIGAUTO</strong> เปิดตัวขึ้นมาด้วยความตั้งใจเดียว คือให้ผู้เล่นได้สัมผัสความลื่น ความเร็ว และความจริงใจ ในแบบที่หาได้ยากในวงการเว็บสล็อตออนไลน์ตอนนี้
    </p>

    <p class="mb-4 text-left text-base leading-relaxed text-[#f7e2d6]">
      ฝั่งระบบเป็นไฮเทคเต็มร้อย ส่วนฝั่งบริการเป็นกันเอง ไม่ยัดเยียด และไม่ทิ้งขั้นตอนกวนใจแบบเว็บเก่า ๆ ที่หลายคนเคยเจอมาก่อน
    </p>

    <p class="mb-4 text-left text-base leading-relaxed text-[#f7e2d6]">
      เพราะสิ่งที่ผู้เล่นต้องการจริง ๆ คือเว็บที่เชื่อถือได้ ปลอดภัย โปร่งใส ไม่ซ่อนไม้ซ่อนมือ และฝากถอนที่เร็ว แม่นยำ เฉียบคม
    </p>

    <p class="text-left text-base leading-relaxed text-[#f7e2d6]">ไม่ต้องทักตามยอดจากแอดมิน เพราะระบบทำให้เองตั้งแต่ต้นจนจบ</p>
  </ContentBox>

  <ContentBox as="h2" title="ทำไม PIGAUTO ถึงเป็นเว็บออโต้ที่ผู้เล่นไว้ใจตั้งแต่วันแรก">
    <p class="mb-4 text-left text-base leading-relaxed text-[#f7e2d6]">
      PIGAUTO เป็นแบรนด์ใหม่ก็จริง แต่หัวใจของระบบไม่ใช่มือใหม่ เพราะใช้เทคโนโลยีออโต้ตัวเดียวกับที่คาสิโนระดับอินเตอร์ใช้งานกันอยู่
    </p>

    <p class="mb-4 text-left text-base leading-relaxed text-[#f7e2d6]">
      ทุกอย่างตั้งแต่สมัคร ฝาก ถอน ไปจนถึงการเข้าเล่นเกม จึงทำได้แบบเรียลไทม์ ไม่มีสะดุด และตัดขั้นตอนที่ไม่เป็นมิตรกับสมาชิกออกไป
    </p>

    <p class="mb-4 text-left text-base leading-relaxed text-[#f7e2d6]">
      ทุกขั้นตอนมีระบบชัดเจน โปร่งใส ตรวจสอบได้ และรองรับผู้เล่นพร้อมกันได้จำนวนมาก โดยไม่ต้องคอยตามแอดมินให้เสียเวลา
    </p>

    <p class="text-left text-base leading-relaxed text-[#f7e2d6]">ระบบที่ดีวัดกันตอนคนเข้าเยอะ ไม่ใช่ตอนเว็บว่าง</p>
  </ContentBox>

  <ContentBox as="h2" title="ความเร็วคือคาแรกเตอร์หลักของ PIGAUTO ฝากถอนตรง เฉียบคม">
    <p class="mb-4 text-left text-base leading-relaxed text-[#f7e2d6]">
      จุดเด่นแรกของ PIGAUTO คือความเร็วของระบบออโต้ ฝากปุ๊บเข้าปั๊บ ถอนปุ๊บยอดขึ้นปั๊บทันที ไม่มีคนกลางมาคั่น และไม่มีการพักระบบ
    </p>

    <p class="mb-4 text-left text-base leading-relaxed text-[#f7e2d6]">
      ไม่มีช่วงเวลาอืดให้ต้องกังวลว่ายอดจะเข้าเมื่อไร ระบบถูกสร้างมาเพื่อให้เล่นได้ต่อเนื่อง ไม่ติดขัด และไม่ต้องรีเฟรชหน้าจอทิ้งเวลาไปเปล่า ๆ
    </p>

    <p class="text-left text-base leading-relaxed text-[#f7e2d6]">ใครเคยช้ำใจกับเว็บที่ปรับยอดช้า จะรู้ทันทีว่าต่างกันตรงไหน</p>
  </ContentBox>

  <ContentBox as="h2" title="ไม่มีขั้นต่ำจริงที่ PIGAUTO ฝากเท่าไหร่ ถอนเท่าไหร่ก็ได้">
    <p class="mb-4 text-left text-base leading-relaxed text-[#f7e2d6]">
      หลายเว็บบอกว่าไม่มีขั้นต่ำ แต่พอเล่นจริงกลับมีเงื่อนไขต่อท้ายเต็มไปหมด ที่ PIGAUTO กฎถูกตั้งไว้แบบตรงไปตรงมากว่านั้น
    </p>

    <p class="mb-4 text-left text-base leading-relaxed text-[#f7e2d6]">
      อยากฝากเท่าไหร่ก็ฝากได้ อยากถอนเท่าไหร่ก็ถอนได้ ไม่มีระบบไหนคอยบังคับยอด และไม่ต้องรอให้ครบก้อนถึงจะขยับตัวได้
    </p>

    <p class="mb-4 text-left text-base leading-relaxed text-[#f7e2d6]">
      แนวคิดตั้งต้นคือผู้เล่นทุกคนควรมีสิทธิ์เริ่มต้นเท่ากัน เว็บนี้จึงออกแบบมารองรับทุกงบและทุกสไตล์การเล่น ด้วยมาตรฐานความปลอดภัยชุดเดียวกัน
    </p>

    <p class="text-left text-base leading-relaxed text-[#f7e2d6]">อยากลองเชิงก่อนก็ได้ ไม่ต้องอาย</p>
  </ContentBox>

  <ContentBox as="h2" title="รองรับวอเล็ทเต็มระบบ pig auto wallet ใช้ง่าย โอนไว">
    <p class="mb-4 text-left text-base leading-relaxed text-[#f7e2d6]">
      PIGAUTO รองรับ True Wallet เต็มระบบ สมัครได้โดยไม่ต้องมีบัญชีธนาคาร เหมาะกับผู้เล่นยุคใหม่ที่ไม่อยากผูกบัญชีไว้กับเว็บพนัน
    </p>

    <p class="mb-4 text-left text-base leading-relaxed text-[#f7e2d6]">
      การทำรายการผ่านวอเล็ทเร็วเท่าธนาคาร ไม่มีดีเลย์ เงินเข้าไวเหมือนกันทั้งสองแบบ จึงเลือกช่องทางที่ถนัดได้โดยไม่ต้องแลกกับความเร็ว
    </p>

    <p class="text-left text-base leading-relaxed text-[#f7e2d6]">pig auto wallet มีไว้เพื่อเพิ่มทางเลือก ไม่ใช่เพื่อเพิ่มขั้นตอน</p>
  </ContentBox>

  <ContentBox as="h2" title="รวมเกมแตกง่ายจากค่ายใหญ่ pigauto slot ลิขสิทธิ์แท้">
    <p class="mb-4 text-left text-base leading-relaxed text-[#f7e2d6]">
      แม้จะเป็นแบรนด์ใหม่ แต่ทุกเกมบน PIGAUTO คัดเฉพาะลิขสิทธิ์แท้จากผู้พัฒนาโดยตรง ทั้ง PG Soft, Joker, Pragmatic Play, JILI และค่ายใหญ่ระดับอินเตอร์
    </p>

    <p class="mb-4 text-left text-base leading-relaxed text-[#f7e2d6]">
      ทุกเกมทำงานตามค่า RTP จริง ไม่มีปรับแต้ม ไม่มีปรับเรท และไม่มีการเซตยูสลับหลังบ้านให้ต้องคอยระแวง
    </p>

    <p class="text-left text-base leading-relaxed text-[#f7e2d6]">
      เข้าเล่นเวลาไหนก็ยังลื่นไหล มี bonus time แทบทุกช่วงเวลา จึงเหมาะทั้งกับมือใหม่และสายที่เล่นจริงจังและต้องการระบบที่มั่นคง
    </p>
  </ContentBox>

  <ContentBox as="h2" title="สมัครเข้าระบบในไม่กี่วินาที ง่ายเหมือนเปิดมือถือ">
    <p class="mb-4 text-left text-base leading-relaxed text-[#f7e2d6]">
      ขั้นตอนสมัครไม่ซับซ้อน กรอกข้อมูลไม่กี่อย่างก็พร้อมเข้าเล่นทันที ทั้งหมดเป็นระบบออโต้ กดครั้งเดียวก็เข้าใช้งานได้เลย
    </p>

    <p class="mb-4 text-left text-base leading-relaxed text-[#f7e2d6]">
      ไม่ต้องคุยกับแอดมิน ไม่ต้องส่งบัตร และไม่มีแบบฟอร์มที่ถามข้อมูลมากเกินจำเป็นจนน่าสงสัย
    </p>

    <p class="text-left text-base leading-relaxed text-[#f7e2d6]">เพราะผู้เล่นอยากเข้าเล่น ไม่ได้อยากกรอกฟอร์มสมัครงาน</p>
  </ContentBox>

  <Navfoot />
</MainLayout>
