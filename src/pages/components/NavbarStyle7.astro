---
import { Picture } from "astro:assets";
const images = import.meta.glob<{ default: ImageMetadata }>("../../assets/logo.{png,webp,jpg}", { eager: true });

const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

const currentPath = Astro.url.pathname;

const isActive = (path: string) => {
  if (path === "/") return currentPath === "/";
  return currentPath.startsWith(path);
};
---

<header class="sticky top-0 z-50 w-full font-sans">
  <nav class="relative z-40 w-full border-b border-yellow-500/20 bg-[#09090b]/95 shadow-[0_4px_30px_rgba(0,0,0,0.8)] backdrop-blur-xl">
    <div class="mx-auto flex h-[70px] max-w-7xl items-center justify-between px-4 lg:h-[80px] xl:px-8">
      <div class="flex items-center gap-4">
        <button id="hamburger-btn" class="flex flex-col items-center justify-center space-y-1.5 p-2 lg:hidden" aria-label="Menu">
          <span class="hamburger-line h-[2px] w-6 origin-center rounded-full bg-yellow-500 shadow-[0_0_5px_rgba(234,179,8,0.5)] transition-all duration-300"></span>
          <span class="hamburger-line h-[2px] w-6 rounded-full bg-yellow-500 shadow-[0_0_5px_rgba(234,179,8,0.5)] transition-all duration-300"></span>
          <span class="hamburger-line h-[2px] w-6 origin-center rounded-full bg-yellow-500 shadow-[0_0_5px_rgba(234,179,8,0.5)] transition-all duration-300"></span>
        </button>

        <a href="/" class="flex-shrink-0 transition-transform hover:scale-105">
          <Picture
            src={mainLogo!}
            alt="VIP Logo"
            loading="eager"
            fetchpriority="high"
            class="h-[35px] w-auto drop-shadow-[0_0_10px_rgba(255,255,255,0.1)] lg:h-[45px]"
            formats={["avif", "webp"]}
            fallbackFormat="webp"
          />
        </a>
      </div>

      <div class="hidden h-full items-center justify-center gap-8 lg:flex xl:gap-12">
        <a href="/" class="group relative flex h-full flex-col items-center justify-center text-sm font-bold transition-all xl:text-base">
          <span class={`transition-colors duration-300 ${isActive("/") ? "text-yellow-400 drop-shadow-[0_0_8px_rgba(234,179,8,0.5)]" : "text-gray-400 group-hover:text-yellow-200"}`}>หน้าแรก</span>
          <div
            class={`absolute bottom-5 w-1.5 h-1.5 rounded-full bg-yellow-400 transition-all duration-300 ${isActive("/") ? "opacity-100 scale-100 shadow-[0_0_10px_rgba(234,179,8,1)]" : "opacity-0 scale-0 group-hover:opacity-100 group-hover:scale-100"}`}>
          </div>
        </a>

        <a href="/promotion" class="group relative flex h-full flex-col items-center justify-center text-sm font-bold transition-all xl:text-base">
          <span class={`transition-colors duration-300 ${isActive("/promotion") ? "text-yellow-400 drop-shadow-[0_0_8px_rgba(234,179,8,0.5)]" : "text-gray-400 group-hover:text-yellow-200"}`}>
            โปรโมชั่น
          </span>
          <div
            class={`absolute bottom-5 w-1.5 h-1.5 rounded-full bg-yellow-400 transition-all duration-300 ${isActive("/promotion") ? "opacity-100 scale-100 shadow-[0_0_10px_rgba(234,179,8,1)]" : "opacity-0 scale-0 group-hover:opacity-100 group-hover:scale-100"}`}>
          </div>
        </a>

        <a href="/gamedemo" class="group relative flex h-full flex-col items-center justify-center text-sm font-bold transition-all xl:text-base">
          <span class={`transition-colors duration-300 ${isActive("/gamedemo") ? "text-yellow-400 drop-shadow-[0_0_8px_rgba(234,179,8,0.5)]" : "text-gray-400 group-hover:text-yellow-200"}`}>
            ทดลองเล่น
          </span>
          <div
            class={`absolute bottom-5 w-1.5 h-1.5 rounded-full bg-yellow-400 transition-all duration-300 ${isActive("/gamedemo") ? "opacity-100 scale-100 shadow-[0_0_10px_rgba(234,179,8,1)]" : "opacity-0 scale-0 group-hover:opacity-100 group-hover:scale-100"}`}>
          </div>
        </a>

        <a href="/gamelogin" class="group relative flex h-full flex-col items-center justify-center text-sm font-bold transition-all xl:text-base">
          <span class={`transition-colors duration-300 ${isActive("/gamelogin") ? "text-yellow-400 drop-shadow-[0_0_8px_rgba(234,179,8,0.5)]" : "text-gray-400 group-hover:text-yellow-200"}`}>
            ทางเข้า
          </span>
          <div
            class={`absolute bottom-5 w-1.5 h-1.5 rounded-full bg-yellow-400 transition-all duration-300 ${isActive("/gamelogin") ? "opacity-100 scale-100 shadow-[0_0_10px_rgba(234,179,8,1)]" : "opacity-0 scale-0 group-hover:opacity-100 group-hover:scale-100"}`}>
          </div>
        </a>

        <a href="/contact" class="group relative flex h-full flex-col items-center justify-center text-sm font-bold transition-all xl:text-base">
          <span class={`transition-colors duration-300 ${isActive("/contact") ? "text-yellow-400 drop-shadow-[0_0_8px_rgba(234,179,8,0.5)]" : "text-gray-400 group-hover:text-yellow-200"}`}>
            ติดต่อเรา
          </span>
          <div
            class={`absolute bottom-5 w-1.5 h-1.5 rounded-full bg-yellow-400 transition-all duration-300 ${isActive("/contact") ? "opacity-100 scale-100 shadow-[0_0_10px_rgba(234,179,8,1)]" : "opacity-0 scale-0 group-hover:opacity-100 group-hover:scale-100"}`}>
          </div>
        </a>
      </div>

      <div class="flex items-center gap-3">
        <a
          href="/signin"
          class="hidden items-center justify-center rounded-full border border-yellow-500/30 bg-transparent px-6 py-2.5 text-sm font-bold text-yellow-500 transition-all hover:bg-yellow-500/10 md:flex">
          เข้าสู่ระบบ
        </a>
        <a
          href="/signup"
          class="flex items-center justify-center rounded-full bg-gradient-to-r from-yellow-600 via-yellow-400 to-yellow-600 bg-[length:200%_auto] px-5 py-2 text-xs font-extrabold text-black shadow-[0_0_20px_rgba(234,179,8,0.3)] transition-all hover:bg-right hover:shadow-[0_0_25px_rgba(234,179,8,0.5)] hover:brightness-110 lg:px-7 lg:py-2.5 lg:text-sm">
          สมัครสมาชิก
        </a>
      </div>
    </div>
  </nav>

  <div id="mobile-overlay" class="pointer-events-none fixed inset-0 z-50 bg-black/80 opacity-0 backdrop-blur-sm transition-opacity duration-400 lg:hidden"></div>

  <div
    id="mobile-bottom-sheet"
    class="pb-safe fixed bottom-0 left-0 z-[60] w-full translate-y-full transform rounded-t-3xl border-t border-yellow-500/30 bg-[#121216] shadow-[0_-10px_40px_rgba(0,0,0,0.8)] transition-transform duration-400 ease-[cubic-bezier(0.3,1,0.3,1)] lg:hidden">
    <div class="flex w-full cursor-pointer justify-center pt-3 pb-2" id="close-sheet-btn">
      <div class="h-1.5 w-12 rounded-full bg-gray-600"></div>
    </div>

    <div class="flex flex-col space-y-2 px-6 pt-2 pb-8">
      <a
        href="/"
        class={`sheet-item flex items-center justify-between px-5 py-4 rounded-2xl transition-all ${isActive("/") ? "bg-gradient-to-r from-yellow-500/20 to-transparent border border-yellow-500/30 text-yellow-400" : "bg-white/5 border-transparent text-gray-300 hover:bg-white/10"}`}>
        <div class="flex items-center gap-4">
          <span class="text-2xl drop-shadow-lg">🏠</span>
          <span class="text-base font-bold tracking-wide">หน้าแรก</span>
        </div>
        {isActive("/") && <span class="h-2 w-2 rounded-full bg-yellow-400 shadow-[0_0_8px_rgba(234,179,8,1)]" />}
      </a>

      <a
        href="/promotion"
        class={`sheet-item flex items-center justify-between px-5 py-4 rounded-2xl transition-all ${isActive("/promotion") ? "bg-gradient-to-r from-yellow-500/20 to-transparent border border-yellow-500/30 text-yellow-400" : "bg-white/5 border-transparent text-gray-300 hover:bg-white/10"}`}>
        <div class="flex items-center gap-4">
          <span class="text-2xl drop-shadow-lg">🎁</span>
          <span class="text-base font-bold tracking-wide">โปรโมชั่น</span>
        </div>
        {isActive("/promotion") && <span class="h-2 w-2 rounded-full bg-yellow-400 shadow-[0_0_8px_rgba(234,179,8,1)]" />}
      </a>

      <a
        href="/gamedemo"
        class={`sheet-item flex items-center justify-between px-5 py-4 rounded-2xl transition-all ${isActive("/gamedemo") ? "bg-gradient-to-r from-yellow-500/20 to-transparent border border-yellow-500/30 text-yellow-400" : "bg-white/5 border-transparent text-gray-300 hover:bg-white/10"}`}>
        <div class="flex items-center gap-4">
          <span class="text-2xl drop-shadow-lg">🎰</span>
          <span class="text-base font-bold tracking-wide">ทดลองเล่น</span>
        </div>
        {isActive("/gamedemo") && <span class="h-2 w-2 rounded-full bg-yellow-400 shadow-[0_0_8px_rgba(234,179,8,1)]" />}
      </a>

      <a
        href="/gamelogin"
        class={`sheet-item flex items-center justify-between px-5 py-4 rounded-2xl transition-all ${isActive("/gamelogin") ? "bg-gradient-to-r from-yellow-500/20 to-transparent border border-yellow-500/30 text-yellow-400" : "bg-white/5 border-transparent text-gray-300 hover:bg-white/10"}`}>
        <div class="flex items-center gap-4">
          <span class="text-2xl drop-shadow-lg">🌐</span>
          <span class="text-base font-bold tracking-wide">ทางเข้า</span>
        </div>
        {isActive("/gamelogin") && <span class="h-2 w-2 rounded-full bg-yellow-400 shadow-[0_0_8px_rgba(234,179,8,1)]" />}
      </a>

      <a
        href="/contact"
        class={`sheet-item flex items-center justify-between px-5 py-4 rounded-2xl transition-all ${isActive("/contact") ? "bg-gradient-to-r from-yellow-500/20 to-transparent border border-yellow-500/30 text-yellow-400" : "bg-white/5 border-transparent text-gray-300 hover:bg-white/10"}`}>
        <div class="flex items-center gap-4">
          <span class="text-2xl drop-shadow-lg">📞</span>
          <span class="text-base font-bold tracking-wide">ติดต่อเรา</span>
        </div>
        {isActive("/contact") && <span class="h-2 w-2 rounded-full bg-yellow-400 shadow-[0_0_8px_rgba(234,179,8,1)]" />}
      </a>

      <div class="mt-2 grid grid-cols-2 gap-3 border-t border-white/5 pt-4">
        <a href="/signin" class="flex items-center justify-center rounded-xl border border-yellow-500/30 bg-yellow-500/5 py-3.5 text-sm font-bold text-yellow-500">เข้าสู่ระบบ</a>
        <a
          href="/signup"
          class="flex items-center justify-center rounded-xl bg-gradient-to-r from-yellow-600 to-yellow-400 py-3.5 text-sm font-extrabold text-black shadow-[0_0_15px_rgba(234,179,8,0.4)]">
          สมัครสมาชิก
        </a>
      </div>
    </div>
  </div>
</header>

<style is:global>
  /* Hamburger อนิเมชั่น (กลายเป็น X) */
  #hamburger-btn.active .hamburger-line:nth-child(1) {
    transform: translateY(8px) rotate(45deg);
  }
  #hamburger-btn.active .hamburger-line:nth-child(2) {
    opacity: 0;
    transform: scaleX(0);
  }
  #hamburger-btn.active .hamburger-line:nth-child(3) {
    transform: translateY(-8px) rotate(-45deg);
  }

  /* อนิเมชั่นเด้งไล่ระดับของเมนูใน Bottom Sheet */
  .sheet-item {
    opacity: 0;
    transform: translateY(20px); /* วิ่งขึ้นมาจากข้างล่าง */
    transition: all 0.4s cubic-bezier(0.3, 1, 0.3, 1);
  }

  /* คลาสโชว์ที่จะถูกยัดเข้ามาทาง JS */
  .sheet-item.item-show {
    opacity: 1;
    transform: translateY(0);
  }

  /* หน่วงเวลาเด้ง */
  .sheet-item:nth-child(1) {
    transition-delay: 0.1s;
  }
  .sheet-item:nth-child(2) {
    transition-delay: 0.15s;
  }
  .sheet-item:nth-child(3) {
    transition-delay: 0.2s;
  }
  .sheet-item:nth-child(4) {
    transition-delay: 0.25s;
  }
  .sheet-item:nth-child(5) {
    transition-delay: 0.3s;
  }

  /* รองรับขอบจอล่างของ iPhone (Safe Area) */
  .pb-safe {
    padding-bottom: env(safe-area-inset-bottom, 20px);
  }
</style>

<script>
  // 🌟 ใช้ JS ควบคุม Tailwind Classes สำหรับ Bottom Sheet
  const hamburgerBtn = document.getElementById("hamburger-btn");
  const overlay = document.getElementById("mobile-overlay");
  const bottomSheet = document.getElementById("mobile-bottom-sheet");
  const sheetItems = document.querySelectorAll(".sheet-item");
  const closeBtn = document.getElementById("close-sheet-btn");

  const toggleSheet = () => {
    // 1. สลับปุ่ม Hamburger
    hamburgerBtn?.classList.toggle("active");

    // 2. ดันแผ่นเมนูขึ้นมา (สลับ translate-y-full กับ translate-y-0)
    bottomSheet?.classList.toggle("translate-y-full");
    bottomSheet?.classList.toggle("translate-y-0");

    // 3. โชว์ฟิล์มดำ
    overlay?.classList.toggle("opacity-0");
    overlay?.classList.toggle("opacity-100");
    overlay?.classList.toggle("pointer-events-none");
    overlay?.classList.toggle("pointer-events-auto");

    // 4. ล็อกหน้าจอ & เล่นอนิเมชันตัวหนังสือ
    if (bottomSheet?.classList.contains("translate-y-0")) {
      document.body.style.overflow = "hidden";
      sheetItems.forEach((item) => item.classList.add("item-show"));
    } else {
      document.body.style.overflow = "";
      sheetItems.forEach((item) => item.classList.remove("item-show"));
    }
  };

  // ผูก Event การกดปุ่ม
  hamburgerBtn?.addEventListener("click", toggleSheet);
  overlay?.addEventListener("click", toggleSheet);
  closeBtn?.addEventListener("click", toggleSheet); // กดที่ขีดด้านบนเพื่อปิดได้ด้วย

  // ปิดเมนูเมื่อกดเลือกลิงก์
  sheetItems.forEach((item) => {
    item.addEventListener("click", () => {
      if (bottomSheet?.classList.contains("translate-y-0")) {
        toggleSheet();
      }
    });
  });
</script>
