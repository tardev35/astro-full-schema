---
const { titleleft, titleright } = Astro.props;
---

<section class="mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="w-full rounded-[25px] bg-[#141414] p-8 shadow-[10px_10px_20px_#080808,-10px_-10px_20px_#202020] transition-all duration-300 hover:shadow-[15px_15px_30px_#050505,-15px_-15px_30px_#2a2a2a]">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <article class="flex flex-col gap-4">
        {titleleft && <h2 class="text-2xl font-black tracking-wide text-white">{titleleft}</h2>}
        <div class="text-base leading-relaxed text-gray-400">
          <slot name="left" />
        </div>
      </article>

      <article class="flex flex-col gap-4 md:border-l md:border-white/5 md:pl-8">
        {titleright && <h2 class="text-2xl font-black tracking-wide text-white">{titleright}</h2>}
        <div class="text-base leading-relaxed text-gray-400">
          <slot name="right" />
        </div>
      </article>
    </div>
  </div>
</section>

<style>
  .font-sans {
    font-family: "Kanit", sans-serif;
  }
</style>
