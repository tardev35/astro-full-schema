---
export interface FaqItem {
  q: string;
  a: string;
}

export interface Props {
  title?: string;
  faqs?: FaqItem[];
}

const { title, faqs = [] } = Astro.props;
---

<div class="mx-auto max-w-[1000px] px-4 py-10 font-sans">
  {
    title && (
      <div
        class="mb-8 flex items-center gap-3 border-l-4 border-[#2fe35f] bg-gradient-to-r from-[#0c1f13] via-[#0c1f13]/60 to-transparent px-4 py-2.5"
        style="clip-path: polygon(0 0, 100% 0, calc(100% - 15px) 100%, 0 100%);">
        <h2 class="text-xl leading-normal font-black tracking-widest text-[#7bff9f] uppercase md:text-2xl">{title}</h2>
      </div>
    )
  }

  <div class="space-y-4">
    {
      faqs.map((faq) => (
        <details
          name="faq-terminal"
          class="faq-item group relative overflow-hidden border border-[#2fe35f]/25 bg-[#0a1a10]/92 backdrop-blur-sm transition-all duration-300 hover:border-[#2fe35f]/50 hover:shadow-[0_15px_40px_rgba(47,227,95,0.30)]"
          style="clip-path: polygon(15px 0, 100% 0, 100% calc(100% - 15px), calc(100% - 15px) 100%, 0 100%, 0 15px);">
          <div aria-hidden="true" class="absolute top-0 left-0 h-[2px] w-16 bg-gradient-to-r from-[#f0c43a] to-transparent" />

          <summary class="flex w-full cursor-pointer items-center justify-between p-5 text-left transition-all">
            <h3 class="flex items-center gap-2 text-base leading-normal font-bold text-[#ddf3e2] transition-colors group-hover:text-[#7bff9f] md:text-lg">
              <span aria-hidden="true" class="font-mono text-[#f0c43a]">
                &gt;_
              </span>
              {faq.q}
            </h3>

            <span
              aria-hidden="true"
              class="faq-icon ml-4 flex h-8 w-8 shrink-0 items-center justify-center border border-[#2fe35f]/30 bg-[#0c1f13] text-lg font-black text-[#2fe35f] transition-all duration-300 group-hover:border-[#2fe35f]/50 group-hover:text-[#7bff9f]"
              style="clip-path: polygon(25% 0, 100% 0, 100% 75%, 75% 100%, 0 100%, 0 25%);">
              +
            </span>
          </summary>

          <div class="faq-answer border-t border-[#0b6b34]/60 p-5 pt-4 text-left text-base leading-relaxed text-[#ddf3e2]">{faq.a}</div>
        </details>
      ))
    }
  </div>
</div>

<style>
  .faq-item > summary {
    list-style: none;
  }
  .faq-item > summary::-webkit-details-marker {
    display: none;
  }
  .faq-item[open] {
    border-color: rgba(47, 227, 95, 0.6);
    box-shadow: 0 15px 40px rgba(47, 227, 95, 0.3);
  }
  .faq-item[open] .faq-icon {
    transform: rotate(45deg);
    border-color: #2fe35f;
    color: #7bff9f;
  }
  .faq-item[open] .faq-answer {
    animation: faq-reveal 0.25s ease-out;
  }

  @keyframes faq-reveal {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-item[open] .faq-answer {
      animation: none;
    }
  }
</style>
