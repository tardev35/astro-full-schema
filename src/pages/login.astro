---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementCyber.astro";
import CtaRedirect from "../components/CtaRedirect.astro";
import { pageGraph } from "../lib/schema";

const pageDescription =
  "หน้าเข้าสู่ระบบ DOLLAR789 รวมปุ่มล็อกอินเข้ายูสเดิมไว้จุดเดียว กดเพื่อไปยังหน้าล็อกอินของเว็บหลัก ใช้ได้ทั้งมือถือและคอม เลือกเกมและฝากถอนออโต้ต่อได้ทันที";

const graph = pageGraph(Astro, {
  name: "เข้าสู่ระบบ DOLLAR789 คาสิโนสด บาคาร่า สล็อต",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เข้าสู่ระบบ", path: "/login" },
  ],
});

const targetUrl = "https://yoalink.com/22hs";
---

<MainLayout title="เข้าสู่ระบบ DOLLAR789 | ปุ่มล็อกอินเข้าเล่นคาสิโนสด บาคาร่า สล็อต" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="เข้าสู่ระบบ DOLLAR789" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label="เข้าสู่ระบบ DOLLAR789"
        class="group relative mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#4c1d95]/60 bg-gradient-to-b from-[#a855f7] to-[#4c1d95] px-6 py-4 text-xl font-bold tracking-wide text-[#ffe9a8] shadow-[0_10px_30px_rgba(168,85,247,0.18)] transition-all duration-300 hover:scale-105 hover:border-[#f5c542]/70 hover:shadow-[0_15px_40px_rgba(245,197,66,0.24)]">
        เข้าสู่ระบบ DOLLAR789
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="เข้าสู่ระบบ" />
</MainLayout>
