---
import { isActivePath } from "../lib/nav";
import { Picture } from "astro:assets";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });
const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;
const currentPath = Astro.url.pathname;
const isActive = (path: string) => isActivePath(currentPath, path);

const logoAlt = "โลโก้หัวเสือ TG787 เสือคำรามสีส้มขาวในกรอบสามเหลี่ยมสีส้ม ตัวอักษรสีขาวขอบดำ และเลข 787 สีส้มตัวใหญ่";

const affUrl = "https://yoalink.com/22hs";

const links = [
  { name: "หน้าแรก", path: "/", icon: "🏠" },
  { name: "โปรโมชั่น", path: "/promotion/", icon: "🎁" },
  { name: "ทดลองเล่น", path: "/ทดลองเล่น/", icon: "🎰" },
  { name: "วิธีฝากถอน", path: "/วิธีฝากถอน/", icon: "💳" },
  { name: "เกี่ยวกับเรา", path: "/about-us/", icon: "🐯" },
  { name: "ติดต่อเรา", path: "/contact-us/", icon: "💬" },
];
---

<div class="hidden w-full border-b border-[#f47b20]/30 bg-gradient-to-r from-[#120c08] via-[#2a1d14] to-[#120c08] px-4 py-1.5 font-sans text-xs font-bold text-[#d9bfa8] lg:block">
  <div class="mx-auto flex max-w-[1400px] justify-between">
    <div class="flex gap-4">
      <span class="flex items-center gap-1"><span aria-hidden="true" class="text-[#ffa94d]">🃏</span> TG787 คาสิโนออนไลน์ถ่ายทอดสดควบคู่สล็อตเว็บตรง</span>
      <span class="flex items-center gap-1 text-[#ffc94a]"><span aria-hidden="true">⚡</span> ฝากถอนไม่มีขั้นต่ำ ระบบออโต้เสร็จใน 3 นาที ตลอด 24 ชั่วโมง</span>
    </div>
    <div class="flex gap-4">
      <a href="/line/" class="flex items-center gap-1 transition-colors hover:text-[#ffa94d]">ติดต่อแอดมิน TG787 ผ่าน LINE Official</a>
    </div>
  </div>
</div>

<header class="sticky top-2 z-50 mt-2 w-full px-2 font-sans md:px-4">
  <nav
    class="relative isolate mx-auto flex h-[75px] w-full max-w-[1400px] items-center justify-between overflow-hidden rounded-[20px] border border-[#f47b20]/45 bg-[#1a120c]/95 px-4 shadow-[0_10px_30px_rgba(31,22,17,0.35)] xl:px-8">
    <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 bottom-0 -z-10 h-[4px] bg-[repeating-linear-gradient(135deg,#1f1611_0_8px,#f47b20_8px_18px)] opacity-90"></div>
    <a href="/" class="z-50 flex-shrink-0 transition-transform hover:scale-105">
      {
        mainLogo ? (
          <Picture
            src={mainLogo}
            alt={logoAlt}
            loading="eager"
            fetchpriority="high"
            widths={[100, 200, 300]}
            sizes="100px"
            class="h-[48px] w-auto drop-shadow-[0_0_10px_rgba(244,123,32,0.45)] xl:h-[54px]"
            formats={["avif", "webp"]}
            fallbackFormat="webp"
          />
        ) : (
          <span class="bg-gradient-to-b from-[#ffc94a] to-[#f47b20] bg-clip-text text-3xl font-black text-transparent">TG787</span>
        )
      }
    </a>

    <div class="hidden h-full items-center gap-4 xl:flex 2xl:gap-6">
      {
        links.map((item) => (
          <a
            href={item.path}
            class={`group relative flex h-full items-center gap-1.5 text-sm font-bold tracking-wide transition-colors ${isActive(item.path) ? "text-[#ffa94d]" : "text-[#fff1e4]/85 hover:text-[#ffc94a]"}`}>
            <span aria-hidden="true" class="text-base">
              {item.icon}
            </span>
            <span>{item.name}</span>
            <div
              class={`absolute bottom-[18px] left-0 h-[2px] w-full origin-center bg-gradient-to-r from-[#f47b20] via-[#ffc94a] to-[#f47b20] transition-transform duration-300 ${isActive(item.path) ? "scale-x-100" : "scale-x-0 group-hover:scale-x-100"}`}
            />
          </a>
        ))
      }
    </div>

    <div class="z-50 flex items-center gap-3">
      <a
        href={affUrl}
        rel="nofollow sponsored"
        class="hidden items-center justify-center gap-1.5 rounded-full border-2 border-white/70 bg-gradient-to-b from-[#3d8bf0] to-[#1557b0] px-5 py-2 text-sm font-bold text-white shadow-[0_8px_22px_rgba(31,111,214,0.35)] transition-all hover:brightness-110 xl:flex">
        <span aria-hidden="true">🔑</span> เข้าสู่ระบบ
      </a>
      <a
        href={affUrl}
        rel="nofollow sponsored"
        class="hidden items-center justify-center gap-1.5 rounded-full border-2 border-[#ffe3b8] bg-gradient-to-b from-[#ffc94a] via-[#f47b20] to-[#c85a0c] px-5 py-2 text-sm font-black text-[#2a1300] shadow-[0_8px_22px_rgba(244,123,32,0.40)] transition-all hover:scale-105 xl:flex">
        <span aria-hidden="true">📝</span> สมัครสมาชิก
      </a>

      <button
        id="hamburger-btn"
        class="relative flex h-[42px] w-[42px] flex-col items-center justify-center gap-[5px] rounded-full border border-[#f47b20]/45 bg-gradient-to-b from-[#2a1d14] to-[#120c08] shadow-sm xl:hidden"
        aria-label="เปิดเมนูหลัก">
        <span class="line-1 h-[2px] w-5 origin-center rounded-full bg-[#ffa94d] transition-all duration-300"></span>
        <span class="line-2 h-[2px] w-5 origin-center rounded-full bg-[#ffa94d] transition-all duration-300"></span>
        <span class="line-3 h-[2px] w-5 origin-center rounded-full bg-[#ffa94d] transition-all duration-300"></span>
      </button>
    </div>
  </nav>

  <div id="fullscreen-menu" class="pointer-events-none fixed inset-0 z-[40] flex flex-col items-center justify-center bg-[#120c08]/98 opacity-0 transition-opacity duration-500">
    <div class="flex w-full flex-col items-center space-y-4 px-6">
      {
        links.map((item) => (
          <a
            href={item.path}
            class={`fs-item flex items-center gap-3 text-2xl font-black tracking-wide transition-all duration-300 ${isActive(item.path) ? "text-[#ffa94d]" : "text-[#fff1e4]/85 hover:text-[#ffc94a]"}`}>
            <span aria-hidden="true" class="text-2xl">
              {item.icon}
            </span>
            {item.name}
          </a>
        ))
      }
      <div class="fs-item mt-4 flex w-full max-w-[280px] flex-col gap-4 pt-6">
        <a
          href={affUrl}
          rel="nofollow sponsored"
          class="flex w-full items-center justify-center gap-2 rounded-full border-2 border-white/70 bg-gradient-to-b from-[#3d8bf0] to-[#1557b0] py-3.5 text-lg font-bold text-white shadow-[0_8px_22px_rgba(31,111,214,0.35)]">
          <span aria-hidden="true">🔑</span> เข้าสู่ระบบ
        </a>
        <a
          href={affUrl}
          rel="nofollow sponsored"
          class="flex w-full items-center justify-center gap-2 rounded-full border-2 border-[#ffe3b8] bg-gradient-to-b from-[#ffc94a] via-[#f47b20] to-[#c85a0c] py-3.5 text-lg font-black text-[#2a1300] shadow-[0_8px_22px_rgba(244,123,32,0.40)]">
          <span aria-hidden="true">📝</span> สมัครสมาชิก
        </a>
      </div>
    </div>
  </div>
</header>

<style is:global>
  #hamburger-btn.active .line-1 {
    transform: translateY(7px) rotate(45deg);
  }
  #hamburger-btn.active .line-2 {
    opacity: 0;
  }
  #hamburger-btn.active .line-3 {
    transform: translateY(-7px) rotate(-45deg);
  }
  .fs-item {
    opacity: 0;
    transform: translateY(20px);
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .fs-item.show {
    opacity: 1;
    transform: translateY(0);
  }
  .fs-item:nth-child(1) {
    transition-delay: 0.1s;
  }
  .fs-item:nth-child(2) {
    transition-delay: 0.15s;
  }
  .fs-item:nth-child(3) {
    transition-delay: 0.2s;
  }
  .fs-item:nth-child(4) {
    transition-delay: 0.25s;
  }
  .fs-item:nth-child(5) {
    transition-delay: 0.3s;
  }
  .fs-item:nth-child(6) {
    transition-delay: 0.35s;
  }
  .fs-item:nth-child(7) {
    transition-delay: 0.4s;
  }
  .fs-item:nth-child(8) {
    transition-delay: 0.45s;
  }

  @media (prefers-reduced-motion: reduce) {
    .fs-item {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  const hamburgerBtn = document.getElementById("hamburger-btn");
  const fsMenu = document.getElementById("fullscreen-menu");
  const fsItems = document.querySelectorAll(".fs-item");

  const toggleFsMenu = () => {
    hamburgerBtn?.classList.toggle("active");
    fsMenu?.classList.toggle("opacity-0");
    fsMenu?.classList.toggle("pointer-events-none");

    if (!fsMenu?.classList.contains("opacity-0")) {
      document.body.style.overflow = "hidden";
      fsItems.forEach((item) => item.classList.add("show"));
    } else {
      document.body.style.overflow = "";
      fsItems.forEach((item) => item.classList.remove("show"));
    }
  };

  hamburgerBtn?.addEventListener("click", toggleFsMenu);
  fsItems.forEach((item) => {
    item.addEventListener("click", () => {
      if (!fsMenu?.classList.contains("opacity-0")) toggleFsMenu();
    });
  });
</script>
