---
import { Picture } from "astro:assets";

import slide1 from "../assets/slide1.png";
import slide2 from "../assets/slide2.png";
import slide3 from "../assets/slide3.png";
import slide4 from "../assets/slide4.png";

const images = [
  {
    src: slide1,
    alt: "ภาพโปรโมชั่น AMBHENG88 พื้นม่วงเข้มขอบทอง มีป้าย EXCLUSIVE และเพชรสีชมพูด้านบน ข้อความ ฝากรับโบนัสเพิ่ม 10% สิทธิประโยชน์พิเศษเฉพาะท่าน มูลค่าสูงสุดรับเพิ่มได้ถึง 500 บาท ครอบคลุมทั้งสมาชิกเก่าและสมาชิกใหม่ ยอดฝากขั้นต่ำเพียง 100 บาทต่อบิล ทำเทิร์น 8 เท่า ถอนสูงสุด 5 เท่า พร้อมตรา VIP EXCLUSIVE",
  },
  {
    src: slide2,
    alt: "ภาพโปรโมชั่น AMBHENG88 พื้นม่วงเข้มลายเฟืองทอง ข้อความ โบนัสฝาก 50% ด้านบน โลโก้ AMBHENG88 อยู่กลางภาพ ล้อมด้วยไพ่ ชิปคาสิโน ตู้สล็อตเลข 777 และหีบสมบัติเหรียญทอง ระบุเงื่อนไข ฝาก 1,000 บาทขึ้นไป รับโบนัส 50% สูงสุด 10,000 บาท ทำเทิร์น 5 เท่า ถอนสูงสุด 2 เท่า",
  },
  {
    src: slide3,
    alt: "ภาพโปรโมชั่น AMBHENG88 ฉากเมืองนีออนสีชมพู โลโก้ AMBHENG88 มุมขวาบน พรีเซนเตอร์หญิงผมชมพูยกมือทักทาย ข้อความ หวย อัตราจ่ายที่ดีที่สุด 3 ตัว บาทละ 1,000 บาท 2 ตัว บาทละ 100 บาท ถูกตรง จ่ายจริง รับเงินรางวัลหลักล้าน ครบจบเรื่องหวยในเว็บเดียว รัฐบาล ลาว ฮานอย หุ้น ยี่กี",
  },
  {
    src: slide4,
    alt: "ภาพโปรโมชั่น AMBHENG88 ฉากเมืองนีออน โลโก้ AMBHENG88 มุมขวาบน พรีเซนเตอร์หญิงสวมแจ็กเก็ตชมพูทำมือเป็นรูปหัวใจ ข้อความ ครบจบในที่เดียว พร้อมปุ่มสี่ปุ่ม หวย บาคาร่า บอล สล็อต และแถบติ๊กถูกด้านล่าง บอล คาสิโน สล็อต ยิงปลา ไก่ชน มวย ไฮโล รูเล็ต",
  },
];

const COPIES = 3;
const slides = Array.from({ length: COPIES }, () => images).flat();
---

<div class="marquee mx-auto w-full max-w-7xl overflow-hidden px-4 py-5">
  <input id="carousel-pause" type="checkbox" class="peer sr-only" />
  <label
    for="carousel-pause"
    class="sr-only cursor-pointer peer-focus-visible:not-sr-only peer-focus-visible:mb-3 peer-focus-visible:inline-block peer-focus-visible:rounded-full peer-focus-visible:border peer-focus-visible:border-[#ff2d8e]/55 peer-focus-visible:bg-[#170512] peer-focus-visible:px-4 peer-focus-visible:py-2 peer-focus-visible:text-sm peer-focus-visible:font-bold peer-focus-visible:text-[#ff74b6]">
    หยุด / เล่นสไลด์ภาพ
  </label>

  <div class="marquee-track flex">
    {
      slides.map((slide, index) => {
        const isDuplicate = index >= images.length;
        return (
          <div class="marquee-slide" aria-hidden={isDuplicate ? "true" : undefined}>
            <Picture
              src={slide.src}
              alt={isDuplicate ? "" : slide.alt}
              class="block w-full rounded-xl border border-[#4a1030] object-cover shadow-[0_10px_30px_rgba(255,45,142,0.18)]"
              width={slide.src.width}
              height={slide.src.height}
              loading="lazy"
              fetchpriority="low"
              decoding="async"
              widths={[300, 360, 420, 480, 540, 600]}
              sizes="(max-width: 767px) calc(100vw - 32px), (max-width: 1279px) calc((100vw - 48px) / 2), 403px"
              formats={["avif", "webp"]}
              fallbackFormat="webp"
              quality={60}
            />
          </div>
        );
      })
    }
  </div>
</div>

<style>
  .marquee {
    --gap: 12px;
    --per-view: 1;
    --shift: calc(-400% - 48px);
  }

  @media (min-width: 768px) {
    .marquee {
      --gap: 16px;
      --per-view: 2;
      --shift: calc(-200% - 32px);
    }
  }

  @media (min-width: 1280px) {
    .marquee {
      --gap: 20px;
      --per-view: 3;
      --shift: calc(-133.3333% - 26.6667px);
    }
  }

  .marquee-track {
    gap: var(--gap);
    width: 100%;
    animation: carousel-scroll 40s linear infinite;
    will-change: transform;
  }

  .marquee-slide {
    flex: 0 0 calc((100% - (var(--per-view) - 1) * var(--gap)) / var(--per-view));
  }

  @keyframes carousel-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(var(--shift));
    }
  }

  .marquee:hover .marquee-track,
  .marquee:focus-within .marquee-track,
  .marquee > input:checked ~ .marquee-track {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
    }
  }
</style>
