---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement4.astro";
import Faq3 from "../components/Faq3.astro";
import IconTiles from "../components/IconTiles.astro";
import ProviderCards from "../components/ProviderCards.astro";
import CtaBand from "../components/CtaBand.astro";
import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import imgFishing from "../assets/cat-fishing.webp";
