---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";
import CtaRedirect from "../components/CtaRedirect.astro";
import { pageGraph } from "../lib/schema";

const pageDescription =
  "หน้าเข้าสู่ระบบ ONEHENG89 รวมปุ่มล็อกอินเข้าบัญชีเดิมไว้จุดเดียว กดแล้วไปยังหน้าล็อกอินเว็บหลัก ใช้ได้ทั้งมือถือและคอม เพื่อเลือกเกมสล็อต ดูโบนัส และฝากถอนออโต้";

const graph = pageGraph(Astro, {
  name: "เข้าสู่ระบบ ONEHENG89 เว็บสล็อตลิขสิทธิ์แท้",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เข้าสู่ระบบ", path: "/login" },
  ],
});

const targetUrl = "https://yoalink.com/22hs";
---

<MainLayout title="เข้าสู่ระบบ ONEHENG89 | ปุ่มล็อกอินเข้าเล่นสล็อตลิขสิทธิ์แท้" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="เข้าสู่ระบบ ONEHENG89" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label="เข้าสู่ระบบ ONEHENG89"
        class="group relative mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#062c85]/60 bg-gradient-to-b from-[#0b3fb8] to-[#062c85] px-6 py-4 text-xl font-bold tracking-wide text-white shadow-[0_10px_30px_rgba(11,63,184,0.18)] transition-all duration-300 hover:scale-105 hover:border-[#16a34a]/70 hover:shadow-[0_15px_40px_rgba(22,163,74,0.24)]">
        เข้าสู่ระบบ ONEHENG89
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="เข้าสู่ระบบ" />
</MainLayout>
