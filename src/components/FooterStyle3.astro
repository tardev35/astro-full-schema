---
import { Picture } from "astro:assets";
import BankStrip from "./BankStrip.astro";
import { BRAND_ADDRESS } from "../lib/brandProfile";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });

const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

const quickLinks = [
  { name: "หน้าแรก", path: "/" },
  { name: "ทดลองเล่นเกมฟรี", path: "/ทดลองเล่น" },
  { name: "โปรโมชั่นสมาชิกใหม่", path: "/promotion" },
  { name: "ทางเข้าล่าสุด", path: "/ทางเข้า" },
  { name: "เกี่ยวกับเรา", path: "/about-us" },
  { name: "สมัครสมาชิก", path: "/register" },
  { name: "ติดต่อแอดมิน", path: "/contact-us" },
];
---

<footer class="relative mt-32 w-full border-t border-[#e9b949]/30 bg-[#140604] pt-64 pb-6 font-sans text-[#f2ddc4] shadow-[0_-10px_30px_rgba(233,185,73,0.15)] md:pt-40">
  <div
    class="absolute -top-14 left-1/2 z-20 flex w-[92%] max-w-5xl -translate-x-1/2 flex-col items-center justify-between rounded-2xl border border-[#e9b949]/35 bg-gradient-to-r from-[#2e130c] via-[#3a1108] to-[#1a0705] p-6 shadow-[0_15px_40px_rgba(168,31,26,0.3)] md:-top-16 md:flex-row md:p-8">
    <div class="mb-5 flex flex-col text-center md:mb-0 md:text-left">
      <p class="text-xl font-black tracking-wide text-[#f8dc9a] uppercase italic drop-shadow-[0_2px_4px_rgba(0,0,0,0.5)] md:text-3xl">
        <span aria-hidden="true">🎰</span> พร้อมยิ้มไปกับ YIMSIAM889 แล้วหรือยัง?
      </p>
      <p class="mt-2 text-sm font-medium text-[#f2ddc4]/90 md:text-base">
        สมัครสมาชิก YIMSIAM889 แล้วเข้าเล่นสล็อตลิขสิทธิ์แท้จากค่ายชั้นนำได้ด้วยบัญชีเดียว พร้อมยิ้มรับโปรสมาชิกใหม่ตั้งแต่ก้าวแรก อ่านเงื่อนไขของแต่ละโปรให้ครบก่อนกดรับทุกครั้ง
      </p>
    </div>

    <a
      href="/register"
      class="group relative flex items-center justify-center overflow-hidden rounded-full border border-[#f8dc9a] bg-gradient-to-b from-[#f8dc9a] to-[#a81f1a] px-8 py-3.5 text-sm font-extrabold whitespace-nowrap text-[#170503] shadow-[0_0_15px_rgba(233,185,73,0.4)] transition-all hover:scale-105 md:text-base">
      <span class="relative z-10">สมัครสมาชิกเลย <span aria-hidden="true">🚀</span></span>
      <div aria-hidden="true" class="absolute inset-0 translate-y-full bg-[#e9b949] transition-transform duration-300 group-hover:translate-y-0"></div>
    </a>
  </div>

  <div class="relative z-10 mx-auto max-w-[1200px] px-6">
    <div class="mb-10 grid grid-cols-1 gap-10 md:grid-cols-12 lg:gap-12">
      <div class="flex flex-col gap-6 md:col-span-12 lg:col-span-4">
        <a href="/" class="inline-block origin-left transition-transform hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt="โลโก้ YIMSIAM889 รูปหน้าจั่ววัดไทยสีทองประดับลายไทย มีตัวอักษร Yimsiam อยู่ด้านล่าง"
                widths={[100, 200, 300]}
                sizes="100px"
                height={45}
                loading="lazy"
                decoding="async"
                class="h-[45px] w-auto drop-shadow-[0_0_12px_rgba(233,185,73,0.55)]"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <p class="bg-gradient-to-b from-[#f8dc9a] to-[#a81f1a] bg-clip-text text-3xl font-black text-transparent drop-shadow-[0_0_8px_rgba(233,185,73,0.5)]">YIMSIAM889</p>
            )
          }
        </a>
        <p class="text-sm leading-relaxed text-[#f2ddc4]/75">
          YIMSIAM889 คือเว็บสล็อตสยามที่ให้บริการแบบเว็บตรง เชื่อมต่อเกมจากค่ายผู้พัฒนาโดยตรง ไม่ผ่านเอเย่นต์ ระบบเกมทำงานตามค่า RTP มาตรฐานสากล
          สมาชิกจัดการเครดิต โปรโมชั่น และประวัติธุรกรรมได้จากบัญชีเดียว พร้อมระบบฝากถอนอัตโนมัติที่ตรวจสถานะรายการย้อนหลังได้จากหน้าบัญชี
        </p>

        <div class="mt-2 flex flex-wrap gap-3">
          <a
            href="/line"
            class="flex items-center gap-2 rounded-full border border-[#00B900]/30 bg-[#00B900]/10 px-4 py-2 text-xs font-bold text-[#00B900] shadow-[0_0_10px_rgba(0,185,0,0.1)] transition-colors hover:bg-[#00B900] hover:text-white">
            <span aria-hidden="true" class="text-base">💬</span> LINE OFFICIAL
          </a>
        </div>

        {
          BRAND_ADDRESS.lines.length > 0 && (
            <address aria-label={BRAND_ADDRESS.label} class="mt-2 rounded-xl border border-white/15 bg-black/20 p-4 text-xs leading-relaxed not-italic opacity-90">
              <p class="mb-2 flex items-center gap-2 text-[11px] font-bold tracking-wider uppercase opacity-80">
                <span aria-hidden="true" class="text-sm">📍</span>
                {BRAND_ADDRESS.label}
              </p>
              {BRAND_ADDRESS.lines.map((line) => (
                <span class="block">{line}</span>
              ))}
              {BRAND_ADDRESS.email && (
                <a href={`mailto:${BRAND_ADDRESS.email}`} class="mt-3 inline-flex items-center gap-2 font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                  <span aria-hidden="true" class="text-sm">✉️</span>
                  {BRAND_ADDRESS.email}
                </a>
              )}
            </address>
          )
        }
      </div>

      <div class="md:col-span-6 lg:col-span-5">
        <p class="relative mb-5 inline-block text-lg font-bold tracking-wider text-[#f2ddc4] uppercase">
          ลิงก์ด่วน (Quick Links)
          <span aria-hidden="true" class="absolute -bottom-2 left-0 h-1 w-1/2 rounded-full bg-gradient-to-r from-[#a81f1a] to-[#f8dc9a] shadow-[0_0_8px_rgba(233,185,73,0.6)]"></span>
        </p>

        <div class="grid grid-cols-2 gap-x-4 gap-y-3 text-sm">
          {
            quickLinks.map((link) => (
              <a href={link.path} class="group flex items-center text-[#f2ddc4]/75 transition-colors hover:text-[#f8dc9a]">
                <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#a81f1a] transition-transform group-hover:rotate-45" />
                {link.name}
              </a>
            ))
          }
        </div>
      </div>

      <div class="md:col-span-6 lg:col-span-3">
        <p class="relative mb-5 inline-block text-lg font-bold tracking-wider text-[#f2ddc4] uppercase">
          ระบบการเงิน
          <span aria-hidden="true" class="absolute -bottom-2 left-0 h-1 w-1/2 rounded-full bg-gradient-to-r from-[#a81f1a] to-[#f8dc9a] shadow-[0_0_8px_rgba(233,185,73,0.6)]"></span>
        </p>

        <p class="mb-4 text-xs text-[#f2ddc4]/75">รองรับการฝาก-ถอนผ่านแอปธนาคารชั้นนำและ TrueMoney Wallet โดยควรใช้บัญชีชื่อเดียวกับข้อมูลที่สมัครไว้</p>

        <BankStrip size={30} />

        <div class="mt-3 flex h-10 items-center justify-center rounded border border-white/5 bg-[#1e0a06] transition-colors hover:border-[#e9b949]/50" title="ตรวจรายการย้อนหลัง">
          <span class="flex items-center gap-1 text-xs font-bold text-[#f2ddc4]"><span aria-hidden="true" class="text-lg text-[#e9b949]">🧾</span> เก็บเลขรายการไว้ตรวจสอบได้</span>
        </div>
      </div>
    </div>

    <hr class="mb-6 border-[#e9b949]/25" />

    <div class="mb-6 hidden text-justify text-[10px] leading-relaxed text-[#f2ddc4]/60 md:block">
      YIMSIAM889 สล็อตสยาม เว็บตรงแตกดีจริง ไม่ผ่านเอเย่นต์ รวมเกมลิขสิทธิ์แท้จาก PG SOFT, Joker Gaming และ Pragmatic Play ระบบสมาชิกบัญชีเดียว ยิ้มรับโปรสมาชิกใหม่
      ธุรกรรมว่องไวด้วยระบบอัตโนมัติ ตรวจประวัติธุรกรรมได้จากหน้าบัญชี ทางเข้า YIMSIAM889 รองรับมือถือ iOS Android คอมพิวเตอร์และแท็บเล็ต
    </div>

    <div class="flex flex-col items-center justify-between gap-4 border-t border-white/5 pt-6 text-xs text-[#f2ddc4]/60 md:flex-row">
      <p>&copy; {new Date().getFullYear()} <span class="font-bold tracking-wider text-[#f8dc9a] uppercase">YIMSIAM889</span>. All Rights Reserved.</p>

      <div class="flex items-center gap-6">
        <a href="/terms/" class="transition-colors hover:text-[#f2ddc4]">เงื่อนไขและข้อตกลง</a>
        <a href="/privacy/" class="transition-colors hover:text-[#f2ddc4]">นโยบายความเป็นส่วนตัว</a>

        <a
          href="#top"
          class="flex h-8 w-8 items-center justify-center rounded border border-white/10 bg-white/5 text-[#f2ddc4] transition-all hover:border-[#f8dc9a] hover:bg-[#2e130c] hover:shadow-[0_0_15px_rgba(233,185,73,0.5)]"
          aria-label="กลับขึ้นด้านบนสุดของหน้า">
          <span aria-hidden="true">↑</span>
        </a>
      </div>
    </div>
  </div>
</footer>
