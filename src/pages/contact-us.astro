---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";

import { Picture } from "astro:assets";
import imgLine from "../assets/contact-line.webp";
import { pageGraph } from "../lib/schema";
import { BRAND_ADDRESS } from "../lib/brandProfile";

const pageTitle = "ติดต่อทีมงาน PAYDAY24 | แจ้งปัญหาฝากถอนและกิจกรรมรับเครดิตผ่าน LINE Official";

const pageDescription =
  "ช่องทางติดต่อทีมงาน PAYDAY24 แจ้งปัญหาฝากถอนออโต้ สอบถามกิจกรรมรับเครดิต และการใช้งานหน้าเมมเบอร์ ผ่าน LINE Official พร้อมที่อยู่ติดต่อและอีเมลของทีมงาน";

const graph = pageGraph(Astro, {
  type: "ContactPage",
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ติดต่อเรา", path: "/contact-us" },
  ],
  org: {
    alternateName: "PAYDAY24 เว็บสล็อตมั่นคง รวมคาสิโนสด บาคาร่า หวย และกีฬาออนไลน์ พร้อมกิจกรรมรับเครดิตทุกวัน",
    contactPoints: [
      {
        contactType: "customer service",
        availableLanguage: ["Thai", "English"],
        path: "/line",
        description: "ติดต่อแอดมิน PAYDAY24 ผ่าน LINE Official แจ้งปัญหาฝากถอนและสอบถามกิจกรรมรับเครดิต",
      },
    ],
  },
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="ติดต่อทีมงาน PAYDAY24" as="h1">
    <Picture
      src={imgLine}
      alt="พนักงานหญิงผมยาวสีน้ำตาลลอนสวมชุดเลื่อมสีชมพูแขนยาวคอวี ยิ้มกอดอกอยู่หน้าวงกลมสีชมพู ด้านล่างเป็นแถบสีขาวที่มีโลโก้ LINE สีเขียวและคำว่า Support"
      loading="lazy"
      fetchpriority="low"
      widths={[200, 400, 600]}
      sizes="(max-width: 768px) 100vw, 400px"
      class="mx-auto h-auto w-full max-w-[400px] object-contain"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={60}
    />
    {
      BRAND_ADDRESS.lines.length > 0 && (
        <address aria-label={BRAND_ADDRESS.label} class="mt-8 mb-8 border-l-4 border-[#fdc700] pl-6 text-left text-base leading-relaxed text-[#ede4fb] not-italic">
          <p class="mb-1 font-bold text-[#ffe680]">{BRAND_ADDRESS.label}</p>
          {BRAND_ADDRESS.lines.map((line) => (
            <span class="block">{line}</span>
          ))}
          {BRAND_ADDRESS.email && (
            <span class="mt-3 block">
              <span aria-hidden="true" class="mr-2">
                ✉️
              </span>
              <a href={`mailto:${BRAND_ADDRESS.email}`} class="font-bold text-[#fdc700] underline decoration-[#a86f00] underline-offset-4 transition-colors hover:text-[#ffe680]">
                {BRAND_ADDRESS.email}
              </a>
            </span>
          )}
        </address>
      )
    }

    <div class="flex flex-wrap justify-center gap-4">
      <a
        href="/register"
        aria-label="สมัครสมาชิก PAYDAY24"
        class="flex items-center justify-center rounded-lg border border-[#a86f00] bg-gradient-to-r from-[#ffe680] via-[#fdc700] to-[#d99400] px-8 py-3 font-bold text-[#150726] shadow-[0_10px_30px_rgba(253,199,0,0.28)] transition-transform hover:scale-105 hover:shadow-[0_15px_40px_rgba(253,199,0,0.35)]">
        สมัครสมาชิก
      </a>

      <a
        href="/login"
        aria-label="เข้าสู่ระบบ PAYDAY24"
        class="flex items-center justify-center rounded-lg border border-[#fdc700]/60 bg-[#2c1247] px-8 py-3 font-extrabold text-[#ffe680] shadow-[0_4px_14px_rgba(253,199,0,0.16)] transition-transform hover:scale-105 hover:bg-[#331652]">
        เข้าสู่ระบบ
      </a>

      <a
        href="/line"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="ติดต่อทีมงาน PAYDAY24 ผ่าน Line Official"
        class="flex items-center justify-center rounded-lg border border-green-300 bg-gradient-to-b from-green-400 to-green-700 px-8 py-3 font-bold text-white transition-transform hover:scale-105">
        ติดต่อผ่าน Line Official
      </a>
    </div>
  </ContentBox>
  <Navfoot />
</MainLayout>
