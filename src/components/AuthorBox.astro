---
import { Image } from "astro:assets";
import { SITE_AUTHOR, authorAvatar, authorInitials, hasAuthor } from "../lib/author";

const linked = SITE_AUTHOR.linkProfile && SITE_AUTHOR.profileUrl.trim().length > 0;
const avatarAlt = `รูปโปรไฟล์ของ ${SITE_AUTHOR.name} ${SITE_AUTHOR.jobTitle}`;
---

{
  hasAuthor && (
    <section aria-label={`ผู้เขียน ${SITE_AUTHOR.name}`} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
      <div class="flex flex-col items-center gap-5 rounded-3xl border border-current/20 bg-current/[0.04] p-6 text-left sm:flex-row sm:items-start md:p-8">
        <div class="shrink-0">
          {authorAvatar ? (
            <Image
              src={authorAvatar}
              alt={avatarAlt}
              widths={[96, 192, 288]}
              sizes="96px"
              width={96}
              height={96}
              loading="lazy"
              decoding="async"
              formats={["avif", "webp"]}
              fallbackFormat="webp"
              quality={80}
              class="h-24 w-24 rounded-full border border-current/25 object-cover"
            />
          ) : (
            <span
              aria-hidden="true"
              class="flex h-24 w-24 items-center justify-center rounded-full border border-current/25 bg-current/[0.06] text-2xl font-black tracking-widest uppercase">
              {authorInitials}
            </span>
          )}
        </div>

        <div class="flex flex-col gap-2">
          <p class="text-xs font-bold tracking-widest uppercase opacity-70">เขียนและตรวจสอบโดย</p>

          <p class="text-xl leading-normal font-black tracking-wide">
            {linked ? (
              <a
                href={SITE_AUTHOR.profileUrl}
                rel="me noopener"
                target="_blank"
                class="underline decoration-current/40 underline-offset-4 transition-opacity hover:opacity-80">
                {SITE_AUTHOR.name}
              </a>
            ) : (
              SITE_AUTHOR.name
            )}
          </p>

          {SITE_AUTHOR.jobTitle && <p class="text-sm font-bold opacity-80">{SITE_AUTHOR.jobTitle}</p>}

          {SITE_AUTHOR.bio && <p class="max-w-[70ch] text-base leading-relaxed opacity-90">{SITE_AUTHOR.bio}</p>}
        </div>
      </div>
    </section>
  )
}
