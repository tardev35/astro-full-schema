---
import ContentBoxTwo from "./ContentBoxTwo.astro";

const menus = [
  { icon: "🗂️", name: "บัญชีเดียวครบทุกหมวด", detail: "สล็อต คาสิโน บาคาร่า บอล และหวยเข้าถึงได้จากบัญชีเดียว ใช้เครดิตและข้อมูลสมาชิกชุดเดิมได้ทุกหมวด", tag: "สลับหมวดได้เลย" },
  { icon: "🧭", name: "เมนูเกมแบ่งชัดเป็นหมวด", detail: "หมวดหลักถูกจัดไว้ให้เลือกได้ตามสไตล์ วันนี้สายสล็อต พรุ่งนี้สายบอลก็เปลี่ยนได้จากหน้าเดิม", tag: "หาเกมง่าย" },
  { icon: "🎰", name: "สล็อตรวมเกมใหม่และเกมยอดนิยม", detail: "มีทั้งสายเล่นง่าย เกมโบนัส และเกมที่มีฟรีสปินหรือตัวคูณ ดูเกมใหม่กับเกมที่กำลังนิยมได้จากหน้าเดียว", tag: "เลือกตามสาย" },
  { icon: "🎴", name: "คาสิโนสดและบาคาร่าเลือกโต๊ะไว", detail: "รวมเกมโต๊ะและบาคาร่าไว้ในหมวดคาสิโนสด เลือกประเภทเกมและโต๊ะที่ต้องการก่อนเข้าเล่นได้", tag: "เมนูเดียวจบ" },
  { icon: "⚽", name: "บอลและหวยในบัญชีเดิม", detail: "ตามการแข่งขันกีฬาหรือลุ้นตัวเลขได้ โดยยังอยู่ในระบบสมาชิกเดียวกับสล็อตและคาสิโน", tag: "มากกว่าสล็อต" },
  { icon: "🔁", name: "ฝากถอนออโต้ขั้นตอนตรงไปตรงมา", detail: "จัดการเครดิตจากหน้าบัญชีได้เป็นขั้นตอนสั้น ดูยอดและรายการที่เกี่ยวข้องได้จากจุดเดียว", tag: "ลดเวลารอ" },
  { icon: "📱", name: "ทางเข้ารองรับทุกอุปกรณ์", detail: "รองรับมือถือ แท็บเล็ต และคอมพิวเตอร์ ใช้บัญชีเดิมเข้าสู่ระบบและเลือกเกมได้จากเบราว์เซอร์ที่ใช้อยู่", tag: "บัญชีเดิมใช้ต่อ" },
];

const chips = ["สล็อต", "คาสิโน", "บาคาร่า", "บอล", "หวย", "ฝากถอนออโต้", "ทางเข้าเว็บหลัก"];
---

<ContentBoxTwo titleleft="เข้าสู่ระบบ KOH888" titleright="ระบบและบริการที่ KOH888 รวมไว้ในบัญชีเดียว" label="เข้าสู่ระบบ KOH888 และระบบที่ใช้ได้จากบัญชีเดียว">
  <div slot="left" class="flex h-full flex-col gap-4">
    <div class="relative overflow-hidden rounded-2xl border border-[#8b36d9]/40 bg-[#1a0a2e]/92 p-6 shadow-[0_10px_30px_rgba(12,4,22,0.65)] backdrop-blur-md">
      <div aria-hidden="true" class="pointer-events-none absolute -top-10 -right-10 h-32 w-32 rounded-full bg-[#8b36d9]/50 blur-[50px]"></div>

      <div class="relative z-10 mb-5 flex items-center gap-3">
        <span
          aria-hidden="true"
          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#f5c542]/40 bg-gradient-to-br from-[#ffe9a3] via-[#f5c542] to-[#a9761a] text-xl shadow-inner">
          🎴
        </span>
        <div class="flex flex-col">
          <p class="text-base font-black text-[#f5c542]">เข้าสู่ระบบแล้วเลือกเล่นได้จากหน้าเดิม</p>
          <span class="text-[11px] text-[#e9dcf6]/70">บัญชีเดียวใช้เลือกเกม ฝากถอนออโต้ และดูประวัติรายการของ KOH888 ได้ครบจากจุดเดียว</span>
        </div>
      </div>

      <div class="relative z-10 flex flex-col gap-3.5">
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#f5c542]">👤</span>
          <input
            type="text"
            placeholder="เบอร์โทรศัพท์ / ยูสเซอร์เนม"
            class="w-full rounded-xl border border-[#8b36d9]/60 bg-[#2a1147]/95 py-3 pr-4 pl-12 text-[#e9dcf6] transition-all outline-none placeholder:text-[#e9dcf6]/50 focus:border-[#f5c542] focus:ring-1 focus:ring-[#f5c542]/50"
          />
        </div>
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#f5c542]">🔑</span>
          <input
            type="password"
            placeholder="รหัส PIN 4 หลัก"
            class="w-full rounded-xl border border-[#8b36d9]/60 bg-[#2a1147]/95 py-3 pr-4 pl-12 text-[#e9dcf6] transition-all outline-none placeholder:text-[#e9dcf6]/50 focus:border-[#f5c542] focus:ring-1 focus:ring-[#f5c542]/50"
          />
        </div>

        <div class="flex items-center justify-between px-1 text-xs">
          <label class="flex items-center gap-2 text-[#e9dcf6]/70">
            <input type="checkbox" class="h-3.5 w-3.5 rounded border-[#8b36d9]/60 bg-[#2a1147] accent-[#8b36d9]" />
            จดจำฉันไว้
          </label>
          <a href="/login" class="text-[#e9dcf6]/70 transition-colors hover:text-[#ffe9a3]">ลืมรหัส PIN?</a>
        </div>

        <button
          class="mt-1 w-full rounded-xl border border-[#f5c542]/40 bg-gradient-to-r from-[#ffe9a3] via-[#f5c542] to-[#a9761a] p-3.5 font-black text-[#1a0a2e] shadow-[0_10px_30px_rgba(245,197,66,0.30)] transition-all hover:scale-[1.02] hover:shadow-[0_15px_40px_rgba(245,197,66,0.40)]">
          เข้าสู่ระบบ
        </button>

        <div class="flex items-center gap-3 py-1 text-[11px] text-[#e9dcf6]/60">
          <span class="h-px flex-1 bg-[#8b36d9]/60"></span>
          หรือ
          <span class="h-px flex-1 bg-[#8b36d9]/60"></span>
        </div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] p-3 text-sm font-bold text-white shadow-md transition-all hover:scale-[1.02]">
          <span aria-hidden="true">💬</span> ทักไลน์ทีมงานตลอด 24 ชั่วโมง
        </a>

        <div class="mt-1 flex items-center justify-between px-1">
          <div class="flex gap-2">
            <span class="rounded-full border border-[#f5c542]/30 bg-[#2a1147] px-2.5 py-1 text-[10px] font-bold text-[#f5c542]"><span aria-hidden="true">🔒</span> เข้ารหัสข้อมูล</span>
            <span class="rounded-full border border-[#c77dff]/50 bg-[#2a1147]/80 px-2.5 py-1 text-[10px] font-bold text-[#c77dff]"><span aria-hidden="true">🕐</span> ฝากถอนออโต้</span>
          </div>
          <a href="/register" class="text-xs font-bold text-[#e9dcf6]/70 transition-colors hover:text-[#ffe9a3]">สมัครสมาชิกใหม่</a>
        </div>
      </div>
    </div>
  </div>

  <div slot="right" class="h-full">
    <div class="flex h-full flex-col rounded-2xl border border-[#8b36d9]/40 bg-[#1a0a2e]/92 p-5 shadow-[0_10px_30px_rgba(12,4,22,0.65)] backdrop-blur-md">
      <div class="mb-5 flex items-center justify-between gap-3">
        <div>
          <span class="text-xs font-bold tracking-wide text-[#e9dcf6]/70">ตารางสรุปสิ่งที่ KOH888 รวมไว้ ตั้งแต่หน้าเลือกเกมจนถึงหน้าทำรายการ</span>
          <div class="bg-gradient-to-r from-[#ffe9a3] via-[#f5c542] to-[#c77dff] bg-clip-text text-3xl font-black text-transparent sm:text-4xl">เว็บตรง • บัญชีเดียวครบ</div>
        </div>
        <span class="flex items-center gap-1.5 self-start rounded-full border border-green-500/40 bg-green-900/40 px-2.5 py-1">
          <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-green-500 shadow-[0_0_8px_rgba(34,197,94,0.7)]"></span>
          <span class="text-[10px] font-bold tracking-widest text-green-300 uppercase">Live</span>
        </span>
      </div>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#e9dcf6]/60 uppercase">
        <span>ระบบ / บริการในเว็บ</span>
        <span>จุดเด่น</span>
      </div>

      <div class="flex flex-1 flex-col gap-2.5">
        {
          menus.map((m) => (
            <div class="rounded-xl border border-[#8b36d9]/45 bg-[#2a1147]/95 px-3.5 py-2.5 transition-colors hover:border-[#f5c542]/50 hover:bg-[#3b0a63]">
              <div class="flex items-center justify-between gap-2 text-sm">
                <span class="flex min-w-0 items-center gap-2 font-bold text-[#e9dcf6]">
                  <span aria-hidden="true" class="w-5 shrink-0 text-center">
                    {m.icon}
                  </span>{" "}
                  <span class="truncate">{m.name}</span>
                </span>
                <span class="shrink-0 rounded-full border border-[#f5c542]/40 bg-[#1a0a2e] px-2.5 py-0.5 text-[10px] font-bold text-[#f5c542]">{m.tag}</span>
              </div>
              <div class="mt-1.5 text-[11px] tracking-wide text-[#e9dcf6]/70">{m.detail}</div>
            </div>
          ))
        }
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
        {chips.map((c) => <span class="rounded-full border border-[#8b36d9]/40 bg-[#2a1147] px-3 py-1 text-[10px] font-bold text-[#c77dff]">{c}</span>)}
      </div>

      <div class="mt-3 text-center text-[10px] tracking-wide text-[#e9dcf6]/60">
        รายละเอียดของแต่ละบริการสรุปจากที่ KOH888 ประกาศไว้ เงื่อนไขจริงให้ยึดตามหน้ารายการของเว็บ หากติดขัดตรงไหนทักไลน์ทีมงานได้ตลอด 24 ชั่วโมง
      </div>
    </div>
  </div>
</ContentBoxTwo>
