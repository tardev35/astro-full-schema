---
export interface Props {
  title?: string;
}

const { title = "เสียงจากสมาชิก WINDRAGON" } = Astro.props;

const reviews = [
  {
    name: "คุณภูมิ",
    role: "เล่นสล็อตเป็นประจำ",
    stars: 5,
    tag: "สล็อตเวอร์ชั่นใหม่",
    content:
      "เล่นสล็อตมาหลายเว็บ ชอบที่ WINDRAGON มีเกมเวอร์ชั่นใหม่ให้เลือกเยอะ ทั้งสายฟรีสปิน สายตัวคูณรางวัล และเกมที่มีโบนัสในตัว เบื่อเกมไหนก็สลับไปลองเกมอื่นได้ทันทีโดยไม่ต้องย้ายเว็บ แต่ละเกมบอกกติกาและรูปแบบการจ่ายไว้ชัด เลยเลือกเกมให้เข้ากับงบของตัวเองได้ง่ายขึ้น",
    avatar: "🎰",
  },
  {
    name: "คุณต้น",
    role: "สลับเล่นหลายหมวดในบัญชีเดียว",
    stars: 5,
    tag: "ยิงปลา กีฬา คาสิโน",
    content:
      "ปกติไม่ได้เล่นแค่สล็อต บางวันอยากยิงปลา บางวันอยากดูบอลแล้วเดิมพันตามแมตช์ หรือเข้าโต๊ะคาสิโนสด พอทุกหมวดอยู่ในบัญชี WINDRAGON เดียวกันก็สะดวกขึ้นมาก ไม่ต้องจำหลายยูสเซอร์ เมนูแยกหมวดชัด กดเข้าหมวดที่ต้องการได้ในไม่กี่ขั้นตอน และยังมีหวยให้ดูรอบออกรางวัลอีกด้วย",
    avatar: "🎯",
  },
  {
    name: "คุณแนน",
    role: "ฝากถอนผ่านทรูมันนี่วอเล็ต",
    stars: 4,
    tag: "ฝากถอนออโต้",
    content:
      "ระบบฝากถอนของ WINDRAGON เป็นออโต้ ทำรายการเองได้ทั้งผ่านแอปธนาคารและทรูมันนี่วอเล็ต ไม่ต้องส่งสลิปแล้วรอแอดมิน ยอดเข้าตรงตามที่ทำรายการ และดูสถานะกับประวัติธุรกรรมย้อนหลังได้จากหน้าบัญชี ให้ 4 ดาวเพราะอยากให้มีช่องทางชำระเงินเพิ่มอีกสักช่องทาง",
    avatar: "👛",
  },
];
const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label={title} class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#ffd77a] via-[#f5b942] to-[#f26b1d] bg-clip-text text-3xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</p>
    <div aria-hidden="true" class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#f26b1d] to-transparent"></div>
  </div>

  <div class="mx-auto mb-8 flex max-w-md items-center justify-center gap-5 rounded-2xl border border-[#5a2a12] bg-[#1a100c] px-6 py-4 shadow-[0_10px_30px_rgba(242,107,29,0.18)]">
    <div class="flex flex-col items-center">
      <span class="bg-gradient-to-b from-[#ffd77a] to-[#f5b942] bg-clip-text text-4xl leading-none font-black text-transparent">{average}</span>
      <span class="mt-1 text-[10px] font-bold tracking-widest text-[#c9b5a6] uppercase">คะแนนเฉลี่ย</span>
    </div>
    <div class="h-12 w-px bg-[#5a2a12]"></div>
    <div class="flex flex-col gap-1.5">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#f5b942]" : "text-[#5a2a12]"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#c9b5a6]">คะแนนเฉลี่ย {average} จาก 5 ดาว จากรีวิวของสมาชิก {reviews.length} คน</span>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
    {
      reviews.map((review) => (
        <article class="group relative isolate flex flex-col gap-4 overflow-hidden rounded-2xl border border-[#5a2a12] bg-[#1a100c] p-6 text-left shadow-[0_10px_30px_rgba(242,107,29,0.16)] transition-all duration-300 hover:-translate-y-1 hover:border-[#f26b1d]/55 hover:shadow-[0_15px_40px_rgba(242,107,29,0.28)]">
          <span aria-hidden="true" class="absolute inset-y-0 left-0 -z-10 w-1 bg-gradient-to-b from-[#ffd77a] via-[#f26b1d] to-[#b3121b] opacity-80 transition-opacity duration-300 group-hover:opacity-100" />
          <span aria-hidden="true" class="pointer-events-none absolute -top-14 -right-14 -z-10 h-32 w-32 rounded-full bg-[#f26b1d]/16 blur-[50px] transition-all duration-300 group-hover:bg-[#cd4604]/18" />

          <div class="flex items-center justify-between gap-3">
            <span class="inline-flex items-center gap-1.5 rounded-full border border-[#5a2a12] bg-[#26150e] px-3 py-1 text-[10px] font-bold tracking-widest text-[#ffe4cc] uppercase">
              <span aria-hidden="true" class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#f26b1d]" />
              {review.tag}
            </span>
            <span class="flex gap-0.5 text-sm">
              <span aria-hidden="true" class="flex gap-0.5">
                {Array.from({ length: 5 }).map((_, i) => (
                  <span class={i < review.stars ? "text-[#f5b942]" : "text-[#5a2a12]"}>★</span>
                ))}
              </span>
              <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
            </span>
          </div>

          <p class="text-left text-base leading-relaxed text-[#f2e7de]">{review.content}</p>

          <div class="mt-auto flex items-center gap-3 border-t border-[#5a2a12] pt-4">
            <span
              aria-hidden="true"
              class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#5a2a12] bg-gradient-to-br from-[#ff8a2a] via-[#f26b1d] to-[#e2550a] text-xl shadow-inner transition-transform duration-300 group-hover:scale-110">
              {review.avatar}
            </span>
            <span class="flex flex-col">
              <span class="text-sm font-black text-[#ff9a4d] transition-colors group-hover:text-[#fff4ea]">{review.name}</span>
              <span class="text-[10px] font-bold tracking-wider text-[#c9b5a6] uppercase">{review.role}</span>
            </span>
          </div>
        </article>
      ))
    }
  </div>
</section>
