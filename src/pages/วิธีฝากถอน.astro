---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";
import { pageGraph } from "../lib/schema";

const pageTitle = "วิธีฝากถอน OHO555 ขั้นต่ำ 1 บาท ทรูวอเลทหรือทุกธนาคาร ไม่ต้องส่งสลิป";

const pageHeading = "วิธีฝากถอน OHO555 ขั้นต่ำ 1 บาท ผ่านทรูวอเลทหรือบัญชีทุกธนาคาร";

const pageDescription =
  "วิธีฝากถอน OHO555 ขั้นต่ำ 1 บาท โอนผ่านทรูวอเลทหรือบัญชีทุกธนาคาร ระบบออโต้ปรับเครดิตให้เองไม่ต้องส่งสลิป ถอนกดเองจากหน้าเว็บ และวิธีแจ้งแอดมินเมื่อยอดไม่ขึ้น";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "วิธีฝากถอน", path: "/วิธีฝากถอน" },
  ],
});

const bodyClass = "mb-4 text-left text-base leading-relaxed";
const closerClass = "text-left text-base leading-relaxed";
const brandClass = "font-bold text-[#ffc93c]";
const linkClass = "font-bold text-[#ffd24d] underline decoration-[#ffd24d]/50 underline-offset-4 transition-colors hover:text-[#ffe9a8]";
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox as="h1" title={pageHeading}>
    <p class={bodyClass}>
      ที่ <strong class={brandClass}>OHO555</strong> ฝากและถอนขั้นต่ำ 1 บาท โอนได้จากทรูวอเลท (TrueMoney Wallet) หรือบัญชีทุกธนาคาร ระบบออโต้ปรับเครดิตให้เอง ไม่ต้องส่งสลิปให้แอดมินตรวจ
    </p>

    <p class={closerClass}>
      ทุกขั้นตอนทำผ่านเบราว์เซอร์บนมือถือได้จนจบโดยไม่ต้องโหลดแอป จะลองระบบด้วยยอดเล็กก่อนแล้วค่อยเติมตามงบที่วางไว้ก็ทำได้
    </p>
  </ContentBox>

  <ContentBox as="h2" title="สมัครสมาชิก OHO555 ก่อนฝากครั้งแรก">
    <p class={bodyClass}>
      การฝากครั้งแรกเริ่มจากยูสเซอร์ของตัวเอง กด<a href="/register/" class={linkClass}>สมัครสมาชิก</a>แล้วกรอกข้อมูลบนหน้าจอให้ครบ ทุกขั้นทำกับเว็บโดยตรง ไม่มีตัวแทนมาเปิดยูสให้
    </p>

    <p class={closerClass}>
      สมาชิกเดิมไม่ต้องสมัครซ้ำ เข้าที่<a href="/ทางเข้า/" class={linkClass}>ทางเข้า OHO555</a>แล้วล็อกอินด้วยยูสเดิมได้ทุกเครื่อง ก่อนกรอกรหัส ตรวจชื่อเว็บบนแถบที่อยู่ให้ตรงทุกครั้ง
    </p>
  </ContentBox>

  <ContentBox as="h2" title="ฝากเงินขั้นต่ำ 1 บาท ระบบออโต้ปรับเครดิตให้เองไม่ต้องส่งสลิป">
    <p class={bodyClass}>
      <a href="/login/" class={linkClass}>เข้าสู่ระบบ</a>แล้วทำรายการฝากตามขั้นตอนที่หน้าเว็บแสดง โอนจากทรูวอเลทหรือบัญชีธนาคารที่ใช้อยู่ได้ทั้งหมด โอนเสร็จแล้วระบบออโต้จะปรับยอดเครดิตในยูสให้เอง
    </p>

    <p class={bodyClass}>
      ยอดขั้นต่ำอยู่ที่ 1 บาท ครั้งแรกจึงโอนยอดเล็กเพื่อดูว่าเครดิตขึ้นจริงก่อนได้ ไม่ต้องส่งสลิปให้ใครตรวจ แล้วค่อยเติมเพิ่มตามงบที่วางไว้
    </p>

    <p class={closerClass}>ยอดฝากแต่ละครั้งเป็นไปตามแผนของคุณเอง ไม่ใช่ตามเกณฑ์ของระบบ</p>
  </ContentBox>

  <ContentBox as="h2" title="ถอนเงินกดเองจากหน้าเว็บ ด้วยระบบออโต้ชุดเดียวกับขาฝาก">
    <p class={bodyClass}>
      ขาถอนใช้ระบบออโต้ชุดเดียวกับขาฝาก คุณสั่งถอนจากหน้าเว็บด้วยยูสของตัวเอง ขั้นต่ำ 1 บาทเท่ากัน ไม่ต้องทักแอดมินให้ทำรายการแทน
    </p>

    <p class={bodyClass}>
      ถ้ารับโบนัสสมาชิกใหม่ 50% ไว้ ยอดนั้นต้องทำเทิร์น 3 เท่าก่อนถอน ใครอยากถอนได้อิสระตั้งแต่แรก เลือกไม่รับโปรแล้วเล่นด้วยยอดฝากล้วนก็ได้
    </p>

    <p class={closerClass}>เงินเข้าด้วยระบบไหน ก็ออกด้วยระบบเดียวกัน</p>
  </ContentBox>

  <ContentBox as="h2" title="ฝากแล้วเครดิตไม่ขึ้น อย่าโอนซ้ำ ส่งเวลาโอนกับจำนวนเงินให้แอดมิน">
    <div class="flex flex-col gap-4">
      <p class={closerClass}>
        ถ้าโอนแล้วยอดยังไม่ขึ้นในยูส อย่ารีบโอนก้อนใหม่ตาม จดเวลาที่โอนกับจำนวนเงินไว้ แล้วแจ้งแอดมินผ่านช่องทางบนเว็บหรือ<a href="/contact-us/" class={linkClass}>หน้าติดต่อทีมงาน</a> ซึ่งรับเรื่องตลอด 24 ชั่วโมง
      </p>

      <p class={closerClass}>
        แอดมินใช้แค่เวลากับยอดเงินเพื่อตามรายการ ไม่ต้องใช้รหัสของคุณ รหัสผ่านกับ OTP จึงไม่ต้องส่งให้ใคร แม้คนที่ทักมาจะอ้างว่าเป็นทีมงานก็ตาม
      </p>

      <div class="flex flex-col items-center justify-center gap-4 pt-4 sm:flex-row">
        <a
          href="/login/"
          aria-label="เข้าสู่ระบบ OHO555 เพื่อฝากถอน"
          style="background-image: linear-gradient(in oklab to bottom, #ffe08a, #fcaa04 55%, #c77d00);"
          class="inline-flex w-full max-w-[320px] items-center justify-center gap-2 rounded-xl border-2 border-[#ffe9a8] bg-[#fcaa04] px-8 py-3.5 text-lg font-black tracking-wide text-[#1a1000] shadow-[0_8px_22px_rgba(252,170,4,0.35)] transition duration-300 hover:scale-105 hover:brightness-110">
          <span aria-hidden="true">💳</span> เข้าสู่ระบบเพื่อฝากถอน
        </a>

        <a
          href="/register/"
          aria-label="สมัครสมาชิก OHO555"
          style="background-image: linear-gradient(in oklab to bottom, #ff4b4b, #d81e1e 55%, #9e0c12);"
          class="inline-flex w-full max-w-[320px] items-center justify-center gap-2 rounded-xl border-2 border-[#ffd24d] bg-[#d81e1e] px-8 py-3.5 text-lg font-black tracking-wide text-white shadow-[0_8px_22px_rgba(216,30,30,0.40)] transition duration-300 hover:scale-105 hover:brightness-110">
          <span aria-hidden="true">📝</span> สมัครสมาชิก OHO555
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
