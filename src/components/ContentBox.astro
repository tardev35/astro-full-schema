---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#2e8bff]/45 bg-[#04173f]/92 p-8 text-left text-base leading-relaxed text-[#dbeafe] shadow-[0_10px_30px_rgba(11,78,168,0.22)] backdrop-blur-xl transition-all duration-500 hover:border-[#2e8bff]/70 hover:shadow-[0_15px_40px_rgba(46,139,255,0.26)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#0b4ea8]/45 blur-[60px] transition-all duration-500 group-hover:bg-[#5aa9ff]/30"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#083a86]/40 blur-[60px] transition-all duration-500 group-hover:bg-[#2e8bff]/25"></div>

    {
      title && (
        <header class="mb-6 flex items-center gap-4 border-b border-[#2e8bff]/45 pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#a8d4ff] to-[#0b4ea8] shadow-[0_0_10px_rgba(46,139,255,0.5)]" />
          <HeadingTag class="bg-gradient-to-r from-[#a8d4ff] via-[#2e8bff] to-[#5aa9ff] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
