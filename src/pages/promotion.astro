---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";

import { Picture } from "astro:assets";

import pro1 from "../assets/slide1.png";
import pro2 from "../assets/slide2.png";
import pro3 from "../assets/slide3.png";
import { pageGraph } from "../lib/schema";

const pageTitle = "โปรโมชั่น PIGAUTO รวมสิทธิ์สมาชิกเว็บสล็อตออโต้ไม่มีขั้นต่ำ";

const pageHeading = "โปรโมชั่น PIGAUTO รวมสิทธิ์สำหรับสมาชิก";

const pageDescription =
  "รวมภาพโปรโมชั่นและสิทธิ์สมาชิกของ PIGAUTO เว็บสล็อตออโต้ไม่มีขั้นต่ำ ดูยอดรับกับเงื่อนไขได้จากบนภาพทุกใบ แล้วสมัครยูสเดียวรับสิทธิ์ต่อจากหน้าเมมเบอร์ได้ทันที";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: pro1.src,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageHeading} as="h1">
    <p class="mb-4 text-left text-base leading-relaxed text-[#f7e2d6]">
      หากคุณกำลังมองหาโปรที่ดูจบได้ในหน้าเดียว <strong class="text-[#f5c542]">PIGAUTO</strong> รวมสิทธิ์ของสมาชิกไว้ให้ครบ ทั้งโปรต้อนรับ โปรฝากรับเพิ่ม และสิทธิ์ที่เปิดตามช่วงเวลา
    </p>

    <p class="mb-8 text-left text-base leading-relaxed text-[#f7e2d6]">
      ยอดรับและเงื่อนไขของแต่ละใบระบุไว้บนภาพ เลือกใบที่ตรงกับงบของคุณ แล้วสมัครยูสเดียวรับต่อจากหน้าเมมเบอร์ด้วยระบบฝากถอนออโต้ไม่ผ่านคนกลาง
      เพื่อประสบการณ์การเล่นที่คุ้มค่าและต่อเนื่องกว่าที่เคย
    </p>

    <div class="grid w-full grid-cols-1 gap-6 sm:grid-cols-2">
      <Picture
        src={pro1}
        alt="ภาพโปรโมชั่น PIGAUTO พื้นแดงทอง พรีเซนเตอร์หญิงชุดกี่เพ้าแดงยืนท่ามกลางโคมไฟจีน พัดทอง ไพ่ ชิป และเหรียญทอง มีโลโก้หัวหมูสีชมพูอยู่ด้านบน ข้อความบนภาพเขียนว่า รองรับวอเล็ท เต็มระบบ pig auto wallet ใช้ง่าย"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class="mx-auto h-auto w-full rounded-xl border border-[#7f1d1d] object-contain shadow-[0_10px_30px_rgba(239,68,68,0.16)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#ef4444]/50 hover:shadow-[0_15px_40px_rgba(239,68,68,0.26)]"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />

      <Picture
        src={pro2}
        alt="ภาพโปรโมชั่น PIGAUTO พื้นแดงทอง พรีเซนเตอร์หญิงชุดกี่เพ้าแดงยืนอยู่ด้านขวา ล้อมด้วยพัดทอง ไพ่ ชิป และเหรียญทอง มีโลโก้หัวหมูสีชมพูอยู่ด้านบน ข้อความบนภาพเขียนว่า เว็บสล็อตออโต้ไม่มีขั้นต่ำ เล่นได้อย่างเป็นมิตร ปลอดภัยสูง"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class="mx-auto h-auto w-full rounded-xl border border-[#7f1d1d] object-contain shadow-[0_10px_30px_rgba(239,68,68,0.16)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#ef4444]/50 hover:shadow-[0_15px_40px_rgba(239,68,68,0.26)]"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />

      <div class="sm:col-span-2 sm:mx-auto sm:w-[calc(50%_-_0.75rem)]">
        <Picture
          src={pro3}
          alt="ภาพโปรโมชั่น PIGAUTO พื้นแดงทอง พรีเซนเตอร์หญิงชุดกี่เพ้าแดงยืนหน้าวงกลมลายจีน มีโคมไฟแดง พัดทอง และเหรียญทองโปรยรอบภาพ ข้อความบนภาพเขียนว่า PIGAUTO สมัครง่ายเหมือนเปิดมือถือ"
          loading="lazy"
          fetchpriority="low"
          widths={[200, 400, 600]}
          sizes="(max-width: 768px) 100vw, 50vw"
          class="mx-auto h-auto w-full rounded-xl border border-[#7f1d1d] object-contain shadow-[0_10px_30px_rgba(239,68,68,0.16)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#ef4444]/50 hover:shadow-[0_15px_40px_rgba(239,68,68,0.26)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />
      </div>
    </div>

    <div class="mt-12 flex justify-center pb-4">
      <a
        href="/register"
        class="flex items-center justify-center rounded-lg border border-[#f5c542]/45 bg-gradient-to-r from-[#f87171] via-[#ef4444] to-[#b91c1c] px-10 py-3.5 text-lg font-black text-[#fff5e6] shadow-[0_10px_30px_rgba(239,68,68,0.28)] transition-transform hover:scale-105 hover:shadow-[0_15px_40px_rgba(245,197,66,0.35)]">
        สมัครสมาชิก PIGAUTO
      </a>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
