---
import { Picture } from "astro:assets";
import { BRAND_NAME } from "../lib/brandProfile";
import imgPg from "../assets/providers/game1.avif";
import imgJili from "../assets/providers/game5.avif";
import imgPp from "../assets/providers/game6.avif";

const providers = [
  {
    name: "PG Soft",
    game: "Wild Bandito",
    mechanic: "ระบบร่วงหล่น",
    isHot: true,
    img: imgPg,
    alt: "โลโก้ PG Pocket Games Soft กับตัวละครสาวสวมมงกุฎขนนกหลากสีและเพื่อนร่วมเกมบนพื้นสีทอง",
  },
  {
    name: "Pragmatic Play",
    game: "Gates of Olympus",
    mechanic: "ไม่ต้องเรียงไลน์",
    isHot: true,
    img: imgPp,
    alt: "โลโก้ PP Slot กับเทพเจ้าเคราขาวสวมมงกุฎทองถือสายฟ้าหน้าเสาวิหาร",
  },
  {
    name: "JILI",
    game: "Fortune Gems",
    mechanic: "วงล้อ 3×3",
    isHot: false,
    img: imgJili,
    alt: "โลโก้ JILI กับนักรบชุดทองสวมหมวกขนนกถือขวานพู่สีแดงน้ำเงิน",
  },
];

const gridTitle = `ค่ายเกมสล็อตใน ${BRAND_NAME} แยกตามค่ายพร้อมเกมเด่น`;
---

<section aria-label={gridTitle} class="mx-auto w-full max-w-[1300px] px-4 py-8 font-sans sm:px-6 lg:px-8">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <span aria-hidden="true" class="text-2xl">🎰</span>
    <p class="text-2xl leading-normal font-black tracking-wide text-[#0c3550] md:text-3xl">
      ค่ายเกมสล็อตใน <span class="text-[#006d99]">{BRAND_NAME}</span>
    </p>
    <p class="text-sm font-bold text-[#5a6b7a]">ทดลองเล่นได้โดยไม่ต้องฝากเงินหรือสมัครก่อน</p>
    <div aria-hidden="true" class="mt-2 h-[3px] w-24 rounded-full bg-gradient-to-r from-[#4cc9f0] via-[#00a4d4] to-[#f7941d]"></div>
  </div>

  <ul class="mx-auto grid max-w-3xl grid-cols-3 gap-3 sm:gap-4 lg:gap-6">
    {
      providers.map((p) => (
        <li class="group relative flex flex-col overflow-hidden rounded-2xl border border-[#cfe9f4] bg-white shadow-[0_10px_30px_rgba(12,53,80,0.08)] transition-all duration-500 hover:-translate-y-1 hover:border-[#8ed3ee] hover:shadow-[0_15px_40px_rgba(0,164,212,0.18)]">
          {p.isHot && (
            <span class="absolute top-0 right-0 z-10 flex items-center gap-1 rounded-bl-xl border-b border-l border-white bg-gradient-to-b from-[#ffd23f] via-[#ffb84d] to-[#f7941d] px-2 py-1 text-[10px] font-black tracking-wide text-[#4a1d00] shadow-md sm:px-3 sm:py-1.5">
              <span aria-hidden="true">🔥</span>
              HOT
            </span>
          )}

          <Picture
            src={p.img}
            alt={p.alt}
            formats={["avif", "webp"]}
            fallbackFormat="webp"
            loading="lazy"
            fetchpriority="low"
            widths={[160, 221]}
            sizes="(max-width: 639px) calc(33vw - 19px), (max-width: 815px) calc(33vw - 27px), 245px"
            quality={70}
            decoding="async"
            class="block aspect-square w-full object-cover transition-transform duration-700 group-hover:scale-105"
          />

          <div class="relative z-10 flex flex-1 flex-col items-center gap-1 border-t border-[#cfe9f4] bg-[#e8f7fd] px-2 py-2.5 text-center sm:px-3">
            <p class="text-xs font-black text-[#0c3550] sm:text-sm">{p.name}</p>
            <p class="text-[11px] leading-snug font-bold text-[#006d99] sm:text-xs">{p.game}</p>
            <span class="mt-0.5 hidden rounded-full border border-[#ffb84d]/60 bg-[#fff4e5] px-2.5 py-0.5 text-[10px] font-bold text-[#a35000] sm:inline-block">{p.mechanic}</span>
          </div>
        </li>
      ))
    }
  </ul>

  <div class="mt-6 flex justify-center">
    <a
      href="/ทดลองเล่น/"
      class="inline-flex items-center gap-2 rounded-full border-2 border-white bg-gradient-to-b from-[#19b2e0] to-[#0077b3] px-6 py-2.5 text-sm font-black text-white shadow-[0_10px_30px_rgba(0,164,212,0.35)] transition-transform hover:scale-[1.03]">
      <span aria-hidden="true">🎮</span>
      <span>ไปที่หน้าทดลองเล่นสล็อต</span>
    </a>
  </div>
</section>
