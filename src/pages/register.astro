---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import CtaRedirect from "../components/CtaRedirect.astro";
import { pageGraph } from "../lib/schema";

const pageDescription =
  "สมัครสมาชิก GOAT888 หน้าสมัครเว็บหลัก กดปุ่มเดียวเริ่มเปิดบัญชีผ่านมือถือ เข้าเล่นสล็อตเว็บตรงและคาสิโน เช็กสิทธิ์เครดิตฟรีสำหรับสมาชิกใหม่ พร้อมฝากถอนออโต้";

const graph = pageGraph(Astro, {
  name: "สมัครสมาชิก GOAT888 เว็บหลัก",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "สมัครสมาชิก", path: "/register" },
  ],
});

const targetUrl = "https://yoalink.com/22hs";
---

<MainLayout title="สมัครสมาชิก GOAT888 | เปิดบัญชีเว็บตรงสล็อตแท้" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="สมัครสมาชิก GOAT888" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label="สมัครสมาชิก"
        class="group relative mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#ffa3ee]/60 bg-gradient-to-b from-[#ffa3ee] via-[#ff3ddb] to-[#8f1080] px-6 py-4 text-xl font-bold tracking-wide text-[#0a0208] shadow-[0_10px_30px_rgba(255,61,219,0.28)] transition-all duration-300 hover:scale-105 hover:shadow-[0_15px_40px_rgba(245,196,81,0.4)]">
        สมัครสมาชิก
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="สมัครสมาชิก" />
</MainLayout>
