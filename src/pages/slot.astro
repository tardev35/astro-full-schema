  },
];

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "สล็อต", path: "/slot" },
  ],
  faqs,
  primaryImagePath: pgAztec.src,
});

const slotTypes = [
  { icon: "slot", name: "วงล้อน้อยวง", desc: "จอไม่แน่น อ่านผลง่าย และมีวงพิเศษแยกไว้อีกวง เช่น Fortune Gems และ Money Coming" },
  { icon: "coins", name: "ระบบร่วงหล่น", desc: "ชุดที่ชนะหายไปแล้วมีสัญลักษณ์ใหม่หล่นมาเติม หมุนครั้งเดียวชนะต่อกันได้ เช่น Mahjong Ways 2" },
  { icon: "target", name: "จ่ายไม่เรียงไลน์หรือจ่ายเป็นกลุ่ม", desc: "นับจำนวนทั้งจอหรือดูกลุ่มที่เกาะติดกัน เช่น Sweet Bonanza และ Sugar Rush" },
  { icon: "ticket", name: "เน้นรอบฟรีสปิน", desc: "จุดลุ้นอยู่ที่รอบพิเศษและลูกเล่นในรอบนั้น เช่น Roma และ Lucky Neko" },
];

