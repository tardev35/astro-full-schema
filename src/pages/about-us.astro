---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement4.astro";
import { pageGraph } from "../lib/schema";

const pageTitle = "เกี่ยวกับเรา YOK789 เว็บตรงที่รวมสล็อต คาสิโน หวย และกีฬา";

const pageDescription =
  "เกี่ยวกับเรา YOK789 เว็บตรงที่รวมสล็อต คาสิโนสด หวย และกีฬาไว้ในบัญชีเดียว กว่า 40 ค่าย 4,000 เกม ฝากถอนออโต้ 1 วินาที และแนวทางตรวจเงื่อนไขคืนยอดเสีย 8%";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title="เกี่ยวกับเรา YOK789 เว็บตรงรวมสล็อต คาสิโน หวย กีฬา ในบัญชีเดียว" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle}>
    <div>
      <p class="mb-4 text-left text-base leading-relaxed text-[#d5f0dd]">
        YOK789 หรือที่ผู้เล่นบางกลุ่มเรียกกันว่า หยก789 วางตัวเป็นเว็บตรงที่รวมสล็อต คาสิโนสด หวย และกีฬาไว้ในบัญชีเดียว จุดที่ทำให้ต่างจากเว็บทั่วไปจึงไม่ได้อยู่ที่จำนวนเกมอย่างเดียว
        แต่อยู่ที่การสลับหมวดได้โดยไม่ต้องสมัครหลายเว็บหรือโยกเครดิตไปมาให้ขั้นตอนยาวเกินจำเป็น ฝั่งสล็อตรวมค่ายเกมไว้มากกว่า 40 ค่าย รวมแล้วกว่า 4,000 เกม
        ส่วนงานหลังบ้านอย่างการฝากถอนเป็นระบบออโต้ที่ทำรายการได้ในระดับ 1 วินาที และมีสิทธิ์คืนยอดเสีย 8% เป็นโปรโมชั่นแกนหลักของเว็บ
      </p>

      <p class="mb-4 text-left text-base leading-relaxed text-[#d5f0dd]">
        หน้าเว็บชุดนี้ทำหน้าที่เป็นหน้ารีวิวและให้ข้อมูล ไม่ได้รับเดิมพันและไม่ได้เก็บยอดเงินของใครเอง สิ่งที่เราเขียนจึงตั้งใจให้อ่านแล้วเอาไปตรวจต่อได้จริง
        เช่น คำว่าจ่ายจริงควรดูจากสถานะการถอนและประวัติรายการในบัญชีของตัวเอง ไม่ใช่จากข้อความบนแบนเนอร์ หรือเงื่อนไขคืนยอดเสีย 8% ก็ต้องอ่านให้ครบว่าคิดจากยอดเสียสุทธิ ยอดเดิมพันรวม หรือเฉพาะเกมที่ร่วมรายการ
        เพราะถ้าคิดจากยอดเสียสุทธิ 1,000 บาท อัตรา 8% ก็เท่ากับ 80 บาท แต่ตัวเลขจริงยังขยับได้ตามข้อยกเว้นของโปรที่เขียนไว้ตัวเล็ก ๆ ด้านล่างเสมอ
      </p>

      <p class="text-left text-base leading-relaxed text-[#d5f0dd]">
        เราจึงเลือกอธิบายทั้งข้อดีและข้อที่ต้องระวังไว้ในหน้าเดียวกัน ทั้งวิธีเลือกเกมให้ตรงงบ จุดที่ต้องเช็กก่อนยืนยันบิลหวยและกีฬา รอบรับสิทธิ์กับจำนวนเทิร์นของโปรโมชั่น
        และการตรวจชื่อเว็บไซต์กับการเชื่อมต่อ HTTPS ก่อนล็อกอินทุกครั้ง หน้ารีวิวที่ดีควรช่วยให้ผู้อ่านตัดสินใจเองได้ มากกว่าจะเร่งให้กดสมัครภายในสามวินาที
        ระบบรวมหลายบริการไว้ในที่เดียวได้ก็จริง แต่ปุ่มหยุดยังต้องเป็นคนกดเองอยู่ดี
      </p>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
