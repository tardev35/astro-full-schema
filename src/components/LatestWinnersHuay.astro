---
import kbankLogo from "../assets/banks/kbank.png";
import scbLogo from "../assets/banks/scb.png";
import krungsriLogo from "../assets/banks/krungsri.png";
import ktbLogo from "../assets/banks/ktb.png";

const bankPool = [
  { name: "KBank", color: "bg-[#1155cc]", icon: kbankLogo.src },
  { name: "SCB", color: "bg-[#4e1c80]", icon: scbLogo.src },
  { name: "Krungsri", color: "bg-[#fcd34d]", icon: krungsriLogo.src },
  { name: "KTB", color: "bg-[#0ea5e9]", icon: ktbLogo.src },
];
---

<div class="mx-auto mb-10 w-full max-w-[1300px] px-4 font-sans">
  <div class="rounded-2xl border border-gray-200 bg-white px-4 py-8 shadow-sm md:p-8">
    <div class="mb-6 flex items-center justify-between border-b border-gray-100 pb-4">
      <div class="flex items-center gap-3">
        <h2 class="text-xl font-black tracking-widest text-[#0a1128]">รายการถอนเงิน <span class="text-[#007bff]">ล่าสุด</span></h2>
      </div>
      <span class="animate-pulse rounded-md bg-green-100 px-3 py-1 text-[10px] font-bold tracking-widest text-green-700">LIVE FEED</span>
    </div>

    <div id="feed-finn-hud" class="flex flex-col gap-3"></div>
  </div>
</div>

<script define:vars={{ bankPool }}>
  const feed = document.getElementById("feed-finn-hud");
  const getRandomStr = (len, chars) =>
    Array.from({ length: len })
      .map(() => chars.charAt(Math.floor(Math.random() * chars.length)))
      .join("");
  const getAmount = () => (Math.floor(Math.random() * (150000 - 5000 + 1)) + 5000).toLocaleString("en-US");

  const createHTML = () => {
    const bank = bankPool[Math.floor(Math.random() * bankPool.length)];
    const user = `0${getRandomStr(1, "89")}***${getRandomStr(4, "0123456789")}`;
    const isPending = Math.random() > 0.7;

    const statusClass = isPending ? "text-orange-500" : "text-green-600";
    const statusText = isPending ? "กำลังดำเนินการ" : "โอนเงินสำเร็จ";

    return `
      <div class="winner-row origin-bottom transform translate-y-4 opacity-0 transition-all duration-500 ease-out">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 rounded-xl border border-gray-100 bg-gray-50 p-4 transition-all duration-300 hover:border-[#ffd60a] hover:bg-white hover:shadow-md">
          <div class="flex items-center gap-4">
            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full border border-gray-200 ${bank.color}">
              <img src="${bank.icon}" alt="bank" class="h-6 w-6 object-contain grayscale brightness-200 contrast-200" />
            </div>
            <div class="flex flex-col">
              <span class="text-[10px] font-medium tracking-widest text-gray-500">ID สมาชิก</span>
              <span class="font-mono text-sm font-bold text-[#0a1128]">${user}</span>
            </div>
          </div>
          <div class="flex items-center justify-between sm:justify-end gap-6 border-t border-gray-200 pt-3 sm:border-none sm:pt-0">
            <div class="text-[11px] font-bold tracking-wider ${statusClass}">${statusText}</div>
            <div class="font-sans text-xl font-black text-[#0a1128]">
              ${getAmount()} <span class="text-xs font-bold text-gray-500">THB</span>
            </div>
          </div>
        </div>
      </div>
    `;
  };

  const trigger = () => {
    const tempDiv = document.createElement("div");
    tempDiv.innerHTML = createHTML();
    const newEl = tempDiv.firstElementChild;
    feed.prepend(newEl);
    setTimeout(() => {
      newEl.classList.remove("translate-y-4", "opacity-0");
      newEl.classList.add("translate-y-0", "opacity-100");
    }, 50);
    if (feed.children.length > 5) {
      const last = feed.lastElementChild;
      last.classList.remove("translate-y-0", "opacity-100");
      last.classList.add("-translate-y-4", "opacity-0");
      setTimeout(() => last.remove(), 500);
    }
  };
  for (let i = 0; i < 5; i++) {
    trigger();
  }
  setInterval(trigger, 3000);
</script>
<style>
  .font-sans {
    font-family: "Kanit", sans-serif;
  }
</style>
