---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";
import { pageGraph } from "../lib/schema";

const pageTitle = "เกี่ยวกับ 777RUAY สล็อตออนไลน์ผ่านเบราว์เซอร์ รวมสี่ค่ายเกม ฝากถอนออโต้ 24 ชั่วโมง";

const pageHeading = "เกี่ยวกับ 777RUAY สล็อตออนไลน์ที่เล่นผ่านเบราว์เซอร์ พร้อมฝากถอนออโต้ตลอด 24 ชั่วโมง";

const pageDescription =
  "รู้จัก 777RUAY สล็อตออนไลน์ที่เล่นผ่านเบราว์เซอร์ทั้ง iOS และ Android รวมเกมจาก PG Soft, Pragmatic Play, JILI และ Habanero ฝากถอนออโต้ 24 ชั่วโมงไม่ต้องแนบสลิป";

const announcementMessage =
  "777RUAY สล็อตออนไลน์ เล่นผ่านเบราว์เซอร์ได้ทั้ง iOS และ Android ไม่ต้องโหลดแอป • ฝากถอนออโต้ตลอด 24 ชั่วโมง ไม่ต้องแนบสลิป • สมัคร ฝาก เล่น และถอนจบบนมือถือเครื่องเดียว • มีเรื่องติดขัดติดต่อแอดมินผ่านช่องทางบนหน้าเว็บ";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});

const bodyClass = "mb-4 text-left text-base leading-relaxed text-[#1f2a44]";
const closerClass = "text-left text-base leading-relaxed text-[#1f2a44]";
const linkClass = "font-bold text-[#1a5fe0] underline underline-offset-4 transition-colors hover:text-[#8a6508]";
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement message={announcementMessage} />

  <ContentBox as="h1" title={pageHeading}>
    <p class={bodyClass}>
      <strong class="font-bold text-[#8a6508]">777RUAY</strong> เป็นเว็บสล็อตออนไลน์ที่เปิดผ่านเบราว์เซอร์ได้เลยโดยไม่ต้องโหลดแอป รวมเกมจากสี่ค่าย คือ PG Soft, Pragmatic Play, JILI และ Habanero ไว้ในที่เดียว
    </p>

    <p class={bodyClass}>
      ฝากถอนเป็นระบบออโต้ที่ปรับเครดิตให้เองตลอด 24 ชั่วโมง และทุกขั้นตอนตั้งแต่สมัครจนถึงถอนเงินจัดการได้บนมือถือเครื่องเดียว ด้านล่างไล่ให้ดูทีละเรื่อง
    </p>

    <p class={closerClass}>ทุกอย่างอยู่ในเบราว์เซอร์ ไม่มีอะไรต้องติดตั้งเพิ่ม</p>
  </ContentBox>

  <ContentBox as="h2" title="สล็อตออนไลน์ 777RUAY จากสี่ค่าย PG Soft Pragmatic Play JILI และ Habanero">
    <p class={bodyClass}>
      ค่ายสล็อตที่เปิดอยู่มีสี่ค่าย แต่ละค่ายมีกติกาและจังหวะเกมของตัวเอง ใครมีค่ายในใจอยู่แล้วเลือกค่ายก่อน แล้วค่อยไล่ดูว่าเกมในค่ายนั้นลุ้นกันแบบไหน
    </p>

    <p class={bodyClass}>
      Fortune Tiger ของ PG Soft เป็นวงล้อ 3×3 ไม่มีสแกตเตอร์และฟรีสปิน แต่มีฟีเจอร์สุ่มที่หมุนซ้ำ ส่วน Sugar Rush ของ Pragmatic Play ใช้ระบบร่วงหล่น จ่ายเมื่อสัญลักษณ์เหมือนกันติดกันเป็นกลุ่ม
    </p>

    <p class={bodyClass}>
      Money Coming ของ JILI มีวงล้อตัวเลข 3 วงกับวงพิเศษวงที่สี่ที่ให้ตัวคูณ หมุนซ้ำ หรือเข้าโบนัส ส่วน Koi Gate ของ Habanero ใช้ปลาคาร์ฟเป็นไวลด์ที่ขยายเต็มแถวแล้วหมุนซ้ำ
    </p>

    <p class={closerClass}>ชื่อค่ายบอกสไตล์ ชื่อเกมบอกกลไก</p>
  </ContentBox>

  <ContentBox as="h2" title="เล่น 777RUAY ผ่านเบราว์เซอร์มือถือ iOS และ Android ไม่ต้องโหลดแอป">
    <p class={bodyClass}>
      ทางเข้าเปิดผ่านเบราว์เซอร์บนมือถือได้ทั้ง iOS และ Android ไม่ต้องโหลดแอปเพิ่ม คนที่เปลี่ยนโทรศัพท์หรือสลับไปใช้แท็บเล็ตระหว่างวันจึงไม่ต้องลงโปรแกรมใหม่ทุกครั้ง
    </p>

    <p class={bodyClass}>
      บนคอมก็เปิดบนจอใหญ่ได้เหมือนกัน สมาชิกเดิมที่ย้ายเครื่องใช้ยูสกับรหัสชุดเดิมล็อกอินได้เลย ไม่ต้องสมัครซ้ำ แค่เปิด <a href="/ทางเข้า/" class={linkClass}>ทางเข้า 777RUAY</a> ในเครื่องใหม่ก็เล่นต่อได้
    </p>

    <p class={closerClass}>เปลี่ยนเครื่องได้ ยูสยังเป็นของเดิม</p>
  </ContentBox>

  <ContentBox as="h2" title="ฝากถอนออโต้ตลอด 24 ชั่วโมง ไม่ต้องแนบสลิป จัดการจบบนมือถือเครื่องเดียว">
    <p class={bodyClass}>
      ระบบฝากถอนปรับยอดเครดิตให้เอง ไม่ต้องแคปหน้าจอแนบสลิปส่งให้พนักงานตรวจ และไม่ต้องรอแอดมินตอบรับ จะเติมตอนดึกหรือถอนตอนเช้าตรู่ก็ทำรายการผ่านหน้าเว็บได้ตลอด 24 ชั่วโมง
    </p>

    <p class={bodyClass}>
      ตั้งแต่กดสมัคร ฝากเครดิต เลือกค่ายเข้าเล่นสล็อตออนไลน์ ไปจนถึงกดถอนเงิน ทำได้บนมือถือเครื่องเดียว ไม่ต้องเปิดคอมเพิ่ม รายละเอียดแต่ละขั้นอยู่ที่หน้า <a href="/วิธีฝากถอน/" class={linkClass}>วิธีฝากถอน</a>
    </p>

    <p class={closerClass}>เรื่องเงินทำจากเครื่องเดียวกับที่เล่น</p>
  </ContentBox>

  <ContentBox as="h2" title="ก่อนล็อกอิน 777RUAY เช็กชื่อเว็บ รักษารหัสผ่านกับ OTP และรู้ช่องทางติดต่อแอดมิน">
    <p class={bodyClass}>
      ลิงก์ที่ส่งต่อกันในแชตมีหลายหน้าตา ก่อนกรอกรหัสทุกครั้งจึงมองชื่อเว็บบนแถบที่อยู่ให้ตรงก่อน รหัสผ่านกับ OTP ไม่ส่งให้ใคร แม้คนที่ทักมาจะอ้างว่าเป็นทีมงานก็ตาม
    </p>

    <p class={bodyClass}>
      ล็อกอินไม่ผ่าน ฝากแล้วเครดิตไม่ขึ้น หรือมีรายการค้าง ติดต่อแอดมินผ่านช่องทางบนหน้า <a href="/contact-us/" class={linkClass}>ติดต่อเรา</a> อย่าเพิ่งโอนซ้ำ แจ้งช่วงเวลาที่ทำรายการกับยอดเงินไปพร้อมกัน
    </p>

    <p class={closerClass}>ข้อมูลที่แจ้งครบตั้งแต่ข้อความแรก คือสิ่งที่ทำให้แอดมินหารายการของเราเจอเร็วที่สุด</p>
  </ContentBox>

  <Navfoot />
</MainLayout>
