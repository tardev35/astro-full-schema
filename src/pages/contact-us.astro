---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxCyberCut.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement2.astro";

import { Picture } from "astro:assets";
import imgLine from "../assets/contact-line.webp";
import { pageGraph } from "../lib/schema";
import { BRAND_ADDRESS } from "../lib/brandProfile";

// One string, used three times: MainLayout's <meta name="description">, the
// WebPage node's description, and nothing else. Keeping it in a const is what
// stops the meta tag and the structured data from drifting apart — they used to
// be two hand-typed variants of the same sentence, and the JSON-LD copy was the
// one nobody reread. 150–160 CHARACTERS (Thai is 3 bytes/char, so a byte count
// reads ~3x too long and will send you rewriting a description that was fine).
const pageDescription =
  "ช่องทางติดต่อทีมงาน WINSIAM88 ผ่าน LINE Official สำหรับปัญหาสมัครสมาชิก เข้าสู่ระบบ ด้วย PIN โปรโมชั่น และสถานะฝากถอนออโต้ พร้อมข้อมูลที่ควรเตรียมก่อนแจ้ง";

const graph = pageGraph(Astro, {
  type: "ContactPage",
  name: "ติดต่อทีมงาน WINSIAM88 ผ่าน LINE Official",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ติดต่อเรา", path: "/contact-us" },
  ],
  org: {
    alternateName: "WINSIAM88 เว็บหลักรวมสล็อต คาสิโน 13 ค่าย และกีฬา",
    contactPoints: [
      {
        contactType: "customer service",
        availableLanguage: ["Thai", "English"],
        // Point at this site's own /line hop, not the short link behind it.
        // This page is indexed, and structured data is read and stored by
        // Google directly — so a shortener host here is the group's most
        // exposed shared identifier. /line forwards to the same place and
        // that redirect page is noindex.
        //
        // `contactOption: "TollFree"` used to be here. That enum describes a
        // freephone NUMBER; on a chat link it is simply false, and a
        // ContactPoint Google rejects takes the rest of the node with it.
        path: "/line",
        description: "ติดต่อแอดมินผ่าน LINE Official",
      },
    ],
  },
});
---

<MainLayout
  title="ติดต่อเรา WINSIAM88 แจ้งปัญหาสมัครสมาชิก โปรโมชั่น และฝากถอนออโต้ ผ่าน LINE Official"
  description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="ติดต่อทีมงาน WINSIAM88" as="h1">
    <h2 class="mb-6 text-2xl leading-normal font-bold text-[#d4a017]">ติดปัญหาสมัครสมาชิก เข้าสู่ระบบ โปรโมชั่น หรือสถานะฝากถอน ทักทีมงาน WINSIAM88 ทางไหน</h2>

    <Picture
      src={imgLine}
      alt="พนักงานหญิงในชุดเลื่อมสีชมพูยิ้มอยู่ข้างปุ่ม LINE Support สีเขียว ช่องทางแชตกับทีมงาน WINSIAM88"
      loading="lazy"
      fetchpriority="low"
      widths={[200, 400, 600]}
      sizes="(max-width: 768px) 100vw"
      class="mx-auto h-auto w-full max-w-[400px] object-contain shadow-[0_10px_30px_rgba(212,160,23,0.18)]"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={60}
    />
    <p class="my-5 text-left text-base leading-relaxed text-[#dfeacf]">
      ช่องทางหลักของ <strong class="text-[#f5cf4d]">WINSIAM88</strong> คือ LINE Official ที่แสดงอยู่บนหน้าเว็บ ใช้ได้ตั้งแต่ขั้นตอนสมัครสมาชิกที่ใช้เบอร์โทรศัพท์ ชื่อบัญชีธนาคารที่ตรงกับผู้สมัคร และรหัส PIN 4 หลักเป็นข้อมูลหลัก ไปจนถึงการเข้าสู่ระบบ การตั้ง PIN ใหม่เมื่อเข้าบัญชีไม่ได้ การหาเกมสล็อตตามค่าย การเลือกโต๊ะคาสิโนสดจากคาสิโนมากกว่า 13 ค่ายอย่างบาคาร่าและรูเล็ต รวมถึงการตรวจสถานะรายการฝากถอนออโต้ที่ส่งไปแล้ว
      ระบบออโต้ใช้เวลาประมาณ 10–30 วินาทีสำหรับฝาก และ 1–3 นาทีสำหรับถอน ขึ้นอยู่กับธนาคารและสถานะระบบ ถ้ายอดยังไม่เปลี่ยนหรือรายการยังไม่ขึ้นสถานะ ให้ทักมาพร้อมเวลาทำรายการและภาพหน้าจอแทนการกดซ้ำ เพราะรายการซ้ำใช้เวลาตรวจย้อนหลังนานกว่าการรอรอบเดิมเสียอีก
    </p>

    <h2 class="mt-8 mb-6 text-2xl leading-normal font-bold text-[#d4a017]">ควรเตรียมข้อมูลอะไรก่อนแจ้งเรื่อง และอะไรที่ห้ามส่งให้ใครเด็ดขาด</h2>

    <p class="mb-6 text-left text-base leading-relaxed text-[#dfeacf]">
      ก่อนทักเข้ามา ควรเตรียมเบอร์โทรศัพท์ที่ใช้สมัคร เวลาที่ทำรายการ ชื่อบัญชีธนาคารและยอดเงินที่โอน ถ้าเป็นเรื่องเกมให้ระบุค่ายและชื่อเกม ยอดเดิมพันต่อรอบ และเวลาที่กด ถ้าเป็นเรื่องโปรโมชั่นให้ระบุชื่อโปรที่กดรับและยอดฝากที่ใช้รับสิทธิ์ เพราะยอดขั้นต่ำ เปอร์เซ็นต์โบนัส จำนวนเทิร์น เกมที่ร่วมรายการ และยอดถอนสูงสุดของแต่ละโปรไม่เท่ากัน ส่วนสิทธิ์คืนยอดเดิมพัน 1% ให้แจ้งรอบคำนวณที่สงสัยมาด้วย แนบภาพหน้าจอที่เกี่ยวข้องมาให้ครบ ข้อมูลครบตั้งแต่ข้อความแรกช่วยได้มากกว่าการเล่าเป็นตอน ๆ
      ที่สำคัญคือไม่ควรส่งรหัส PIN หรือ OTP ให้ผู้อื่นไม่ว่ากรณีใด ทีมงานไม่มีความจำเป็นต้องขอสองอย่างนี้ ต่อให้อีกฝั่งพิมพ์มาสุภาพแค่ไหน ตัวเลขชุดนี้ก็ไม่ได้มีไว้แบ่งปัน หากลืม PIN ควรใช้เมนูกู้คืนจากระบบโดยตรง และควรติดต่อผ่านช่องทางที่แสดงบนเว็บไซต์จริงเท่านั้น ไม่ใช่ลิงก์ที่เด้งมาจากข้อความส่วนตัว
    </p>

    {
      BRAND_ADDRESS.lines.length > 0 && (
        <address
          aria-label={BRAND_ADDRESS.label}
          class="mt-8 mb-8 border-l-4 border-[#a3e635] pl-6 text-left text-base leading-relaxed text-[#dfeacf] not-italic">
          <p class="mb-1 font-bold text-[#f5cf4d]">{BRAND_ADDRESS.label}</p>
          {BRAND_ADDRESS.lines.map((line) => (
            <span class="block">{line}</span>
          ))}
        </address>
      )
    }

    <div class="flex flex-wrap justify-center gap-4">
      <a
        href="/register"
        aria-label="สมัครสมาชิก"
        class="flex items-center justify-center rounded-lg border border-[#d4a017]/60 bg-gradient-to-b from-[#f5cf4d] via-[#d4a017] to-[#9a7112] px-8 py-3 font-bold text-[#0f1a06] shadow-[0_10px_30px_rgba(212,160,23,0.18)] transition-transform hover:scale-105 hover:shadow-[0_15px_40px_rgba(163,230,53,0.30)]">
        สมัครสมาชิก
      </a>

      <a
        href="/login"
        aria-label="เข้าสู่ระบบ"
        class="flex items-center justify-center rounded-lg border border-[#d4a017]/60 bg-[#0b1408] px-8 py-3 font-extrabold text-[#f5cf4d] shadow-[0_4px_14px_rgba(212,160,23,0.18)] transition-transform hover:scale-105 hover:bg-[#122010]">
        เข้าสู่ระบบ
      </a>

      <a
        href="/line"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="ติดต่อทีมงานผ่าน Line Official"
        class="flex items-center justify-center rounded-lg border border-green-300 bg-gradient-to-b from-green-400 to-green-700 px-8 py-3 font-bold text-white transition-transform hover:scale-105">
        ติดต่อผ่าน Line Official
      </a>
    </div>
  </ContentBox>
  <Navfoot />
</MainLayout>
