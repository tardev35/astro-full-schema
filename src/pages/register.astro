---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement2.astro";
import CtaRedirect from "../components/CtaRedirect.astro";
import { pageGraph } from "../lib/schema";

const pageTitle = "สมัครสมาชิก AMD365 | ปุ่มเปิดยูสใหม่ผ่านมือถือ เล่นครบในบัญชีเดียว";

const pageDescription =
  "หากคุณกำลังมองหาเว็บเกมออนไลน์ที่สมัครง่าย AMD365 มีปุ่มเปิดยูสใหม่ผ่านมือถือ เข้าเล่นสล็อต คาสิโนสด กีฬา และหวยในบัญชีเดียว ฝากถอนออโต้โอนไวจากหน้าเมมเบอร์";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "สมัครสมาชิก", path: "/register" },
  ],
});

const targetUrl = "https://yoalink.com/22hs";
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="สมัครสมาชิก AMD365" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label="สมัครสมาชิก AMD365"
        class="group relative mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#a06a09] bg-gradient-to-r from-[#ffe9a8] via-[#fec93a] to-[#d4840e] px-6 py-4 text-xl font-bold tracking-wide text-[#160e03] shadow-[0_10px_30px_rgba(254,201,58,0.26)] transition-all duration-300 hover:scale-105 hover:border-[#ffe9a8] hover:shadow-[0_15px_40px_rgba(254,201,58,0.35)]">
        สมัครสมาชิก AMD365
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="สมัครสมาชิก" />
</MainLayout>
