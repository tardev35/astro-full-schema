---
import { Picture } from "astro:assets";
import img1 from "../assets/providers/game1.avif";
import img2 from "../assets/providers/game2.avif";
import img3 from "../assets/providers/game3.avif";
import img4 from "../assets/providers/game4.avif";
import img5 from "../assets/providers/game5.avif";
import img6 from "../assets/providers/game6.avif";

const providers = [
  { alt: "ON Gaming", users: "2,486", isHot: true, img: img1 },
  { alt: "Big Gaming", users: "1,892", isHot: true, img: img2 },
  { alt: "WM Casino", users: "3,102", isHot: true, img: img3 },
  { alt: "Evolution", users: "2,301", isHot: true, img: img4 },
  { alt: "SA Gaming", users: "1,954", isHot: true, img: img5 },
  { alt: "Sexy Baccarat", users: "1,245", isHot: true, img: img6 },
];
---

<div class="mx-auto w-full max-w-[1300px] px-4 py-5 font-sans sm:px-6 lg:px-8">
  <div
    class="mb-8 inline-flex w-full max-w-[1250px] items-center gap-3 rounded-l-md border-l-[6px] border-yellow-500 bg-gradient-to-r from-yellow-900/60 via-yellow-900/10 to-transparent py-2.5 pr-12 pl-4 shadow-[inset_1px_0_0_rgba(234,179,8,0.3)]">
    <span class="text-xl drop-shadow-[0_0_8px_rgba(234,179,8,0.8)]">🎰</span>
    <h2 class="bg-gradient-to-r from-[#fef08a] to-[#ca8a04] bg-clip-text text-xl font-black tracking-wide text-transparent drop-shadow-[0_2px_4px_rgba(0,0,0,0.5)] md:text-2xl">ค่ายคาสิโนยอดฮิต</h2>
  </div>

  <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-6 lg:gap-4">
    {
      providers.map((p) => (
        <div class="group relative flex cursor-pointer overflow-hidden rounded-lg bg-[#2b0404]/80 transition-all duration-300 hover:-translate-y-2 hover:shadow-[0_10px_25px_rgba(234,179,8,0.4)]">
          <div class="pointer-events-none absolute inset-0 z-20 rounded-lg border-2 border-yellow-500/10 transition-all duration-300 group-hover:border-yellow-500/60" />

          <div class="absolute top-2 left-2 z-10 flex items-center gap-1 rounded border border-yellow-900/50 bg-black/80 px-2 py-0.5 text-[10px] font-bold text-yellow-400 shadow-sm backdrop-blur-sm">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 text-yellow-400" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z" clip-rule="evenodd" />
            </svg>
            {p.users}
          </div>

          {p.isHot && (
            <div class="absolute top-2 right-2 z-10 flex items-center gap-1 rounded border border-red-500 bg-gradient-to-r from-red-600 to-red-800 px-2 py-0.5 text-[10px] font-black tracking-wide text-white shadow-md">
              <span>🔥</span> HOT
            </div>
          )}

          <Picture
            src={p.img}
            alt={p.alt}
            formats={["avif", "webp"]}
            fallbackFormat="webp"
            loading="lazy"
            fetchpriority="low"
            widths={[200, 400, 600]}
            decoding="async"
            class="block h-full w-full object-cover grayscale-[20%] transition-transform duration-500 group-hover:scale-110 group-hover:grayscale-0"
          />

          <div class="pointer-events-none absolute inset-0 z-10 bg-yellow-500 opacity-0 mix-blend-overlay transition-opacity duration-300 group-hover:opacity-30" />
        </div>
      ))
    }
  </div>
</div>
<style>
  .font-sans {
    font-family: "Kanit", sans-serif;
  }
</style>
