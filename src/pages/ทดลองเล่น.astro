---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";

import { Picture } from "astro:assets";
import { itemList, pageGraph, schemaCtx } from "../lib/schema";
import image1 from "../assets/gamedemo7.webp";
import image2 from "../assets/gamedemo8.webp";
import image3 from "../assets/gamedemo9.webp";
import image4 from "../assets/gamedemo10.webp";
import image5 from "../assets/gamedemo11.webp";
import image6 from "../assets/gamedemo12.webp";
import image7 from "../assets/gamedemo13.webp";
import image8 from "../assets/gamedemo14.webp";
import image9 from "../assets/gamedemo15.webp";
import image10 from "../assets/gamedemo16.webp";
import image11 from "../assets/gamedemo17.webp";
import image12 from "../assets/gamedemo18.webp";

const demoGames = [
  { name: "AskmeSlot", src: image1, alt: "แบนเนอร์ค่าย askmeslot โลโก้โพดำสีทองที่มีสัญลักษณ์ไพ่อยู่ข้างใน คู่กับตัวการ์ตูนเด็กชายสวมหมวกแดงติดดาว กางแขนวิ่งบนถนนในเมืองยุโรปที่มีกังหันลม" },
  { name: "Popular Game", src: image2, alt: "แบนเนอร์ Popular Game ตัวอักษรทองนูนหน้าวงแหวนชิปคาสิโนสีทอง ขนาบด้วยกระต่ายถือหีบสมบัติกับแมวใส่แว่นกันแดด ท่ามกลางเหรียญทองและชิปที่ลอยฟุ้ง" },
  { name: "SlotXO", src: image3, alt: "แบนเนอร์ค่าย SLOTXO โลโก้ตู้สล็อตล้อมด้วยเหรียญทอง คู่กับนักรบโรมันผมขาวสวมมงกุฎใบลอเรลและเกราะทอง ยืนหน้าโคลอสเซียมกับทหารอีกสองนาย" },
  { name: "Skywind Group", src: image4, alt: "แบนเนอร์ค่าย Skywind Group โลโก้วงกลมสี่สีบนพื้นดำ คู่กับแมวกวักนำโชคสีขาวคาดกระพรวนทอง ยืนข้างไหทองและถุงเงินสีม่วงใต้ต้นซากุระ" },
  { name: "PG Soft", src: image5, alt: "แบนเนอร์ค่าย PG Pocket Games Soft โลโก้ตัวอักษรพิกเซลบนพื้นดำ คู่กับตัวละครหญิงนักรบผิวแทนสวมเครื่องประดับทองและหมวกขนนกสไตล์แอซเท็ก" },
  { name: "SBOBET", src: image6, alt: "แบนเนอร์ค่ายเกม SBOBET โลโก้ตัวอักษรขาวบนพื้นดำ คู่กับตัวการ์ตูนอนิเมะสาวหูจิ้งจอกผมบลอนด์ในชุดกิโมโนสีชมพู มือถืออมยิ้มเกลียวหลากสี" },
  { name: "Sexy Slot", src: image7, alt: "แบนเนอร์ค่าย Sexy Slot ตัวอักษรสีชมพูม่วงมีประกายวิบวับ คู่กับตัวการ์ตูนสาวผมน้ำตาลในชุดรัดรูปสีม่วง นั่งอยู่ในกรอบวงกลมที่ล้อมด้วยหัวใจสีชมพู" },
  { name: "JILI", src: image8, alt: "แบนเนอร์ค่ายเกม JILI ตัวอักษรทองบนพื้นดำ คู่กับนางเงือกผมแดงสวมเกราะเปลือกหอยสีทอง ยกหอยสังข์แนบหูอยู่ใต้ทะเลที่มีปลาการ์ตูนและปะการัง" },
  { name: "Ask Me Bet", src: image9, alt: "แบนเนอร์ค่ายเกม ask me bet โลโก้สามช่องสีขาวเขียวเหลืองบนพื้นดำ คู่กับหัวสิงโตเชิดสีแดงทองตาโต ใต้แถวโคมไฟสีแดงหน้าศาลเจ้า" },
  { name: "New Game", src: image10, alt: "แบนเนอร์ New Game ตัวอักษรสีขาวนูนกลางภาพ ขนาบด้วยตัวการ์ตูนฟักทองหัวไฟกับโครงกระดูกยิ้ม ยืนบนฟลอร์นีออนสีชมพูฟ้าที่เกลื่อนด้วยชิปและลูกเต๋า" },
  { name: "JOKER", src: image11, alt: "แบนเนอร์ค่ายเกม JOKER ตัวอักษรขาวทองบนพื้นดำ คู่กับนักรบโรมันสวมหมวกเหล็กติดขนนกและถือโล่ ยืนเคียงสิงโตกำลังคำรามกลางสนามประลอง" },
  { name: "AFB Gaming", src: image12, alt: "แบนเนอร์ค่ายเกม AFB Gaming โลโก้ตัวอักษรทองบนพื้นดำ คู่กับเทพซุสเคราขาวตาเรืองแสงสีฟ้า สวมมงกุฎใบลอเรลและกำไลทองหน้าวิหารกรีก" },
];

const gameList = demoGames.map((game) => ({ name: game.name, imagePath: game.src.src }));

const pageTitle = "ทดลองเล่นสล็อต BABYSHARK8899 ลองให้พอใจก่อน แล้วค่อยลงเครดิตจริง";

const pageHeading = "ทดลองเล่นสล็อต BABYSHARK8899 เลือกค่ายที่ชอบ ลองให้พอใจก่อนลงเครดิตจริง";

const pageDescription =
  "หากคุณกำลังมองหาที่ลองเกมก่อนลงเครดิตจริง BABYSHARK8899 พร้อมมอบโหมดทดลองจากค่ายดัง ทั้ง PG Soft, JILI, JOKER, SlotXO และ Skywind ให้ลองจนพอใจก่อนเล่นจริง";

const ctx = schemaCtx(Astro);
const graph = pageGraph(Astro, {
  type: "CollectionPage",
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  ],
  extra: [
    itemList(ctx, {
      name: "ทดลองเล่นเกมของ BABYSHARK8899",
      alternateName: "BABYSHARK8899 โหมดทดลองเล่นเกมสล็อตหลายค่ายบนมือถือ ก่อนใช้เครดิตจริงในบัญชีสมาชิกเดียว",
      itemType: "Game",
      items: gameList,
    }),
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox as="h1" title={pageHeading}>
    <p class="mb-4 text-left text-base leading-relaxed">
      หากคุณกำลังมองหาเว็บที่ได้ลองก่อนตัดสินใจ <strong class="text-[#6cc5ff]">BABYSHARK8899</strong> พร้อมมอบโหมดทดลองจากค่ายที่เปิดอยู่ในระบบ ทั้ง PG Soft, JILI, JOKER, SlotXO และ Skywind ให้ลองได้ตามใจ
    </p>

    <p class="mb-4 text-left text-base leading-relaxed">
      เลือกค่ายที่สะดุดตาจากด้านล่างได้เลย กดที่ภาพแล้วระบบจะพาไปยังขั้นตอนเปิดยูส ใช้เวลาไม่กี่นาที จากนั้นค่อยเข้าโหมดทดลองของค่ายนั้นต่อจากหน้าสมาชิก
    </p>

    <p class="text-left text-base leading-relaxed">เปิดจากมือถือ แท็บเล็ต หรือคอมก็เหมือนกัน ใช้ยูสตัวเดิมได้ทุกเครื่อง ไม่ต้องโหลดแอปเพิ่มและไม่ต้องจำรหัสหลายชุด</p>
  </ContentBox>

  <ContentBox as="h2" title="ค่ายไหนสะดุดตา เริ่มจากค่ายนั้นได้เลย ยูสเดียวของ BABYSHARK8899 ใช้ได้ทุกค่าย">
    <p class="mb-4 text-left text-base leading-relaxed">
      ค่ายไหนถูกตาเริ่มจากค่ายนั้นได้เลยครับ เพราะแต่ละค่ายวางจังหวะและฟีเจอร์ไว้ไม่เหมือนกัน ทั้งสล็อตหมุนคลาสสิก เกมฟรีสปิน เกมโบนัสหลายชั้น และเกมยิงปลา
    </p>

    <p class="mb-4 text-left text-base leading-relaxed">
      ปุ่มบนภาพเขียนว่าสมัครเพื่อลอง เพราะมันพาไปที่ขั้นตอนเปิดยูสก่อน เปิดเสร็จก็เข้าค่ายนั้นได้ทันที แล้วสลับไปคาสิโนสดหรือบาคาร่าต่อจากบัญชีเดิมในหน้าสมาชิกเดียวกัน
    </p>

    <p class="mb-8 text-left text-base leading-relaxed">ยูสเดียวสลับได้ทุกค่าย ไม่ต้องเปิดบัญชีใหม่ทีละค่าย และไม่ต้องโยกเครดิตไปมาให้เสียจังหวะตอนกำลังสนุก ทุกอย่างจบในหน้าสมาชิกเดียว</p>
    <div class="mb-5 grid grid-cols-2 gap-5 sm:grid-cols-2 md:grid-cols-4">
      {
        demoGames.map((game) => (
          <div class="group/game relative mx-auto w-full max-w-[400px] overflow-hidden rounded-xl border border-[#0a2258]">
            <Picture
              src={game.src}
              alt={game.alt}
              loading="lazy"
              fetchpriority="low"
              widths={[200, 400, 600]}
              sizes="(max-width: 768px) 50vw, 25vw"
              class="block h-auto w-full object-cover shadow-[0_10px_30px_rgba(11,131,250,0.18)] transition-transform duration-300 group-hover/game:scale-105"
              decoding="async"
              formats={["avif", "webp"]}
              fallbackFormat="webp"
              quality={60}
            />
            <a
              href="/register"
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`สมัครสมาชิกเพื่อลองเล่น ${game.name} ที่ BABYSHARK8899`}
              class="absolute inset-0 flex items-center justify-center bg-[#000b24]/85 opacity-0 transition-opacity duration-300 group-hover/game:opacity-100 focus-visible:opacity-100">
              <span class="rounded-full border border-[#6e0a10]/60 bg-gradient-to-r from-[#ff4d4d] via-[#e8202a] to-[#b0121a] px-6 py-2 font-bold text-white shadow-[0_10px_30px_rgba(232,32,42,0.35)] transition-transform hover:scale-110">สมัครเพื่อลอง</span>
            </a>
          </div>
        ))
      }
    </div>
  </ContentBox>

  <ContentBox as="h2" title="ทดลองเล่นฟรีไม่จำกัดรอบ ลองให้พอใจก่อนใช้เครดิตจริง">
    <p class="mb-4 text-left text-base leading-relaxed">
      เข้าโหมดทดลองแล้วหมุนได้ไม่จำกัดรอบ เพราะเป็นเครดิตสมมติล้วน ๆ อยากลองผิดลองถูกกี่ครั้งก็ตามสบาย ไม่มีอะไรต้องเสี่ยงสักบาท
    </p>

    <p class="mb-4 text-left text-base leading-relaxed">
      ระหว่างลองก็ดูไปด้วยว่าเกมวางสัญลักษณ์ไว้แบบไหน ฟรีสปินกับโบนัสเข้ามาบ่อยแค่ไหน และจังหวะหนึ่งรอบยาวพอกับที่คุณชอบไหม เก็บไว้เป็นข้อมูลตอนเลือกเกมที่จะเล่นจริง
    </p>

    <p class="mb-4 text-left text-base leading-relaxed">กลไกที่คุณเห็นในโหมดทดลองคือชุดเดียวกับตอนเล่นจริง ต่างกันแค่เครดิตที่ใช้หมุน เกมที่คุ้นมือแล้วจึงไม่ต้องเริ่มทำความรู้จักกันใหม่</p>

    <p class="mb-4 text-left text-base leading-relaxed">เรื่องที่ต้องบอกให้ชัดตั้งแต่แรก เครดิตในโหมดทดลองถอนไม่ได้ และไม่นับเป็นยอดเทิร์นของโปรโมชั่นใด ๆ ทั้งสิ้น เอาไว้ทำความรู้จักเกมอย่างเดียว</p>

    <p class="text-left text-base leading-relaxed">
      อีกอย่างคือไม่ใช่ทุกเกมที่มีปุ่มทดลอง เพราะโหมดนี้ขึ้นอยู่กับผู้ให้บริการแต่ละราย ถ้าเกมที่อยากลองยังไม่เปิดไว้ ทักทีมงานที่ดูแลตลอด 24 ชั่วโมงให้ช่วยแนะนำเกมใกล้เคียงได้
    </p>
  </ContentBox>

  <ContentBox as="h2" title="พร้อมเมื่อไหร่ สมัครสมาชิก BABYSHARK8899 แล้วเริ่มเล่นจริงได้ทันที">
    <p class="mb-4 text-left text-base leading-relaxed">
      สมัครจบในไม่กี่นาที แล้วได้ยูสเดียวที่ใช้ได้กับทุกหมวดในเว็บ ทั้งสล็อต คาสิโนสด บาคาร่า และเกมยิงปลา ใช้แค่ข้อมูลที่จำเป็นต่อการเปิดยูสและยืนยันเจ้าของบัญชี
    </p>

    <p class="mb-4 text-left text-base leading-relaxed">
      ฝากถอนเป็นระบบออโต้ที่รับคำขอ ตรวจข้อมูล และอัปเดตสถานะให้เอง ส่งคำขอแล้วดูสถานะรายการได้จากหน้าสมาชิก ไม่ต้องรอเจ้าหน้าที่ไล่เช็กยอดทีละรายการ
    </p>

    <p class="mb-4 text-left text-base leading-relaxed">
      ยอดที่ถอนจ่ายเต็มทุกบิล ไม่มีลดทอนระหว่างทาง ส่วนวงเงินต่อรายการและจำนวนครั้งที่ถอนได้ระบุไว้ในเงื่อนไขของบัญชีและของโปรที่ใช้อยู่ อ่านให้ครบก่อนกดยืนยัน
    </p>

    <p class="mb-4 text-left text-base leading-relaxed">อีกอย่างที่ควรติดตัวไว้เสมอ อย่าบอกรหัสผ่านหรือรหัส OTP กับใครทั้งนั้น แม้คนนั้นจะอ้างว่าเป็นทีมงานก็ตาม เพราะทีมงานจริงไม่มีเหตุต้องขอ</p>

    <p class="text-left text-base leading-relaxed">
      เลือกค่ายที่ถูกใจแล้วเริ่มได้เลยครับ เกมที่คุณคุ้นมือจากโหมดทดลองวันนี้ คือเกมที่พร้อมให้ลงเครดิตจริงในรอบถัดไปแบบไม่ต้องเดา
    </p>
  </ContentBox>

  <Navfoot />
</MainLayout>
