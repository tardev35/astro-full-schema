---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titlecenter?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titlecenter, titleright } = Astro.props;
---

<section class="mx-auto mb-6 w-full max-w-7xl px-4 font-sans">
  <div
    class="relative isolate w-full border border-[#7d0b46]/70 bg-[#170512]/95 p-8 text-[#f3e3ee] shadow-[0_0_25px_rgba(255,45,142,0.16)] transition-all duration-300 hover:border-[#ff2d8e] hover:shadow-[0_0_40px_rgba(255,45,142,0.30)]"
    style="clip-path: polygon(30px 0, 100% 0, 100% calc(100% - 30px), calc(100% - 30px) 100%, 0 100%, 0 30px);">
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-[2px] w-24 bg-gradient-to-r from-[#ff2d8e] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-[2px] w-24 bg-gradient-to-l from-[#ff2d8e] to-transparent"></div>
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-16 w-[2px] bg-gradient-to-b from-[#ff2d8e] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-16 w-[2px] bg-gradient-to-t from-[#ff2d8e] to-transparent"></div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#7d0b46] pb-4">
          <span aria-hidden="true" class="h-8 w-1.5 shrink-0 bg-gradient-to-b from-[#ff2d8e] to-[#ffe814] shadow-[0_0_10px_rgba(255,45,142,0.45)]" />
          <HeadingTag class="bg-gradient-to-r from-[#fff27a] via-[#ffe814] to-[#c9a800] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
      <article class="flex flex-col gap-4 border-b border-[#7d0b46]/50 pb-6 text-left text-base leading-relaxed text-[#f3e3ee] md:border-r md:border-b-0 md:pr-6 md:pb-0">
        {
          titleleft && (
            <p class="flex items-center gap-2 text-lg leading-normal font-black tracking-widest text-[#fff27a] uppercase">
              <span aria-hidden="true" class="h-2 w-2 shrink-0 bg-[#ffe814] shadow-[0_0_5px_rgba(255,232,20,0.8)]" /> {titleleft}
            </p>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 border-b border-[#7d0b46]/50 pb-6 text-left text-base leading-relaxed text-[#f3e3ee] md:border-r md:border-b-0 md:px-4 md:pb-0">
        {
          titlecenter && (
            <p class="flex items-center gap-2 text-lg leading-normal font-black tracking-widest text-[#fff27a] uppercase">
              <span aria-hidden="true" class="h-2 w-2 shrink-0 bg-[#ff2d8e] shadow-[0_0_5px_rgba(255,45,142,0.8)]" /> {titlecenter}
            </p>
          )
        }
        <slot name="center" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f3e3ee] md:pl-6">
        {
          titleright && (
            <p class="flex items-center gap-2 text-lg leading-normal font-black tracking-widest text-[#fff27a] uppercase">
              <span aria-hidden="true" class="h-2 w-2 shrink-0 bg-[#ffe814] shadow-[0_0_5px_rgba(255,232,20,0.8)]" /> {titleright}
            </p>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
