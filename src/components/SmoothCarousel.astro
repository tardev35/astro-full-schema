---
import { Picture } from "astro:assets";

import slide1 from "../assets/slide1.png";
import slide2 from "../assets/slide2.png";
import slide3 from "../assets/slide3.png";
import slide4 from "../assets/slide4.png";

const images = [
  {
    src: slide1,
    alt: "แบนเนอร์ YOK789 เว็บตรง ครบทุกเกม สล็อต คาสิโน หวย กีฬา แสดงหน้าจอมือถือสามเครื่องเป็นภารกิจรายวัน วงล้อ Lucky Wheel และหน้าเช็กอินสะสมพอยท์ พร้อมข้อความ ทำภารกิจรายวันและล็อกอินประจำวัน สะสมพอยท์ร่วมสนุกกับกิจกรรม ร่วมลุ้นรับรางวัล iPhone 17 PM, Vivo Y03 และเครดิตฟรี แจกจริงทุกเดือน และแถบท้าย มั่นใจปลอดภัยมาตรฐานสากล SSL ENCRYPTION, ฝากถอนออโต้รวดเร็ว 1 วินาที ตลอด 24 ชม., คืนยอดเสียสูงสุด 8% ตามเงื่อนไขที่กำหนด, ตรวจสอบได้ทุกยอดรายการ โปร่งใสไร้กังวล",
  },
  {
    src: slide2,
    alt: "แบนเนอร์ YOK789 สล็อต คาสิโน หวย กีฬา บนพื้นเขียวนีออนพร้อมชิปคาสิโนและไพ่ ระบุข้อความ จ่ายจริง คืนยอดเสีย 8% และหัวข้อย่อย เว็บตรงเล่นง่าย รวมเกมในบัญชีเดียว ฝากถอนออโต้ตลอด 24 ชม. พร้อมปุ่มสมัครสมาชิกด้านล่าง",
  },
  {
    src: slide3,
    alt: "แบนเนอร์ YOK789 เว็บตรงครบทุกเกม สล็อต คาสิโน หวย กีฬา ระบุข้อความ จ่ายจริง เช็กได้ คืนยอดเสีย 8% พร้อมตัวเลข มากกว่า 40+ ค่ายเกม กว่า 4,000+ เกม และฝากถอนออโต้ได้ 1 วินาที รวดเร็วทันใจ ต่อด้วยป้ายระบบปลอดภัยมาตรฐานสากล SSL ENCRYPTION ตรวจสอบได้ทุกยอดรายการโปร่งใสไร้กังวล และคืนยอดเสียสูงสุด 8% ตามเงื่อนไขที่กำหนด ปิดท้ายด้วยปุ่มสมัครสมาชิก เริ่มต้นความสนุกได้เลย",
  },
  {
    src: slide4,
    alt: "แบนเนอร์ YOK789 รีวิวเว็บตรง สล็อต คาสิโน หวย กีฬา บนพื้นเขียวและเหรียญทอง ระบุข้อความ เช็กจ่ายจริง และตัวเลข คืนยอดเสีย 8% พร้อมลูกศรชี้ขึ้น ต่อด้วยหัวข้อย่อย รวมเกมหลายหมวดในบัญชีเดียว และเล่นง่าย ฝากถอนออโต้ ปิดท้ายด้วยปุ่มดูรายละเอียด",
  },
];

const COPIES = 3;
const slides = Array.from({ length: COPIES }, () => images).flat();
---

<div class="marquee mx-auto w-full max-w-[1301px] overflow-hidden px-4 py-5">
  <input id="carousel-pause" type="checkbox" class="peer sr-only" />
  <label
    for="carousel-pause"
    class="sr-only cursor-pointer peer-focus-visible:not-sr-only peer-focus-visible:mb-3 peer-focus-visible:inline-block peer-focus-visible:rounded-full peer-focus-visible:border peer-focus-visible:border-[#12b84f]/60 peer-focus-visible:px-4 peer-focus-visible:py-2 peer-focus-visible:text-sm peer-focus-visible:font-bold peer-focus-visible:text-[#5cff9b]">
    หยุด / เล่นสไลด์ภาพ
  </label>

  <div class="marquee-track flex">
    {
      slides.map((slide, index) => {
        const isDuplicate = index >= images.length;
        return (
          <div class="marquee-slide" aria-hidden={isDuplicate ? "true" : undefined}>
            <Picture
              src={slide.src}
              alt={isDuplicate ? "" : slide.alt}
              class="block w-full rounded-xl border border-[#12b84f]/25 object-cover shadow-[0_10px_30px_rgba(18,184,79,0.18)]"
              width={slide.src.width}
              height={slide.src.height}
              loading={index < 2 ? "eager" : "lazy"}
              fetchpriority={index === 0 ? "high" : "auto"}
              decoding="async"
              widths={[200, 400, 600]}
              sizes="(max-width: 768px) 50vw, 33vw"
              formats={["avif", "webp"]}
              fallbackFormat="webp"
              quality={60}
            />
          </div>
        );
      })
    }
  </div>
</div>

<style>
  .marquee {
    --gap: 12px;
    --per-view: 2;
    --shift: calc(-200% - 24px);
  }

  @media (min-width: 768px) {
    .marquee {
      --gap: 16px;
      --per-view: 3;
      --shift: calc(-133.3333% - 21.3333px);
    }
  }

  .marquee-track {
    gap: var(--gap);
    width: 100%;
    animation: carousel-scroll 32s linear infinite;
    will-change: transform;
  }

  .marquee-slide {
    flex: 0 0 calc((100% - (var(--per-view) - 1) * var(--gap)) / var(--per-view));
  }

  @keyframes carousel-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(var(--shift));
    }
  }

  .marquee:hover .marquee-track,
  .marquee:focus-within .marquee-track,
  .marquee > input:checked ~ .marquee-track {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
    }
  }
</style>
