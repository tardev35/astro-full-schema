---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement2.astro";
import CtaRedirect from "../components/CtaRedirect.astro";
import { pageGraph } from "../lib/schema";

const pageTitle = "เข้าสู่ระบบ SUPREME888 | ทางเข้าหน้าสมาชิก สล็อต ถอนได้เต็มทุกบิล";

const pageDescription =
  "หากคุณกำลังมองหาทางกลับเข้ายูสเดิมแบบไม่ต้องค้นลิงก์ SUPREME888 พร้อมมอบปุ่มเข้าสู่ระบบเพียงปุ่มเดียว ใช้ยูสและรหัสเดิมได้ทุกเครื่อง เพื่อกลับไปปั่นต่อได้ทันที";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เข้าสู่ระบบ", path: "/login" },
  ],
});

const targetUrl = "https://yoalink.com/22hs";
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="เข้าสู่ระบบ SUPREME888" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label="เข้าสู่ระบบ SUPREME888"
        class="group relative mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl bg-gradient-to-b from-[#ff4d55] to-[#d0121b] px-6 py-4 text-xl font-bold tracking-wide text-white shadow-[0_10px_30px_rgba(236,27,36,0.30)] transition-all duration-300 hover:scale-105 hover:brightness-110 hover:shadow-[0_15px_40px_rgba(236,27,36,0.45)]">
        เข้าสู่ระบบ SUPREME888
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="เข้าสู่ระบบ" />
</MainLayout>
