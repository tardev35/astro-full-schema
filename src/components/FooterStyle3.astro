---
import { Picture } from "astro:assets";
import BankStrip from "./BankStrip.astro";
import { BRAND_ADDRESS } from "../lib/brandProfile";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });

const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

const quickLinks = [
  { name: "หน้าแรก", path: "/" },
  { name: "ทดลองเล่นเกมฟรี", path: "/ทดลองเล่น/" },
  { name: "โปรโมชั่นสมาชิกใหม่", path: "/promotion/" },
  { name: "ทางเข้าล่าสุด", path: "/ทางเข้า/" },
  { name: "เกี่ยวกับเรา", path: "/about-us/" },
  { name: "สมัครสมาชิก", path: "/register/" },
  { name: "เข้าสู่ระบบ", path: "/login/" },
  { name: "ติดต่อแอดมิน", path: "/contact-us/" },
];

const logoAlt =
  "โลโก้ PAYDAY24 ตัวอักษร PayDay แบบเอียงสามมิติ คำว่า Pay เป็นสีขาวขอบดำ คำว่า Day เป็นสีทองไล่เฉด มีมงกุฎทองวางอยู่เหนือตัว D และมีแถบเฉียงสีทองสามแถบต่อท้าย";
---

<footer class="relative mt-32 w-full border-t border-[#ffe680]/45 bg-[#150726] pt-64 pb-6 font-sans text-[#ede4fb] shadow-[0_-10px_30px_rgba(253,199,0,0.28)] md:pt-40">
  <div
    class="absolute -top-14 left-1/2 z-20 flex w-[92%] max-w-5xl -translate-x-1/2 flex-col items-center justify-between rounded-2xl border border-[#ffe680]/50 bg-gradient-to-r from-[#2c1247] via-[#d99400] to-[#6d28d9] p-6 shadow-[0_15px_40px_rgba(253,199,0,0.32)] md:-top-16 md:flex-row md:p-8">
    <div class="mb-5 flex flex-col text-center md:mb-0 md:text-left">
      <p class="text-xl font-black tracking-wide text-white uppercase italic drop-shadow-[0_2px_4px_rgba(21,7,38,0.6)] md:text-3xl">
        <span aria-hidden="true">🎰</span> เปิดยูส PAYDAY24 วันนี้ รับกิจกรรมเครดิตได้ตั้งแต่วันแรก
      </p>
      <p class="mt-2 text-sm font-medium text-[#ede4fb]/90 md:text-base">
        ยูสเดียวเล่นได้ทั้งสล็อต คาสิโนสด บาคาร่า หวย และกีฬา เช็กอินประจำวัน หมุนกงล้อ และรับคืนยอดเสียได้จากหน้าเมมเบอร์เดิม ฝากถอนออโต้รองรับ True Wallet
      </p>
    </div>

    <a
      href="/register/"
      class="group relative flex items-center justify-center overflow-hidden rounded-full border border-[#ffeeb0] bg-gradient-to-b from-white to-[#ffeeb0] px-8 py-3.5 text-sm font-extrabold whitespace-nowrap text-[#6b4400] shadow-[0_0_15px_rgba(255,230,128,0.5)] transition-all hover:scale-105 md:text-base">
      <span class="relative z-10">สมัครสมาชิกเลย <span aria-hidden="true">🚀</span></span>
      <div aria-hidden="true" class="absolute inset-0 translate-y-full bg-[#fdc700] transition-transform duration-300 group-hover:translate-y-0"></div>
    </a>
  </div>

  <div class="relative z-10 mx-auto max-w-[1200px] px-6">
    <div class="mb-10 grid grid-cols-1 gap-10 md:grid-cols-12 lg:gap-12">
      <div class="flex flex-col gap-6 md:col-span-12 lg:col-span-4">
        <a href="/" class="inline-block origin-left transition-transform hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt={logoAlt}
                widths={[100, 200, 300]}
                sizes="100px"
                height={45}
                loading="lazy"
                decoding="async"
                class="h-[45px] w-auto rounded-md bg-white/95 px-1.5 py-1 drop-shadow-[0_0_12px_rgba(253,199,0,0.55)]"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <p class="bg-gradient-to-b from-white to-[#ffeeb0] bg-clip-text text-3xl font-black text-transparent drop-shadow-[0_0_8px_rgba(255,230,128,0.5)]">PAYDAY24</p>
            )
          }
        </a>
        <p class="text-sm leading-relaxed text-[#ede4fb]/85">
          PAYDAY24 เว็บสล็อตมั่นคงที่รวมสล็อตจาก PG Slot, Joker Gaming และ Jili ไว้กับคาสิโนสด บาคาร่า หวย และกีฬาในบัญชีเดียว เครดิต โปรโมชั่น
          และประวัติรายการอยู่ในหน้าเมมเบอร์เดียวกัน พร้อมกิจกรรมรับเครดิตอย่างเช็กอิน กงล้อ และคืนยอดเสียที่เปลี่ยนไปตามช่วงเวลา
        </p>

        <div class="mt-2 flex flex-wrap gap-3">
          <a
            href="/line/"
            class="flex items-center gap-2 rounded-full border border-[#00B900]/40 bg-[#00B900]/15 px-4 py-2 text-xs font-bold text-[#8fe6a8] shadow-[0_0_10px_rgba(0,185,0,0.15)] transition-colors hover:bg-[#00B900] hover:text-white">
            <span aria-hidden="true" class="text-base">💬</span> LINE OFFICIAL
          </a>
        </div>

        {
          BRAND_ADDRESS.lines.length > 0 && (
            <address aria-label={BRAND_ADDRESS.label} class="mt-2 rounded-xl border border-white/15 bg-black/20 p-4 text-xs leading-relaxed not-italic opacity-90">
              <p class="mb-2 flex items-center gap-2 text-[11px] font-bold tracking-wider uppercase opacity-80">
                <span aria-hidden="true" class="text-sm">📍</span>
                {BRAND_ADDRESS.label}
              </p>
              {BRAND_ADDRESS.lines.map((line) => (
                <span class="block">{line}</span>
              ))}
              {BRAND_ADDRESS.email && (
                <a href={`mailto:${BRAND_ADDRESS.email}`} class="mt-3 inline-flex items-center gap-2 font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                  <span aria-hidden="true" class="text-sm">✉️</span>
                  {BRAND_ADDRESS.email}
                </a>
              )}
            </address>
          )
        }
      </div>

      <div class="md:col-span-6 lg:col-span-5">
        <p class="relative mb-5 inline-block text-lg font-bold tracking-wider text-white uppercase">
          ลิงก์ด่วน (Quick Links)
          <span aria-hidden="true" class="absolute -bottom-2 left-0 h-1 w-1/2 rounded-full bg-gradient-to-r from-[#ffeeb0] to-[#fdc700] shadow-[0_0_8px_rgba(255,230,128,0.6)]"></span>
        </p>

        <div class="grid grid-cols-2 gap-x-4 gap-y-3 text-sm">
          {
            quickLinks.map((link) => (
              <a href={link.path} class="group flex items-center text-[#ede4fb]/85 transition-colors hover:text-white">
                <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#fdc700] transition-transform group-hover:rotate-45" />
                {link.name}
              </a>
            ))
          }
        </div>
      </div>

      <div class="md:col-span-6 lg:col-span-3">
        <p class="relative mb-5 inline-block text-lg font-bold tracking-wider text-white uppercase">
          ระบบการเงิน
          <span aria-hidden="true" class="absolute -bottom-2 left-0 h-1 w-1/2 rounded-full bg-gradient-to-r from-[#ffeeb0] to-[#fdc700] shadow-[0_0_8px_rgba(255,230,128,0.6)]"></span>
        </p>

        <p class="mb-4 text-xs text-[#ede4fb]/85">รองรับการฝาก-ถอนผ่านแอปธนาคารชั้นนำและทรูมันนี่วอลเล็ท โดยควรใช้บัญชีชื่อเดียวกับข้อมูลที่สมัครไว้</p>

        <BankStrip size={30} />

        <div class="mt-3 flex h-10 items-center justify-center rounded border border-white/12 bg-[#2c1247] transition-colors hover:border-[#ffe680]/70" title="ตรวจรายการย้อนหลัง">
          <span class="flex items-center gap-1 text-xs font-bold text-[#ede4fb]"><span aria-hidden="true" class="text-lg text-[#ffeeb0]">🧾</span> เก็บเลขรายการไว้ตรวจสอบได้</span>
        </div>
      </div>
    </div>

    <hr class="mb-6 border-white/15" />

    <div class="mb-6 hidden text-justify text-[10px] leading-relaxed text-[#ede4fb]/65 md:block">
      PAYDAY24 เว็บสล็อตมั่นคง เว็บตรงลิขสิทธิ์แท้ที่รวมเกมสล็อตจากค่ายชั้นนำอย่าง PG Slot, Joker Gaming และ Jili ไว้ในยูสเดียว พร้อมคาสิโนสดจากสตูดิโอ SA Gaming บาคาร่า หวยออนไลน์ที่อัปเดตทุกงวด และแทงบอลออนไลน์
      กิจกรรมรับเครดิตมีทั้งเช็กอินประจำวัน กงล้อ กรอกโค้ด และคืนยอดเสีย โดยแต่ละรายการมีเงื่อนไขและช่วงเวลาของตัวเอง ควรเช็กหน้ากิจกรรมก่อนเริ่มเล่นทุกครั้ง
      ระบบฝากถอนออโต้รองรับ True Wallet เข้าสู่ระบบ PAYDAY24 ด้วยยูสเดิมได้จากมือถือ แท็บเล็ต และคอมพิวเตอร์
    </div>

    <div class="flex flex-col items-center justify-between gap-4 border-t border-white/15 pt-6 text-xs text-[#ede4fb]/75 md:flex-row">
      <p>&copy; {new Date().getFullYear()} <span class="font-bold tracking-wider text-white uppercase">PAYDAY24</span>. All Rights Reserved.</p>

      <div class="flex items-center gap-6">
        <a href="/terms/" class="transition-colors hover:text-white">เงื่อนไขและข้อตกลง</a>
        <a href="/privacy/" class="transition-colors hover:text-white">นโยบายความเป็นส่วนตัว</a>

        <a
          href="#top"
          class="flex h-8 w-8 items-center justify-center rounded border border-white/25 bg-white/10 text-white transition-all hover:border-[#ffe680] hover:bg-[#2c1247] hover:shadow-[0_0_15px_rgba(255,230,128,0.5)]"
          aria-label="กลับขึ้นด้านบนสุดของหน้า">
          <span aria-hidden="true">↑</span>
        </a>
      </div>
    </div>
  </div>
</footer>
