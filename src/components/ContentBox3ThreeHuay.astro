---
const { titleleft, titlecenter, titleright } = Astro.props;
---

<section class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="group relative w-full overflow-hidden rounded-2xl border border-green-500/20 bg-[#032e1f]/70 p-8 text-white/90 shadow-[0_10px_30px_rgba(0,0,0,0.5)] backdrop-blur-md transition-all duration-500 hover:border-yellow-400/40 hover:shadow-[0_15px_40px_rgba(251,191,36,0.15)] md:p-10">
    <div class="relative z-10 grid grid-cols-1 gap-8 md:grid-cols-3">
      <article class="flex flex-col gap-3 border-b border-green-500/20 pb-8 md:border-r md:border-b-0 md:pr-8 md:pb-0">
        {
          titleleft && (
            <h3 class="flex items-center gap-2 text-lg font-black tracking-widest text-yellow-400 uppercase">
              <span class="text-xl">⭐</span> {titleleft}
            </h3>
          )
        }
        <div class="text-sm leading-relaxed text-green-100/80"><slot name="left" /></div>
      </article>

      <article class="flex flex-col gap-3 border-b border-green-500/20 pb-8 md:border-r md:border-b-0 md:px-4 md:pb-0">
        {
          titlecenter && (
            <h3 class="flex items-center gap-2 text-lg font-black tracking-widest text-yellow-400 uppercase">
              <span class="text-xl">⚡</span> {titlecenter}
            </h3>
          )
        }
        <div class="text-sm leading-relaxed text-green-100/80"><slot name="center" /></div>
      </article>

      <article class="flex flex-col gap-3 md:pl-8">
        {
          titleright && (
            <h3 class="flex items-center gap-2 text-lg font-black tracking-widest text-yellow-400 uppercase">
              <span class="text-xl">💰</span> {titleright}
            </h3>
          )
        }
        <div class="text-sm leading-relaxed text-green-100/80"><slot name="right" /></div>
      </article>
    </div>
  </div>
</section>
<style>
  .font-sans {
    font-family: "Kanit", sans-serif;
  }
</style>
