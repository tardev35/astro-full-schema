---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement2.astro";

import { Picture } from "astro:assets";
import { itemList, pageGraph, schemaCtx } from "../lib/schema";
import image1 from "../assets/gamedemo7.webp";
import image2 from "../assets/gamedemo8.webp";
import image3 from "../assets/gamedemo9.webp";
import image4 from "../assets/gamedemo10.webp";
import image5 from "../assets/gamedemo11.webp";
import image6 from "../assets/gamedemo12.webp";
import image7 from "../assets/gamedemo13.webp";
import image8 from "../assets/gamedemo14.webp";
import image9 from "../assets/gamedemo15.webp";
import image10 from "../assets/gamedemo16.webp";
import image11 from "../assets/gamedemo17.webp";
import image12 from "../assets/gamedemo18.webp";

const demoGames = [
  { name: "AskmeSlot", src: image1, alt: "แบนเนอร์ค่าย askmeslot โลโก้โพดำสีทองที่มีสัญลักษณ์ไพ่อยู่ข้างใน คู่กับตัวการ์ตูนเด็กชายสวมหมวกแดงติดดาว กางแขนวิ่งบนถนนในเมืองยุโรปที่มีกังหันลม" },
  { name: "Popular Game", src: image2, alt: "แบนเนอร์ Popular Game ตัวอักษรทองนูนหน้าวงแหวนชิปคาสิโนสีทอง ขนาบด้วยกระต่ายถือหีบสมบัติกับแมวใส่แว่นกันแดด ท่ามกลางเหรียญทองและชิปที่ลอยฟุ้ง" },
  { name: "SlotXO", src: image3, alt: "แบนเนอร์ค่าย SLOTXO โลโก้ตู้สล็อตล้อมด้วยเหรียญทอง คู่กับนักรบโรมันผมขาวสวมมงกุฎใบลอเรลและเกราะทอง ยืนหน้าโคลอสเซียมกับทหารอีกสองนาย" },
  { name: "Skywind Group", src: image4, alt: "แบนเนอร์ค่าย Skywind Group โลโก้วงกลมสี่สีบนพื้นดำ คู่กับแมวกวักนำโชคสีขาวคาดกระพรวนทอง ยืนข้างไหทองและถุงเงินสีม่วงใต้ต้นซากุระ" },
  { name: "PG Soft", src: image5, alt: "แบนเนอร์ค่าย PG Pocket Games Soft โลโก้ตัวอักษรพิกเซลบนพื้นดำ คู่กับตัวละครหญิงนักรบผิวแทนสวมเครื่องประดับทองและหมวกขนนกสไตล์แอซเท็ก" },
  { name: "SBOBET", src: image6, alt: "แบนเนอร์ค่ายเกม SBOBET โลโก้ตัวอักษรขาวบนพื้นดำ คู่กับตัวการ์ตูนอนิเมะสาวหูจิ้งจอกผมบลอนด์ในชุดกิโมโนสีชมพู มือถืออมยิ้มเกลียวหลากสี" },
  { name: "Sexy Slot", src: image7, alt: "แบนเนอร์ค่าย Sexy Slot ตัวอักษรสีชมพูม่วงมีประกายวิบวับ คู่กับตัวการ์ตูนสาวผมน้ำตาลในชุดรัดรูปสีม่วง นั่งอยู่ในกรอบวงกลมที่ล้อมด้วยหัวใจสีชมพู" },
  { name: "JILI", src: image8, alt: "แบนเนอร์ค่ายเกม JILI ตัวอักษรทองบนพื้นดำ คู่กับนางเงือกผมแดงสวมเกราะเปลือกหอยสีทอง ยกหอยสังข์แนบหูอยู่ใต้ทะเลที่มีปลาการ์ตูนและปะการัง" },
  { name: "Ask Me Bet", src: image9, alt: "แบนเนอร์ค่ายเกม ask me bet โลโก้สามช่องสีขาวเขียวเหลืองบนพื้นดำ คู่กับหัวสิงโตเชิดตรุษจีนสีแดงทองตาโต ใต้แถวโคมไฟแดงหน้าศาลเจ้า" },
  { name: "New Game", src: image10, alt: "แบนเนอร์ New Game ตัวอักษรสีขาวนูนกลางภาพ ขนาบด้วยตัวการ์ตูนฟักทองหัวไฟกับโครงกระดูกยิ้ม ยืนบนฟลอร์นีออนสีชมพูฟ้าที่เกลื่อนด้วยชิปและลูกเต๋า" },
  { name: "JOKER", src: image11, alt: "แบนเนอร์ค่ายเกม JOKER ตัวอักษรขาวทองบนพื้นดำ คู่กับนักรบโรมันสวมหมวกเหล็กติดขนนกและถือโล่ ยืนเคียงสิงโตกำลังคำรามกลางสนามประลอง" },
  { name: "AFB Gaming", src: image12, alt: "แบนเนอร์ค่ายเกม AFB Gaming โลโก้ตัวอักษรทองบนพื้นดำ คู่กับเทพซุสเคราขาวตาเรืองแสงสีฟ้า สวมมงกุฎใบลอเรลและกำไลทองหน้าวิหารกรีก" },
];

const gameList = demoGames.map((game) => ({ name: game.name, imagePath: game.src.src }));

const pageTitle = "ทดลองเล่นสล็อต WINNOW168 เปิดดูหน้าเกมก่อนเริ่มเล่นด้วยเครดิตจริง";

const pageHeading = "ทดลองเล่นสล็อต WINNOW168 เปิดดูระบบเกมก่อนเริ่มเล่นด้วยเครดิตจริง";

const pageDescription =
  "ทดลองเล่นสล็อต WINNOW168 เปิดดูหน้าเกมและปุ่มปรับเดิมพันจากมือถือก่อนเริ่มเล่นจริง พร้อมรายชื่อค่ายที่เปิดให้ลอง และสิ่งที่ควรดูก่อนสมัครเข้าใช้งานจริง";

const ctx = schemaCtx(Astro);
const graph = pageGraph(Astro, {
  type: "CollectionPage",
  name: pageHeading,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  ],
  extra: [
    itemList(ctx, {
      name: "ทดลองเล่นเกมสล็อตของ WINNOW168",
      alternateName: "WINNOW168 โหมดทดลองสล็อตหลายค่ายบนมือถือก่อนเล่นด้วยเครดิตจริง",
      itemType: "Game",
      items: gameList,
    }),
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox as="h1" title={pageHeading}>
    <p class="mb-4 text-left text-base leading-relaxed text-[#f2dede]">
      WINNOW168 เป็นเว็บตรงที่รวมบาคาร่าออนไลน์ สล็อต คาสิโนสด และกีฬาไว้ในบัญชีเดียว หมวดสล็อตถูกแยกตามค่ายและรูปแบบการเล่นไว้ในเมนูเดียวกัน
      ทั้ง PG Soft, JOKER, JILI, SlotXO, Skywind Group และ AFB Gaming จึงมองหาเกมได้เร็วขึ้นโดยไม่ต้องเลื่อนหาทีละหน้า เปิดดูได้ทั้งบนมือถือและคอมพิวเตอร์
      ผ่านเบราว์เซอร์ ไม่ต้องโหลดโปรแกรมเพิ่ม
    </p>

    <p class="text-left text-base leading-relaxed text-[#f2dede]">
      หน้านี้จัดไว้ให้กดเปิดดูหน้าเกมก่อนว่าระบบหน้าตาเป็นอย่างไร ปุ่มปรับเดิมพันอยู่ตรงไหน ฟีเจอร์ฟรีสปินเรียกใช้อย่างไร และหนึ่งรอบกินเวลาเท่าไร
      สิ่งที่ควรดูจริง ๆ คือเดิมพันเริ่มต้นต่อรอบ ความผันผวนของเกม และรูปแบบการจ่าย มากกว่าจะดูว่าเกมไหนกำลังเป็นที่พูดถึงที่สุด
      เพราะเกมดังช่วยให้หารีวิวง่ายก็จริง แต่ไม่ได้ช่วยเจรจากับระบบสุ่มให้คุณเป็นการส่วนตัว
    </p>
  </ContentBox>

  <ContentBox as="h2" title="รวมค่ายเกมที่เปิดให้เลือกใน WINNOW168">
    <p class="mb-8 text-left text-base leading-relaxed text-[#f2dede]">
      หมวดสล็อตของ WINNOW168 มีทั้งเกมคลาสสิก เกมโบนัส และเกมใหม่ที่ออกแบบมาสำหรับมือถือ สมาชิกเลือกเกมตามค่าย ธีม ฟรีสปิน หรือตัวคูณที่ชอบได้จากหมวดสล็อตโดยตรง
      การแบ่งเกมตามค่ายและความนิยมช่วยให้ค้นหาได้เร็วขึ้น ไม่ต้องเปิดดูทีละเกมจนลืมว่าตั้งใจเข้ามาเล่นอะไร กดที่ภาพเพื่อไปยังขั้นตอนสมัครและเข้าใช้งานหมวดนั้นได้ทันที
    </p>

    <div class="mb-5 grid grid-cols-2 gap-5 sm:grid-cols-2 md:grid-cols-4">
      {
        demoGames.map((game) => (
          <div class="group/game relative mx-auto w-full max-w-[400px] overflow-hidden rounded-xl">
            <Picture
              src={game.src}
              alt={game.alt}
              loading="lazy"
              fetchpriority="low"
              widths={[200, 400, 600]}
              sizes="(max-width: 768px) 100vw, 25vw"
              class="block h-auto w-full object-cover shadow-[0_10px_30px_rgba(224,30,38,0.18)] transition-transform duration-300 group-hover/game:scale-105"
              decoding="async"
              formats={["avif", "webp"]}
              fallbackFormat="webp"
              quality={60}
            />
            <a
              href="/register"
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`สมัครสมาชิกเพื่อเล่น ${game.name} ที่ WINNOW168`}
              class="absolute inset-0 flex items-center justify-center bg-[#0a0403]/80 opacity-0 transition-opacity duration-300 group-hover/game:opacity-100 focus-visible:opacity-100">
              <span class="rounded-full border border-[#e01e26]/60 bg-gradient-to-r from-[#ff5a5f] via-[#e01e26] to-[#a20d12] px-6 py-2 font-bold text-[#1a0202] shadow-[0_10px_30px_rgba(224,30,38,0.30)] transition-transform hover:scale-110">เล่นเลย</span>
            </a>
          </div>
        ))
      }
    </div>
  </ContentBox>

  <ContentBox as="h2" title="โหมดทดลองบอกอะไรได้ และบอกอะไรไม่ได้">
    <p class="mb-4 text-left text-base leading-relaxed text-[#f2dede]">
      โหมดทดลองบอกได้ว่าเกมทำงานอย่างไร เมนูอยู่ตรงไหน ฟีเจอร์ซื้อฟรีสปินเรียกใช้อย่างไร และหนึ่งรอบใช้เวลาเท่าไร แต่เครดิตในโหมดนี้เป็นยอดสมมติ ถอนไม่ได้
      และผลที่ออกมาก็ไม่ได้แปลว่าเล่นจริงแล้วจะออกในรูปแบบเดียวกัน ต่อให้กดในโหมดทดลองแล้วจังหวะเข้ามือ ก็ไม่ใช่หลักฐานว่าเกมนั้นกำลังรอคุณอยู่
      โหมดนี้มีไว้ศึกษาระบบ ไม่ได้มีไว้ดูดวงผ่านหน้าจอ
    </p>

    <p class="text-left text-base leading-relaxed text-[#f2dede]">
      อีกเรื่องที่ควรเผื่อใจไว้คือโหมดทดลองไม่ได้มีให้ครบทุกเกม จึงควรเปิดหน้ารายละเอียดของเกมดูเสียก่อนเลือก และยอดที่หมุนในโหมดทดลองไม่นับเป็นยอดเทิร์นของบัญชีหรือของโปรโมชั่นใดทั้งสิ้น
      ถ้าเกมที่อยากลองยังไม่มีปุ่มทดลอง ให้ถือว่าวันนี้ยังไม่ถูกจังหวะ ไม่ใช่สัญญาณลับที่ระบบส่งมาให้คุณคนเดียว และเวลาเทียบเกมกัน ให้ดูที่จำนวนไลน์ ตัวคูณ และเงื่อนไขการเข้าฟรีสปิน
      แล้วเอามาเทียบกับงบต่อรอบของตัวคุณเอง นั่นคือข้อมูลที่นำไปตัดสินใจได้จริง ไม่ใช่ความรู้สึกว่าเกมไหนหน้าตาใจดีกว่ากัน
    </p>
  </ContentBox>

  <ContentBox as="h2" title="จากโหมดทดลองไปเล่นจริงกับ WINNOW168 ควรเตรียมอะไรบ้าง">
    <p class="mb-4 text-left text-base leading-relaxed text-[#f2dede]">
      เมื่อพร้อมขยับจากโหมดทดลองไปเล่นด้วยเครดิตจริง เรื่องที่ควรจัดการก่อนคือบัญชีสมาชิก งบต่อรอบ และทางเข้าที่ใช้ ด้านบัญชี WINNOW168 ใช้บัญชีเดียวครอบคลุมทั้งบาคาร่า สล็อต คาสิโนสด และกีฬา
      เครดิต โปรโมชั่น และประวัติรายการจึงรวมอยู่ในหน้าสมาชิกเดียวกัน อยากเปลี่ยนหมวดก็เลือกต่อได้เลย ไม่ต้องตั้งค่าบัญชีใหม่ทุกครั้ง
    </p>

    <p class="mb-4 text-left text-base leading-relaxed text-[#f2dede]">
      ด้านงบ เว็บชูคำว่าไม่มีขั้นต่ำเป็นจุดขายสำหรับการเริ่มต้นด้วยยอดที่เข้าถึงง่าย แต่ควรดูในหน้ารายการว่าเงื่อนไขครอบคลุมยอดฝาก ยอดถอน หรือการเดิมพันหมวดใด เพราะแต่ละบริการอาจกำหนดไม่เหมือนกัน
      ส่วนการทำรายการใช้ระบบฝากถอนอัตโนมัติที่รองรับตลอด 24 ชั่วโมง เติมเครดิต ถอนเงิน และดูสถานะรายการได้จากหน้าบัญชีโดยตรง จึงจัดการยอดได้ตามเวลาที่สะดวก
    </p>

    <p class="text-left text-base leading-relaxed text-[#f2dede]">
      ด้านทางเข้า WINNOW168 รองรับโทรศัพท์ แท็บเล็ต และคอมพิวเตอร์ ใช้บัญชีเดิมเข้าสู่ระบบได้จากอุปกรณ์ที่อยู่ใกล้มือ ความเร็วในการโหลดเกมและเปลี่ยนหมวดยังขึ้นอยู่กับมือถือ เบราว์เซอร์
      และสัญญาณอินเทอร์เน็ตของแต่ละคน จึงควรเผื่อไว้ว่าผลลัพธ์อาจไม่เท่ากันทุกเครื่อง และไม่ควรส่งรหัสผ่านหรือรหัส OTP ให้บุคคลอื่นไม่ว่ากรณีใด
    </p>
  </ContentBox>

  <Navfoot />
</MainLayout>
