---
const providers = [
  { name: "PG SLOT", desc: "สล็อตภาพสวย แตกง่าย", tag: "HOT 🔥", color: "from-red-600 to-red-900" },
  { name: "Pragmatic Play", desc: "ซื้อฟรีสปินสุดคุ้ม", tag: "HIT ⭐", color: "from-orange-600 to-red-800" },
  { name: "Joker Gaming", desc: "สล็อตโรม่าในตำนาน", tag: "POPULAR", color: "from-red-700 to-black" },
  { name: "JILI Games", desc: "เกมยิงปลาอันดับ 1", tag: "NEW 🌟", color: "from-yellow-600 to-red-800" },
  { name: "Habanero", desc: "แจ็คพอตแตกบ่อย", tag: "RECOMMEND", color: "from-red-800 to-gray-900" },
  { name: "EVO Play", desc: "สล็อต 3D ล้ำสมัย", tag: "VIP 💎", color: "from-red-600 to-red-800" },
];
---

<div class="mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans relative z-10">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <h2 class="text-3xl font-black uppercase tracking-widest text-transparent bg-clip-text bg-gradient-to-r from-red-800 via-gray-800 to-gray-400 drop-shadow-[0_2px_10px_rgba(255,255,255,0.2)]">
      ค่ายเกมชั้นนำ <span class="text-red-500">SUMOHENG</span>
    </h2>
    <div class="h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-red-600 to-transparent mt-2"></div>
  </div>

  <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-6 lg:gap-5">
    {
      providers.map((game) => (
        <div class={`group relative flex cursor-pointer flex-col items-center justify-center overflow-hidden rounded-2xl border border-red-500/20 bg-gradient-to-b ${game.color} p-5 shadow-lg backdrop-blur-md transition-all duration-300 hover:-translate-y-2 hover:border-red-400 hover:shadow-[0_10px_30px_rgba(220,38,38,0.4)]`}>
          
          <!-- แสงแฟลร์ตอนโฮเวอร์ -->
          <div class="absolute inset-0 bg-white/5 opacity-0 transition-opacity duration-300 group-hover:opacity-100"></div>
          
          <div class="absolute -right-4 -top-4 flex h-12 w-12 items-end justify-center rounded-bl-full bg-gradient-to-br from-yellow-400 to-yellow-600 text-[9px] font-black text-black shadow-sm transition-transform duration-300 group-hover:scale-110 pl-2 pb-2">
            {game.tag.split(' ')[0]}
          </div>
          
          <div class="text-4xl mb-3 drop-shadow-[0_0_15px_rgba(255,255,255,0.3)] transition-transform duration-300 group-hover:scale-125 group-hover:rotate-3">🎰</div>
          <h3 class="text-center text-sm font-black text-white transition-colors group-hover:text-yellow-400">{game.name}</h3>
          <p class="mt-1 text-center text-[10px] text-gray-300 group-hover:text-white">{game.desc}</p>
          
          <div class="mt-4 w-full rounded-full bg-black/40 py-1.5 text-center text-[11px] font-bold text-red-400 shadow-inner border border-red-500/30 transition-colors duration-300 group-hover:bg-red-600 group-hover:text-white group-hover:border-red-400">
            เข้าเล่นเกม
          </div>
        </div>
      ))
    }
  </div>
</div>
<style>
  .font-sans {
    font-family: "Kanit", sans-serif;
  }
  .font-mono {
    font-family: monospace;
  }
</style>
