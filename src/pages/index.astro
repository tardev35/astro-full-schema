---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/Announcement3.astro";
import ContentBox from "../components/ContentBox.astro";
import ContentBoxPremium from "../components/ContentBoxPremium.astro";
import ContentBoxFloatingBadge from "../components/ContentBoxFloatingBadge.astro";
import ContentBoxNeumorphism from "../components/ContentBoxNeumorphism.astro";
import ContentBoxTwoPremium from "../components/ContentBoxTwoPremium.astro";
import ContentBoxSevenThreePremium from "../components/ContentBoxSevenThreePremium.astro";
import ContentBoxSevenThreeNeumorphism from "../components/ContentBoxSevenThreeNeumorphism.astro";
import ProviderGrid from "../components/ProviderGrid.astro";
import GameRankingBoard from "../components/GameRankingBoard.astro";
import SmoothCarousel from "../components/SmoothCarousel.astro";
import LatestWinnersCyber from "../components/LatestWinnersCyber.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import ReviewCardSumo2 from "../components/ReviewCardSumo2.astro";
import Faq2 from "../components/Faq2.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import imgCommission from "../assets/slide4.png";
import imgAllInOne from "../assets/slide1.png";

const pageTitle = "GGHENG | สล็อตเว็บตรงสายเฮง ระบบแท้100% แตกง่าย จ่ายไม่อั้น";

const pageDescription = "GGHENG สล็อตเว็บตรงสายเฮง ไม่มีขั้นต่ำ ระบบแท้100% เล่นลื่นไหล แตกง่าย ค่าRTP มาตรฐาน ฝากถอน True Wallet หลักล้านก็โอน จ่ายไม่อั้น";

const commissionAlt =
  "ภาพโปรโมชั่น โลโก้ GGHENG หัวข้อ COMMISSION คืนทุกยอดเล่นตลอดทั้งวัน 0.3% เล่นถึง 50% ถอนได้เลย สามารถกดรับง่ายๆ ที่หน้าเว็บได้เลยค่ะ รับสิทธิ์ก่อน 23.59 น. ของทุกวัน ยิ่งเล่นเยอะ ยิ่งได้เยอะ";

const allInOneAlt =
  "ภาพโปรโมชั่นพื้นแดงเข้มประกายไฟ โลโก้ปีกสีแดงทอง GGHENG มุมขวาบน ปุ่มเรียงด้านซ้าย หวย บอล บาคาร่า สล็อต ข้อความทองขนาดใหญ่ ครบจบในที่เดียว แถบล่าง บอล คาสิโน สล็อต ยิงปลา ไก่ชน มวย ไฮโล รูเล็ต กลางภาพเป็นพรีเซนเตอร์หญิงชุดเลื่อมสีดำทอง";

const walletPoints = [
  { icon: "👛", text: "รองรับ True Money Wallet แบบเต็มรูปแบบ" },
  { icon: "🏦", text: "ไม่สะดวกใช้บัญชีธนาคาร ก็ฝาก-ถอนผ่านวอเลทได้ทันที" },
  { icon: "⚡", text: "ระบบออโต้ทำงานไวเหมือนกันทุกช่องทาง" },
  { icon: "🔎", text: "ปลอดภัย แม่นยำ ตรวจสอบได้ทุกยอดธุรกรรม" },
];

const faqs = [
  {
    q: "GGHENG เป็นสล็อตเว็บตรงหรือเว็บเอเย่นต์?",
    a: "GGHENG เป็นสล็อตเว็บตรงสายเฮง ใช้ระบบแท้ 100% จากต่างประเทศ ไม่ใช่เว็บเอเย่นต์ เกมทุกเกมเป็นลิขสิทธิ์แท้จากค่ายแม่โดยตรง",
  },
  {
    q: "GGHENG มีการล็อกยูสหรือปรับอัตราแพ้ชนะหรือไม่?",
    a: "ไม่มี เราทำเว็บแบบจริงจังระยะยาว จึงไม่ยุ่งกับค่าแพ้ชนะหรือปรับอัตราใด ๆ (Lock User) ทุกเกมรันด้วยค่า RTP (Return to Player) มาตรฐานสากลจากค่ายแม่โดยตรง วัดกันที่ดวงและจังหวะของผู้เล่น",
  },
  {
    q: "เล่น GGHENG ได้บนอุปกรณ์อะไรบ้าง ต้องโหลดแอปไหม?",
    a: "รองรับทุกแพลตฟอร์ม ทั้งไอแพด มือถือ และคอมพิวเตอร์ ใช้ยูสเซอร์เดียวเข้าเล่นได้ทันที ระบบเสถียร ลื่นไหล ไม่กินเน็ต และไม่ต้องโหลดแอปให้รกเครื่อง",
  },
  {
    q: "ถอนเงินยอดใหญ่ที่ GGHENG ได้ครบไหม มีค่าธรรมเนียมหรือเปล่า?",
    a: "GGHENG จ่ายไม่อั้น ไม่ว่าจะแตกหลักแสนหรือหลักล้านก็โอนให้ครบทุกบาททุกสตางค์ ไม่มีผ่อนจ่าย และไม่หักค่าธรรมเนียมใดๆ ทั้งสิ้น",
  },
  {
    q: "GGHENG มีขั้นต่ำในการฝากหรือไม่?",
    a: "ไม่มีขั้นต่ำ ไม่ว่าทุนจะมากหรือน้อยก็เริ่มต้นได้ จะฝากหลักสิบหรือหลักร้อยก็เข้าเล่นได้เหมือนสมาชิกทุกคน",
  },
  {
    q: "GGHENG มีเกมสล็อตจากค่ายไหนบ้าง?",
    a: "เรารวบรวมค่ายเกมชั้นนำระดับโลกอย่าง PG SOFT, Pragmatic Play, Joker Gaming และอีกหลายค่ายมาไว้ในที่เดียว ทุกเกมเป็นลิขสิทธิ์แท้ ภาพสวย เสียงชัด เล่นลื่นไหล และอัปเดตเกมใหม่ก่อนใคร",
  },
  {
    q: "ฝากถอนผ่าน True Wallet ที่ GGHENG ได้ไหม?",
    a: "ได้ ระบบการเงินรองรับ True Money Wallet แบบเต็มรูปแบบ สำหรับผู้ที่ไม่สะดวกใช้บัญชีธนาคารก็ฝาก-ถอนผ่านวอเลทได้ทันที ระบบออโต้ทำงานเหมือนกัน ปลอดภัย แม่นยำ และตรวจสอบได้ทุกยอดธุรกรรม",
  },
];

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBoxPremium as="h1" title="GGHENG สล็อตเว็บตรงสายเฮง ระบบแท้100% แตกง่าย จ่ายไม่อั้น">
    <p class="text-left text-base leading-relaxed">
      GGHENG (จีจีเฮง) ต้อนรับว่าที่เศรษฐีใหม่ทุกท่าน ที่นี่ไม่ใช่แค่เว็บสล็อตธรรมดา แต่คือ สล็อตเว็บตรงสายเฮง การันตีด้วยเกียรติของเจ้าของเว็บ เราใช้ ระบบแท้100% จากต่างประเทศ สัมผัส เกมสล็อต
      แตกง่าย ในแบบที่ควรจะเป็น และเมื่อได้เงินรางวัล ไม่ว่าจะยอดเท่าไหร่ GGHENG พร้อม จ่ายไม่อั้น เงินทั้งหมดของเว็บ เตรียมไว้แจกพวกคุณเหล่าสมาชิกโดยเฉพาะ เข้ามาเลยครับ
      มาร่วมสนุกและโกยเงินทุกวัน
    </p>
  </ContentBoxPremium>

  <SmoothCarousel />

  <ContentBoxFloatingBadge as="h2" title="GGHENG สล็อตเว็บตรงสายเฮง ส่งตรงความรวย เข้าได้ทุกแพลตฟอร์ม">
    <p class="text-left text-base leading-relaxed">
      สล็อตเว็บตรงสายเฮง ไม่ได้ถูกกำกัดการเล่นที่ใด หรือแพลตฟอร์มใดแพลตฟอร์มหนึ่ง GGHENG รองรับการใช้งานทุกรูปแบบ ไม่ว่าคุณจะนั่งจิบกาแฟใช้ไอแพด นอนเล่นบนโซฟาด้วยมือถือ
      หรือนั่งทำงานหน้าคอมพิวเตอร์ ใช้ยูสเซอร์เดียวสามารถเข้าถึงความเฮงๆได้ทันที เว็บไซต์ GGHENG เราทำระบบมาให้เสถียร ลื่นไหล ไม่กินเน็ต ไม่ต้องโหลดแอปให้รกเครื่อง
      แค่คลิกเดียวก็เหมือนวาร์ปเข้ามาอยู่ในคาสิโนระดับโลก ส่งตรงความเฮงๆ ให้คุณทุกที่
    </p>
  </ContentBoxFloatingBadge>

  <ContentBoxNeumorphism as="h3" title="เล่นสล็อตที่ GGHENG แตกง่าย ค่าRTP มาตรฐานสากล">
    <p class="text-left text-base leading-relaxed">
      เราเลือกทำเว็บนี้แบบจริงจังระยะยาว ไม่ใช่เว็บที่หวังผลชั่วคราว จึงไม่มีความจำเป็นต้องไปยุ่งกับค่าแพ้ชนะหรือปรับอัตราใด ๆ (Lock User) ให้เสียชื่อ ทุกอย่างที่คุณเล่นคือระบบตรง 100%
      เกมทุกเกมในบ้านหลังนี้ รันด้วยค่า RTP (Return to Player) มาตรฐานสากลจากค่ายแม่โดยตรง นี่คือเหตุผลที่ว่าทำไมเล่นที่นี่ถึง แตกง่าย กว่าเว็บเอเย่นต์ทั่วไป ความเฮงที่ GGHENG เกิดจาก
      “ความแฟร์” ล้วนๆ ครับ วัดกันที่ดวงและจังหวะของคุณจริงๆ ไม่มีระบบผีผลักหรือกลโกงใดๆ ให้ระคายเคืองใจแน่นอน
    </p>
  </ContentBoxNeumorphism>

  <LoginRtpSection />

  <ContentBoxSevenThreeNeumorphism as="h2" titleright="GGHENG จ่ายไม่อั้น ถอนหลักล้านก็โอนครบทุกบาท">
    <Picture
      slot="left"
      src={imgCommission}
      alt={commissionAlt}
      loading="lazy"
      fetchpriority="low"
      widths={[240, 382, 480, 764]}
      sizes="(max-width: 767px) calc(100vw - 96px), 382px"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={70}
      class="mx-auto h-auto w-full rounded-2xl border border-[#5c0b13] shadow-[0_10px_30px_rgba(245,197,66,0.22)]"
    />

    <p slot="right" class="text-left text-base leading-relaxed">
      เล่นได้เงินแล้วต้องได้ถอน! ที่ GGHENG เรามีสภาพคล่องทางการเงินระดับมหาศาล พร้อมเปย์ไม่อั้น ไม่ว่าคุณจะฟลุ๊คแตกแจ็คพอตหลักแสน หรือดวงเฮงสุดขีดได้หลักล้าน
      ผมโอนให้ครบทุกบาททุกสตางค์ทันทีภายในไม่กี่วินาที ไม่มีดึงเชง ไม่มีผ่อนจ่าย และไม่หักค่าธรรมเนียมใดๆ ทั้งสิ้น เงินของคุณ คุณต้องได้ใช้ทันทีครับ
    </p>
  </ContentBoxSevenThreeNeumorphism>

  <LatestWinnersCyber />

  <ContentBox as="h2" title="คนทุนน้อยก็เฮงได้ เพราะ GGHENG ไม่มีขั้นต่ำ">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed">
        ไม่ว่าทุนคุณจะมากหรือน้อย ทีมงานเราเชื่อว่าความเฮงมันสร้างกันได้ครับ GGHENG จึงเปิดให้ทุกคนเริ่มต้นแบบ ไม่มีขั้นต่ำ ฝากหลักสิบ หรือหลักร้อย
        ก็มีสิทธิ์ไปแตะหลักหมื่นหลักแสนเหมือนสมาชิกหลายคนในคลับของผมมาแล้ว ผมต้อนรับทุกคนเสมอ มาลองเริ่มต้นก้าวแรกที่นี่ด้วยกันนะครับ
      </p>

      <a
        href="/register/"
        class="inline-flex w-fit items-center gap-2 rounded-full bg-gradient-to-r from-[#ffe9a3] via-[#f5c542] to-[#c8901a] px-7 py-3 text-sm font-black tracking-widest text-[#2a0203] shadow-[0_10px_30px_rgba(245,197,66,0.34)] transition-transform duration-300 hover:scale-105">
        <span aria-hidden="true">🧧</span> สมัครสมาชิก GGHENG
      </a>
    </div>
  </ContentBox>

  <ContentBoxSevenThreePremium as="h2" titleright="รวมเกมสล็อตค่ายดัง ระบบแท้100% เล่นลื่นไหล รับโชคใหญ่ได้ทุกเกม">
    <Picture
      slot="left"
      src={imgAllInOne}
      alt={allInOneAlt}
      loading="lazy"
      fetchpriority="low"
      widths={[240, 338, 480, 676]}
      sizes="(max-width: 767px) calc(100vw - 96px), 338px"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={70}
      class="mx-auto h-auto w-full rounded-2xl border border-[#5c0b13] shadow-[0_10px_30px_rgba(245,197,66,0.22)]"
    />

    <p slot="right" class="text-left text-base leading-relaxed">
      สมาชิกเว็บ GGHENG ต้องได้เล่นสล็อตของดีมีคุณภาพเท่านั้นครับเรารวบรวมค่ายเกมชั้นนำระดับโลกอย่าง PG SOFT, Pragmatic Play, Joker Gaming และอีกเพียบ มาไว้ให้ครบจบในที่เดียว
      ทุกเกมเป็นลิขสิทธิ์แท้ ภาพสวย เสียงชัด เล่นลื่นไหลไม่มีสะดุด ฟีเจอร์มาเต็ม อัปเดตเกมใหม่ก่อนใคร รับรองว่าเล่นเพลินจนลืมเวลา และทุกช่วงเวลา มีโบนัสแตก รับโชคใหญ่ได้ทุกเกม
    </p>
  </ContentBoxSevenThreePremium>

  <ProviderGrid />

  <GameRankingBoard />

  <ContentBoxTwoPremium as="h2" title="ฝากถอน โอนผ่าน True Wallet ได้เต็มระบบเหมือนธนาคาร">
    <p slot="left" class="text-left text-base leading-relaxed">
      เพื่อความสะดวกสูงสุด เราอัปเกรดระบบการเงินให้รองรับ True Money Wallet แบบเต็มรูปแบบ สำหรับใครที่ไม่สะดวกใช้บัญชีธนาคาร ก็สามารถฝาก-ถอนผ่านวอเลทได้ทันที
      ระบบออโต้ทำงานไวไฟเหมือนกันเป๊ะ ปลอดภัย แม่นยำ ตรวจสอบได้ทุกยอดธุรกรรม จะช่องทางไหนก็รับทรัพย์ได้เหมือนกัน ที่ GGHENG เรื่องเงินเรื่องง่ายเสมอ!
    </p>

    <ul slot="right" class="flex flex-col gap-3">
      {
        walletPoints.map((point) => (
          <li class="flex items-center gap-3 rounded-xl border border-[#5c0b13] bg-[#1f0405] px-4 py-3 text-left text-base leading-relaxed">
            <span aria-hidden="true" class="shrink-0 text-xl">
              {point.icon}
            </span>
            <span>{point.text}</span>
          </li>
        ))
      }
    </ul>
  </ContentBoxTwoPremium>

  <ReviewCardSumo2 title="เสียงตอบรับจาก ผู้ใช้งานจริง" />

  <Faq2 title="คำถามที่พบบ่อยเกี่ยวกับ GGHENG" faqs={faqs} />

  <Navfoot />
</MainLayout>
