---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement4.astro";
import { pageGraph } from "../lib/schema";

const pageTitle = "วิธีฝากถอน BABYSHARK8899 สมัคร ฝาก เล่น ถอน จบในมือถือเครื่องเดียว";

const pageHeading = "วิธีฝากถอน BABYSHARK8899 ทำได้ครบจบในมือถือเครื่องเดียว";

const pageDescription =
  "วิธีฝากถอน BABYSHARK8899 ฝากเข้ายูสและถอนเข้าบัญชีธนาคาร จบในมือถือเครื่องเดียว วิธีรับมือเมื่อโอนแล้วเครดิตไม่เข้า และเงื่อนไขเทิร์นของโปรที่ต้องเช็กก่อนรับ";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "วิธีฝากถอน", path: "/วิธีฝากถอน" },
  ],
});

const linkClass = "font-bold text-[#4da3ff] underline underline-offset-4 transition-colors hover:text-[#ff5a60]";
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox as="h1" title={pageHeading}>
    <p class="mb-4 text-left text-base leading-relaxed">
      ที่ <strong class="text-[#4da3ff]">BABYSHARK8899</strong> สมัคร ฝาก เล่น และถอนจบในมือถือเครื่องเดียว เปิดผ่านเบราว์เซอร์ได้เลยโดยไม่ต้องโหลดแอป ทุกขั้นตอนทำจากหน้าเดียวกับที่เราเปิดเกม สลับมาทำรายการได้จากเครื่องเดิม
    </p>

    <p class="text-left text-base leading-relaxed">
      ใครยังไม่มียูส กด<a href="/register/" class={linkClass}>สมัครสมาชิก BABYSHARK8899</a>ก่อน ใส่ข้อมูลตามหน้าสมัครแล้วเช็กอีกรอบก่อนกดยืนยัน ส่วนสมาชิกเดิมใช้ยูสกับรหัสชุดเดิมล็อกอินจากเครื่องไหนก็ได้ ไม่ต้องสมัครใหม่
    </p>
  </ContentBox>

  <ContentBox as="h2" title="ฝากเงินเข้า BABYSHARK8899 ดูชื่อเว็บบนแถบที่อยู่ให้ตรงก่อนกรอก">
    <p class="mb-4 text-left text-base leading-relaxed">
      ลิงก์ที่ส่งต่อกันในแชตมีหลายหน้าตา ก่อนกรอกยูสกับรหัสเพื่อเข้าไปฝาก ให้มองชื่อเว็บบนแถบที่อยู่ให้แน่ใจว่าตรงกับ BABYSHARK8899 ทุกครั้ง แล้วค่อยกด<a href="/login/" class={linkClass}>เข้าสู่ระบบ</a>
    </p>

    <p class="mb-4 text-left text-base leading-relaxed">
      เข้าสู่ระบบแล้วเลือกเมนูฝาก ทำตามขั้นตอนที่หน้าเว็บแสดง โอนจากบัญชีธนาคารของเราเสร็จแล้วสลับกลับมาที่หน้าเว็บ พอเครดิตเข้ายูสก็เลือกหมวดเกมแรกของวันได้เลย
    </p>

    <p class="text-left text-base leading-relaxed">
      รหัสผ่านกับ OTP ไม่ส่งให้ใคร ไม่ว่าใครจะทักมาด้วยเหตุผลไหน มีเรื่องสงสัยระหว่างฝากให้ถามแอดมินผ่านช่องทางบนหน้าเว็บเท่านั้น ไม่ตอบกลับลิงก์แปลกหน้าที่ส่งเข้ามาในแชต
    </p>
  </ContentBox>

  <ContentBox as="h2" title="โอนแล้วเครดิตไม่เข้า อย่าเพิ่งโอนซ้ำ แจ้งแอดมินพร้อมเวลาและยอดเงิน">
    <p class="mb-4 text-left text-base leading-relaxed">
      ฝากแล้วเครดิตยังไม่เข้า อย่าเพิ่งโอนซ้ำ จดเวลาที่โอนกับยอดเงินไว้ แล้วแจ้งแอดมินผ่านช่องทางบนหน้าเว็บหรือหน้า<a href="/contact-us/" class={linkClass}>ติดต่อเรา</a> ข้อมูลสองอย่างนี้ช่วยให้แอดมินหารายการของเราเจอง่ายขึ้น
    </p>

    <p class="text-left text-base leading-relaxed">
      โอนซ้ำเพราะใจร้อนหนึ่งครั้ง อาจต้องตามเงินสองก้อนแทนก้อนเดียว รอให้แอดมินเช็กรายการแรกให้จบก่อน แล้วค่อยตัดสินใจว่าจะฝากเพิ่มหรือพอแค่นี้
    </p>
  </ContentBox>

  <ContentBox as="h2" title="ถอนเงินจาก BABYSHARK8899 เข้าบัญชีธนาคารของเรา">
    <p class="mb-4 text-left text-base leading-relaxed">
      ขาถอนทำจากหน้าเดียวกับขาฝาก เข้าสู่ระบบ เลือกเมนูถอน ใส่ยอดที่ต้องการแล้วกดยืนยัน เงินออกไปที่บัญชีธนาคารของเรา ทำจากมือถือเครื่องไหนก็ได้ที่ล็อกอินด้วยยูสเดิมอยู่
    </p>

    <p class="text-left text-base leading-relaxed">
      ก่อนกดถอน เช็กก่อนว่ายอดในยูสมาจากโปรโมชั่นตัวไหนหรือเปล่า เพราะแต่ละโปรมีเงื่อนไขเทิร์นกับเพดานถอนของตัวเอง ต้องทำเทิร์นให้ครบตามเงื่อนไขของโปรนั้นก่อน ยอดจึงถอนออกได้ตามเพดานที่กำหนด
    </p>
  </ContentBox>

  <ContentBox as="h2" title="เงื่อนไขเทิร์นของโปรโมชั่น เช็กที่หน้าโปรโมชั่นก่อนกดรับทุกครั้ง">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed">
        โปรโมชั่นแต่ละตัวของ BABYSHARK8899 มีเงื่อนไขเทิร์นกับเพดานถอนของตัวเอง เช่น ฝากรับโบนัสเพิ่ม 10% สำหรับบิลฝาก 100 บาทขึ้นไป ทำเทิร์น 8 เท่า ถอนได้สูงสุด 5 เท่า
      </p>

      <p class="text-left text-base leading-relaxed">
        ส่วนโบนัสฝาก 50% สำหรับยอดฝาก 1,000 บาทขึ้นไป ทำเทิร์น 5 เท่า ถอนได้สูงสุด 2 เท่า ตัวเลขของสองโปรนี้ต่างกันชัดเจน จึงต้องเปิด<a href="/promotion/" class={linkClass}>หน้าโปรโมชั่น</a>อ่านเงื่อนไขของโปรที่จะรับให้ครบก่อนกดรับ
      </p>

      <p class="text-left text-base leading-relaxed">
        โปรที่รับไว้โดยไม่ได้อ่านเงื่อนไข มักกลายเป็นคำถามตอนกดถอน อ่านก่อนรับใช้เวลาไม่ถึงนาที แต่ประหยัดเวลารอคำตอบไปได้หลายรอบ
      </p>

      <div class="flex flex-col items-center justify-center gap-4 pt-4 sm:flex-row">
        <a
          href="/login/"
          aria-label="เข้าสู่ระบบ BABYSHARK8899 เพื่อฝากถอน"
          class="inline-flex w-full max-w-[320px] items-center justify-center gap-2 rounded-xl bg-gradient-to-b from-[#4da3ff] to-[#0554b8] px-8 py-3.5 text-lg font-black tracking-wide text-white shadow-[0_10px_30px_rgba(11,124,244,0.35)] transition duration-300 hover:scale-105 hover:brightness-110">
          <span aria-hidden="true">💳</span> เข้าสู่ระบบเพื่อฝากถอน
        </a>

        <a
          href="/register/"
          aria-label="สมัครสมาชิก BABYSHARK8899"
          class="inline-flex w-full max-w-[320px] items-center justify-center gap-2 rounded-xl bg-gradient-to-b from-[#ff5a60] to-[#b0121a] px-8 py-3.5 text-lg font-bold tracking-wide text-white shadow-[0_10px_30px_rgba(232,32,42,0.35)] transition duration-300 hover:scale-105 hover:brightness-110">
          <span aria-hidden="true">🦈</span> สมัครสมาชิก BABYSHARK8899
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
