---
import kbankLogo from "../assets/banks/kbank.png";
import scbLogo from "../assets/banks/scb.png";
import krungsriLogo from "../assets/banks/krungsri.png";
import ktbLogo from "../assets/banks/ktb.png";

const bankPool = [
  { name: "KBank", color: "bg-[#1155cc]", icon: kbankLogo.src },
  { name: "SCB", color: "bg-[#4e1c80]", icon: scbLogo.src },
  { name: "Krungsri", color: "bg-[#fcd34d]", icon: krungsriLogo.src },
  { name: "KTB", color: "bg-[#0ea5e9]", icon: ktbLogo.src },
];
---

<div class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="relative rounded-3xl border border-red-600/30 bg-[#0a0a0a]/80 px-4 py-8 shadow-[0_10px_40px_rgba(0,0,0,0.8)] backdrop-blur-xl md:p-8">
    <div class="relative z-10 mb-6 flex items-center justify-between border-b border-red-600/30 pb-4">
      <div class="flex items-center gap-3">
        <span class="flex h-10 w-10 items-center justify-center rounded-full border border-red-500/30 bg-red-600/20 text-2xl text-red-500">🏆</span>
        <h2 class="text-xl font-black tracking-widest text-white drop-shadow-sm">รายการถอนเงินล่าสุด <span class="text-red-500">SUMO</span>HENG</h2>
      </div>
      <span class="animate-pulse rounded-full border border-green-500/50 bg-green-900/40 px-3 py-1 text-[10px] font-bold tracking-widest text-green-400 shadow-[0_0_10px_rgba(74,222,128,0.2)]">
        LIVE NOW
      </span>
    </div>

    <div id="feed-sumo-hud" class="relative z-10 flex h-[380px] flex-col gap-3 overflow-hidden"></div>
  </div>
</div>

<script define:vars={{ bankPool }}>
  const feed = document.getElementById("feed-sumo-hud");
  const getRandomStr = (len, chars) =>
    Array.from({ length: len })
      .map(() => chars.charAt(Math.floor(Math.random() * chars.length)))
      .join("");
  const getAmount = () => (Math.floor(Math.random() * (250000 - 1000 + 1)) + 1000).toLocaleString("en-US");

  const createHTML = () => {
    const bank = bankPool[Math.floor(Math.random() * bankPool.length)];
    const user = `0${getRandomStr(1, "89")}***${getRandomStr(4, "0123456789")}`;
    const isBigWin = Math.random() > 0.8;

    const statusClass = isBigWin ? "text-yellow-400 animate-pulse font-black" : "text-green-400 font-bold";
    const statusText = isBigWin ? "SUPER MEGA WIN!" : "ถอนเงินสำเร็จ";
    const boxBorder = isBigWin ? "border-yellow-500/50 shadow-[0_0_15px_rgba(250,204,21,0.2)]" : "border-red-600/20";

    return `
      <div class="winner-row origin-bottom transform translate-y-6 opacity-0 transition-all duration-500 ease-out">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 rounded-xl border ${boxBorder} bg-[#171717]/80 p-4 shadow-sm backdrop-blur-sm transition-all duration-300 hover:border-red-500 hover:bg-[#262626]">
          <div class="flex items-center gap-4">
            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full border border-white/10 ${bank.color} shadow-inner">
              <img src="${bank.icon}" alt="bank" class="h-6 w-6 object-contain grayscale" />
            </div>
            <div class="flex flex-col">
              <span class="text-[10px] font-medium tracking-widest text-gray-400">ยูสเซอร์เนม</span>
              <span class="font-mono text-sm font-bold text-white">${user}</span>
            </div>
          </div>
          <div class="flex items-center justify-between sm:justify-end gap-6 border-t border-red-900/30 pt-3 sm:border-none sm:pt-0">
            <div class="text-[11px] tracking-wider ${statusClass}">${statusText}</div>
            <div class="font-sans text-xl font-black text-transparent bg-clip-text bg-gradient-to-r from-yellow-300 to-yellow-500 drop-shadow-[0_2px_5px_rgba(250,204,21,0.3)]">
              ${getAmount()} <span class="text-xs font-bold text-yellow-600">THB</span>
            </div>
          </div>
        </div>
      </div>
    `;
  };

  const trigger = () => {
    if (!feed) return;
    const tempDiv = document.createElement("div");
    tempDiv.innerHTML = createHTML();
    const newEl = tempDiv.firstElementChild;
    feed.prepend(newEl);
    setTimeout(() => {
      newEl.classList.remove("translate-y-6", "opacity-0");
      newEl.classList.add("translate-y-0", "opacity-100");
    }, 50);
    if (feed.children.length > 5) {
      const last = feed.lastElementChild;
      last.classList.remove("translate-y-0", "opacity-100");
      last.classList.add("translate-y-6", "opacity-0");
      setTimeout(() => last.remove(), 500);
    }
  };
  for (let i = 0; i < 5; i++) {
    trigger();
  }
  setInterval(trigger, 3500);
</script>
<style>
  .font-sans {
    font-family: "Kanit", sans-serif;
  }
  .font-mono {
    ffont-family: "Kanit", sans-serif;
  }
</style>
