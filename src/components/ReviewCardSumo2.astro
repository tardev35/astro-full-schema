---
const reviews = [
  {
    name: "สมาชิกที่หมุนสล็อตเป็นหลัก",
    role: "สลับค่ายกี่รอบก็ใช้ยูสเดิมได้ทั้งวัน",
    stars: 5,
    tag: "สล็อตเว็บตรง",
    content:
      "ที่ถูกใจคือไม่ต้องแยกยูสตามค่ายครับ ล็อกอินครั้งเดียวแล้วไล่ดูได้ว่าค่ายไหนมีเกมที่อยากลอง ถ้าเกมนี้ไม่ใช่ก็เปลี่ยนด้วยเครดิตชุดเดิม อยากพักจากวงล้อคลาสสิกไปเล่นเกมฟรีสปินของอีกค่ายต่อก็ได้ เช็กยอดกับย้อนดูประวัติรายการได้จากจุดเดียว",
    avatar: "🎰",
  },
  {
    name: "สมาชิกที่ตามโปรโมชั่นเป็นช่วง",
    role: "ดูยอดรับ เงื่อนไข และเทิร์นก่อนกดรับ",
    stars: 5,
    tag: "โปรโมชั่น",
    content:
      "ชอบตรงที่โปรเปลี่ยนตามช่วงเวลาแล้วดูได้จากหน้าโปรเลยค่ะ เข้าไปดูได้ว่าตอนนี้มีสิทธิ์อะไรเปิดอยู่บ้าง แล้วอ่านเงื่อนไขกับเทิร์นให้จบก่อนค่อยกดรับ ไม่ต้องรับทุกอัน เลือกเฉพาะอันที่เข้ากับทุนของตัวเองก็พอ จะได้ไม่งงว่าเครดิตก้อนไหนติดเงื่อนไขอะไร",
    avatar: "🎁",
  },
  {
    name: "สมาชิกที่ใช้มือถือเป็นหลัก",
    role: "ฝากถอนออโต้ผ่านธนาคารและวอเลท",
    stars: 5,
    tag: "ฝากถอนออโต้",
    content:
      "ผมใช้มือถืออย่างเดียวครับ ส่งรายการฝากถอนออโต้จบในหน้าเดียว จะใช้บัญชีธนาคารหรือวอเลทก็เลือกได้ตามสะดวก พอเครดิตขึ้นก็กลับเข้าเกมต่อได้เลย ถอนแล้วก็ตามสถานะรายการเองได้จากหน้าเมมเบอร์ วันไหนอยากเปลี่ยนแนวก็เลือกเกมค่ายอื่นด้วยยูสเดิม สลับไปคอมก็เข้าได้เหมือนเดิม",
    avatar: "📱",
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label="เสียงจากสมาชิก VING999" class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#ff3b46] via-[#f2f5f7] to-[#bdcad2] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      เสียงจากสมาชิก <span class="text-[#e01b2d]">VING999</span>
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#e01b2d] to-transparent"></div>
  </div>

  <div class="mx-auto mb-8 flex max-w-md items-center justify-center gap-5 rounded-2xl border border-[#5a1a1e] bg-[#170a0b] px-6 py-4 shadow-[0_10px_30px_rgba(224,27,45,0.18)]">
    <div class="flex flex-col items-center">
      <span class="bg-gradient-to-b from-[#f2f5f7] to-[#7d8b95] bg-clip-text text-4xl leading-none font-black text-transparent">{average}</span>
      <span class="mt-1 text-[10px] font-bold tracking-widest text-[#b3bec6] uppercase">คะแนนเฉลี่ย</span>
    </div>
    <div class="h-12 w-px bg-[#5a1a1e]"></div>
    <div class="flex flex-col gap-1.5">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#e01b2d]" : "text-[#5a1a1e]"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#b3bec6]">คะแนนเฉลี่ย {average} จาก 5 ดาว จากการใช้งานจริงของสมาชิก {reviews.length} ด้าน</span>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
    {
      reviews.map((review) => (
        <article class="group relative isolate flex flex-col gap-4 overflow-hidden rounded-2xl border border-[#5a1a1e] bg-[#170a0b] p-6 text-left shadow-[0_10px_30px_rgba(224,27,45,0.14)] transition-all duration-300 hover:-translate-y-1 hover:border-[#e01b2d]/60 hover:shadow-[0_15px_40px_rgba(224,27,45,0.28)]">
          <span class="absolute inset-y-0 left-0 -z-10 w-1 bg-gradient-to-b from-[#e01b2d] to-[#bdcad2] opacity-80 transition-opacity duration-300 group-hover:opacity-100" />
          <span class="pointer-events-none absolute -top-14 -right-14 -z-10 h-32 w-32 rounded-full bg-[#e01b2d]/16 blur-[50px] transition-all duration-300 group-hover:bg-[#ff3b46]/24" />

          <div class="flex items-center justify-between gap-3">
            <span class="inline-flex items-center gap-1.5 rounded-full border border-[#5a1a1e] bg-[#0a0506] px-3 py-1 text-[10px] font-bold tracking-widest text-[#bdcad2] uppercase">
              <span aria-hidden="true" class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#e01b2d]" />
              {review.tag}
            </span>
            <span class="flex gap-0.5 text-sm">
              <span aria-hidden="true" class="flex gap-0.5">
                {Array.from({ length: 5 }).map((_, i) => (
                  <span class={i < review.stars ? "text-[#e01b2d]" : "text-[#5a1a1e]"}>★</span>
                ))}
              </span>
              <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
            </span>
          </div>

          <p class="text-left text-base leading-relaxed text-[#dce3e8]">{review.content}</p>

          <div class="mt-auto flex items-center gap-3 border-t border-[#5a1a1e] pt-4">
            <span
              aria-hidden="true"
              class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#e01b2d]/40 bg-gradient-to-br from-[#ff3b46] via-[#e01b2d] to-[#8f0a13] text-xl shadow-inner transition-transform duration-300 group-hover:scale-110">
              {review.avatar}
            </span>
            <span class="flex flex-col">
              <span class="text-sm font-black text-[#f2f5f7] transition-colors group-hover:text-[#bdcad2]">{review.name}</span>
              <span class="text-[10px] font-bold tracking-wider text-[#b3bec6] uppercase">{review.role}</span>
            </span>
          </div>
        </article>
      ))
    }
  </div>
</section>
