---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";

import { Picture } from "astro:assets";
import imgLine from "../assets/contact-line.webp";
import { pageGraph } from "../lib/schema";
import { BRAND_ADDRESS } from "../lib/brandProfile";

const pageDescription =
  "หน้าติดต่อทีมงาน ONEHENG89 เว็บสล็อตลิขสิทธิ์แท้ รวมช่องทางแจ้งปัญหาและสอบถามการใช้งานทาง LINE Official ตลอด 24 ชั่วโมง พร้อมที่อยู่ติดต่อ อีเมล และปุ่มเข้าเล่น";

const graph = pageGraph(Astro, {
  type: "ContactPage",
  name: "ติดต่อทีมงาน ONEHENG89 ผ่าน LINE Official",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ติดต่อเรา", path: "/contact-us" },
  ],
  org: {
    alternateName: "ONEHENG89 รวมสล็อตเกมลิขสิทธิ์แท้ โบนัส และระบบออโต้ไว้ในบัญชีเดียว",
    contactPoints: [
      {
        contactType: "customer service",
        availableLanguage: ["Thai", "English"],
        path: "/line",
        description: "ติดต่อแอดมินผ่าน LINE Official",
      },
    ],
  },
});
---

<MainLayout title="ติดต่อทีมงาน ONEHENG89 | แจ้งปัญหาผ่าน LINE Official 24 ชม." description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="ติดต่อทีมงาน ONEHENG89" as="h1">
    <Picture
      src={imgLine}
      alt="พนักงานหญิงผมยาวสีน้ำตาลลอนสวมชุดเลื่อมสีชมพูแขนยาวคอวี ยิ้มกอดอกอยู่หน้าวงกลมสีชมพู ด้านล่างเป็นแถบสีขาวที่มีโลโก้ LINE สีเขียวและคำว่า Support"
      loading="lazy"
      fetchpriority="low"
      widths={[200, 400, 600]}
      sizes="(max-width: 768px) 100vw, 400px"
      class="mx-auto h-auto w-full max-w-[400px] object-contain shadow-[0_10px_30px_rgba(11,63,184,0.14)]"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={60}
    />
    {
      BRAND_ADDRESS.lines.length > 0 && (
        <address aria-label={BRAND_ADDRESS.label} class="mt-8 mb-8 border-l-4 border-[#0b3fb8] pl-6 text-left text-base leading-relaxed text-[#1b2c4a] not-italic">
          <p class="mb-1 font-bold text-[#0a1c3a]">{BRAND_ADDRESS.label}</p>
          {BRAND_ADDRESS.lines.map((line) => (
            <span class="block">{line}</span>
          ))}
          {BRAND_ADDRESS.email && (
            <span class="mt-3 block">
              <span aria-hidden="true" class="mr-2">
                ✉️
              </span>
              <a href={`mailto:${BRAND_ADDRESS.email}`} class="font-bold text-[#0b3fb8] underline decoration-[#0b3fb8]/60 underline-offset-4 transition-colors hover:text-[#16a34a]">
                {BRAND_ADDRESS.email}
              </a>
            </span>
          )}
        </address>
      )
    }

    <div class="flex flex-wrap justify-center gap-4">
      <a
        href="/register"
        aria-label="สมัครสมาชิก"
        class="flex items-center justify-center rounded-lg border border-[#062c85]/60 bg-gradient-to-b from-[#0b3fb8] to-[#062c85] px-8 py-3 font-bold text-white shadow-[0_10px_30px_rgba(11,63,184,0.18)] transition-transform hover:scale-105 hover:shadow-[0_15px_40px_rgba(11,63,184,0.26)]">
        สมัครสมาชิก
      </a>

      <a
        href="/login"
        aria-label="เข้าสู่ระบบ"
        class="flex items-center justify-center rounded-lg border border-[#0b3fb8]/45 bg-[#e6efff] px-8 py-3 font-extrabold text-[#062c85] shadow-[0_4px_14px_rgba(11,63,184,0.14)] transition-transform hover:scale-105 hover:bg-[#d3e3ff]">
        เข้าสู่ระบบ
      </a>

      <a
        href="/line"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="ติดต่อทีมงานผ่าน Line Official"
        class="flex items-center justify-center rounded-lg border border-green-300 bg-gradient-to-b from-green-400 to-green-700 px-8 py-3 font-bold text-white transition-transform hover:scale-105">
        ติดต่อผ่าน Line Official
      </a>
    </div>
  </ContentBox>
  <Navfoot />
</MainLayout>
