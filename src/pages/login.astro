---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import CtaRedirect from "../components/CtaRedirect.astro";
import { pageGraph } from "../lib/schema";

const pageDescription = "หน้าเข้าสู่ระบบ SCLASS88 สล็อตแท้เว็บตรง รวมปุ่มล็อกอินเข้าบัญชีเดิมไว้จุดเดียว ใช้งานผ่านมือถือและคอม เพื่อเลือกเกมค่ายใหญ่ เช็กเครดิต ดูโบนัส และฝากถอนออโต้";

const graph = pageGraph(Astro, {
  name: "เข้าสู่ระบบ SCLASS88 สล็อตแท้เว็บตรง",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เข้าสู่ระบบ", path: "/login" },
  ],
});

const targetUrl = "https://yoalink.com/22hs";
---

<MainLayout title="เข้าสู่ระบบ SCLASS88 | ปุ่มล็อกอินเข้าเล่นสล็อตแท้เว็บตรง" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="เข้าสู่ระบบ SCLASS88" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label="เข้าสู่ระบบ SCLASS88"
        class="group relative mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#f5c542]/45 bg-[#161006] px-6 py-4 text-xl font-bold tracking-wide text-[#ffe9a8] shadow-[0_10px_30px_rgba(245,197,66,0.18)] transition-all duration-300 hover:scale-105 hover:border-[#ffd75e] hover:bg-[#241906] hover:shadow-[0_15px_40px_rgba(245,197,66,0.28)]">
        เข้าสู่ระบบ SCLASS88
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="เข้าสู่ระบบ" />
</MainLayout>
