---
import kbankLogo from "../assets/banks/kbank.png";
import scbLogo from "../assets/banks/scb.png";
import krungsriLogo from "../assets/banks/krungsri.png";
import ktbLogo from "../assets/banks/ktb.png";
import ttbLogo from "../assets/banks/ttb.png";
import { brandFlag, brandPick } from "../lib/brandProfile";

const bankPool = [
  { name: "KBank", color: "bg-[#1155cc]", icon: kbankLogo.src },
  { name: "SCB", color: "bg-[#5b21b6]", icon: scbLogo.src },
  { name: "Krungsri", color: "bg-[#fcd34d]", icon: krungsriLogo.src },
  { name: "KTB", color: "bg-[#0ea5e9]", icon: ktbLogo.src },
  { name: "TTB", color: "bg-[#1279be]", icon: ttbLogo.src },
];

const LETTERS = "abcdefghijklmnopqrstuvwxyz";
const pickFrom = (chars: string, salt: string) => chars.charAt(brandPick(Astro.site, salt, chars.length));

const initialRows = Array.from({ length: 5 }, (_, i) => ({
  bank: bankPool[brandPick(Astro.site, `winner-bank-${i}`, bankPool.length)],
  user: `${pickFrom(LETTERS, `winner-a-${i}`)}${pickFrom(LETTERS, `winner-b-${i}`)}***${[0, 1, 2, 3].map((d) => brandPick(Astro.site, `winner-d${i}-${d}`, 10)).join("")}`,
  amount: (15000 + brandPick(Astro.site, `winner-amount-${i}`, 80001)).toLocaleString("en-US"),
  pending: brandFlag(Astro.site, `winner-pending-${i}`),
}));
---

<div class="mx-auto w-full max-w-[1300px] p-4">
  <section
    aria-label="รายการเติมถอนออโต้ล่าสุดของสมาชิก GGHENG"
    class="relative border-r-4 border-l-4 border-[#e11d1d] bg-[#140202] px-4 py-8 shadow-[0_10px_30px_rgba(225,29,29,0.18)] md:p-10"
    style="clip-path: polygon(20px 0, calc(100% - 20px) 0, 100% 20px, 100% calc(100% - 20px), calc(100% - 20px) 100%, 20px 100%, 0 calc(100% - 20px), 0 20px);">
    <div aria-hidden="true" class="absolute top-0 left-0 h-[1px] w-full bg-gradient-to-r from-transparent via-[#e11d1d] to-transparent"></div>
    <div aria-hidden="true" class="absolute bottom-0 left-0 h-[1px] w-full bg-gradient-to-r from-transparent via-[#f5c542] to-transparent"></div>

    <div class="relative z-10 mb-8 flex items-center justify-between border-b border-[#5a0a0a] pb-4">
      <p class="text-xl font-black tracking-[0.2em] text-[#f5c542]">/// GGHENG_AUTO_WALLET</p>
      <span class="animate-pulse border border-[#ff8a70]/60 px-2 py-1 text-xs font-bold tracking-widest text-[#ff8a70]">24 ชม.</span>
    </div>

    <div
      data-winners-feed
      data-interval="4200"
      data-max-rows="5"
      data-amount-min="15000"
      data-amount-max="95000"
      data-pending-chance="0.4"
      data-user-style="letters"
      data-user-digits="4"
      class="relative z-10 flex flex-col gap-3">
      {
        initialRows.map((row) => (
          <div data-winner-row class="winner-row origin-left transform transition-all duration-500 ease-out">
            <div class="flex items-center justify-between border-l-2 border-[#e11d1d] bg-gradient-to-r from-[#1f0405] to-transparent p-3 transition-colors hover:bg-[#3a0a0d]">
              <div class="flex items-center gap-4">
                <div data-winner-bank class={`flex h-8 w-8 items-center justify-center border border-[#5a0a0a] ${row.bank.color}`}>
                  <img data-winner-icon src={row.bank.icon} alt="" width="20" height="20" loading="lazy" decoding="async" class="h-5 w-5 object-contain" />
                </div>
                <div class="font-mono text-sm text-[#f7e6d0]">
                  USR_ID:{" "}
                  <span data-winner-user class="font-bold text-[#f5c542]">
                    {row.user}
                  </span>
                </div>
              </div>
              <div class="flex items-center gap-6">
                <div
                  data-winner-status
                  data-pending-text="[กำลังทำรายการ]"
                  data-done-text="[ทำรายการสำเร็จ]"
                  class={`winner-status font-mono text-[10px] tracking-widest ${row.pending ? "is-pending" : "is-verified"}`}>
                  {row.pending ? "[กำลังทำรายการ]" : "[ทำรายการสำเร็จ]"}
                </div>
                <div class="font-mono text-xl font-black text-[#f5c542]">
                  <span data-winner-amount>{row.amount}</span> <span class="text-xs text-[#d4b59a]">THB</span>
                </div>
              </div>
            </div>
          </div>
        ))
      }
    </div>

    <p class="relative z-10 mt-6 text-left text-[11px] leading-relaxed tracking-wide text-[#d4b59a]">
      รายการที่แสดงเป็นตัวอย่างการเติม ฝาก ถอนออโต้ของสมาชิก GGHENG ทั้งผ่านทรูมันนี่วอลเล็ทและบัญชีธนาคาร ซึ่งส่งรายการเองได้จากหน้าเมมเบอร์ตลอด 24 ชั่วโมง
      ความเร็วของแต่ละรายการขึ้นอยู่กับช่องทางและสถานะระบบในขณะนั้น สถานะจริงให้ยึดตามหน้าเมมเบอร์ของตัวเอง
    </p>

    <script type="application/json" data-winners-banks set:html={JSON.stringify(bankPool)} />
  </section>
</div>

<script>
  import { startWinnersFeed } from "../lib/winnersFeed";

  startWinnersFeed();
</script>

<style>
  .font-mono {
    font-family: monospace;
  }

  .winner-status.is-pending {
    color: #f5c542;
    border-color: #e11d1d;
  }
  .winner-status.is-verified {
    color: #4ade80;
    border-color: color-mix(in oklab, #4ade80 50%, transparent);
  }

  .winner-row.is-entering {
    transform: scaleX(0.95);
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .winner-row {
      transition: none;
    }
  }
</style>
