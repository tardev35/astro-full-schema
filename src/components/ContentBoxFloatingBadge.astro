---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-xl sm:text-2xl md:text-3xl" : "text-lg sm:text-xl md:text-2xl";
---

<section class="my-10 flex w-full justify-center px-4 font-sans">
  <div
    class="relative isolate w-full max-w-[1400px] rounded-2xl border-2 border-[#5c6472] bg-gradient-to-b from-[#120c02] to-[#0e0902] p-8 pt-40 text-left text-base leading-relaxed text-[#f4e8d2] shadow-[0_10px_30px_rgba(201,204,212,0.20)] md:pt-36">
    <div aria-hidden="true" class="pointer-events-none absolute -top-16 -right-10 -z-10 h-40 w-40 rounded-full bg-[#c9ccd4]/24 blur-[60px]"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -bottom-16 -left-10 -z-10 h-40 w-40 rounded-full bg-[#fec93a]/18 blur-[60px]"></div>

    {
      title && (
        <div class="absolute -top-6 left-1/2 flex w-[92%] max-w-2xl -translate-x-1/2 items-center justify-center gap-2 rounded-lg border-2 border-[#fec93a]/55 bg-[#221703] px-4 py-2.5 text-center shadow-[0_10px_30px_rgba(254,201,58,0.30)] sm:px-8">
          <span aria-hidden="true" class="shrink-0 text-[#e6e8ee]">
            ✦
          </span>
          <HeadingTag class={`min-w-0 bg-gradient-to-r from-[#ffe9a8] via-[#fec93a] to-[#e6e8ee] bg-clip-text ${headingSize} leading-normal font-black tracking-tight text-transparent uppercase`}>
            {title}
          </HeadingTag>
          <span aria-hidden="true" class="shrink-0 text-[#e6e8ee]">
            ✦
          </span>
        </div>
      )
    }

    <slot />
  </div>
</section>
