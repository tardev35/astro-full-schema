---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/AnnouncementCyber.astro";
import ContentBox from "../components/ContentBox.astro";
import ContentBoxPremium from "../components/ContentBoxPremium.astro";
import ContentBoxCyberCut from "../components/ContentBoxCyberCut.astro";
import ContentBoxSevenThreePremium from "../components/ContentBoxSevenThreePremium.astro";
import ContentBoxTwoPremium from "../components/ContentBoxTwoPremium.astro";
import ContentBoxSevenThreeCyberCut from "../components/ContentBoxSevenThreeCyberCut.astro";
import ContentBoxFloatingBadge from "../components/ContentBoxFloatingBadge.astro";
import SmoothCarousel from "../components/SmoothCarousel.astro";
import ProviderGrid from "../components/ProviderGrid.astro";
import LatestWinnersCyber from "../components/LatestWinnersCyber.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import ReviewCardSumo2 from "../components/ReviewCardSumo2.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import imgSlots from "../assets/slide4.png";
import imgDeposit from "../assets/slide3.png";

const pageTitle = "TG787 | คาสิโนออนไลน์ควบคู่สล็อตเว็บตรง ฝากถอนออโต้ใน 3 นาที";

const pageDescription =
  "เปิดบัญชี TG787 คาสิโนออนไลน์ถ่ายทอดสดพร้อมสล็อตเว็บตรง เว็บใหญ่จ่ายจริง ฝากถอนไม่มีขั้นต่ำผ่านระบบออโต้เสร็จใน 3 นาที เล่นบนมือถือสะดวกทุกเวลา สมัครวันนี้";

const h1Title = "TG787 คาสิโนออนไลน์ควบคู่สล็อตเว็บตรง ฝากถอนออโต้ใน 3 นาที";

const announcementMessage =
  "TG787 คาสิโนออนไลน์ถ่ายทอดสดควบคู่สล็อตเว็บตรง • ฝากถอนไม่มีขั้นต่ำ ระบบออโต้ทำรายการเสร็จใน 3 นาที ตลอด 24 ชั่วโมง • ล็อกอินยูสเดิมได้ทุกเครื่องทั้ง iOS และ Android ผ่านเบราว์เซอร์ • ติดปัญหาการใช้งานติดต่อแอดมินผ่านช่องทางบนหน้าเว็บได้ทันที";

const slotsAlt =
  "โลโก้หัวเสือ TG787 สล็อตออนไลน์ ครบหลายค่าย รวมเกมยอดนิยมไว้ในที่เดียว ป้ายเกมหลากหลาย ใช้งานสะดวก เลือกได้ครบ และปุ่มเริ่มสนุก พรีเซนเตอร์ชุดสูทสีครีมลายทองชูมือถือ ท่ามกลางเสาหินสีขาวและเหรียญทองบนท้องฟ้าสดใส";

const depositAlt =
  "โลโก้หัวเสือ TG787 ฝากถอนไม่มีขั้นต่ำ ระบบออโต้ ใช้งานง่าย รวดเร็ว ป้ายอัตโนมัติ ทันสมัย สะดวก และปุ่มสมัครเลย เฟืองสีทองขนาดใหญ่มีไอคอนลูกศรหมุนวน พรีเซนเตอร์ชุดผ้าไหมสีเงินลายเสือถือมือถือ";

const graph = pageGraph(Astro, {
  name: h1Title,
  description: pageDescription,
});

const body = "text-left text-base leading-relaxed text-[#2b2622]";
const brandMark = "font-bold text-[#a84a06]";
const inlineLink = "font-bold text-[#1557b0] underline underline-offset-4 transition-colors hover:text-[#a84a06]";
const slideFrame = "mx-auto h-auto w-full max-w-md rounded-2xl border border-[#f1d9c4] shadow-[0_10px_30px_rgba(244,123,32,0.18)]";
const listItem = "rounded-xl border border-[#f1d9c4] bg-[#fff3e8] p-4 text-left text-base leading-relaxed text-[#2b2622]";
const listLabel = "font-bold text-[#1f1611]";
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement message={announcementMessage} />

  <ContentBoxPremium as="h1" title={h1Title}>
    <p class={body}>ผู้เล่นที่กังวลเรื่องความชัดเจนของหน้าโต๊ะเดิมพันมักมองหาพื้นที่ที่แสดงผลตรงไปตรงมา <strong class={brandMark}>TG787</strong> คาสิโนออนไลน์ของเราจึงเปิดโต๊ะถ่ายทอดสดเคียงคู่กับหมวดสล็อตในรูปแบบเว็บตรงที่เป็นเว็บใหญ่จ่ายจริง</p>
    <p class={`mt-4 ${body}`}>คุณเข้าดูหน้าโต๊ะถ่ายทอดสดหรือเปลี่ยนไปหมุนวงล้อได้จากหน้าเว็บเดียวกัน พร้อมจัดการยอดเงินแบบ<a href="/วิธีฝากถอน/" class={inlineLink}>ฝากถอนไม่มีขั้นต่ำ</a>และใช้ฝากถอนออโต้ซึ่งเสร็จสิ้นใน 3 นาทีผ่านเบราว์เซอร์บนมือถือได้ทันที</p>
  </ContentBoxPremium>

  <SmoothCarousel />

  <ContentBoxCyberCut as="h2" title="TG787 คาสิโนออนไลน์ถ่ายทอดสดจากค่ายดังพร้อมโต๊ะเดิมพันที่อ่านผลง่าย">
    <p class={body}>คนที่ชอบเห็นจังหวะเปิดไพ่ด้วยตาตัวเองย่อมรู้ดีว่าภาพสดสำคัญแค่ไหน ห้องคาสิโนออนไลน์ของเราจึงเปิดโต๊ะสดจากค่าย WM Casino และ Dream Gaming (DG) ให้คุณดูดีลเลอร์แจกไพ่จริงผ่านภาพสด</p>
    <p class={`mt-4 ${body}`}>ไม่ว่าจะเลือกอ่านเค้าไพ่บาคาร่าเพื่อวางฝั่งผู้เล่น เจ้ามือ หรือเสมอ สลับไปทายผลสูงต่ำ แต้มรวม และตองในโต๊ะไฮโล หรือตัดสินใจขอไพ่เพิ่มหรือหยุดในเกมแบล็คแจ็ค เหมาะกับคนที่ชอบดูจังหวะหน้าโต๊ะด้วยตาตัวเองก่อนลงเดิมพัน</p>
  </ContentBoxCyberCut>

  <ContentBoxSevenThreePremium as="h2" title="TG787 สล็อต รวมเกมระบบร่วงหล่นและตัวคูณจากหลายค่าย">
    <Picture
      slot="left"
      src={imgSlots}
      alt={slotsAlt}
      loading="lazy"
      fetchpriority="low"
      widths={[280, 380, 480, 600]}
      sizes="(max-width: 543px) calc(100vw - 96px), (max-width: 767px) 448px, (max-width: 1271px) calc(40vw - 61px), 448px"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={70}
      class={slideFrame}
    />

    <div slot="right" class="flex flex-col gap-4">
      <p class={body}>ใครที่เล่นสล็อตมานานอาจเบื่อรูปแบบการจ่ายรางวัลแบบเดิม หมวดสล็อตของเราจึงรวมเกมที่มีกลไกต่างกันให้คุณเลือกตามจังหวะที่ถนัด โดยแต่ละเกมมีจุดเด่นเฉพาะตัวดังนี้</p>
      <ul class="flex flex-col gap-3">
        <li class={listItem}><strong class={listLabel}>PG Soft (Wild Bandito):</strong> เกมธีมโจรเม็กซิกันที่ใช้ระบบร่วงหล่น เมื่อชนะรางวัลสัญลักษณ์กรอบทองจะกลายเป็นไวลด์ และตัวคูณเพิ่มทุกครั้งที่ชนะต่อเนื่องในสปินเดียว</li>
        <li class={listItem}><strong class={listLabel}>Pragmatic Play (The Dog House):</strong> โดดเด่นด้วยสัญลักษณ์ไวลด์ตัวคูณ และเมื่อเข้าสู่รอบฟรีสปินไวลด์ค้างอยู่จนจบรอบช่วยให้ลุ้นรางวัลได้ชัดเจนขึ้น</li>
        <li class={listItem}><strong class={listLabel}>JILI (Golden Empire):</strong> มาในธีมอาณาจักรทองที่ผสานระบบร่วงหล่นกับตัวคูณเข้าด้วยกัน ทำให้การลุ้นสัญลักษณ์ต่อเนื่องในแต่ละรอบเข้าใจง่าย</li>
      </ul>
    </div>
  </ContentBoxSevenThreePremium>

  <ProviderGrid />

  <ContentBoxTwoPremium as="h2" title="เว็บตรงของเรา ล็อกอินยูสเดิมได้ทุกเครื่องผ่านเบราว์เซอร์">
    <p slot="left" class={body}>ผู้เล่นหลายคนสลับเครื่องเล่นระหว่างวัน แล้วกังวลว่าต้องสมัครใหม่ทุกครั้งที่เปลี่ยนเครื่อง ที่เว็บตรงของเรา เมื่อคุณมียูสเซอร์อยู่แล้วสามารถนำรหัสเดิมไปล็อกอินผ่าน<a href="/ทางเข้า/" class={inlineLink}>ทางเข้า</a> <strong class={brandMark}>TG787</strong> ได้ทุกเครื่องทั้ง iOS และ Android โดยไม่ต้องสมัครซ้ำ</p>
    <p slot="right" class={body}>เรื่อง<a href="/register/" class={inlineLink}>การสมัคร</a> ฝาก เล่น และถอนทำจนจบบนมือถือเครื่องเดียวผ่านเบราว์เซอร์ได้โดยไม่ต้องโหลดแอป แนะนำให้ตรวจชื่อเว็บบนแถบที่อยู่ก่อนกรอกรหัสเสมอ</p>
  </ContentBoxTwoPremium>

  <ContentBoxSevenThreeCyberCut as="h2" title="จัดการงบเดิมพันได้อิสระด้วยระบบฝากถอนไม่มีขั้นต่ำที่ทำรายการไว">
    <Picture
      slot="left"
      src={imgDeposit}
      alt={depositAlt}
      loading="lazy"
      fetchpriority="low"
      widths={[280, 380, 480, 600]}
      sizes="(max-width: 543px) calc(100vw - 96px), (max-width: 767px) 448px, (max-width: 1247px) calc(40vw - 51px), 448px"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={70}
      class={slideFrame}
    />

    <div slot="right" class="flex flex-col gap-4">
      <p class={body}>คนที่มีแผนแบ่งงบเล่นเป็นรอบสั้นมักอึดอัดเมื่อเจอกฎบังคับยอดโอนเข้าออกที่สูงเกินความจำเป็น เพราะเราเปิดให้คุณใช้งานฝากถอนไม่มีขั้นต่ำควบคู่ไปกับบริการ<a href="/วิธีฝากถอน/" class={inlineLink}>ฝากถอนออโต้</a>ซึ่งใช้เวลาทำรายการเสร็จใน 3 นาที</p>
      <p class={body}>เมื่อกดโอนแล้วตัวระบบจะปรับเครดิตให้เองโดยไม่ต้องแนบสลิปแจ้งแอดมินให้เสียเวลา คุณจึงเข้ามาเติมเครดิตหรือสั่งถอนยอดได้ตลอด 24 ชั่วโมงตามจังหวะที่สะดวก เหมาะกับคนที่ต้องการควบคุมยอดเงินเข้าออกด้วยตัวเองแบบไม่ยุ่งยาก</p>
    </div>
  </ContentBoxSevenThreeCyberCut>

  <LatestWinnersCyber />

  <ContentBoxFloatingBadge as="h2" title="สมัคร TG787 ผ่านมือถือและติดต่อแอดมินเมื่อพบปัญหาใช้งาน">
    <p class={body}>ถ้าเกิดรายการค้างหรือเข้าระบบไม่ได้ หลายคนกังวลว่าจะไม่รู้ว่าต้องแจ้งใคร เริ่มจาก<a href="/register/" class={inlineLink}>กดสมัคร</a> <strong class={brandMark}>TG787</strong> และกรอกข้อมูลบนหน้าจอมือถือให้เรียบร้อย จากนั้นหากระหว่างใช้งานพบปัญหาล็อกอินไม่ได้ เครดิตไม่ขึ้น หรือมีรายการค้างอยู่ สามารถติดต่อแอดมินผ่าน<a href="/contact-us/" class={inlineLink}>ช่องทางบนหน้าเว็บ</a>ได้ทันที</p>
    <p class={`mt-4 ${body}`}>ข้อสำคัญคือถ้าฝากแล้วยอดเครดิตไม่ขึ้นอย่าโอนซ้ำ ให้แจ้งเวลากับยอดที่ทำรายการเพื่อให้เจ้าหน้าที่ตรวจสอบ พร้อมเก็บรักษารหัสผ่านและไม่บอก OTP กับผู้อื่นเสมอ</p>
  </ContentBoxFloatingBadge>

  <ContentBox>
    <p class={body}>การเริ่มต้นกับ <strong class={brandMark}>TG787</strong> ช่วยให้คุณเข้าถึงทั้งห้องถ่ายทอดสดจากค่ายชั้นนำและเกมวงล้อหลากหลายกลไกภายใต้มาตรฐานเว็บตรงที่เป็นเว็บใหญ่จ่ายจริง ฝากถอนไม่มีขั้นต่ำและใช้ฝากถอนออโต้ซึ่งเสร็จสิ้นภายใน 3 นาทีตลอด 24 ชั่วโมง</p>
    <p class={`mt-4 ${body}`}>รองรับการเล่นผ่านเบราว์เซอร์บนมือถือได้ครบทุกขั้นตอน สำหรับผู้ที่ต้องการพื้นที่เดิมพันที่จัดการง่ายและมีทีมงานดูแลเมื่อติดขัด สามารถ<a href="/register/" class={inlineLink}>เปิดบัญชี</a>ผ่านหน้าเว็บแล้วเลือกหมวดเกมที่ต้องการเล่นได้เลย</p>
  </ContentBox>

  <LoginRtpSection />

  <ReviewCardSumo2 />

  <Navfoot />
</MainLayout>
