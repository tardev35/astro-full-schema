---
const providers = [
  { name: "บาคาร่า", desc: "รวมโต๊ะคาสิโนออนไลน์ไว้เป็นหมวดชัด เลือกเกมและวงเงินที่เหมาะกับตัวเองก่อนเข้าเล่นได้", tag: "หมวดหลัก", icon: "🎴" },
  { name: "สล็อต", desc: "มีหลายธีมและหลายรูปแบบ ตั้งแต่เกมเล่นง่ายไปจนถึงเกมที่มีฟรีสปิน โบนัส และฟีเจอร์พิเศษ", tag: "หมวดหลัก", icon: "🎰" },
  { name: "บอล", desc: "ดูรายการกีฬาและเลือกตลาดที่สนใจได้ สำหรับคนที่ไม่ได้เล่นเฉพาะเกมคาสิโน", tag: "เพิ่มตัวเลือก", icon: "⚽" },
  { name: "หวย", desc: "เข้าเล่นหวยผ่านบัญชีเดียวกับบาคาร่าและสล็อต ไม่ต้องแยกบัญชีตามประเภทเกม", tag: "เพิ่มตัวเลือก", icon: "🎫" },
  { name: "เกมบนมือถือ", desc: "เปิดผ่านเบราว์เซอร์บนมือถือ แท็บเล็ต หรือคอมพิวเตอร์ เลือกเกมได้ตามอุปกรณ์ที่ใช้อยู่", tag: "ทุกอุปกรณ์", icon: "📱" },
  { name: "ฝากถอนออโต้", desc: "เติมเครดิตและถอนยอดเป็นขั้นตอนสั้น ดูสถานะและประวัติรายการจากหน้าบัญชีได้โดยตรง", tag: "ลดเวลารอ", icon: "🔁" },
  { name: "หน้าสมาชิก", desc: "รวมยอดเครดิต โปรโมชั่น และประวัติการทำรายการไว้ในบัญชีเดียว ดูข้อมูลได้จากหน้าเดียว", tag: "รวมจุดเดียว", icon: "🧭" },
];
---

<section aria-label="หมวดเกมและบริการที่ NORWAY89 รวมไว้ในบัญชีเดียว" class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#f5d488] via-[#e0aa2e] to-[#d8cdb6] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      หมวดเกมและบริการที่ <span class="text-[#e0aa2e]">NORWAY89</span> รวมไว้ในบัญชีเดียว
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#e0aa2e] to-transparent"></div>
  </div>

  <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4 lg:gap-5 xl:grid-cols-7">
    {
      providers.map((provider) => (
        <a
          href="/register"
          class="group relative flex flex-col items-center justify-center overflow-hidden rounded-2xl border border-[#e0aa2e]/25 bg-[#160f07]/92 p-5 shadow-[0_10px_30px_rgba(10,7,4,0.55)] backdrop-blur-md transition-all duration-300 hover:-translate-y-2 hover:border-[#e0aa2e]/55 hover:bg-[#241809]/95 hover:shadow-[0_15px_40px_rgba(224,170,46,0.30)]">
          <div class="pointer-events-none absolute inset-0 bg-[#6b4310]/35 opacity-0 transition-opacity duration-300 group-hover:opacity-100" />

          <div class="absolute top-2 right-2 z-10 rounded-full bg-gradient-to-r from-[#f5d488] via-[#e0aa2e] to-[#6b4310] px-2 py-0.5 text-[9px] font-black tracking-wide whitespace-nowrap text-[#120b04] shadow-sm transition-transform duration-300 group-hover:scale-110">
            {provider.tag}
          </div>

          <div aria-hidden="true" class="mb-3 text-4xl transition-transform duration-300 group-hover:scale-125 group-hover:rotate-3">
            {provider.icon}
          </div>
          <p class="text-center text-sm font-black text-[#efe0c4] transition-colors group-hover:text-[#f5d488]">{provider.name}</p>
          <p class="mt-1 text-center text-[10px] text-[#efe0c4]/70">{provider.desc}</p>

          <span class="relative z-10 mt-4 block w-full rounded-full border border-[#e0aa2e]/25 bg-[#0a0704] py-1.5 text-center text-[11px] font-bold text-[#e0aa2e] shadow-inner transition-colors duration-300 group-hover:border-[#e0aa2e]/50 group-hover:bg-gradient-to-r group-hover:from-[#f5d488] group-hover:via-[#e0aa2e] group-hover:to-[#b87814] group-hover:text-[#120b04]">
            เข้าดูหมวดนี้
          </span>
        </a>
      ))
    }
  </div>
</section>
