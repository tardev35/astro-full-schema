---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";

import { Picture } from "astro:assets";
import imgLine from "../assets/contact-line.webp";
import { pageGraph } from "../lib/schema";
import { BRAND_ADDRESS } from "../lib/brandProfile";

const pageTitle = "ติดต่อทีมงาน OHO555 | แจ้งปัญหาการใช้งานผ่าน LINE Official";

const pageDescription =
  "ติดต่อทีมงาน OHO555 ผ่าน LINE Official ตลอด 24 ชั่วโมง เมื่อล็อกอินไม่เข้า เครดิตไม่ขึ้น หรือรายการฝากถอนค้าง ยอดไม่เข้าอย่าโอนซ้ำ ส่งเวลาโอนกับยอดให้แอดมิน";

const graph = pageGraph(Astro, {
  type: "ContactPage",
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ติดต่อเรา", path: "/contact-us" },
  ],
  org: {
    contactPoints: [
      {
        contactType: "customer service",
        availableLanguage: ["Thai"],
        path: "/line",
        description: "ติดต่อทีมงาน OHO555 ผ่าน LINE Official ตลอด 24 ชั่วโมง เรื่องการสมัครสมาชิก การเข้าสู่ระบบ และรายการฝากถอนที่ค้าง",
      },
    ],
  },
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="ติดต่อทีมงาน OHO555" as="h1">
    <div>
      <Picture
        src={imgLine}
        alt="ภาพช่องทางติดต่อทีมงาน OHO555 ทาง LINE ไอคอน LINE สีเขียวทรงสี่เหลี่ยมมุมมน มีกรอบข้อความสีครีมที่เขียนคำว่า LINE อยู่ตรงกลาง ด้านบนเป็นวงกลมลูกศรสีเขียวล้อมตัวเลข 24h และมีผู้หญิงผมดำรวบตึง สวมชุดราตรีซาตินสีเขียวเข้มเปิดไหล่ ใส่สร้อยคอสีทอง ยืนอยู่ทางขวาของภาพ"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600]}
        sizes="(max-width: 768px) 100vw, 400px"
        class="mx-auto h-auto w-full max-w-[400px] object-contain"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={60}
      />
      {
        BRAND_ADDRESS.lines.length > 0 && (
          <address aria-label={BRAND_ADDRESS.label} class="mt-8 mb-8 rounded-r-xl border-l-4 border-[#fcaa04] bg-[#123a1a] py-4 pr-4 pl-6 text-left text-base leading-relaxed text-[#b5cbb0] not-italic">
            <span class="mb-1 block font-bold text-white">{BRAND_ADDRESS.label}</span>
            {BRAND_ADDRESS.lines.map((line) => (
              <span class="block">{line}</span>
            ))}
            {BRAND_ADDRESS.email && (
              <span class="mt-3 block">
                <span aria-hidden="true" class="mr-2">
                  ✉️
                </span>
                <a href={`mailto:${BRAND_ADDRESS.email}`} class="font-bold text-[#ffd24d] underline decoration-[#ffd24d]/50 underline-offset-4 transition-colors hover:text-[#ffe9a8]">
                  {BRAND_ADDRESS.email}
                </a>
              </span>
            )}
          </address>
        )
      }

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/register/"
          aria-label="สมัครสมาชิก OHO555"
          style="background-image: linear-gradient(in oklab to bottom, #ff4b4b, #d81e1e 55%, #9e0c12);"
          class="flex items-center justify-center rounded-xl border-2 border-[#ffd24d] bg-[#d81e1e] px-8 py-3 font-black text-white shadow-[0_8px_22px_rgba(216,30,30,0.40)] transition-all hover:scale-105 hover:brightness-110 hover:shadow-[0_15px_40px_rgba(216,30,30,0.50)]">
          สมัครสมาชิก
        </a>

        <a
          href="/login/"
          aria-label="เข้าสู่ระบบ OHO555"
          style="background-image: linear-gradient(in oklab to bottom, #ffe08a, #fcaa04 55%, #c77d00);"
          class="flex items-center justify-center rounded-xl border-2 border-[#ffe9a8] bg-[#fcaa04] px-8 py-3 font-black text-[#1a1000] shadow-[0_8px_22px_rgba(252,170,4,0.35)] transition-all hover:scale-105 hover:brightness-110 hover:shadow-[0_15px_40px_rgba(252,170,4,0.45)]">
          เข้าสู่ระบบ
        </a>

        <a
          href="/line/"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="ติดต่อทีมงาน OHO555 ผ่าน Line Official"
          class="flex items-center justify-center rounded-xl border border-[#00B900]/70 bg-[#00B900] px-8 py-3 font-bold text-white shadow-[0_8px_24px_rgba(0,185,0,0.25)] transition-transform hover:scale-105 hover:bg-[#00a300]">
          ติดต่อผ่าน Line Official
        </a>
      </div>
    </div>
  </ContentBox>
  <Navfoot />
</MainLayout>
