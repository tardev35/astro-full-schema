---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";
---

<section class="relative z-10 my-6 flex w-full justify-center px-4 font-sans">
  <div
    class="w-full max-w-[1400px] rounded-[25px] border border-[#ed0133]/45 bg-[#2a0509] p-8 text-left text-base leading-relaxed text-[#f9dfe3] shadow-[10px_10px_20px_#000000,-10px_-10px_20px_#4a0611]">
    {
      title && (
        <header class="mb-8 border-b border-[#ed0133]/30 pb-4 text-center">
          <HeadingTag class={`bg-gradient-to-r from-[#ffdb7d] via-[#f0b429] to-[#a8710c] bg-clip-text ${headingSize} leading-normal font-black tracking-wide text-transparent`}>{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
