---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";
import { pageGraph } from "../lib/schema";

const pageTitle = "วิธีฝากถอน 77RUAY ฝากถอนออโต้ ไม่ต้องแนบสลิป ทำรายการได้ตลอด 24 ชั่วโมง";

const pageHeading = "วิธีฝากถอน 77RUAY ระบบออโต้ปรับเครดิตให้เอง จบบนมือถือเครื่องเดียว";

const pageDescription =
  "วิธีฝากถอน 77RUAY ผ่านระบบออโต้ที่ปรับเครดิตให้เองโดยไม่ต้องแนบสลิป ทำรายการได้ตลอด 24 ชั่วโมงบนมือถือเครื่องเดียว และสิ่งที่ต้องทำเมื่อฝากแล้วเครดิตไม่ขึ้น";

const announcementMessage =
  "77RUAY สล็อตออนไลน์ เล่นผ่านเบราว์เซอร์ได้ทั้ง iOS และ Android ไม่ต้องโหลดแอป • ฝากถอนออโต้ตลอด 24 ชั่วโมง ไม่ต้องแนบสลิป • สมัคร ฝาก เล่น และถอนจบบนมือถือเครื่องเดียว • มีเรื่องติดขัดติดต่อแอดมินผ่านช่องทางบนหน้าเว็บ";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "วิธีฝากถอน", path: "/วิธีฝากถอน" },
  ],
});

const linkClass = "font-bold text-[#1a5fe0] underline underline-offset-4 transition-colors hover:text-[#8a6508]";
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement message={announcementMessage} />

  <ContentBox as="h1" title={pageHeading}>
    <p class="mb-4 text-left text-base leading-relaxed">
      ที่ <strong class="font-bold text-[#8a6508]">77RUAY</strong> ฝากและถอนทำผ่านหน้าเว็บด้วยระบบออโต้ ระบบปรับยอดเครดิตให้เอง คุณไม่ต้องแคปหน้าจอส่งสลิปให้พนักงานตรวจ และไม่ต้องนั่งรอแอดมินตอบรับก่อนเล่นต่อ
    </p>

    <p class="text-left text-base leading-relaxed">
      ทุกขั้นตอนตั้งแต่สมัคร ฝากเครดิต เลือกค่ายเข้าปั่น ไปจนถึงกดถอน จบบนมือถือเครื่องเดียวผ่านเบราว์เซอร์ ทั้ง iOS และ Android โดยไม่ต้องโหลดแอปหรือเปิดคอมเพิ่ม
    </p>
  </ContentBox>

  <ContentBox as="h2" title="สมัครยูสใหม่หรือเข้าสู่ระบบด้วยยูสเดิมก่อนทำรายการ">
    <p class="mb-4 text-left text-base leading-relaxed">
      ผู้เล่นใหม่กด<a href="/register/" class={linkClass}>สมัครสมาชิก</a> แล้วกรอกข้อมูลตามที่ระบบแสดง ตรวจความถูกต้องอีกรอบก่อนยืนยัน ส่วนสมาชิกเดิมไปที่<a href="/ทางเข้า/" class={linkClass}>ทางเข้า 77RUAY</a> แล้วล็อกอินด้วยยูสและรหัสเดิมได้เลย ไม่ต้องสมัครซ้ำ
    </p>

    <p class="text-left text-base leading-relaxed">
      ก่อนกรอกรหัสทุกครั้ง ตรวจชื่อเว็บบนแถบที่อยู่ให้ตรงก่อน รหัสผ่านกับ OTP เก็บไว้เป็นความลับ ไม่ส่งให้ใครทางแชต แม้คนนั้นจะอ้างว่าเป็นทีมงานก็ตาม
    </p>
  </ContentBox>

  <ContentBox as="h2" title="ฝากเงินผ่านระบบออโต้ ระบบปรับเครดิตให้เองโดยไม่ต้องแนบสลิป">
    <p class="mb-4 text-left text-base leading-relaxed">
      <a href="/login/" class={linkClass}>เข้าสู่ระบบ</a>แล้วเลือกเมนูฝาก ทำตามขั้นตอนที่หน้าเว็บแสดง โอนเสร็จแล้วสลับกลับมาที่หน้าเว็บบนเครื่องเดิม ระบบจะปรับยอดเครดิตในยูสให้เองโดยไม่ต้องแนบสลิปยืนยัน
    </p>

    <p class="text-left text-base leading-relaxed">
      จะเติมเครดิตตอนดึกหรือช่วงเช้าตรู่ก็ทำรายการเองได้ ไม่ต้องส่งหลักฐานทางแชตแล้วรอคิวพนักงาน ไม่มีสลิปให้ส่ง ก็ไม่มีคิวให้รอ
    </p>
  </ContentBox>

  <ContentBox as="h2" title="ถอนเงินจากมือถือเครื่องเดียวกับที่เล่น ทำรายการได้ตลอด 24 ชั่วโมง">
    <p class="mb-4 text-left text-base leading-relaxed">
      ขาถอนอยู่บนหน้าเว็บเดียวกับขาฝาก เลือกเมนูถอน ใส่ยอดที่ต้องการแล้วกดยืนยัน ทำจากมือถือเครื่องที่ใช้เล่นอยู่ได้เลย ไม่ต้องเปิดคอมเพื่อถอนแยกอีกเครื่อง
    </p>

    <p class="text-left text-base leading-relaxed">
      ระบบออโต้เปิดรับรายการตลอด 24 ชั่วโมง กดถอนยอดช่วงเช้าตรู่หรือหลังเที่ยงคืนก็ทำผ่านหน้าเว็บได้เหมือนกัน เรื่องเงินอยู่บนเครื่องเดียวกับที่เล่น จึงไม่ต้องสลับอุปกรณ์ไปมา
    </p>
  </ContentBox>

  <ContentBox as="h2" title="ฝากแล้วเครดิตไม่ขึ้นหรือรายการค้าง อย่าโอนซ้ำ แจ้งเวลาและยอดเงินกับแอดมิน">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed">
        ถ้าฝากแล้วเครดิตไม่ขึ้น ล็อกอินไม่ได้ หรือมีรายการค้าง อย่าโอนเงินซ้ำเด็ดขาด รวบรวมช่วงเวลาที่ทำรายการกับยอดเงินไว้ แล้วแจ้งผ่านช่องทางบนหน้าเว็บหรือหน้า<a href="/contact-us/" class={linkClass}>ติดต่อเรา</a>
      </p>

      <p class="text-left text-base leading-relaxed">
        ข้อมูลสองอย่างนี้ช่วยให้แอดมินตรวจสอบและแก้ไขรายการของคุณได้ตรงจุด โอนซ้ำเพราะใจร้อนหนึ่งครั้ง อาจต้องตามเงินสองก้อนแทนที่จะตามแค่ก้อนเดียว
      </p>

      <div class="flex flex-col items-center justify-center gap-4 pt-4 sm:flex-row">
        <a
          href="/login/"
          aria-label="เข้าสู่ระบบ 77RUAY เพื่อฝากถอน"
          class="inline-flex w-full max-w-[320px] items-center justify-center gap-2 rounded-xl border-2 border-[#b07d12] bg-gradient-to-b from-[#ffd45c] via-[#e0a91b] to-[#b07d12] px-8 py-3.5 text-lg font-black tracking-wide text-[#0a1f5c] shadow-[0_10px_30px_rgba(224,169,27,0.30)] transition duration-300 hover:scale-105 hover:brightness-110">
          <span aria-hidden="true">💳</span> เข้าสู่ระบบเพื่อฝากถอน
        </a>

        <a
          href="/register/"
          aria-label="สมัครสมาชิก 77RUAY"
          class="inline-flex w-full max-w-[320px] items-center justify-center gap-2 rounded-xl border-2 border-[#ffd45c] bg-gradient-to-b from-[#4d8ff5] via-[#1a5fe0] to-[#0b3a9e] px-8 py-3.5 text-lg font-bold tracking-wide text-white shadow-[0_10px_30px_rgba(26,95,224,0.35)] transition duration-300 hover:scale-105 hover:brightness-110">
          <span aria-hidden="true">💎</span> สมัครสมาชิก 77RUAY
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
