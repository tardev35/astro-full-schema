---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementCyber.astro";
import { pageGraph } from "../lib/schema";

const pageTitle = "เกี่ยวกับเรา AMBHENG88 สล็อตทรูมันนี่วอลเล็ท ระบบออโต้ ไม่มีขั้นต่ำ";

const pageHeading = "เกี่ยวกับเรา AMBHENG88 เว็บสล็อตทรูมันนี่วอลเล็ทที่จบได้ในยูสเดียว";

const pageDescription =
  "รู้จัก AMBHENG88 เว็บสล็อตทรูมันนี่วอลเล็ทที่รวมการเติม ฝาก ถอน และเข้าเล่นไว้ในยูสเดียว ด้วยระบบออโต้ที่ไม่มีขั้นต่ำ และการจ่ายเต็มโดยไม่หักค่าธรรมเนียม";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox as="h1" title={pageHeading}>
    <p class="mb-4 text-left text-base leading-relaxed">
      <strong class="text-[#ff74b6]">AMBHENG88</strong> คือเว็บสล็อตที่ผูกการเติมยอดผ่านทรูมันนี่วอลเล็ทเข้ากับการเข้าเล่นไว้ในระบบเดียว สมาชิกเติมยอด เลือกเกม และตรวจสอบรายการของตัวเองได้จากยูสเดิม
    </p>

    <p class="mb-4 text-left text-base leading-relaxed">
      สิ่งที่เราให้เวลากับมันคือขั้นตอนที่สั้นลง ไม่ใช่ฟีเจอร์ที่เยอะขึ้น ทุกอย่างถูกวางให้จบได้จากมือถือเครื่องเดียวตั้งแต่รายการแรกของวัน
    </p>

    <p class="text-left text-base leading-relaxed">หน้านี้เล่าว่าเว็บทำงานอย่างไร ไม่ได้เขียนไว้ขายของ</p>
  </ContentBox>

  <ContentBox as="h2" title="สล็อตทรูมันนี่วอลเล็ท เติมจากบัญชีเดิม แล้วเล่นต่อในยูสเดียว">
    <p class="mb-4 text-left text-base leading-relaxed">
      คนที่ใช้ทรูมันนี่วอลเล็ทเติมยอดเข้ายูส AMBHENG88 ได้จากบัญชีเดิม ไม่ต้องเปิดยูสใหม่ทุกครั้งที่อยากเปลี่ยนเกม เมื่อยอดอัปเดตแล้วก็เลือกเกมจากเมนูในเว็บต่อได้ทันที
    </p>

    <p class="mb-4 text-left text-base leading-relaxed">
      รูปแบบนี้ทำมาเพื่อคนที่จัดการทุกอย่างจากมือถือ ทั้งการเติมเงินและการเข้าเล่นอยู่บนเครื่องเดียวกัน ไม่ต้องสลับช่องทางไปมาระหว่างรอบ
    </p>

    <p class="text-left text-base leading-relaxed">ก่อนทำรายการทุกครั้ง ตรวจหมายเลขบัญชี ยอดเงิน และช่องทางที่ระบบกำหนดให้ตรงก่อน รายการจะได้ไม่ค้าง</p>
  </ContentBox>

  <ContentBox as="h2" title="ระบบออโต้ที่ไม่ต้องรอแอดมินไล่ตรวจทีละยอด">
    <p class="mb-4 text-left text-base leading-relaxed">
      การเติม ฝาก และถอนของเราใช้การประมวลผลแบบอัตโนมัติ ระบบตรวจรายการและอัปเดตยอดในบัญชีสมาชิกเอง ส่งคำขอแล้วติดตามสถานะได้จากหน้าสมาชิกของตัวเอง
    </p>

    <p class="mb-4 text-left text-base leading-relaxed">
      อัตโนมัติไม่ได้แปลว่าไม่มีคน ทีมงานยังอยู่ตามปกติสำหรับรายการที่ต้องถาม ต่างกันแค่ว่าไม่ต้องรอคิวเพื่อให้ยอดเข้าบัญชี
    </p>

    <p class="text-left text-base leading-relaxed">รายการตอนตีสามกับตอนบ่ายสองจึงใช้เวลาไม่ต่างกัน</p>
  </ContentBox>

  <ContentBox as="h2" title="เงื่อนไขไม่มีขั้นต่ำ กับการจ่ายเต็มที่ไม่หักค่าธรรมเนียม">
    <p class="mb-4 text-left text-base leading-relaxed">
      เงื่อนไขไม่มีขั้นต่ำถูกเขียนไว้ว่าครอบคลุมรายการใดบ้าง ทั้งการเติมครั้งแรก ฝาก ถอน และการเข้าเล่น สมาชิกอ่านขอบเขตได้จากคู่มือและข้อกำหนดก่อนทำรายการ
    </p>

    <p class="mb-4 text-left text-base leading-relaxed">
      ฝั่งการจ่าย ยอดที่ชนะจะถูกโอนเต็มจำนวนโดยไม่มีการหักค่าธรรมเนียมระหว่างทาง และไม่มีเพดานวงเงินถอนต่อวันมาจำกัดไว้
    </p>

    <p class="mb-4 text-left text-base leading-relaxed">
      แต่ละช่องทางและแต่ละโปรโมชั่นมีเงื่อนไขของตัวเอง จุดนี้ต่างกันจริง จึงควรอ่านของรายการที่จะใช้ทุกครั้ง
    </p>

    <p class="text-left text-base leading-relaxed">ตัวเลขที่ประกาศไว้กับตัวเลขที่เข้าบัญชี ควรเป็นจำนวนเดียวกัน</p>
  </ContentBox>

  <ContentBox as="h2" title="ความเสถียรของระบบ และการดูแลบัญชีสมาชิก">
    <p class="mb-4 text-left text-base leading-relaxed">
      เรื่องที่เราลงแรงมากที่สุดคืออาการโหลดช้า หน้าเว็บค้าง และหลุดตอนเปลี่ยนเมนู ทั้งการเช็กยอดและการเข้าเกมถูกวางให้ทำงานต่อเนื่องตลอด 24 ชั่วโมง
    </p>

    <p class="mb-4 text-left text-base leading-relaxed">
      ประสิทธิภาพจริงยังขึ้นอยู่กับอุปกรณ์ เบราว์เซอร์ และเครือข่ายของผู้ใช้ด้วย ถ้าเจอปัญหา ลองรีเฟรชหน้า ตรวจอินเทอร์เน็ต หรือเข้าสู่ระบบใหม่ จะแยกสาเหตุได้เร็วขึ้น
    </p>

    <p class="mb-4 text-left text-base leading-relaxed">
      ฝั่งบัญชี การสมัครขอเฉพาะข้อมูลที่จำเป็นต่อการยืนยันตัวตน และควรตั้งรหัสผ่านที่คาดเดายาก ไม่ใช้ซ้ำกับบัญชีสำคัญอื่นของคุณ
    </p>

    <p class="text-left text-base leading-relaxed">หลังบ้านที่นิ่งไม่ได้ทำให้เล่นเก่งขึ้น แต่ทำให้ไม่ต้องคอยระแวงมัน</p>
  </ContentBox>

  <Navfoot />
</MainLayout>
