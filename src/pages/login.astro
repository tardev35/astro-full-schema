---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementCyber.astro";
import CtaRedirect from "../components/CtaRedirect.astro";
import { pageGraph } from "../lib/schema";

const pageTitle = "เข้าสู่ระบบ VODKAFUN | ปุ่มล็อกอินเข้าหน้าสมาชิก สล็อตเว็บตรงเว็บใหญ่";

const pageDescription =
  "หากคุณกำลังมองหาทางกลับเข้าหน้าสมาชิกโดยไม่ต้องค้นหาลิงก์ VODKAFUN พร้อมมอบปุ่มเข้าสู่ระบบเพียงปุ่มเดียว เพื่อกลับไปเล่นสล็อตเว็บตรงเว็บใหญ่ต่อด้วยยูสเดิมทันที";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เข้าสู่ระบบ", path: "/login" },
  ],
});

const targetUrl = "https://yoalink.com/mojo";
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="เข้าสู่ระบบ VODKAFUN" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label="เข้าสู่ระบบ VODKAFUN"
        class="group relative mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#0aa4c4]/70 bg-gradient-to-b from-[#9bf2fb] via-[#1be5f4] to-[#0aa4c4] px-6 py-4 text-xl font-bold tracking-wide text-[#14042e] shadow-[0_10px_30px_rgba(27,229,244,0.26)] transition-all duration-300 hover:scale-105 hover:border-[#9bf2fb] hover:shadow-[0_15px_40px_rgba(27,229,244,0.38)]">
        เข้าสู่ระบบ VODKAFUN
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="เข้าสู่ระบบ" />
</MainLayout>
