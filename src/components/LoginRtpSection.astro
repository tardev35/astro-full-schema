---
import ContentBoxTwo from "./ContentBoxTwo.astro";

const steps = [
  { icon: "📝", name: "สมัครยูสจากเครื่องที่ถนัด", detail: "กรอกข้อมูลไม่กี่ช่องแล้วจบในเครื่องเดียว จะเริ่มจากมือถือ แท็บเล็ต หรือคอมก็ได้", tag: "ขั้นที่ 1" },
  { icon: "👛", name: "เติมด้วยบัญชีธนาคารหรือวอเลท", detail: "ผูกบัญชีธนาคารก็ได้ ใช้ทรูมันนี่วอเลทก็ได้ ฝากได้ตั้งแต่ 1 บาท ไม่มียอดขั้นต่ำ", tag: "ขั้นที่ 2" },
  { icon: "⏱️", name: "ระบบออโต้ตัดยอดเองใน 3 วินาที", detail: "ยอดเข้าทันทีโดยไม่ต้องส่งสลิปให้ใครตรวจ ถอนก็ใช้เส้นทางเดียวกันและไม่ดองบิล", tag: "ขั้นที่ 3" },
  { icon: "🎰", name: "เลือกเกมจากค่ายที่เชื่อม API แท้", detail: "PG Soft, Pragmatic Play, JILI และ Joker Gaming อยู่หลังยูสเดียวกัน สลับค่ายแล้วเข้าเกมต่อได้เลย", tag: "ขั้นที่ 4" },
  { icon: "💬", name: "ติดขัดตรงไหนทักทีมงานได้ 24 ชม.", detail: "ทีมงานช่วยดูตั้งแต่ยอดไม่ปรับไปจนถึงบัคเกม และส่งเรื่องเข้าระบบของค่ายให้โดยตรง", tag: "ขั้นที่ 5" },
];

const chips = ["API แท้", "ออโต้ 3 วินาที", "รองรับวอเลท", "ไม่มีขั้นต่ำ", "ไม่ล็อกยูส", "PG Soft", "Pragmatic Play", "JILI"];
---

<ContentBoxTwo titleleft="เข้าสู่ระบบ PIGAUTO" titleright="ลำดับการใช้งานตั้งแต่สมัครถึงถอนยอด" label="เข้าสู่ระบบ PIGAUTO และลำดับการใช้งานตั้งแต่สมัครถึงถอนยอด">
  <div slot="left" class="flex h-full flex-col gap-4">
    <div class="relative overflow-hidden rounded-2xl border border-[#b07d12]/55 bg-[#3a0808] p-6 shadow-[0_10px_30px_rgba(245,197,66,0.16)]">
      <div aria-hidden="true" class="pointer-events-none absolute -top-10 -right-10 h-32 w-32 rounded-full bg-[#f5c542]/14 blur-[50px]"></div>

      <div class="relative z-10 mb-5 flex items-center gap-3">
        <span
          aria-hidden="true"
          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#ffe08a]/55 bg-gradient-to-br from-[#ffe08a] via-[#f5c542] to-[#b07d12] text-xl shadow-inner">
          🐷
        </span>
        <div class="flex flex-col">
          <p class="text-base font-black text-[#ffe08a]">ล็อกอินแล้วเลือกค่ายที่อยากเล่นต่อได้ทันที</p>
          <span class="text-[11px] text-[#d7b9a4]">
            ยูสเดียวเข้าได้ทุกค่ายที่เชื่อม API แท้ ทั้ง PG Soft, Pragmatic Play, JILI และ Joker Gaming ยอดฝากถอนเดินผ่านระบบออโต้ชุดเดียวกัน เช็กเครดิต ดูโปรโมชั่น และย้อนดูประวัติได้จากหน้าเมมเบอร์
          </span>
        </div>
      </div>

      <div class="relative z-10 flex flex-col gap-3.5">
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#f5c542]">👤</span>
          <input
            type="text"
            placeholder="เบอร์โทรศัพท์ / ยูสเซอร์เนม"
            class="w-full rounded-xl border border-[#b07d12]/60 bg-[#1f0303] py-3 pr-4 pl-12 text-[#f7e4d4] transition-all outline-none placeholder:text-[#d7b9a4] focus:border-[#f5c542] focus:ring-1 focus:ring-[#f5c542]/40"
          />
        </div>
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#f5c542]">🔑</span>
          <input
            type="password"
            placeholder="รหัส PIN 4 หลัก"
            class="w-full rounded-xl border border-[#b07d12]/60 bg-[#1f0303] py-3 pr-4 pl-12 text-[#f7e4d4] transition-all outline-none placeholder:text-[#d7b9a4] focus:border-[#f5c542] focus:ring-1 focus:ring-[#f5c542]/40"
          />
        </div>

        <div class="flex items-center justify-between px-1 text-xs">
          <label class="flex items-center gap-2 text-[#d7b9a4]">
            <input type="checkbox" class="h-3.5 w-3.5 rounded border-[#b07d12]/60 bg-[#1f0303] accent-[#f5c542]" />
            จดจำฉันไว้
          </label>
          <a href="/login" class="text-[#d7b9a4] transition-colors hover:text-[#ffe08a]">ลืมรหัส PIN?</a>
        </div>

        <button
          class="mt-1 w-full rounded-xl border border-[#ffe08a]/50 bg-gradient-to-r from-[#ffe08a] via-[#f5c542] to-[#d99e1f] p-3.5 font-black text-[#1f0303] shadow-[0_10px_30px_rgba(245,197,66,0.28)] transition-all hover:scale-[1.02] hover:shadow-[0_15px_40px_rgba(245,197,66,0.38)]">
          เข้าสู่ระบบ
        </button>

        <div class="flex items-center gap-3 py-1 text-[11px] text-[#d7b9a4]">
          <span class="h-px flex-1 bg-[#b07d12]/55"></span>
          หรือ
          <span class="h-px flex-1 bg-[#b07d12]/55"></span>
        </div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] p-3 text-sm font-bold text-white shadow-md transition-all hover:scale-[1.02]">
          <span aria-hidden="true">💬</span> ทักไลน์ทีมงานตลอด 24 ชั่วโมง
        </a>

        <div class="mt-1 flex items-center justify-between px-1">
          <div class="flex gap-2">
            <span class="rounded-full border border-[#b07d12]/60 bg-[#2a0505] px-2.5 py-1 text-[10px] font-bold text-[#ffe08a]"><span aria-hidden="true">🔒</span> เข้ารหัสข้อมูล</span>
            <span class="rounded-full border border-[#d92121]/55 bg-[#340707] px-2.5 py-1 text-[10px] font-bold text-[#f9a8c0]"><span aria-hidden="true">🕐</span> ใช้งานได้ตลอด 24 ชม.</span>
          </div>
          <a href="/register" class="text-xs font-bold text-[#d7b9a4] transition-colors hover:text-[#ffe08a]">สมัครสมาชิกใหม่</a>
        </div>
      </div>
    </div>
  </div>

  <div slot="right" class="h-full">
    <div class="flex h-full flex-col rounded-2xl border border-[#b07d12]/55 bg-[#3a0808] p-5 shadow-[0_10px_30px_rgba(245,197,66,0.16)]">
      <div class="mb-5 flex items-center justify-between gap-3">
        <div>
          <span class="text-xs font-bold tracking-wide text-[#d7b9a4]">ลำดับการใช้งานที่ PIGAUTO วางไว้ ตั้งแต่สมัครยูสจนถอนยอดออก อยู่ในระบบออโต้ชุดเดียวกันทั้งหมด</span>
          <div class="bg-gradient-to-r from-[#ffe08a] via-[#f5c542] to-[#d99e1f] bg-clip-text text-2xl font-black text-transparent sm:text-3xl">สมัคร • ฝาก • เล่น • ถอน</div>
        </div>
        <span class="flex items-center gap-1.5 self-start rounded-full border border-[#d92121]/55 bg-[#340707] px-2.5 py-1">
          <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#d92121] shadow-[0_0_8px_rgba(217,33,33,0.7)]"></span>
          <span class="text-[10px] font-bold tracking-widest text-[#f9a8c0] uppercase">Live</span>
        </span>
      </div>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#d7b9a4] uppercase">
        <span>ขั้นตอนการใช้งาน</span>
        <span>ลำดับ</span>
      </div>

      <div class="flex flex-1 flex-col gap-2.5">
        {
          steps.map((s) => (
            <div class="rounded-xl border border-[#b07d12]/45 bg-[#2a0505] px-3.5 py-2.5 transition-colors hover:border-[#f5c542]/65 hover:bg-[#451010]">
              <div class="flex items-center justify-between gap-2 text-sm">
                <span class="flex min-w-0 items-center gap-2 font-bold text-[#f7e4d4]">
                  <span aria-hidden="true" class="w-5 shrink-0 text-center">
                    {s.icon}
                  </span>{" "}
                  <span class="truncate">{s.name}</span>
                </span>
                <span class="shrink-0 rounded-full border border-[#d92121]/55 bg-[#340707] px-2.5 py-0.5 text-[10px] font-bold text-[#f9a8c0]">{s.tag}</span>
              </div>
              <div class="mt-1.5 text-[11px] tracking-wide text-[#d7b9a4]">{s.detail}</div>
            </div>
          ))
        }
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
        {chips.map((c) => <span class="rounded-full border border-[#b07d12]/45 bg-[#2a0505] px-3 py-1 text-[10px] font-bold text-[#ffe08a]">{c}</span>)}
      </div>

      <div class="mt-3 text-center text-[10px] tracking-wide text-[#d7b9a4]">
        ลำดับในตารางสรุปจากที่หน้าเว็บแสดงไว้ รายละเอียดของค่ายเกม เงื่อนไขเครดิต และโปรโมชั่นที่เปิดอยู่จริงให้ยึดตามหน้าเมมเบอร์ของ PIGAUTO ก่อนทำรายการทุกครั้ง และอย่าบอกรหัสผ่านหรือ OTP กับใคร
        หากติดขัดตรงไหนทักไลน์ทีมงานได้ตลอด 24 ชั่วโมง
      </div>
    </div>
  </div>
</ContentBoxTwo>
