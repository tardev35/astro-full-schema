---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementCyber.astro";

import { Picture } from "astro:assets";
import imgLine from "../assets/contact-line.webp";
import { pageGraph } from "../lib/schema";
import { BRAND_ADDRESS } from "../lib/brandProfile";

const pageTitle = "ติดต่อทีมงาน AMBHENG88 | แชท LINE Official ตลอด 24 ชั่วโมง";

const pageDescription =
  "ช่องทางติดต่อทีมงาน AMBHENG88 ทักผ่าน LINE Official ได้ตลอด 24 ชั่วโมง พร้อมที่อยู่ติดต่อและอีเมลของทีมงาน สอบถามการสมัคร เติมฝากถอนออโต้ และการใช้งานระบบ";

const graph = pageGraph(Astro, {
  type: "ContactPage",
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ติดต่อเรา", path: "/contact-us" },
  ],
  org: {
    alternateName: "AMBHENG88 สล็อตทรูมันนี่วอลเล็ท ระบบล่าสุด เติม ฝาก ถอนออโต้ ไม่มีขั้นต่ำ แตกล้านจ่ายเต็ม",
    contactPoints: [
      {
        contactType: "customer service",
        availableLanguage: ["Thai", "English"],
        path: "/line",
        description: "ติดต่อทีมงาน AMBHENG88 ผ่าน LINE Official สอบถามการสมัคร การเติมฝากถอนออโต้ และการใช้งานระบบ",
      },
    ],
  },
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="ติดต่อทีมงาน AMBHENG88" as="h1">
    <Picture
      src={imgLine}
      alt="ไอคอนแอป LINE สีเขียวทรงสี่เหลี่ยมมุมมน มีกรอบข้อความสีครีมที่เขียนคำว่า LINE อยู่ตรงกลาง ด้านหลังเป็นวงกลมลูกศรสีเขียวล้อมตัวเลข 24h และมีผู้หญิงผมดำรวบตึง สวมชุดราตรีซาตินสีเขียวเข้มเปิดไหล่ ใส่สร้อยคอมุก ยืนอยู่ทางขวาของภาพ"
      loading="lazy"
      fetchpriority="low"
      widths={[200, 400, 600]}
      sizes="(max-width: 768px) 100vw, 400px"
      class="mx-auto h-auto w-full max-w-[400px] object-contain"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={60}
    />
    {
      BRAND_ADDRESS.lines.length > 0 && (
        <address aria-label={BRAND_ADDRESS.label} class="mt-8 mb-8 rounded-r-xl border-l-4 border-[#ff2d8e] bg-[#280a1c] py-4 pl-6 text-left text-base leading-relaxed not-italic">
          <span class="mb-1 block font-bold text-[#ff74b6]">{BRAND_ADDRESS.label}</span>
          {BRAND_ADDRESS.lines.map((line) => (
            <span class="block">{line}</span>
          ))}
          {BRAND_ADDRESS.email && (
            <span class="mt-3 block">
              <span aria-hidden="true" class="mr-2">
                ✉️
              </span>
              <a href={`mailto:${BRAND_ADDRESS.email}`} class="font-bold text-[#ff74b6] underline decoration-[#ff2d8e] underline-offset-4 transition-colors hover:text-[#ff2d8e]">
                {BRAND_ADDRESS.email}
              </a>
            </span>
          )}
        </address>
      )
    }

    <div class="flex flex-wrap justify-center gap-4">
      <a
        href="/register"
        aria-label="สมัครสมาชิก AMBHENG88"
        class="flex items-center justify-center rounded-lg border border-[#c9a800] bg-gradient-to-r from-[#fff27a] via-[#ffe814] to-[#c9a800] px-8 py-3 font-bold text-[#170512] shadow-[0_10px_30px_rgba(255,232,20,0.24)] transition-transform hover:scale-105 hover:shadow-[0_15px_40px_rgba(255,232,20,0.34)]">
        สมัครสมาชิก
      </a>

      <a
        href="/login"
        aria-label="เข้าสู่ระบบ AMBHENG88"
        class="flex items-center justify-center rounded-lg border border-[#ff2d8e]/55 bg-[#280a1c] px-8 py-3 font-extrabold text-[#ff74b6] shadow-[0_4px_14px_rgba(255,45,142,0.22)] transition-transform hover:scale-105 hover:bg-[#4a1030]">
        เข้าสู่ระบบ
      </a>

      <a
        href="/line"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="ติดต่อทีมงาน AMBHENG88 ผ่าน Line Official"
        class="flex items-center justify-center rounded-lg border border-green-300 bg-gradient-to-b from-green-400 to-green-700 px-8 py-3 font-bold text-white transition-transform hover:scale-105">
        ติดต่อผ่าน Line Official
      </a>
    </div>
  </ContentBox>
  <Navfoot />
</MainLayout>
