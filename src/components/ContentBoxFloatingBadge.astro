---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-xl sm:text-2xl md:text-3xl" : "text-lg sm:text-xl md:text-2xl";
---

<section class="my-12 flex w-full justify-center px-4 font-sans">
  <div
    class="relative isolate w-full max-w-[1400px] rounded-2xl border-2 border-[#2a6b2c] bg-[#0c2a12] p-8 pt-32 text-left text-base leading-relaxed text-[#e3eedf] shadow-[0_10px_30px_rgba(1,10,3,0.45)] sm:pt-24 md:pt-28">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 rounded-2xl bg-gradient-to-b from-[#123a1a] to-[#0c2a12]"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-10 -bottom-16 -z-10 h-40 w-40 rounded-full bg-[#2f9e1f]/20 blur-[60px]"></div>

    {
      title && (
        <div class="absolute -top-6 left-1/2 flex w-[92%] max-w-2xl -translate-x-1/2 items-center justify-center gap-2 rounded-xl border-2 border-[#ffe9a8] bg-gradient-to-b from-[#ffe08a] via-[#fcaa04] to-[#c77d00] px-4 py-2.5 text-center shadow-[0_10px_26px_rgba(252,170,4,0.35)] sm:px-8">
          <span aria-hidden="true" class="shrink-0 text-[#1a1000]">
            ✦
          </span>
          <HeadingTag class={`min-w-0 ${headingSize} leading-normal font-black tracking-tight text-[#1a1000]`}>{title}</HeadingTag>
          <span aria-hidden="true" class="shrink-0 text-[#1a1000]">
            ✦
          </span>
        </div>
      )
    }

    <slot />
  </div>
</section>
