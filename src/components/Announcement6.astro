---
const { message = "🔥 SUMOHENG เว็บไซต์ทางการ สล็อตเว็บตรงค่ายใหญ่ มั่นคง ปลอดภัย 100% ระบบออโต้ ฝาก-ถอนรวดเร็ว รองรับทรูวอเลท!" } = Astro.props;
---

<div class="mx-auto max-w-[900px] p-2">
  <div class="relative flex h-[50px] items-center rounded-lg border-[2px] border-dashed border-yellow-500/60 bg-gradient-to-b from-[#3a2000] to-[#1a0f00] p-1 shadow-[0_5px_15px_rgba(0,0,0,0.6)]">
    <div class="relative flex h-full items-center justify-center rounded bg-gradient-to-b from-yellow-400 via-yellow-600 to-yellow-700 px-4 shadow-[inset_0_1px_1px_rgba(255,255,255,0.6)]">
      <span class="text-xs font-black tracking-wider text-yellow-950 uppercase md:text-sm">🎫 JACKPOT</span>
    </div>

    <div class="flex-1 overflow-hidden px-4">
      <div class="flex w-max animate-[scroll_18s_linear_infinite] gap-10 text-sm font-bold whitespace-nowrap text-yellow-300/90">
        <span>{message}</span>
        <span>{message}</span>
        <span>{message}</span>
      </div>
    </div>
  </div>
</div>

<style>
  @keyframes scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(calc(-33.33% - 13.33px));
    }
  }
</style>
