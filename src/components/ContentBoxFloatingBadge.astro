---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-xl sm:text-2xl md:text-3xl" : "text-lg sm:text-xl md:text-2xl";
---

<section class="my-10 flex w-full justify-center px-4 font-sans">
  <div
    class="relative isolate w-full max-w-[1400px] rounded-2xl border-2 border-[#e0aa2e]/30 bg-gradient-to-b from-[#1c1309]/95 to-[#0a0704]/95 p-8 pt-36 text-left text-base leading-relaxed text-[#efe0c4] shadow-[0_10px_30px_rgba(224,170,46,0.18)] md:pt-32">
    <div aria-hidden="true" class="pointer-events-none absolute -top-16 -right-10 -z-10 h-40 w-40 rounded-full bg-[#e0aa2e]/25 blur-[60px]"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -bottom-16 -left-10 -z-10 h-40 w-40 rounded-full bg-[#6b4310]/60 blur-[60px]"></div>

    {
      title && (
        <div class="absolute -top-6 left-1/2 flex w-[92%] max-w-2xl -translate-x-1/2 items-center justify-center gap-2 rounded-lg border-2 border-[#e0aa2e]/40 bg-[#160f07] px-4 py-2.5 text-center shadow-[0_10px_30px_rgba(224,170,46,0.24)] sm:px-8">
          <span aria-hidden="true" class="shrink-0 text-[#d8cdb6]">
            ✦
          </span>
          <HeadingTag class={`min-w-0 bg-gradient-to-r from-[#f5d488] via-[#e0aa2e] to-[#d8cdb6] bg-clip-text ${headingSize} leading-normal font-black tracking-tight text-transparent uppercase`}>
            {title}
          </HeadingTag>
          <span aria-hidden="true" class="shrink-0 text-[#d8cdb6]">
            ✦
          </span>
        </div>
      )
    }

    <slot />
  </div>
</section>
