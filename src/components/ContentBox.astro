---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#f5c542]/45 bg-[#1c0a06]/92 p-8 text-left text-base leading-relaxed text-[#f3e3c6] shadow-[0_10px_30px_rgba(224,27,27,0.22)] backdrop-blur-xl transition-all duration-500 hover:border-[#f5c542]/70 hover:shadow-[0_15px_40px_rgba(245,197,66,0.26)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#e01b1b]/45 blur-[60px] transition-all duration-500 group-hover:bg-[#ff5a4d]/30"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#b8860b]/40 blur-[60px] transition-all duration-500 group-hover:bg-[#f5c542]/25"></div>

    {
      title && (
        <header class="mb-6 flex items-center gap-4 border-b border-[#f5c542]/45 pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffe9a8] to-[#e01b1b] shadow-[0_0_10px_rgba(245,197,66,0.5)]" />
          <HeadingTag class="bg-gradient-to-r from-[#ffe9a8] via-[#f5c542] to-[#ff5a4d] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
