---
const providers = [
  { name: "สล็อตค่ายยอดนิยม", desc: "เกมดังหาข้อมูลง่าย แต่ยังต้องดูเดิมพันขั้นต่ำและตัวคูณก่อนลงเครดิต", tag: "หาข้อมูลง่าย", icon: "🎰" },
  { name: "สล็อตความผันผวนต่ำ", desc: "รอบสั้น จ่ายถี่กว่า เหมาะกับงบจำกัดและการลองระบบครั้งแรก", tag: "เริ่มจากงบจริง", icon: "🍀" },
  { name: "สล็อตฟรีสปินและตัวคูณ", desc: "ฟีเจอร์โบนัสต่างกันทุกค่าย อ่านกติกาหน้าเกมก่อนขยับยอดต่อรอบ", tag: "อ่านกติกาก่อน", icon: "💎" },
  { name: "คาสิโนสดหลายโต๊ะ", desc: "บาคาร่า รูเล็ต และเกมโต๊ะ ต่างกันที่วงเงิน ความเร็วรอบ และเวลาปิดรับ", tag: "ดูขั้นต่ำของโต๊ะ", icon: "🎴" },
  { name: "หวยหลายประเภท", desc: "ตรวจประเภทเลข งวด และเวลาปิดรับให้ตรงก่อนกดยืนยันรายการ", tag: "เช็กงวดก่อน", icon: "🎟️" },
  { name: "กีฬาและบอลสด", desc: "ดูคู่แข่งขัน ตลาดเดิมพัน ราคา และเวลาเริ่มแข่งให้ครบก่อนส่งบิล", tag: "อ่านรายการซ้ำ", icon: "⚽" },
  { name: "บัญชีเดียวทุกหมวด", desc: "สลับหมวดได้โดยไม่ต้องย้ายเว็บ พร้อมประวัติรายการรวมไว้จุดเดียว", tag: "ไม่ต้องสมัครใหม่", icon: "👛" },
];
---

<section aria-label="สล็อตกว่า 40 ค่ายและหมวดเกมที่ YOK789 รวมไว้ในบัญชีเดียว" class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#5cff9b] via-[#12b84f] to-[#0a6b2f] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      สล็อตกว่า 40 ค่าย และหมวดเกมที่ <span class="text-[#ffd94a]">YOK789</span> รวมไว้ในบัญชีเดียว
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#12b84f] to-transparent"></div>
  </div>

  <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4 lg:gap-5 xl:grid-cols-7">
    {
      providers.map((provider) => (
        <a
          href="/register"
          class="group relative flex flex-col items-center justify-center overflow-hidden rounded-2xl border border-[#12b84f]/25 bg-[#08150d]/92 p-5 shadow-[0_10px_30px_rgba(18,184,79,0.18)] backdrop-blur-md transition-all duration-300 hover:-translate-y-2 hover:border-[#12b84f]/50 hover:bg-[#0e2216]/95 hover:shadow-[0_15px_40px_rgba(18,184,79,0.3)]">
          <div class="pointer-events-none absolute inset-0 bg-[#ffd94a]/10 opacity-0 transition-opacity duration-300 group-hover:opacity-100" />

          <div class="absolute top-2 right-2 z-10 rounded-full bg-gradient-to-r from-[#5cff9b] via-[#12b84f] to-[#0a6b2f] px-2 py-0.5 text-[9px] font-black tracking-wide whitespace-nowrap text-[#04140a] shadow-sm transition-transform duration-300 group-hover:scale-110">
            {provider.tag}
          </div>

          <div aria-hidden="true" class="mb-3 text-4xl transition-transform duration-300 group-hover:scale-125 group-hover:rotate-3">
            {provider.icon}
          </div>
          <p class="text-center text-sm font-black text-[#d5f0dd] transition-colors group-hover:text-[#5cff9b]">{provider.name}</p>
          <p class="mt-1 text-center text-[10px] text-[#9dbfa8]">{provider.desc}</p>

          <span class="relative z-10 mt-4 block w-full rounded-full border border-[#12b84f]/25 bg-[#050d07] py-1.5 text-center text-[11px] font-bold text-[#12b84f] shadow-inner transition-colors duration-300 group-hover:border-[#12b84f]/50 group-hover:bg-gradient-to-r group-hover:from-[#5cff9b] group-hover:via-[#12b84f] group-hover:to-[#0a6b2f] group-hover:text-[#04140a]">
            เข้าดูเกม
          </span>
        </a>
      ))
    }
  </div>
</section>
