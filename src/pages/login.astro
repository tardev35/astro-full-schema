---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import CtaRedirect from "../components/CtaRedirect.astro";
import { pageGraph } from "../lib/schema";

const pageDescription =
  "เข้าสู่ระบบ ANDAMAN168 หน้าล็อกอินเว็บหลัก กดปุ่มเดียวเข้าบัญชีเดิมเพื่อเล่นบาคาร่า สล็อต ฟุตบอล และคาสิโน ตรวจเครดิต รับโปรโมชั่น และดูประวัติฝากถอนออโต้";

const graph = pageGraph(Astro, {
  name: "เข้าสู่ระบบ ANDAMAN168 เว็บหลัก",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เข้าสู่ระบบ", path: "/login" },
  ],
});

const targetUrl = "https://yoalink.com/22hs";
---

<MainLayout title="เข้าสู่ระบบ ANDAMAN168 | ล็อกอินเว็บหลัก รองรับทุกอุปกรณ์" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="เข้าสู่ระบบ ANDAMAN168" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label="เข้าระบบเกม"
        class="group relative mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#21d4f2]/70 bg-[#0a3a68] px-6 py-4 text-xl font-bold tracking-wide text-[#ffe999] shadow-[0_10px_30px_rgba(33,212,242,0.35)] transition-all duration-300 hover:scale-105 hover:border-[#7fe6ff] hover:bg-[#04182f] hover:text-[#fdb524] hover:shadow-[0_15px_40px_rgba(127,230,255,0.42)]">
        เข้าระบบเกม
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="เข้าสู่ระบบ" />
</MainLayout>
