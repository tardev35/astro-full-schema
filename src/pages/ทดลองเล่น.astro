---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";

import { Picture } from "astro:assets";
import { itemList, pageGraph, schemaCtx } from "../lib/schema";
import image1 from "../assets/gamedemo7.webp";
import image2 from "../assets/gamedemo8.webp";
import image3 from "../assets/gamedemo9.webp";
import image4 from "../assets/gamedemo10.webp";
import image5 from "../assets/gamedemo11.webp";
import image6 from "../assets/gamedemo12.webp";
import image7 from "../assets/gamedemo13.webp";
import image8 from "../assets/gamedemo14.webp";
import image9 from "../assets/gamedemo15.webp";
import image10 from "../assets/gamedemo16.webp";
import image11 from "../assets/gamedemo17.webp";
import image12 from "../assets/gamedemo18.webp";

const demoGames = [
  { name: "AskmeSlot", src: image1, alt: "แบนเนอร์ค่าย askmeslot โลโก้โพดำสีทองที่มีสัญลักษณ์ไพ่อยู่ข้างใน คู่กับตัวการ์ตูนเด็กชายสวมหมวกแดงติดดาว กางแขนวิ่งบนถนนในเมืองยุโรปที่มีกังหันลม" },
  { name: "Popular Game", src: image2, alt: "แบนเนอร์ Popular Game ตัวอักษรทองนูนหน้าวงแหวนชิปคาสิโนสีทอง ขนาบด้วยกระต่ายถือหีบสมบัติกับแมวใส่แว่นกันแดด ท่ามกลางเหรียญทองและชิปที่ลอยฟุ้ง" },
  { name: "SlotXO", src: image3, alt: "แบนเนอร์ค่าย SLOTXO โลโก้ตู้สล็อตล้อมด้วยเหรียญทอง คู่กับนักรบโรมันผมขาวสวมมงกุฎใบลอเรลและเกราะทอง ยืนหน้าโคลอสเซียมกับทหารอีกสองนาย" },
  { name: "Skywind Group", src: image4, alt: "แบนเนอร์ค่าย Skywind Group โลโก้วงกลมสี่สีบนพื้นดำ คู่กับแมวกวักนำโชคสีขาวคาดกระพรวนทอง ยืนข้างไหทองและถุงเงินสีม่วงใต้ต้นซากุระ" },
  { name: "PG Soft", src: image5, alt: "แบนเนอร์ค่าย PG Pocket Games Soft โลโก้ตัวอักษรพิกเซลบนพื้นดำ คู่กับตัวละครหญิงนักรบผิวแทนสวมเครื่องประดับทองและหมวกขนนกสไตล์แอซเท็ก" },
  { name: "SBOBET", src: image6, alt: "แบนเนอร์ค่ายเกม SBOBET โลโก้ตัวอักษรขาวบนพื้นดำ คู่กับตัวการ์ตูนอนิเมะสาวหูจิ้งจอกผมบลอนด์ในชุดกิโมโนสีชมพู มือถืออมยิ้มเกลียวหลากสี" },
  { name: "Sexy Slot", src: image7, alt: "แบนเนอร์ค่าย Sexy Slot ตัวอักษรสีชมพูม่วงมีประกายวิบวับ คู่กับตัวการ์ตูนสาวผมน้ำตาลในชุดรัดรูปสีม่วง นั่งอยู่ในกรอบวงกลมที่ล้อมด้วยหัวใจสีชมพู" },
  { name: "JILI", src: image8, alt: "แบนเนอร์ค่ายเกม JILI ตัวอักษรทองบนพื้นดำ คู่กับนางเงือกผมแดงสวมเกราะเปลือกหอยสีทอง ยกหอยสังข์แนบหูอยู่ใต้ทะเลที่มีปลาการ์ตูนและปะการัง" },
  { name: "Ask Me Bet", src: image9, alt: "แบนเนอร์ค่ายเกม ask me bet โลโก้สามช่องสีขาวเขียวเหลืองบนพื้นดำ คู่กับหัวสิงโตเชิดสีแดงทองตาโต ใต้แถวโคมไฟสีแดงหน้าศาลเจ้า" },
  { name: "New Game", src: image10, alt: "แบนเนอร์ New Game ตัวอักษรสีขาวนูนกลางภาพ ขนาบด้วยตัวการ์ตูนฟักทองหัวไฟกับโครงกระดูกยิ้ม ยืนบนฟลอร์นีออนสีชมพูฟ้าที่เกลื่อนด้วยชิปและลูกเต๋า" },
  { name: "JOKER", src: image11, alt: "แบนเนอร์ค่ายเกม JOKER ตัวอักษรขาวทองบนพื้นดำ คู่กับนักรบโรมันสวมหมวกเหล็กติดขนนกและถือโล่ ยืนเคียงสิงโตกำลังคำรามกลางสนามประลอง" },
  { name: "AFB Gaming", src: image12, alt: "แบนเนอร์ค่ายเกม AFB Gaming โลโก้ตัวอักษรทองบนพื้นดำ คู่กับเทพซุสเคราขาวตาเรืองแสงสีฟ้า สวมมงกุฎใบลอเรลและกำไลทองหน้าวิหารกรีก" },
];

const gameList = demoGames.map((game) => ({ name: game.name, imagePath: game.src.src }));

const pageTitle = "ทดลองเล่นสล็อต YIMSIAM889 - ลองระบบเกมก่อนใช้เครดิตจริง";

const pageHeading = "ทดลองเล่นสล็อต YIMSIAM889 ลองระบบเกมให้คุ้นมือก่อนใช้เครดิตจริง";

const pageDescription =
  "ทดลองเล่นสล็อต YIMSIAM889 เว็บตรงไม่ผ่านเอเย่นต์ เปิดดูหน้าเกมจากค่าย PG SOFT Joker Gaming และ Pragmatic Play ก่อนใช้เครดิตจริง ดูเดิมพันต่อรอบและฟีเจอร์โบนัส";

const ctx = schemaCtx(Astro);
const graph = pageGraph(Astro, {
  type: "CollectionPage",
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  ],
  extra: [
    itemList(ctx, {
      name: "ทดลองเล่นเกมสล็อตของ YIMSIAM889",
      alternateName: "YIMSIAM889 โหมดทดลองเล่นสล็อตหลายค่ายบนมือถือ ก่อนใช้เครดิตจริงด้วยยูสเซอร์เดียว",
      itemType: "Game",
      items: gameList,
    }),
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox as="h1" title={pageHeading}>
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed">
        หากท่านกำลังมองหาที่ลองเกมให้คุ้นมือก่อนลงเครดิตจริง <strong class="text-[#9cc9ff]">YIMSIAM889</strong> สล็อตสยามเว็บตรงไม่ผ่านเอเย่นต์ พร้อมเปิดเรือนให้ท่านเข้ามาดูหน้าเกมจากค่ายดัง เพื่อให้รู้จังหวะของเกมก่อนตัดสินใจขอรับ
      </p>
      <p class="text-left text-base leading-relaxed">
        เชิญเลือกค่ายที่สะดุดตาจากด้านล่าง กดที่ภาพเพื่อสมัครสมาชิกเพียงครั้งเดียว แล้วเข้าโหมดทดลองของค่ายนั้นต่อได้จากหน้าสมาชิก ใช้เวลาเพียงครู่เดียวก็พร้อมลองแล้วขอรับ
      </p>
      <p class="text-left text-base leading-relaxed">
        จะเปิดจากมือถือ iOS หรือ Android แท็บเล็ต หรือคอมพิวเตอร์ ก็ใช้ยูสเซอร์เดิมได้ทุกเครื่อง เมนูภาษาไทยอ่านง่ายสบายตา ไม่ต้องแปลไทยเป็นไทยอีกรอบ
      </p>
    </div>
  </ContentBox>

  <ContentBox as="h2" title="เลือกค่ายที่ถูกใจ สมัครสมาชิก YIMSIAM889 ครั้งเดียว ยูสเดียวลองได้หลายค่าย">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed">
        เรือนนี้รวมเกมไว้หลายรส ทั้งสล็อตกราฟิก 3D ของ PG SOFT เกมคลาสสิกรอบสั้นของ Joker Gaming และเกมฟีเจอร์แพรวพราวของ Pragmatic Play ทุกค่ายเชื่อมสัญญาณตรงจากค่ายแม่แบบลิขสิทธิ์แท้ขอรับ
      </p>
      <p class="text-left text-base leading-relaxed">
        ปุ่มบนภาพเขียนว่าสมัครเพื่อลอง เพราะจะพาท่านไปขั้นตอนสมัครสมาชิกก่อน กรอกข้อมูลเบื้องต้นให้ครบก็ได้ยูสเซอร์ไว้เข้าสู่ระบบ แล้วเลือกเปิดเกมที่อยากลองได้จากหน้าสมาชิกทันที
      </p>
      <p class="text-left text-base leading-relaxed">
        สมัครครั้งเดียวใช้ได้กับทุกค่ายในเรือน อยากเปลี่ยนบรรยากาศจากเกมหนึ่งไปอีกเกมก็กดสลับได้เลย ไม่ต้องเปิดบัญชีใหม่ทีละค่ายให้วุ่นวาย
      </p>
      <div class="mt-4 mb-5 grid grid-cols-2 gap-5 sm:grid-cols-2 md:grid-cols-4">
        {
          demoGames.map((game) => (
            <div class="group/game relative mx-auto w-full max-w-[400px] overflow-hidden rounded-xl border border-[#16357a]">
              <Picture
                src={game.src}
                alt={game.alt}
                loading="lazy"
                fetchpriority="low"
                widths={[200, 400, 600]}
                sizes="(max-width: 768px) 50vw, 25vw"
                class="block h-auto w-full object-cover shadow-[0_10px_30px_rgba(47,140,255,0.18)] transition-transform duration-300 group-hover/game:scale-105"
                decoding="async"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
                quality={60}
              />
              <a
                href="/register/"
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`สมัครสมาชิก YIMSIAM889 เพื่อลองเล่น ${game.name}`}
                class="absolute inset-0 flex items-center justify-center bg-[#020b24]/85 opacity-0 transition-opacity duration-300 group-hover/game:opacity-100 focus-visible:opacity-100">
                <span class="rounded-full border border-[#0b4fd6]/60 bg-gradient-to-r from-[#eaf4ff] via-[#9cc9ff] to-[#4d9dff] px-6 py-2 font-bold text-[#03133c] shadow-[0_10px_30px_rgba(47,140,255,0.4)] transition-transform hover:scale-110">สมัครเพื่อลอง</span>
              </a>
            </div>
          ))
        }
      </div>
    </div>
  </ContentBox>

  <ContentBox as="h2" title="ทดลองเล่นฟรีไม่จำกัดรอบ ลองให้พอใจก่อนใช้เครดิตจริง">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed">
        เข้าโหมดทดลองแล้วหมุนได้ไม่จำกัดรอบ เพราะใช้เครดิตสมมติทั้งหมด ท่านอยากลองผิดลองถูกกี่ครั้งก็เชิญตามสบาย ไม่เร่ง ไม่กดดัน ตามแบบฉบับการต้อนรับของเรือนยิ้มสยามขอรับ
      </p>
      <p class="text-left text-base leading-relaxed">
        ระหว่างลองเชิญสังเกตไปด้วยว่าเดิมพันต่อรอบเริ่มที่เท่าไร ฟรีสปินกับฟีเจอร์โบนัสเข้ามาในจังหวะไหน และหนึ่งรอบยาวพอดีกับที่ท่านชอบหรือไม่ จะได้เลือกเกมที่ถูกจริตตัวเองตั้งแต่ยังไม่ลงทุน
      </p>
      <p class="text-left text-base leading-relaxed">
        เกมบน YIMSIAM889 รับสัญญาณตรงจากค่ายแม่ ค่า RTP เป็นไปตามมาตรฐานสากล ไม่มีใครมาแอบปรับหลังบ้าน หน้าเกมและกติกาที่ท่านเห็นตอนทดลองจึงเป็นชุดเดียวกับตอนเล่นจริง ต่างกันเพียงเครดิตที่ใช้หมุน
      </p>
      <p class="text-left text-base leading-relaxed">
        เรื่องที่กระผมขอเรียนให้ชัดตั้งแต่ต้น เครดิตในโหมดทดลองถอนออกมาไม่ได้ และไม่นับเป็นยอดเทิร์นของโปรโมชั่นใดทั้งสิ้น มีไว้ให้ท่านทำความรู้จักเกมอย่างเดียวขอรับ
      </p>
      <p class="text-left text-base leading-relaxed">
        อีกข้อคือไม่ใช่ทุกเกมที่มีปุ่มทดลอง เพราะโหมดนี้ขึ้นอยู่กับค่ายผู้พัฒนาแต่ละราย หากเกมที่ท่านหมายตายังไม่เปิดไว้ <a href="/contact-us/" class="font-bold text-[#7cc0ff] underline underline-offset-4 transition-colors hover:text-[#eaf4ff]">ทักทีมงาน</a> ให้ช่วยแนะนำเกมแนวใกล้เคียงได้เลย
      </p>
    </div>
  </ContentBox>

  <ContentBox as="h2" title="พร้อมเมื่อไหร่ เริ่มเล่นจริงกับ YIMSIAM889 ได้ทันทีด้วยยูสเซอร์เดิม">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed">
        เมื่อเจอเกมที่ใช่แล้ว ท่านเริ่มเล่นจริงได้เลยด้วยยูสเซอร์เดิม ไม่ต้องสมัครซ้ำ จะเริ่มเบาๆ หรือจัดเต็มก็เลือกได้ตามงบของท่านเอง เรือนนี้ไม่เร่งและไม่กดดันให้ฝากเพิ่ม
      </p>
      <p class="text-left text-base leading-relaxed">
        ฝากถอนเป็นระบบอัตโนมัติ ทำรายการเองผ่านแอปพลิเคชันธนาคารชั้นนำหรือทรูวอลเลทได้เลย ไม่ต้องส่งสลิปให้แอดมินดูให้เสียเวลา ท่านจึงสนุกต่อได้ยาวๆ โดยไม่ต้องนั่งรอ
      </p>
      <p class="text-left text-base leading-relaxed">
        สมาชิกใหม่ยังมีของขวัญต้อนรับจัดเตรียมไว้ให้ยิ้มรับตั้งแต่ก้าวแรก เงื่อนไขของแต่ละรายการดูได้ที่ <a href="/promotion/" class="font-bold text-[#7cc0ff] underline underline-offset-4 transition-colors hover:text-[#eaf4ff]">หน้าโปรโมชั่น</a> เลือกรับเฉพาะรายการที่เข้ากับสไตล์การเล่นของท่านได้เลยขอรับ
      </p>
      <p class="text-left text-base leading-relaxed">
        อีกเรื่องที่ควรติดตัวไว้เสมอ อย่าบอกรหัสผ่านหรือรหัส OTP กับผู้ใดทั้งสิ้น แม้ผู้นั้นจะอ้างว่าเป็นทีมงานก็ตาม เพราะทีมงานตัวจริงไม่มีเหตุให้ต้องขอขอรับ
      </p>
      <p class="text-left text-base leading-relaxed">
        เชิญเลือกค่ายที่ถูกใจแล้วเริ่มได้เลยขอรับ เกมที่ท่านคุ้นมือจากโหมดทดลองวันนี้ คือเกมที่ท่านรู้จักหน้าตาและกติกาดีแล้วเมื่อถึงรอบเล่นจริง ไม่ต้องเดาเอาเอง
      </p>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
