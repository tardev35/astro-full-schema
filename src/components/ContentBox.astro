---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-[24px] border border-[#2a6b2c] bg-[#0c2a12]/95 p-8 pt-10 text-left text-base leading-relaxed text-[#e3eedf] shadow-[0_10px_30px_rgba(1,10,3,0.45)] transition-shadow duration-500 hover:border-[#fcaa04]/60 hover:shadow-[0_16px_40px_rgba(252,170,4,0.16)] md:p-10 md:pt-12">
    <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-1.5 bg-gradient-to-r from-[#c77d00] via-[#fcaa04] to-[#2f9e1f]"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-16 -bottom-16 -z-10 h-44 w-44 rounded-full bg-[#2f9e1f]/20 blur-[50px] transition-colors duration-500 group-hover:bg-[#fcaa04]/15"></div>

    {
      title && (
        <header class="mb-6 border-l-4 border-[#fcaa04] pl-4">
          <HeadingTag class="text-2xl leading-normal font-black text-white">{title}</HeadingTag>
          <span aria-hidden="true" class="mt-2 block h-1 w-16 rounded-full bg-gradient-to-r from-[#fcaa04] to-[#5ccf3f]" />
        </header>
      )
    }
    <slot />
  </div>
</section>
