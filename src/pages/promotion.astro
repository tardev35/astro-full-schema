---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementCyber.astro";

import { Picture } from "astro:assets";

import pro1 from "../assets/slide1.png";
import pro2 from "../assets/slide2.png";
import pro3 from "../assets/slide3.png";
import pro4 from "../assets/slide4.png";
import pro5 from "../assets/slide5.png";
import { pageGraph } from "../lib/schema";

const pageTitle = "โปรโมชั่น AMBHENG88 โบนัสฝาก ฝากรับเพิ่ม และสิทธิ์แนะนำเพื่อน";

const pageHeading = "โปรโมชั่นและสิทธิ์สมาชิก AMBHENG88";

const pageDescription =
  "รวมภาพโปรโมชั่นของ AMBHENG88 ทั้งโบนัสฝาก 50% ฝากรับเพิ่ม 10% และสิทธิ์แนะนำเพื่อน ดูยอดรับ เงื่อนไขเทิร์น และยอดถอนสูงสุดที่ระบุบนภาพได้ครบในหน้าเดียว";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: pro1.src,
});

const promoClass =
  "mx-auto h-auto w-full rounded-xl border border-[#4a1030] object-contain shadow-[0_10px_30px_rgba(255,45,142,0.16)] transition-all duration-300 hover:-translate-y-1 hover:border-[#ff2d8e]/55 hover:shadow-[0_15px_40px_rgba(255,45,142,0.28)]";
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageHeading} as="h1">
    <p class="mb-4 text-left text-base leading-relaxed">
      หากคุณกำลังมองหาโปรที่กดรับเองได้จากหน้าเว็บ <strong class="text-[#ff74b6]">AMBHENG88</strong> รวมโบนัสฝาก โปรฝากรับเพิ่ม สิทธิ์แนะนำเพื่อน และอัตราจ่ายพิเศษไว้ในภาพด้านล่างนี้ครบแล้ว
    </p>

    <p class="mb-8 text-left text-base leading-relaxed">
      ยอดรับ เงื่อนไขเทิร์น และยอดถอนสูงสุดระบุไว้บนภาพทุกใบ เลือกใบที่ตรงกับงบและสไตล์การเล่นของคุณ แล้วสมัครยูสเดียวใช้ได้ทุกสิทธิ์ เพื่อประสบการณ์ที่คุ้มค่ากว่าเดิม
    </p>

    <div class="grid w-full grid-cols-1 gap-6 sm:grid-cols-2">
      <Picture
        src={pro1}
        alt="ภาพโปรโมชั่น AMBHENG88 ฝากรับโบนัสเพิ่ม 10% พื้นม่วงเข้มขอบทอง มีเพชรสีชมพูเรืองแสงอยู่กลางภาพ ข้อความบนภาพระบุ โบนัส 10% มูลค่าสูงสุด 500 บาท ฝากขั้นต่ำ 100 บาทต่อบิล ทำเทิร์น 8 เท่า ถอนได้สูงสุด 5 เท่า พร้อมตรา VIP EXCLUSIVE"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class={promoClass}
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />

      <Picture
        src={pro2}
        alt="ภาพโปรโมชั่น AMBHENG88 โบนัสฝาก 50% โลโก้ AMBHENG88 อยู่กลางภาพ ล้อมด้วยไพ่ ชิปคาสิโน ตู้สล็อตเลข 777 และหีบสมบัติเหรียญทอง ข้อความบนภาพระบุ ฝาก 1,000 บาทขึ้นไป รับโบนัส 50% สูงสุด 10,000 บาท ทำเทิร์น 5 เท่า ถอนได้สูงสุด 2 เท่า"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class={promoClass}
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />

      <Picture
        src={pro3}
        alt="ภาพโปรโมชั่น AMBHENG88 อัตราจ่ายที่ดีที่สุด ฉากเมืองนีออนสีชมพู มีพรีเซนเตอร์หญิงผมชมพูยืนอยู่ข้างข้อความ 3 ตัว บาทละ 1,000 บาท และ 2 ตัว บาทละ 100 บาท"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class={promoClass}
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />

      <Picture
        src={pro4}
        alt="ภาพโปรโมชั่น AMBHENG88 ครบจบในที่เดียว พรีเซนเตอร์หญิงทำมือเป็นรูปหัวใจอยู่กลางภาพ ข้างกันเป็นปุ่มสี่ปุ่ม หวย บาคาร่า บอล และสล็อต แถบด้านล่างเป็นเครื่องหมายถูกเรียงกัน บอล คาสิโน สล็อต ยิงปลา ไก่ชน มวย ไฮโล รูเล็ต"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class={promoClass}
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />

      <Picture
        src={pro5}
        alt="ภาพโปรโมชั่น AMBHENG88 แนะนำเพื่อนรับโบนัส 0.8% พรีเซนเตอร์หญิงสองคนถือชิปคาสิโนและไพ่อยู่สองข้างของข้อความ พร้อมบรรทัดล่างที่เขียนว่า สร้างรายได้ 100,000 ต่อเดือน"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class={promoClass}
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />
    </div>

    <div class="mt-12 flex justify-center pb-4">
      <a
        href="/register"
        class="flex items-center justify-center rounded-lg border border-[#c9a800] bg-gradient-to-r from-[#fff27a] via-[#ffe814] to-[#c9a800] px-10 py-3.5 text-lg font-black text-[#170512] shadow-[0_10px_30px_rgba(255,232,20,0.24)] transition-transform hover:scale-105 hover:shadow-[0_15px_40px_rgba(255,232,20,0.34)]">
        สมัครสมาชิก AMBHENG88
      </a>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
