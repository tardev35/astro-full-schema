---
const {
  message = "VING999 เว็บตรงอันดับ1 รวมสล็อตออนไลน์จากหลายค่ายไว้ในยูสเดียว ทั้งเกมยอดฮิต เกมใหม่ และเกมที่มีโบนัสฟีเจอร์ • เปลี่ยนค่ายหรือเปลี่ยนหมวดเกมได้ทันทีโดยใช้เครดิตและบัญชีเดิม ไม่ต้องแยกยูสตามผู้ให้บริการ • ระบบฝากถอนออโต้ทำรายการและเช็กสถานะได้เองจากหน้าเมมเบอร์ • รองรับทั้งบัญชีธนาคารและ TrueWallet เลือกช่องทางที่ถนัดได้จากระบบสมาชิก • ฝากขั้นต่ำ 1 บาท เริ่มจากทุนเล็กเพื่อลองระบบและเลือกเกมก่อนได้ • โปรโมชั่นเปลี่ยนตามช่วงเวลา ดูยอดรับ เทิร์น และเงื่อนไขในหน้าโปรก่อนกดรับทุกครั้ง • ทางเข้า VING999 รองรับมือถือ ล็อกอินด้วยยูสเดิมแล้วเข้าเกมต่อได้ทันที",
} = Astro.props;

const SCROLL_PX_PER_SEC = 50;
const PX_PER_CHAR = 6.2;
const TRAILING_PX = 81;
const scrollSeconds = Math.max(12, Math.round((message.length * PX_PER_CHAR + TRAILING_PX) / SCROLL_PX_PER_SEC));
---

<div class="mx-auto w-full max-w-7xl px-4 py-3 font-sans">
  <div class="relative overflow-hidden rounded-md border border-[#e01b2d]/45 bg-[#0e0708] shadow-[0_0_15px_rgba(224,27,45,0.22)]">
    <div aria-hidden="true" class="absolute top-0 -left-4 h-full w-8 -skew-x-12 bg-gradient-to-b from-[#ff3b46] to-[#8f0a13]"></div>
    <div aria-hidden="true" class="absolute top-0 -right-4 h-full w-8 -skew-x-12 bg-[#bdcad2]/20"></div>

    <div class="flex items-center">
      <div class="relative z-10 flex w-12 shrink-0 items-center justify-center bg-gradient-to-b from-[#ff3b46] to-[#8f0a13] py-2.5">
        <span aria-hidden="true" class="animate-pulse text-lg drop-shadow-[0_0_5px_rgba(242,245,247,0.85)]">🎰</span>
      </div>

      <div class="marquee-container relative flex-1 overflow-hidden py-2.5 pr-6">
        <div aria-hidden="true" class="pointer-events-none absolute top-0 left-0 z-10 h-full w-8 bg-gradient-to-r from-[#0e0708] to-transparent"></div>
        <div aria-hidden="true" class="pointer-events-none absolute top-0 right-0 z-10 h-full w-12 bg-gradient-to-l from-[#0e0708] to-transparent"></div>

        <div class="marquee-content inline-block pl-4 text-sm font-bold tracking-wide whitespace-nowrap text-[#e8eef2]" style={`animation-duration:${scrollSeconds}s`}>
          <span class="mr-8 inline-flex items-center gap-2"><span aria-hidden="true" class="h-1.5 w-1.5 rounded-full bg-[#e01b2d] shadow-[0_0_5px_rgba(224,27,45,0.85)]"></span>{message}</span>
          <span aria-hidden="true" class="mr-8 inline-flex items-center gap-2"><span class="h-1.5 w-1.5 rounded-full bg-[#e01b2d] shadow-[0_0_5px_rgba(224,27,45,0.85)]"></span>{message}</span>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .marquee-content {
    animation: marquee 25s linear infinite;
  }
  .marquee-container:hover .marquee-content {
    animation-play-state: paused;
  }
  @keyframes marquee {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee-content {
      animation: none;
    }
  }
</style>
