---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/AnnouncementHuay.astro";
import ContentBoxHuay from "../components/ContentBoxHuay.astro";
import Navfoot from "../components/Navfoot.astro";
import { pageGraph } from "../lib/schema";

const pageDescription = "รวมแนวทางหวยและเลขเด่นบน POE888 เว็บสีฟ้า ครบทั้งหวยไทย หวยลาว หวยฮานอย และหวยมาเลย์ พร้อมรอบปิดรับ อัตราจ่ายของแต่ละประเภท และข้อมูลที่ควรเช็กก่อนยืนยันโพย";

const graph = pageGraph(Astro, {
  name: "แนวทางหวย POE888 เลขเด่นทุกตลาด",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "แนวทาง", path: "/แนวทาง" },
  ],
});

const tips = [
  { title: "แนวทางหวยไทย งวดล่าสุด", desc: "รวมเลขเด่นและเลขรองของงวดนี้ พร้อมเวลาปิดรับ ตรวจให้ครบก่อนกดยืนยันโพย", type: "หวยไทย", date: "วันนี้", hot: true },
  { title: "เจาะเลขฮานอยรอบพิเศษ", desc: "สรุปสถิติหวยฮานอยย้อนหลังหลายรอบ ดูแนวโน้มก่อนเลือกเลขและจัดโพย", type: "หวยฮานอย", date: "วันนี้", hot: true },
  { title: "แนวทางหวยลาวพัฒนา", desc: "รวมเลขที่ถูกพูดถึงมากที่สุดของงวดนี้ จดไว้ก่อนถึงเวลาปิดรับหวยลาว", type: "หวยลาว", date: "เมื่อวาน", hot: false },
  { title: "สรุปแนวทางหวยมาเลย์", desc: "เลขเด่นและรอบออกผลของหวยมาเลย์ มัดรวมไว้ให้อ่านจบได้ในที่เดียว", type: "หวยมาเลย์", date: "เมื่อวาน", hot: false },
  { title: "อ่านอัตราจ่ายก่อนวางโพย", desc: "3 ตัวบนบาทละ 950 โต๊ด 150 ล่าง 200 และ 2 ตัว 95 คิดยอดให้ชัดก่อนยืนยัน", type: "อัตราจ่าย", date: "2 วันที่แล้ว", hot: false },
  { title: "จัดโพยหลายตลาดในบัญชีเดียว", desc: "วางแผนแบ่งเลขข้ามตลาด แล้วย้อนดูประวัติรายการได้จากหน้าบัญชีสมาชิก", type: "เทคนิค", date: "2 วันที่แล้ว", hot: false },
];
---

<MainLayout title="แนวทางหวย POE888 เลขเด่นทุกตลาด หวยไทย ลาว ฮานอย มาเลย์ เว็บสีฟ้า" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <section class="mx-auto my-8 w-full max-w-7xl px-4 font-sans">
    <div class="mb-10 flex flex-col items-center text-center">
      <span aria-hidden="true" class="mb-2 text-4xl drop-shadow-[0_0_10px_rgba(255,217,61,0.8)]">🔮</span>
      <h1 class="bg-gradient-to-r from-[#ffe98a] via-[#ffd93d] to-[#cd994e] bg-clip-text text-4xl font-black tracking-widest text-transparent uppercase">แนวทางหวย POE888</h1>
      <p class="mt-3 text-left text-base leading-relaxed text-[#b9cdf0]">
        รวมเลขเด่นและข้อมูลที่คนติดตามหวยใช้ประกอบการเลือกเลข ครบทั้งหวยไทย หวยลาว หวยฮานอย และหวยมาเลย์ ให้สมาชิก POE888 วางแผนโพยได้ก่อนถึงรอบปิดรับของแต่ละตลาด
      </p>
    </div>

    <section aria-label="รวมแนวทางหวยล่าสุดของทุกตลาดที่ POE888 เปิดรับ">
      <p class="mb-6 text-center text-2xl font-black tracking-widest text-[#ffd93d] uppercase">รวมแนวทางหวยล่าสุด ครบทุกตลาดที่เปิดรับ</p>

      <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
        {
          tips.map((tip) => (
            <article
              aria-label={tip.title}
              class="group relative flex flex-col overflow-hidden rounded-2xl border border-[#2e8bff]/30 bg-[#04173f]/90 p-6 shadow-lg backdrop-blur-sm transition-all duration-300 hover:-translate-y-2 hover:border-[#ffd93d]/50 hover:shadow-[0_15px_30px_rgba(255,217,61,0.2)]">
              <div
                aria-hidden="true"
                class="pointer-events-none absolute inset-0 bg-gradient-to-br from-[#0b4ea8]/35 to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100"
              />

              <div class="relative z-10 mb-4 flex items-center justify-between">
                <span class="rounded-full border border-[#ffd93d]/40 bg-[#062459] px-3 py-1 text-xs font-bold text-[#ffd93d]">{tip.type}</span>
                {tip.hot && (
                  <span class="flex animate-pulse items-center gap-1 text-xs font-black text-[#ffe98a]">
                    <span aria-hidden="true">🔥</span> มาแรง
                  </span>
                )}
              </div>

              <span class="relative z-10 mb-2 line-clamp-1 block text-xl font-bold text-[#dbeafe] transition-colors group-hover:text-[#a8d4ff]">{tip.title}</span>

              <p class="relative z-10 mb-6 text-left text-base leading-relaxed text-[#b9cdf0]">{tip.desc}</p>

              <span class="relative z-10 mt-auto text-sm font-bold text-[#a8d4ff]">อัปเดต {tip.date}</span>
            </article>
          ))
        }
      </div>
    </section>
  </section>

  <ContentBoxHuay title="ตลาดหวยที่ POE888 เปิดรับและรอบปิดรับของแต่ละตลาด" as="h2">
    <p class="text-left text-base leading-relaxed text-[#dbeafe]">
      POE888 วางหวยไทยและหวยลาวเป็นตลาดหลัก และเปิดหวยฮานอยกับหวยมาเลย์ไว้ให้คนที่ติดตามหลายตลาดในวันเดียวกัน แต่ละตลาดมีรอบออกผลและเวลาปิดรับเป็นของตัวเอง แนวทางของงวดหนึ่งจึงใช้ข้ามตลาดไม่ได้
      ก่อนหยิบเลขจากหน้านี้ไปใช้ ควรเช็กก่อนว่ากำลังดูรอบไหนอยู่ และรอบนั้นยังเปิดรับโพยหรือปิดไปแล้ว
    </p>

    <p class="mt-4 text-left text-base leading-relaxed text-[#dbeafe]">
      เลขที่รวมไว้บนหน้านี้เป็นข้อมูลประกอบการตัดสินใจ ไม่ใช่ผลรางวัลและไม่ใช่การรับประกันว่าเลขชุดใดจะออก ผลจริงของทุกตลาดดูได้จากหน้า
      <a href="/ตรวจหวย/" class="font-bold text-[#ffd93d] underline underline-offset-4">ตรวจหวย</a> ซึ่งอัปเดตหลังแต่ละตลาดประกาศผลของงวดนั้นแล้ว
    </p>
  </ContentBoxHuay>

  <ContentBoxHuay title="ใช้แนวทางหวยร่วมกับการจัดโพยบน POE888 อย่างไร" as="h2">
    <p class="text-left text-base leading-relaxed text-[#dbeafe]">
      วิธีที่ทำให้เลขเด่นกลายเป็นโพยที่จัดการได้จริง คือเลือกตลาดก่อน แล้วจึงเลือกประเภทที่จะแทง เพราะอัตราจ่ายผูกกับประเภท ไม่ได้ผูกกับตัวเลข สามตัวบนคิดบาทละ 950 สามตัวโต๊ดบาทละ 150 สามตัวล่างบาทละ
      200 ส่วนสองตัวบนและสองตัวล่างบาทละ 95 เลขชุดเดียวกันจึงให้ยอดต่างกันตามที่เลือกไว้ตอนยืนยันโพย
    </p>

    <p class="mt-4 text-left text-base leading-relaxed text-[#dbeafe]">
      เมื่อยืนยันแล้ว รายการทั้งหมดจะถูกเก็บไว้กับบัญชีสมาชิก ทั้งเลข ประเภท ยอด และตลาดที่ส่งไป ทำให้ย้อนกลับมาดูได้ว่าเลขชุดไหนอยู่ในรอบใด โดยไม่ต้องจดแยกไว้เอง
      คนที่เล่นหลายตลาดในวันเดียวกันจึงไม่ต้องไล่ความจำ ใช้ประวัติรายการในบัญชีเป็นหลักฐานเดียวได้เลย
    </p>
  </ContentBoxHuay>

  <Navfoot />
</MainLayout>
