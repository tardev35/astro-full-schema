---
import { Picture } from "astro:assets";

import slide2 from "../assets/slide2.png";
import slide3 from "../assets/slide3.png";

const images = [
  {
    src: slide2,
    alt: "ภาพโปรโมชั่น SCLASS88 พื้นหลังสีดำตกแต่งด้วยลายทองและเหรียญทอง ด้านบนเป็นตัวอักษร SCLASS88 ถัดลงมาเป็นตัวอักษรทองขนาดใหญ่ว่า โบนัสกำไรบาน และ สล็อตเว็บตรง สนุกแตกง่าย ใต้ลงมาเป็นสองบรรทัดเขียนว่า รวมสล็อตค่ายใหญ่ เข้าเล่นง้าย และ ฝากถอนออโต้ ตลอด 24 ชม. ตรงกลางเป็นหีบสมบัติเปิดออกมีเหรียญทองล้นออกมา ด้านขวาเป็นพรีเซนเตอร์หญิงสวมชุดสีดำ มีปุ่มสีทองเขียนว่า เข้าสู่ระบบ และแถบล่างสุดเขียนว่า ลุ้นเครดิตฟรี สูงสุด 1,000 บาท",
  },
  {
    src: slide3,
    alt: "ภาพโปรโมชั่น SCLASS88 พื้นหลังสีดำตกแต่งด้วยลายทอง ด้านบนเป็นตัวอักษร SCLASS88 ถัดลงมาเขียนว่า ฝากเงินผ่าน QR Code ง่ายๆ และ ระบบออโต้ ฝากถอนไว ทำตามได้ไม่ยาก ตรงกลางเป็นภาพหน้าจอโทรศัพท์สามเครื่องเรียงกันพร้อมลำดับขั้นตอนว่า 1 กดเมนูฝากเงิน 2 เลือก QR Code และ 3 สแกนและยืนยัน ด้านขวาเป็นพรีเซนเตอร์หญิงสวมชุดสีดำถือกล่องของขวัญสีทอง แถบล่างสุดเขียนว่า Auto Wallet 24 ชม. รองรับมือถือ ใช้งานง่าย",
  },
];

const COPIES = 3;
const slides = Array.from({ length: COPIES }, () => images).flat();
---

<div class="marquee mx-auto w-full max-w-7xl overflow-hidden px-4 py-5">
  <input id="carousel-pause" type="checkbox" class="peer sr-only" />
  <label
    for="carousel-pause"
    class="sr-only cursor-pointer peer-focus-visible:not-sr-only peer-focus-visible:mb-3 peer-focus-visible:inline-block peer-focus-visible:rounded-full peer-focus-visible:border peer-focus-visible:border-[#f5c542]/60 peer-focus-visible:px-4 peer-focus-visible:py-2 peer-focus-visible:text-sm peer-focus-visible:font-bold peer-focus-visible:text-[#ffe9a8]">
    หยุด / เล่นสไลด์ภาพ
  </label>

  <div class="marquee-track flex">
    {
      slides.map((slide, index) => {
        const isDuplicate = index >= images.length;
        return (
          <div class="marquee-slide" aria-hidden={isDuplicate ? "true" : undefined}>
            <Picture
              src={slide.src}
              alt={isDuplicate ? "" : slide.alt}
              class="block w-full rounded-xl border border-[#f5c542]/45 object-cover shadow-[0_10px_30px_rgba(245,197,66,0.18)]"
              width={slide.src.width}
              height={slide.src.height}
              loading="lazy"
              fetchpriority="low"
              decoding="async"
              widths={[300, 360, 420, 480, 540, 600]}
              sizes="(max-width: 767px) calc(100vw - 32px), (max-width: 1279px) calc((100vw - 48px) / 2), 403px"
              formats={["avif", "webp"]}
              fallbackFormat="webp"
              quality={60}
            />
          </div>
        );
      })
    }
  </div>
</div>

<style>
  .marquee {
    --gap: 12px;
    --per-view: 1;
    --shift: calc(-200% - 24px);
  }

  @media (min-width: 768px) {
    .marquee {
      --gap: 16px;
      --per-view: 2;
      --shift: calc(-100% - 16px);
    }
  }

  @media (min-width: 1280px) {
    .marquee {
      --gap: 20px;
      --per-view: 3;
      --shift: calc(-66.6667% - 13.3333px);
    }
  }

  .marquee-track {
    gap: var(--gap);
    width: 100%;
    animation: carousel-scroll 24s linear infinite;
    will-change: transform;
  }

  .marquee-slide {
    flex: 0 0 calc((100% - (var(--per-view) - 1) * var(--gap)) / var(--per-view));
  }

  @keyframes carousel-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(var(--shift));
    }
  }

  .marquee:hover .marquee-track,
  .marquee:focus-within .marquee-track,
  .marquee > input:checked ~ .marquee-track {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
    }
  }
</style>
