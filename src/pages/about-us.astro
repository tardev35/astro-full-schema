---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";
import { pageGraph } from "../lib/schema";

const pageTitle = "เกี่ยวกับเรา KOH888 เว็บตรงรวมสล็อต คาสิโน บาคาร่า บอล และหวยในบัญชีเดียว";

const pageDescription =
  "เกี่ยวกับเรา KOH888 เว็บตรงที่รวมสล็อต คาสิโน บาคาร่า บอล และหวยไว้ในบัญชีเดียว ทำความรู้จักการจัดหมวดเกม ระบบฝากถอนออโต้ และหน้าสมาชิกที่ใช้งานง่ายบนมือถือ";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox as="h1" title={pageTitle}>
    <p class="mb-4 text-left text-base leading-relaxed text-[#e9dcf6]">
      <strong class="text-[#f5c542]">KOH888</strong> เป็นเว็บตรงที่รวมสล็อต คาสิโน บาคาร่า บอล และหวยไว้ในบัญชีสมาชิกเดียว เปิดเข้ามาแล้วเลือกหมวดที่ชอบได้จากเมนูเดิม
      อยากหมุนสล็อต ต่อบาคาร่า หรือเปลี่ยนไปเชียร์บอลก็สลับได้โดยไม่ต้องเปิดหลายหน้าให้รกจอ สิ่งที่เราให้ความสำคัญคือหน้าเว็บที่รองรับมือถือ ระบบฝากถอนออโต้
      และหน้าสมาชิกที่รวมเครดิต โปรโมชั่น และประวัติรายการไว้ครบในที่เดียว
    </p>

    <p class="text-left text-base leading-relaxed text-[#e9dcf6]">
      หน้านี้ทำหน้าที่เป็นหน้าข้อมูลและแนะนำตัว อธิบายว่าเว็บนี้ให้บริการอะไร จัดหน้าเว็บอย่างไร และเหมาะกับผู้ใช้แบบไหน เพื่อให้อ่านแล้วนำไปเทียบกับสิ่งที่เห็นในหน้าสมาชิกจริงได้
      ส่วนรายละเอียดของโปรโมชั่นและเงื่อนไขแต่ละรายการจะอยู่ในหน้ารายการของโปรนั้นโดยตรง จึงควรเปิดดูก่อนใช้สิทธิ์ทุกครั้ง
    </p>
  </ContentBox>

  <ContentBox as="h2" title="วิธีที่ KOH888 จัดหมวดเกมให้เลือกได้จากเมนูเดียว">
    <p class="mb-4 text-left text-base leading-relaxed text-[#e9dcf6]">
      เมนูของเราแบ่งเป็นสล็อต คาสิโน บาคาร่า บอล และหวย หมวดสล็อตรวมเกมหลายธีมและหลายรูปแบบ ตั้งแต่เกมเล่นง่ายไปจนถึงเกมที่มีฟรีสปิน โบนัส และตัวคูณ
      ส่วนหมวดคาสิโนสดรวมเกมโต๊ะและบาคาร่าไว้ด้วยกัน สมาชิกเลือกประเภทเกมและโต๊ะที่ต้องการจากหน้าเดียวก่อนเข้าเล่นตามรูปแบบที่ตัวเองถนัด
      หมวดบอลและหวยเปิดไว้สำหรับคนที่ไม่ได้เล่นเฉพาะเกมคาสิโน จะตามการแข่งขันกีฬาหรือลุ้นตัวเลขก็ทำผ่านบัญชีเดียวกัน
    </p>

    <p class="text-left text-base leading-relaxed text-[#e9dcf6]">
      การแยกหมวดแบบนี้ทำให้คนมีเกมประจำหาเจอเร็ว ส่วนคนที่ชอบลองของใหม่ก็เลือกต่อได้ง่าย เกมเยอะเป็นเรื่องดี แต่ถ้าจัดไม่เป็นก็กลายเป็นโกดัง
      เราจึงเน้นให้เลือกง่ายมากกว่าโยนทุกอย่างมากองรวมกัน วันนี้สายสล็อต พรุ่งนี้สายบอลก็เปลี่ยนได้ ความชอบเปลี่ยนได้ตามวัน แต่บัญชีไม่ต้องเปลี่ยนตามให้วุ่น
    </p>
  </ContentBox>

  <ContentBox as="h2" title="ระบบฝากถอนออโต้และหน้าสมาชิกที่เรารวมไว้จุดเดียว">
    <p class="mb-4 text-left text-base leading-relaxed text-[#e9dcf6]">
      KOH888 ใช้ระบบฝากถอนออโต้ ทำให้การเติมเครดิตและถอนยอดจบเป็นขั้นตอนตรงไปตรงมา สมาชิกดูยอดและรายการที่เกี่ยวข้องได้จากหน้าบัญชีโดยตรง
      จึงลดเวลาระหว่างเติมเครดิตกับการเลือกเกม ทำรายการเสร็จแล้วกลับเข้าเกมได้ทันที
    </p>

    <p class="text-left text-base leading-relaxed text-[#e9dcf6]">
      เมื่อระบบการเงินอยู่ในหน้าสมาชิกเดียวกับเครดิต โปรโมชั่น และประวัติรายการ การใช้งานก็ไหลต่อเนื่องกว่าเดิม ตั้งค่าบัญชีครั้งเดียวแล้วใช้ต่อได้ทุกหมวด
      เพราะเวลาที่ควรลุ้นคือในเกม ไม่ใช่นั่งลุ้นว่าหน้าธุรกรรมจะพาไปทางไหนต่อ
    </p>
  </ContentBox>

  <ContentBox as="h2" title="ทางเข้าและการใช้งานบนอุปกรณ์ที่สมาชิกถนัด">
    <p class="mb-4 text-left text-base leading-relaxed text-[#e9dcf6]">
      ทางเข้าของเรารองรับโทรศัพท์ แท็บเล็ต และคอมพิวเตอร์ สมาชิกเข้าสู่ระบบผ่านเบราว์เซอร์แล้วเลือกเกม ดูโปรโมชั่น หรือจัดการบัญชีได้ตามอุปกรณ์ที่ใช้อยู่
      หน้าเว็บบนมือถือเน้นเมนูหลักที่กดง่ายและไม่อัดข้อมูลจนแน่นเกินจอ จอเล็กพอแล้ว ปุ่มไม่ควรเล็กตามจนต้องใช้สมาธิระดับผ่าตัด
    </p>

    <p class="text-left text-base leading-relaxed text-[#e9dcf6]">
      การใช้บัญชีเดิมบนหลายอุปกรณ์ช่วยให้เปลี่ยนหน้าจอได้ตามสถานการณ์ อยู่บ้านใช้คอม ออกข้างนอกใช้มือถือ เมนูและข้อมูลสมาชิกยังอยู่ในระบบเดียวกัน
      เปลี่ยนอุปกรณ์ได้ แต่ไม่ต้องเริ่มชีวิตใหม่ทุกครั้ง และไม่ควรส่งรหัสผ่านหรือรหัส OTP ให้บุคคลอื่นไม่ว่ากรณีใด
    </p>
  </ContentBox>

  <ContentBox as="h2" title="KOH888 เหมาะกับผู้ใช้แบบไหน">
    <p class="mb-4 text-left text-base leading-relaxed text-[#e9dcf6]">
      KOH888 เหมาะกับคนที่ชอบสล็อต คาสิโน บาคาร่า บอล และหวย แต่ต้องการใช้งานทั้งหมดจากบัญชีเดียว รวมถึงคนที่เล่นผ่านมือถือเป็นหลักและอยากจัดการเครดิตกับโปรโมชั่นจากหน้าเดียว
      ภาพรวมของเราเน้นเกมครบ เลือกง่าย และใช้งานต่อเนื่อง จึงตอบโจทย์ทั้งสายเกมหมุน โต๊ะสด กีฬา และตัวเลข
    </p>

    <p class="text-left text-base leading-relaxed text-[#e9dcf6]">
      การสมัครใช้ข้อมูลสมาชิกตามที่ระบบกำหนด เมื่อสร้างบัญชีเรียบร้อยก็เข้าหน้าหลักเพื่อเลือกหมวดเกมได้จากเมนูเดียว ขั้นตอนสมัครควรสั้นพอให้จำได้
      เพราะทุกวันนี้รหัสผ่านในชีวิตก็เยอะจนสมองแทบอยากขอลาพักร้อนอยู่แล้ว ส่วนเงื่อนไขของโปรโมชั่นแต่ละรายการยังคงต้องอ่านจากหน้ารายการของโปรนั้นก่อนกดรับเสมอ
    </p>
  </ContentBox>

  <Navfoot />
</MainLayout>
