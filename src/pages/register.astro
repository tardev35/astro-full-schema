---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";
import CtaRedirect from "../components/CtaRedirect.astro";
import { pageGraph } from "../lib/schema";

const pageDescription =
  "สมัครสมาชิก KOH888 หน้าสมัครเว็บหลัก ขั้นตอนไม่กี่นาที เข้าเลือกสล็อต คาสิโน บาคาร่า บอล และหวยได้ทันที พร้อมฝากถอนออโต้และหน้าสมาชิกรวมเครดิตกับโปรโมชั่น";

const graph = pageGraph(Astro, {
  name: "สมัครสมาชิก KOH888 เว็บหลัก",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "สมัครสมาชิก", path: "/register" },
  ],
});

const targetUrl = "https://yoalink.com/22hs";
---

<MainLayout title="สมัครสมาชิก KOH888 | บัญชีเดียวเล่นครบทุกหมวด" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="สมัครสมาชิก KOH888" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label="สมัครสมาชิก"
        class="group relative mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#f5c542]/60 bg-gradient-to-b from-[#ffe9a3] via-[#f5c542] to-[#a9761a] px-6 py-4 text-xl font-bold tracking-wide text-[#1a0a2e] shadow-[0_10px_30px_rgba(245,197,66,0.24)] transition-all duration-300 hover:scale-105 hover:shadow-[0_15px_40px_rgba(245,197,66,0.4)]">
        สมัครสมาชิก
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="สมัครสมาชิก" />
</MainLayout>
