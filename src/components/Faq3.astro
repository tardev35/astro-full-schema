---
// ตัวอย่างข้อมูล FAQ (เอาไปวนลูปได้เลย)
const faqs = [
  {
    q: "รองรับระบบ True Wallet หรือไม่?",
    a: "แน่นอน! เราคือผู้นำด้านระบบกระเป๋าเงินออนไลน์ รองรับ TrueMoney Wallet เต็มรูปแบบ ฝากถอนง่ายไม่ต้องรอคิวธนาคาร"
  },
  {
    q: "ถอนเงินขั้นต่ำเท่าไหร่?",
    a: "ไม่มีขั้นต่ำในการฝากถอน! คุณสามารถทำรายการผ่านระบบออโต้ได้ตั้งแต่ 1 บาทเป็นต้นไป ทำรายการไวภายใน 3 วินาที"
  }
];
---

<div class="mx-auto max-w-[700px] space-y-3 p-4">
  {faqs.map((faq) => (
    <div class="rounded-3xl border border-white/10 bg-white/5 p-2 backdrop-blur-xl transition-all hover:bg-white/10 shadow-lg">
      
      <button class="glass-faq-btn flex w-full cursor-pointer items-center justify-between p-4 font-bold text-white transition-colors hover:text-yellow-400">
        <span class="text-left text-sm md:text-base">{faq.q}</span>
        
        <span class="icon ml-4 flex h-6 w-6 shrink-0 items-center justify-center text-2xl transition-transform duration-300 ease-in-out">
          +
        </span>
      </button>

      <div class="glass-faq-content grid grid-rows-[0fr] opacity-0 transition-all duration-300 ease-in-out">
        <div class="overflow-hidden">
          <p class="px-4 pb-4 leading-relaxed text-white/60 text-sm md:text-base">
            {faq.a}
          </p>
        </div>
      </div>

    </div>
  ))}
</div>

<script>
  // Script สำหรับสลับเปิด-ปิด FAQ แบบสมูท
  const btns = document.querySelectorAll('.glass-faq-btn');
  
  btns.forEach(btn => {
    btn.addEventListener('click', () => {
      const content = btn.nextElementSibling;
      const icon = btn.querySelector('.icon');

      // ตรวจสอบว่าเปิดอยู่หรือไม่
      const isOpen = content?.classList.contains('grid-rows-[1fr]');

      // ถ้าอยากให้ "เปิดได้ทีละอัน" ให้เอาคอมเมนต์โค้ดด้านล่างนี้ออกครับ
      /*
      document.querySelectorAll('.glass-faq-content').forEach(c => {
        c.classList.replace('grid-rows-[1fr]', 'grid-rows-[0fr]');
        c.classList.replace('opacity-100', 'opacity-0');
      });
      document.querySelectorAll('.glass-faq-btn .icon').forEach(i => {
        i.classList.remove('rotate-45', 'text-red-500');
      });
      */

      // สลับสถานะของตัวที่โดนคลิก
      if (!isOpen) {
        content?.classList.replace('grid-rows-[0fr]', 'grid-rows-[1fr]');
        content?.classList.replace('opacity-0', 'opacity-100');
        icon?.classList.add('rotate-45', 'text-red-500'); // หมุน 45 องศา (กลายเป็นกากบาท) และเปลี่ยนสี
      } else {
        content?.classList.replace('grid-rows-[1fr]', 'grid-rows-[0fr]');
        content?.classList.replace('opacity-100', 'opacity-0');
        icon?.classList.remove('rotate-45', 'text-red-500');
      }
    });
  });
</script>