---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import { pageGraph } from "../lib/schema";

const pageTitle = "เกี่ยวกับเรา VODKAFUN สล็อตเวอร์ชั่นใหม่ รวมเกมครบครันในเว็บเดียว";

const pageHeading = "เกี่ยวกับเรา VODKAFUN สล็อตเวอร์ชั่นใหม่ที่รวมเกมครบครันไว้ในเว็บเดียว";

const pageDescription =
  "เกี่ยวกับ VODKAFUN สล็อตเวอร์ชั่นใหม่ รวมเกมครบครัน สล็อต ยิงปลา กีฬา คาสิโน และหวย ในเว็บเดียว ฝากถอนระบบออโต้ รองรับทรูมันนี่วอเล็ต และช่องทางติดต่อทีมงาน";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});

const linkClass = "font-bold text-[#c8fc04] underline underline-offset-4 transition-colors hover:text-[#e6ff6a]";
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox as="h1" title={pageHeading}>
    <p class="mb-4 text-left text-base leading-relaxed">
      <strong class="text-[#c8fc04]">VODKAFUN</strong> คือเว็บสล็อตเวอร์ชั่นใหม่ที่รวมเกมเดิมพันหลายประเภทไว้ในที่เดียว ทั้งสล็อต ยิงปลา กีฬา คาสิโน และหวย คุณเลือกหมวดที่ชอบได้จากบัญชีสมาชิกเดียวโดยไม่ต้องสมัครแยกตามประเภทเกม
    </p>

    <p class="mb-4 text-left text-base leading-relaxed">
      สิ่งที่เราให้ความสำคัญคือการใช้งานที่ไม่ซับซ้อน ตั้งแต่สมัครสมาชิก เข้าสู่ระบบ ไปจนถึงฝากถอนผ่านระบบออโต้ที่รองรับทรูมันนี่วอเล็ต เพื่อให้คุณใช้เวลากับเกมที่ชอบได้ต่อเนื่อง
    </p>

    <p class="mb-4 text-left text-base leading-relaxed">
      หน้านี้สรุปเรื่องที่ควรรู้ก่อนตัดสินใจใช้งาน ทั้งหมวดเกมที่เปิดให้บริการ วิธีที่ระบบฝากถอนทำงาน การตรวจสอบทางเข้า และช่องทางติดต่อทีมงาน ทุกข้อคุณตรวจสอบได้ด้วยตัวเอง
    </p>

    <p class="text-left text-base leading-relaxed">เว็บที่ดีไม่ได้วัดกันที่จำนวนเกม แต่วัดกันที่คุณหาเกมที่อยากเล่นเจอได้เร็วแค่ไหน และกลับมาหาเจอได้อีกในวันถัดไปโดยไม่ต้องเริ่มค้นใหม่</p>
  </ContentBox>

  <ContentBox as="h2" title="VODKAFUN รวมเกมครบครัน สล็อต ยิงปลา กีฬา คาสิโน และหวย">
    <p class="mb-4 text-left text-base leading-relaxed">
      สล็อตของ VODKAFUN มีทั้งเกมที่เน้นหมุนฟรี เกมที่มีตัวคูณรางวัล และเกมที่มาพร้อมฟีเจอร์โบนัสต่างกัน แต่ละเกมมีกติกาและการจ่ายรางวัลต่างกัน คุณจึงเปรียบเทียบก่อนเลือกเกมที่เหมาะกับงบได้
    </p>

    <p class="mb-4 text-left text-base leading-relaxed">
      นอกจากสล็อตยังมียิงปลาที่เน้นการเลือกเป้าหมาย กีฬาสำหรับคนติดตามการแข่งขัน คาสิโนสำหรับคนชอบเกมโต๊ะ และหวยสำหรับคนสนใจผลรางวัล แต่ละหมวดเล่นไม่เหมือนกัน ควรอ่านกติกาก่อนเริ่มทุกครั้ง
    </p>

    <p class="mb-4 text-left text-base leading-relaxed">
      ลำดับเกมที่แสดงบนหน้าเว็บขยับตามจำนวนคนที่เข้าเล่นในแต่ละช่วง ไม่ได้บอกว่าเกมไหนให้ผลดีกว่ากัน ถ้าอยากดูหน้าเกมก่อนลงเครดิต เริ่มที่หน้า <a href="/ทดลองเล่น/" class={linkClass}>ทดลองเล่น</a> ได้
    </p>

    <p class="text-left text-base leading-relaxed">วันนี้อยากหมุนสล็อต พรุ่งนี้อยากดูบอล วันถัดไปอยากนั่งโต๊ะคาสิโน บัญชีเดียวก็พอ ไม่ต้องจำรหัสผ่านหลายชุดให้ปวดหัว</p>
  </ContentBox>

  <ContentBox as="h2" title="ฝากถอนระบบออโต้ VODKAFUN รองรับทรูมันนี่วอเล็ต">
    <p class="mb-4 text-left text-base leading-relaxed">
      ระบบออโต้เป็นหัวใจของการทำรายการฝากถอนบน VODKAFUN คุณทำรายการเองได้จากหน้าบัญชีผ่านช่องทางที่ระบบเปิดให้บริการ รวมถึงทรูมันนี่วอเล็ต โดยไม่ต้องรอใครกดยืนยันให้
    </p>

    <p class="mb-4 text-left text-base leading-relaxed">
      ก่อนยืนยันทุกครั้ง ตรวจข้อมูลบัญชี จำนวนเงิน และเงื่อนไขการทำรายการให้ถูกต้อง เพราะรายการที่กรอกผิดคือสาเหตุหลักของยอดที่ไม่เข้า ขั้นตอนโดยละเอียดอยู่ที่หน้า <a href="/วิธีฝากถอน/" class={linkClass}>วิธีฝากถอน</a>
    </p>

    <p class="mb-4 text-left text-base leading-relaxed">
      ทุกรายการมีสถานะให้ตรวจสอบในประวัติธุรกรรม หากยอดยังไม่ปรากฏหรือพบรายการผิดปกติ ให้ตรวจประวัติก่อนแล้วติดต่อฝ่ายบริการผ่านช่องทางของ VODKAFUN โดยตรง อย่าโอนซ้ำทันทีถ้ายังไม่ทราบสาเหตุ
    </p>

    <p class="text-left text-base leading-relaxed">ความชัดเจนของรายการสำคัญกว่าความเร็วในการโอน รอให้สถานะเปลี่ยนก่อนหนึ่งนาที ดีกว่าต้องตามเงินสองก้อนทีหลังอีกหลายวัน</p>
  </ContentBox>

  <ContentBox as="h2" title="ทางเข้า VODKAFUN สำหรับสมัครสมาชิกและเข้าสู่ระบบ">
    <p class="mb-4 text-left text-base leading-relaxed">
      สมาชิกใหม่เริ่มที่หน้า <a href="/register/" class={linkClass}>สมัครสมาชิก</a> กรอกข้อมูลตามที่ระบบกำหนดให้ครบ ส่วนสมาชิกเดิมใช้ข้อมูลเดิม <a href="/login/" class={linkClass}>เข้าสู่ระบบ</a> เพื่อกลับไปเลือกเกม ดูรายการฝากถอน หรือตรวจรายละเอียดบัญชีของตัวเอง
    </p>

    <p class="mb-4 text-left text-base leading-relaxed">
      ถ้าบัญชีเดิมยังใช้งานได้ ไม่จำเป็นต้องสมัครใหม่เพียงเพราะทางเข้าเว็บเปลี่ยน ให้ตรวจสอบข้อมูลบัญชีและช่องทางเข้าใช้งานกับผู้ให้บริการก่อน แทนการสมัครซ้ำโดยไม่จำเป็น
    </p>

    <p class="mb-4 text-left text-base leading-relaxed">
      เปิดได้จากมือถือทั้ง iOS และ Android รวมถึงแท็บเล็ตและคอมพิวเตอร์ด้วยบัญชีเดียวกัน หน้าเว็บเป็นภาษาไทยทั้งหมด เมนูอ่านง่าย ไม่ต้องติดตั้งโปรแกรมเพิ่ม
    </p>

    <p class="text-left text-base leading-relaxed">บัญชีเดียวที่จำได้ ดีกว่าหลายบัญชีที่จำไม่ได้สักอัน ยิ่งสมัครซ้ำบ่อย ประวัติรายการและโปรโมชั่นที่รับไว้ก็ยิ่งกระจัดกระจาย</p>
  </ContentBox>

  <ContentBox as="h2" title="ตรวจสอบทางเข้า VODKAFUN ให้ถูกต้องก่อนใช้บัญชีสมาชิก">
    <p class="mb-4 text-left text-base leading-relaxed">
      ก่อนเข้าสู่ระบบ ตรวจชื่อเว็บไซต์และ URL ให้ตรงกับช่องทางที่แบรนด์ประกาศ ลิงก์จากผลการค้นหา ข้อความแชต หรือโฆษณา อาจไม่ได้เชื่อมกับระบบสมาชิกเดียวกัน เห็นแค่ชื่อหรือโลโก้ยังยืนยันไม่ได้
    </p>

    <p class="mb-4 text-left text-base leading-relaxed">
      หากเข้าเว็บผิดแห่ง อาจใช้บัญชีเดิมไม่ได้ ข้อมูลรายการไม่ตรง หรือเสี่ยงเปิดเผยข้อมูลส่วนตัวให้คนที่ไม่เกี่ยวข้อง ใช้ทางเข้าที่ตรวจสอบได้ และยืนยันช่องทางก่อนกรอกข้อมูลสำคัญทุกครั้ง
    </p>

    <p class="mb-4 text-left text-base leading-relaxed">
      รหัสผ่านและรหัส OTP เป็นของคุณคนเดียว ไม่ควรส่งให้ใครไม่ว่าอีกฝ่ายจะอ้างว่าเป็นใครก็ตาม ทีมงานจริงไม่มีเหตุต้องขอข้อมูลสองอย่างนี้จากคุณ
    </p>

    <p class="text-left text-base leading-relaxed">URL ที่ถูกต้องเป็นด่านแรก รหัสที่เก็บไว้กับตัวเป็นด่านสุดท้าย ผ่านสองด่านนี้ได้ ปัญหาเรื่องบัญชีส่วนใหญ่ก็ไม่เกิดตั้งแต่ต้น</p>
  </ContentBox>

  <ContentBox as="h2" title="ช่องทางติดต่อทีมงาน VODKAFUN">
    <p class="mb-4 text-left text-base leading-relaxed">
      มีข้อสงสัยเรื่องสมัครสมาชิก เข้าสู่ระบบ หรือรายการฝากถอน ติดต่อทีมงานได้ทาง <a href="/line/" class={linkClass}>LINE Official</a> หรือดูช่องทางทั้งหมดที่หน้า <a href="/contact-us/" class={linkClass}>ติดต่อเรา</a> ทีมงานพร้อมช่วยตรวจสอบให้
    </p>

    <p class="mb-4 text-left text-base leading-relaxed">
      แจ้งปัญหาพร้อมเวลาที่ทำรายการและยอดเงินจะช่วยให้ตรวจสอบได้เร็วขึ้น และใช้เฉพาะช่องทางที่ยืนยันได้ว่าเป็นของ VODKAFUN จริง เพราะช่องทางปลอมมักเริ่มจากการขอข้อมูลที่ทีมงานจริงไม่มีทางถาม
    </p>

    <p class="mb-4 text-left text-base leading-relaxed">
      รายละเอียดบางอย่าง เช่น ช่องทางชำระเงิน เกมที่เปิดให้บริการ หรือเงื่อนไขสมาชิก อาจเปลี่ยนตามช่วงเวลา ให้ยึดข้อมูลปัจจุบันในเว็บไซต์เป็นหลักก่อนดำเนินการ
    </p>

    <p class="text-left text-base leading-relaxed">ถามก่อนทำหนึ่งครั้ง ประหยัดเวลาตามแก้ทีหลังหลายรอบ ทีมงานตอบคำถามเรื่องขั้นตอนได้ แต่แก้รายการที่โอนผิดบัญชีไปแล้วไม่ได้</p>
  </ContentBox>

  <Navfoot />
</MainLayout>
