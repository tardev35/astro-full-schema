---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#6b2f0b] bg-[#241004]/92 p-8 text-left text-base leading-relaxed text-[#f8e3d2] shadow-[0_10px_30px_rgba(249,115,22,0.16)] transition-all duration-500 hover:border-[#f97316]/60 hover:shadow-[0_15px_40px_rgba(249,115,22,0.26)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#f97316]/20 blur-[60px] transition-all duration-500 group-hover:bg-[#fb923c]/28"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#fbbf24]/16 blur-[60px] transition-all duration-500 group-hover:bg-[#fcd34d]/24"></div>

    {
      title && (
        <header class="mb-6 flex items-center gap-4 border-b border-[#6b2f0b] pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#f97316] to-[#fbbf24] shadow-[0_0_10px_rgba(249,115,22,0.45)]" />
          <HeadingTag class="bg-gradient-to-r from-[#fb923c] via-[#fcd34d] to-[#fbbf24] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
