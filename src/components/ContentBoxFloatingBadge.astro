---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-xl sm:text-2xl md:text-3xl" : "text-lg sm:text-xl md:text-2xl";
---

<section class="my-10 flex w-full justify-center px-4 font-sans">
  <div
    class="relative isolate w-full max-w-[1400px] rounded-2xl border-2 border-[#2e8bff]/35 bg-gradient-to-b from-[#04173f]/95 to-[#010817]/95 p-8 pt-36 text-left text-base leading-relaxed text-[#dbeafe] shadow-[0_10px_30px_rgba(46,139,255,0.22)] md:pt-32">
    <div aria-hidden="true" class="pointer-events-none absolute -top-16 -right-10 -z-10 h-40 w-40 rounded-full bg-[#2e8bff]/30 blur-[60px]"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -bottom-16 -left-10 -z-10 h-40 w-40 rounded-full bg-[#cd994e]/45 blur-[60px]"></div>

    {
      title && (
        <div class="absolute -top-6 left-1/2 flex w-[92%] max-w-2xl -translate-x-1/2 items-center justify-center gap-2 rounded-lg border-2 border-[#ffd93d]/45 bg-[#062459] px-4 py-2.5 text-center shadow-[0_10px_30px_rgba(255,217,61,0.26)] sm:px-8">
          <span aria-hidden="true" class="shrink-0 text-[#5aa9ff]">
            ✦
          </span>
          <HeadingTag class={`min-w-0 bg-gradient-to-r from-[#ffe98a] via-[#ffd93d] to-[#5aa9ff] bg-clip-text ${headingSize} leading-normal font-black tracking-tight text-transparent uppercase`}>
            {title}
          </HeadingTag>
          <span aria-hidden="true" class="shrink-0 text-[#5aa9ff]">
            ✦
          </span>
        </div>
      )
    }

    <slot />
  </div>
</section>
