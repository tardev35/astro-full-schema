---
export interface Props {
  titleleft?: string;
  titleright?: string;
  label?: string;
}
const { titleleft, titleright, label } = Astro.props;

const sectionLabel = label ?? titleleft ?? titleright ?? "ข้อมูลประกอบ";
---

<section aria-label={sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f9dcec]">
      {
        titleleft && (
          <p class="flex items-center gap-3 border-b border-[#a4126b]/60 pb-3 text-xl leading-normal font-black tracking-widest text-[#ff2d8f] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#ff2d8f]/40 bg-gradient-to-br from-[#ffa6d5] via-[#ff2d8f] to-[#c2185b] text-sm text-[#0d0207] shadow-[0_5px_15px_rgba(255,45,143,0.35)]">
              🔐
            </span>
            {titleleft}
          </p>
        )
      }
      <slot name="left" />
    </article>

    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f9dcec]">
      {
        titleright && (
          <p class="flex items-center gap-3 border-b border-[#a4126b]/60 pb-3 text-xl leading-normal font-black tracking-widest text-[#ff2d8f] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#ff6bb5]/60 bg-gradient-to-br from-[#ff6bb5] via-[#a4126b] to-[#8f0f52] text-sm text-[#f9dcec] shadow-[0_5px_15px_rgba(164,18,107,0.40)]">
              📊
            </span>
            {titleright}
          </p>
        )
      }
      <slot name="right" />
    </article>
  </div>
</section>
