---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
---

<section class="my-3 flex w-full justify-center px-4">
  <div
    class="from-red-1000 bg-red-gold-oklab w-full max-w-7xl rounded-[15px] border-2 border-[#dba100] p-8 text-center shadow-2xl"
    style="box-shadow: 0 0 14px rgba(48, 0, 36, 0.65), inset 0 0 12px rgba(49, 1, 31, 0.35)">
    {
      title && (
        <header class="mb-6">
          <HeadingTag class="text-3xl font-bold text-[#ffd700] drop-shadow-md">{title}</HeadingTag>
        </header>
      )
    }

    <div class="text-lg leading-relaxed text-white">
      <slot />
    </div>
  </div>
</section>

<style>
  .bg-red-gold-oklab {
    background-image: linear-gradient(in oklab to right, #000000, #755c00cf, #000000);
  }
</style>
