---
import { Picture } from "astro:assets";

import slide1 from "../assets/slide1.png";
import slide4 from "../assets/slide4.png";

const images = [
  {
    src: slide1,
    alt: "ภาพโปรโมชั่น ONEHENG89 โทนขาว น้ำเงิน และเขียว ด้านบนเป็นโลโก้ ONEHENG89 ถัดลงมาเป็นตัวอักษรขนาดใหญ่ว่า แนะนำสมาชิกวันนี้ มีแต่ได้กับได้ พร้อมบรรทัดเขียนว่า โบนัสแนะนำสมาชิก 0.3% และ สะสมนานสูงสุด 1 เดือน ด้านขวาเป็นพรีเซนเตอร์หญิงสวมชุดกีฬาสีขาวสลับน้ำเงิน รอบภาพมีป้ายสี่เหลี่ยมเขียนว่า เว็บสล็อตโบนัสไหล เกมลิขสิทธิ์แท้ ระบบออโต้ 24 ชม. แนะนำง่ายได้ทุกคน ยิ่งเล่นเยอะยิ่งได้เยอะ และ มั่นคง ปลอดภัย 100%",
  },
  {
    src: slide4,
    alt: "ภาพโปรโมชั่น ONEHENG89 โทนน้ำเงินสลับขาว ด้านบนเป็นตัวอักษรขนาดใหญ่ว่า ฝาก 100 รับ 50 ถัดลงมาเขียนว่า ทำยอด 750 ถอนได้ 500 และ เดิมพันได้เฉพาะค่าย PG และ JILI เท่านั้น พร้อมบรรทัดเล็กว่า เงื่อนไขเป็นไปตามที่กำหนด ด้านซ้ายเป็นพรีเซนเตอร์หญิงสวมชุดสีน้ำเงินยืนคู่กับตัวการ์ตูนเพนกวินของค่าย PG ด้านขวาเป็นการ์ดไลน์เขียนว่า @one89 รอบภาพมีป้ายเขียนว่า ค่ายเกมดัง เล่นง่าย ถอนได้ไว ปลอดภัย 100% และ บริการ 24 ชม.",
  },
];

const COPIES = 3;
const slides = Array.from({ length: COPIES }, () => images).flat();
---

<div class="marquee mx-auto w-full max-w-7xl overflow-hidden px-4 py-5">
  <input id="carousel-pause" type="checkbox" class="peer sr-only" />
  <label
    for="carousel-pause"
    class="sr-only cursor-pointer peer-focus-visible:not-sr-only peer-focus-visible:mb-3 peer-focus-visible:inline-block peer-focus-visible:rounded-full peer-focus-visible:border peer-focus-visible:border-[#0b3fb8]/50 peer-focus-visible:bg-white peer-focus-visible:px-4 peer-focus-visible:py-2 peer-focus-visible:text-sm peer-focus-visible:font-bold peer-focus-visible:text-[#062c85]">
    หยุด / เล่นสไลด์ภาพ
  </label>

  <div class="marquee-track flex">
    {
      slides.map((slide, index) => {
        const isDuplicate = index >= images.length;
        return (
          <div class="marquee-slide" aria-hidden={isDuplicate ? "true" : undefined}>
            <Picture
              src={slide.src}
              alt={isDuplicate ? "" : slide.alt}
              class="block w-full rounded-xl border border-[#c7dcfb] object-cover shadow-[0_10px_30px_rgba(11,63,184,0.14)]"
              width={slide.src.width}
              height={slide.src.height}
              loading="lazy"
              fetchpriority="low"
              decoding="async"
              widths={[300, 360, 420, 480, 540, 600]}
              sizes="(max-width: 767px) calc(100vw - 32px), (max-width: 1279px) calc((100vw - 48px) / 2), 403px"
              formats={["avif", "webp"]}
              fallbackFormat="webp"
              quality={60}
            />
          </div>
        );
      })
    }
  </div>
</div>

<style>
  .marquee {
    --gap: 12px;
    --per-view: 1;
    --shift: calc(-200% - 24px);
  }

  @media (min-width: 768px) {
    .marquee {
      --gap: 16px;
      --per-view: 2;
      --shift: calc(-100% - 16px);
    }
  }

  @media (min-width: 1280px) {
    .marquee {
      --gap: 20px;
      --per-view: 3;
      --shift: calc(-66.6667% - 13.3333px);
    }
  }

  .marquee-track {
    gap: var(--gap);
    width: 100%;
    animation: carousel-scroll 24s linear infinite;
    will-change: transform;
  }

  .marquee-slide {
    flex: 0 0 calc((100% - (var(--per-view) - 1) * var(--gap)) / var(--per-view));
  }

  @keyframes carousel-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(var(--shift));
    }
  }

  .marquee:hover .marquee-track,
  .marquee:focus-within .marquee-track,
  .marquee > input:checked ~ .marquee-track {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
    }
  }
</style>
