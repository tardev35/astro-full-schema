---
const { message = "🦅 999LORD รีวิวเว็บสล็อตเว็บตรง สล็อตทุกค่าย ระบบออโต้ ฝาก-ถอนอัตโนมัติ รวดเร็ว ปลอดภัย มาตรฐาน SSL ทางเข้าอัปเดตล่าสุด www.999lord-review.com" } = Astro.props;
---

<div class="mx-auto mt-6 max-w-[900px] px-2 md:px-0">
  <div class="relative flex h-[40px] items-center rounded-sm border-b-2 border-blue-500 bg-[#050d16] shadow-[0_2px_10px_rgba(0,0,0,0.8)]">
    <div class="absolute -top-3 left-4 flex items-center gap-1.5 rounded-sm bg-red-600 px-3 py-0.5 shadow-[0_4px_10px_rgba(239,68,68,0.5)]">
      <div class="h-2 w-2 animate-pulse rounded-full bg-white"></div>
      <span class="text-[10px] font-black tracking-widest text-white md:text-xs">LIVE UPDATE</span>
    </div>

    <div class="ml-32 flex-1 overflow-hidden md:ml-40">
      <div class="flex w-max animate-[scroll_22s_linear_infinite] gap-12 text-sm font-medium whitespace-nowrap text-white/90">
        <span>{message}</span>
        <span>{message}</span>
      </div>
    </div>
  </div>
</div>

<style>
  @keyframes scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(calc(-50% - 24px));
    }
  }
</style>
