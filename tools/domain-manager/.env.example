# Copy this file to ".env" (same folder) and fill in the real password.
# .env is gitignored — the password must NEVER be committed.
#
# This lets a machine with no SSH key to the hosting server add domains using
# the server's password instead.

VPS_HOST=45.32.122.181
VPS_USER=root
VPS_PASSWORD=changeme

# The aaPanel server is a different machine, so it gets its own keys rather than
# reusing the ones above. It authenticates with an SSH key, which the uploader
# looks for at ~/.ssh/id_ed25519 then ~/.ssh/id_rsa — so on a machine that has
# the key, none of the three lines below are needed at all.
#
# Set AAPANEL_PASSWORD only on a machine with no key. Set AAPANEL_KEY only if
# the key lives somewhere other than the two default paths.
# AAPANEL_HOST=187.52.122.249
# AAPANEL_USER=root
# AAPANEL_KEY=
# AAPANEL_KEY_PASSPHRASE=
# AAPANEL_PASSWORD=

# Optional overrides:
# PORT=3000
# HOST=127.0.0.1
