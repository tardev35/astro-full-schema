---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";

import { Picture } from "astro:assets";
import { itemList, pageGraph, schemaCtx } from "../lib/schema";
import image1 from "../assets/gamedemo7.webp";
import image2 from "../assets/gamedemo8.webp";
import image3 from "../assets/gamedemo9.webp";
import image4 from "../assets/gamedemo10.webp";
import image5 from "../assets/gamedemo11.webp";
import image6 from "../assets/gamedemo12.webp";
import image7 from "../assets/gamedemo13.webp";
import image8 from "../assets/gamedemo14.webp";
import image9 from "../assets/gamedemo15.webp";
import image10 from "../assets/gamedemo16.webp";
import image11 from "../assets/gamedemo17.webp";
import image12 from "../assets/gamedemo18.webp";

const demoGames = [
  { name: "AskmeSlot", src: image1, alt: "แบนเนอร์ค่าย askmeslot โลโก้โพดำสีทองที่มีสัญลักษณ์ไพ่อยู่ข้างใน คู่กับตัวการ์ตูนเด็กชายสวมหมวกแดงติดดาว กางแขนวิ่งบนถนนในเมืองยุโรปที่มีกังหันลม" },
  { name: "Popular Game", src: image2, alt: "แบนเนอร์ Popular Game ตัวอักษรทองนูนหน้าวงแหวนชิปคาสิโนสีทอง ขนาบด้วยกระต่ายถือหีบสมบัติกับแมวใส่แว่นกันแดด ท่ามกลางเหรียญทองและชิปที่ลอยฟุ้ง" },
  { name: "SlotXO", src: image3, alt: "แบนเนอร์ค่าย SLOTXO โลโก้ตู้สล็อตล้อมด้วยเหรียญทอง คู่กับนักรบโรมันผมขาวสวมมงกุฎใบลอเรลและเกราะทอง ยืนหน้าโคลอสเซียมกับทหารอีกสองนาย" },
  { name: "Skywind Group", src: image4, alt: "แบนเนอร์ค่าย Skywind Group โลโก้วงกลมสี่สีบนพื้นดำ คู่กับแมวกวักนำโชคสีขาวคาดกระพรวนทอง ยืนข้างไหทองและถุงเงินสีม่วงใต้ต้นซากุระ" },
  { name: "PG Soft", src: image5, alt: "แบนเนอร์ค่าย PG Pocket Games Soft โลโก้ตัวอักษรพิกเซลบนพื้นดำ คู่กับตัวละครหญิงนักรบผิวแทนสวมเครื่องประดับทองและหมวกขนนกสไตล์แอซเท็ก" },
  { name: "SBOBET", src: image6, alt: "แบนเนอร์ค่ายเกม SBOBET โลโก้ตัวอักษรขาวบนพื้นดำ คู่กับตัวการ์ตูนอนิเมะสาวหูจิ้งจอกผมบลอนด์ในชุดกิโมโนสีชมพู มือถืออมยิ้มเกลียวหลากสี" },
  { name: "Sexy Slot", src: image7, alt: "แบนเนอร์ค่าย Sexy Slot ตัวอักษรสีชมพูม่วงมีประกายวิบวับ คู่กับตัวการ์ตูนสาวผมน้ำตาลในชุดรัดรูปสีม่วง นั่งอยู่ในกรอบวงกลมที่ล้อมด้วยหัวใจสีชมพู" },
  { name: "JILI", src: image8, alt: "แบนเนอร์ค่ายเกม JILI ตัวอักษรทองบนพื้นดำ คู่กับนางเงือกผมแดงสวมเกราะเปลือกหอยสีทอง ยกหอยสังข์แนบหูอยู่ใต้ทะเลที่มีปลาการ์ตูนและปะการัง" },
  { name: "Ask Me Bet", src: image9, alt: "แบนเนอร์ค่ายเกม ask me bet โลโก้สามช่องสีขาวเขียวเหลืองบนพื้นดำ คู่กับหัวสิงโตเชิดสีแดงทองตาโต ใต้แถวโคมไฟสีแดงหน้าศาลเจ้า" },
  { name: "New Game", src: image10, alt: "แบนเนอร์ New Game ตัวอักษรสีขาวนูนกลางภาพ ขนาบด้วยตัวการ์ตูนฟักทองหัวไฟกับโครงกระดูกยิ้ม ยืนบนฟลอร์นีออนสีชมพูฟ้าที่เกลื่อนด้วยชิปและลูกเต๋า" },
  { name: "JOKER", src: image11, alt: "แบนเนอร์ค่ายเกม JOKER ตัวอักษรขาวทองบนพื้นดำ คู่กับนักรบโรมันสวมหมวกเหล็กติดขนนกและถือโล่ ยืนเคียงสิงโตกำลังคำรามกลางสนามประลอง" },
  { name: "AFB Gaming", src: image12, alt: "แบนเนอร์ค่ายเกม AFB Gaming โลโก้ตัวอักษรทองบนพื้นดำ คู่กับเทพซุสเคราขาวตาเรืองแสงสีฟ้า สวมมงกุฎใบลอเรลและกำไลทองหน้าวิหารกรีก" },
];

const gameList = demoGames.map((game) => ({ name: game.name, imagePath: game.src.src }));

const pageTitle = "ทดลองเล่นสล็อต GGHENG";

const pageHeading = "ทดลองเล่นสล็อต GGHENG เลือกค่ายที่ชอบ ลองให้พอใจก่อนลงเครดิตจริง";

const pageDescription =
  "ทดลองเล่น GGHENG สล็อตเว็บตรงสายเฮง รวมโหมดทดลองจากค่ายดังอย่าง PG SOFT, Pragmatic Play และ Joker Gaming เลือกค่ายที่ชอบ เปิดยูสเดียวแล้วลองจนพอใจก่อนเล่นจริง";

const ctx = schemaCtx(Astro);
const graph = pageGraph(Astro, {
  type: "CollectionPage",
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  ],
  extra: [
    itemList(ctx, {
      name: "ทดลองเล่นเกมของ GGHENG",
      alternateName: "GGHENG โหมดทดลองเล่นเกมสล็อตหลายค่ายบนมือถือ ก่อนใช้เครดิตจริงด้วยยูสเซอร์เดียว",
      itemType: "Game",
      items: gameList,
    }),
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox as="h1" title={pageHeading}>
    <p class="mb-4 text-left text-base leading-relaxed">
      หากคุณกำลังมองหาที่ลองเกมให้ชัดก่อนลงเครดิตจริง <strong class="text-[#ffdf80]">GGHENG</strong> สล็อตเว็บตรงสายเฮง พร้อมมอบโหมดทดลองจากค่ายที่เปิดอยู่ในระบบ เพื่อให้คุณรู้จักจังหวะของเกมก่อนตัดสินใจ
    </p>
    <p class="mb-4 text-left text-base leading-relaxed">
      ขั้นตอนสั้นกว่าที่คิด เลือกค่ายที่สะดุดตาจากด้านล่าง กดที่ภาพเพื่อเปิดยูสก่อนหนึ่งครั้ง จากนั้นเข้าโหมดทดลองของค่ายนั้นต่อได้เลยจากหน้าสมาชิก
    </p>
    <p class="text-left text-base leading-relaxed">
      เปิดจากมือถือ ไอแพด หรือคอมพิวเตอร์ก็เหมือนกัน ใช้ยูสเซอร์เดิมได้ทุกเครื่อง ไม่ต้องโหลดแอปให้รกเครื่องและไม่ต้องจำรหัสหลายชุด
    </p>
  </ContentBox>

  <ContentBox as="h2" title="เลือกค่ายที่ถูกใจ แล้วเปิดยูส GGHENG ยูสเดียวลองได้ทุกค่าย">
    <p class="mb-4 text-left text-base leading-relaxed">
      ค่ายไหนถูกตาเริ่มจากค่ายนั้นได้เลยครับ เพราะแต่ละค่ายวางจังหวะและฟีเจอร์ไว้ไม่เหมือนกัน ทั้งสล็อตหมุนคลาสสิก เกมฟรีสปิน และเกมโบนัสหลายชั้น ทุกเกมเป็นลิขสิทธิ์แท้จากค่ายโดยตรง
    </p>
    <p class="mb-4 text-left text-base leading-relaxed">
      ปุ่มบนภาพเขียนว่าสมัครเพื่อลอง เพราะมันพาไปที่ขั้นตอนเปิดยูสก่อน พอได้ยูสแล้วค่อยเข้าโหมดทดลองของค่ายนั้นต่อในหน้าสมาชิกเดียวกัน
    </p>
    <p class="mb-8 text-left text-base leading-relaxed">
      GGHENG ใช้ระบบแท้100% ยูสเซอร์เดียวสลับได้ทุกค่าย ไม่ต้องเปิดบัญชีใหม่ทีละค่าย ความเฮงจะมาจากเกมไหนก็ไม่ต้องเสียจังหวะตอนกำลังสนุก
    </p>
    <div class="mb-5 grid grid-cols-2 gap-5 sm:grid-cols-2 md:grid-cols-4">
      {
        demoGames.map((game) => (
          <div class="group/game relative mx-auto w-full max-w-[400px] overflow-hidden rounded-xl border border-[#5c0b13]">
            <Picture
              src={game.src}
              alt={game.alt}
              loading="lazy"
              fetchpriority="low"
              widths={[200, 400, 600]}
              sizes="(max-width: 768px) 50vw, 25vw"
              class="block h-auto w-full object-cover shadow-[0_10px_30px_rgba(245,197,66,0.18)] transition-transform duration-300 group-hover/game:scale-105"
              decoding="async"
              formats={["avif", "webp"]}
              fallbackFormat="webp"
              quality={60}
            />
            <a
              href="/register/"
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`สมัครสมาชิกเพื่อลองเล่น ${game.name} ที่ GGHENG`}
              class="absolute inset-0 flex items-center justify-center bg-[#140202]/85 opacity-0 transition-opacity duration-300 group-hover/game:opacity-100 focus-visible:opacity-100">
              <span class="rounded-full border border-[#8a6208]/60 bg-gradient-to-r from-[#ffe9a3] via-[#f5c542] to-[#c8901a] px-6 py-2 font-bold text-[#2a0203] shadow-[0_10px_30px_rgba(245,197,66,0.35)] transition-transform hover:scale-110">สมัครเพื่อลอง</span>
            </a>
          </div>
        ))
      }
    </div>
  </ContentBox>

  <ContentBox as="h2" title="ลองให้พอใจในโหมดทดลอง แล้วค่อยตัดสินใจลงเครดิตจริง">
    <p class="mb-4 text-left text-base leading-relaxed">
      เข้าโหมดทดลองแล้วหมุนได้ไม่จำกัดรอบ เพราะเป็นเครดิตสมมติล้วน ๆ อยากลองผิดลองถูกกี่ครั้งก็ตามสบาย ไม่มีอะไรต้องเสี่ยงสักบาท
    </p>
    <p class="mb-4 text-left text-base leading-relaxed">
      ระหว่างลองก็ดูไปด้วยว่าเกมวางสัญลักษณ์ไว้แบบไหน ฟรีสปินกับโบนัสเข้ามาในจังหวะไหน และหนึ่งรอบยาวพอกับที่คุณชอบไหม เก็บไว้เป็นข้อมูลตอนเลือกเกมที่จะเล่นจริง
    </p>
    <p class="mb-4 text-left text-base leading-relaxed">
      เกมบน GGHENG รันด้วยค่า RTP มาตรฐานสากลจากค่ายแม่ ไม่มีการล็อกยูส กลไกที่คุณเห็นในโหมดทดลองจึงเป็นชุดเดียวกับตอนเล่นจริง ต่างกันแค่เครดิตที่ใช้หมุน
    </p>
    <p class="mb-4 text-left text-base leading-relaxed">
      เรื่องที่ต้องบอกให้ชัดตั้งแต่แรก เครดิตในโหมดทดลองถอนไม่ได้ และไม่นับเป็นยอดเทิร์นของโปรโมชั่นใด ๆ ทั้งสิ้น เอาไว้ทำความรู้จักเกมอย่างเดียว
    </p>
    <p class="text-left text-base leading-relaxed">
      อีกอย่างคือไม่ใช่ทุกเกมที่มีปุ่มทดลอง เพราะโหมดนี้ขึ้นอยู่กับผู้ให้บริการแต่ละราย ถ้าเกมที่อยากลองยังไม่เปิดไว้ ทักทีมงานให้ช่วยแนะนำเกมใกล้เคียงได้
    </p>
  </ContentBox>

  <ContentBox as="h2" title="พร้อมเมื่อไหร่ สมัคร GGHENG แล้วเริ่มเล่นจริงได้ทันที ไม่มีขั้นต่ำ">
    <p class="mb-4 text-left text-base leading-relaxed">
      พอเจอเกมที่ใช่แล้ว เริ่มเล่นจริงได้เลยด้วยยูสเซอร์เดิม GGHENG ไม่มีขั้นต่ำ ทุนมากหรือน้อยก็เริ่มได้เท่ากัน จะฝากหลักสิบหรือหลักร้อยก็เข้าเล่นได้ทุกเกม
    </p>
    <p class="mb-4 text-left text-base leading-relaxed">
      ฝากถอนเป็นระบบออโต้ รองรับทั้งบัญชีธนาคารและ True Money Wallet แบบเต็มรูปแบบ ใครไม่สะดวกใช้ธนาคารก็ทำรายการผ่านวอลเล็ตได้ทันที ตรวจสอบได้ทุกยอดธุรกรรม
    </p>
    <p class="mb-4 text-left text-base leading-relaxed">
      เล่นได้แล้วต้องได้ถอน GGHENG จ่ายไม่อั้น ถอนหลักแสนหรือหลักล้านก็โอนครบทุกบาท ไม่มีผ่อนจ่ายและไม่หักค่าธรรมเนียม ส่วนเงื่อนไขของโปรโมชั่นที่ใช้อยู่ อ่านให้จบก่อนกดยืนยันทุกครั้ง
    </p>
    <p class="mb-4 text-left text-base leading-relaxed">
      อีกอย่างที่ควรติดตัวไว้เสมอ อย่าบอกรหัสผ่านหรือรหัส OTP กับใครทั้งนั้น แม้คนนั้นจะอ้างว่าเป็นทีมงานก็ตาม เพราะทีมงานจริงไม่มีเหตุต้องขอ
    </p>
    <p class="text-left text-base leading-relaxed">
      เลือกค่ายที่ถูกใจแล้วเริ่มได้เลยครับ เกมที่คุณคุ้นมือจากโหมดทดลองวันนี้ คือเกมที่พร้อมให้ลงเครดิตจริงในรอบถัดไปแบบไม่ต้องเดา
    </p>
  </ContentBox>

  <Navfoot />
</MainLayout>
