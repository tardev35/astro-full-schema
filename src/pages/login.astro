---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import CtaRedirect from "../components/CtaRedirect.astro";
import { pageGraph } from "../lib/schema";

const pageTitle = "เข้าสู่ระบบ PAYDAY24 | ปุ่มล็อกอินเข้าหน้าเมมเบอร์ สล็อต คาสิโน หวย กีฬา";

const pageDescription =
  "หากคุณกำลังมองหาทางกลับเข้าหน้าเมมเบอร์ที่ไม่ยุ่งยาก PAYDAY24 พร้อมมอบปุ่มเข้าสู่ระบบเพียงปุ่มเดียว เพื่อกลับไปเล่นสล็อต คาสิโนสด หวย และกีฬาด้วยยูสเดิม";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เข้าสู่ระบบ", path: "/login" },
  ],
});

const targetUrl = "https://yoalink.com/22hs";
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="เข้าสู่ระบบ PAYDAY24" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label="เข้าสู่ระบบ PAYDAY24"
        class="group relative mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#a855f7]/70 bg-gradient-to-b from-[#a855f7] to-[#6d28d9] px-6 py-4 text-xl font-bold tracking-wide text-[#f3e9ff] shadow-[0_10px_30px_rgba(168,85,247,0.26)] transition-all duration-300 hover:scale-105 hover:border-[#c98bff] hover:shadow-[0_15px_40px_rgba(168,85,247,0.38)]">
        เข้าสู่ระบบ PAYDAY24
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="เข้าสู่ระบบ" />
</MainLayout>
