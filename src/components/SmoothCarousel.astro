---
import { Picture } from "astro:assets";

import slide1 from "../assets/slide1.png";
import slide2 from "../assets/slide2.png";
import slide3 from "../assets/slide3.png";
import slide4 from "../assets/slide4.png";
import slide5 from "../assets/slide5.png";

const images = [
  {
    src: slide1,
    alt: "โปรโมชั่น BABYSHARK8899 ฝากรับโบนัสเพิ่ม 10% จากทุกยอดบิลฝาก มูลค่าสูงสุด 500 บาท ครอบคลุมสมาชิกเก่าและใหม่ ยอดฝากขั้นต่ำ 100 บาทต่อบิล ทำเทิร์น 8 เท่า ถอนสูงสุด 5 เท่า แจ้งแอดมินได้ตลอด 24 ชั่วโมง",
  },
  {
    src: slide2,
    alt: "โปรโมชั่น BABYSHARK8899 โบนัสฝาก 50% ฝาก 1,000 บาทขึ้นไป รับโบนัส 50% สูงสุด 10,000 บาท ทำเทิร์น 5 เท่า ถอนสูงสุด 2 เท่า",
  },
  {
    src: slide3,
    alt: "BABYSHARK8899 หวย อัตราจ่ายที่ดีที่สุด 3 ตัว บาทละ 1000 และ 2 ตัว บาทละ 100 ถูกตรง จ่ายจริง รับเงินรางวัลหลักล้าน ครบจบเรื่องหวยในเว็บเดียว ทั้งรัฐบาล ลาว ฮานอย หุ้น ยี่กี พรีเซนเตอร์หญิงในแจ็คเก็ตหนังสีดำ",
  },
  {
    src: slide4,
    alt: "BABYSHARK8899 แนะนำเพื่อนรับ 0.8% สร้างรายได้ 100,000 บาทต่อเดือน พรีเซนเตอร์หญิงสองคนในแจ็คเก็ตหนังและกระโปรงสีแดง",
  },
  {
    src: slide5,
    alt: "BABYSHARK8899 คอมมิชชั่น 0.3% คืนทุกยอดเล่นตลอดทั้งวัน เล่นถึง 50% ถอนได้เลย กดรับได้ที่หน้าเว็บ รับสิทธิ์ก่อน 23.59 น. ของทุกวัน ยิ่งเล่นเยอะ ยิ่งได้เยอะ",
  },
];

const COPIES = 3;
const slides = Array.from({ length: COPIES }, () => images).flat();
---

<div class="marquee mx-auto w-full max-w-7xl overflow-hidden px-4 py-5">
  <input id="carousel-pause" type="checkbox" class="peer sr-only" />
  <label
    for="carousel-pause"
    class="sr-only cursor-pointer peer-focus-visible:not-sr-only peer-focus-visible:mb-3 peer-focus-visible:inline-block peer-focus-visible:rounded-full peer-focus-visible:border peer-focus-visible:border-[#0b7cf4]/60 peer-focus-visible:bg-[#041a45] peer-focus-visible:px-4 peer-focus-visible:py-2 peer-focus-visible:text-sm peer-focus-visible:font-bold peer-focus-visible:text-white">
    หยุด / เล่นสไลด์ภาพ
  </label>

  <div class="marquee-track flex">
    {
      slides.map((slide, index) => {
        const isDuplicate = index >= images.length;
        return (
          <div class="marquee-slide" aria-hidden={isDuplicate ? "true" : undefined}>
            <Picture
              src={slide.src}
              alt={isDuplicate ? "" : slide.alt}
              class="block w-full rounded-xl border border-[#1a4a9c] object-cover shadow-[0_10px_30px_rgba(0,0,0,0.35)]"
              width={slide.src.width}
              height={slide.src.height}
              loading="lazy"
              fetchpriority="low"
              decoding="async"
              widths={[300, 360, 420, 480, 540, 600]}
              sizes="(max-width: 767px) calc(100vw - 32px), (max-width: 1279px) calc((100vw - 48px) / 2), 403px"
              formats={["avif", "webp"]}
              fallbackFormat="webp"
              quality={70}
            />
          </div>
        );
      })
    }
  </div>
</div>

<style>
  .marquee {
    --gap: 12px;
    --per-view: 1;
    --shift: calc(-500% - 60px);
    --duration: 40s;
  }

  @media (min-width: 768px) {
    .marquee {
      --gap: 16px;
      --per-view: 2;
      --shift: calc(-250% - 40px);
    }
  }

  @media (min-width: 1280px) {
    .marquee {
      --gap: 20px;
      --per-view: 3;
      --shift: calc(-166.6667% - 33.3333px);
    }
  }

  .marquee-track {
    gap: var(--gap);
    width: 100%;
    animation: carousel-scroll var(--duration) linear infinite;
    will-change: transform;
  }

  .marquee-slide {
    flex: 0 0 calc((100% - (var(--per-view) - 1) * var(--gap)) / var(--per-view));
  }

  @keyframes carousel-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(var(--shift));
    }
  }

  .marquee:hover .marquee-track,
  .marquee:focus-within .marquee-track,
  .marquee > input:checked ~ .marquee-track {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
    }
  }
</style>
