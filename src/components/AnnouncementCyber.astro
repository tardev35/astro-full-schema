---
const {
  message = "DOLLAR789 รวมคาสิโนสด บาคาร่า สล็อต และฟุตบอลไว้ในยูสเดียว เลือกเกมต่อได้จากหน้าเดิม • หน้าสมาชิกรวมเครดิต โปร และประวัติรายการไว้จุดเดียว เช็กสถานะได้เอง • ระบบฝากถอนออโต้ทำรายการได้ตลอด 24 ชั่วโมง ทั้งมือถือและคอมพิวเตอร์ • โปรสมาชิกใหม่ดูยอดรับ เงื่อนไข และเทิร์นได้ก่อนกดรับทุกครั้ง • ทางเข้า DOLLAR789 ใช้ยูสเดิมสลับอุปกรณ์ได้ ไม่ต้องเริ่มใหม่",
} = Astro.props;
---

<div class="mx-auto w-full max-w-7xl px-4 py-3 font-sans">
  <div
    class="relative flex overflow-hidden border border-[#a855f7]/50 bg-[#150826]/90 shadow-[0_0_15px_rgba(168,85,247,0.3)] backdrop-blur-md"
    style="clip-path: polygon(15px 0, 100% 0, calc(100% - 15px) 100%, 0 100%);">
    <div
      class="relative z-10 flex shrink-0 items-center justify-center bg-gradient-to-r from-[#4c1d95] to-[#a855f7] px-6 py-2.5 font-black text-[#0b011b]"
      style="clip-path: polygon(0 0, 100% 0, calc(100% - 10px) 100%, 0 100%);">
      ประกาศ
    </div>

    <div class="marquee-container relative flex-1 overflow-hidden py-2.5 pr-6">
      <div class="pointer-events-none absolute top-0 left-0 z-10 h-full w-8 bg-gradient-to-r from-[#150826] to-transparent"></div>

      <div class="marquee-content inline-block pl-4 text-sm font-bold tracking-widest whitespace-nowrap text-[#e9d5ff]">
        <span class="mr-8 inline-flex items-center gap-2"><span aria-hidden="true" class="h-2 w-2 bg-[#f5c542] shadow-[0_0_8px_rgba(245,197,66,1)]"></span>{message}</span>
        <span class="mr-8 inline-flex items-center gap-2"><span aria-hidden="true" class="h-2 w-2 bg-[#f5c542] shadow-[0_0_8px_rgba(245,197,66,1)]"></span>{message}</span>
      </div>
    </div>
  </div>
</div>

<style>
  .marquee-content {
    animation: marquee 20s linear infinite;
  }
  .marquee-container:hover .marquee-content {
    animation-play-state: paused;
  }
  @keyframes marquee {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee-content {
      animation: none;
    }
  }
</style>
