---
const { message = "🟢 LOTTO432 เว็บหวยอันดับหนึ่ง! ฝาก-ถอน อัตโนมัติ เงินเข้าภายใน 5 นาที จ่ายจริง ถอนจริง เปิดรับเดิมพันตลอด 24 ชั่วโมง!" } = Astro.props;
---

<div class="mx-auto w-full max-w-7xl px-4 py-3 font-sans">
  <div class="relative flex overflow-hidden rounded-md border border-green-500/30 bg-[#032e1f]/80 shadow-[0_0_15px_rgba(34,197,94,0.1)] backdrop-blur-md">
    <div class="relative z-10 flex shrink-0 items-center justify-center bg-gradient-to-r from-yellow-500 to-yellow-400 px-6 py-2 font-black text-[#021c13] shadow-[4px_0_15px_rgba(0,0,0,0.5)]">
      <span class="mr-2 animate-pulse text-lg">📢</span> ประกาศ
    </div>

    <div class="marquee-container relative flex-1 overflow-hidden py-2 pr-6">
      <div class="pointer-events-none absolute top-0 left-0 z-10 h-full w-8 bg-gradient-to-r from-[#032e1f] to-transparent"></div>

      <div class="marquee-content inline-block pl-4 text-sm font-bold tracking-widest whitespace-nowrap text-white/90">
        <span class="mr-8 inline-flex items-center gap-2"><span class="h-2 w-2 rounded-full bg-green-400 shadow-[0_0_8px_rgba(74,222,128,0.8)]"></span>{message}</span>
        <span class="mr-8 inline-flex items-center gap-2"><span class="h-2 w-2 rounded-full bg-green-400 shadow-[0_0_8px_rgba(74,222,128,0.8)]"></span>{message}</span>
      </div>
    </div>
  </div>
</div>

<style>
  .font-sans {
    font-family: "Kanit", sans-serif;
  }
  .marquee-content {
    animation: marquee 20s linear infinite;
  }
  .marquee-container:hover .marquee-content {
    animation-play-state: paused;
  }
  @keyframes marquee {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }
</style>
