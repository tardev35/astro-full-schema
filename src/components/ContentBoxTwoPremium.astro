---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#a06a09]/55 bg-[#160e03] p-8 text-[#f4e8d2] shadow-[0_10px_30px_rgba(254,201,58,0.14)] transition-all duration-500 hover:border-[#fec93a]/70 hover:shadow-[0_15px_40px_rgba(254,201,58,0.24)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 bg-gradient-to-br from-[#33220a] to-transparent opacity-70"></div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#a06a09]/40 pb-4">
          <span aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#fec93a] via-[#ffe9a8] to-[#c9ccd4] shadow-[0_0_10px_rgba(254,201,58,0.45)]" />
          <HeadingTag class="bg-gradient-to-r from-[#ffe9a8] via-[#fec93a] to-[#d4840e] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-10 md:grid-cols-2">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f4e8d2]">
        {
          titleleft && (
            <p class="flex items-center gap-3 border-b border-[#a06a09]/40 pb-3 text-xl leading-normal font-black tracking-widest text-[#ffe9a8] uppercase">
              <span aria-hidden="true" class="h-6 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#fec93a] to-[#c9ccd4] shadow-[0_0_10px_rgba(254,201,58,0.45)]" />
              {titleleft}
            </p>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f4e8d2] md:border-l md:border-[#a06a09]/40 md:pl-10">
        {
          titleright && (
            <p class="flex items-center gap-3 border-b border-[#a06a09]/40 pb-3 text-xl leading-normal font-black tracking-widest text-[#ffe9a8] uppercase">
              <span aria-hidden="true" class="h-6 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#c9ccd4] to-[#fec93a] shadow-[0_0_10px_rgba(201,204,212,0.45)]" />
              {titleright}
            </p>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
