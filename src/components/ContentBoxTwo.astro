---
export interface Props {
  titleleft?: string;
  titleright?: string;
  label?: string;
}
const { titleleft, titleright, label } = Astro.props;

const sectionLabel = label ?? titleleft ?? titleright ?? "ข้อมูลประกอบ";
---

<section aria-label={sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f2ddc4]">
      {
        titleleft && (
          <p class="flex items-center gap-3 border-b border-[#9c724a]/35 pb-3 text-xl leading-normal font-black tracking-widest text-[#e9b949] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#e9b949]/40 bg-gradient-to-br from-[#f8dc9a] via-[#e9b949] to-[#a81f1a] text-sm text-[#140604] shadow-[0_5px_15px_rgba(168,31,26,0.35)]">
              🔐
            </span>
            {titleleft}
          </p>
        )
      }
      <slot name="left" />
    </article>

    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f2ddc4]">
      {
        titleright && (
          <p class="flex items-center gap-3 border-b border-[#9c724a]/35 pb-3 text-xl leading-normal font-black tracking-widest text-[#e9b949] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#9c724a]/60 bg-gradient-to-br from-[#f8dc9a] via-[#e9b949] to-[#9c724a] text-sm text-[#140604] shadow-[0_5px_15px_rgba(233,185,73,0.35)]">
              🎰
            </span>
            {titleright}
          </p>
        )
      }
      <slot name="right" />
    </article>
  </div>
</section>
