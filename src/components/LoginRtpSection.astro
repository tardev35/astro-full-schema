---
import ContentBoxTwo from "./ContentBoxTwo.astro";

const steps = [
  { icon: "🔑", name: "เข้าสู่ระบบด้วยยูสเดิม", detail: "ใช้เบอร์โทรศัพท์หรือยูสเซอร์เนมที่สมัครไว้ เข้าได้ทั้งจากมือถือและคอม", tag: "ขั้นที่ 1" },
  { icon: "🎰", name: "เลือกหมวดเกมสล็อตที่อยากเล่น", detail: "ไล่ดูหมวดที่เปิดอยู่ก่อน แล้วค่อยเลือกเกมที่จังหวะตรงกับสไตล์ของตัวเอง", tag: "ขั้นที่ 2" },
  { icon: "🌀", name: "เปลี่ยนเกมด้วยเครดิตชุดเดิม", detail: "สลับจากวงล้อคลาสสิกไปเกมฟรีสปินกลางทางได้ ไม่ต้องออกจากระบบหรือเปิดยูสใหม่", tag: "ขั้นที่ 3" },
  { icon: "🎁", name: "เช็กโปรโมชั่นที่เปิดอยู่", detail: "ดูยอดรับ เงื่อนไข เทิร์น และช่วงเวลาที่ใช้ได้จากหน้าเมมเบอร์ก่อนกดรับ", tag: "ขั้นที่ 4" },
  { icon: "💳", name: "ฝากถอนออโต้และย้อนดูประวัติ", detail: "ส่งรายการฝากเข้าถอนออกจากหน้าเดิม แล้วเช็กสถานะรายการของตัวเองได้เอง", tag: "ขั้นที่ 5" },
];

const chips = ["สล็อตเว็บตรง", "ฟรีสปิน", "เกมโบนัส", "ไม่ติดเทิร์น", "ฝากถอนออโต้", "สมัครง่าย", "ยูสเดียว"];
---

<ContentBoxTwo titleleft="เข้าสู่ระบบ WON22" titleright="ลำดับการใช้งานบนหน้าเมมเบอร์" label="เข้าสู่ระบบ WON22 และลำดับการใช้งานบนหน้าเมมเบอร์">
  <div slot="left" class="flex h-full flex-col gap-4">
    <div class="relative overflow-hidden rounded-2xl border border-[#6b2f0b] bg-[#241004] p-6 shadow-[0_10px_30px_rgba(249,115,22,0.18)]">
      <div aria-hidden="true" class="pointer-events-none absolute -top-10 -right-10 h-32 w-32 rounded-full bg-[#f97316]/20 blur-[50px]"></div>

      <div class="relative z-10 mb-5 flex items-center gap-3">
        <span
          aria-hidden="true"
          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#6b2f0b] bg-gradient-to-br from-[#fb923c] via-[#f97316] to-[#9a3412] text-xl shadow-inner">
          🎰
        </span>
        <div class="flex flex-col">
          <p class="text-base font-black text-[#fcd34d]">เข้าสู่ระบบแล้วเลือกหมวดเกมสล็อตที่อยากเล่นต่อได้ทันที</p>
          <span class="text-[11px] text-[#dcb99a]">ยูสเดียวใช้เข้าได้ทั้งสล็อตคลาสสิก เกมฟรีสปิน และเกมโบนัส เช็กเครดิต ดูโปร และย้อนดูประวัติรายการของ WON22 ได้จากหน้าเดียว</span>
        </div>
      </div>

      <div class="relative z-10 flex flex-col gap-3.5">
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#fb923c]">👤</span>
          <input
            type="text"
            placeholder="เบอร์โทรศัพท์ / ยูสเซอร์เนม"
            class="w-full rounded-xl border border-[#6b2f0b] bg-[#180a03] py-3 pr-4 pl-12 text-[#f8e3d2] transition-all outline-none placeholder:text-[#dcb99a] focus:border-[#f97316] focus:ring-1 focus:ring-[#f97316]/40"
          />
        </div>
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#fb923c]">🔑</span>
          <input
            type="password"
            placeholder="รหัส PIN 4 หลัก"
            class="w-full rounded-xl border border-[#6b2f0b] bg-[#180a03] py-3 pr-4 pl-12 text-[#f8e3d2] transition-all outline-none placeholder:text-[#dcb99a] focus:border-[#f97316] focus:ring-1 focus:ring-[#f97316]/40"
          />
        </div>

        <div class="flex items-center justify-between px-1 text-xs">
          <label class="flex items-center gap-2 text-[#dcb99a]">
            <input type="checkbox" class="h-3.5 w-3.5 rounded border-[#6b2f0b] bg-[#180a03] accent-[#f97316]" />
            จดจำฉันไว้
          </label>
          <a href="/login" class="text-[#dcb99a] transition-colors hover:text-[#fb923c]">ลืมรหัส PIN?</a>
        </div>

        <button
          class="mt-1 w-full rounded-xl border border-[#f97316]/50 bg-gradient-to-r from-[#fcd34d] via-[#fbbf24] to-[#b45309] p-3.5 font-black text-[#180a03] shadow-[0_10px_30px_rgba(249,115,22,0.28)] transition-all hover:scale-[1.02] hover:shadow-[0_15px_40px_rgba(249,115,22,0.36)]">
          เข้าสู่ระบบ
        </button>

        <div class="flex items-center gap-3 py-1 text-[11px] text-[#dcb99a]">
          <span class="h-px flex-1 bg-[#6b2f0b]"></span>
          หรือ
          <span class="h-px flex-1 bg-[#6b2f0b]"></span>
        </div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] p-3 text-sm font-bold text-white shadow-md transition-all hover:scale-[1.02]">
          <span aria-hidden="true">💬</span> ทักไลน์ทีมงานตลอด 24 ชั่วโมง
        </a>

        <div class="mt-1 flex items-center justify-between px-1">
          <div class="flex gap-2">
            <span class="rounded-full border border-[#b91c1c]/60 bg-[#1a0a04] px-2.5 py-1 text-[10px] font-bold text-[#f87171]"><span aria-hidden="true">🔒</span> เข้ารหัสข้อมูล</span>
            <span class="rounded-full border border-[#b45309]/60 bg-[#2e1805] px-2.5 py-1 text-[10px] font-bold text-[#fcd34d]"><span aria-hidden="true">🕐</span> ใช้งานได้ตลอด 24 ชม.</span>
          </div>
          <a href="/register" class="text-xs font-bold text-[#dcb99a] transition-colors hover:text-[#fb923c]">สมัครสมาชิกใหม่</a>
        </div>
      </div>
    </div>
  </div>

  <div slot="right" class="h-full">
    <div class="flex h-full flex-col rounded-2xl border border-[#6b2f0b] bg-[#241004] p-5 shadow-[0_10px_30px_rgba(249,115,22,0.18)]">
      <div class="mb-5 flex items-center justify-between gap-3">
        <div>
          <span class="text-xs font-bold tracking-wide text-[#dcb99a]">ลำดับการใช้งานที่ WON22 วางไว้บนหน้าเมมเบอร์ หลังเข้าสู่ระบบด้วยยูสเดิม</span>
          <div class="bg-gradient-to-r from-[#fb923c] via-[#f8e3d2] to-[#fbbf24] bg-clip-text text-2xl font-black text-transparent sm:text-3xl">สล็อตเว็บตรง • ฝากถอนออโต้ • ไม่ติดเทิร์น</div>
        </div>
        <span class="flex items-center gap-1.5 self-start rounded-full border border-green-500/40 bg-green-900/20 px-2.5 py-1">
          <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-green-400 shadow-[0_0_8px_rgba(74,222,128,0.7)]"></span>
          <span class="text-[10px] font-bold tracking-widest text-green-400 uppercase">Live</span>
        </span>
      </div>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#dcb99a] uppercase">
        <span>ขั้นตอนการใช้งาน</span>
        <span>ลำดับ</span>
      </div>

      <div class="flex flex-1 flex-col gap-2.5">
        {
          steps.map((s) => (
            <div class="rounded-xl border border-[#6b2f0b] bg-[#180a03] px-3.5 py-2.5 transition-colors hover:border-[#f97316]/60 hover:bg-[#331608]">
              <div class="flex items-center justify-between gap-2 text-sm">
                <span class="flex min-w-0 items-center gap-2 font-bold text-[#f8e3d2]">
                  <span aria-hidden="true" class="w-5 shrink-0 text-center">
                    {s.icon}
                  </span>{" "}
                  <span class="truncate">{s.name}</span>
                </span>
                <span class="shrink-0 rounded-full border border-[#f97316]/45 bg-[#331608] px-2.5 py-0.5 text-[10px] font-bold text-[#fcd34d]">{s.tag}</span>
              </div>
              <div class="mt-1.5 text-[11px] tracking-wide text-[#dcb99a]">{s.detail}</div>
            </div>
          ))
        }
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
        {chips.map((c) => <span class="rounded-full border border-[#6b2f0b] bg-[#180a03] px-3 py-1 text-[10px] font-bold text-[#fb923c]">{c}</span>)}
      </div>

      <div class="mt-3 text-center text-[10px] tracking-wide text-[#dcb99a]">
        ลำดับในตารางสรุปจากที่หน้าเว็บแสดงไว้ รายละเอียดของหมวดเกม เงื่อนไขเครดิต และโปรที่เปิดอยู่จริงให้ยึดตามหน้าเมมเบอร์และหน้าโปรโมชั่นของ WON22 ก่อนเลือกใช้ทุกครั้ง
        หากติดขัดตรงไหนทักไลน์ทีมงานได้ตลอด 24 ชั่วโมง
      </div>
    </div>
  </div>
</ContentBoxTwo>
