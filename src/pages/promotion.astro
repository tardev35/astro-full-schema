---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "./components/ContentBox.astro";
import Navfoot from "./components/Navfoot.astro";
import Footer from "./components/Footer.astro";
import Announcement from "./components/Announcement.astro";

import { Picture } from "astro:assets";
import image1 from "../assets/BETFLIK4U-bn600-1.jpg";
import image2 from "../assets/BETFLIK4Ubn600-2.jpg";
import image3 from "../assets/BETFLIK4Ubn600-3.jpg";
import image4 from "../assets/BETFLIK4Ubn6001.jpg";

const currentPath = Astro.url.pathname;
const webPageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: "โปรโมชั่น BETFLIK4U คาสิโครบวงจร อันดับ 1 แจกโบนัสโหดๆ",
  description: "โปรโมชั่น BETFLIK4U คาสิโนครบวงจร อัยดับ 1 แจกโบนัสโหด ข้อเสนอที่ตรงความต้องการผู้เล่น คืนยอดเสียแบบจุกๆ เครดิตฟรีและกิจกรรมสนันสนุนสมาชิกทุกวัน",
  url: currentPath,
};

const allSchemas = [webPageSchema];
---

<script type="application/ld+json" set:html={JSON.stringify(allSchemas)} />
<MainLayout
  title="โปรโมชั่น BETFLIK4U คาสิโครบวงจร อันดับ 1 แจกโบนัสโหดๆ"
  ,
  description="โปรโมชั่น BETFLIK4U คาสิโนครบวงจร อัยดับ 1 แจกโบนัสโหด ข้อเสนอที่ตรงความต้องการผู้เล่น คืนยอดเสียแบบจุกๆ เครดิตฟรีและกิจกรรมสนันสนุนสมาชิกทุกวัน">
  <Announcement />
  <ContentBox>
    <h1 class="mb-7 text-3xl text-amber-400">โปรโมชั่น BETFLIK4U คาสิโครบวงจร อันดับ 1 แจกโบนัสโหดๆ</h1>
    <p class="mb-8 text-gray-200">โปรโมชั่น BETFLIK4U คาสิโนครบวงจร อัยดับ 1 แจกโบนัสโหด ข้อเสนอที่ตรงความต้องการผู้เล่น คืนยอดเสียแบบจุกๆ เครดิตฟรีและกิจกรรมสนันสนุนสมาชิกทุกวัน</p>
    <div class="mb-5 grid grid-cols-1 gap-5 md:grid-cols-3">
      <div class="flex flex-col gap-4">
        <Picture
          src={image1}
          alt="ไม่มีขั้นต่ำ"
          loading="lazy"
          fetchpriority="low"
          widths={[200, 400, 600]}
          sizes="(max-width: 768px) 100vw, 33vw"
          class="mx-auto h-auto w-full max-w-[400px] object-contain shadow-xl"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={60}
        />
      </div>

      <div class="flex flex-col gap-4">
        <Picture
          src={image2}
          alt="BETFLIK4U"
          loading="lazy"
          fetchpriority="low"
          widths={[200, 400, 600]}
          sizes="(max-width: 768px) 100vw, 33vw"
          class="mx-auto h-auto w-full max-w-[400px] object-contain shadow-xl"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />
      </div>

      <div class="flex flex-col gap-4">
        <Picture
          src={image3}
          alt="BETFLIK4U API แท้"
          loading="lazy"
          fetchpriority="low"
          widths={[200, 400, 600]}
          sizes="(max-width: 768px) 100vw, 33vw"
          class="mx-auto h-auto w-full max-w-[400px] object-contain shadow-xl"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />
      </div>

      <div class="flex flex-col gap-4">
        <Picture
          src={image3}
          alt="BETFLIK4U ระบบออโต้"
          loading="lazy"
          fetchpriority="low"
          widths={[200, 400, 600]}
          sizes="(max-width: 768px) 100vw, 33vw"
          class="mx-auto h-auto w-full max-w-[400px] object-contain shadow-xl"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />
      </div>
      <div class="flex flex-col gap-4">
        <Picture
          src={image4}
          alt="BETFLIK4U แตกง่าย"
          loading="lazy"
          fetchpriority="low"
          widths={[200, 400, 600]}
          sizes="(max-width: 768px) 100vw, 33vw"
          class="mx-auto h-auto w-full max-w-[400px] object-contain shadow-xl"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />
      </div>
    </div>
  </ContentBox>
</MainLayout>
<Footer />
<Navfoot />
