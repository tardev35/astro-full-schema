---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";
import CtaRedirect from "../components/CtaRedirect.astro";
import { pageGraph } from "../lib/schema";

const pageTitle = "เข้าสู่ระบบ SUPERCLUB168 | ปุ่มล็อกอินเข้าหน้าสมาชิก สล็อตเว็บตรง API แท้";

const pageDescription =
  "หากคุณกำลังมองหาทางกลับเข้าหน้าสมาชิกแบบไม่ต้องค้นหน้าเข้าเว็บ SUPERCLUB168 พร้อมมอบปุ่มเข้าสู่ระบบเพียงปุ่มเดียว เพื่อกลับไปเล่นต่อด้วยยูสเดิมได้ทันที";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เข้าสู่ระบบ", path: "/login" },
  ],
});

const targetUrl = "https://tinyurl.com/tarspclv";
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="เข้าสู่ระบบ SUPERCLUB168" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label="เข้าสู่ระบบ SUPERCLUB168"
        class="group relative mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#63120a]/70 bg-gradient-to-b from-[#ff5a4a] via-[#e12b27] to-[#a31a12] px-6 py-4 text-xl font-bold tracking-wide text-white shadow-[0_10px_30px_rgba(225,43,39,0.26)] transition-all duration-300 hover:scale-105 hover:border-[#ff9a7a] hover:shadow-[0_15px_40px_rgba(225,43,39,0.38)]">
        เข้าสู่ระบบ SUPERCLUB168
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="เข้าสู่ระบบ" />
</MainLayout>
