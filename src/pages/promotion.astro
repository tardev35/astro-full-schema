          loading="lazy"
          fetchpriority="low"
          widths={[200, 400, 600]}
          sizes="(max-width: 768px) 100vw, 33vw"
          class="mx-auto h-auto w-full max-w-[400px] object-contain shadow-xl"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />
      </div>
      <div class="flex flex-col gap-4">
        <Picture
          src={image6}
          alt="โปรโมชั่นฝากแรกของวัน KIKI49 รับโบนัส 10% ทั้งสมาชิกเก่าและใหม่"
          loading="lazy"
          fetchpriority="low"
          widths={[200, 400, 600]}
          sizes="(max-width: 768px) 100vw, 33vw"
          class="mx-auto h-auto w-full max-w-[400px] object-contain shadow-xl"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />
      </div>
      <div class="flex flex-col gap-4">
        <Picture
          src={image7}
          alt="ตารางระดับ VIP Ranking KIKI49 สิทธิพิเศษและค่าคอมมิชชั่นรายระดับ"
          loading="lazy"
          fetchpriority="low"
          widths={[200, 400, 600]}
          sizes="(max-width: 768px) 100vw, 33vw"
          class="mx-auto h-auto w-full max-w-[400px] object-contain shadow-xl"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />
      </div>
      <div class="flex flex-col gap-4">
        <Picture
          src={image8}
          alt="แนะนำเพื่อนมาเล่น KIKI49 รับค่าคอมมิชชั่น 0.8% จากยอดเทิร์นเพื่อนตลอดชีพ"
