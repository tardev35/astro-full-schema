---
const { titleleft, titlecenter, titleright } = Astro.props;
---

<section
  class="mx-auto mb-4 w-full max-w-7xl rounded-xl border-2 border-red-900/50 bg-[#050000]/90 p-8 text-center text-white/90 shadow-[0_0_20px_rgba(185,28,28,0.15),inset_0_0_15px_rgba(185,28,28,0.05)] backdrop-blur-md transition-all duration-300 hover:border-red-500/50 hover:shadow-[0_0_30px_rgba(185,28,28,0.3)]">
  <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
    <article class="flex flex-col gap-4 border-b border-cyan-800/50 pb-4 md:border-r md:border-b-0 md:pr-4 md:pb-0">
      {titleleft && <h3 class="mb-2 text-2xl font-bold text-yellow-400 drop-shadow-[0_0_5px_rgba(234,179,8,0.4)]">{titleleft}</h3>}
      <div class="text-cyan-50/80">
        <slot name="left" />
      </div>
    </article>

    <article class="flex flex-col gap-4 border-b border-cyan-800/50 pb-4 md:border-r md:border-b-0 md:px-2 md:pb-0">
      {titlecenter && <h3 class="mb-2 text-2xl font-bold text-yellow-400 drop-shadow-[0_0_5px_rgba(234,179,8,0.4)]">{titlecenter}</h3>}
      <div class="text-cyan-50/80">
        <slot name="center" />
      </div>
    </article>

    <article class="flex flex-col gap-4 md:pl-4">
      {titleright && <h3 class="mb-2 text-2xl font-bold text-yellow-400 drop-shadow-[0_0_5px_rgba(234,179,8,0.4)]">{titleright}</h3>}
      <div class="text-cyan-50/80">
        <slot name="right" />
      </div>
    </article>
  </div>
</section>

<style>
  .font-sans {
    font-family: "Kanit", sans-serif;
  }
</style>
