---
import { Picture } from "astro:assets";
import BankStrip from "./BankStrip.astro";
import { BRAND_ADDRESS } from "../lib/brandProfile";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });

const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

const quickLinks = [
  { name: "หน้าแรก", path: "/" },
  { name: "ทดลองเล่นเกมฟรี", path: "/ทดลองเล่น" },
  { name: "โปรโมชั่นสมาชิกใหม่", path: "/promotion" },
  { name: "ทางเข้าล่าสุด", path: "/ทางเข้า" },
  { name: "เกี่ยวกับเรา", path: "/about-us" },
  { name: "สมัครสมาชิก", path: "/register" },
  { name: "ติดต่อแอดมิน", path: "/contact-us" },
];
---

<footer class="relative mt-32 w-full border-t border-[#ffd400]/30 bg-[#0d0320] pt-64 pb-6 font-sans text-[#ece2fb] shadow-[0_-10px_30px_rgba(255,212,0,0.15)] md:pt-40">
  <div
    class="absolute -top-14 left-1/2 z-20 flex w-[92%] max-w-5xl -translate-x-1/2 flex-col items-center justify-between rounded-2xl border border-[#ffd400]/35 bg-gradient-to-r from-[#231045] via-[#2e1550] to-[#1a0330] p-6 shadow-[0_15px_40px_rgba(255,79,216,0.28)] md:-top-16 md:flex-row md:p-8">
    <div class="mb-5 flex flex-col text-center md:mb-0 md:text-left">
      <p class="text-xl font-black tracking-wide text-[#ffe94d] uppercase italic drop-shadow-[0_2px_4px_rgba(0,0,0,0.5)] md:text-3xl">
        <span aria-hidden="true">🎰</span> พร้อมเริ่มกับ OKG777 แล้วหรือยัง?
      </p>
      <p class="mt-2 text-sm font-medium text-[#ece2fb]/90 md:text-base">
        สมัครสมาชิก OKG777 แล้วใช้สล็อต คาสิโนสด และกีฬาได้จากบัญชีเดียว สมาชิกใหม่มีสิทธิ์รับฟรี 18 บาทตามกิจกรรมที่กำหนด อ่านเงื่อนไขของแต่ละโปรให้ครบก่อนกดรับทุกครั้ง
      </p>
    </div>

    <a
      href="/register"
      class="group relative flex items-center justify-center overflow-hidden rounded-full border border-[#ffe94d] bg-gradient-to-b from-[#ffe94d] to-[#b8860a] px-8 py-3.5 text-sm font-extrabold whitespace-nowrap text-[#1a0330] shadow-[0_0_15px_rgba(255,212,0,0.4)] transition-all hover:scale-105 md:text-base">
      <span class="relative z-10">สมัครสมาชิกเลย <span aria-hidden="true">🚀</span></span>
      <div aria-hidden="true" class="absolute inset-0 translate-y-full bg-[#ffd400] transition-transform duration-300 group-hover:translate-y-0"></div>
    </a>
  </div>

  <div class="relative z-10 mx-auto max-w-[1200px] px-6">
    <div class="mb-10 grid grid-cols-1 gap-10 md:grid-cols-12 lg:gap-12">
      <div class="flex flex-col gap-6 md:col-span-12 lg:col-span-4">
        <a href="/" class="inline-block origin-left transition-transform hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt="โลโก้ OKG777 ตัวอักษร OKG สีเหลืองทองและเลข 777 สีชมพูนีออนบนพื้นม่วงเข้ม"
                widths={[100, 200, 300]}
                sizes="100px"
                height={45}
                loading="lazy"
                decoding="async"
                class="h-[45px] w-auto drop-shadow-[0_0_12px_rgba(255,79,216,0.6)]"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <p class="bg-gradient-to-b from-[#ffe94d] to-[#b8860a] bg-clip-text text-3xl font-black text-transparent drop-shadow-[0_0_8px_rgba(255,212,0,0.5)]">OKG777</p>
            )
          }
        </a>
        <p class="text-sm leading-relaxed text-[#c8b6e8]">
          OKG777 รวมสล็อต คาสิโนสด และกีฬาไว้ในระบบเดียว สมาชิกจัดการเครดิต โปรโมชั่น และประวัติการใช้งานผ่านบัญชีเดียว จึงเปลี่ยนหมวดเกมได้ต่อเนื่องโดยไม่ต้องโอนยอดแยก
          พร้อมระบบฝากถอนอัตโนมัติที่ตรวจสถานะรายการย้อนหลังได้จากหน้าบัญชี
        </p>

        <div class="mt-2 flex flex-wrap gap-3">
          <a
            href="/line"
            class="flex items-center gap-2 rounded-full border border-[#00B900]/30 bg-[#00B900]/10 px-4 py-2 text-xs font-bold text-[#00B900] shadow-[0_0_10px_rgba(0,185,0,0.1)] transition-colors hover:bg-[#00B900] hover:text-white">
            <span aria-hidden="true" class="text-base">💬</span> LINE OFFICIAL
          </a>
        </div>

        {
          BRAND_ADDRESS.lines.length > 0 && (
            <address aria-label={BRAND_ADDRESS.label} class="mt-6 rounded-xl border border-[#ffd400]/20 bg-[#170733]/60 p-4 text-xs leading-relaxed text-[#c8b6e8] not-italic">
              <p class="mb-2 flex items-center gap-2 text-[11px] font-bold tracking-wider text-[#ffe94d] uppercase">
                <span aria-hidden="true" class="text-sm">
                  📍
                </span>
                {BRAND_ADDRESS.label}
              </p>
              {BRAND_ADDRESS.lines.map((line) => (
                <span class="block">{line}</span>
              ))}
              {BRAND_ADDRESS.email && (
                <a href={`mailto:${BRAND_ADDRESS.email}`} class="mt-3 inline-flex items-center gap-2 font-bold text-[#c8b6e8] transition-colors hover:text-[#ffe94d]">
                  <span aria-hidden="true" class="text-sm">
                    ✉️
                  </span>
                  {BRAND_ADDRESS.email}
                </a>
              )}
            </address>
          )
        }
      </div>

      <div class="md:col-span-6 lg:col-span-5">
        <p class="relative mb-5 inline-block text-lg font-bold tracking-wider text-[#ece2fb] uppercase">
          ลิงก์ด่วน (Quick Links)
          <span aria-hidden="true" class="absolute -bottom-2 left-0 h-1 w-1/2 rounded-full bg-gradient-to-r from-[#b8860a] to-[#ffe94d] shadow-[0_0_8px_rgba(255,212,0,0.6)]"></span>
        </p>

        <div class="grid grid-cols-2 gap-x-4 gap-y-3 text-sm">
          {
            quickLinks.map((link) => (
              <a href={link.path} class="group flex items-center text-[#c8b6e8] transition-colors hover:text-[#ffe94d]">
                <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#ff4fd8] transition-transform group-hover:rotate-45" />
                {link.name}
              </a>
            ))
          }
        </div>
      </div>

      <div class="md:col-span-6 lg:col-span-3">
        <p class="relative mb-5 inline-block text-lg font-bold tracking-wider text-[#ece2fb] uppercase">
          ระบบการเงิน
          <span aria-hidden="true" class="absolute -bottom-2 left-0 h-1 w-1/2 rounded-full bg-gradient-to-r from-[#b8860a] to-[#ffe94d] shadow-[0_0_8px_rgba(255,212,0,0.6)]"></span>
        </p>

        <p class="mb-4 text-xs text-[#c8b6e8]">รองรับการฝาก-ถอนผ่านแอปธนาคารชั้นนำและ TrueMoney Wallet โดยควรใช้บัญชีชื่อเดียวกับข้อมูลที่สมัครไว้</p>

        <BankStrip size={30} />

        <div class="mt-3 flex h-10 items-center justify-center rounded border border-white/5 bg-[#231045] transition-colors hover:border-[#ffd400]/50" title="ตรวจรายการย้อนหลัง">
          <span class="flex items-center gap-1 text-xs font-bold text-[#ece2fb]"><span aria-hidden="true" class="text-lg text-[#ffd400]">🧾</span> เก็บเลขรายการไว้ตรวจสอบได้</span>
        </div>
      </div>
    </div>

    <hr class="mb-6 border-[#ffd400]/25" />

    <div class="mb-6 hidden text-justify text-[10px] leading-relaxed text-[#a08fc4] md:block">
      OKG777 สล็อตเว็บตรง เกมใหม่ ค่ายดัง คาสิโนสด เกมโต๊ะ บาคาร่า รูเล็ต กีฬาและตลาดเดิมพันตามคู่แข่งขัน ระบบสมาชิกบัญชีเดียว ฝากถอนอัตโนมัติ ตรวจประวัติธุรกรรมจากหน้าบัญชี สมาชิกใหม่รับฟรี 18 บาท
      เครดิตฟรี 38 บาท รางวัลชวนเพื่อน 88 บาท ทางเข้าเว็บหลักรองรับมือถือ สมัครสมาชิก OKG777
    </div>

    <div class="flex flex-col items-center justify-between gap-4 border-t border-white/5 pt-6 text-xs text-[#a08fc4] md:flex-row">
      <p>&copy; {new Date().getFullYear()} <span class="font-bold tracking-wider text-[#ffe94d] uppercase">OKG777</span>. All Rights Reserved.</p>

      <div class="flex items-center gap-6">
        <a href="/terms/" class="transition-colors hover:text-[#ece2fb]">เงื่อนไขและข้อตกลง</a>
        <a href="/privacy/" class="transition-colors hover:text-[#ece2fb]">นโยบายความเป็นส่วนตัว</a>

        <a
          href="#top"
          class="flex h-8 w-8 items-center justify-center rounded border border-white/10 bg-white/5 text-[#ece2fb] transition-all hover:border-[#ffe94d] hover:bg-[#2e1550] hover:shadow-[0_0_15px_rgba(255,212,0,0.5)]"
          aria-label="กลับขึ้นด้านบนสุดของหน้า">
          <span aria-hidden="true">↑</span>
        </a>
      </div>
    </div>
  </div>
</footer>

<style>
  footer a {
    text-decoration: none;
    color: inherit;
    transition: all 0.3s ease;
  }
</style>
