---
const reviews = [
  {
    name: "สมาชิกที่สลับค่ายเกมบ่อย",
    role: "เปลี่ยนค่ายจากยูสเดิมได้เลย",
    stars: 5,
    tag: "รวมหลายค่าย",
    content:
      "เมื่อก่อนต้องเปิดยูสแยกตามค่ายครับ พอมาที่นี่ค่ายที่เล่นประจำกับค่ายที่อยากลองใหม่อยู่หลังบัญชีเดียวกัน กดเปลี่ยนแล้วเข้าเกมต่อได้เลย เครดิตก็ชุดเดิม ไม่ต้องมานั่งจำว่าเงินอยู่ค่ายไหน วันไหนอยากเปลี่ยนบรรยากาศก็เปิดค่ายใหม่ดูได้",
    avatar: "🎰",
  },
  {
    name: "สมาชิกที่ทำรายการเองทั้งวัน",
    role: "ฝากถอนและเช็กเครดิตจากหน้าเดียว",
    stars: 5,
    tag: "ระบบออโต้",
    content:
      "ที่ถูกใจคือส่งรายการแล้วดูสถานะได้จากหน้าเมมเบอร์เลยค่ะ ไม่ต้องเปิดหลายหน้าไปมา เครดิตกับประวัติรายการอยู่ตรงนั้นให้เช็กก่อนกลับเข้าเกม เวลาเข้าเล่นดึก ๆ แล้วไม่ต้องรอใครมาตอบก็ทำให้วางแผนทุนของตัวเองง่ายขึ้น",
    avatar: "⚡",
  },
  {
    name: "สมาชิกที่ใช้มือถือเป็นเครื่องหลัก",
    role: "เปิดเบราว์เซอร์ได้เลย ไม่ต้องโหลดapp",
    stars: 5,
    tag: "เล่นบนมือถือ",
    content:
      "ผมไม่ค่อยอยากลงแอปเพิ่มในเครื่องครับ พอเว็บนี้เปิดผ่าน Chrome แล้วใช้ได้ครบก็จบเลย ล็อกอินด้วยยูสเดิม เลือกเกม เช็กเครดิต ดูโปรโมชั่น ทำได้จากมือถือเครื่องเดียว หน้าจอย่อขยายมาพอดี ไม่ต้องซูมหาปุ่มเหมือนบางเว็บ",
    avatar: "📱",
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label="เสียงจากสมาชิก OSIRIS168" class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#4ff0bb] via-[#f8ecc9] to-[#e8b52c] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      เสียงจากสมาชิก <span class="text-[#e8b52c]">OSIRIS168</span>
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#e8b52c] to-transparent"></div>
  </div>

  <div class="mx-auto mb-8 flex max-w-md items-center justify-center gap-5 rounded-2xl border border-[#064c39] bg-[#0f241d] px-6 py-4 shadow-[0_10px_30px_rgba(18,196,143,0.18)]">
    <div class="flex flex-col items-center">
      <span class="bg-gradient-to-b from-[#ffdd8a] to-[#8a6314] bg-clip-text text-4xl leading-none font-black text-transparent">{average}</span>
      <span class="mt-1 text-[10px] font-bold tracking-widest text-[#b9d6c9] uppercase">คะแนนเฉลี่ย</span>
    </div>
    <div class="h-12 w-px bg-[#064c39]"></div>
    <div class="flex flex-col gap-1.5">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#e8b52c]" : "text-[#064c39]"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#b9d6c9]">คะแนนเฉลี่ย {average} จาก 5 ดาว จากการใช้งานจริงของสมาชิก {reviews.length} ด้าน</span>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
    {
      reviews.map((review) => (
        <article class="group relative isolate flex flex-col gap-4 overflow-hidden rounded-2xl border border-[#064c39] bg-[#0f241d] p-6 text-left shadow-[0_10px_30px_rgba(18,196,143,0.14)] transition-all duration-300 hover:-translate-y-1 hover:border-[#12c48f]/60 hover:shadow-[0_15px_40px_rgba(18,196,143,0.28)]">
          <span class="absolute inset-y-0 left-0 -z-10 w-1 bg-gradient-to-b from-[#12c48f] to-[#e8b52c] opacity-80 transition-opacity duration-300 group-hover:opacity-100" />
          <span class="pointer-events-none absolute -top-14 -right-14 -z-10 h-32 w-32 rounded-full bg-[#12c48f]/16 blur-[50px] transition-all duration-300 group-hover:bg-[#4ff0bb]/24" />

          <div class="flex items-center justify-between gap-3">
            <span class="inline-flex items-center gap-1.5 rounded-full border border-[#064c39] bg-[#050d0b] px-3 py-1 text-[10px] font-bold tracking-widest text-[#b9d6c9] uppercase">
              <span aria-hidden="true" class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#4ff0bb]" />
              {review.tag}
            </span>
            <span class="flex gap-0.5 text-sm">
              <span aria-hidden="true" class="flex gap-0.5">
                {Array.from({ length: 5 }).map((_, i) => (
                  <span class={i < review.stars ? "text-[#e8b52c]" : "text-[#064c39]"}>★</span>
                ))}
              </span>
              <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
            </span>
          </div>

          <p class="text-left text-base leading-relaxed text-[#dfeee6]">{review.content}</p>

          <div class="mt-auto flex items-center gap-3 border-t border-[#064c39] pt-4">
            <span
              aria-hidden="true"
              class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#12c48f]/40 bg-gradient-to-br from-[#4ff0bb] via-[#12c48f] to-[#064c39] text-xl shadow-inner transition-transform duration-300 group-hover:scale-110">
              {review.avatar}
            </span>
            <span class="flex flex-col">
              <span class="text-sm font-black text-[#f8ecc9] transition-colors group-hover:text-[#e8b52c]">{review.name}</span>
              <span class="text-[10px] font-bold tracking-wider text-[#b9d6c9] uppercase">{review.role}</span>
            </span>
          </div>
        </article>
      ))
    }
  </div>
</section>
