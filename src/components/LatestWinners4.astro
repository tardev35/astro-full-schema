---
import kbankLogo from "../assets/banks/kbank.png";
import scbLogo from "../assets/banks/scb.png";
import krungsriLogo from "../assets/banks/krungsri.png";
import ktbLogo from "../assets/banks/ktb.png";
import ttbLogo from "../assets/banks/ttb.png";

const bankPool = [
  { name: "KBank", color: "bg-[#1155cc]", icon: kbankLogo.src },
  { name: "SCB", color: "bg-[#4e1c80]", icon: scbLogo.src },
  { name: "Krungsri", color: "bg-[#fcd34d]", icon: krungsriLogo.src },
  { name: "KTB", color: "bg-[#0ea5e9]", icon: ktbLogo.src },
];
---

<div class="mx-auto w-full max-w-[1000px] p-4 font-sans">
  <div class="relative overflow-hidden rounded-[30px] border-2 border-cyan-900/50 bg-[#001a33]/90 px-4 py-8 shadow-lg backdrop-blur-md">
    <div class="mb-6 text-center">
      <h2 class="bg-gradient-to-b from-[#fef08a] to-[#eab308] bg-clip-text text-xl font-black text-transparent md:text-2xl">⚡ ถอนเงินแบบเรียลไทม์</h2>
    </div>

    <div id="feed-pills" class="relative z-10 flex flex-wrap justify-center gap-3"></div>
  </div>
</div>

<script define:vars={{ bankPool }}>
  const feed = document.getElementById("feed-pills");
  const getRandomStr = (len, chars) =>
    Array.from({ length: len })
      .map(() => chars.charAt(Math.floor(Math.random() * chars.length)))
      .join("");
  const getAmount = () => (Math.floor(Math.random() * (95000 - 15000 + 1)) + 15000).toLocaleString("en-US");

  const createHTML = () => {
    const bank = bankPool[Math.floor(Math.random() * bankPool.length)];
    const user = `${getRandomStr(2, "abcdefghijklmnopqrstuvwxyz")}***`;

    return `
      <div class="transform scale-90 opacity-0 transition-all duration-500 ease-out">
        <div class="flex items-center gap-3 rounded-full border border-cyan-500/30 bg-[#000a14] py-1.5 pl-1.5 pr-4 shadow-[0_0_10px_rgba(6,182,212,0.1)] hover:border-cyan-400">
          <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full ${bank.color}">
            <img src="${bank.icon}" alt="bank" class="h-4 w-4 object-contain" />
          </div>
          <div class="text-sm font-bold text-white/90">${user}</div>
          <div class="text-sm font-black text-yellow-400 drop-shadow-sm">+${getAmount()} ฿</div>
        </div>
      </div>
    `;
  };

  const trigger = () => {
    const tempDiv = document.createElement("div");
    tempDiv.innerHTML = createHTML();
    const newEl = tempDiv.firstElementChild;

    // สุ่มเอาไปแทรกตำแหน่งต่างๆ เพื่อให้ดูเป็นธรรมชาติ (ไม่ใช่แค่ดันลง)
    if (feed.children.length > 0) {
      feed.insertBefore(newEl, feed.children[Math.floor(Math.random() * Math.min(3, feed.children.length))]);
    } else {
      feed.appendChild(newEl);
    }

    setTimeout(() => {
      newEl.classList.remove("scale-90", "opacity-0");
      newEl.classList.add("scale-100", "opacity-100");
    }, 50);

    if (feed.children.length > 12) {
      // โชว์ชิปได้เยอะขึ้นเพราะขนาดเล็ก
      const last = feed.lastElementChild;
      last.classList.remove("scale-100", "opacity-100");
      last.classList.add("scale-90", "opacity-0");
      setTimeout(() => last.remove(), 500);
    }
  };

  for (let i = 0; i < 8; i++) {
    trigger();
  }
  setInterval(trigger, 3000);
</script>
<style>
  .font-sans {
    font-family: "Kanit", sans-serif;
  }
</style>
