---
const { titleleft, titleright } = Astro.props;
---

<section
  class="mx-auto mb-4 w-full max-w-7xl rounded-2xl border-2 border-yellow-600/30 bg-[#4a0404]/80 p-8 text-center font-sans shadow-[0_0_20px_rgba(234,179,8,0.1),inset_0_0_15px_rgba(234,179,8,0.05)] backdrop-blur-md transition-all duration-300 hover:border-yellow-500/60 hover:shadow-[0_0_30px_rgba(234,179,8,0.25)]">
  <div class="grid grid-cols-1 gap-5 md:grid-cols-2 lg:grid-cols-2">
    <article class="flex flex-col gap-4">
      {titleleft && <h2 class="mb-4 text-3xl font-black text-yellow-400 drop-shadow-[0_0_5px_rgba(234,179,8,0.4)]">{titleleft}</h2>}
      <div class="text-red-50/90">
        <slot name="left" />
      </div>
    </article>

    <article class="flex flex-col gap-4">
      {titleright && <h2 class="mb-4 text-3xl font-black text-yellow-400 drop-shadow-[0_0_5px_rgba(234,179,8,0.4)]">{titleright}</h2>}
      <div class="text-red-50/90">
        <slot name="right" />
      </div>
    </article>
  </div>
</section>

<style>
  .font-sans {
    font-family: "Kanit", sans-serif;
  }
</style>
