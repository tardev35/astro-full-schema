---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-2xl";
---

<section class="relative z-10 my-6 flex w-full justify-center px-4 font-sans">
  <div
    class="w-full max-w-[1400px] rounded-[25px] border border-[#2a6b2c] bg-[#0c2a12] p-8 text-left text-base leading-relaxed text-[#e3eedf] shadow-[8px_8px_20px_rgba(1,10,3,0.6),-6px_-6px_16px_rgba(92,207,63,0.07)] md:p-10">
    {
      title && (
        <header class="mb-8 border-b border-[#2a6b2c] pb-5 text-center">
          <HeadingTag class={`${headingSize} leading-normal font-black tracking-wide text-[#ffd24d]`}>{title}</HeadingTag>
          <span aria-hidden="true" class="mx-auto mt-4 block h-1.5 w-20 rounded-full bg-gradient-to-r from-[#c77d00] via-[#fcaa04] to-[#2f9e1f]" />
        </header>
      )
    }
    <slot />
  </div>
</section>
