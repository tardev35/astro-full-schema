---
const providers = [
  { name: "PG SOFT", desc: "กราฟิก 3D วิจิตรบรรจง เชื่อมตรงกับค่าย pg แบบลิขสิทธิ์แท้ ทุกการหมุนเป็นไปตามมาตรฐาน", tag: "ขวัญใจมหาชน", icon: "🎨" },
  { name: "Joker Gaming", desc: "ตำนานสล็อตยุคคลาสสิก มีเกมโรม่าอันเลื่องชื่อที่ยังแจกรางวัลอย่างสม่ำเสมอ", tag: "เก๋าและขลัง", icon: "🃏" },
  { name: "Pragmatic Play", desc: "ฟีเจอร์แพรวพราว มีลูกเล่นให้ลุ้นระทึกตลอดเวลา อัตราการจ่ายหนักหน่วงสมน้ำสมเนื้อ", tag: "ระดับสากล", icon: "💠" },
  { name: "สล็อตแตกง่าย", desc: "รวมเกมที่กติกาไม่ซับซ้อนซ่อนเงื่อน ถูกจริตพี่น้องชาวไทย เล่นแล้วเข้าใจได้ทันที", tag: "เล่นง่าย", icon: "🎰" },
  { name: "เกมฟีเจอร์ฟรีสปิน", desc: "สายลุ้นโบนัสเลือกหมวดนี้ได้เลย ตัวคูณซ้อนหลายชั้นตามจังหวะของเกมจริงๆ", tag: "ฟีเจอร์แน่น", icon: "🌀" },
  { name: "เกมคลาสสิกรอบสั้น", desc: "รูปแบบเข้าใจง่าย เหมาะกับท่านที่อยากเล่นในบรรยากาศไม่วุ่นวาย ไม่เร่ง ไม่กดดัน", tag: "สบายๆ", icon: "🍒" },
  { name: "เกมใหม่สำหรับมือถือ", desc: "เมนูภาษาไทยชัดเจน อ่านง่ายสบายตา รองรับทั้ง iOS และ Android ลื่นไหลไม่มีสะดุด", tag: "iOS / Android", icon: "📱" },
];
---

<section aria-label="ค่ายเกมและหมวดสล็อตที่ YIMSIAM889 รวมไว้ให้ครบ" class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#eaf4ff] via-[#9cc9ff] to-[#7cc0ff] bg-clip-text text-3xl leading-normal font-black tracking-widest text-transparent uppercase">ค่ายเกมและหมวดสล็อตที่ YIMSIAM889 รวมไว้ให้ครบ</p>
    <div aria-hidden="true" class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#2f8cff] to-transparent"></div>
  </div>

  <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4 lg:gap-5 xl:grid-cols-7">
    {
      providers.map((provider) => (
        <a
          href="/register/"
          class="group relative flex flex-col items-center justify-center overflow-hidden rounded-2xl border border-[#16357a] bg-[#061538] p-5 shadow-[0_10px_30px_rgba(47,140,255,0.14)] transition-all duration-300 hover:-translate-y-2 hover:border-[#2f8cff]/55 hover:bg-[#0a1f4d] hover:shadow-[0_15px_40px_rgba(47,140,255,0.28)]">
          <div aria-hidden="true" class="pointer-events-none absolute inset-0 bg-[#2f8cff]/8 opacity-0 transition-opacity duration-300 group-hover:opacity-100" />

          <div class="absolute top-2 right-2 z-10 rounded-full bg-gradient-to-r from-[#eaf4ff] via-[#9cc9ff] to-[#4d9dff] px-2 py-0.5 text-[9px] font-black tracking-wide whitespace-nowrap text-[#03133c] shadow-sm transition-transform duration-300 group-hover:scale-110">
            {provider.tag}
          </div>

          <div aria-hidden="true" class="mb-3 text-4xl transition-transform duration-300 group-hover:scale-125 group-hover:rotate-3">
            {provider.icon}
          </div>
          <p class="text-center text-sm font-black text-[#9cc9ff] transition-colors group-hover:text-[#eaf4ff]">{provider.name}</p>
          <p class="mt-1 text-center text-[10px] text-[#93a9d6]">{provider.desc}</p>

          <span class="relative z-10 mt-4 block w-full rounded-full border border-[#16357a] bg-[#0a1f4d] py-1.5 text-center text-[11px] font-bold text-[#dbeaff] shadow-inner transition-colors duration-300 group-hover:border-transparent group-hover:bg-gradient-to-r group-hover:from-[#eaf4ff] group-hover:via-[#9cc9ff] group-hover:to-[#4d9dff] group-hover:text-[#03133c]">
            สมัครเข้าเล่น
          </span>
        </a>
      ))
    }
  </div>
</section>
