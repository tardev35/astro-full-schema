---
export interface Props {
  title?: string;
  titleleft?: string;
  titleright?: string;
  label?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, titleleft, titleright, label, as } = Astro.props;
const TitleTag = as ?? "p";
const intro = Astro.slots.has("default") ? (await Astro.slots.render("default")).trim() : "";

const sectionLabel = label ?? title ?? titleleft ?? titleright ?? "ข้อมูลประกอบ";
---

<section aria-label={sectionLabel} class="mx-auto mb-6 w-full max-w-7xl px-4 font-sans">
  <div
    class="relative isolate w-full border border-[#d6e2f7] bg-white p-8 text-[#1f2a44] transition-colors duration-300 hover:border-[#9dbcf0]"
    style="clip-path: polygon(30px 0, 100% 0, 100% calc(100% - 30px), calc(100% - 30px) 100%, 0 100%, 0 30px);">
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-[2px] w-24 bg-gradient-to-r from-[#e0a91b] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-[2px] w-24 bg-gradient-to-l from-[#1a5fe0] to-transparent"></div>
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-16 w-[2px] bg-gradient-to-b from-[#e0a91b] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-16 w-[2px] bg-gradient-to-t from-[#1a5fe0] to-transparent"></div>

    {
      title && (
        <TitleTag class="mb-6 bg-gradient-to-r from-[#0b3a9e] via-[#1a5fe0] to-[#0a1f5c] bg-clip-text text-center text-xl leading-normal font-black text-transparent md:text-2xl">{title}</TitleTag>
      )
    }

    {intro && <div class="mb-8 text-left text-base leading-relaxed text-[#1f2a44]" set:html={intro} />}

    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <article class="relative flex flex-col gap-4 text-left text-base leading-relaxed text-[#1f2a44]">
        {
          titleleft && (
            <p class="flex items-center gap-2 border-b border-[#d6e2f7] pb-2 text-xl leading-normal font-black text-[#0a1f5c]">
              <span aria-hidden="true" class="inline-block h-2 w-2 shrink-0 bg-[#e0a91b]" /> {titleleft}
            </p>
          )
        }
        <slot name="left" />
      </article>

      <article class="relative flex flex-col gap-4 text-left text-base leading-relaxed text-[#1f2a44] md:border-l md:border-[#d6e2f7] md:pl-8">
        {
          titleright && (
            <p class="flex items-center gap-2 border-b border-[#d6e2f7] pb-2 text-xl leading-normal font-black text-[#0a1f5c]">
              <span aria-hidden="true" class="inline-block h-2 w-2 shrink-0 bg-[#1a5fe0]" /> {titleright}
            </p>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
