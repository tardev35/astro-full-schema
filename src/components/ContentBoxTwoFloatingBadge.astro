---
export interface Props {
  title?: string;
  titleleft?: string;
  titleright?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, titleleft, titleright, as: HeadingTag = "h2" } = Astro.props;
---

<section class="my-10 flex w-full justify-center px-4 font-sans">
  <div
    class="relative isolate w-full max-w-7xl rounded-2xl border-2 border-[#f5c542]/35 bg-gradient-to-b from-[#0d0904]/95 to-[#060402]/95 p-8 pt-36 shadow-[0_10px_30px_rgba(245,197,66,0.18)] md:pt-32">
    <div aria-hidden="true" class="pointer-events-none absolute -top-16 -right-10 -z-10 h-40 w-40 rounded-full bg-[#bc7b14]/35 blur-[60px]"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -bottom-16 -left-10 -z-10 h-40 w-40 rounded-full bg-[#f5c542]/20 blur-[60px]"></div>

    {
      title && (
        <div class="absolute -top-6 left-1/2 flex w-[92%] max-w-2xl -translate-x-1/2 items-center justify-center gap-2 rounded-lg border-2 border-[#f5c542]/45 bg-[#161006] px-4 py-2.5 text-center shadow-[0_10px_30px_rgba(245,197,66,0.28)] sm:px-8">
          <span aria-hidden="true" class="shrink-0 text-[#f5c542]">
            ✦
          </span>
          <HeadingTag class="min-w-0 bg-gradient-to-r from-[#ffe9a8] via-[#f5c542] to-[#bc7b14] bg-clip-text text-lg leading-normal font-black tracking-tight text-transparent uppercase sm:text-xl md:text-2xl">
            {title}
          </HeadingTag>
          <span aria-hidden="true" class="shrink-0 text-[#f5c542]">
            ✦
          </span>
        </div>
      )
    }

    <div class="grid grid-cols-1 gap-10 md:grid-cols-2">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#efe1c2]">
        {titleleft && <p class="text-2xl leading-normal font-bold text-[#ffd75e]">{titleleft}</p>}
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#efe1c2] md:border-l md:border-[#a3610c]/50 md:pl-10">
        {titleright && <p class="text-2xl leading-normal font-bold text-[#ffe9a8]">{titleright}</p>}
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
