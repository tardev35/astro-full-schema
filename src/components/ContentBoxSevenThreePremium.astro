---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#f1d9c4] bg-white p-8 text-[#2b2622] shadow-[0_10px_30px_rgba(31,22,17,0.08)] transition-[border-color,box-shadow] duration-500 hover:border-[#f0a868] hover:shadow-[0_15px_40px_rgba(244,123,32,0.18)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-24 -left-24 -z-10 h-48 w-48 rounded-full bg-[#ffa94d]/20 blur-[60px]"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-24 -bottom-24 -z-10 h-48 w-48 rounded-full bg-[#5aa9ff]/15 blur-[60px]"></div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#f1d9c4] pb-4">
          <span aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffc94a] via-[#f47b20] to-[#c85a0c] shadow-[0_0_10px_rgba(244,123,32,0.30)]" />
          <HeadingTag class="text-xl leading-normal font-black tracking-wide text-[#1f1611] md:text-2xl">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-10 md:grid-cols-[2fr_3fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#2b2622]">
        {titleleft && <p class="text-center text-xl leading-normal font-black tracking-wide text-[#1f1611] md:text-left">{titleleft}</p>}
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#2b2622] md:border-l md:border-[#f1d9c4] md:pl-10">
        {titleright && <HeadingTag class="mb-2 text-xl leading-normal font-black tracking-wide text-[#1f1611] md:text-2xl">{titleright}</HeadingTag>}
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
