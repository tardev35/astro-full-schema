---
const providers = [
  { name: "เว็บตรงลิขสิทธิ์แท้", desc: "ทุกเกมมาจากค่ายผู้พัฒนาโดยตรง ไม่ผ่านเอเย่นต์ เดินตามมาตรฐานต้นฉบับของค่าย", tag: "ค่ายโดยตรง", icon: "🎰" },
  { name: "ไม่มีล็อกยูส", desc: "ไม่มีการปรับจูนระบบหลังบ้านเพื่อเอาเปรียบสมาชิก วัดผลกันด้วยฝีมือและดวงล้วน ๆ", tag: "โปร่งใส", icon: "🔓" },
  { name: "สมัครด้วยตัวเอง", desc: "กรอกข้อมูลพื้นฐานผ่านหน้าเว็บ รับยูสเซอร์เนมได้เองภายในไม่กี่วินาที ไม่ต้องรออนุมัติ", tag: "ไม่ซับซ้อน", icon: "📝" },
  { name: "ฝากไม่มีขั้นต่ำ", desc: "หลักสิบหลักร้อยก็เริ่มได้ ทำรายการปุ๊บเครดิตเข้าปั๊บ ไม่ต้องรอแอดมินอนุมัติ", tag: "เริ่มได้ทุกงบ", icon: "💰" },
  { name: "ถอนออโต้ 24 ชม.", desc: "ทำรายการถอนได้เองตลอดวัน ระบบประมวลผลอัตโนมัติ ไม่ต้องส่งสลิปให้คนกลางตรวจ", tag: "โอนไว", icon: "⚡" },
  { name: "AI ช่วยอ่านจังหวะเกม", desc: "สรุปรูปแบบการออกฟีเจอร์และความถี่ของโบนัสเป็นสัญญาณเชิงแนวโน้ม โดยไม่แตะตัวเกม", tag: "เรียลไทม์", icon: "🤖" },
  { name: "ระบบนิ่ง ไม่สะดุด", desc: "ตัวเกมทำงานราบรื่น ไม่เด้งออกกลางทาง ใช้งานต่อเนื่องได้ทั้งบนมือถือและคอมพิวเตอร์", tag: "เสถียร", icon: "📶" },
];
---

<section aria-label="จุดเด่นของ TOPGAMEVIP เว็บตรงเกมสล็อต" class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#8a0208] via-[#e60012] to-[#8a6410] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      สิ่งที่ <span class="text-[#8a6410]">TOPGAMEVIP</span> ให้ผู้เล่นในยูสเดียว
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#e60012] to-transparent"></div>
  </div>

  <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4 lg:gap-5 xl:grid-cols-7">
    {
      providers.map((provider) => (
        <a
          href="/register"
          class="group relative flex flex-col items-center justify-center overflow-hidden rounded-2xl border border-[#f6c9c6] bg-white p-5 shadow-[0_10px_30px_rgba(230,0,18,0.10)] transition-all duration-300 hover:-translate-y-2 hover:border-[#e60012]/45 hover:bg-[#fff7f6] hover:shadow-[0_15px_40px_rgba(230,0,18,0.20)]">
          <div class="pointer-events-none absolute inset-0 bg-[#d4a017]/8 opacity-0 transition-opacity duration-300 group-hover:opacity-100" />

          <div class="absolute top-2 right-2 z-10 rounded-full bg-gradient-to-r from-[#ffe9a8] via-[#f5c542] to-[#d4a017] px-2 py-0.5 text-[9px] font-black tracking-wide whitespace-nowrap text-[#2a0709] shadow-sm transition-transform duration-300 group-hover:scale-110">
            {provider.tag}
          </div>

          <div aria-hidden="true" class="mb-3 text-4xl transition-transform duration-300 group-hover:scale-125 group-hover:rotate-3">
            {provider.icon}
          </div>
          <p class="text-center text-sm font-black text-[#8a0208] transition-colors group-hover:text-[#e60012]">{provider.name}</p>
          <p class="mt-1 text-center text-[10px] text-[#6f4b4d]">{provider.desc}</p>

          <span class="relative z-10 mt-4 block w-full rounded-full border border-[#f6c9c6] bg-[#ffe9e7] py-1.5 text-center text-[11px] font-bold text-[#8a0208] shadow-inner transition-colors duration-300 group-hover:border-transparent group-hover:bg-gradient-to-r group-hover:from-[#ff4b41] group-hover:via-[#e60012] group-hover:to-[#b30009] group-hover:text-white">
            สมัครเข้าเล่น
          </span>
        </a>
      ))
    }
  </div>
</section>
