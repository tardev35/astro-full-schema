---
export interface Props {
  title?: string;
  titleleft?: string;
  titleright?: string;
  label?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, titleleft, titleright, label, as } = Astro.props;
const TitleTag = as ?? "p";
const intro = Astro.slots.has("default") ? (await Astro.slots.render("default")).trim() : "";

const sectionLabel = label ?? title ?? titleleft ?? titleright ?? "ข้อมูลประกอบ";
---

<section aria-label={sectionLabel} class="mx-auto mb-6 w-full max-w-7xl px-4 font-sans">
  <div
    class="relative isolate w-full border border-[#21d4f2]/30 bg-[#04182f]/92 p-8 text-[#dbeefb] shadow-[0_10px_30px_rgba(33,212,242,0.20)] backdrop-blur-md transition-all duration-300 hover:border-[#21d4f2]/55 hover:shadow-[0_15px_40px_rgba(33,212,242,0.30)]"
    style="clip-path: polygon(30px 0, 100% 0, 100% calc(100% - 30px), calc(100% - 30px) 100%, 0 100%, 0 30px);">
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-[2px] w-24 bg-gradient-to-r from-[#21d4f2] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-[2px] w-24 bg-gradient-to-l from-[#fdb524] to-transparent"></div>
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-16 w-[2px] bg-gradient-to-b from-[#21d4f2] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-16 w-[2px] bg-gradient-to-t from-[#fdb524] to-transparent"></div>

    {
      title && (
        <TitleTag class="mb-4 bg-gradient-to-r from-[#7fe6ff] via-[#21d4f2] to-[#ffe999] bg-clip-text text-center text-2xl leading-normal font-black text-transparent uppercase">{title}</TitleTag>
      )
    }

    {intro && <div class="mb-8 text-left text-base leading-relaxed text-[#dbeefb]" set:html={intro} />}

    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <article class="relative flex flex-col gap-4 text-left text-base leading-relaxed text-[#dbeefb]">
        {
          titleleft && (
            <p class="flex items-center gap-2 border-b border-[#0a3a68]/80 pb-2 text-xl leading-normal font-black text-[#7fe6ff] uppercase">
              <span aria-hidden="true" class="inline-block h-2 w-2 shrink-0 bg-[#21d4f2] shadow-[0_0_5px_rgba(33,212,242,0.8)]" /> {titleleft}
            </p>
          )
        }
        <slot name="left" />
      </article>

      <article class="relative flex flex-col gap-4 text-left text-base leading-relaxed text-[#dbeefb] md:border-l md:border-[#0a3a68]/80 md:pl-8">
        {
          titleright && (
            <p class="flex items-center gap-2 border-b border-[#0a3a68]/80 pb-2 text-xl leading-normal font-black text-[#ffe999] uppercase">
              <span aria-hidden="true" class="inline-block h-2 w-2 shrink-0 bg-[#fdb524] shadow-[0_0_5px_rgba(253,181,36,0.8)]" /> {titleright}
            </p>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
