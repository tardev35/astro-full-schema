---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
---

<section class="my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative w-full max-w-7xl overflow-hidden rounded-3xl border border-blue-600/30 bg-[#050d16]/80 p-8 text-white/90 shadow-[0_10px_30px_rgba(37,99,235,0.6)] backdrop-blur-xl transition-all duration-500 hover:border-blue-500/60 hover:shadow-[0_15px_40px_rgba(37,99,235,0.25)] md:p-10">
    <div class="pointer-events-none absolute -top-20 -left-20 h-40 w-40 rounded-full bg-blue-600/20 blur-[50px] transition-all duration-500 group-hover:bg-blue-500/30"></div>
    <div class="pointer-events-none absolute -right-20 -bottom-20 h-40 w-40 rounded-full bg-yellow-600/10 blur-[50px] transition-all duration-500 group-hover:bg-yellow-500/20"></div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-blue-800/50 pb-4">
          <div class="h-8 w-1.5 rounded-full bg-gradient-to-b from-yellow-300 to-yellow-600 shadow-[0_0_10px_rgba(234,179,8,0.5)]" />
          <HeadingTag class="bg-gradient-to-r from-yellow-200 to-yellow-500 bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase drop-shadow-sm">{title}</HeadingTag>
        </header>
      )
    }
    <div class="relative z-10 text-lg leading-relaxed text-blue-100/90">
      <slot />
    </div>
  </div>
</section>
<style>
  .font-sans {
    font-family: "Kanit", sans-serif;
  }
</style>
