---
const {
  message = "SUPREME888 สล็อต ถอนได้เต็มทุกบิล ไม่หักเปอร์เซ็นต์ • ฝากถอนออโต้เริ่ม 20 บาท ถอนเองได้ตลอด 24 ชม. ไม่ต้องส่งสลิป • ทุกธนาคารและ TrueMoney Wallet • รวม PG Soft, Pragmatic Play, JILI และ Joker Gaming ไว้ในเว็บเดียว • สมัคร ฝาก ปั่น ถอน จบบนมือถือเครื่องเดียว แอดมินดูแลตลอด 24 ชม.",
} = Astro.props;
---

<div class="relative mx-auto mt-4 flex h-[42px] max-w-[900px] items-center overflow-hidden rounded-sm border border-[#f1d2d3] bg-white shadow-[0_4px_15px_rgba(20,20,20,0.06)]">
  <div class="relative z-10 flex h-full items-center bg-gradient-to-r from-[#b5121a] to-[#ec1b24] px-6 pl-4 [clip-path:polygon(0_0,100%_0,85%_100%,0_100%)] md:px-8">
    <div class="flex items-center gap-2">
      <span aria-hidden="true" class="relative flex h-2.5 w-2.5">
        <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-white opacity-75"></span>
        <span class="relative inline-flex h-2.5 w-2.5 rounded-full bg-white"></span>
      </span>
      <span class="font-black tracking-widest text-white italic">HOT</span>
    </div>
  </div>

  <div class="relative flex-1 overflow-hidden">
    <div aria-hidden="true" class="absolute inset-y-0 left-0 z-10 w-8 bg-gradient-to-r from-white to-transparent"></div>
    <div aria-hidden="true" class="absolute inset-y-0 right-0 z-10 w-8 bg-gradient-to-l from-white to-transparent"></div>

    <div class="marquee-track flex w-max animate-[scroll_20s_linear_infinite] items-center gap-10 pl-4 text-sm font-bold whitespace-nowrap text-[#141414] md:text-base">
      <span>{message}</span>
      <span aria-hidden="true">{message}</span>
      <span aria-hidden="true">{message}</span>
    </div>
  </div>

  <div aria-hidden="true" class="absolute bottom-0 left-0 h-[2px] w-full bg-gradient-to-r from-[#ec1b24] via-[#d4a017] to-transparent"></div>
</div>

<style>
  @keyframes scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(calc(-33.33% - 13px));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
    }
  }
</style>
