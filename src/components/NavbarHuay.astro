---
import { Picture } from "astro:assets";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });
const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;
const currentPath = Astro.url.pathname;
const isActive = (path: string) => {
  if (path === "/") return currentPath === "/";
  return currentPath.startsWith(path);
};
---

<header class="sticky top-0 z-[100] w-full font-sans">
  <nav class="relative mx-auto flex h-[80px] w-full items-center justify-between border-b border-yellow-600/50 bg-[#450a0a]/95 px-4 shadow-[0_5px_25px_rgba(251,191,36,0.2)] backdrop-blur-xl xl:px-8">
    <a href="/" class="z-[110] flex-shrink-0 transition-transform hover:scale-105">
      {
        mainLogo ? (
          <Picture
            src={mainLogo}
            alt="HUAYPUNG Logo"
            loading="eager"
            class="h-[60px] w-auto drop-shadow-[0_0_12px_rgba(251,191,36,0.6)] xl:h-[75px]"
            formats={["avif", "webp"]}
            fallbackFormat="webp"
          />
        ) : (
          <h1 class="bg-gradient-to-r from-yellow-400 to-yellow-600 bg-clip-text text-3xl font-black tracking-wider text-transparent">HUAYPUNG</h1>
        )
      }
    </a>

    <div class="hidden h-full flex-1 items-center justify-center gap-6 lg:flex">
      {
        [
          { name: "หน้าแรก", path: "/" },
          { name: "ตรวจหวย", path: "/ตรวจหวย" },
          { name: "แนวทางหวย", path: "/แนวทาง" },
          { name: "โปรโมชั่น", path: "/promotion" },
          { name: "ติดต่อเรา", path: "/contact-us" },
        ].map((item) => (
          <a
            href={item.path}
            class={`group relative flex h-full items-center px-2 text-sm font-bold tracking-widest uppercase transition-colors ${isActive(item.path) ? "text-yellow-400" : "text-white/70 hover:text-white"}`}>
            <span>{item.name}</span>
            <div
              class={`absolute bottom-0 left-0 h-[4px] w-full bg-yellow-500 shadow-[0_-2px_10px_rgba(251,191,36,1)] transition-transform duration-300 ${isActive(item.path) ? "scale-x-100" : "scale-x-0 group-hover:scale-x-100"}`}
            />
          </a>
        ))
      }
    </div>

    <div class="z-[110] flex items-center gap-4">
      <a href="/login" class="hidden rounded-full border border-yellow-500/50 bg-red-950/50 px-6 py-2 text-sm font-bold text-yellow-500 transition-all hover:bg-red-900/50 lg:flex">เข้าแทงหวย</a>
      <a
        href="/register"
        class="hidden rounded-full bg-gradient-to-r from-yellow-500 to-yellow-300 px-6 py-2 text-sm font-black text-red-900 shadow-[0_0_15px_rgba(251,191,36,0.4)] transition-all hover:scale-105 lg:flex">
        สมัครสมาชิก
      </a>

      <button
        id="hamburger-btn"
        class="relative flex h-[45px] w-[45px] flex-col items-center justify-center gap-[6px] rounded-full border border-yellow-500/30 bg-[#2a0404] lg:hidden"
        aria-label="Menu">
        <span class="line-1 h-[2px] w-5 origin-center rounded-full bg-yellow-400 shadow-[0_0_5px_rgba(251,191,36,0.8)] transition-all duration-300"></span>
        <span class="line-2 h-[2px] w-5 origin-center rounded-full bg-yellow-400 shadow-[0_0_5px_rgba(251,191,36,0.8)] transition-all duration-300"></span>
        <span class="line-3 h-[2px] w-5 origin-center rounded-full bg-yellow-400 shadow-[0_0_5px_rgba(251,191,36,0.8)] transition-all duration-300"></span>
      </button>
    </div>
  </nav>

  <div
    id="mobile-menu"
    class="pointer-events-none absolute top-[80px] left-0 w-full origin-top -translate-y-4 scale-y-95 flex-col rounded-b-3xl border-b border-yellow-600/40 bg-[#2a0404]/98 px-6 pt-4 pb-8 opacity-0 shadow-2xl backdrop-blur-xl transition-all duration-300 lg:hidden">
    <div class="flex flex-col gap-2">
      {
        [
          { name: "หน้าแรก", path: "/" },
          { name: "ตรวจหวย", path: "/ตรวจหวย" },
          { name: "แนวทางหวย", path: "/แนวทาง" },
          { name: "โปรโมชั่น", path: "/promotion" },
          { name: "ติดต่อเรา", path: "/contact-us" },
        ].map((item) => (
          <a
            href={item.path}
            class={`flex items-center rounded-xl px-4 py-3 text-lg font-bold tracking-widest uppercase transition-colors ${isActive(item.path) ? "border-l-4 border-yellow-500 bg-red-900/30 pl-3 text-yellow-400" : "text-white/70 hover:bg-white/5 hover:text-white"}`}>
            {item.name}
          </a>
        ))
      }
    </div>
    <div class="mt-6 flex flex-col gap-4">
      <a
        href="/register"
        class="flex w-full justify-center rounded-full bg-gradient-to-r from-yellow-500 to-yellow-300 py-3.5 text-lg font-black text-red-900 shadow-[0_5px_15px_rgba(251,191,36,0.3)]">
        สมัครสมาชิก
      </a>
      <a href="/login" class="flex w-full justify-center rounded-full border border-yellow-500/50 bg-red-950/50 py-3.5 text-lg font-bold text-yellow-500">เข้าสู่ระบบ</a>
    </div>
  </div>
</header>

<style is:global>
  nav,
  header {
    font-family: "Kanit", sans-serif !important;
  }
  #hamburger-btn.active .line-1 {
    transform: translateY(8px) rotate(45deg);
  }
  #hamburger-btn.active .line-2 {
    opacity: 0;
  }
  #hamburger-btn.active .line-3 {
    transform: translateY(-8px) rotate(-45deg);
  }
  #mobile-menu.show {
    opacity: 1;
    transform: translateY(0) scaleY(100%);
    pointer-events: auto;
  }
</style>

<script>
  const hamburgerBtn = document.getElementById("hamburger-btn");
  const mobileMenu = document.getElementById("mobile-menu");
  hamburgerBtn?.addEventListener("click", () => {
    hamburgerBtn.classList.toggle("active");
    mobileMenu?.classList.toggle("show");
  });
</script>
