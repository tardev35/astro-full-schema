---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementCyber.astro";
import { pageGraph } from "../lib/schema";

const pageTitle = "เกี่ยวกับเรา DOLLAR789 คาสิโนสด บาคาร่า สล็อต และฟุตบอลในยูสเดียว";

const pageHeading = "เกี่ยวกับเรา DOLLAR789 รวมคาสิโนสด บาคาร่า สล็อต และฟุตบอลไว้ในยูสเดียว";

const pageDescription =
  "เกี่ยวกับเรา DOLLAR789 หน้ารวมข้อมูลเว็บที่รวมคาสิโนสด บาคาร่า สล็อต และฟุตบอล พร้อมหน้าเมมเบอร์ โปรสมาชิก และระบบฝากถอนออโต้ไว้ในยูสเดียว รองรับมือถือ";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox as="h1" title={pageHeading}>
    <p class="mb-4 text-left text-base leading-relaxed text-[#e7dcf7]">
      <strong class="text-[#f5c542]">DOLLAR789</strong> รวมคาสิโนสด บาคาร่า สล็อต และฟุตบอลไว้ในยูสเดียว เข้าสู่ระบบครั้งเดียวแล้วเลือกโต๊ะ เช็กเครดิต ดูโปรที่เปิดอยู่ หรือย้อนดูประวัติรายการต่อได้ทันที
    </p>

    <p class="text-left text-base leading-relaxed text-[#e7dcf7]">
      ที่รวมไว้จุดเดียวไม่ใช่เพราะอยากให้เมนูดูเยอะ แต่เพราะการสลับเว็บกลางเกมคือจังหวะที่คนเล่นเสียไปเปล่า ๆ ใช้ได้ทั้งบนมือถือและคอมพิวเตอร์ด้วยยูสเดิม
    </p>
  </ContentBox>

  <ContentBox as="h2" title="DOLLAR789 วางคาสิโนสดและบาคาร่าไว้เป็นหมวดหลักอย่างไร">
    <p class="mb-4 text-left text-base leading-relaxed text-[#e7dcf7]">
      คาสิโนสดของ DOLLAR789 เน้นห้องเล่นแบบเรียลไทม์ที่มีบาคาร่าเป็นตัวหลัก เหมาะทั้งคนที่มีโต๊ะประจำและสายที่ชอบไล่ดูหลายห้องก่อนลงเดิมพัน
    </p>

    <p class="mb-4 text-left text-base leading-relaxed text-[#e7dcf7]">
      เลือกบรรยากาศและรูปแบบที่ตัวเองถนัดก่อนเข้าโต๊ะได้ ไม่ต้องรีบตามใคร เซียนจริงไม่ได้เข้าโต๊ะเร็วที่สุด แต่รู้ว่าตัวเองกำลังจะเล่นอะไร
    </p>

    <p class="mb-4 text-left text-base leading-relaxed text-[#e7dcf7]">
      สายบาคาร่าแต่ละคนเล่นคนละแบบ บางคนชอบโต๊ะไหลไว บางคนดูเค้าไพ่ก่อน บางคนแค่อยากได้ห้องที่ภาพชัดและเข้าเดิมพันง่าย ตัวเลือกโต๊ะจึงสำคัญพอ ๆ กับจำนวนเกม
    </p>

    <p class="text-left text-base leading-relaxed text-[#e7dcf7]">
      โต๊ะนี้ไม่ใช่ก็ย้ายจากยูสเดิมได้ วันไหนไม่อยากนั่งโต๊ะสดก็เปลี่ยนไปเล่นสล็อตหรือเปิดหมวดกีฬาตามคู่บอลที่ติดตามอยู่
    </p>
  </ContentBox>

  <ContentBox as="h2" title="เข้าสู่ระบบ DOLLAR789 แล้วใช้งานหน้าเมมเบอร์ส่วนไหนได้บ้าง">
    <p class="mb-4 text-left text-base leading-relaxed text-[#e7dcf7]">
      หลังเข้าสู่ระบบ เลือกห้องคาสิโนสด เปิดสล็อต ดูเครดิต และเช็กโปรได้จากหน้าเดียว ใช้งานได้ทั้งบนมือถือและคอมพิวเตอร์ด้วยยูสเดิม
    </p>

    <p class="mb-4 text-left text-base leading-relaxed text-[#e7dcf7]">
      เมนูสำคัญจัดไว้ให้กดถึงได้เร็ว เพราะการล็อกอินควรเป็นประตูเข้าเกม ไม่ใช่ด่านทดสอบความอดทนก่อนเริ่มใช้งาน
    </p>

    <p class="mb-4 text-left text-base leading-relaxed text-[#e7dcf7]">
      หน้าเมมเบอร์รวมเครดิต โปร และประวัติรายการไว้ในพื้นที่เดียว จึงตรวจสอบได้ว่าทำรายการไหนไปแล้ว ใช้สิทธิ์โปรใดอยู่ และเหลือยอดเท่าไร
    </p>

    <p class="text-left text-base leading-relaxed text-[#e7dcf7]">
      คนเล่นดูจากตรงนี้เป็นหลักว่าเครดิตขึ้นตรงไหม รายการย้อนหลังหาเจอไหม เปลี่ยนเครื่องแล้วข้อมูลยังอยู่ครบไหม เงินอยู่ตรงไหนต้องรู้ เกมอยู่ตรงไหนค่อยว่ากัน
    </p>
  </ContentBox>

  <ContentBox as="h2" title="โปรสมาชิกใหม่ของ DOLLAR789 ควรดูตรงไหนก่อนกดรับ">
    <p class="mb-4 text-left text-base leading-relaxed text-[#e7dcf7]">
      ก่อนกดรับ ดูยอดรับ เงื่อนไข เทิร์น และช่วงเวลาที่ใช้ได้ให้ครบ เพราะโบนัสเยอะไม่ได้แปลว่าเหมาะกับทุกยูส
    </p>

    <p class="mb-4 text-left text-base leading-relaxed text-[#e7dcf7]">
      DOLLAR789 มีพื้นที่โปรให้สมาชิกเช็กสิทธิ์ที่เปิดอยู่ก่อนใช้งาน ดูได้ในที่เดียวว่าตอนนี้มีอะไรใช้ได้บ้าง และแต่ละรายการผูกกับหมวดไหน
    </p>

    <p class="text-left text-base leading-relaxed text-[#e7dcf7]">
      เลือกโปรให้เข้ากับแนวเล่นของตัวเอง ดีกว่ารับทุกอันจนจำไม่ได้ว่าเครดิตก้อนไหนติดเงื่อนไขอะไร โปรมีไว้เพิ่มความคุ้ม ไม่ใช่เพิ่มภาระอ่านตัวเล็กสิบหน้า
    </p>
  </ContentBox>

  <ContentBox as="h2" title="ระบบฝากถอนออโต้ของ DOLLAR789 จัดการเครดิตสะดวกแค่ไหน">
    <p class="mb-4 text-left text-base leading-relaxed text-[#e7dcf7]">
      ระบบออโต้ลดช่วงรอระหว่างฝากเข้า เครดิตขึ้น และเข้าเกม รวมถึงตอนถอนออก ส่งรายการและเช็กยอดได้จากหน้าเดียว ตลอด 24 ชั่วโมง จากอุปกรณ์เดิม
    </p>

    <p class="mb-4 text-left text-base leading-relaxed text-[#e7dcf7]">
      เมื่อเชื่อมเข้ากับหน้าเมมเบอร์ การจัดการเงินจึงอยู่ในระบบเดียวกับเกม ดูยอดและย้อนดูรายการได้จากจุดเดียว
    </p>

    <p class="mb-4 text-left text-base leading-relaxed text-[#e7dcf7]">
      เวลาอยากเปลี่ยนโต๊ะหรือพักเกม ไม่มีใครอยากมานั่งไล่ถามว่ารายการถึงไหนแล้ว ระบบการเงินที่ดีควรอยู่หลังฉากและทำงานของมันไปเงียบ ๆ
    </p>

    <p class="text-left text-base leading-relaxed text-[#e7dcf7]">
      และขอย้ำไว้ตรงนี้ ไม่ควรส่งรหัสผ่านหรือรหัส OTP ให้บุคคลอื่นไม่ว่ากรณีใด
    </p>
  </ContentBox>

  <ContentBox as="h2" title="ทางเข้าและการสมัครสมาชิกผ่านมือถือใช้งานง่ายแค่ไหน">
    <p class="mb-4 text-left text-base leading-relaxed text-[#e7dcf7]">
      สมัครผ่านมือถือเริ่มจากกรอกข้อมูล เปิดยูส และยืนยันตามขั้นตอนของระบบ จากนั้นล็อกอินเข้าหน้าเมมเบอร์เพื่อดูเกม เครดิต และโปรที่ใช้งานได้ทันที
    </p>

    <p class="mb-4 text-left text-base leading-relaxed text-[#e7dcf7]">
      โครงแบบนี้เหมาะกับคนที่ใช้มือถือเป็นหลักและอยากจบทุกอย่างจากเครื่องเดียว
    </p>

    <p class="mb-4 text-left text-base leading-relaxed text-[#e7dcf7]">
      จำทางเข้าหลักหรือหน้าล็อกอินที่ใช้อยู่ประจำไว้ จะกลับเข้าหน้าเมมเบอร์ เช็กเครดิต และกลับโต๊ะเดิมได้ไว ทั้งยังช่วยลดความสับสนจากชื่อเว็บคล้ายกันบนผลค้นหา
    </p>

    <p class="text-left text-base leading-relaxed text-[#e7dcf7]">
      DOLLAR789 รองรับทั้งมือถือและคอมด้วยยูสเดียว สลับอุปกรณ์ได้โดยไม่ต้องเริ่มใหม่ ส่วนความเร็วในการโหลดห้องเกมขึ้นอยู่กับเครื่อง เบราว์เซอร์ และสัญญาณอินเทอร์เน็ตของแต่ละคน
    </p>
  </ContentBox>

  <ContentBox as="h2" title="DOLLAR789 เหมาะกับนักเล่นแบบไหน">
    <p class="mb-4 text-left text-base leading-relaxed text-[#e7dcf7]">
      เหมาะกับคนที่มีบาคาร่าเป็นเกมหลักแต่ไม่ได้เล่นอย่างเดียว อยากมีคาสิโนสด สล็อต บอล โปร และระบบฝากถอนอยู่ในยูสเดียว โดยเน้นใช้งานผ่านมือถือเป็นหลัก
    </p>

    <p class="mb-4 text-left text-base leading-relaxed text-[#e7dcf7]">
      เลือกโต๊ะที่ถูกใจ เช็กโปรที่เหมาะกับงบ แล้วจัดการเครดิตต่อได้จากที่เดียว หลายเกมมีไว้เลือก ส่วนหลายบัญชีส่วนใหญ่มีไว้ลืมรหัส
    </p>

    <p class="mb-4 text-left text-base leading-relaxed text-[#e7dcf7]">
      ถ้าคุณเป็นสายเปิดมือถือแล้วอยากเข้าโต๊ะเร็ว เช็กเครดิตง่าย และเปลี่ยนโหมดตามอารมณ์ได้โดยไม่วุ่นหลายบัญชี โครงแบบนี้ตอบโจทย์ค่อนข้างตรง
    </p>

    <p class="text-left text-base leading-relaxed text-[#e7dcf7]">
      เลือกเกมที่สนุกกับตัวเองก่อน แล้วค่อยให้ระบบที่เหลือทำงานตามหน้าที่ของมันไป
    </p>
  </ContentBox>

  <Navfoot />
</MainLayout>
