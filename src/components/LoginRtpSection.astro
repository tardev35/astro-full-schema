---
import ContentBoxTwo from "./ContentBoxTwo.astro";

const steps = [
  { icon: "📝", name: "สมัครยูสเดียวใช้ได้ทุกบริการ", detail: "กรอกข้อมูลไม่กี่ช่องก็เข้าหน้าเมมเบอร์ได้ ใช้ยูสเดิมทั้งสล็อต คาสิโนสด หวย และกีฬา", tag: "ขั้นที่ 1" },
  { icon: "💳", name: "ฝากจากเมนูเดียวในหน้าเมมเบอร์", detail: "เลือกเมนูฝาก ทำรายการผ่าน True Wallet หรือบัญชีธนาคารตามช่องทางที่ระบบเปิดให้บริการ", tag: "ขั้นที่ 2" },
  { icon: "⏱️", name: "ระบบออโต้ตัดยอดและแจ้งสถานะเอง", detail: "ไม่ต้องสลับไปหลายหน้าเพื่อทำเรื่องเดียว สถานะรายการฝากถอนแสดงอยู่ในหน้าเมมเบอร์ของตัวเอง", tag: "ขั้นที่ 3" },
  { icon: "🎮", name: "เลือกบริการที่อยากเล่นในวันนั้น", detail: "สล็อตจาก PG Slot, Joker Gaming, Jili คาสิโนสดจาก SA Gaming หวยออนไลน์ หรือแทงบอล อยู่ในเมนูเดียวกัน", tag: "ขั้นที่ 4" },
  { icon: "🎁", name: "เช็กหน้ากิจกรรมรับเครดิตก่อนเริ่มเล่น", detail: "คืนยอดเสีย เช็กอิน กงล้อ และกรอกโค้ด ใช้เงื่อนไขคนละแบบ สิทธิ์ที่บัญชีมีวันนี้อาจไม่เหมือนเมื่อวาน", tag: "ขั้นที่ 5" },
];

const chips = ["ยูสเดียวครบ", "ฝากถอนออโต้", "True Wallet", "คาสิโนสด", "หวยออนไลน์", "แทงบอล", "PG Slot", "Joker Gaming", "Jili", "SA Gaming"];
---

<ContentBoxTwo titleleft="เข้าสู่ระบบ PAYDAY24" titleright="ลำดับการใช้งานตั้งแต่สมัครถึงถอนยอด" label="เข้าสู่ระบบ PAYDAY24 และลำดับการใช้งานตั้งแต่สมัครถึงถอนยอด">
  <div slot="left" class="flex h-full flex-col gap-4">
    <div class="relative overflow-hidden rounded-2xl border border-[#a86f00]/55 bg-[#2c1247] p-6 shadow-[0_10px_30px_rgba(253,199,0,0.16)]">
      <div aria-hidden="true" class="pointer-events-none absolute -top-10 -right-10 h-32 w-32 rounded-full bg-[#fdc700]/14 blur-[50px]"></div>

      <div class="relative z-10 mb-5 flex items-center gap-3">
        <span
          aria-hidden="true"
          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#ffe680]/55 bg-gradient-to-br from-[#ffe680] via-[#fdc700] to-[#a86f00] text-xl shadow-inner">
          🎲
        </span>
        <div class="flex flex-col">
          <p class="text-base font-black text-[#ffe680]">ล็อกอินแล้วเลือกบริการที่อยากเล่นต่อได้ทันที</p>
          <span class="text-[11px] text-[#c4b5e8]">
            ยูสเดียวเข้าได้ทั้งสล็อต คาสิโนสด บาคาร่า หวย และกีฬา ยอดฝากถอนเดินผ่านระบบออโต้ชุดเดียวกัน รองรับ True Wallet เช็กเครดิต ดูกิจกรรมรับเครดิต และย้อนดูประวัติรายการได้จากหน้าเมมเบอร์
          </span>
        </div>
      </div>

      <div class="relative z-10 flex flex-col gap-3.5">
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#fdc700]">👤</span>
          <input
            type="text"
            placeholder="เบอร์โทรศัพท์ / ยูสเซอร์เนม"
            class="w-full rounded-xl border border-[#a86f00]/60 bg-[#150726] py-3 pr-4 pl-12 text-[#ede4fb] transition-all outline-none placeholder:text-[#c4b5e8] focus:border-[#fdc700] focus:ring-1 focus:ring-[#fdc700]/40"
          />
        </div>
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#fdc700]">🔑</span>
          <input
            type="password"
            placeholder="รหัส PIN 4 หลัก"
            class="w-full rounded-xl border border-[#a86f00]/60 bg-[#150726] py-3 pr-4 pl-12 text-[#ede4fb] transition-all outline-none placeholder:text-[#c4b5e8] focus:border-[#fdc700] focus:ring-1 focus:ring-[#fdc700]/40"
          />
        </div>

        <div class="flex items-center justify-between px-1 text-xs">
          <label class="flex items-center gap-2 text-[#c4b5e8]">
            <input type="checkbox" class="h-3.5 w-3.5 rounded border-[#a86f00]/60 bg-[#150726] accent-[#fdc700]" />
            จดจำฉันไว้
          </label>
          <a href="/login" class="text-[#c4b5e8] transition-colors hover:text-[#ffe680]">ลืมรหัส PIN?</a>
        </div>

        <button
          class="mt-1 w-full rounded-xl border border-[#ffe680]/50 bg-gradient-to-r from-[#ffe680] via-[#fdc700] to-[#d99400] p-3.5 font-black text-[#150726] shadow-[0_10px_30px_rgba(253,199,0,0.28)] transition-all hover:scale-[1.02] hover:shadow-[0_15px_40px_rgba(253,199,0,0.38)]">
          เข้าสู่ระบบ
        </button>

        <div class="flex items-center gap-3 py-1 text-[11px] text-[#c4b5e8]">
          <span class="h-px flex-1 bg-[#a86f00]/55"></span>
          หรือ
          <span class="h-px flex-1 bg-[#a86f00]/55"></span>
        </div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] p-3 text-sm font-bold text-white shadow-md transition-all hover:scale-[1.02]">
          <span aria-hidden="true">💬</span> ทักไลน์ทีมงานตลอด 24 ชั่วโมง
        </a>

        <div class="mt-1 flex items-center justify-between px-1">
          <div class="flex gap-2">
            <span class="rounded-full border border-[#a86f00]/60 bg-[#1c0a30] px-2.5 py-1 text-[10px] font-bold text-[#ffe680]"><span aria-hidden="true">🔒</span> เข้ารหัสข้อมูล</span>
            <span class="rounded-full border border-[#a855f7]/55 bg-[#241040] px-2.5 py-1 text-[10px] font-bold text-[#c98bff]"><span aria-hidden="true">🕐</span> ใช้งานได้ตลอด 24 ชม.</span>
          </div>
          <a href="/register" class="text-xs font-bold text-[#c4b5e8] transition-colors hover:text-[#ffe680]">สมัครสมาชิกใหม่</a>
        </div>
      </div>
    </div>
  </div>

  <div slot="right" class="h-full">
    <div class="flex h-full flex-col rounded-2xl border border-[#a86f00]/55 bg-[#2c1247] p-5 shadow-[0_10px_30px_rgba(253,199,0,0.16)]">
      <div class="mb-5 flex items-center justify-between gap-3">
        <div>
          <span class="text-xs font-bold tracking-wide text-[#c4b5e8]">ลำดับการใช้งานที่ PAYDAY24 วางไว้ ตั้งแต่สมัครยูสจนถอนยอดออก อยู่ในระบบออโต้ชุดเดียวกันทั้งหมด</span>
          <div class="bg-gradient-to-r from-[#ffe680] via-[#fdc700] to-[#d99400] bg-clip-text text-2xl font-black text-transparent sm:text-3xl">สมัคร • ฝาก • เล่น • ถอน</div>
        </div>
        <span class="flex items-center gap-1.5 self-start rounded-full border border-[#a855f7]/55 bg-[#241040] px-2.5 py-1">
          <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#a855f7] shadow-[0_0_8px_rgba(168,85,247,0.7)]"></span>
          <span class="text-[10px] font-bold tracking-widest text-[#c98bff] uppercase">Live</span>
        </span>
      </div>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#c4b5e8] uppercase">
        <span>ขั้นตอนการใช้งาน</span>
        <span>ลำดับ</span>
      </div>

      <div class="flex flex-1 flex-col gap-2.5">
        {
          steps.map((s) => (
            <div class="rounded-xl border border-[#a86f00]/45 bg-[#1c0a30] px-3.5 py-2.5 transition-colors hover:border-[#fdc700]/65 hover:bg-[#331652]">
              <div class="flex items-center justify-between gap-2 text-sm">
                <span class="flex min-w-0 items-center gap-2 font-bold text-[#ede4fb]">
                  <span aria-hidden="true" class="w-5 shrink-0 text-center">
                    {s.icon}
                  </span>{" "}
                  <span class="truncate">{s.name}</span>
                </span>
                <span class="shrink-0 rounded-full border border-[#a855f7]/55 bg-[#241040] px-2.5 py-0.5 text-[10px] font-bold text-[#c98bff]">{s.tag}</span>
              </div>
              <div class="mt-1.5 text-[11px] tracking-wide text-[#c4b5e8]">{s.detail}</div>
            </div>
          ))
        }
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
        {chips.map((c) => <span class="rounded-full border border-[#a86f00]/45 bg-[#1c0a30] px-3 py-1 text-[10px] font-bold text-[#ffe680]">{c}</span>)}
      </div>

      <div class="mt-3 text-center text-[10px] tracking-wide text-[#c4b5e8]">
        ลำดับในตารางสรุปจากที่หน้าเว็บแสดงไว้ รายละเอียดของค่ายเกม เงื่อนไขเครดิต และรายการที่เปิดให้บริการจริงให้ยึดตามหน้าเมมเบอร์ของ PAYDAY24 ก่อนทำรายการทุกครั้ง และอย่าบอกรหัสผ่านหรือ OTP กับใคร
        หากติดขัดตรงไหนทักไลน์ทีมงานได้ตลอด 24 ชั่วโมง
      </div>
    </div>
  </div>
</ContentBoxTwo>
