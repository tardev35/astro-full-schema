---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";
import { pageGraph } from "../lib/schema";

const pageTitle = "เกี่ยวกับเรา RIEL38 เว็บสล็อตมาใหม่ รวมกว่า 2,000 เกมในบัญชีเดียว";

const pageHeading = "เกี่ยวกับเรา RIEL38 เว็บสล็อตมาใหม่ที่วางระบบ AI ไว้หลังบ้าน";

const pageDescription =
  "เกี่ยวกับเรา RIEL38 เว็บสล็อตมาใหม่ที่รวมเกมกว่า 2,000 เกมจาก 30+ ค่ายไว้ในบัญชีเดียว พร้อม Smart Wallet รวมเครดิตจุดเดียว ระบบ AI หลังบ้าน และโหมดทดลองเล่นฟรี";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox as="h1" title={pageHeading}>
    <p class="mb-4 text-left text-base leading-relaxed text-[#5b2140]">
      <strong class="text-[#9d174d]">RIEL38</strong> เปิดตัวในฐานะเว็บสล็อตมาใหม่ที่ไม่ได้ตั้งต้นจากจำนวนเกม แต่ตั้งต้นจากคำถามว่าอะไรบ้างที่คนเล่นไม่ควรต้องจัดการเอง
    </p>

    <p class="mb-4 text-left text-base leading-relaxed text-[#5b2140]">
      คำตอบกลายเป็นโครงของเว็บทั้งหมด บัญชีเดียวครอบคลุมทุกค่าย เครดิตอยู่ใน Smart Wallet ก้อนเดียว และมีระบบ AI คอยรวบรวมข้อมูลเกมกับบัญชีไว้ให้ดูจากหน้าเมมเบอร์
    </p>

    <p class="text-left text-base leading-relaxed text-[#5b2140]">ชื่อ เรียล38 มาจากคำว่าเรียลไทม์ ไม่ได้มาจากโชคลาง</p>
  </ContentBox>

  <ContentBox as="h2" title="จุดเริ่มต้นของ RIEL38 กับโจทย์ที่ตั้งไว้ตั้งแต่วันแรก">
    <p class="mb-4 text-left text-base leading-relaxed text-[#5b2140]">
      คนเล่นสล็อตทุกวันนี้เปิดเว็บจากมือถือเป็นหลัก เล่นสั้นลงแต่บ่อยขึ้น และเลิกอดทนกับเว็บที่ต้องกดหลายชั้นกว่าจะถึงหน้าเกม
    </p>

    <p class="mb-4 text-left text-base leading-relaxed text-[#5b2140]">
      โจทย์ของ RIEL38 จึงไม่ใช่การเพิ่มฟีเจอร์ แต่เป็นการตัดขั้นตอนที่ไม่จำเป็นออก ตั้งแต่ล็อกอิน เลือกค่าย เช็กเครดิต ไปจนถึงกลับเข้าเกมที่ค้างไว้
    </p>

    <p class="text-left text-base leading-relaxed text-[#5b2140]">เกมเยอะเป็นเรื่องพื้นฐานไปแล้ว ที่ยังต่างกันคือเข้าเกมง่ายแค่ไหน</p>
  </ContentBox>

  <ContentBox as="h2" title="ระบบ AI หลังบ้านของ RIEL38 ทำอะไร และไม่ทำอะไร">
    <p class="mb-4 text-left text-base leading-relaxed text-[#5b2140]">
      เริ่มจากส่วนที่มันไม่ทำก่อน AI หลังบ้านไม่ได้ทำนายว่าเกมไหนจะแตกหรือรอบไหนจะจ่าย ไม่มีระบบไหนรู้เรื่องนั้น และเราไม่เคยบอกว่ามันรู้
    </p>

    <p class="mb-4 text-left text-base leading-relaxed text-[#5b2140]">
      สิ่งที่มันทำคือหยิบข้อมูลที่ระบบมีอยู่แล้วมาเรียงให้อ่านง่าย ทั้งเกมที่เล่นบ่อย ค่า RTP ที่แต่ละค่ายประกาศไว้ โบนัสที่ยังใช้ได้ และยอดเครดิตคงเหลือ
    </p>

    <p class="mb-4 text-left text-base leading-relaxed text-[#5b2140]">เทียบง่ายๆ คือเลขาส่วนตัวที่จำแทนให้ ไม่ใช่หมอดู</p>

    <p class="text-left text-base leading-relaxed text-[#5b2140]">
      ผลที่ได้จริงคือเวลาที่เคยหมดไปกับการไล่หาข้อมูลเอง ถูกคืนกลับมาให้ใช้กับการเล่น
    </p>
  </ContentBox>

  <ContentBox as="h2" title="Smart Wallet กับเหตุผลที่เครดิตควรตามคนเล่นไป">
    <p class="mb-4 text-left text-base leading-relaxed text-[#5b2140]">
      Smart Wallet เป็นศูนย์กลางของเครดิตในระบบสมาชิก สลับจากค่ายหนึ่งไปอีกค่ายได้โดยไม่ต้องโยกเงินเอง และไม่ต้องจำว่ากระเป๋าไหนเหลือเท่าไร
    </p>

    <p class="mb-4 text-left text-base leading-relaxed text-[#5b2140]">
      สำหรับคนที่เปลี่ยนเกมบ่อย จุดนี้ต่างกันชัดเจน เพราะสิ่งที่อยากเปลี่ยนคือเกม ไม่ใช่ขั้นตอนจัดการเงิน
    </p>

    <p class="text-left text-base leading-relaxed text-[#5b2140]">ระบบกระเป๋าที่ดีควรทำให้เครดิตตามเราไป ไม่ใช่ให้เราวิ่งตามเครดิต</p>
  </ContentBox>

  <ContentBox as="h2" title="กว่า 2,000 เกมจาก 30+ ค่าย ทำไมจำนวนอย่างเดียวไม่ใช่คำตอบ">
    <p class="mb-4 text-left text-base leading-relaxed text-[#5b2140]">
      ในระบบมีเกมให้เลือกกว่า 2,000 เกม จากค่ายชั้นนำมากกว่า 30 ค่าย ทั้ง PG Soft, Pragmatic Play, JILI, Joker Gaming และ Habanero
    </p>

    <p class="mb-4 text-left text-base leading-relaxed text-[#5b2140]">
      ข้อดีของการมีหลายค่ายไม่ได้อยู่ที่ตัวเลข แต่อยู่ที่การเลือกตามสไตล์ตัวเองได้ บางค่ายเด่นเรื่องฟรีสปิน บางค่ายเกมเดินเร็ว บางค่ายเน้นฟีเจอร์และตัวคูณ
    </p>

    <p class="text-left text-base leading-relaxed text-[#5b2140]">วันไหนอยากเล่นไว วันไหนอยากนั่งรอโบนัส ก็ไม่ต้องเปลี่ยนเว็บตามอารมณ์</p>
  </ContentBox>

  <ContentBox as="h2" title="โหมดทดลองเล่นฟรี ส่วนที่เราไม่ได้คิดว่าเป็นของแถม">
    <p class="mb-4 text-left text-base leading-relaxed text-[#5b2140]">
      โหมดทดลองเปิดไว้ให้ดูรูปแบบเกม ฟีเจอร์ และเดิมพันต่อรอบ ก่อนตัดสินใจลงเครดิตจริง ทั้งหมดเป็นเครดิตสมมติ จึงลองผิดลองถูกได้เต็มที่
    </p>

    <p class="mb-4 text-left text-base leading-relaxed text-[#5b2140]">เครดิตในโหมดทดลองถอนไม่ได้ และไม่นับเป็นยอดเทิร์นของโปรใดๆ</p>

    <p class="text-left text-base leading-relaxed text-[#5b2140]">
      ไม่ใช่ทุกเกมที่มีปุ่มทดลอง แต่ค่ายหลักที่คนเล่นถามหาบ่อยเปิดโหมดนี้ไว้ให้ลองก่อนเสมอ
    </p>
  </ContentBox>

  <ContentBox as="h2" title="เข้าสู่ระบบจากมือถือ แท็บเล็ต หรือคอม ด้วยยูสเดิม">
    <p class="mb-4 text-left text-base leading-relaxed text-[#5b2140]">
      สมาชิกใช้ยูสเดิมล็อกอินได้จากทุกเครื่อง เปิดผ่านเบราว์เซอร์ได้ตรงๆ ไม่ต้องโหลดแอปและไม่ต้องติดตั้งโปรแกรมเพิ่ม
    </p>

    <p class="mb-4 text-left text-base leading-relaxed text-[#5b2140]">
      ข้อมูลบัญชี ประวัติรายการ และเครดิตยังเป็นชุดเดียวกันทุกอุปกรณ์ เริ่มเล่นจากมือถือตอนกลางวันแล้วมาต่อบนคอมตอนดึกก็ไม่ต้องเริ่มใหม่
    </p>

    <p class="text-left text-base leading-relaxed text-[#5b2140]">คนส่วนใหญ่ตัดสินเว็บภายในไม่กี่วินาทีแรกบนมือถือ</p>
  </ContentBox>

  <ContentBox as="h2" title="RIEL38 เหมาะกับคนเล่นสล็อตแบบไหน">
    <p class="mb-4 text-left text-base leading-relaxed text-[#5b2140]">
      RIEL38 เหมาะกับคนที่เล่นหลายค่าย ชอบตามเกมเปิดใหม่ ใช้มือถือเป็นเครื่องหลัก และอยากให้เครดิต โปรโมชั่น กับประวัติรายการอยู่ในระบบเดียวกัน
    </p>

    <p class="mb-4 text-left text-base leading-relaxed text-[#5b2140]">
      ถ้าเป็นสายลองก่อนตัดสินใจ โหมดทดลองกับข้อมูลที่ระบบสรุปไว้ก็ช่วยให้เลือกเกมได้เร็วขึ้น เพื่อประสบการณ์การเล่นที่คุ้มค่าและต่อเนื่องกว่าที่เคย
    </p>

    <p class="text-left text-base leading-relaxed text-[#5b2140]">เว็บที่คนกลับมาเล่นซ้ำ มักไม่ใช่เว็บที่พูดเก่งที่สุด แต่เป็นเว็บที่ไม่ทำให้เสียเวลา</p>
  </ContentBox>

  <Navfoot />
</MainLayout>
