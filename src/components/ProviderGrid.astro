---
import { BRAND_NAME } from "../lib/brandProfile";

const providers = [
  { name: "PG Soft", desc: "ค่ายของ Treasures of Aztec สายรอบฟรีสปินที่ตัวคูณขยับขึ้นเมื่อชนะติดกัน", tag: "ฟรีสปิน", icon: "🏺" },
  { name: "Pragmatic Play", desc: "ค่ายของ Sweet Bonanza สัญลักษณ์ร่วงหล่นต่อเนื่อง มีปุ่มซื้อฟีเจอร์สำหรับคนทุนพร้อม", tag: "ซื้อฟีเจอร์", icon: "🍭" },
  { name: "JILI", desc: "ค่ายของ Fortune Gems วงล้อตัวคูณด้านข้างสุ่มให้ทุกรอบ จังหวะไว เล่นทีละช่วงสั้นได้", tag: "ตัวคูณ", icon: "💎" },
  { name: "Joker Gaming", desc: "ค่ายของ Roma เกมคลาสสิกที่คนไทยคุ้น กติกาเข้าใจง่าย เหมาะกับคนเพิ่งเริ่ม", tag: "คลาสสิก", icon: "🏛️" },
];

const gridTitle = `ค่ายสล็อตที่ ${BRAND_NAME} รวมไว้ในเว็บเดียว`;
---

<section aria-label={gridTitle} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-6 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="text-3xl leading-normal font-black tracking-wide text-[#141414]">{gridTitle}</p>
    <div aria-hidden="true" class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#ec1b24] to-transparent"></div>
  </div>

  <p class="mb-8 text-left text-base leading-relaxed text-[#2b2627]">
    {BRAND_NAME} รวมค่ายที่สายปั่นไทยเปิดบ่อยไว้ในเว็บเดียว ทั้ง PG Soft, Pragmatic Play, JILI และ Joker Gaming เลือกค่ายจากการ์ดด้านล่าง แล้วดูกลไกฟรีสปิน ตัวคูณ และเบทต่ำสุดของเกมนั้นก่อนเริ่มปั่น
  </p>

  <div class="grid grid-cols-2 gap-4 lg:grid-cols-4 lg:gap-5">
    {
      providers.map((provider) => (
        <a
          href="/register/"
          class="group relative isolate flex flex-col items-center justify-center overflow-hidden rounded-2xl border border-[#f1d2d3] bg-white p-5 shadow-[0_10px_30px_rgba(20,20,20,0.06)] transition-all duration-300 hover:-translate-y-2 hover:border-[#ec1b24]/55 hover:bg-[#fff5f5] hover:shadow-[0_15px_40px_rgba(236,27,36,0.16)]">
          <div class="absolute top-2 right-2 z-10 rounded-full bg-gradient-to-b from-[#ff4d55] to-[#d0121b] px-2 py-0.5 text-[10px] font-black tracking-wide whitespace-nowrap text-white shadow-sm transition-transform duration-300 group-hover:scale-110">
            {provider.tag}
          </div>

          <div aria-hidden="true" class="mt-3 mb-3 text-4xl transition-transform duration-300 group-hover:scale-125 group-hover:rotate-3">
            {provider.icon}
          </div>
          <p class="text-center text-base font-black text-[#141414] transition-colors group-hover:text-[#b5121a]">{provider.name}</p>
          <p class="mt-1 text-center text-xs leading-relaxed text-[#6b6264]">{provider.desc}</p>

          <span class="relative z-10 mt-4 block w-full rounded-full border border-[#f1d2d3] bg-[#fff5f5] py-1.5 text-center text-xs font-bold text-[#b5121a] transition-colors duration-300 group-hover:border-transparent group-hover:bg-gradient-to-b group-hover:from-[#ff4d55] group-hover:to-[#d0121b] group-hover:text-white">
            สมัครเข้าเล่น
          </span>
        </a>
      ))
    }
  </div>
</section>
