---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementCyber.astro";
import { pageGraph } from "../lib/schema";

const pageTitle = "เกี่ยวกับเรา VODKAFUN สล็อตเว็บตรงเว็บใหญ่ ลิขสิทธิ์แท้100%";

const pageHeading = "เกี่ยวกับเรา VODKAFUN สล็อตเว็บตรงเว็บใหญ่ ที่อยากให้คุณอยู่แล้วสบายใจ";

const pageDescription =
  "รู้จัก VODKAFUN สล็อตเว็บตรงเว็บใหญ่ ลิขสิทธิ์แท้100% เชื่อม API จากค่ายแม่โดยตรง สมัครฟรีไม่ต้องฝากก่อน ฝากถอน AI Auto 2–5 วินาที ไม่มีขั้นต่ำ กระเป๋าเดียว";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox as="h1" title={pageHeading}>
    <p class="mb-4 text-left text-base leading-relaxed">
      <strong class="text-[#ff8fe0]">VODKAFUN</strong> หรือวอดก้าฟัน คือสล็อตเว็บตรงเว็บใหญ่ที่ฐานระบบทั้งหมดเป็นของแท้จากค่ายเกมแม่ สมาชิกใช้ยูสเซอร์เดียวเข้าเล่นได้ทั้งมือถือและคอมพิวเตอร์ โดยไม่ต้องโหลดแอปเพิ่ม
    </p>

    <p class="mb-4 text-left text-base leading-relaxed">
      เรามองตัวเองเหมือนบาร์เทนเดอร์ที่คัดของก่อนเสิร์ฟ เกมที่ขึ้นเมนูต้องมาจากค่ายต้นสังกัดโดยตรง และระบบหลังบ้านต้องนิ่งพอให้สมาชิกไม่ต้องคอยลุ้นเรื่องอื่นนอกจากเกม
    </p>

    <p class="mb-4 text-left text-base leading-relaxed">
      หลายคนย้ายมาเพราะเจอปัญหาเดิม ๆ จากที่อื่น ทั้งล็อกยูสและถอนยาก หน้านี้จึงเล่าตรง ๆ ว่าเว็บทำงานอย่างไรในแต่ละเรื่อง
    </p>

    <p class="text-left text-base leading-relaxed">ร้านที่คิดจะเปิดทุกคืน ไม่มีเหตุผลต้องโกงแก้วแรกของลูกค้า</p>
  </ContentBox>

  <ContentBox as="h2" title="ลิขสิทธิ์แท้100% เชื่อม API ค่ายแม่โดยตรง ไม่ปรับเรท ไม่ล็อกยูส">
    <p class="mb-4 text-left text-base leading-relaxed">
      ทุกเกมบน VODKAFUN เชื่อมผ่าน API ของค่ายต้นสังกัดแบบเรียลไทม์ ตัวเกมส่งตรงมาพร้อมค่า RTP เดิมที่ค่ายกำหนด เว็บไม่ได้เข้าไปแต่งหรือปรับอัตราใด ๆ ระหว่างทาง
    </p>

    <p class="mb-4 text-left text-base leading-relaxed">
      ไม่มีการล็อกไอดี และไม่แบ่งกลุ่มยูสใหม่กับยูสเก่า จะเล่นเบทเล็กหรือเบทใหญ่ ผลของแต่ละรอบก็มาจากระบบของค่ายเกมชุดเดียวกันทุกคน
    </p>

    <p class="text-left text-base leading-relaxed">ความแฟร์ไม่ใช่โปรโมชั่น มันคือสิ่งที่ต้องมีอยู่แล้วตั้งแต่ก่อนเปิดร้าน</p>
  </ContentBox>

  <ContentBox as="h2" title="ค่ายเกมระดับโลกบน VODKAFUN ในระบบกระเป๋าเดียว">
    <p class="mb-4 text-left text-base leading-relaxed">
      ค่ายหลักที่รวมไว้คือ PG SOFT, Pragmatic Play และ Joker Gaming แต่ละค่ายมีรสของตัวเอง PG SOFT เด่นที่กราฟิก Pragmatic Play เด่นที่ฟีเจอร์ซื้อฟรีสปิน ส่วน Joker เป็นแนวคลาสสิกที่คุ้นมือ
    </p>

    <p class="mb-4 text-left text-base leading-relaxed">
      ทั้งหมดอยู่ในระบบกระเป๋าเดียว อยากเปลี่ยนบรรยากาศไปเล่นค่ายไหนก็สลับได้ในคลิกเดียว ยอดเครดิตตามไปด้วยทันทีโดยไม่ต้องโยกเงินระหว่างค่าย
    </p>

    <p class="text-left text-base leading-relaxed">เมนูยาวแค่ไหนไม่สำคัญเท่าสั่งแล้วได้ของจริงทุกแก้ว</p>
  </ContentBox>

  <ContentBox as="h2" title="ฝากถอน AI Auto 2–5 วินาที และไม่มีขั้นต่ำ">
    <p class="mb-4 text-left text-base leading-relaxed">
      ระบบฝากถอนของ VODKAFUN เป็น AI Auto ทั้งหมด ทำรายการเฉลี่ย 2–5 วินาที ฝั่งฝากไม่ต้องส่งสลิปให้แอดมินตรวจ ฝั่งถอนกดแล้วเงินเข้าบัญชีโดยไม่ต้องรอคิว
    </p>

    <p class="mb-4 text-left text-base leading-relaxed">
      ไม่มีขั้นต่ำทั้งฝากและถอน จะเริ่มที่ 1 บาทหรือหลักหมื่นก็ได้เท่ากัน เว็บไม่บังคับยอด ไม่กดดันให้ฝากเพิ่ม และไม่มีเงื่อนไขยิบย่อยซ่อนอยู่ข้างหลัง
    </p>

    <p class="mb-4 text-left text-base leading-relaxed">
      ช่องทางรองรับทั้งแอปธนาคารและ True Money Wallet คนที่ไม่สะดวกใช้บัญชีธนาคารก็ทำรายการผ่านวอลเล็ตได้ด้วยความเร็วเท่ากัน
    </p>

    <p class="text-left text-base leading-relaxed">เงินของสมาชิกไม่ควรต้องรอใครอนุมัติ</p>
  </ContentBox>

  <ContentBox as="h2" title="สมัครฟรี ไม่ต้องฝากก่อน และการดูแลบัญชีสมาชิก VODKAFUN">
    <p class="mb-4 text-left text-base leading-relaxed">
      การสมัครสมาชิกไม่มีค่าใช้จ่าย ไม่ต้องโอนเงินมาจองสิทธิ์ และไม่มีค่าธรรมเนียมแรกเข้า กรอกข้อมูลเบื้องต้นให้ครบก็ได้ยูสไปล็อกอิน เข้าดูหน้าเว็บ เลือกดูเกม หรือทดลองระบบได้ทันที
    </p>

    <p class="mb-4 text-left text-base leading-relaxed">
      เราอยากให้คุณพิสูจน์ระบบจนพอใจก่อน แล้วค่อยตัดสินใจเรื่องเงินทีหลัง เพราะความเชื่อใจเป็นสิ่งที่ต้องมาก่อนยอดฝากเสมอ
    </p>

    <p class="mb-4 text-left text-base leading-relaxed">
      รหัสผ่านควรตั้งให้ไม่ซ้ำกับบัญชีสำคัญอื่น และไม่ส่งรหัสผ่านหรือรหัส OTP ให้ใคร ไม่ว่าอีกฝ่ายจะอ้างว่าเป็นใครก็ตาม ทีมงานจริงไม่มีเหตุต้องขอข้อมูลสองอย่างนี้
    </p>

    <p class="text-left text-base leading-relaxed">บัญชีที่ปลอดภัยไม่ได้ทำให้เล่นเก่งขึ้น แต่ทำให้ไม่ต้องคอยระแวงมัน</p>
  </ContentBox>

  <Navfoot />
</MainLayout>
