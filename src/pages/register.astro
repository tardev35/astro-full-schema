---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import CtaRedirect from "../components/CtaRedirect.astro";
import { pageGraph } from "../lib/schema";

const pageTitle = "สมัครสมาชิก BABYSHARK8899 | ปุ่มเปิดยูสใหม่ผ่านมือถือ ฝากถอนออโต้ทั้งเว็บ";

const pageDescription =
  "หากคุณกำลังมองหาเว็บนอกลิขสิทธิ์แท้ที่สมัครจบในไม่กี่นาที BABYSHARK8899 พร้อมมอบปุ่มเปิดยูสใหม่ผ่านมือถือ เพื่อเข้าเล่นได้ทุกค่ายด้วยยูสเดียวและฝากถอนออโต้";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "สมัครสมาชิก", path: "/register" },
  ],
});

const targetUrl = "https://yoalink.com/gf78";
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="สมัครสมาชิก BABYSHARK8899" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label="สมัครสมาชิก BABYSHARK8899"
        class="group relative mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#6e0a10]/70 bg-gradient-to-b from-[#ff4d4d] via-[#e8202a] to-[#b0121a] px-6 py-4 text-xl font-bold tracking-wide text-white shadow-[0_10px_30px_rgba(232,32,42,0.26)] transition-all duration-300 hover:scale-105 hover:border-[#ff8080] hover:shadow-[0_15px_40px_rgba(232,32,42,0.38)]">
        สมัครสมาชิก BABYSHARK8899
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="สมัครสมาชิก" />
</MainLayout>
