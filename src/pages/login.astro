---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement6.astro";
import CtaRedirect from "../components/CtaRedirect.astro";
import { pageGraph } from "../lib/schema";

const pageTitle = "เข้าสู่ระบบ PIGAUTO | ปุ่มล็อกอินเข้าหน้าเมมเบอร์ สล็อตหมูเว็บตรง";

const pageDescription =
  "หากคุณกำลังมองหาทางเข้าเล่นที่ไม่ยุ่งยาก PIGAUTO พร้อมมอบปุ่มเข้าสู่ระบบเพียงปุ่มเดียว เพื่อกลับเข้าหน้าเมมเบอร์ด้วยยูสเดิม เช็กยอดคงเหลือและเล่นต่อได้ทันที";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เข้าสู่ระบบ", path: "/login" },
  ],
});

const targetUrl = "https://yoalink.com/22hs";
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="เข้าสู่ระบบ PIGAUTO" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label="เข้าสู่ระบบ PIGAUTO"
        class="group relative mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#f5c542]/60 bg-gradient-to-b from-[#d92121] to-[#8c0f0f] px-6 py-4 text-xl font-bold tracking-wide text-white shadow-[0_10px_30px_rgba(217,33,33,0.24)] transition-all duration-300 hover:scale-105 hover:border-[#ffe08a]/70 hover:shadow-[0_15px_40px_rgba(217,33,33,0.35)]">
        เข้าสู่ระบบ PIGAUTO
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="เข้าสู่ระบบ" />
</MainLayout>
