---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement2.astro";
import { pageGraph } from "../lib/schema";

const pageTitle = "เกี่ยวกับเรา AMD365 รวมสล็อต คาสิโน กีฬา หวย ในบัญชีเดียว";

const pageHeading = "เกี่ยวกับเรา AMD365 เว็บเกมออนไลน์ที่รวมสล็อต คาสิโน กีฬา และหวยไว้ในบัญชีเดียว";

const pageDescription =
  "เกี่ยวกับเรา AMD365 เว็บเกมออนไลน์ที่รวมสล็อต คาสิโนสด กีฬา eSports และหวยไว้ในบัญชีสมาชิกเดียว พร้อมระบบฝากถอนออโต้ โหมดทดลองเล่น และมาตรฐานเกมจากผู้ให้บริการ";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox as="h1" title={pageHeading}>
    <p class="mb-4 text-left text-base leading-relaxed text-[#f4e8d2]">
      <strong class="text-[#ffe9a8]">AMD365</strong> เริ่มจากโจทย์ข้อเดียว คือทำให้คนที่ชอบความสนุกหลายแบบไม่ต้องเปลี่ยนเว็บทุกครั้งที่เปลี่ยนใจ ทั้งสล็อต คาสิโนสด กีฬา eSports และหวยออนไลน์จึงอยู่ในระบบสมาชิกเดียวกัน
    </p>

    <p class="mb-4 text-left text-base leading-relaxed text-[#f4e8d2]">
      ระบบสมาชิกเชื่อมเมนูเกม เครดิต โปรโมชั่น และการฝากถอนไว้ด้วยกัน การย้ายหมวดจึงเป็นแค่การเลือกเกม ไม่ใช่การเริ่มต้นระบบใหม่ตั้งแต่ศูนย์
    </p>

    <p class="text-left text-base leading-relaxed text-[#f4e8d2]">เกมเยอะเป็นเรื่องพื้นฐานไปแล้ว ที่ยังต่างกันคือสลับหมวดได้ง่ายแค่ไหน</p>
  </ContentBox>

  <ContentBox as="h2" title="จุดตั้งต้นของ AMD365 กับโจทย์เรื่องบัญชีเดียวจบทุกหมวด">
    <p class="mb-4 text-left text-base leading-relaxed text-[#f4e8d2]">
      คนเล่นทุกวันนี้เปิดเว็บจากมือถือเป็นหลัก เล่นสั้นลงแต่บ่อยขึ้น และเปลี่ยนความสนใจเร็ว วันนี้อยากหมุนสล็อต พรุ่งนี้อยากเช็กคู่บอล วันถัดไปอาจอยากลุ้นเลขสักงวด
    </p>

    <p class="mb-4 text-left text-base leading-relaxed text-[#f4e8d2]">
      โจทย์แรกจึงไม่ใช่การเพิ่มจำนวนเกม แต่เป็นการทำให้ทุกหมวดใช้บัญชีเดียวกัน เครดิต ประวัติรายการ และโปรโมชั่นยังอยู่ที่เดิมเมื่อผู้เล่นย้ายหมวด
    </p>

    <p class="text-left text-base leading-relaxed text-[#f4e8d2]">ความสนุกไม่ได้มีตารางเวลาราชการ ระบบจึงควรตามพฤติกรรมคนเล่นให้ทัน</p>
  </ContentBox>

  <ContentBox as="h2" title="หมวดสล็อตของ AMD365 รวมค่ายไหนไว้บ้าง">
    <p class="mb-4 text-left text-base leading-relaxed text-[#f4e8d2]">
      หมวดสล็อตรวมเกมจากผู้ให้บริการหลายค่ายที่เปิดอยู่ในระบบ ทั้ง PG Slot, Pragmatic Play, Joker และค่ายอื่น ๆ มีตั้งแต่เกมยอดนิยม เกมใหม่ เกมฟรีสปิน ไปจนถึงเกมที่เน้นตัวคูณ
    </p>

    <p class="mb-4 text-left text-base leading-relaxed text-[#f4e8d2]">
      แต่ละค่ายมีสไตล์ต่างกันชัดเจน PG Slot เด่นที่ภาพและเมนูซึ่งเข้าใจง่ายบนมือถือ Pragmatic Play เด่นที่รอบโบนัสกับฟรีสปิน ส่วน Joker เหมาะกับคนที่ชอบสลับไปลองเกมใหม่บ่อย
    </p>

    <p class="mb-4 text-left text-base leading-relaxed text-[#f4e8d2]">
      เกมที่รองรับ DEMO เปิดให้ดูหน้าตาเกม ระบบสัญลักษณ์ และจังหวะการเล่นได้ก่อนใช้เครดิตจริง
    </p>

    <p class="text-left text-base leading-relaxed text-[#f4e8d2]">เกมฮิตกับเกมที่เข้ากับสไตล์ของคนเล่น ไม่ใช่เกมเดียวกันเสมอไป</p>
  </ContentBox>

  <ContentBox as="h2" title="คาสิโนสดกับเกมโต๊ะที่เลือกได้จากหน้าเดียว">
    <p class="mb-4 text-left text-base leading-relaxed text-[#f4e8d2]">
      หมวดคาสิโนสดเหมาะกับคนที่อยากเปลี่ยนจากสล็อตมาสัมผัสเกมโต๊ะ มีทั้งบาคาร่า รูเล็ต ไฮโล แบล็กแจ็ก และเกม Live อื่น ๆ ตามรายการที่เปิดให้บริการ
    </p>

    <p class="mb-4 text-left text-base leading-relaxed text-[#f4e8d2]">
      ความต่างจากสล็อตอยู่ที่จังหวะเกมและบรรยากาศโต๊ะซึ่งเป็นส่วนหนึ่งของประสบการณ์ หมวดนี้จึงจัดให้ค้นหาโต๊ะได้ง่ายทั้งบนมือถือและคอม
    </p>

    <p class="text-left text-base leading-relaxed text-[#f4e8d2]">คนที่มีโต๊ะประจำอยู่แล้ว กดกลับเข้าเกมเดิมได้ในไม่กี่วินาที</p>
  </ContentBox>

  <ContentBox as="h2" title="หมวดกีฬาและ eSports ของ AMD365 ที่ไม่ได้มีแค่ฟุตบอล">
    <p class="mb-4 text-left text-base leading-relaxed text-[#f4e8d2]">
      หมวดกีฬาไม่ได้จำกัดอยู่ที่ฟุตบอล ยังพบตัวเลือกจากบาสเกตบอล เทนนิส มวย และ eSports ตามรายการแข่งขันที่เปิดให้บริการในแต่ละช่วง
    </p>

    <p class="mb-4 text-left text-base leading-relaxed text-[#f4e8d2]">
      คนที่ติดตามหลายชนิดกีฬาจึงไม่ต้องเปลี่ยนแพลตฟอร์มตามฤดูกาลแข่งขัน ก่อนแข่งเปิดดูคู่ที่สนใจ พอจบเกมก็กลับไปเล่นสล็อตหรือคาสิโนจากบัญชีเดิมได้ทันที
    </p>

    <p class="text-left text-base leading-relaxed text-[#f4e8d2]">ความสนใจของคนเล่นมักมีมากกว่าหนึ่งอย่างอยู่แล้ว</p>
  </ContentBox>

  <ContentBox as="h2" title="หวยออนไลน์ AMD365 กับตลาดที่เปิดตามรอบของระบบ">
    <p class="mb-4 text-left text-base leading-relaxed text-[#f4e8d2]">
      หมวดหวยออนไลน์เปิดทางให้สมาชิกที่ชอบลุ้นตัวเลขเลือกตลาดจากระบบเดียวกับเกมอื่น รายการที่เปิดอาจมีทั้งหวยรัฐบาลไทย หวยลาว หวยหุ้น หวยยี่กี และตลาดอื่นตามรอบที่ระบบกำหนด
    </p>

    <p class="mb-4 text-left text-base leading-relaxed text-[#f4e8d2]">
      ข้อดีคือดูรายการและจัดการบัญชีได้จากหน้าเมมเบอร์เดิม ไม่ต้องสร้างยูสอีกชุดเพียงเพราะเปลี่ยนจากสล็อตมาลุ้นเลข
    </p>

    <p class="text-left text-base leading-relaxed text-[#f4e8d2]">แต่ละตลาดมีเวลาเปิด-ปิดไม่เหมือนกัน ตรวจรอบและเงื่อนไขก่อนทำรายการทุกครั้ง</p>
  </ContentBox>

  <ContentBox as="h2" title="ระบบฝากถอนออโต้ที่ผูกอยู่กับหน้าเมมเบอร์">
    <p class="mb-4 text-left text-base leading-relaxed text-[#f4e8d2]">
      ระบบฝากถอนออโต้เชื่อมอยู่กับบัญชีสมาชิกโดยตรง เลือกเมนูฝากหรือถอน ตรวจยอดเครดิต และดูสถานะรายการได้จากหน้าเมมเบอร์ ไม่ต้องสลับหลายหน้าเพื่อทำเรื่องเดียวให้จบ
    </p>

    <p class="mb-4 text-left text-base leading-relaxed text-[#f4e8d2]">
      สิ่งที่ระบบออโต้ให้ได้จริงคือขั้นตอนที่สั้นลงและสถานะที่อ่านออก มากกว่าการโยนตัวเลขเวลาสวย ๆ มาโฆษณา
    </p>

    <p class="text-left text-base leading-relaxed text-[#f4e8d2]">ประวัติรายการของตัวเองยังย้อนดูได้เองทุกเมื่อจากบัญชีเดิม</p>
  </ContentBox>

  <ContentBox as="h2" title="ความปลอดภัย มาตรฐานเกม และความน่าเชื่อถือที่ตรวจสอบได้">
    <p class="mb-4 text-left text-base leading-relaxed text-[#f4e8d2]">
      ข้อมูลสมาชิกและการเชื่อมต่อของเว็บไซต์อยู่บนระบบที่รองรับการเข้ารหัส ส่วนเกมในระบบมาจากผู้ให้บริการที่มีระบบเกมและมาตรฐานของตัวเอง
    </p>

    <p class="mb-4 text-left text-base leading-relaxed text-[#f4e8d2]">
      สมาชิกจึงควรดูชื่อผู้ให้บริการเกมและข้อมูลที่แสดงในแต่ละหมวดก่อนใช้งาน และเก็บรหัสผ่านกับรหัส OTP ไว้กับตัวเสมอ ไม่ส่งต่อให้ใครไม่ว่ากรณีใด
    </p>

    <p class="mb-4 text-left text-base leading-relaxed text-[#f4e8d2]">
      AMD365 เลือกสื่อสารจากสิ่งที่ตรวจสอบได้ ทั้งช่องทางติดต่อ ระบบสมาชิก ประวัติรายการ และข้อมูลเกม มากกว่าพึ่งประโยคว่าปลอดภัย 100% เพียงอย่างเดียว
    </p>

    <p class="text-left text-base leading-relaxed text-[#f4e8d2]">ความน่าเชื่อถือไม่ได้เกิดจากตัวหนังสือหนา ๆ แต่เกิดจากระบบที่ใช้แล้วข้อมูลตรง</p>
  </ContentBox>

  <Navfoot />
</MainLayout>
