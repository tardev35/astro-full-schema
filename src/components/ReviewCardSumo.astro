---
const reviews = [
  {
    name: "สมาชิกที่เล่นสล็อตหลายค่ายในบัญชีเดียว",
    role: "รวมเกม เครดิต และประวัติไว้ที่เดียว",
    stars: 5,
    content:
      "เข้าสู่ระบบครั้งเดียวก็เลือกได้ทั้งเกมคลาสสิก เกมฟีเจอร์ และเกมโบนัส สลับค่ายใหญ่ไปมาโดยใช้เครดิตชุดเดิม เช็กยอดกับย้อนดูประวัติรายการได้จากหน้าเดียว ไม่ต้องมานั่งจำว่าเคยเล่นอะไรไว้ตรงไหน",
    avatar: "🎰",
  },
  {
    name: "สมาชิกที่ตามโบนัสเป็นช่วง",
    role: "เช็กสิทธิ์ที่เปิดอยู่ก่อนเลือกใช้ทุกครั้ง",
    stars: 5,
    content:
      "โบนัสกับสิทธิ์สมาชิกรวมอยู่ในหน้าสมาชิกเลยค่ะ เข้าไปดูได้ว่าช่วงนี้มีอะไรเปิดอยู่บ้าง แล้วอ่านเงื่อนไขให้จบก่อนค่อยกดรับ ไม่ต้องรับทุกอัน เลือกเฉพาะอันที่เหมาะกับงบที่ตั้งไว้ก็พอ",
    avatar: "🎁",
  },
  {
    name: "สมาชิกที่ใช้งานผ่านมือถืออย่างเดียว",
    role: "ฝากถอนออโต้แล้วกลับเข้าเกมต่อได้เลย",
    stars: 5,
    content:
      "ผมเปิดจากมือถืออย่างเดียวครับ ระบบออโต้ทำรายการจบในหน้าเดียว พอเสร็จก็กลับเข้าเกมต่อได้ทันที ยอดคงเหลือกับประวัติรายการอยู่ในบัญชีชุดเดียวกัน ตรวจย้อนหลังเองได้โดยไม่ต้องถามใคร",
    avatar: "📱",
  },
];
---

<section aria-label="เสียงจากสมาชิก SCLASS88" class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#ffe9a8] via-[#f5c542] to-[#bc7b14] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase drop-shadow-sm">
      เสียงตอบรับจาก <span class="text-[#f5c542]">สมาชิก SCLASS88</span>
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#f5c542] to-transparent"></div>
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-3 lg:gap-8">
    {
      reviews.map((review) => (
        <article class="group relative isolate flex flex-col justify-between rounded-3xl border border-[#f5c542]/25 bg-[#0d0904]/92 p-8 shadow-[0_10px_30px_rgba(0,0,0,0.75)] backdrop-blur-xl transition-all duration-500 hover:-translate-y-2 hover:border-[#f5c542]/55 hover:shadow-[0_15px_40px_rgba(245,197,66,0.28)]">
          <div aria-hidden="true" class="pointer-events-none absolute -top-10 -left-10 -z-10 h-32 w-32 rounded-full bg-[#bc7b14]/35 blur-[50px] transition-all duration-500 group-hover:bg-[#f5c542]/25" />

          <div class="relative z-10 flex flex-col gap-4">
            <div class="flex items-center justify-between border-b border-[#a3610c]/50 pb-4">
              <span aria-hidden="true" class="font-serif text-4xl leading-none text-[#f5c542]/60 drop-shadow-[0_0_5px_rgba(245,197,66,0.45)]">
                "
              </span>
              <span class="flex gap-1 text-lg">
                <span aria-hidden="true" class="flex gap-1">
                  {Array.from({ length: 5 }).map((_, i) => (
                    <span class={i < review.stars ? "text-[#f5c542] drop-shadow-[0_0_5px_rgba(245,197,66,0.7)]" : "text-[#7a4a0a]"}>★</span>
                  ))}
                </span>
                <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
              </span>
            </div>

            <p class="min-h-[100px] text-left text-base leading-relaxed text-[#efe1c2]">{review.content}</p>
          </div>

          <div class="relative z-10 mt-6 flex items-center gap-4 border-t border-[#f5c542]/20 pt-4">
            <span
              aria-hidden="true"
              class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full border border-[#f5c542]/45 bg-gradient-to-br from-[#bc7b14] to-[#1a1206] text-2xl shadow-inner transition-transform duration-300 group-hover:scale-110">
              {review.avatar}
            </span>
            <span class="flex flex-col">
              <span class="text-base font-black text-[#efe1c2] transition-colors group-hover:text-[#ffe9a8]">{review.name}</span>
              <span class="text-[11px] font-bold tracking-wider text-[#c2ac7f] uppercase">{review.role}</span>
            </span>
          </div>
        </article>
      ))
    }
  </div>
</section>
