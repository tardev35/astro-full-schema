---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";
import { pageGraph } from "../lib/schema";

const pageTitle = "วิธีฝากถอน YIMSIAM889 ระบบอัตโนมัติ ไม่ต้องส่งสลิป";

const pageHeading = "วิธีฝากถอน YIMSIAM889 ผ่านระบบอัตโนมัติ";

const pageDescription =
  "วิธีฝากถอน YIMSIAM889 ด้วยระบบอัตโนมัติ ทำรายการเองผ่านแอปธนาคารชั้นนำหรือทรูวอลเลท ไม่ต้องส่งสลิปให้แอดมิน ตรวจสถานะและประวัติธุรกรรมได้จากหน้าบัญชีตลอดวัน";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "วิธีฝากถอน", path: "/วิธีฝากถอน" },
  ],
});

const linkClass = "font-bold text-[#7cc0ff] underline underline-offset-4 transition-colors hover:text-[#eaf4ff]";
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox as="h1" title={pageHeading}>
    <p class="mb-4 text-left text-base leading-relaxed">
      ระบบฝาก-ถอนของ <strong class="text-[#9cc9ff]">YIMSIAM889</strong> เป็นระบบอัตโนมัติ ท่านทำรายการได้ด้วยตัวเองผ่านแอปพลิเคชันธนาคารชั้นนำหรือทรูวอลเลท โดยไม่ต้องส่งสลิปให้แอดมินดูให้เสียเวลา
    </p>

    <p class="text-left text-base leading-relaxed">
      เรื่องเงินๆ ทองๆ ต้องรอบคอบ แต่ก็ต้องรวดเร็วด้วยเช่นกันขอรับ สิ่งที่ควรรู้มีอยู่สี่เรื่อง คือการฝาก การถอน จุดที่ควรตรวจก่อนกดยืนยัน และช่องทางที่ระบบรองรับ
    </p>
  </ContentBox>

  <ContentBox as="h2" title="ฝากเงินอัตโนมัติ ไม่ต้องส่งสลิปให้แอดมิน">
    <p class="mb-4 text-left text-base leading-relaxed">
      เข้าสู่ระบบด้วยบัญชีสมาชิกของท่าน แล้วทำรายการฝากจากหน้าบัญชี โอนผ่านแอปพลิเคชันธนาคารหรือทรูวอลเลทที่ท่านใช้อยู่เป็นประจำ ไม่ต้องติดตั้งโปรแกรมใดเพิ่ม
    </p>

    <p class="mb-4 text-left text-base leading-relaxed">
      เมื่อโอนเสร็จ ระบบอัตโนมัติจะตรวจรายการและปรับยอดเครดิตให้เอง ท่านไม่ต้องส่งสลิปให้แอดมิน และไม่ต้องรอใครกดยืนยันให้ อย่างที่เรือนเราเรียกกันว่าฝากปุ๊บเงินเข้าปั๊บ
    </p>

    <p class="text-left text-base leading-relaxed">ขั้นตอนยิ่งสั้น โอกาสผิดพลาดก็ยิ่งน้อย</p>
  </ContentBox>

  <ContentBox as="h2" title="ถอนเงินอัตโนมัติ โอนเข้าบัญชีของท่านโดยตรง">
    <p class="mb-4 text-left text-base leading-relaxed">
      การถอนทำจากหน้าบัญชีเช่นเดียวกัน ระบุยอดที่ต้องการแล้วกดยืนยันเพียงครั้งเดียว ระบบอัตโนมัติจะโอนเงินเข้าบัญชีที่ท่านลงทะเบียนไว้ตอนสมัครสมาชิก
    </p>

    <p class="text-left text-base leading-relaxed">
      ทุกรายการถูกบันทึกไว้ในประวัติธุรกรรม ท่านเปิดดูสถานะย้อนหลังได้จากหน้าบัญชีทุกเมื่อ ยอดที่แสดงตรงกับที่ทำรายการจริง ทุกบาททุกสตางค์ตรวจสอบได้
    </p>
  </ContentBox>

  <ContentBox as="h2" title="สิ่งที่ควรตรวจก่อนและหลังทำรายการฝากถอน">
    <p class="mb-4 text-left text-base leading-relaxed">
      ชื่อบัญชีที่ใช้ทำรายการควรตรงกับชื่อที่ลงทะเบียนไว้กับ YIMSIAM889 เพื่อให้ระบบอัตโนมัติจับคู่รายการได้ถูกต้อง หากใช้บัญชีของผู้อื่น ระบบอาจไม่ปรับยอดให้เอง
    </p>

    <p class="mb-4 text-left text-base leading-relaxed">
      หากรายการยังประมวลผลอยู่ ไม่ควรกดซ้ำทันที ให้เปิดดูสถานะและประวัติธุรกรรมจากหน้าบัญชีก่อน การกดซ้ำระหว่างที่ระบบทำงานอาจทำให้เกิดรายการซ้อนโดยไม่จำเป็น
    </p>

    <p class="mb-4 text-left text-base leading-relaxed">
      หากตรวจแล้วรายการยังค้างอยู่ แจ้งทีมงานได้ที่หน้า
      <a href="/contact-us/" class={linkClass}>ติดต่อเรา</a> พร้อมเวลาที่ทำรายการและยอดเงิน ทีมงานจะช่วยตรวจให้ และโปรดอย่าส่งรหัสผ่านหรือรหัส OTP ให้ผู้ใด
    </p>

    <p class="text-left text-base leading-relaxed">รอบคอบก่อนกดหนึ่งครั้ง สบายใจกว่าตามแก้ทีหลังหลายรอบ</p>
  </ContentBox>

  <ContentBox as="h2" title="ช่องทางที่รองรับ แอปธนาคารชั้นนำและทรูวอลเลท">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed">
        YIMSIAM889 รองรับการทำรายการผ่านแอปพลิเคชันธนาคารชั้นนำของไทย และทรูวอลเลทสำหรับท่านที่ไม่สะดวกใช้บัญชีธนาคาร ทั้งสองช่องทางทำงานบนระบบอัตโนมัติชุดเดียวกัน
      </p>

      <p class="text-left text-base leading-relaxed">
        ระบบเปิดรับรายการตลอดวัน ทำได้จากโทรศัพท์มือถือทั้ง iOS และ Android รวมถึงคอมพิวเตอร์และแท็บเล็ต ไม่ว่าช่องทางไหนก็ไม่ต้องส่งสลิปให้แอดมินตรวจ
      </p>

      <div class="flex flex-col items-center justify-center gap-4 pt-4 sm:flex-row">
        <a
          href="/login/"
          class="inline-flex w-full max-w-[320px] items-center justify-center gap-2 rounded-xl border border-[#2f8cff]/70 bg-gradient-to-r from-[#eaf4ff] via-[#9cc9ff] to-[#4d9dff] px-8 py-3.5 text-lg font-black tracking-wide text-[#03133c] shadow-[0_10px_30px_rgba(47,140,255,0.4)] transition-transform duration-300 hover:scale-105">
          <span aria-hidden="true">💳</span> เข้าสู่ระบบเพื่อฝากถอน
        </a>

        <a
          href="/register/"
          class="inline-flex w-full max-w-[320px] items-center justify-center gap-2 rounded-xl border border-[#2f8cff]/70 bg-[#061538] px-8 py-3.5 text-lg font-bold tracking-wide text-[#dbeaff] transition-colors duration-300 hover:bg-[#0a1f4d]">
          สมัครสมาชิก YIMSIAM889
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
