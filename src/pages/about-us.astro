---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";
import { pageGraph } from "../lib/schema";

const pageTitle = "เกี่ยวกับเรา YIMSIAM889 สล็อตสยาม เว็บตรงไม่ผ่านเอเย่นต์";

const pageHeading = "เกี่ยวกับเรา YIMSIAM889 สล็อตสยาม ที่บริการด้วยใจแบบไทยแท้";

const pageDescription =
  "รู้จัก YIMSIAM889 สล็อตสยาม เว็บตรงไม่ผ่านเอเย่นต์ เชื่อมเกมจาก PG SOFT Joker Gaming และ Pragmatic Play โดยตรง ฝากถอนอัตโนมัติไม่ต้องส่งสลิป รองรับทุกอุปกรณ์";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});

const linkClass = "font-bold text-[#7cc0ff] underline underline-offset-4 transition-colors hover:text-[#eaf4ff]";
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox as="h1" title={pageHeading}>
    <p class="mb-4 text-left text-base leading-relaxed">
      <strong class="text-[#9cc9ff]">YIMSIAM889</strong> หรือยิ้มสยาม889 คือผู้ให้บริการสล็อตออนไลน์ในรูปแบบเว็บตรง ไม่ผ่านเอเย่นต์ ยึดถือคติ “บริการด้วยใจ ยิ้มแย้มแจ่มใสแบบไทยแท้” เป็นหลักในการดูแลผู้เล่นทุกท่าน
    </p>

    <p class="mb-4 text-left text-base leading-relaxed">
      คำว่าสล็อตสยามไม่ได้หมายถึงแค่ชื่อ แต่สะท้อนแนวคิดการให้บริการที่สุภาพ ไม่เร่ง ไม่กดดัน และให้เกียรติผู้เล่นทุกคน เกมที่คัดมาจึงเป็นเกมที่เล่นง่าย กติกาไม่ซับซ้อนซ่อนเงื่อน
    </p>

    <p class="mb-4 text-left text-base leading-relaxed">
      เว็บนี้เหมาะกับท่านที่อยากเล่นสล็อตในบรรยากาศที่ไม่วุ่นวาย แต่ยังได้ระบบที่ชัดเจนและเชื่อถือได้ เรื่องที่ควรรู้ก่อนตัดสินใจมีอยู่ไม่กี่ข้อ และทุกข้อตรวจสอบได้ด้วยตัวท่านเอง
    </p>

    <p class="text-left text-base leading-relaxed">เรือนที่ตั้งใจต้อนรับแขกทุกวัน ย่อมไม่มีเหตุให้ต้องเร่งแขกคนใด</p>
  </ContentBox>

  <ContentBox as="h2" title="เว็บตรง ไม่ผ่านเอเย่นต์ เชื่อมสัญญาณเกมจากค่ายแม่โดยตรง">
    <p class="mb-4 text-left text-base leading-relaxed">
      YIMSIAM889 ให้บริการในรูปแบบเว็บตรง ไม่ผ่านเอเย่นต์หรือนายหน้าใดๆ สัญญาณเกมรับตรงจากค่ายผู้พัฒนา ไม่มีคนกลางมาคั่นระหว่างท่านกับค่ายเกม ระบบจึงเสถียรและตรวจสอบได้ทุกขั้นตอน
    </p>

    <p class="mb-4 text-left text-base leading-relaxed">
      เมื่อระบบตรงไปตรงมา อัตราการชนะก็เป็นไปตามค่า RTP มาตรฐานของแต่ละค่าย ไม่มีใครแอบปรับหลังบ้าน และไม่มีการกั๊กช่วงเวลาว่าต้องมาหมุนตอนไหนถึงจะเข้า ผลแต่ละรอบขึ้นอยู่กับจังหวะของเกมจริงๆ
    </p>

    <p class="text-left text-base leading-relaxed">ความแฟร์ไม่ใช่ของแถม เป็นสิ่งที่ต้องมีอยู่ก่อนเปิดประตูเรือน</p>
  </ContentBox>

  <ContentBox as="h2" title="ค่ายเกมลิขสิทธิ์แท้บน YIMSIAM889 และค่า RTP ตามมาตรฐานของค่าย">
    <p class="mb-4 text-left text-base leading-relaxed">
      ค่ายหลักที่เชื่อมต่อไว้คือ PG SOFT, Joker Gaming และ Pragmatic Play ทุกค่ายเป็นลิขสิทธิ์แท้ที่รับสัญญาณตรงเหมือนกันหมด เกมที่ท่านเปิดจึงเป็นชุดเดียวกับที่ค่ายปล่อยออกมา
    </p>

    <p class="mb-4 text-left text-base leading-relaxed">
      PG SOFT ขึ้นชื่อเรื่องกราฟิก 3D ที่วิจิตรบรรจง Joker Gaming เป็นแนวคลาสสิกที่เล่นง่าย มีเกมโรม่าอันเลื่องชื่อ ส่วน Pragmatic Play หรือ PP โดดเด่นที่ฟีเจอร์และลูกเล่นให้ลุ้นตลอดเวลา
    </p>

    <p class="mb-4 text-left text-base leading-relaxed">
      ลำดับความนิยมของเกมบนหน้าเว็บขยับตามจำนวนคนที่เข้ามาหมุนในแต่ละช่วง ไม่ได้แปลว่าเกมไหนแตกดีกว่าเกมไหน ทุกเกมทำงานตามค่า RTP ที่ค่ายกำหนดเหมือนกัน
    </p>

    <p class="text-left text-base leading-relaxed">ชื่อค่ายบอกรสมือของเกม ส่วนผลของแต่ละรอบ ดวงเป็นคนบอก</p>
  </ContentBox>

  <ContentBox as="h2" title="ฝากถอนอัตโนมัติผ่านแอปธนาคารและทรูวอลเลท ไม่ต้องส่งสลิป">
    <p class="mb-4 text-left text-base leading-relaxed">
      ระบบฝาก-ถอนของ YIMSIAM889 เป็นระบบอัตโนมัติ ท่านทำรายการได้ด้วยตัวเองผ่านแอปพลิเคชันธนาคารชั้นนำหรือทรูวอลเลท โดยไม่ต้องส่งสลิปให้แอดมินตรวจให้เสียเวลา
    </p>

    <p class="mb-4 text-left text-base leading-relaxed">
      ระบบรองรับการทำรายการตลอดวัน สถานะและประวัติธุรกรรมตรวจได้จากหน้าบัญชีของท่านเอง หากรายการยังประมวลผลอยู่ไม่ควรกดซ้ำทันที ขั้นตอนโดยละเอียดอยู่ที่หน้า
      <a href="/วิธีฝากถอน/" class={linkClass}>วิธีฝากถอน</a>
    </p>

    <p class="text-left text-base leading-relaxed">เรื่องเงินต้องรอบคอบ แต่ไม่จำเป็นต้องช้า</p>
  </ContentBox>

  <ContentBox as="h2" title="รองรับทุกอุปกรณ์ และช่องทางติดต่อทีมงาน YIMSIAM889">
    <p class="mb-4 text-left text-base leading-relaxed">
      ทางเข้า YIMSIAM889 เปิดได้จากโทรศัพท์มือถือทั้ง iOS และ Android รวมถึงคอมพิวเตอร์และแท็บเล็ต หน้าเว็บออกแบบให้อ่านง่าย สบายตา เมนูภาษาไทยชัดเจน ไม่ต้องแปลไทยเป็นไทยอีกรอบ
    </p>

    <p class="mb-4 text-left text-base leading-relaxed">
      หากมีข้อสงสัยเรื่องสมัครสมาชิก เข้าสู่ระบบ หรือธุรกรรม ติดต่อทีมงานได้ทาง
      <a href="/line/" class={linkClass}>LINE Official</a> หรือดูช่องทางทั้งหมดที่หน้า
      <a href="/contact-us/" class={linkClass}>ติดต่อเรา</a> ทีมงานตอบอย่างสุภาพ ไม่เร่งรัดท่านขอรับ
    </p>

    <p class="mb-4 text-left text-base leading-relaxed">
      รหัสผ่านและรหัส OTP เป็นของท่านคนเดียว ไม่ควรส่งให้ผู้ใด ไม่ว่าอีกฝ่ายจะอ้างว่าเป็นใครก็ตาม ทีมงานจริงไม่มีเหตุต้องขอข้อมูลสองอย่างนี้จากท่าน
    </p>

    <p class="text-left text-base leading-relaxed">เรือนที่ดีไม่ได้วัดกันที่ความใหญ่โต วัดกันที่แขกกลับมาแล้วยังยิ้มได้</p>
  </ContentBox>

  <Navfoot />
</MainLayout>
