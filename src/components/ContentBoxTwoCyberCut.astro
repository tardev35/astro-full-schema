---
export interface Props {
  title?: string;
  titleleft?: string;
  titleright?: string;
  label?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, titleleft, titleright, label, as } = Astro.props;
const TitleTag = as ?? "p";
const intro = Astro.slots.has("default") ? (await Astro.slots.render("default")).trim() : "";

const sectionLabel = label ?? title ?? titleleft ?? titleright ?? "ข้อมูลประกอบ";
---

<section aria-label={sectionLabel} class="mx-auto mb-6 w-full max-w-7xl px-4 font-sans">
  <div
    class="relative isolate w-full border border-[#f1d9c4] bg-white p-8 text-[#2b2622] transition-colors duration-300 hover:border-[#f0a868]"
    style="clip-path: polygon(30px 0, 100% 0, 100% calc(100% - 30px), calc(100% - 30px) 100%, 0 100%, 0 30px);">
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-[2px] w-24 bg-gradient-to-r from-[#f47b20] to-transparent"></div>
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-16 w-[2px] bg-gradient-to-b from-[#f47b20] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-[2px] w-24 bg-gradient-to-l from-[#1f6fd6] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-16 w-[2px] bg-gradient-to-t from-[#1f6fd6] to-transparent"></div>

    {
      title && (
        <div class="mb-6 flex flex-col items-center gap-2">
          <TitleTag class="text-center text-xl leading-normal font-black text-[#1f1611] md:text-2xl">{title}</TitleTag>
          <span aria-hidden="true" class="h-1 w-20 rounded-full bg-gradient-to-r from-[#ffc94a] via-[#f47b20] to-[#1f6fd6]" />
        </div>
      )
    }

    {intro && <div class="mb-8 text-left text-base leading-relaxed text-[#2b2622]" set:html={intro} />}

    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <article class="relative flex flex-col gap-4 text-left text-base leading-relaxed text-[#2b2622]">
        {
          titleleft && (
            <p class="flex items-center gap-2 border-b border-[#f1d9c4] pb-2 text-xl leading-normal font-black text-[#1f1611]">
              <span aria-hidden="true" class="inline-block h-2 w-2 shrink-0 bg-[#f47b20]" /> {titleleft}
            </p>
          )
        }
        <slot name="left" />
      </article>

      <article class="relative flex flex-col gap-4 text-left text-base leading-relaxed text-[#2b2622] md:border-l md:border-[#f1d9c4] md:pl-8">
        {
          titleright && (
            <p class="flex items-center gap-2 border-b border-[#f1d9c4] pb-2 text-xl leading-normal font-black text-[#1f1611]">
              <span aria-hidden="true" class="inline-block h-2 w-2 shrink-0 bg-[#1f6fd6]" /> {titleright}
            </p>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
