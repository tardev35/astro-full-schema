---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxCyberCut.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";

import { Picture } from "astro:assets";
import imgLine from "../assets/contact-line.webp";
import { pageGraph } from "../lib/schema";
import { BRAND_ADDRESS } from "../lib/brandProfile";

const pageDescription =
  "ติดต่อทีมงาน 888NEO ผ่านไลน์ออฟฟิเชียลได้ตลอด 24 ชั่วโมง หน้านี้รวมช่องทางแจ้งปัญหา ที่อยู่ติดต่อ และอีเมลของทีมงาน พร้อมปุ่มสมัครสมาชิกและเข้าสู่ระบบ";

const graph = pageGraph(Astro, {
  type: "ContactPage",
  name: "ติดต่อทีมงาน 888NEO ผ่าน LINE Official",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ติดต่อเรา", path: "/contact-us" },
  ],
  org: {
    alternateName: "888NEO รวมสล็อต คาสิโนสด ระบบออโต้ และระบบสมาชิกไว้ในบัญชีเดียว",
    contactPoints: [
      {
        contactType: "customer service",
        availableLanguage: ["Thai", "English"],
        path: "/line",
        description: "ติดต่อแอดมินผ่าน LINE Official",
      },
    ],
  },
});
---

<MainLayout title="ติดต่อ 888NEO" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="ติดต่อทีมงาน 888NEO" as="h1">
    <Picture
      src={imgLine}
      alt="พนักงานหญิงชุดเลื่อมสีชมพูยิ้มกอดอก ยืนอยู่ข้างปุ่มสีขาวที่มีโลโก้ LINE สีเขียวและคำว่า Support"
      loading="lazy"
      fetchpriority="low"
      widths={[200, 400, 600]}
      sizes="(max-width: 768px) 100vw, 400px"
      class="mx-auto h-auto w-full max-w-[400px] object-contain shadow-[0_10px_30px_rgba(224,27,27,0.35)]"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={60}
    />
    {
      BRAND_ADDRESS.lines.length > 0 && (
        <address aria-label={BRAND_ADDRESS.label} class="mt-8 mb-8 border-l-4 border-[#e01b1b] pl-6 text-left text-base leading-relaxed text-[#f3e3c6] not-italic">
          <p class="mb-1 font-bold text-[#f5c542]">{BRAND_ADDRESS.label}</p>
          {BRAND_ADDRESS.lines.map((line) => (
            <span class="block">{line}</span>
          ))}
          {BRAND_ADDRESS.email && (
            <span class="mt-3 block">
              <span aria-hidden="true" class="mr-2">
                ✉️
              </span>
              <a href={`mailto:${BRAND_ADDRESS.email}`} class="font-bold text-[#f5c542] underline decoration-[#ff5a4d]/60 underline-offset-4 transition-colors hover:text-[#ffe9a8]">
                {BRAND_ADDRESS.email}
              </a>
            </span>
          )}
        </address>
      )
    }

    <div class="flex flex-wrap justify-center gap-4">
      <a
        href="/register"
        aria-label="สมัครสมาชิก"
        class="flex items-center justify-center rounded-lg border border-[#ff5a4d]/60 bg-gradient-to-b from-[#ffe9a8] via-[#f5c542] to-[#b8860b] px-8 py-3 font-bold text-[#0b0503] shadow-[0_10px_30px_rgba(224,27,27,0.35)] transition-transform hover:scale-105 hover:shadow-[0_15px_40px_rgba(245,197,66,0.30)]">
        สมัครสมาชิก
      </a>

      <a
        href="/login"
        aria-label="เข้าสู่ระบบ"
        class="flex items-center justify-center rounded-lg border border-[#f5c542]/60 bg-[#1c0a06] px-8 py-3 font-extrabold text-[#ffe9a8] shadow-[0_4px_14px_rgba(224,27,27,0.35)] transition-transform hover:scale-105 hover:bg-[#2a1109]">
        เข้าสู่ระบบ
      </a>

      <a
        href="/line"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="ติดต่อทีมงานผ่าน Line Official"
        class="flex items-center justify-center rounded-lg border border-green-300 bg-gradient-to-b from-green-400 to-green-700 px-8 py-3 font-bold text-white transition-transform hover:scale-105">
        ติดต่อผ่าน Line Official
      </a>
    </div>
  </ContentBox>
  <Navfoot />
</MainLayout>
