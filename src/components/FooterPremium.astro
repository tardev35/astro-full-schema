---
import { Picture } from "astro:assets";
import BankStrip from "./BankStrip.astro";
import { BRAND_ADDRESS, BRAND_NAME } from "../lib/brandProfile";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });
const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

const logoAlt = "โลโก้ BABYSHARK8899 หัวฉลามการ์ตูนสีฟ้าฟันแหลมในวงกลมสีแดง ตัวอักษร BABY สีแดง SHARK สีขาวเงิน และเลข 8899 สีฟ้าขอบดำ มีลายสาดสีแดงและน้ำเงินด้านหลัง";
---

<footer
  class="relative mt-16 w-full overflow-hidden rounded-t-[3rem] border-t-2 border-[#0b7cf4] bg-[#020b22] pt-16 pb-8 font-sans text-[#dbe9ff] shadow-[0_-15px_40px_rgba(11,124,244,0.22)]">
  <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 -top-20 mx-auto h-[250px] w-full max-w-4xl rounded-full bg-[#0b7cf4]/20 blur-[100px]"></div>

  <div class="relative z-10 mx-auto w-full max-w-[1200px] px-6">
    <div class="mb-12 grid grid-cols-1 gap-12 md:grid-cols-12">
      <div class="flex flex-col gap-5 md:col-span-5">
        <a href="/" class="inline-block transition-transform duration-300 hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt={logoAlt}
                widths={[130, 260, 390]}
                sizes="130px"
                loading="lazy"
                class="h-[75px] w-auto drop-shadow-[0_5px_15px_rgba(11,124,244,0.45)]"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <span class="text-4xl font-black tracking-widest italic">
                <span class="text-[#ff5a60]">BABY</span>
                <span class="text-white">SHARK</span>
                <span class="text-[#4da3ff]">8899</span>
              </span>
            )
          }
        </a>
        <p class="border-l-2 border-[#0b7cf4] pl-4 text-sm leading-relaxed text-[#dbe9ff]/75">
          BABYSHARK8899 ทางเข้าเดียวที่รวมสล็อตแยกตามค่าย คาสิโนสดที่มีบาคาร่ากับเกมไพ่ที่เราคุ้นมือ เกมยิงปลาหลายธีม และหวยทุกประเภทไว้ด้วยกัน
          เปิดผ่านเบราว์เซอร์บนมือถือได้ทันทีโดยไม่ต้องโหลดแอป สมัคร ฝาก เล่น และถอนจบในเครื่องเดียว สงสัยอะไรทักแอดมินได้ตลอด
        </p>
        <div class="mt-4 flex flex-wrap gap-3">
          <span class="rounded-full border border-[#0b7cf4]/45 bg-[#0b7cf4]/15 px-4 py-1 text-xs font-medium text-[#4da3ff]">สล็อต คาสิโนสด ยิงปลา หวย ครบในทางเข้าเดียว</span>
          <span class="rounded-full border border-[#e8202a]/45 bg-[#e8202a]/15 px-4 py-1 text-xs font-medium text-[#dbe9ff]">เล่นบนมือถือ ไม่ต้องโหลดแอป</span>
        </div>
      </div>

      <nav aria-label="ลิงก์หน้าเว็บ BABYSHARK8899" class="flex flex-col gap-4 md:col-span-3 lg:pl-8">
        <p class="text-lg font-black tracking-widest text-[#4da3ff] uppercase drop-shadow-sm">เมนูลัด</p>
        <div aria-hidden="true" class="h-[1px] w-12 bg-[#0b7cf4]"></div>
        <ul class="flex flex-col gap-3 text-sm font-medium text-[#dbe9ff]/75">
          <li><a href="/" class="transition-colors hover:text-[#ff5a60]">หน้าแรก</a></li>
          <li><a href="/promotion/" class="transition-colors hover:text-[#ff5a60]">โปรโมชั่น</a></li>
          <li><a href="/register/" class="transition-colors hover:text-[#ff5a60]">สมัครสมาชิก</a></li>
          <li><a href="/login/" class="transition-colors hover:text-[#ff5a60]">เข้าสู่ระบบ</a></li>
          <li><a href="/ทางเข้า/" class="transition-colors hover:text-[#ff5a60]">ทางเข้า</a></li>
          <li><a href="/ทดลองเล่น/" class="transition-colors hover:text-[#ff5a60]">ทดลองเล่น</a></li>
          <li><a href="/slot/" class="transition-colors hover:text-[#ff5a60]">สล็อต</a></li>
          <li><a href="/casino/" class="transition-colors hover:text-[#ff5a60]">คาสิโนสด</a></li>
          <li><a href="/fishing-casino/" class="transition-colors hover:text-[#ff5a60]">ยิงปลา</a></li>
          <li><a href="/lotto/" class="transition-colors hover:text-[#ff5a60]">หวยออนไลน์</a></li>
          <li><a href="/วิธีฝากถอน/" class="transition-colors hover:text-[#ff5a60]">วิธีฝากถอน</a></li>
          <li><a href="/about-us/" class="transition-colors hover:text-[#ff5a60]">เกี่ยวกับเรา</a></li>
          <li><a href="/contact-us/" class="transition-colors hover:text-[#ff5a60]">ติดต่อเรา</a></li>
        </ul>
      </nav>

      <div class="flex flex-col gap-5 md:col-span-4">
        <p class="text-lg font-black tracking-widest text-[#4da3ff] uppercase drop-shadow-sm">ฝ่ายดูแลสมาชิก</p>
        <div aria-hidden="true" class="h-[1px] w-12 bg-[#0b7cf4]"></div>

        <a
          href="/line/"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] py-3.5 font-bold text-white shadow-[0_5px_15px_rgba(0,185,0,0.3)] transition-all hover:-translate-y-1 hover:shadow-[0_8px_20px_rgba(0,185,0,0.4)]">
          ติดต่อแอดมิน LINE
        </a>

        {
          BRAND_ADDRESS.lines.length > 0 && (
            <address aria-label={BRAND_ADDRESS.label} class="mt-2 rounded-xl border border-white/15 bg-black/20 p-4 text-xs leading-relaxed not-italic opacity-90">
              <p class="mb-2 flex items-center gap-2 text-[11px] font-bold tracking-wider uppercase opacity-80">
                <span aria-hidden="true" class="text-sm">📍</span>
                {BRAND_ADDRESS.label}
              </p>
              {BRAND_ADDRESS.lines.map((line) => (
                <span class="block">{line}</span>
              ))}
              {BRAND_ADDRESS.email && (
                <a href={`mailto:${BRAND_ADDRESS.email}`} class="mt-3 inline-flex items-center gap-2 font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                  <span aria-hidden="true" class="text-sm">✉️</span>
                  {BRAND_ADDRESS.email}
                </a>
              )}
            </address>
          )
        }

        <div class="mt-4 text-xs font-medium tracking-widest text-[#dbe9ff]/60 uppercase">ช่องทางฝากถอนที่รองรับ</div>
        <BankStrip size={30} />
      </div>
    </div>

    <div class="flex flex-col items-center justify-between border-t border-[#1a4a9c] pt-8 text-xs font-medium tracking-wide text-[#dbe9ff]/55 md:flex-row">
      <p>COPYRIGHT &copy; {new Date().getFullYear()} {BRAND_NAME}. ALL RIGHTS RESERVED.</p>
      <div class="mt-4 flex gap-4 md:mt-0">
        <a href="/terms/" class="transition-colors hover:text-[#ff5a60]">TERMS &amp; CONDITIONS</a>
        <a href="/privacy/" class="transition-colors hover:text-[#ff5a60]">PRIVACY POLICY</a>
      </div>
    </div>
  </div>
</footer>
