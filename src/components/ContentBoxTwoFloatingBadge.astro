---
export interface Props {
  title?: string;
  titleleft?: string;
  titleright?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, titleleft, titleright, as: HeadingTag = "h2" } = Astro.props;
---

<section class="my-10 flex w-full justify-center px-4 font-sans">
  <div class="relative isolate w-full max-w-7xl rounded-2xl border-2 border-[#33220a] bg-gradient-to-b from-[#120c02] to-[#0e0902] p-8 pt-40 shadow-[0_10px_30px_rgba(212,132,14,0.20)] md:pt-36">
    <div aria-hidden="true" class="pointer-events-none absolute -top-16 -right-10 -z-10 h-40 w-40 rounded-full bg-[#cdbb93]/18 blur-[60px]"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -bottom-16 -left-10 -z-10 h-40 w-40 rounded-full bg-[#d4840e]/24 blur-[60px]"></div>

    {
      title && (
        <div class="absolute -top-6 left-1/2 flex w-[92%] max-w-2xl -translate-x-1/2 items-center justify-center gap-2 rounded-lg border-2 border-[#d4840e]/55 bg-[#221703] px-4 py-2.5 text-center shadow-[0_10px_30px_rgba(212,132,14,0.30)] sm:px-8">
          <span aria-hidden="true" class="shrink-0 text-[#cdbb93]">
            ✦
          </span>
          <HeadingTag class="min-w-0 bg-gradient-to-r from-[#fec93a] via-[#f4e8d2] to-[#cdbb93] bg-clip-text text-lg leading-normal font-black tracking-tight text-transparent uppercase sm:text-xl md:text-2xl">
            {title}
          </HeadingTag>
          <span aria-hidden="true" class="shrink-0 text-[#cdbb93]">
            ✦
          </span>
        </div>
      )
    }

    <div class="grid grid-cols-1 gap-10 md:grid-cols-2">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#e6e8ee]">
        {titleleft && <p class="text-2xl leading-normal font-bold text-[#f4e8d2]">{titleleft}</p>}
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#e6e8ee] md:border-l md:border-[#33220a] md:pl-10">
        {titleright && <p class="text-2xl leading-normal font-bold text-[#f4e8d2]">{titleright}</p>}
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
