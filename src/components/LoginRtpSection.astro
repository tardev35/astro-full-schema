---
import ContentBoxTwo from "./ContentBoxTwo.astro";

const steps = [
  { icon: "📝", name: "สมัครยูสด้วยข้อมูลเท่าที่จำเป็น", detail: "ใช้ข้อมูลสำหรับสร้างบัญชีและยืนยันตัวตนเท่านั้น ตั้งรหัสผ่านที่คาดเดายากและไม่ซ้ำกับบัญชีสำคัญอื่น", tag: "ขั้นที่ 1" },
  { icon: "👛", name: "เติมยอดผ่านทรูมันนี่วอลเล็ท", detail: "ตรวจหมายเลขบัญชี ยอดเงิน และช่องทางที่ระบบกำหนดให้ถูกต้องก่อนกดยืนยัน เพื่อไม่ให้รายการตรวจสอบล่าช้า", tag: "ขั้นที่ 2" },
  { icon: "🎰", name: "เลือกเกมสล็อตจากบัญชีเดิม", detail: "เมื่อยอดอัปเดตแล้วเลือกเกมและเข้าเล่นต่อผ่านเมนูภายในเว็บไซต์ได้ทันที ไม่ต้องสมัครยูสใหม่อีกรอบ", tag: "ขั้นที่ 3" },
  { icon: "🔎", name: "ติดตามสถานะรายการจากระบบ", detail: "ทุกคำขอเติม ฝาก ถอนประมวลผลอัตโนมัติ และยังติดต่อแอดมินคนจริงเพื่อสอบถามได้ตามปกติ", tag: "ขั้นที่ 4" },
  { icon: "⚡", name: "ถอนได้เองตลอด 24 ชั่วโมง", detail: "กดถอนแล้วระบบการเงินโอนให้ครบทุกจำนวน ไม่จำกัดวงเงินต่อวัน และไม่มีการหักค่าธรรมเนียม", tag: "ขั้นที่ 5" },
];

const chips = ["ทรูมันนี่วอลเล็ท", "ยูสเดียวจบ", "เติมออโต้", "ฝากออโต้", "ถอนออโต้", "ไม่มีขั้นต่ำ", "ตลอด 24 ชั่วโมง", "เล่นบนมือถือ", "จ่ายเต็มทุกบาท", "ระบบล่าสุด"];
---

<ContentBoxTwo
  titleleft="เข้าสู่ระบบ AMBHENG88"
  titleright="ลำดับการใช้งานตั้งแต่สมัครถึงถอนยอด"
  label="เข้าสู่ระบบ AMBHENG88 และลำดับการใช้งานตั้งแต่สมัครถึงถอนยอด">
  <div slot="left" class="flex h-full flex-col gap-4">
    <div class="relative overflow-hidden rounded-2xl border border-[#4a1030] bg-[#280a1c] p-6 shadow-[0_10px_30px_rgba(255,45,142,0.16)]">
      <div aria-hidden="true" class="pointer-events-none absolute -top-10 -right-10 h-32 w-32 rounded-full bg-[#ff2d8e]/16 blur-[50px]"></div>

      <div class="relative z-10 mb-5 flex items-center gap-3">
        <span
          aria-hidden="true"
          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#7d0b46] bg-gradient-to-br from-[#ff74b6] via-[#ff2d8e] to-[#c20e6a] text-xl shadow-inner">
          🎰
        </span>
        <div class="flex flex-col">
          <p class="text-base font-black text-[#ffe814]">ล็อกอินแล้วจัดการทุกขั้นตอนได้จากยูสของตัวเอง</p>
          <span class="text-[11px] text-[#c49ab6]">
            ยูสเดียวใช้ได้ทั้งการเติมยอดผ่านทรูมันนี่วอลเล็ทและการเข้าเล่นเกมสล็อต ตรวจยอดคงเหลือ ดูสถานะรายการ และย้อนดูประวัติการทำรายการได้จากหน้าเมมเบอร์
          </span>
        </div>
      </div>

      <div class="relative z-10 flex flex-col gap-3.5">
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#ff2d8e]">👤</span>
          <input
            type="text"
            placeholder="เบอร์โทรศัพท์ / ยูสเซอร์เนม"
            class="w-full rounded-xl border border-[#4a1030] bg-[#170512] py-3 pr-4 pl-12 text-[#f3e3ee] transition-all outline-none placeholder:text-[#c49ab6] focus:border-[#ff2d8e] focus:ring-1 focus:ring-[#ff2d8e]/50"
          />
        </div>
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#ff2d8e]">🔑</span>
          <input
            type="password"
            placeholder="รหัส PIN 4 หลัก"
            class="w-full rounded-xl border border-[#4a1030] bg-[#170512] py-3 pr-4 pl-12 text-[#f3e3ee] transition-all outline-none placeholder:text-[#c49ab6] focus:border-[#ff2d8e] focus:ring-1 focus:ring-[#ff2d8e]/50"
          />
        </div>

        <div class="flex items-center justify-between px-1 text-xs">
          <label class="flex items-center gap-2 text-[#c49ab6]">
            <input type="checkbox" class="h-3.5 w-3.5 rounded border-[#4a1030] bg-[#170512] accent-[#ff2d8e]" />
            จดจำฉันไว้
          </label>
          <a href="/login" class="text-[#c49ab6] transition-colors hover:text-[#ffe814]">ลืมรหัส PIN?</a>
        </div>

        <button
          class="mt-1 w-full rounded-xl border border-[#7d0b46] bg-gradient-to-r from-[#ff74b6] via-[#ff2d8e] to-[#c20e6a] p-3.5 font-black text-[#170512] shadow-[0_10px_30px_rgba(255,45,142,0.32)] transition-all hover:scale-[1.02] hover:shadow-[0_15px_40px_rgba(255,45,142,0.42)]">
          เข้าสู่ระบบ
        </button>

        <div class="flex items-center gap-3 py-1 text-[11px] text-[#c49ab6]">
          <span class="h-px flex-1 bg-[#4a1030]"></span>
          หรือ
          <span class="h-px flex-1 bg-[#4a1030]"></span>
        </div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] p-3 text-sm font-bold text-white shadow-md transition-all hover:scale-[1.02]">
          <span aria-hidden="true">💬</span> ทักไลน์ทีมงานตลอด 24 ชั่วโมง
        </a>

        <div class="mt-1 flex items-center justify-between px-1">
          <div class="flex gap-2">
            <span class="rounded-full border border-[#4a1030] bg-[#170512] px-2.5 py-1 text-[10px] font-bold text-[#ff74b6]"><span aria-hidden="true">🔒</span> ดูแลข้อมูลสมาชิก</span>
            <span class="rounded-full border border-[#c9a800]/60 bg-[#170512] px-2.5 py-1 text-[10px] font-bold text-[#ffe814]"><span aria-hidden="true">🕐</span> ใช้งานได้ตลอด 24 ชม.</span>
          </div>
          <a href="/register" class="text-xs font-bold text-[#c49ab6] transition-colors hover:text-[#ffe814]">สมัครสมาชิกใหม่</a>
        </div>
      </div>
    </div>
  </div>

  <div slot="right" class="h-full">
    <div class="flex h-full flex-col rounded-2xl border border-[#4a1030] bg-[#280a1c] p-5 shadow-[0_10px_30px_rgba(255,45,142,0.16)]">
      <div class="mb-5 flex items-center justify-between gap-3">
        <div>
          <span class="text-xs font-bold tracking-wide text-[#c49ab6]">ลำดับการใช้งานที่ AMBHENG88 วางไว้ ตั้งแต่เปิดยูสจนถอนยอดออก อยู่ในระบบออโต้ชุดเดียวกันทั้งหมด</span>
          <div class="bg-gradient-to-r from-[#ff74b6] via-[#ff2d8e] to-[#ffe814] bg-clip-text text-2xl font-black text-transparent sm:text-3xl">สมัคร • เติม • เล่น • ถอน</div>
        </div>
        <span class="flex items-center gap-1.5 self-start rounded-full border border-green-400/40 bg-[#170512] px-2.5 py-1">
          <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-green-400 shadow-[0_0_8px_rgba(74,222,128,0.7)]"></span>
          <span class="text-[10px] font-bold tracking-widest text-green-400 uppercase">Live</span>
        </span>
      </div>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#c49ab6] uppercase">
        <span>ขั้นตอนการใช้งาน</span>
        <span>ลำดับ</span>
      </div>

      <div class="flex flex-1 flex-col gap-2.5">
        {
          steps.map((s) => (
            <div class="rounded-xl border border-[#4a1030] bg-[#170512] px-3.5 py-2.5 transition-colors hover:border-[#ff2d8e]/55 hover:bg-[#4a1030]">
              <div class="flex items-center justify-between gap-2 text-sm">
                <span class="flex min-w-0 items-center gap-2 font-bold text-[#f3e3ee]">
                  <span aria-hidden="true" class="w-5 shrink-0 text-center">
                    {s.icon}
                  </span>{" "}
                  <span class="truncate">{s.name}</span>
                </span>
                <span class="shrink-0 rounded-full border border-[#c9a800]/60 bg-[#280a1c] px-2.5 py-0.5 text-[10px] font-bold text-[#ffe814]">{s.tag}</span>
              </div>
              <div class="mt-1.5 text-[11px] tracking-wide text-[#c49ab6]">{s.detail}</div>
            </div>
          ))
        }
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
        {chips.map((c) => <span class="rounded-full border border-[#4a1030] bg-[#170512] px-3 py-1 text-[10px] font-bold text-[#ff74b6]">{c}</span>)}
      </div>

      <div class="mt-3 text-center text-[10px] tracking-wide text-[#c49ab6]">
        ลำดับในตารางสรุปจากที่หน้าเว็บแสดงไว้ เงื่อนไขการทำรายการ ขอบเขตของคำว่าไม่มีขั้นต่ำ และบริการที่เปิดใช้งานจริงให้ยึดตามคู่มือและหน้าเมมเบอร์ของ AMBHENG88 ก่อนทำรายการทุกครั้ง
        และอย่าบอกรหัสผ่านหรือ OTP กับใคร หากติดขัดตรงไหนทักไลน์ทีมงานได้ตลอด 24 ชั่วโมง
      </div>
    </div>
  </div>
</ContentBoxTwo>
