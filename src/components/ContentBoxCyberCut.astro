---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
---

<section class="my-4 flex w-full justify-center px-4 font-sans">
  <div
    class="w-full max-w-7xl rounded-2xl border-2 border-yellow-600/30 bg-[#4a0404]/80 p-8 text-center text-white/90 shadow-[0_0_20px_rgba(234,179,8,0.1),inset_0_0_15px_rgba(234,179,8,0.05)] backdrop-blur-md transition-all duration-300 hover:border-yellow-500/60 hover:shadow-[0_0_30px_rgba(234,179,8,0.25)]">
    {
      title && (
        <header class="mb-8">
          <HeadingTag class="bg-gradient-to-b from-[#fef08a] via-[#eab308] to-[#b45309] bg-clip-text text-3xl font-black tracking-tight text-transparent drop-shadow-[0_2px_4px_rgba(0,0,0,0.5)] md:text-4xl">
            {title}
          </HeadingTag>
        </header>
      )
    }
    <div class="text-lg leading-relaxed text-red-50/90">
      <slot />
    </div>
  </div>
</section>
<style>
  .font-sans {
    font-family: "Kanit", sans-serif;
  }
</style>
