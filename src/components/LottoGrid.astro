---
const lottos = [
  { name: "หวยรัฐบาลไทย", close: "15:00 น.", reward: "บาทละ 900", icon: "🇹🇭" },
  { name: "หวยฮานอย", close: "18:00 น.", reward: "บาทละ 95", icon: "🇻🇳" },
  { name: "หวยลาวพัฒนา", close: "20:00 น.", reward: "บาทละ 95", icon: "🇱🇦" },
  { name: "หวยยี่กี 88 รอบ", close: "ทุก 15 นาที", reward: "บาทละ 95", icon: "⏱️" },
  { name: "หวยมาเลย์", close: "18:00 น.", reward: "บาทละ 95", icon: "🇲🇾" },
  { name: "หวยหุ้นไทย", close: "16:40 น.", reward: "บาทละ 95", icon: "📈" },
];
---

<div class="mx-auto mb-10 w-full max-w-[1300px] px-4 font-sans">
  <div class="mb-6 flex w-full flex-col items-center justify-center gap-2 text-center">
    <h2 class="text-2xl font-black tracking-widest text-[#0a1128] uppercase">เลือกแทงหวยออนไลน์</h2>
    <div class="h-[3px] w-16 rounded-full bg-[#ffd60a]"></div>
  </div>

  <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-6">
    {
      lottos.map((lotto) => (
        <div class="group relative flex cursor-pointer flex-col items-center justify-center rounded-xl border border-gray-200 bg-white p-5 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:border-[#ffd60a] hover:shadow-lg">
          <div class="mb-3 text-4xl transition-transform duration-300 group-hover:scale-110">{lotto.icon}</div>
          <h3 class="text-center text-sm font-bold text-[#0a1128] transition-colors group-hover:text-[#007bff]">{lotto.name}</h3>
          <p class="mt-1 text-[10px] text-gray-500">
            ปิดรับ: <span class="font-mono font-bold text-[#0a1128]">{lotto.close}</span>
          </p>
          <div class="mt-3 rounded-md bg-[#f4f6f9] px-3 py-1 text-[11px] font-bold text-[#0a1128] transition-colors group-hover:bg-[#ffd60a]">{lotto.reward}</div>
        </div>
      ))
    }
  </div>
</div>

<style>
  .font-sans {
    font-family: "Kanit", sans-serif;
  }
</style>
