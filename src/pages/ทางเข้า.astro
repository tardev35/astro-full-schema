---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement.astro";
import { pageGraph } from "../lib/schema";

const pageDescription =
  "ทางเข้า YIMSIAM88 เว็บหลัก สล็อตเว็บตรงไทยแท้ กดเข้าสู่ระบบหรือสมัครสมาชิกได้จากหน้านี้ทันที โบนัสแรงแตกบ่อย จ่ายเต็มไม่มีหัก ฝากถอนออโต้ไม่มีขั้นต่ำ 24 ชม.";

const graph = pageGraph(Astro, {
  name: "ทางเข้า YIMSIAM88 เว็บหลัก",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทางเข้า", path: "/ทางเข้า" },
  ],
});
---

<MainLayout title="ทางเข้า YIMSIAM88 เว็บหลัก" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="ทางเข้า YIMSIAM88 เว็บหลัก" as="h1">
    <div class="mb-5 grid grid-cols-1 gap-8 md:grid-cols-2">
      <div class="flex flex-col items-center justify-center gap-4">
        <a
          href="/login"
          aria-label="เข้าสู่ระบบ YIMSIAM88"
          class="group relative mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#f6c475]/60 bg-[#24100a] px-6 py-4 shadow-[0_10px_30px_rgba(255,122,24,0.18)] transition-all duration-300 hover:scale-105 hover:border-[#ff7a18] hover:bg-[#2a0f06] hover:shadow-[0_15px_40px_rgba(255,122,24,0.30)]">
          <div aria-hidden="true" class="absolute inset-x-0 top-0 h-1/2 bg-gradient-to-b from-[#ff7a18]/20 to-transparent"></div>

          <svg
            class="relative z-10 h-9 w-9 text-[#ff7a18]"
            aria-hidden="true"
            focusable="false"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            viewBox="0 0 24 24"
            xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"></path>
          </svg>

          <span class="relative z-10 text-3xl font-bold tracking-wide text-[#ffd98a]">เข้าสู่ระบบ</span>
        </a>
      </div>

      <div class="flex flex-col items-center justify-center gap-4">
        <a
          href="/register"
          aria-label="สมัครสมาชิก YIMSIAM88"
          class="group relative mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#f6c475]/60 bg-gradient-to-r from-[#ffd98a] via-[#ff7a18] to-[#8d2b09] px-6 py-4 shadow-[0_10px_30px_rgba(255,122,24,0.18)] transition-all duration-300 hover:scale-105 hover:shadow-[0_15px_40px_rgba(255,122,24,0.30)]">
          <div aria-hidden="true" class="absolute inset-x-0 top-0 h-1/2 bg-gradient-to-b from-white/55 to-transparent"></div>

          <svg
            class="relative z-10 h-9 w-9 text-[#160604]"
            aria-hidden="true"
            focusable="false"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            viewBox="0 0 24 24"
            xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"></path>
          </svg>

          <span class="relative z-10 text-3xl font-bold tracking-wide text-[#160604]">สมัครสมาชิก</span>
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
