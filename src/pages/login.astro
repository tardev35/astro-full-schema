---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";
import CtaRedirect from "../components/CtaRedirect.astro";
import { pageGraph } from "../lib/schema";

const pageDescription =
  "เข้าสู่ระบบ KOH888 หน้าล็อกอินเว็บหลัก ใช้บัญชีเดิมเข้าเล่นสล็อต คาสิโน บาคาร่า บอล และหวย ตรวจยอดเครดิต รับโปรโมชั่น และดูประวัติฝากถอนออโต้ได้ทุกอุปกรณ์";

const graph = pageGraph(Astro, {
  name: "เข้าสู่ระบบ KOH888 เว็บหลัก",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เข้าสู่ระบบ", path: "/login" },
  ],
});

const targetUrl = "https://yoalink.com/22hs";
---

<MainLayout title="เข้าสู่ระบบ KOH888 | ล็อกอินเว็บหลัก รองรับทุกอุปกรณ์" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="เข้าสู่ระบบ KOH888" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label="เข้าระบบเกม"
        class="group relative mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#8b36d9]/70 bg-[#3b0a63] px-6 py-4 text-xl font-bold tracking-wide text-[#ffe9a3] shadow-[0_10px_30px_rgba(139,54,217,0.35)] transition-all duration-300 hover:scale-105 hover:border-[#c77dff] hover:bg-[#1a0a2e] hover:text-[#f5c542] hover:shadow-[0_15px_40px_rgba(199,125,255,0.42)]">
        เข้าระบบเกม
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="เข้าสู่ระบบ" />
</MainLayout>
