---
import { Picture } from "astro:assets";

import slide2 from "../assets/slide2.png";
import slide3 from "../assets/slide3.png";

const images = [
  {
    src: slide2,
    alt: "ภาพโปรโมชั่น WON22 โทนส้มไฟสลับทองบนพื้นดำ ด้านบนเป็นโลโก้ตัวอักษรทอง WON22 มีมงกุฎอยู่เหนือตัวอักษรและบรรทัดว่า WON TO WIN ด้านขวาเป็นพรีเซนเตอร์หญิงสวมเดรสซาตินสีแดงสนิมยืนอยู่หน้าฉากคาสิโน มีเหรียญทองลอยอยู่รอบภาพ ตัวอักษรใหญ่ว่า เกมสล็อต ออนไลน์เว็บตรง ถัดลงมาเป็นแถวไอคอนทองสี่แถวว่า ฝากถอนออโต้ รวดเร็ว ทันใจ 24 ชม. ไม่ติดเทิร์น เล่นง่าย ถอนได้จริง สมัครง่าย ไม่กี่ขั้นตอน เล่นได้ทันที และ โปรโมชั่นจัดเต็ม โบนัสเยอะ ให้ทุกวัน ปิดท้ายด้วยแถบล่างว่า เว็บตรง ปลอดภัย เกมสล็อต ครบทุกค่าย และ รองรับมือถือ เล่นได้ทุกที่",
  },
  {
    src: slide3,
    alt: "ภาพโปรโมชั่น WON22 โทนส้มไฟสลับทองบนพื้นดำ ด้านบนเป็นโลโก้ตัวอักษรทอง WON22 พร้อมมงกุฎและบรรทัดว่า WON TO WIN ด้านขวาเป็นพรีเซนเตอร์หญิงสวมเดรสซาตินสีแดงสนิมถือโทรศัพท์มือถือ มีเหรียญทองลอยอยู่รอบภาพ ตัวอักษรใหญ่ว่า เกมสล็อตออนไลน์ เว็บตรง ต่อด้วยป้ายว่า ฝากถอน ไม่ติดเทิร์น และ สมัครง่าย ถัดลงมาเป็นแถวไอคอนทองห้าแถวว่า ฝากถอนออโต้ รวดเร็ว ทันใจ 24 ชม. ไม่ติดเทิร์น เล่นง่าย ถอนได้จริง สมัครง่าย ไม่กี่ขั้นตอน เล่นได้ทันที โปรโมชั่นจัดเต็ม โบนัสเยอะ รับไม่อั้น และ รองรับมือถือ เล่นได้ทุกที่ ทุกเวลา ปิดท้ายด้วยแถบล่างว่า เว็บตรง ปลอดภัย 100% เกมสล็อต ครบทุกค่าย และ มั่นคง ปลอดภัย ข้อมูลไม่รั่วไหล",
  },
];

const COPIES = 3;
const slides = Array.from({ length: COPIES }, () => images).flat();
---

<div class="marquee mx-auto w-full max-w-7xl overflow-hidden px-4 py-5">
  <input id="carousel-pause" type="checkbox" class="peer sr-only" />
  <label
    for="carousel-pause"
    class="sr-only cursor-pointer peer-focus-visible:not-sr-only peer-focus-visible:mb-3 peer-focus-visible:inline-block peer-focus-visible:rounded-full peer-focus-visible:border peer-focus-visible:border-[#f97316]/60 peer-focus-visible:bg-[#241004] peer-focus-visible:px-4 peer-focus-visible:py-2 peer-focus-visible:text-sm peer-focus-visible:font-bold peer-focus-visible:text-[#fcd34d]">
    หยุด / เล่นสไลด์ภาพ
  </label>

  <div class="marquee-track flex">
    {
      slides.map((slide, index) => {
        const isDuplicate = index >= images.length;
        return (
          <div class="marquee-slide" aria-hidden={isDuplicate ? "true" : undefined}>
            <Picture
              src={slide.src}
              alt={isDuplicate ? "" : slide.alt}
              class="block w-full rounded-xl border border-[#6b2f0b] object-cover shadow-[0_10px_30px_rgba(249,115,22,0.20)]"
              width={slide.src.width}
              height={slide.src.height}
              loading="lazy"
              fetchpriority="low"
              decoding="async"
              widths={[300, 360, 420, 480, 540, 600]}
              sizes="(max-width: 767px) calc(100vw - 32px), (max-width: 1279px) calc((100vw - 48px) / 2), 403px"
              formats={["avif", "webp"]}
              fallbackFormat="webp"
              quality={60}
            />
          </div>
        );
      })
    }
  </div>
</div>

<style>
  .marquee {
    --gap: 12px;
    --per-view: 1;
    --shift: calc(-200% - 24px);
  }

  @media (min-width: 768px) {
    .marquee {
      --gap: 16px;
      --per-view: 2;
      --shift: calc(-100% - 16px);
    }
  }

  @media (min-width: 1280px) {
    .marquee {
      --gap: 20px;
      --per-view: 3;
      --shift: calc(-66.6667% - 13.3333px);
    }
  }

  .marquee-track {
    gap: var(--gap);
    width: 100%;
    animation: carousel-scroll 24s linear infinite;
    will-change: transform;
  }

  .marquee-slide {
    flex: 0 0 calc((100% - (var(--per-view) - 1) * var(--gap)) / var(--per-view));
  }

  @keyframes carousel-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(var(--shift));
    }
  }

  .marquee:hover .marquee-track,
  .marquee:focus-within .marquee-track,
  .marquee > input:checked ~ .marquee-track {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
    }
  }
</style>
