---
export interface Props {
  titleleft?: string;
  titleright?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { titleleft, titleright, as: HeadingTag = "h2" } = Astro.props;
---

<section class="mx-auto mb-6 w-full max-w-7xl px-4 font-sans">
  <div
    class="relative isolate w-full border border-[#2c1266] bg-[#0a0320] p-8 text-[#ece6ff] shadow-[0_10px_30px_rgba(255,61,200,0.18)] transition-all duration-300 hover:border-[#ff3dc8]/60 hover:shadow-[0_15px_40px_rgba(255,61,200,0.28)]"
    style="clip-path: polygon(30px 0, 100% 0, 100% calc(100% - 30px), calc(100% - 30px) 100%, 0 100%, 0 30px);">
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-[2px] w-24 bg-gradient-to-r from-[#ff3dc8] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-[2px] w-24 bg-gradient-to-l from-[#1be5f4] to-transparent"></div>
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-16 w-[2px] bg-gradient-to-b from-[#ff3dc8] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-16 w-[2px] bg-gradient-to-t from-[#1be5f4] to-transparent"></div>

    <div class="grid grid-cols-1 gap-8 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#ece6ff]">
        {
          titleleft && (
            <div class="flex items-baseline gap-2 border-b border-[#2c1266] pb-2">
              <span aria-hidden="true" class="font-mono text-[#ff3dc8]">
                &gt;_
              </span>
              <p class="text-xl leading-normal font-black text-[#ff8fe0] uppercase">{titleleft}</p>
            </div>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#ece6ff] md:border-l md:border-[#2c1266] md:pl-8">
        {
          titleright && (
            <div class="flex items-baseline gap-2 border-b border-[#2c1266] pb-2">
              <span aria-hidden="true" class="font-mono text-[#1be5f4]">
                &gt;_
              </span>
              <HeadingTag class="text-xl leading-normal font-black text-[#ff8fe0] uppercase">{titleright}</HeadingTag>
            </div>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
