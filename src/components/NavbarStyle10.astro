---
import { isActivePath } from "../lib/nav";
import { Picture } from "astro:assets";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });
const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;
const currentPath = Astro.url.pathname;
const isActive = (path: string) => isActivePath(currentPath, path);

const logoAlt =
  "โลโก้ DOLLAR789 ตัวอักษรนูนสามมิติเขียนว่า DOLLAR789 โดยคำว่า DOLLAR เป็นสีทองและตัว D ทำเป็นสัญลักษณ์ดอลลาร์ ส่วนเลข 789 เป็นสีเงินโครเมียม วางบนพื้นหลังโปร่งใส";

const links = [
  { name: "หน้าแรก", path: "/", icon: "🏠" },
  { name: "โปรโมชั่น", path: "/promotion/", icon: "🎁" },
  { name: "สมัครสมาชิก", path: "/register/", icon: "📝" },
  { name: "เข้าสู่ระบบ", path: "/login/", icon: "🔑" },
  { name: "ทดลองเล่น", path: "/ทดลองเล่น/", icon: "🃏" },
  { name: "เกี่ยวกับเรา", path: "/about-us/", icon: "📘" },
  { name: "ติดต่อเรา", path: "/contact-us/", icon: "💬" },
];
---

<div class="hidden w-full border-b border-[#7c3aed]/45 bg-gradient-to-r from-[#050010] via-[#2a1147] to-[#050010] px-4 py-1.5 font-sans text-xs font-bold text-[#e9d5ff]/85 lg:block">
  <div class="mx-auto flex max-w-400 justify-between">
    <div class="flex gap-4">
      <span class="flex items-center gap-1"><span aria-hidden="true" class="text-[#f5c542]">🎴</span> DOLLAR789 รวมคาสิโนสด บาคาร่า สล็อต และฟุตบอลไว้ในยูสเดียว</span>
      <span class="flex items-center gap-1 text-[#ffe9a8]"><span aria-hidden="true" class="text-[#f5c542]">⚡</span> ฝากถอนออโต้ ทำรายการได้ตลอด 24 ชั่วโมง</span>
    </div>
    <div class="flex gap-4">
      <a href="/line/" class="flex items-center gap-1 transition-colors hover:text-[#ffd75e]">ติดต่อแอดมิน LINE: @DOLLAR789</a>
    </div>
  </div>
</div>

<header class="sticky top-2 z-50 mt-2 w-full px-2 font-sans md:px-4">
  <nav
    class="relative mx-auto flex h-[75px] w-full max-w-400 items-center justify-between gap-4 rounded-[20px] border border-[#a855f7]/50 bg-[#0b011b]/90 px-4 shadow-[0_10px_30px_rgba(168,85,247,0.28)] backdrop-blur-lg xl:px-6">
    <a href="/" class="z-50 flex-shrink-0 transition-transform hover:scale-105">
      {
        mainLogo ? (
          <Picture
            src={mainLogo}
            alt={logoAlt}
            loading="eager"
            fetchpriority="high"
            widths={[170, 340, 510]}
            sizes="170px"
            class="h-[40px] w-auto max-w-[170px] object-contain drop-shadow-[0_0_10px_rgba(168,85,247,0.55)] xl:h-[45px]"
            formats={["avif", "webp"]}
            fallbackFormat="webp"
          />
        ) : (
          <span class="bg-gradient-to-b from-[#ffe9a8] to-[#a3610c] bg-clip-text text-3xl font-black text-transparent drop-shadow-[0_0_8px_rgba(168,85,247,0.45)]">DOLLAR789</span>
        )
      }
    </a>

    <div class="hidden h-full min-w-0 items-center justify-center gap-5 xl:flex 2xl:gap-8">
      {
        links.map((item) => (
          <a
            href={item.path}
            class={`group relative flex h-full shrink-0 items-center gap-1.5 text-sm font-bold whitespace-nowrap transition-colors xl:text-base ${isActive(item.path) ? "text-[#f5c542] drop-shadow-[0_0_8px_rgba(168,85,247,0.45)]" : "text-[#e9d5ff]/80 hover:text-[#f5c542]"}`}>
            <span aria-hidden="true" class="text-base leading-none">
              {item.icon}
            </span>
            <span>{item.name}</span>
            <div
              class={`absolute bottom-[18px] left-0 h-[2px] w-full origin-center bg-[#a855f7] shadow-[0_0_10px_rgba(168,85,247,0.9)] transition-transform duration-300 ${isActive(item.path) ? "scale-x-100" : "scale-x-0 group-hover:scale-x-100"}`}
            />
          </a>
        ))
      }
    </div>

    <div class="z-50 flex shrink-0 items-center gap-2 xl:gap-3">
      <a
        href="/login/"
        class="hidden items-center justify-center rounded-full border border-[#a855f7]/60 bg-[#1e0c33] px-6 py-2 text-sm font-bold whitespace-nowrap text-[#ffe9a8] shadow-sm transition-all hover:bg-[#a855f7]/25 2xl:flex">
        เข้าสู่ระบบ
      </a>
      <a
        href="/register/"
        class="hidden items-center justify-center rounded-full bg-gradient-to-r from-[#ffe9a8] via-[#f5c542] to-[#a3610c] px-4 py-2 text-sm font-black whitespace-nowrap text-[#150826] shadow-[0_0_15px_rgba(245,197,66,0.45)] transition-all hover:scale-105 lg:flex xl:px-6">
        สมัครสมาชิก
      </a>

      <button
        id="hamburger-btn"
        class="relative flex h-[42px] w-[42px] flex-col items-center justify-center gap-[5px] rounded-full border border-[#a855f7]/40 bg-gradient-to-b from-[#2a1147] to-[#050010] shadow-sm xl:hidden"
        aria-label="เปิดเมนู">
        <span class="line-1 h-[2px] w-5 origin-center rounded-full bg-[#a855f7] transition-all duration-300"></span>
        <span class="line-2 h-[2px] w-5 origin-center rounded-full bg-[#a855f7] transition-all duration-300"></span>
        <span class="line-3 h-[2px] w-5 origin-center rounded-full bg-[#a855f7] transition-all duration-300"></span>
      </button>
    </div>
  </nav>

  <div id="fullscreen-menu" class="pointer-events-none fixed inset-0 z-[40] flex flex-col items-center justify-center bg-[#050010]/98 opacity-0 backdrop-blur-xl transition-opacity duration-500">
    <div class="flex w-full flex-col items-center space-y-5 px-6">
      {
        links.map((item) => (
          <a
            href={item.path}
            class={`fs-item flex items-center gap-3 text-2xl font-black tracking-widest uppercase transition-all duration-300 ${isActive(item.path) ? "text-[#f5c542] drop-shadow-[0_0_12px_rgba(168,85,247,0.65)]" : "text-[#e9d5ff]/85 hover:text-[#ffd75e]"}`}>
            <span aria-hidden="true" class="text-2xl leading-none">
              {item.icon}
            </span>
            {item.name}
          </a>
        ))
      }
      <div class="fs-item mt-4 flex w-full max-w-[280px] flex-col gap-4 pt-6">
        <a
          href="/register/"
          class="flex w-full items-center justify-center rounded-full bg-gradient-to-r from-[#ffe9a8] to-[#f5c542] py-3.5 text-lg font-black text-[#150826] shadow-[0_0_20px_rgba(168,85,247,0.5)]">
          สมัครสมาชิกใหม่
        </a>
        <a
          href="/login/"
          class="flex w-full items-center justify-center rounded-full border-2 border-[#a855f7]/60 bg-[#1e0c33] py-3.5 text-lg font-bold text-[#ffe9a8] transition-colors hover:bg-[#a855f7]/25">
          เข้าสู่ระบบ
        </a>
      </div>
    </div>
  </div>
</header>

<style is:global>
  #hamburger-btn.active .line-1 {
    transform: translateY(7px) rotate(45deg);
  }
  #hamburger-btn.active .line-2 {
    opacity: 0;
  }
  #hamburger-btn.active .line-3 {
    transform: translateY(-7px) rotate(-45deg);
  }

  .fs-item {
    opacity: 0;
    transform: translateY(20px);
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .fs-item.show {
    opacity: 1;
    transform: translateY(0);
  }
  .fs-item:nth-child(1) {
    transition-delay: 0.1s;
  }
  .fs-item:nth-child(2) {
    transition-delay: 0.15s;
  }
  .fs-item:nth-child(3) {
    transition-delay: 0.2s;
  }
  .fs-item:nth-child(4) {
    transition-delay: 0.25s;
  }
  .fs-item:nth-child(5) {
    transition-delay: 0.3s;
  }
  .fs-item:nth-child(6) {
    transition-delay: 0.35s;
  }
  .fs-item:nth-child(7) {
    transition-delay: 0.4s;
  }
  .fs-item:nth-child(8) {
    transition-delay: 0.45s;
  }

  @media (prefers-reduced-motion: reduce) {
    .fs-item {
      transition: none;
      transform: none;
    }
  }
</style>

<script>
  const hamburgerBtn = document.getElementById("hamburger-btn");
  const fsMenu = document.getElementById("fullscreen-menu");
  const fsItems = document.querySelectorAll(".fs-item");

  const toggleFsMenu = () => {
    hamburgerBtn?.classList.toggle("active");
    fsMenu?.classList.toggle("opacity-0");
    fsMenu?.classList.toggle("pointer-events-none");

    if (!fsMenu?.classList.contains("opacity-0")) {
      document.body.style.overflow = "hidden";
      fsItems.forEach((item) => item.classList.add("show"));
    } else {
      document.body.style.overflow = "";
      fsItems.forEach((item) => item.classList.remove("show"));
    }
  };

  hamburgerBtn?.addEventListener("click", toggleFsMenu);
  fsItems.forEach((item) => {
    item.addEventListener("click", () => {
      if (!fsMenu?.classList.contains("opacity-0")) toggleFsMenu();
    });
  });
</script>
