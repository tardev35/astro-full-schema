---
const reviews = [
  {
    name: "สมาชิกที่เล่นหลายหมวดในบัญชีเดียว",
    role: "สลับบาคาร่า สล็อต และกีฬาจากหน้าเดิม",
    stars: 5,
    tag: "บัญชีเดียวครบทุกหมวด",
    content:
      "ที่ชอบคือไม่ต้องกดออกเข้าใหม่ทุกครั้งที่อยากเปลี่ยนแนวครับ อยากพักจากสล็อตไปดูกีฬาหรือกลับมาเล่นบาคาร่าบนโต๊ะสด ก็เลือกต่อจากหน้าเดิมได้เลย เครดิตกับประวัติรายการอยู่ในหน้าสมาชิกเดียวกัน เลยไม่ต้องจำรหัสหลายชุดให้ปวดหัว",
    avatar: "🎴",
  },
  {
    name: "สมาชิกที่เล่นผ่านมือถือเป็นหลัก",
    role: "เปิดผ่านเบราว์เซอร์ ไม่ได้ลงโปรแกรมเพิ่ม",
    stars: 5,
    tag: "เล่นผ่านมือถือ",
    content:
      "ใช้โทรศัพท์เครื่องเดียวตั้งแต่ล็อกอิน เลือกหมวด ไปจนถึงเปิดเกม ไม่ต้องเปิดหลายแท็บให้จอเต็มค่ะ ความเร็วก็ยังขึ้นกับสัญญาณเน็ตกับรุ่นมือถืออยู่บ้าง แต่หน้าเว็บออกแบบให้รองรับจอเล็ก ปุ่มไม่ล้นและตัวหนังสืออ่านง่ายกว่าที่คิดไว้",
    avatar: "📱",
  },
  {
    name: "สมาชิกที่เริ่มจากยอดเล็ก",
    role: "ทำรายการผ่านหน้าบัญชีตามเวลาที่สะดวก",
    stars: 5,
    tag: "ฝากถอนออโต้ 24 ชั่วโมง",
    content:
      "ผมว่างไม่ตรงกับคนอื่น บางวันเพิ่งได้เข้าหลังเที่ยงคืน ระบบออโต้เลยช่วยได้เยอะ เติมเครดิต ถอน และดูสถานะรายการจากหน้าบัญชีได้เอง ส่วนเรื่องไม่มีขั้นต่ำผมแนะนำให้ดูเงื่อนไขในหน้ารายการก่อนนะครับ เพราะแต่ละบริการกำหนดไม่เหมือนกัน",
    avatar: "🔁",
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label="เสียงจากสมาชิก WINNOW168" class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#ff5a5f] via-[#e01e26] to-[#f5c542] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      เสียงจากสมาชิก <span class="text-[#f5c542]">WINNOW168</span>
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#e01e26] to-transparent"></div>
  </div>

  <div
    class="mx-auto mb-8 flex max-w-md items-center justify-center gap-5 rounded-2xl border border-[#f5c542]/25 bg-[#170707]/92 px-6 py-4 shadow-[0_10px_30px_rgba(10,4,3,0.5)] backdrop-blur-xl">
    <div class="flex flex-col items-center">
      <span class="bg-gradient-to-b from-[#ff5a5f] to-[#a20d12] bg-clip-text text-4xl leading-none font-black text-transparent">{average}</span>
      <span class="mt-1 text-[10px] font-bold tracking-widest text-[#f2dede]/70 uppercase">คะแนนเฉลี่ย</span>
    </div>
    <div class="h-12 w-px bg-[#a20d12]/60"></div>
    <div class="flex flex-col gap-1.5">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#f5c542]" : "text-[#a20d12]/60"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#f2dede]/70">คะแนนเฉลี่ย {average} จาก 5 ดาว จากการใช้งานจริงของสมาชิก {reviews.length} ด้าน</span>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
    {
      reviews.map((review) => (
        <article class="group relative isolate flex flex-col gap-4 overflow-hidden rounded-2xl border border-[#f5c542]/25 bg-[#170707]/92 p-6 text-left shadow-[0_10px_30px_rgba(10,4,3,0.5)] backdrop-blur-xl transition-all duration-300 hover:-translate-y-1 hover:border-[#f5c542]/55 hover:shadow-[0_15px_40px_rgba(224,30,38,0.30)]">
          <span class="absolute inset-y-0 left-0 -z-10 w-1 bg-gradient-to-b from-[#ff5a5f] to-[#a20d12] opacity-80 transition-opacity duration-300 group-hover:opacity-100" />
          <span class="pointer-events-none absolute -top-14 -right-14 -z-10 h-32 w-32 rounded-full bg-[#6e0709]/60 blur-[50px] transition-all duration-300 group-hover:bg-[#e01e26]/25" />

          <div class="flex items-center justify-between gap-3">
            <span class="inline-flex items-center gap-1.5 rounded-full border border-[#f5c542]/25 bg-[#0a0403] px-3 py-1 text-[10px] font-bold tracking-widest text-[#f5c542] uppercase">
              <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#e01e26]" />
              {review.tag}
            </span>
            <span class="flex gap-0.5 text-sm">
              <span aria-hidden="true" class="flex gap-0.5">
                {Array.from({ length: 5 }).map((_, i) => (
                  <span class={i < review.stars ? "text-[#f5c542]" : "text-[#a20d12]/60"}>★</span>
                ))}
              </span>
              <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
            </span>
          </div>

          <p class="text-left text-base leading-relaxed text-[#f2dede]">{review.content}</p>

          <div class="mt-auto flex items-center gap-3 border-t border-[#a20d12]/60 pt-4">
            <span
              aria-hidden="true"
              class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#f5c542]/30 bg-gradient-to-br from-[#ff5a5f] via-[#e01e26] to-[#6e0709] text-xl shadow-inner transition-transform duration-300 group-hover:scale-110">
              {review.avatar}
            </span>
            <span class="flex flex-col">
              <span class="text-sm font-black text-[#f2dede] transition-colors group-hover:text-[#ffdf8a]">{review.name}</span>
              <span class="text-[10px] font-bold tracking-wider text-[#f2dede]/70 uppercase">{review.role}</span>
            </span>
          </div>
        </article>
      ))
    }
  </div>
</section>
