---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h2" } = Astro.props;
---

<section class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#0e2150] bg-[#03091f] p-6 text-[#f5e7c2] shadow-[0_10px_30px_rgba(247,208,70,0.16)] transition-all duration-500 hover:border-[#f7d046]/55 md:p-10">
    <div
      aria-hidden="true"
      class="pointer-events-none absolute top-0 left-1/2 -z-10 h-[3px] w-1/2 -translate-x-1/2 bg-gradient-to-r from-transparent via-[#f7d046] to-transparent opacity-60 transition-opacity duration-500 group-hover:opacity-100">
    </div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#0e2150] pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#f7d046] to-[#ffd83a] shadow-[0_0_10px_rgba(247,208,70,0.45)]" />
          <HeadingTag class="bg-gradient-to-r from-[#ffe38a] via-[#f7d046] to-[#ffd83a] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-2 lg:gap-10">
      <article
        class="relative flex gap-4 rounded-2xl border border-[#0e2150] bg-[#071230] p-6 text-left text-base leading-relaxed text-[#f5e7c2] transition-all duration-300 hover:-translate-y-2 hover:border-[#f7d046]/55 hover:bg-[#0e2150] hover:shadow-[0_15px_40px_rgba(247,208,70,0.24)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#16305f] bg-gradient-to-br from-[#ffe38a] via-[#f7d046] to-[#c99a17] text-2xl shadow-[0_5px_15px_rgba(247,208,70,0.35)]">
          💥
        </div>
        <slot name="left" />
      </article>

      <article
        class="relative flex gap-4 rounded-2xl border border-[#0e2150] bg-[#071230] p-6 text-left text-base leading-relaxed text-[#f5e7c2] transition-all duration-300 hover:-translate-y-2 hover:border-[#ffd83a]/60 hover:bg-[#0e2150] hover:shadow-[0_15px_40px_rgba(255,216,58,0.22)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#b8890f] bg-gradient-to-br from-[#ffe89a] via-[#ffd83a] to-[#b8890f] text-2xl shadow-[0_5px_15px_rgba(255,216,58,0.30)]">
          🏦
        </div>
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
