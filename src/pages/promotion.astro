---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxPremium.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";

import { Picture } from "astro:assets";

import pro1 from "../assets/slide1.png";
import pro2 from "../assets/slide2.png";
import pro3 from "../assets/slide3.png";
import pro4 from "../assets/slide4.png";
import { pageGraph } from "../lib/schema";

const pageTitle = "โปรโมชั่น KOH888 รวมโบนัสสมาชิกใหม่ ฝากแรกของวัน และสิทธิ์วันเกิด";

const pageDescription =
  "รวมโปรโมชั่น KOH888 ทั้งโบนัสสมาชิกใหม่ ฝากแรกของวันรับเพิ่ม และสิทธิ์วันเกิด ดูภาพโปรแต่ละรายการแล้วอ่านเงื่อนไขการรับสิทธิ์จากหน้าโปรนั้นก่อนกดใช้งานทุกครั้ง";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: pro1.src,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="โปรโมชั่น KOH888 ทุกแคมเปญรวมไว้ที่เดียว" as="h1">
    <p class="mb-8 text-left text-base leading-relaxed text-[#e9dcf6]">
      หน้านี้รวมภาพโปรโมชั่นที่ <strong class="text-[#f5c542]">KOH888</strong> เปิดให้สมาชิกเลือกใช้ ทั้งสิทธิ์สมาชิกใหม่ โบนัสฝากแรกของวัน และสิทธิ์วันเกิด
      ทุกรายการผูกกับบัญชีเดียวกับที่ใช้เล่นสล็อต คาสิโน บาคาร่า บอล และหวย จึงกดรับและตรวจสถานะได้จากหน้าสมาชิกหน้าเดิม
      รายละเอียดของแต่ละโปรต่างกันทั้งยอดเริ่มต้น เกมที่ร่วมรายการ และเงื่อนไขรับสิทธิ์ จึงควรอ่านจากหน้าโปรนั้นก่อนกดใช้งานทุกครั้ง
    </p>

    <div class="grid w-full grid-cols-1 gap-6 sm:grid-cols-2">
      <Picture
        src={pro1}
        alt="ภาพโปรโมชั่น KOH888 สิทธิ์พิเศษวันเกิด รับเพิ่มสูงสุด 500 บาท พื้นหลังเป็นเมืองกลางคืนโทนม่วง มีพรีเซนเตอร์หญิงชุดม่วงถือบัตรทองยืนข้างกล่องของขวัญสีทองและกองเหรียญ พร้อมข้อความ เล่นผ่านเว็บหลัก ฝากถอนออโต้ และ รวดเร็ว ปลอดภัย มั่นใจ 100 เปอร์เซ็นต์ ปิดท้ายด้วยปุ่ม สมัครสมาชิก"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class="mx-auto h-auto w-full rounded-xl border border-[#8b36d9]/45 object-contain shadow-[0_10px_30px_rgba(139,54,217,0.22)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#f5c542]/60 hover:shadow-[0_15px_40px_rgba(245,197,66,0.28)]"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />

      <Picture
        src={pro2}
        alt="ภาพโปรโมชั่น KOH888 หวยออนไลน์ เล่นง่าย วางโพยไว ผ่านมือถือ มีแถบไอคอนหมวด สล็อต คาสิโน หวย และกีฬา พร้อมปุ่มข้อความ ระบบออโต้ ทำรายการไว แม่นยำ และ สมัครง่าย ไม่ยุ่งยาก ใช้แค่เบอร์ ด้านข้างเป็นลูกหวยและใบหวยรัฐบาล"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class="mx-auto h-auto w-full rounded-xl border border-[#8b36d9]/45 object-contain shadow-[0_10px_30px_rgba(139,54,217,0.22)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#f5c542]/60 hover:shadow-[0_15px_40px_rgba(245,197,66,0.28)]"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />

      <Picture
        src={pro3}
        alt="ภาพโปรโมชั่น KOH888 ฝากแรกของวัน รับโบนัส 50 เปอร์เซ็นต์ พื้นหลังโทนม่วงทอง มีวงล้อรูเล็ตสองวงและชิปคาสิโนวางเรียง ป้ายมุมซ้ายเขียน สมัครง่าย ฝากถอนออโต้ ส่วนบรรทัดล่างเขียน สล็อต คาสิโน หวย กีฬา ครบในบัญชีเดียว"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class="mx-auto h-auto w-full rounded-xl border border-[#8b36d9]/45 object-contain shadow-[0_10px_30px_rgba(139,54,217,0.22)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#f5c542]/60 hover:shadow-[0_15px_40px_rgba(245,197,66,0.28)]"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />

      <Picture
        src={pro4}
        alt="ภาพโปรโมชั่น KOH888 สมาชิกใหม่ เริ่มง่าย ผ่านเว็บตรง ฝากเริ่มต้น 50 บาท มีแถบไอคอนหมวด สล็อต คาสิโน หวย และฟุตบอล พร้อมป้ายข้อความ ระบบออโต้ และ เล่นบนมือถือได้ ด้านขวาเป็นพรีเซนเตอร์หญิงชุดชมพูยืนคู่กับเหรียญทอง"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class="mx-auto h-auto w-full rounded-xl border border-[#8b36d9]/45 object-contain shadow-[0_10px_30px_rgba(139,54,217,0.22)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#f5c542]/60 hover:shadow-[0_15px_40px_rgba(245,197,66,0.28)]"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />
    </div>

    <div class="mt-12 flex justify-center pb-4">
      <a
        href="/register"
        class="flex items-center justify-center rounded-lg border border-[#f5c542]/60 bg-gradient-to-r from-[#ffe9a3] via-[#f5c542] to-[#a9761a] px-10 py-3.5 text-lg font-black text-[#0c0416] shadow-[0_10px_30px_rgba(245,197,66,0.24)] transition-transform hover:scale-105 hover:shadow-[0_15px_40px_rgba(245,197,66,0.38)]">
        สมัครสมาชิก KOH888
      </a>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
