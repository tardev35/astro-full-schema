---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#d6e2f7] bg-white p-8 text-left text-base leading-relaxed text-[#1f2a44] shadow-[0_10px_30px_rgba(10,31,92,0.08)] transition-all duration-500 hover:border-[#9dbcf0] hover:shadow-[0_15px_40px_rgba(26,95,224,0.16)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute top-0 left-0 -z-10 h-1.5 w-full bg-gradient-to-r from-[#1a5fe0] via-[#4d8ff5] to-[#e0a91b]"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#4d8ff5]/10 blur-[60px] transition-all duration-500 group-hover:bg-[#e0a91b]/15"></div>

    {
      title && (
        <header class="mb-6 flex items-center gap-4 border-b border-[#d6e2f7] pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#1a5fe0] to-[#e0a91b]" />
          <HeadingTag class="text-2xl leading-normal font-black tracking-wide text-[#0a1f5c]">{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
