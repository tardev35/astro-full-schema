---
export interface FAQ {
  q: string;
  a: string;
}
export interface Props {
  title?: string;
  faqs?: FAQ[];
}

const {
  title = "คำถามที่พบบ่อย (FAQ)",
  faqs = [
    {
      q: "อัตราจ่ายของหวยแต่ละตลาดดูได้ที่ไหน",
      a: "อัตราจ่ายของทุกประเภทการแทงจะแสดงอยู่ในหน้าของแต่ละตลาดหวย และระบบจะแสดงอัตราจ่ายจริงอีกครั้งบนหน้ายืนยันโพยก่อนกดส่งเสมอ",
    },
    { q: "แทงหวยขั้นต่ำกี่บาท", a: "ระบบรองรับการส่งโพยตั้งแต่จำนวนเงินขั้นต่ำที่กำหนดไว้ในแต่ละตลาด สมาชิกสามารถตรวจสอบจำนวนเงินขั้นต่ำและสูงสุดได้จากหน้ารายละเอียดของตลาดนั้นก่อนส่งโพย" },
    {
      q: "มีเลขอั้นหรือเลขเต็มหรือไม่",
      a: "มีตามรอบที่ยอดแทงเข้ามามาก เลขอั้นจะถูกปรับลดอัตราจ่ายลง ส่วนเลขเต็มจะปิดรับในรอบนั้น ทั้งสองรายการแสดงอยู่ในหน้าตลาดหวยและระบบจะแจ้งให้ทราบก่อนยืนยันโพย",
    },
  ],
} = Astro.props;
---

<section class="mx-auto mb-12 w-full max-w-4xl px-4 font-sans">
  <div class="mb-6 text-center">
    <h2 class="bg-gradient-to-r from-[#ffe08a] via-[#f5c542] to-[#d99e1f] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase drop-shadow-sm">{title}</h2>
  </div>

  <div class="flex flex-col gap-3">
    {
      faqs.map((faq) => (
        <details
          name="faq-huay"
          class="faq-item group overflow-hidden rounded-xl border border-[#f5c542]/30 bg-[#2a0505]/88 backdrop-blur-md transition-all duration-300 hover:border-[#f5c542]/65 hover:shadow-[0_10px_25px_rgba(245,197,66,0.16)]">
          <summary class="flex w-full cursor-pointer items-center justify-between gap-4 p-5 text-left">
            <h3 class="text-base leading-normal font-bold text-[#f7e4d4] transition-colors group-hover:text-[#ffe08a]">{faq.q}</h3>
            <span
              aria-hidden="true"
              class="faq-icon flex h-6 w-6 shrink-0 items-center justify-center rounded-md border border-[#f5c542]/45 bg-[#3a0808] text-sm font-bold text-[#ffe08a] transition-all duration-300 group-hover:bg-[#f5c542] group-hover:text-[#1f0303]">
              +
            </span>
          </summary>
          <p class="faq-answer border-t border-[#f5c542]/20 bg-[#1f0303]/75 p-5 text-left text-base leading-relaxed text-[#f7e4d4]/90">{faq.a}</p>
        </details>
      ))
    }
  </div>
</section>

<style>
  .faq-item > summary {
    list-style: none;
  }
  .faq-item > summary::-webkit-details-marker {
    display: none;
  }
  .faq-item[open] {
    border-color: rgba(245, 197, 66, 0.6);
  }
  .faq-item[open] .faq-icon {
    transform: rotate(45deg);
    background-color: #f5c542;
    color: #1f0303;
  }
  .faq-item[open] .faq-answer {
    animation: faq-reveal 0.25s ease-out;
  }

  @keyframes faq-reveal {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-item[open] .faq-answer {
      animation: none;
    }
  }
</style>
