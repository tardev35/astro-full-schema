---
import { Image } from "astro:assets";
import Bg from "../assets/bg.webp";
import "../styles/global.css";
import NavbarStyle6 from "../components/NavbarCyber.astro";
import Footer from "../components/FooterCyber.astro";

const bannerImages = import.meta.glob<{ default: ImageMetadata }>("../assets/banner*.{png,webp,jpg,jpeg}", { eager: true });
const bannerPaths = Object.keys(bannerImages);
const mainBanner = bannerPaths.length > 0 ? bannerImages[bannerPaths[0]].default : null;

const {
  title = "MARANGS777 เว็บตรง API แท้ มีครบเกมสล็อตออนไลน์ ทางเข้าหลัก",
  description = "ทางเข้าหลัก MARANGS777 เว็บตรง API แท้ จากเซิร์ฟเวอร์จริง ไม่เสี่ยงโดนโกง จ่ายจริงไม่ล็อคยูส ฝากถอนออโต้ ทำงานเอง ไม่ผ่านแอดมิน สมัครที่นี่ปลอดภัย 100%",
  robots = "index, follow",
  ImageOg = "/pro3.webp",
} = Astro.props;

const currentPath = Astro.url.pathname;
const canonicalURL = new URL(currentPath, Astro.site);
const ogImageURL = new URL(ImageOg, Astro.site);
const ogSiteName = "MARANGS777";
---

<html lang="th">
  <head>
    <meta charset="utf-8" />
    <meta name="google-site-verification" content="QBlyU6ykSCvx9r-jtnRYJi9MVvsZ5XDmBdz5nNvYoRg" />
    <meta name="robots" content={robots} />
    <meta name="googlebot" content={robots} />
    <title>{title}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="preload" href="/fonts/kanit-v17-latin_thai-regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/kanit-v17-latin_thai-700.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/kanit-v17-latin_thai-600.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:site_name" content={ogSiteName} />
    <meta property="og:locale" content="th_TH" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <style is:global>
      body {
        background-size: cover;
        background-position: center;
        background-attachment: fixed;
        background-repeat: no-repeat;
        margin: 0;
        background-color: #ffffff;
        font-weight: 400;
        font-family: "Kanit", sans-serif !important;
        /* color: white; */
      }
    </style>
  </head>

  <body class="relative flex min-h-screen w-full flex-col">
    <Image
      src={Bg}
      alt="Website Background"
      loading="eager"
      widths={[412, 768, 1024, 1900]}
      sizes="100vw"
      format="avif"
      class="fixed inset-0 -z-50 h-full w-full object-cover"
      quality="low"
      decoding="sync"
    />

    <NavbarStyle6 />

    <div class="mb-2.5 flex w-full items-center justify-center">
      <Image
        src={mainBanner!}
        alt="WAIVER388 banner"
        loading="eager"
        fetchpriority="high"
        widths={[412, 768, 1900]}
        sizes="(max-width: 768px) 412px, 100vw"
        class="mx-auto h-auto w-full max-w-full object-contain shadow-xl"
        decoding="sync"
        format="avif"
        quality={60}
      />
    </div>

    <main class="w-full flex-1">
      <slot />
    </main>

    <Footer />
  </body>
</html>
