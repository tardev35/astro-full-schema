---
import { Picture } from "astro:assets";
import BankStrip from "./BankStrip.astro";
import { BRAND_ADDRESS } from "../lib/brandProfile";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });
const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;
---

<footer class="relative mt-16 w-full overflow-hidden rounded-t-[3rem] border-t border-[#f5c542]/60 bg-[#1a0303] pt-16 pb-8 font-sans text-[#f7e4d4] shadow-[0_-15px_40px_rgba(245,197,66,0.22)]">
  <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 -top-20 mx-auto h-[250px] w-full max-w-4xl rounded-full bg-[#f5c542]/18 blur-[100px]"></div>
  <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 -bottom-24 mx-auto h-[220px] w-full max-w-2xl rounded-full bg-[#d92121]/30 blur-[100px]"></div>

  <div class="relative z-10 mx-auto w-full max-w-[1200px] px-6">
    <div class="mb-12 grid grid-cols-1 gap-12 md:grid-cols-12">
      <div class="flex flex-col gap-5 md:col-span-5">
        <a href="/" class="inline-block max-w-max rounded-xl border border-[#f5c542]/30 bg-[#2a0505] px-4 py-2 transition-transform duration-300 hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt="โลโก้ PIGAUTO หัวหมูการ์ตูนสีชมพูยิ้มอยู่กลางเฟืองจักรโลหะสีเทาเงิน มีปีกโลหะกางออกสองข้าง ด้านล่างเป็นตัวอักษรสีขาวขอบเข้มว่า PIGAUTO"
                widths={[160, 320, 480]}
                sizes="160px"
                loading="lazy"
                decoding="async"
                class="h-[50px] w-auto object-contain"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <span class="text-3xl font-black tracking-widest text-[#f7e4d4]">
                PIG<span class="text-[#f5c542]">AUTO</span>
              </span>
            )
          }
        </a>
        <p class="border-l-2 border-[#f5c542]/50 pl-4 text-sm leading-relaxed text-[#d7b9a4]">
          PIGAUTO สล็อตหมูเว็บตรง เชื่อมต่อเกมลิขสิทธิ์ผ่าน API แท้จากค่ายผู้พัฒนาโดยตรง รวมสล็อตและยิงปลาไว้ในบัญชีเดียว ฝากถอนออโต้ภายใน 3 วินาที ไม่ต้องส่งสลิป
          รองรับทั้งบัญชีธนาคารและทรูมันนี่วอเลท ไม่มีขั้นต่ำ พร้อมทีมงานดูแลตลอด 24 ชั่วโมง
        </p>
        <div class="mt-4 flex flex-wrap gap-3">
          <span class="rounded-full border border-[#f5c542]/30 bg-[#2a0505] px-4 py-1 text-xs font-medium text-[#f5c542]">สล็อตหมูเว็บตรง API แท้</span>
          <span class="rounded-full border border-[#d92121]/45 bg-[#3a0808] px-4 py-1 text-xs font-medium text-[#f9a8c0]">ออโต้ 3 วิ ไม่มีขั้นต่ำ</span>
        </div>
      </div>

      <nav class="flex flex-col gap-4 md:col-span-3 lg:pl-8">
        <p class="text-lg font-black tracking-widest text-[#f7e4d4] uppercase drop-shadow-sm">ทางลัด</p>
        <div aria-hidden="true" class="h-[1px] w-12 bg-[#f5c542]"></div>
        <ul class="flex flex-col gap-3 text-sm font-medium text-[#d7b9a4]">
          <li><a href="/" class="transition-colors hover:text-[#f5c542]">หน้าหลัก</a></li>
          <li><a href="/promotion/" class="transition-colors hover:text-[#f5c542]">โปรโมชั่น</a></li>
          <li><a href="/register/" class="transition-colors hover:text-[#f5c542]">สมัครสมาชิก</a></li>
          <li><a href="/login/" class="transition-colors hover:text-[#f5c542]">เข้าสู่ระบบ</a></li>
          <li><a href="/ทดลองเล่น/" class="transition-colors hover:text-[#f5c542]">ทดลองเล่น</a></li>
          <li><a href="/ทางเข้า/" class="transition-colors hover:text-[#f5c542]">ทางเข้า</a></li>
          <li><a href="/about-us/" class="transition-colors hover:text-[#f5c542]">เกี่ยวกับเรา</a></li>
          <li><a href="/contact-us/" class="transition-colors hover:text-[#f5c542]">ติดต่อเรา</a></li>
        </ul>
      </nav>

      <div class="flex flex-col gap-5 md:col-span-4">
        <p class="text-lg font-black tracking-widest text-[#f7e4d4] uppercase drop-shadow-sm">บริการลูกค้า 24 ชม.</p>
        <div aria-hidden="true" class="h-[1px] w-12 bg-[#f5c542]"></div>

        <a
          href="/line/"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] py-3.5 font-bold text-white shadow-[0_5px_15px_rgba(0,185,0,0.3)] transition-all hover:-translate-y-1 hover:shadow-[0_8px_20px_rgba(0,185,0,0.4)]">
          ติดต่อแอดมิน LINE
        </a>

        {
          BRAND_ADDRESS.lines.length > 0 && (
            <address aria-label={BRAND_ADDRESS.label} class="mt-2 rounded-xl border border-white/15 bg-black/20 p-4 text-xs leading-relaxed not-italic opacity-90">
              <p class="mb-2 flex items-center gap-2 text-[11px] font-bold tracking-wider uppercase opacity-80">
                <span aria-hidden="true" class="text-sm">
                  📍
                </span>
                {BRAND_ADDRESS.label}
              </p>
              {BRAND_ADDRESS.lines.map((line) => (
                <span class="block">{line}</span>
              ))}
              {BRAND_ADDRESS.email && (
                <a href={`mailto:${BRAND_ADDRESS.email}`} class="mt-3 inline-flex items-center gap-2 font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                  <span aria-hidden="true" class="text-sm">
                    ✉️
                  </span>
                  {BRAND_ADDRESS.email}
                </a>
              )}
            </address>
          )
        }

        <div class="mt-4 text-xs font-medium tracking-widest text-[#d7b9a4] uppercase">Supported Payments</div>
        <BankStrip size={30} />
      </div>
    </div>

    <div class="flex flex-col items-center justify-between border-t border-[#b07d12]/60 pt-8 text-xs font-medium tracking-wide text-[#d7b9a4] md:flex-row">
      <p>COPYRIGHT &copy; {new Date().getFullYear()} PIGAUTO-MAIN.NET. ALL RIGHTS RESERVED.</p>
      <div class="mt-4 flex gap-4 md:mt-0">
        <a href="/terms/" class="transition-colors hover:text-[#f5c542]">เงื่อนไขข้อตกลง</a>
        <a href="/privacy/" class="transition-colors hover:text-[#f5c542]">นโยบายความเป็นส่วนตัว</a>
      </div>
    </div>
  </div>
</footer>

<style>
  footer a {
    text-decoration: none;
    font-family: var(--font-sans);
  }
  footer {
    font-family: var(--font-sans);
  }
</style>
