---
import kbankLogo from "../assets/banks/kbank.png";
import scbLogo from "../assets/banks/scb.png";
import krungsriLogo from "../assets/banks/krungsri.png";
import ktbLogo from "../assets/banks/ktb.png";

const bankPool = [
  { name: "KBank", color: "bg-[#1155cc]", icon: kbankLogo.src },
  { name: "SCB", color: "bg-[#4e1c80]", icon: scbLogo.src },
  { name: "Krungsri", color: "bg-[#fcd34d]", icon: krungsriLogo.src },
  { name: "KTB", color: "bg-[#0ea5e9]", icon: ktbLogo.src },
];
---

<div class="mx-auto w-full max-w-[1300px] p-4 font-sans">
  <div class="relative overflow-hidden border-x-4 border-y border-red-700 bg-[#050000] px-4 py-8 shadow-[0_0_30px_rgba(185,28,28,0.2)] md:p-10">
    <div class="relative z-10 mb-8 flex items-center justify-center gap-3">
      <span class="text-2xl drop-shadow-[0_0_8px_rgba(185,28,28,0.8)]">💀</span>
      <h2 class="bg-gradient-to-r from-[#ffffff] to-[#b91c1c] bg-clip-text text-xl font-black tracking-widest text-transparent uppercase drop-shadow-[0_0_10px_rgba(185,28,28,0.5)] md:text-3xl">
        LIVE PAYOUTS
      </h2>
      <span class="text-2xl drop-shadow-[0_0_8px_rgba(185,28,28,0.8)]">💀</span>
    </div>
    <div id="feed-cyber" class="relative z-10 flex flex-col gap-2"></div>
  </div>
</div>

<script define:vars={{ bankPool }}>
  const feed = document.getElementById("feed-cyber");
  const getRandomStr = (len, chars) =>
    Array.from({ length: len })
      .map(() => chars.charAt(Math.floor(Math.random() * chars.length)))
      .join("");
  const getAmount = () => (Math.floor(Math.random() * (95000 - 15000 + 1)) + 15000).toLocaleString("en-US");
  const getNowTime = () => {
    const d = new Date();
    return `${d.getHours().toString().padStart(2, "0")}:${d.getMinutes().toString().padStart(2, "0")}:${d.getSeconds().toString().padStart(2, "0")}`;
  };

  const createHTML = () => {
    const bank = bankPool[Math.floor(Math.random() * bankPool.length)];
    const user = `${getRandomStr(2, "abcdefghijklmnopqrstuvwxyz")}***${getRandomStr(4, "0123456789")}`;
    const isPending = Math.random() > 0.6;

    // 🌟 ธีมแดง: Pending สีเทาดำ, Success สีแดงเรืองแสง
    const statusClass = isPending ? "border-gray-600 text-gray-400 bg-gray-900 animate-pulse" : "border-red-600 text-red-500 bg-red-950";
    const statusText = isPending ? "PROCESSING" : "TRANSFER_OK";

    return `
      <div class="winner-row grid grid-rows-[0fr] opacity-0 transition-all duration-500 ease-in-out -translate-x-10">
        <div class="overflow-hidden">
          <div class="mb-2 flex items-center justify-between border-l-4 border-r border-y border-[#1a0505] border-l-red-600 bg-black/80 p-4 transition-colors hover:bg-[#0a0000]">
            <div class="flex items-center gap-4">
              <div class="flex h-10 w-10 shrink-0 items-center justify-center overflow-hidden rounded-sm ${bank.color} grayscale-[30%]">
                <img src="${bank.icon}" alt="bank" class="h-6 w-6 object-contain" />
              </div>
              <div class="flex flex-col justify-center">
                <div class="text-sm font-bold text-white md:text-base">USR: <span class="tracking-widest text-red-300">${user}</span></div>
                <div class="mt-0.5 text-[10px] text-gray-500 md:text-xs">ID_${getRandomStr(8, "0123456789")} // ${getNowTime()}</div>
              </div>
            </div>
            <div class="flex flex-col items-end justify-center gap-1.5">
              <div class="text-xl font-black text-white md:text-2xl drop-shadow-[2px_2px_0_rgba(185,28,28,0.8)]">
                ${getAmount()} <span class="text-[10px] text-red-500">THB</span>
              </div>
              <div class="border px-2 py-0.5 text-[9px] font-bold tracking-widest ${statusClass}">${statusText}</div>
            </div>
          </div>
        </div>
      </div>
    `;
  };

  const trigger = () => {
    const tempDiv = document.createElement("div");
    tempDiv.innerHTML = createHTML();
    const newEl = tempDiv.firstElementChild;
    feed.prepend(newEl);
    newEl.getBoundingClientRect();
    newEl.classList.remove("grid-rows-[0fr]", "opacity-0", "-translate-x-10");
    newEl.classList.add("grid-rows-[1fr]", "opacity-100", "translate-x-0");
    if (feed.children.length > 4) {
      const last = feed.lastElementChild;
      last.classList.remove("grid-rows-[1fr]", "opacity-100", "translate-x-0");
      last.classList.add("grid-rows-[0fr]", "opacity-0", "translate-x-10");
      setTimeout(() => last.remove(), 500);
    }
  };
  for (let i = 0; i < 4; i++) {
    const t = document.createElement("div");
    t.innerHTML = createHTML();
    const e = t.firstElementChild;
    e.classList.remove("grid-rows-[0fr]", "opacity-0", "-translate-x-10");
    e.classList.add("grid-rows-[1fr]", "opacity-100", "translate-x-0");
    feed.appendChild(e);
  }
  setInterval(trigger, 5000);
</script>
<style>
  .font-sans {
    font-family: "Kanit", sans-serif;
  }
</style>
