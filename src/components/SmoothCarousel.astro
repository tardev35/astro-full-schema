---
import { Picture } from "astro:assets";

import slide1 from "../assets/slide1.png";
import slide2 from "../assets/slide2.png";
import slide3 from "../assets/slide3.png";
import slide4 from "../assets/slide4.png";

const images = [
  {
    src: slide1,
    alt: "ภาพโปรโมชั่นพื้นดำ-ทอง ตราวงกลม SUPERCLUB168 ด้านบน หัวข้อ COMMISSION คืนทุกยอดเล่นตลอดทั้งวัน 0.3% ระบุเล่นถึง 50% ถอนได้เลย กดรับง่ายๆ ที่หน้าเว็บได้เลย รับสิทธิ์ก่อน 23.59 น. ของทุกวัน ปิดท้ายด้วยข้อความ ยิ่งเล่นเยอะ ยิ่งได้เยอะ ด้านซ้ายเป็นพรีเซนเตอร์หญิงสวมชุดเลื่อมสีทอง",
  },
  {
    src: slide2,
    alt: "ภาพโปรโมชั่นพื้นดำ-ทอง ตราวงกลม SUPERCLUB168 ด้านบน ข้อความ แนะนำเพื่อน รับโบนัส 0.8% และ สร้างรายได้ 100,000/เดือน ด้านขวาเป็นพรีเซนเตอร์หญิงสวมชุดเลื่อมสีทอง มีเหรียญทองกระจายรอบภาพ",
  },
  {
    src: slide3,
    alt: "ภาพโปรโมชั่นพื้นดำ-ทอง ตราวงกลม SUPERCLUB168 มุมขวาบน ปุ่มเรียงด้านซ้ายระบุ หวย บอล บาคาร่า สล็อต ข้อความใหญ่ ครบจบในที่เดียว และแถบรายการด้านล่าง บอล คาสิโน สล็อต ยิงปลา ไก่ชน มวย ไฮโล รูเล็ต ตรงกลางเป็นพรีเซนเตอร์หญิงสวมชุดเลื่อมสีทอง",
  },
  {
    src: slide4,
    alt: "ภาพโปรโมชั่นหวยพื้นดำ-ทอง ตราวงกลม SUPERCLUB168 มุมซ้ายบน หัวข้อ หวย อัตราจ่ายที่ดีที่สุด ระบุ 3 ตัวบาทละ 1000 และ 2 ตัวบาทละ 100 พร้อมข้อความ ถูกตรง จ่ายจริง รับเงินรางวัลหลักล้าน ครบจบเรื่องหวยในเว็บเดียว รัฐบาล ลาว ฮานอย หุ้น ยี่กี่ ด้านขวาเป็นพรีเซนเตอร์หญิงสวมชุดเลื่อมสีทอง",
  },
];

const COPIES = 3;
const slides = Array.from({ length: COPIES }, () => images).flat();
---

<div class="marquee mx-auto w-full max-w-7xl overflow-hidden px-4 py-5">
  <input id="carousel-pause" type="checkbox" class="peer sr-only" />
  <label
    for="carousel-pause"
    class="sr-only cursor-pointer peer-focus-visible:not-sr-only peer-focus-visible:mb-3 peer-focus-visible:inline-block peer-focus-visible:rounded-full peer-focus-visible:border peer-focus-visible:border-[#f7d046]/55 peer-focus-visible:bg-[#03091f] peer-focus-visible:px-4 peer-focus-visible:py-2 peer-focus-visible:text-sm peer-focus-visible:font-bold peer-focus-visible:text-[#ffe38a]">
    หยุด / เล่นสไลด์ภาพ
  </label>

  <div class="marquee-track flex">
    {
      slides.map((slide, index) => {
        const isDuplicate = index >= images.length;
        return (
          <div class="marquee-slide" aria-hidden={isDuplicate ? "true" : undefined}>
            <Picture
              src={slide.src}
              alt={isDuplicate ? "" : slide.alt}
              class="block w-full rounded-xl border border-[#0e2150] object-cover shadow-[0_10px_30px_rgba(247,208,70,0.20)]"
              width={slide.src.width}
              height={slide.src.height}
              loading="lazy"
              fetchpriority="low"
              decoding="async"
              widths={[300, 360, 420, 480, 540, 600]}
              sizes="(max-width: 767px) calc(100vw - 32px), (max-width: 1279px) calc((100vw - 48px) / 2), 403px"
              formats={["avif", "webp"]}
              fallbackFormat="webp"
              quality={60}
            />
          </div>
        );
      })
    }
  </div>
</div>

<style>
  .marquee {
    --gap: 12px;
    --per-view: 1;
    --shift: calc(-400% - 48px);
  }

  @media (min-width: 768px) {
    .marquee {
      --gap: 16px;
      --per-view: 2;
      --shift: calc(-200% - 32px);
    }
  }

  @media (min-width: 1280px) {
    .marquee {
      --gap: 20px;
      --per-view: 3;
      --shift: calc(-133.3333% - 26.6667px);
    }
  }

  .marquee-track {
    gap: var(--gap);
    width: 100%;
    animation: carousel-scroll 40s linear infinite;
    will-change: transform;
  }

  .marquee-slide {
    flex: 0 0 calc((100% - (var(--per-view) - 1) * var(--gap)) / var(--per-view));
  }

  @keyframes carousel-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(var(--shift));
    }
  }

  .marquee:hover .marquee-track,
  .marquee:focus-within .marquee-track,
  .marquee > input:checked ~ .marquee-track {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
    }
  }
</style>
