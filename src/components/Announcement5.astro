---
const { message = "👑 KONG24H เว็บใหญ่อันดับ 1 ในไทย คาสิโน สล็อต บาคาร่า ฝาก-ถอน AUTO 24 ชั่วโมง บริการระดับ VIP" } = Astro.props;
---

<div class="mx-auto w-full max-w-7xl px-4 py-3 font-sans">
  <div class="relative overflow-hidden rounded-md border border-yellow-600/40 bg-[#1a0202] shadow-[0_0_15px_rgba(234,179,8,0.15)]">
    <div class="absolute top-0 -left-4 h-full w-8 -skew-x-12 bg-gradient-to-b from-yellow-400 to-yellow-600"></div>
    <div class="absolute top-0 -right-4 h-full w-8 -skew-x-12 bg-yellow-900/40"></div>

    <div class="flex items-center">
      <div class="relative z-10 flex w-12 shrink-0 items-center justify-center bg-gradient-to-b from-yellow-400 to-yellow-600 py-2.5">
        <span class="animate-pulse text-lg drop-shadow-[0_0_5px_rgba(255,255,255,0.8)]">📢</span>
      </div>

      <div class="marquee-container relative flex-1 overflow-hidden py-2.5 pr-6">
        <div class="pointer-events-none absolute top-0 left-0 z-10 h-full w-8 bg-gradient-to-r from-[#1a0202] to-transparent"></div>
        <div class="pointer-events-none absolute top-0 right-0 z-10 h-full w-12 bg-gradient-to-l from-[#1a0202] to-transparent"></div>

        <div class="marquee-content inline-block pl-4 text-sm font-bold tracking-wide whitespace-nowrap text-yellow-400">
          <span class="mr-8 inline-flex items-center gap-2"><span class="h-1.5 w-1.5 rounded-full bg-yellow-400 shadow-[0_0_5px_rgba(234,179,8,0.8)]"></span>{message}</span>
          <span class="mr-8 inline-flex items-center gap-2"><span class="h-1.5 w-1.5 rounded-full bg-yellow-400 shadow-[0_0_5px_rgba(234,179,8,0.8)]"></span>{message}</span>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .font-sans {
    font-family: "Kanit", sans-serif;
  }
  .marquee-content {
    animation: marquee 25s linear infinite;
  }
  .marquee-container:hover .marquee-content {
    animation-play-state: paused;
  }
  @keyframes marquee {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }
</style>
