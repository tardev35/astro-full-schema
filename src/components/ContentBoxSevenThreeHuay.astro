---
const { titleleft, titleright } = Astro.props;
---

<section class="mx-auto mb-10 w-full max-w-7xl px-4 font-sans">
  <div class="rounded-2xl border border-gray-200 bg-white p-8 shadow-sm md:p-10">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-2">
        {titleleft && <h2 class="text-center text-2xl font-black tracking-wider text-[#0a1128] uppercase md:text-left">{titleleft}</h2>}
        <div class="text-center text-sm font-bold text-[#007bff] md:text-left">
          <slot name="left" />
        </div>
      </article>

      <article class="flex flex-col gap-3 md:border-l md:border-gray-200 md:pl-8">
        {
          titleright && (
            <h3 class="flex items-center gap-2 text-lg font-bold text-[#0a1128]">
              <span class="text-[#ffd60a]">⚡</span> {titleright}
            </h3>
          )
        }
        <div class="text-base leading-relaxed text-gray-600">
          <slot name="right" />
        </div>
      </article>
    </div>
  </div>
</section>
<style>
  .font-sans {
    font-family: "Kanit", sans-serif;
  }
</style>
