---
import { Picture } from "astro:assets";
import img1 from "../assets/providers/game1.avif";
import img2 from "../assets/providers/game2.avif";
import img3 from "../assets/providers/game3.avif";
import img4 from "../assets/providers/game4.avif";
import img5 from "../assets/providers/game5.avif";
import img6 from "../assets/providers/game6.avif";

const providers = [
  { alt: "ON Gaming", users: "2,486", isHot: true, img: img1 },
  { alt: "Big Gaming", users: "1,892", isHot: true, img: img2 },
  { alt: "WM Casino", users: "3,102", isHot: true, img: img3 },
  { alt: "Evolution", users: "2,301", isHot: true, img: img4 },
  { alt: "SA Gaming", users: "1,954", isHot: true, img: img5 },
  { alt: "Sexy Baccarat", users: "1,245", isHot: true, img: img6 },
];
---

<div class="mx-auto w-full max-w-[1300px] px-4 py-5 font-sans sm:px-6 lg:px-8">
  <div
    class="mb-8 inline-flex w-full max-w-[1250px] items-center gap-3 border-l-4 border-purple-500 bg-gradient-to-r from-purple-900/50 via-purple-900/10 to-transparent py-2.5 pr-12 pl-4"
    style="clip-path: polygon(0 0, 100% 0, calc(100% - 15px) 100%, 0 100%);">
    <span class="text-xl drop-shadow-[0_0_8px_rgba(157,78,221,0.8)]">🎮</span>
    <h2 class="text-xl font-black tracking-widest text-purple-300 uppercase drop-shadow-[0_0_8px_rgba(157,78,221,0.5)] md:text-2xl">/// เกมยอดนิยม</h2>
  </div>

  <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-6 lg:gap-4">
    {
      providers.map((p) => (
        <div
          class="group relative flex cursor-pointer overflow-hidden bg-[#10002b] transition-all duration-300 hover:-translate-y-2 hover:shadow-[0_10px_25px_rgba(157,78,221,0.4)]"
          style="clip-path: polygon(10px 0, 100% 0, 100% calc(100% - 10px), calc(100% - 10px) 100%, 0 100%, 0 10px);">
          <div class="pointer-events-none absolute inset-0 z-20 border-2 border-purple-500/20 transition-all duration-300 group-hover:border-purple-400 group-hover:shadow-[inset_0_0_15px_rgba(157,78,221,0.5)]" />

          <div
            class="absolute top-0 left-0 z-10 flex items-center gap-1 border-r border-b border-purple-500/50 bg-purple-900/90 px-2 py-1 font-mono text-[10px] font-bold text-yellow-400 shadow-sm backdrop-blur-sm"
            style="clip-path: polygon(0 0, 100% 0, calc(100% - 5px) 100%, 0 100%);">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 text-purple-300" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z" clip-rule="evenodd" />
            </svg>
            {p.users}
          </div>

          {p.isHot && (
            <div
              class="absolute top-0 right-0 z-10 flex items-center gap-1 border-b border-l border-yellow-500 bg-yellow-400 px-2 py-1 text-[10px] font-black tracking-wide text-black shadow-md"
              style="clip-path: polygon(0 0, 100% 0, 100% 100%, 5px 100%);">
              <span class="animate-pulse text-red-600">🔥</span> HOT
            </div>
          )}

          <Picture
            src={p.img}
            alt={p.alt}
            formats={["avif", "webp"]}
            fallbackFormat="webp"
            loading="lazy"
            fetchpriority="low"
            widths={[200, 400, 600]}
            decoding="async"
            class="block h-full w-full object-cover opacity-80 grayscale-[30%] transition-transform duration-500 group-hover:scale-110 group-hover:opacity-100 group-hover:grayscale-0"
          />

          <div class="pointer-events-none absolute inset-0 z-10 bg-purple-600 opacity-0 mix-blend-overlay transition-opacity duration-300 group-hover:opacity-40" />
        </div>
      ))
    }
  </div>
</div>
<style>
  .font-sans {
    font-family: "Kanit", sans-serif;
  }
  .font-mono {
    font-family: monospace;
  }
</style>
