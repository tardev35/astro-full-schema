---
const reviews = [
  {
    name: "สมาชิกที่จัดโพยหลายตลาดในบัญชีเดียว",
    role: "รวมหวยไทย หวยลาว โพย และเครดิตไว้ที่เดียว",
    stars: 5,
    tag: "ระบบสมาชิกบัญชีเดียว",
    content:
      "ที่ถูกใจคือไม่ต้องแยกโพยไปหลายที่ครับ เข้าสู่ระบบครั้งเดียวแล้วเลือกตลาด จัดเลข เช็กเครดิต หรือย้อนดูประวัติรายการได้จากจุดเดียว งวดไหนแทงไว้กี่ชุดก็ตามได้หมด ไม่ต้องมานั่งนึกว่าจดกระดาษไว้ตรงไหน",
    avatar: "🎫",
  },
  {
    name: "สมาชิกที่ตามหวยลาวเป็นรอบ",
    role: "เลือกรอบตามช่วงที่เปิดรับแล้วกลับมาตรวจผล",
    stars: 5,
    tag: "ตรวจผลรายรอบ",
    content:
      "ชอบตรงที่แยกตลาดกับรอบไว้ชัดค่ะ ดูได้ว่ารอบไหนยังเปิดรับอยู่ก่อนกดยืนยันโพย พอประกาศผลก็กลับมาเทียบกับเลขที่แทงไว้จากบัญชีเดิมได้เลย จบเป็นรอบ ๆ ไม่ต้องเปิดหลายแท็บให้สับสน",
    avatar: "📅",
  },
  {
    name: "สมาชิกที่เลือกเลขผ่านมือถือเป็นหลัก",
    role: "จัดโพยและจัดการเครดิตจากหน้าบัญชี",
    stars: 5,
    tag: "ใช้งานผ่านมือถือ",
    content:
      "ผมเลือกเลขจากมือถืออย่างเดียวครับ แก้ตัวเลขก่อนยืนยันได้จากหน้าจอเดียว พอส่งโพยแล้วเครดิตกับรายการฝากถอนก็อยู่ในหน้าบัญชีชุดเดียวกัน ตรวจย้อนหลังได้เองโดยไม่ต้องถามใคร",
    avatar: "📱",
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label="เสียงจากสมาชิก POE888" class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#a8d4ff] via-[#2e8bff] to-[#5aa9ff] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      เสียงจากสมาชิก <span class="text-[#ffd93d]">POE888</span>
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#ffd93d] to-transparent"></div>
  </div>

  <div class="mx-auto mb-8 flex max-w-md items-center justify-center gap-5 rounded-2xl border border-[#2e8bff]/25 bg-[#04173f]/92 px-6 py-4 shadow-[0_10px_30px_rgba(2,10,30,0.5)] backdrop-blur-xl">
    <div class="flex flex-col items-center">
      <span class="bg-gradient-to-b from-[#ffe98a] to-[#cd994e] bg-clip-text text-4xl leading-none font-black text-transparent">{average}</span>
      <span class="mt-1 text-[10px] font-bold tracking-widest text-[#b9cdf0] uppercase">คะแนนเฉลี่ย</span>
    </div>
    <div class="h-12 w-px bg-[#062459]"></div>
    <div class="flex flex-col gap-1.5">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#ffd93d]" : "text-[#062459]"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#b9cdf0]">คะแนนเฉลี่ย {average} จาก 5 ดาว จากการใช้งานจริงของสมาชิก {reviews.length} ด้าน</span>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
    {
      reviews.map((review) => (
        <article class="group relative isolate flex flex-col gap-4 overflow-hidden rounded-2xl border border-[#2e8bff]/25 bg-[#04173f]/92 p-6 text-left shadow-[0_10px_30px_rgba(2,10,30,0.5)] backdrop-blur-xl transition-all duration-300 hover:-translate-y-1 hover:border-[#ffd93d]/55 hover:shadow-[0_15px_40px_rgba(46,139,255,0.30)]">
          <span class="absolute inset-y-0 left-0 -z-10 w-1 bg-gradient-to-b from-[#ffe98a] to-[#0b4ea8] opacity-80 transition-opacity duration-300 group-hover:opacity-100" />
          <span class="pointer-events-none absolute -top-14 -right-14 -z-10 h-32 w-32 rounded-full bg-[#0b4ea8]/45 blur-[50px] transition-all duration-300 group-hover:bg-[#2e8bff]/25" />

          <div class="flex items-center justify-between gap-3">
            <span class="inline-flex items-center gap-1.5 rounded-full border border-[#2e8bff]/25 bg-[#062459] px-3 py-1 text-[10px] font-bold tracking-widest text-[#a8d4ff] uppercase">
              <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#ffd93d]" />
              {review.tag}
            </span>
            <span class="flex gap-0.5 text-sm">
              <span aria-hidden="true" class="flex gap-0.5">
                {Array.from({ length: 5 }).map((_, i) => (
                  <span class={i < review.stars ? "text-[#ffd93d]" : "text-[#062459]"}>★</span>
                ))}
              </span>
              <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
            </span>
          </div>

          <p class="text-left text-base leading-relaxed text-[#dbeafe]">{review.content}</p>

          <div class="mt-auto flex items-center gap-3 border-t border-[#062459] pt-4">
            <span
              aria-hidden="true"
              class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#ffd93d]/30 bg-gradient-to-br from-[#ffe98a] via-[#ffd93d] to-[#cd994e] text-xl shadow-inner transition-transform duration-300 group-hover:scale-110">
              {review.avatar}
            </span>
            <span class="flex flex-col">
              <span class="text-sm font-black text-[#dbeafe] transition-colors group-hover:text-[#ffe98a]">{review.name}</span>
              <span class="text-[10px] font-bold tracking-wider text-[#b9cdf0] uppercase">{review.role}</span>
            </span>
          </div>
        </article>
      ))
    }
  </div>
</section>
