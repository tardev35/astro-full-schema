---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;
const rightHeading = titleright ?? title;
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#d6e2f7] bg-white p-8 text-[#1f2a44] shadow-[0_10px_30px_rgba(10,31,92,0.08)] transition-all duration-500 hover:border-[#9dbcf0] hover:shadow-[0_15px_40px_rgba(26,95,224,0.16)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-24 -left-24 -z-10 h-48 w-48 rounded-full bg-[#4d8ff5]/15 blur-[60px] transition-all duration-500 group-hover:bg-[#4d8ff5]/22"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-24 -bottom-24 -z-10 h-48 w-48 rounded-full bg-[#e0a91b]/15 blur-[60px] transition-all duration-500 group-hover:bg-[#e0a91b]/22"></div>

    <div class="grid grid-cols-1 gap-10 md:grid-cols-[2fr_3fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#1f2a44]">
        {
          titleleft && (
            <p class="text-center text-xl leading-normal font-black tracking-wide text-[#0a1f5c] md:text-left">
              {titleleft}
            </p>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#1f2a44] md:border-l md:border-[#d6e2f7] md:pl-10">
        {
          rightHeading && (
            <HeadingTag class="mb-2 bg-gradient-to-r from-[#0a1f5c] via-[#0b3a9e] to-[#1a5fe0] bg-clip-text text-xl leading-normal font-black tracking-wide text-transparent md:text-2xl">
              {rightHeading}
            </HeadingTag>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
