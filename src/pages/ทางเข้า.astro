---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";
import { pageGraph } from "../lib/schema";

const pageTitle = "ทางเข้า BUNNY555 เว็บหลัก";

const pageDescription =
  "หน้าทางเข้า BUNNY555 สล็อตเว็บตรง สำหรับกดเข้าสู่ระบบหรือสมัครสมาชิกจากจุดเดียว รองรับมือถือและคอม ใช้บัญชีเดิมเข้าเลือกเกมค่ายใหญ่ เช็กโบนัส และจัดการเครดิต";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทางเข้า", path: "/ทางเข้า" },
  ],
});
---

<MainLayout title="ทางเข้า BUNNY555 เว็บหลัก | เข้าสู่ระบบและสมัครสมาชิกสล็อตเว็บตรง" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="mb-5 grid grid-cols-1 gap-8 md:grid-cols-2">
      <div class="flex flex-col items-center justify-center gap-4">
        <a
          href="/login"
          aria-label="เข้าสู่ระบบ BUNNY555"
          class="group relative mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#be185d]/50 bg-[#ec4899] px-6 py-4 shadow-[0_10px_30px_rgba(190,24,93,0.20)] transition-all duration-300 hover:scale-105 hover:border-[#f7c948] hover:bg-[#be185d] hover:shadow-[0_15px_40px_rgba(236,72,153,0.20)]">
          <div aria-hidden="true" class="absolute inset-x-0 top-0 h-1/2 bg-gradient-to-b from-white/30 to-transparent"></div>

          <svg
            class="relative z-10 h-9 w-9 text-white"
            aria-hidden="true"
            focusable="false"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            viewBox="0 0 24 24"
            xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"></path>
          </svg>

          <span class="relative z-10 text-3xl font-bold tracking-wide text-white">เข้าสู่ระบบ</span>
        </a>
      </div>

      <div class="flex flex-col items-center justify-center gap-4">
        <a
          href="/register"
          aria-label="สมัครสมาชิก BUNNY555"
          class="group relative mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#a86a10]/50 bg-gradient-to-r from-[#f7c948] via-[#e8a020] to-[#f7c948] px-6 py-4 shadow-[0_10px_30px_rgba(190,24,93,0.18)] transition-all duration-300 hover:scale-105 hover:border-[#be185d]/70 hover:shadow-[0_15px_40px_rgba(232,160,32,0.20)]">
          <div aria-hidden="true" class="absolute inset-x-0 top-0 h-1/2 bg-gradient-to-b from-white/55 to-transparent"></div>

          <svg
            class="relative z-10 h-9 w-9 text-[#7a1038]"
            aria-hidden="true"
            focusable="false"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            viewBox="0 0 24 24"
            xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"></path>
          </svg>

          <span class="relative z-10 text-3xl font-bold tracking-wide text-[#7a1038]">สมัครสมาชิก</span>
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
