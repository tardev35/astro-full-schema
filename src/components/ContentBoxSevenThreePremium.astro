---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;
const rightHeading = titleright ?? title;
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#5a1a60] bg-[#1c0620] p-8 text-[#ead9ec] shadow-[0_10px_30px_rgba(0,0,0,0.35)] transition-all duration-500 hover:border-[#8a2f8f] hover:shadow-[0_15px_40px_rgba(193,63,196,0.26)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-24 -left-24 -z-10 h-48 w-48 rounded-full bg-[#c13fc4]/20 blur-[60px] transition-all duration-500 group-hover:bg-[#c13fc4]/28"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-24 -bottom-24 -z-10 h-48 w-48 rounded-full bg-[#f5c542]/15 blur-[60px] transition-all duration-500 group-hover:bg-[#f5c542]/22"></div>

    <div class="grid grid-cols-1 gap-10 md:grid-cols-[2fr_3fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#ead9ec]">
        {
          titleleft && (
            <p class="bg-gradient-to-r from-[#e8e8ee] via-[#ffe08a] to-[#e061e3] bg-clip-text text-center text-xl leading-normal font-black tracking-widest text-transparent uppercase md:text-left">
              {titleleft}
            </p>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#ead9ec] md:border-l md:border-[#5a1a60] md:pl-10">
        {
          rightHeading && (
            <HeadingTag class="mb-2 bg-gradient-to-r from-[#e8e8ee] via-[#ffe08a] to-[#e061e3] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">
              {rightHeading}
            </HeadingTag>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
