---
import { Picture } from "astro:assets";

import slide1 from "../assets/slide1.png";
import slide2 from "../assets/slide2.png";

const images = [
  {
    src: slide1,
    alt: "ภาพโปรโมชั่น WINNOW168 พื้นสีแดงและทอง เขียนว่า WINNOW168 เว็บตรงน้องใหม่ รวมสล็อต คาสิโน กีฬา ในบัญชีเดียว และ เล่นลื่นผ่านมือถือ พร้อมแถบข้อความ ฝากถอนออโต้ ใช้งานง่าย จ่ายไว ถัดลงมาเป็นไอคอนสี่ช่อง สล็อตค่ายดัง คาสิโนสดครบวงจร กีฬาเดิมพันมันส์ และ โบนัสจัดเต็มทุกสัปดาห์ ด้านข้างเป็นพรีเซนเตอร์หญิงถือชิปคาสิโนยืนคู่กับโทรศัพท์มือถือ",
  },
  {
    src: slide2,
    alt: "ภาพโปรโมชั่น WINNOW168 พื้นสีแดงและทอง หัวเรื่องว่า เว็บตรงครบจบ!! สายเล่นอยากไว มาทางนี้ ใต้โลโก้ WINNOW168 เรียงข้อความสามบรรทัดว่า สล็อต คาสิโน กีฬา บัญชีเดียว เล่นได้ครบ และ เล่นผ่านมือถือ 24 ชม. ด้านข้างเป็นพรีเซนเตอร์หญิงชุดสีแดงยืนถือโทรศัพท์ที่เปิดหน้าเว็บไซต์อยู่",
  },
];

const COPIES = 3;
const slides = Array.from({ length: COPIES }, () => images).flat();
---

<div class="marquee mx-auto w-full max-w-3xl overflow-hidden px-4 py-5">
  <input id="carousel-pause" type="checkbox" class="peer sr-only" />
  <label
    for="carousel-pause"
    class="sr-only cursor-pointer peer-focus-visible:not-sr-only peer-focus-visible:mb-3 peer-focus-visible:inline-block peer-focus-visible:rounded-full peer-focus-visible:border peer-focus-visible:border-[#f5c542]/60 peer-focus-visible:px-4 peer-focus-visible:py-2 peer-focus-visible:text-sm peer-focus-visible:font-bold peer-focus-visible:text-[#ffdf8a]">
    หยุด / เล่นสไลด์ภาพ
  </label>

  <div class="marquee-track flex">
    {
      slides.map((slide, index) => {
        const isDuplicate = index >= images.length;
        return (
          <div class="marquee-slide" aria-hidden={isDuplicate ? "true" : undefined}>
            <Picture
              src={slide.src}
              alt={isDuplicate ? "" : slide.alt}
              class="block w-full rounded-xl border border-[#f5c542]/25 object-cover shadow-[0_10px_30px_rgba(224,30,38,0.18)]"
              width={slide.src.width}
              height={slide.src.height}
              loading="lazy"
              fetchpriority="low"
              decoding="async"
              widths={[300, 360, 540, 720]}
              sizes="(max-width: 767px) calc(100vw - 32px), 360px"
              formats={["avif", "webp"]}
              fallbackFormat="webp"
              quality={60}
            />
          </div>
        );
      })
    }
  </div>
</div>

<style>
  .marquee {
    --gap: 12px;
    --per-view: 1;
    --shift: calc(-200% - 24px);
  }

  @media (min-width: 768px) {
    .marquee {
      --gap: 16px;
      --per-view: 2;
      --shift: calc(-100% - 16px);
    }
  }

  .marquee-track {
    gap: var(--gap);
    width: 100%;
    animation: carousel-scroll 24s linear infinite;
    will-change: transform;
  }

  .marquee-slide {
    flex: 0 0 calc((100% - (var(--per-view) - 1) * var(--gap)) / var(--per-view));
  }

  @keyframes carousel-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(var(--shift));
    }
  }

  .marquee:hover .marquee-track,
  .marquee:focus-within .marquee-track,
  .marquee > input:checked ~ .marquee-track {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
    }
  }
</style>
