---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import { pageGraph } from "../lib/schema";

const pageTitle = "เกี่ยวกับเรา GOAT888 เว็บตรงสล็อต คาสิโน ระบบสมาชิก และฝากถอนออโต้ในบัญชีเดียว";

const pageDescription =
  "เกี่ยวกับเรา GOAT888 หน้ารวมข้อมูลบริการสล็อต คาสิโน ระบบสมาชิก ฝากถอนออโต้ และการเข้าสู่ระบบผ่านมือถือในบัญชีเดียว พร้อมสิทธิ์เครดิตฟรีสำหรับสมาชิกใหม่";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox as="h1" title={pageTitle}>
    <p class="mb-4 text-left text-base leading-relaxed text-[#f7e3f4]">
      <strong class="text-[#f5c451]">GOAT888</strong> รวมสล็อต คาสิโน โปรโมชั่น และการจัดการเครดิตไว้ในบัญชีเดียว สมาชิกเข้าสู่ระบบครั้งเดียวแล้วเลือกเกม ดูยอด
      หรือจัดการข้อมูลบัญชีต่อได้ทันที ทั้งบนมือถือและคอมพิวเตอร์ โดยไม่ต้องสลับไปมาระหว่างหลายระบบให้เสียจังหวะ
    </p>

    <p class="text-left text-base leading-relaxed text-[#f7e3f4]">
      หน้านี้ทำหน้าที่เป็นหน้าข้อมูลและแนะนำตัว อธิบายว่าเราเปิดให้บริการอะไร วางระบบสมาชิกไว้อย่างไร และเหมาะกับผู้เล่นแบบไหน เพื่อให้อ่านแล้วนำไปเทียบกับสิ่งที่เห็นในหน้าสมาชิกจริงได้
      ส่วนรายละเอียดของแต่ละสิทธิ์และเงื่อนไขจะอยู่ในหน้าโปรโมชั่นโดยตรง จึงควรเปิดดูก่อนกดรับทุกครั้ง เพราะคำว่า “ฟรี” น่าสนใจ ส่วนเงื่อนไขก็ต้องอ่านให้ครบ จะได้ไม่เซอร์ไพรส์กันทีหลัง
    </p>
  </ContentBox>

  <ContentBox as="h2" title="GOAT888 เว็บตรงสล็อตแท้ รวมเกมและค่ายไว้ในหมวดเดียว">
    <p class="mb-4 text-left text-base leading-relaxed text-[#f7e3f4]">
      เราจัดสล็อตเป็นหมวดหลักของเว็บ มีเกมหลายธีมและหลายค่ายให้เลือกจากบัญชีเดียว ทั้งเกมคลาสสิก เกมที่มีฟรีสปิน โบนัส และฟีเจอร์หลายรูปแบบ
      สมาชิกที่มีเกมประจำอยู่แล้วจึงเข้าเกมเดิมได้ไว ส่วนสายที่ชอบลองของใหม่ก็เปิดดูเกมใหม่จากหมวดสล็อตได้โดยตรง
    </p>

    <p class="text-left text-base leading-relaxed text-[#f7e3f4]">
      เกมเยอะอย่างเดียวไม่พอ เมนูต้องหาเจอเร็วด้วย เราจึงวางหมวดหมู่ให้กดถึงเกมที่ต้องการในไม่กี่ขั้น เพราะคนเข้าเว็บมาเล่นสล็อต ไม่ได้มาฝึกเลื่อนหน้าจอแบบมาราธอน
      ตัวเลือกเยอะเป็นเรื่องดี แต่ไม่ควรเยอะจนเลือกเกมนานกว่าเล่นเกม
    </p>
  </ContentBox>

  <ContentBox as="h2" title="คาสิโน GOAT888 เพิ่มทางเลือกอะไรนอกจากเกมสล็อต">
    <p class="mb-4 text-left text-base leading-relaxed text-[#f7e3f4]">
      นอกจากสล็อต เรายังเปิดหมวดคาสิโนที่มีเกมโต๊ะและเกมสดสำหรับสมาชิกที่อยากเปลี่ยนบรรยากาศ โดยยังใช้บัญชีและเครดิตชุดเดียวกับที่ใช้เล่นสล็อตอยู่แล้ว
      ไม่ต้องเปิดบัญชีที่สอง ไม่ต้องโอนเครดิตข้ามระบบ และไม่ต้องจำรหัสเพิ่มอีกชุด
    </p>

    <p class="text-left text-base leading-relaxed text-[#f7e3f4]">
      วันนี้อยากหมุนสล็อตก็เล่นสล็อต พรุ่งนี้อยากลองเกมโต๊ะก็เปลี่ยนหมวดได้เลย ความชอบเปลี่ยนได้ตามอารมณ์ แต่ไม่จำเป็นต้องให้บัญชีเปลี่ยนตามจนจำรหัสกันไม่ไหว
    </p>
  </ContentBox>

  <ContentBox as="h2" title="ระบบสมาชิก GOAT888 รวมเครดิต โปรโมชั่น และประวัติรายการไว้ที่เดียว">
    <p class="mb-4 text-left text-base leading-relaxed text-[#f7e3f4]">
      ระบบสมาชิกของเรารวมเครดิต สิทธิ์โปรโมชั่น และประวัติรายการไว้ในบัญชีเดียว สมาชิกจึงเช็กยอด ดูสิทธิ์ที่ถืออยู่ และจัดการข้อมูลส่วนตัวได้จากหน้าเดียว
      คนที่เล่นหลายเกมหรือถือหลายโปรพร้อมกันจะตามข้อมูลได้ง่ายขึ้น เพราะทุกอย่างอยู่ในที่เดียวกันตั้งแต่ต้น
    </p>

    <p class="text-left text-base leading-relaxed text-[#f7e3f4]">
      หลักที่เรายึดคือข้อมูลของสมาชิกควรหาเจอเร็วกว่ากุญแจรถตอนรีบออกจากบ้าน อันนั้นหายทีมีหัวร้อนจริง
      และขอย้ำเสมอว่าไม่ควรส่งรหัสผ่านหรือรหัส OTP ให้บุคคลอื่นไม่ว่ากรณีใด เพราะทีมงานจริงไม่มีความจำเป็นต้องขอสองสิ่งนี้
    </p>
  </ContentBox>

  <ContentBox as="h2" title="ฝากถอนออโต้และการเข้าสู่ระบบผ่านมือถือของ GOAT888">
    <p class="mb-4 text-left text-base leading-relaxed text-[#f7e3f4]">
      ฝากถอนออโต้ช่วยให้สมาชิกทำรายการผ่านบัญชีได้โดยตรง พร้อมดูเครดิตและข้อมูลรายการจากระบบเดียว ลดขั้นตอนก่อนกลับเข้าเกม
      ระบบออโต้มีหน้าที่ทำเรื่องเงินให้สั้นและตรง ทำรายการเสร็จแล้วไปเล่นต่อได้ ไม่ใช่เปลี่ยนจากรอคนมาเป็นรอวงกลมหมุนบนหน้าจอ
    </p>

    <p class="text-left text-base leading-relaxed text-[#f7e3f4]">
      ด้านการเข้าใช้งาน GOAT888 รองรับการเข้าสู่ระบบผ่านมือถือด้วยบัญชีเดิม เปิดสล็อต คาสิโน โปรโมชั่น ฝากถอน และข้อมูลบัญชีได้จากเบราว์เซอร์ ไม่ต้องติดตั้งโปรแกรมเพิ่ม
      เมนูหลักถูกจัดให้เหมาะกับจอเล็กและใช้งานด้วยมือเดียวได้สะดวก เพราะมือถือเล็กพอแล้ว ปุ่มไม่จำเป็นต้องเล็กตามจนต้องเพ่งเหมือนอ่านฉลากยา
    </p>
  </ContentBox>

  <ContentBox as="h2" title="สมาชิกใหม่ GOAT888 กับเครดิตฟรีและเงื่อนไขที่ควรอ่านก่อนกดรับ">
    <p class="mb-4 text-left text-base leading-relaxed text-[#f7e3f4]">
      สมาชิกใหม่สามารถเช็กสิทธิ์เครดิตฟรีได้จากหน้าโปรโมชั่น โดยแต่ละสิทธิ์อาจต่างกันในเรื่องเกมที่ร่วมรายการ ยอดเริ่มต้น เทิร์น หรือเงื่อนไขการถอน
      นอกจากสิทธิ์สำหรับสมาชิกใหม่ ยังมีกิจกรรมตามช่วงเวลาให้เลือกอีก สมาชิกจึงเลือกโปรให้ตรงกับรูปแบบการเล่นของตัวเองได้ ไม่ต้องไล่รับทุกอันที่ตัวเลขใหญ่
    </p>

    <p class="text-left text-base leading-relaxed text-[#f7e3f4]">
      เครดิตฟรีช่วยให้เริ่มต้นได้เบาขึ้น แต่ควรดูรายละเอียดก่อนกดรับทุกครั้ง ตัวหนังสือ “ฟรี” มักใหญ่ ส่วนเงื่อนไขมักตัวเล็กกว่าเสมอ
      โดยรวมแล้ว GOAT888 เหมาะกับคนที่ต้องการสล็อต คาสิโน โปรโมชั่น ฝากถอนออโต้ และการใช้งานผ่านมือถือในบัญชีเดียว โดยไม่อยากจัดการหลายระบบพร้อมกัน
    </p>
  </ContentBox>

  <Navfoot />
</MainLayout>
