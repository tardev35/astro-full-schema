---
import { Picture } from "astro:assets";

import slide2 from "../assets/slide2.png";
import slide3 from "../assets/slide3.png";

const images = [
  {
    src: slide2,
    alt: "ภาพโปรโมชั่น ANKERSPIN พื้นหลังโทนชมพูนีออนบนดำ มีไพ่โพดำและชิปคาสิโนพิมพ์โลโก้ ANKERSPIN กระจายอยู่ ด้านบนเป็นโลโก้ ANKER SPIN พร้อมสมอเรือ ตรงกลางเป็นตัวอักษรขนาดใหญ่ว่า เว็บตรงลิขสิทธิ์แท้ ถัดลงมาเขียนว่า สล็อต คาสิโนสด กีฬา และ รวมไว้ในบัญชีเดียว ตรงกลางเป็นพรีเซนเตอร์หญิงสองคนสวมชุดสีชมพูถือไพ่ ด้านล่างเป็นป้ายเขียนว่า ฝากถอน Auto Wallet, บริการตลอด 24 ชั่วโมง และ สมัครสมาชิกผ่านมือถือ ใช้งานง่าย",
  },
  {
    src: slide3,
    alt: "ภาพโปรโมชั่น ANKERSPIN พื้นหลังโทนชมพูนีออนมีเหรียญทองและชิปกระจายอยู่ ด้านบนเป็นโลโก้ ANKERSPIN พร้อมสมอเรือ ตรงกลางเป็นตัวอักษรขนาดใหญ่ว่า เว็บตรงลิขสิทธิ์แท้ ถัดลงมาเขียนว่า สล็อต คาสิโนสด ฝากถอน Auto Wallet ใต้ลงมาเป็นป้ายสี่ช่องเขียนว่า รวมสล็อต หลายค่าย เล่นง่าย, คาสิโนสด บาคาร่า รูเล็ต ครบ, Auto Wallet ฝากถอน 24 ชม. และ สมัครผ่านมือถือ เริ่มเล่นได้ไว ด้านขวาเป็นพรีเซนเตอร์หญิงสวมชุดสีชมพูถือชิปคาสิโน ด้านล่างเป็นป้ายเขียนว่า บัญชีเดียวครบทุกหมวด",
  },
];

const COPIES = 3;
const slides = Array.from({ length: COPIES }, () => images).flat();
---

<div class="marquee mx-auto w-full max-w-7xl overflow-hidden px-4 py-5">
  <input id="carousel-pause" type="checkbox" class="peer sr-only" />
  <label
    for="carousel-pause"
    class="sr-only cursor-pointer peer-focus-visible:not-sr-only peer-focus-visible:mb-3 peer-focus-visible:inline-block peer-focus-visible:rounded-full peer-focus-visible:border peer-focus-visible:border-[#ff2d8f]/60 peer-focus-visible:px-4 peer-focus-visible:py-2 peer-focus-visible:text-sm peer-focus-visible:font-bold peer-focus-visible:text-[#ffa6d5]">
    หยุด / เล่นสไลด์ภาพ
  </label>

  <div class="marquee-track flex">
    {
      slides.map((slide, index) => {
        const isDuplicate = index >= images.length;
        return (
          <div class="marquee-slide" aria-hidden={isDuplicate ? "true" : undefined}>
            <Picture
              src={slide.src}
              alt={isDuplicate ? "" : slide.alt}
              class="block w-full rounded-xl border border-[#ff2d8f]/40 object-cover shadow-[0_10px_30px_rgba(164,18,107,0.30)]"
              width={slide.src.width}
              height={slide.src.height}
              loading="lazy"
              fetchpriority="low"
              decoding="async"
              widths={[300, 360, 420, 480, 540, 600]}
              sizes="(max-width: 767px) calc(100vw - 32px), (max-width: 1279px) calc((100vw - 48px) / 2), 403px"
              formats={["avif", "webp"]}
              fallbackFormat="webp"
              quality={60}
            />
          </div>
        );
      })
    }
  </div>
</div>

<style>
  .marquee {
    --gap: 12px;
    --per-view: 1;
    --shift: calc(-200% - 24px);
  }

  @media (min-width: 768px) {
    .marquee {
      --gap: 16px;
      --per-view: 2;
      --shift: calc(-100% - 16px);
    }
  }

  @media (min-width: 1280px) {
    .marquee {
      --gap: 20px;
      --per-view: 3;
      --shift: calc(-66.6667% - 13.3333px);
    }
  }

  .marquee-track {
    gap: var(--gap);
    width: 100%;
    animation: carousel-scroll 24s linear infinite;
    will-change: transform;
  }

  .marquee-slide {
    flex: 0 0 calc((100% - (var(--per-view) - 1) * var(--gap)) / var(--per-view));
  }

  @keyframes carousel-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(var(--shift));
    }
  }

  .marquee:hover .marquee-track,
  .marquee:focus-within .marquee-track,
  .marquee > input:checked ~ .marquee-track {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
    }
  }
</style>
