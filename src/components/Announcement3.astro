---
const {
  message = "YIMSIAM889 สล็อตสยาม เว็บตรงแตกดีจริง ไม่ผ่านเอเย่นต์ • ยิ้มรับโปรสมาชิกใหม่ตั้งแต่ก้าวแรก • ฝากถอนระบบอัตโนมัติ 24 ชม. รองรับแอปธนาคารและ TrueMoney Wallet",
} = Astro.props;
---

<div class="mx-auto mt-4 max-w-[900px] px-4 md:px-0">
  <div
    class="relative flex h-[46px] items-center rounded-r-full border border-[#e9b949]/40 bg-gradient-to-r from-[#5e0f06]/70 to-[#140604] py-2 pr-4 pl-12 shadow-[0_0_20px_rgba(233,185,73,0.16)] backdrop-blur-md">
    <div class="absolute top-1/2 -left-2 flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full border-[3px] border-[#e9b949] bg-[#140604] shadow-[0_0_15px_rgba(233,185,73,0.55)]">
      <span aria-hidden="true" class="animate-pulse text-xl">📢</span>
    </div>

    <div class="mr-4 h-full w-[1px] bg-[#e9b949]/30"></div>

    <div class="flex-1 overflow-hidden [mask-image:linear-gradient(90deg,transparent_0%,#000_5%,#000_95%,transparent_100%)]">
      <div class="flex w-max animate-[scroll_25s_linear_infinite] gap-12 text-sm font-bold whitespace-nowrap text-[#f8dc9a]">
        <span class="drop-shadow-[0_0_5px_rgba(233,185,73,0.5)]">{message}</span>
        <span class="drop-shadow-[0_0_5px_rgba(233,185,73,0.5)]">{message}</span>
      </div>
    </div>
  </div>
</div>

<style>
  @keyframes scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(calc(-50% - 24px));
    }
  }
</style>
