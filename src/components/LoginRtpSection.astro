---
import ContentBoxTwo from "./ContentBoxTwo.astro";

const steps = [
  { icon: "🔑", name: "เข้าสู่ระบบด้วยยูสเดิม", detail: "ใช้เบอร์โทรศัพท์หรือยูสเซอร์เนมที่สมัครไว้ เข้าได้ทั้งจากมือถือและคอม", tag: "ขั้นที่ 1" },
  { icon: "🎴", name: "เลือกโต๊ะบาคาร่าหรือห้องคาสิโนสด", detail: "ไล่ดูห้องที่เปิดอยู่ก่อน แล้วค่อยเลือกโต๊ะที่จังหวะตรงกับสไตล์ของตัวเอง", tag: "ขั้นที่ 2" },
  { icon: "🎰", name: "สลับไปสล็อตลิขสิทธิ์ผ่าน API แท้", detail: "เปลี่ยนค่ายกลางทางด้วยเครดิตชุดเดิม ไม่ต้องออกจากระบบหรือเปิดยูสใหม่", tag: "ขั้นที่ 3" },
  { icon: "🎁", name: "เช็กโปรสมาชิกใหม่ที่เปิดอยู่", detail: "ดูยอดรับ เงื่อนไข เทิร์น และช่วงเวลาที่ใช้ได้จากหน้าเมมเบอร์ก่อนกดรับ", tag: "ขั้นที่ 4" },
  { icon: "💳", name: "ฝากถอนออโต้และย้อนดูประวัติ", detail: "ส่งรายการผ่านทรูวอลเล็ตหรือธนาคารจากหน้าเดิม ถอนยอดใหญ่แล้วเช็กสถานะได้เอง", tag: "ขั้นที่ 5" },
];

const chips = ["บาคาร่า", "คาสิโนสด", "สล็อตลิขสิทธิ์", "API แท้", "ถอนได้จริง 10 ล้าน", "ฝากถอนออโต้", "ยูสเดียว"];
---

<ContentBoxTwo titleleft="เข้าสู่ระบบ OKHENG" titleright="ลำดับการใช้งานบนหน้าเมมเบอร์" label="เข้าสู่ระบบ OKHENG และลำดับการใช้งานบนหน้าเมมเบอร์">
  <div slot="left" class="flex h-full flex-col gap-4">
    <div class="relative overflow-hidden rounded-2xl border border-[#6b0d1e] bg-[#2a0509] p-6 shadow-[0_10px_30px_rgba(237,1,51,0.18)]">
      <div aria-hidden="true" class="pointer-events-none absolute -top-10 -right-10 h-32 w-32 rounded-full bg-[#ed0133]/20 blur-[50px]"></div>

      <div class="relative z-10 mb-5 flex items-center gap-3">
        <span
          aria-hidden="true"
          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#6b0d1e] bg-gradient-to-br from-[#ff3d63] via-[#ed0133] to-[#7a0119] text-xl shadow-inner">
          🎴
        </span>
        <div class="flex flex-col">
          <p class="text-base font-black text-[#ffdb7d]">เข้าสู่ระบบแล้วเลือกโต๊ะหรือค่ายเกมที่ชอบต่อได้ทันที</p>
          <span class="text-[11px] text-[#e0b6bd]">ยูสเดียวใช้เข้าทั้งบาคาร่า คาสิโนสด และสล็อตลิขสิทธิ์ เช็กเครดิต ดูโปร และย้อนดูประวัติรายการของ OKHENG ได้จากหน้าเดียว</span>
        </div>
      </div>

      <div class="relative z-10 flex flex-col gap-3.5">
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#ff3d63]">👤</span>
          <input
            type="text"
            placeholder="เบอร์โทรศัพท์ / ยูสเซอร์เนม"
            class="w-full rounded-xl border border-[#6b0d1e] bg-[#170206] py-3 pr-4 pl-12 text-[#f9dfe3] transition-all outline-none placeholder:text-[#e0b6bd] focus:border-[#ed0133] focus:ring-1 focus:ring-[#ed0133]/40"
          />
        </div>
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#ff3d63]">🔑</span>
          <input
            type="password"
            placeholder="รหัส PIN 4 หลัก"
            class="w-full rounded-xl border border-[#6b0d1e] bg-[#170206] py-3 pr-4 pl-12 text-[#f9dfe3] transition-all outline-none placeholder:text-[#e0b6bd] focus:border-[#ed0133] focus:ring-1 focus:ring-[#ed0133]/40"
          />
        </div>

        <div class="flex items-center justify-between px-1 text-xs">
          <label class="flex items-center gap-2 text-[#e0b6bd]">
            <input type="checkbox" class="h-3.5 w-3.5 rounded border-[#6b0d1e] bg-[#170206] accent-[#ed0133]" />
            จดจำฉันไว้
          </label>
          <a href="/login" class="text-[#e0b6bd] transition-colors hover:text-[#ff3d63]">ลืมรหัส PIN?</a>
        </div>

        <button
          class="mt-1 w-full rounded-xl border border-[#ed0133]/50 bg-gradient-to-r from-[#ffdb7d] via-[#f0b429] to-[#a8710c] p-3.5 font-black text-[#170206] shadow-[0_10px_30px_rgba(237,1,51,0.28)] transition-all hover:scale-[1.02] hover:shadow-[0_15px_40px_rgba(237,1,51,0.36)]">
          เข้าสู่ระบบ
        </button>

        <div class="flex items-center gap-3 py-1 text-[11px] text-[#e0b6bd]">
          <span class="h-px flex-1 bg-[#6b0d1e]"></span>
          หรือ
          <span class="h-px flex-1 bg-[#6b0d1e]"></span>
        </div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] p-3 text-sm font-bold text-white shadow-md transition-all hover:scale-[1.02]">
          <span aria-hidden="true">💬</span> ทักไลน์ทีมงานตลอด 24 ชั่วโมง
        </a>

        <div class="mt-1 flex items-center justify-between px-1">
          <div class="flex gap-2">
            <span class="rounded-full border border-[#1f5fd6]/60 bg-[#0c1730] px-2.5 py-1 text-[10px] font-bold text-[#6fa8ff]"><span aria-hidden="true">🔒</span> เข้ารหัสข้อมูล</span>
            <span class="rounded-full border border-[#a8710c]/60 bg-[#2e1c05] px-2.5 py-1 text-[10px] font-bold text-[#ffdb7d]"><span aria-hidden="true">🕐</span> ใช้งานได้ตลอด 24 ชม.</span>
          </div>
          <a href="/register" class="text-xs font-bold text-[#e0b6bd] transition-colors hover:text-[#ff3d63]">สมัครสมาชิกใหม่</a>
        </div>
      </div>
    </div>
  </div>

  <div slot="right" class="h-full">
    <div class="flex h-full flex-col rounded-2xl border border-[#6b0d1e] bg-[#2a0509] p-5 shadow-[0_10px_30px_rgba(237,1,51,0.18)]">
      <div class="mb-5 flex items-center justify-between gap-3">
        <div>
          <span class="text-xs font-bold tracking-wide text-[#e0b6bd]">ลำดับการใช้งานที่ OKHENG วางไว้บนหน้าเมมเบอร์ หลังเข้าสู่ระบบด้วยยูสเดิม</span>
          <div class="bg-gradient-to-r from-[#ff3d63] via-[#f9dfe3] to-[#f0b429] bg-clip-text text-2xl font-black text-transparent sm:text-3xl">บาคาร่า • คาสิโนสด • สล็อตลิขสิทธิ์</div>
        </div>
        <span class="flex items-center gap-1.5 self-start rounded-full border border-green-500/40 bg-green-900/20 px-2.5 py-1">
          <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-green-400 shadow-[0_0_8px_rgba(74,222,128,0.7)]"></span>
          <span class="text-[10px] font-bold tracking-widest text-green-400 uppercase">Live</span>
        </span>
      </div>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#e0b6bd] uppercase">
        <span>ขั้นตอนการใช้งาน</span>
        <span>ลำดับ</span>
      </div>

      <div class="flex flex-1 flex-col gap-2.5">
        {
          steps.map((s) => (
            <div class="rounded-xl border border-[#6b0d1e] bg-[#170206] px-3.5 py-2.5 transition-colors hover:border-[#ed0133]/60 hover:bg-[#3a070f]">
              <div class="flex items-center justify-between gap-2 text-sm">
                <span class="flex min-w-0 items-center gap-2 font-bold text-[#f9dfe3]">
                  <span aria-hidden="true" class="w-5 shrink-0 text-center">
                    {s.icon}
                  </span>{" "}
                  <span class="truncate">{s.name}</span>
                </span>
                <span class="shrink-0 rounded-full border border-[#ed0133]/45 bg-[#3a070f] px-2.5 py-0.5 text-[10px] font-bold text-[#ffdb7d]">{s.tag}</span>
              </div>
              <div class="mt-1.5 text-[11px] tracking-wide text-[#e0b6bd]">{s.detail}</div>
            </div>
          ))
        }
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
        {chips.map((c) => <span class="rounded-full border border-[#6b0d1e] bg-[#170206] px-3 py-1 text-[10px] font-bold text-[#ff3d63]">{c}</span>)}
      </div>

      <div class="mt-3 text-center text-[10px] tracking-wide text-[#e0b6bd]">
        ลำดับในตารางสรุปจากที่หน้าเว็บแสดงไว้ รายละเอียดของค่ายเกม ห้องเล่น และเงื่อนไขโปรจริงให้ยึดตามหน้าเมมเบอร์และหน้าโปรโมชั่นของ OKHENG ก่อนเลือกใช้ทุกครั้ง หากติดขัดตรงไหนทักไลน์ทีมงานได้ตลอด
        24 ชั่วโมง
      </div>
    </div>
  </div>
</ContentBoxTwo>
