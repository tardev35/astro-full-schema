---
const { titleleft, titleright } = Astro.props;
---

<section class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#8f1080]/80 bg-[#1a0414]/92 p-8 text-[#f7e3f4] shadow-[0_10px_30px_rgba(255,61,219,0.22)] backdrop-blur-xl transition-all duration-500 hover:border-[#f5c451]/55 md:p-10">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-[3fr_7fr] md:items-center">
      <article
        class="flex flex-col gap-4 border-b border-[#8f1080]/80 pb-6 text-center text-base font-medium text-[#f5c451] md:border-r md:border-b-0 md:pr-6 md:pb-0 md:text-left">
        {
          titleleft && (
            <h2 class="text-center text-4xl leading-normal font-black tracking-wider text-[#f7e3f4] uppercase drop-shadow-[0_2px_10px_rgba(255,61,219,0.35)] md:text-left">{titleleft}</h2>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#f7e3f4] md:pl-6">
        {titleright && <h2 class="flex items-center gap-2 text-2xl leading-normal font-black text-[#f5c451] drop-shadow-[0_0_8px_rgba(245,196,81,0.35)]">{titleright}</h2>}
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
