---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";
import CtaRedirect from "../components/CtaRedirect.astro";
import { pageGraph } from "../lib/schema";

const pageTitle = "สมัครสมาชิก GGHENG | ปุ่มเปิดยูสใหม่ สล็อตเว็บตรงสายเฮง ไม่มีขั้นต่ำ";

const pageDescription =
  "หากคุณกำลังมองหาสล็อตเว็บตรงสายเฮงที่ไม่มีขั้นต่ำ GGHENG พร้อมมอบปุ่มสมัครสมาชิกเพียงปุ่มเดียว เพื่อเปิดยูสใหม่ เล่นได้ทุกแพลตฟอร์ม และฝากถอนผ่าน True Wallet";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "สมัครสมาชิก", path: "/register" },
  ],
});

const targetUrl = "https://yoalink.com/32c3";
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="สมัครสมาชิก GGHENG" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label="สมัครสมาชิก GGHENG"
        class="group relative mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#8a6208]/70 bg-gradient-to-b from-[#ffe9a3] via-[#f5c542] to-[#c8901a] px-6 py-4 text-xl font-bold tracking-wide text-[#2a0203] shadow-[0_10px_30px_rgba(245,197,66,0.26)] transition-all duration-300 hover:scale-105 hover:border-[#ffd34d] hover:shadow-[0_15px_40px_rgba(245,197,66,0.38)]">
        สมัครสมาชิก GGHENG
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="สมัครสมาชิก" />
</MainLayout>
