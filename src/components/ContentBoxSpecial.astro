---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h2" } = Astro.props;
---

<section class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#c7dcfb] bg-white p-6 text-[#1b2c4a] shadow-[0_10px_30px_rgba(11,63,184,0.12)] transition-all duration-500 hover:border-[#0b3fb8]/45 md:p-10">
    <div
      aria-hidden="true"
      class="pointer-events-none absolute top-0 left-1/2 -z-10 h-[2px] w-1/2 -translate-x-1/2 bg-gradient-to-r from-transparent via-[#0b3fb8] to-transparent opacity-60 transition-opacity duration-500 group-hover:opacity-100">
    </div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#c7dcfb] pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#0b3fb8] to-[#16a34a] shadow-[0_0_10px_rgba(11,63,184,0.35)]" />
          <HeadingTag class="bg-gradient-to-r from-[#062c85] via-[#0b3fb8] to-[#16a34a] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-2 lg:gap-10">
      <article
        class="relative flex gap-4 rounded-2xl border border-[#c7dcfb] bg-[#f3f8ff] p-6 text-left text-base leading-relaxed text-[#1b2c4a] transition-all duration-300 hover:-translate-y-2 hover:border-[#0b3fb8]/45 hover:bg-[#e6efff] hover:shadow-[0_15px_40px_rgba(11,63,184,0.16)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#c7dcfb] bg-gradient-to-br from-[#3b74e8] via-[#0b3fb8] to-[#062c85] text-2xl shadow-[0_5px_15px_rgba(11,63,184,0.20)]">
          📱
        </div>
        <slot name="left" />
      </article>

      <article
        class="relative flex gap-4 rounded-2xl border border-[#c7dcfb] bg-[#f3f8ff] p-6 text-left text-base leading-relaxed text-[#1b2c4a] transition-all duration-300 hover:-translate-y-2 hover:border-[#16a34a]/45 hover:bg-[#e3f8ec] hover:shadow-[0_15px_40px_rgba(22,163,74,0.18)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#c7dcfb] bg-gradient-to-br from-[#31c96b] via-[#16a34a] to-[#0f7a37] text-2xl shadow-[0_5px_15px_rgba(22,163,74,0.20)]">
          ✅
        </div>
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
