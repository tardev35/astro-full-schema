---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement6.astro";

import { Picture } from "astro:assets";

import pro1 from "../assets/slide1.png";
import pro2 from "../assets/slide2.png";
import pro3 from "../assets/slide3.png";
import { pageGraph } from "../lib/schema";

const pageTitle = "โปรโมชั่น PIGAUTO รวมสิทธิ์สมาชิกใหม่และสมาชิกเดิม สล็อตหมูเว็บตรง";

const pageHeading = "โปรโมชั่น PIGAUTO รวมสิทธิ์สำหรับสมาชิก";

const pageDescription =
  "รวมภาพโปรโมชั่น PIGAUTO สล็อตหมูเว็บตรง ทั้งการรับวอเลท ฝากถอนออโต้ไม่มีขั้นต่ำ และสิทธิ์ของสมาชิกเดิม เงื่อนไขระบุบนภาพทุกใบ สมัครยูสเดียวรับสิทธิ์ได้เลย";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: pro1.src,
});

const promoClass =
  "mx-auto h-auto w-full rounded-xl border border-[#f5c542]/45 object-contain shadow-[0_10px_30px_rgba(245,197,66,0.16)] transition-all duration-300 hover:-translate-y-1 hover:border-[#ffe08a]/80 hover:shadow-[0_15px_40px_rgba(245,197,66,0.26)]";
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageHeading} as="h1">
    <p class="mb-4 text-left text-base leading-relaxed text-[#f7e4d4]">
      หากคุณกำลังมองหาสิทธิ์ที่ดูจบได้ในหน้าเดียว <strong class="text-[#ffe08a]">PIGAUTO</strong> พร้อมมอบโปรของสมาชิกไว้ครบในภาพด้านล่าง ทั้งการรับวอเลทเต็มระบบ ฝากถอนออโต้ไม่มีขั้นต่ำ และการสมัครที่จบได้จากมือถือ
    </p>

    <p class="mb-8 text-left text-base leading-relaxed text-[#f7e4d4]">
      ยอดรับและเงื่อนไขของแต่ละใบไม่เท่ากัน ระบุไว้บนภาพแล้วทุกใบ เลือกใบที่ตรงกับทุนของคุณ แล้วสมัครยูสเดียวรับสิทธิ์ต่อจากหน้าเมมเบอร์ เพื่อประสบการณ์การเล่นที่คุ้มค่าและต่อเนื่องกว่าที่เคย
    </p>

    <div class="grid w-full grid-cols-1 gap-6 sm:grid-cols-2">
      <Picture
        src={pro1}
        alt="ภาพโปรโมชั่น PIGAUTO ข้อความ รองรับวอเล็ท เต็มระบบ และ pig auto wallet ใช้ง่าย ด้านบนเป็นโลโก้หมูการ์ตูน PIGAUTO ตรงกลางเป็นพรีเซนเตอร์หญิงในชุดกี่เพ้าสีแดงปักลายทอง รายล้อมด้วยโคมไฟจีนสีแดง พัดกระดาษสีทอง ไพ่ และเหรียญทองบนฉากหลังผ้าไหมสีแดง"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class={promoClass}
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />

      <Picture
        src={pro2}
        alt="ภาพโปรโมชั่น PIGAUTO ข้อความ เว็บสล็อตออโต้ไม่มีขั้นต่ำ และ เล่นได้อย่างเป็นมิตร ปลอดภัยสูง พรีเซนเตอร์หญิงในชุดกี่เพ้าสีแดงยืนอยู่ด้านขวาของภาพ รายล้อมด้วยพัดกระดาษสีทอง ชิปคาสิโน และเหรียญทองที่กระจายอยู่บนฉากหลังสีแดงสลับทอง"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class={promoClass}
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />

      <Picture
        src={pro3}
        alt="ภาพโปรโมชั่น PIGAUTO ตัวอักษรทองคำว่า PIGAUTO และข้อความ สมัครง่ายเหมือนเปิดมือถือ พรีเซนเตอร์หญิงในชุดกี่เพ้าสีแดงยืนอยู่ด้านซ้ายของภาพ มีโคมไฟจีนสีแดงแขวนอยู่ด้านบน พร้อมเหรียญทองและวงกลมลายจีนสีทองประดับรอบภาพ"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class={promoClass}
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />
    </div>

    <div class="mt-12 flex justify-center pb-4">
      <a
        href="/register"
        class="flex items-center justify-center rounded-lg border border-[#b07d12]/60 bg-gradient-to-r from-[#ffe08a] via-[#f5c542] to-[#d99e1f] px-10 py-3.5 text-lg font-black text-[#1f0303] shadow-[0_10px_30px_rgba(245,197,66,0.28)] transition-transform hover:scale-105 hover:shadow-[0_15px_40px_rgba(245,197,66,0.38)]">
        สมัครสมาชิก PIGAUTO
      </a>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
