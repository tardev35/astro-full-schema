---
import { Picture } from "astro:assets";
import img1 from "../assets/providers/game1.avif";
import img2 from "../assets/providers/game2.avif";
import img3 from "../assets/providers/game3.avif";
import img4 from "../assets/providers/game4.avif";
import img5 from "../assets/providers/game5.avif";
import img6 from "../assets/providers/game6.avif";

const games = [
  { rank: 1, name: "สล็อตฟีเจอร์ฟรีสปิน", type: "บทจะเข้าฟรีสปินก็ไหลยาวเป็นหางว่าว ตัวคูณซ้อนหลายชั้น", menus: ["ยอดนิยม", "เล่นล่าสุด"], players: 5124, img: img6 },
  { rank: 2, name: "สล็อตแตกง่ายทุนน้อย", type: "ฝาก 1 บาทก็เริ่มปั่นได้ ไม่มีขั้นต่ำของจริง", menus: ["ยอดนิยม", "รายการโปรด"], players: 3842, img: img2 },
  { rank: 3, name: "สล็อตสายซื้อฟรีสปิน", type: "กดเข้าโบนัสได้เลย ไม่ต้องนั่งรอจังหวะให้เมื่อยนิ้ว", menus: ["ยอดนิยม", "รายการโปรด"], players: 3517, img: img3 },
  { rank: 4, name: "สล็อตเกมใหม่สำหรับมือถือ", type: "เมนูภาษาไทยตัวใหญ่ กดง่ายด้วยมือเดียวตั้งแต่หน้าแรก", menus: ["เกมใหม่", "เล่นล่าสุด"], players: 2905, img: img4 },
  { rank: 5, name: "สล็อตคลาสสิกรอบสั้น", type: "จบไวเข้าใจง่าย เหมาะกับสายขำๆ คั่นเวลา", menus: ["เกมใหม่", "รายการโปรด"], players: 2431, img: img1 },
  { rank: 6, name: "สล็อตแจ็คพอตหลักล้าน", type: "แตกทีเดียวก็โอนให้ครบทุกบาท จ่ายเต็มไม่มีหัก", menus: ["เกมใหม่", "เล่นล่าสุด"], players: 2108, img: img5 },
];

const medal = (rank: number) => (rank === 1 ? "🥇" : rank === 2 ? "🥈" : rank === 3 ? "🥉" : null);
---

<section aria-label="หมวดสล็อตยอดนิยมของ YIMSIAM88" class="mx-auto w-full max-w-[1300px] px-4 py-8 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <span aria-hidden="true" class="text-2xl">🏆</span>
    <p class="bg-gradient-to-r from-[#ffd98a] via-[#f6c475] to-[#ff7a18] bg-clip-text text-2xl font-black tracking-widest text-transparent uppercase">
      หมวดสล็อตยอดนิยมของ YIMSIAM88 ที่พี่น้องชาวไทยปั่นกันมากที่สุด
    </p>
    <p class="max-w-3xl text-base leading-relaxed text-[#c9ac91]">
      ทุกเกมที่ YIMSIAM88 รันด้วยระบบ RNG มาตรฐานโลกเหมือนกันหมดครับ การแตกของโบนัสจึงเป็นไปตามธรรมชาติของเกมจริงๆ ไม่มีการกั๊กช่วงเวลา ไม่มีการปรับ % ให้เกลือ
      ลำดับความนิยมในตารางนี้ขยับตามคนที่เข้ามาปั่นในแต่ละช่วง ไม่ได้แปลว่าเกมไหนแตกง่ายกว่าเกมไหน วัดกันที่ดวงและฝีมือล้วนๆ เหมือนกันทุกเกม
    </p>
    <div class="mt-2 h-[3px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#ff7a18] to-transparent"></div>
  </div>

  <div class="flex flex-col gap-3">
    {
      games.map((g) => {
        const top = g.rank === 1;
        return (
          <article
            class={`group relative flex items-center gap-3 overflow-hidden rounded-2xl border p-3 backdrop-blur-md transition-all duration-300 hover:-translate-y-0.5 sm:gap-5 sm:p-4 ${
              top
                ? "border-[#ff7a18]/50 bg-gradient-to-r from-[#3a1a0e]/95 via-[#24100a]/92 to-[#24100a]/92 shadow-[0_15px_40px_rgba(255,122,24,0.3)]"
                : "border-[#ff7a18]/25 bg-[#24100a]/92 shadow-[0_10px_30px_rgba(255,122,24,0.18)] hover:border-[#ff7a18]/50 hover:shadow-[0_15px_40px_rgba(255,122,24,0.3)]"
            }`}>
            <div class="pointer-events-none absolute top-1/2 -left-10 h-24 w-24 -translate-y-1/2 rounded-full bg-[#ffa347]/20 blur-[40px] transition-all duration-500 group-hover:bg-[#ffa347]/30" />

            <div class="relative z-10 flex w-8 shrink-0 flex-col items-center justify-center sm:w-12">
              {medal(g.rank) ? (
                <span class="text-2xl sm:text-3xl">
                  <span aria-hidden="true">{medal(g.rank)}</span>
                  <span class="sr-only">อันดับ {g.rank}</span>
                </span>
              ) : (
                <span class="text-xl font-black text-[#c8921e] sm:text-2xl">#{g.rank}</span>
              )}
            </div>

            <div class={`relative z-10 h-14 w-14 shrink-0 overflow-hidden rounded-xl border sm:h-16 sm:w-16 ${top ? "border-[#ff7a18]/50" : "border-[#ff7a18]/25"}`}>
              <Picture
                src={g.img}
                alt={`ภาพหน้าปกเกมสล็อตในหมวด ${g.name} บนกระดานหมวดสล็อตยอดนิยมของ YIMSIAM88`}
                formats={["avif", "webp"]}
                fallbackFormat="webp"
                loading="lazy"
                fetchpriority="low"
                widths={[100, 200]}
                sizes="(max-width: 640px) 56px, 64px"
                decoding="async"
                class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-110"
              />
            </div>

            <div class="relative z-10 min-w-0 flex-1">
              <div class="flex items-center gap-2">
                <p class="truncate text-base font-black text-[#f7e6d4] sm:text-lg">{g.name}</p>
                {top && (
                  <span class="hidden shrink-0 rounded-full border border-[#f6c475]/60 bg-[#160604] px-2 py-0.5 text-[9px] font-black tracking-wider text-[#f6c475] sm:inline">ยอดนิยมสูงสุด</span>
                )}
              </div>
              <p class="truncate text-[11px] text-[#c9ac91] sm:text-xs">{g.type}</p>

              <div class="mt-2 flex flex-wrap items-center gap-1.5">
                {g.menus.map((m) => (
                  <span class="rounded-full border border-[#ff7a18]/25 bg-[#160604] px-2.5 py-0.5 text-[10px] font-bold text-[#ff7a18]">{m}</span>
                ))}
              </div>
            </div>

            <div class="relative z-10 hidden shrink-0 flex-col items-end gap-1 sm:flex">
              <span class="flex items-center gap-1.5 text-[11px] text-[#c9ac91]">
                <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-green-500 shadow-[0_0_6px_rgba(34,197,94,0.6)]" />
                <span class="tabular-nums" data-players data-base={g.players}>
                  {g.players.toLocaleString("en-US")}
                </span>{" "}
                ออนไลน์
              </span>
              <a
                href="/register"
                class={`rounded-full px-4 py-1.5 text-xs font-black transition-transform hover:scale-105 ${
                  top
                    ? "bg-gradient-to-r from-[#ffd98a] via-[#f6c475] to-[#c8921e] text-[#160604] shadow-[0_10px_30px_rgba(246,196,117,0.22)]"
                    : "border border-[#ff7a18]/60 bg-[#160604] text-[#ff7a18] hover:border-[#ff7a18] hover:bg-[#3a1a0e]"
                }`}>
                เข้าดูเกม
              </a>
            </div>
          </article>
        );
      })
    }
  </div>
</section>

<script>
  import { startLiveCounters } from "../lib/liveCounter";

  startLiveCounters();
</script>
