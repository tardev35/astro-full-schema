---
const { message = "⚽ BRAZIL999 คาสิโนสล็อตเว็บใหญ่ ทลายความกลัว ถอนชัวร์ด้วย API แท้" } = Astro.props;
---

<div class="mx-auto flex h-[42px] max-w-[900px] items-center overflow-hidden bg-[#061409] shadow-[0_4px_15px_rgba(0,0,0,0.5)]">
  <div class="relative z-10 flex h-full items-center bg-gradient-to-r from-green-700 to-green-500 px-6 pl-4 [clip-path:polygon(0_0,100%_0,85%_100%,0_100%)] md:px-8">
    <div class="flex items-center gap-2">
      <span class="relative flex h-2.5 w-2.5">
        <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-yellow-400 opacity-75"></span>
        <span class="relative inline-flex h-2.5 w-2.5 rounded-full bg-yellow-400"></span>
      </span>
      <span class="font-black tracking-widest text-yellow-400 italic drop-shadow-md">HOT</span>
    </div>
  </div>

  <div class="relative flex-1 overflow-hidden bg-[url('/assets/noise.png')]">
    <div class="absolute inset-y-0 left-0 z-10 w-8 bg-gradient-to-r from-[#061409] to-transparent"></div>
    <div class="absolute inset-y-0 right-0 z-10 w-8 bg-gradient-to-l from-[#061409] to-transparent"></div>

    <div class="flex w-max animate-[scroll_20s_linear_infinite] items-center gap-10 pl-4 text-sm font-bold whitespace-nowrap text-gray-300 md:text-base">
      <span>{message}</span>
      <span>{message}</span>
      <span>{message}</span>
    </div>
  </div>

  <div class="absolute bottom-0 left-0 h-[2px] w-full bg-gradient-to-r from-yellow-400 via-yellow-500 to-transparent"></div>
</div>

<style>
  @keyframes scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(calc(-33.33% - 13px));
    }
  }
</style>
