---
const {
  message = "GOAT888 รวมสล็อต คาสิโน ระบบสมาชิก และฝากถอนออโต้ไว้ในบัญชีเดียว • เว็บตรงสล็อตแท้ มีเกมหลายธีมและหลายค่ายให้เลือกจากบัญชีเดียว • คาสิโนสดและเกมโต๊ะใช้เครดิตชุดเดียวกับสล็อต ไม่ต้องสลับบัญชี • สมาชิกใหม่เช็กสิทธิ์เครดิตฟรีได้จากหน้าโปรโมชั่น อ่านเงื่อนไขให้ครบก่อนกดรับ • ฝากถอนออโต้ทำรายการผ่านบัญชีได้โดยตรง เข้าสู่ระบบผ่านมือถือด้วยบัญชีเดิม",
} = Astro.props;
---

<div class="mx-auto w-full max-w-7xl px-4 py-3 font-sans">
  <div class="relative overflow-hidden rounded-md border border-[#f5c451]/45 bg-[#1a0414] shadow-[0_0_15px_rgba(255,61,219,0.18)]">
    <div aria-hidden="true" class="absolute top-0 -left-4 h-full w-8 -skew-x-12 bg-gradient-to-b from-[#ffa3ee] to-[#ff3ddb]"></div>
    <div aria-hidden="true" class="absolute top-0 -right-4 h-full w-8 -skew-x-12 bg-[#f5c451]/20"></div>

    <div class="flex items-center">
      <div class="relative z-10 flex w-12 shrink-0 items-center justify-center bg-gradient-to-b from-[#ffa3ee] to-[#ff3ddb] py-2.5">
        <span aria-hidden="true" class="animate-pulse text-lg drop-shadow-[0_0_5px_rgba(245,196,81,0.85)]">🔔</span>
      </div>

      <div class="marquee-container relative flex-1 overflow-hidden py-2.5 pr-6">
        <div aria-hidden="true" class="pointer-events-none absolute top-0 left-0 z-10 h-full w-8 bg-gradient-to-r from-[#1a0414] to-transparent"></div>
        <div aria-hidden="true" class="pointer-events-none absolute top-0 right-0 z-10 h-full w-12 bg-gradient-to-l from-[#1a0414] to-transparent"></div>

        <div class="marquee-content inline-block pl-4 text-sm font-bold tracking-wide whitespace-nowrap text-[#ffe6a3]">
          <span class="mr-8 inline-flex items-center gap-2"><span aria-hidden="true" class="h-1.5 w-1.5 rounded-full bg-[#ff3ddb] shadow-[0_0_5px_rgba(255,61,219,0.85)]"></span>{message}</span>
          <span class="mr-8 inline-flex items-center gap-2"><span aria-hidden="true" class="h-1.5 w-1.5 rounded-full bg-[#ff3ddb] shadow-[0_0_5px_rgba(255,61,219,0.85)]"></span>{message}</span>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .marquee-content {
    animation: marquee 25s linear infinite;
  }
  .marquee-container:hover .marquee-content {
    animation-play-state: paused;
  }
  @keyframes marquee {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee-content {
      animation: none;
    }
  }
</style>
