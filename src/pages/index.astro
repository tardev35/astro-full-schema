---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/AnnouncementPremium.astro";
import ContentBox from "../components/ContentBox.astro";
import ContentBoxPremium from "../components/ContentBoxPremium.astro";
import ContentBoxCyberCut from "../components/ContentBoxCyberCut.astro";
import ContentBoxSpecial from "../components/ContentBoxSpecial.astro";
import ContentBoxTwoPremium from "../components/ContentBoxTwoPremium.astro";
import ContentBoxTwoCyberCut from "../components/ContentBoxTwoCyberCut.astro";
import ContentBoxSevenThreePremium from "../components/ContentBoxSevenThreePremium.astro";
import ContentBoxSevenThreeCyberCut from "../components/ContentBoxSevenThreeCyberCut.astro";
import GameRankingBoard from "../components/GameRankingBoard.astro";
import FeatureHighlights from "../components/FeatureHighlights.astro";
import SmoothCarousel from "../components/SmoothCarousel.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import LatestWinnersCyber from "../components/LatestWinnersCyber.astro";
import ProviderGrid from "../components/ProviderGrid.astro";
import ReviewCardSumo2 from "../components/ReviewCardSumo2.astro";
import Faq2 from "../components/Faq2.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import imgSignupMobile from "../assets/slide3.png";
import imgAutoWallet from "../assets/slide1.png";
import imgSlotBrand from "../assets/banner2.png";
import imgPlayerFit from "../assets/banner3.png";

const pageTitle = "PIGAUTO เว็บสล็อตออโต้ ไม่มีขั้นต่ำ รองรับวอลเล็ท สมัครรับโปรสมาชิกใหม่";

const pageDescription =
  "PIGAUTO เว็บสล็อตออโต้แท้ ไม่มีขั้นต่ำ รองรับวอลเล็ท ยูสเดียวปั่นสล็อตและเข้าคาสิโนสดได้ ฝากถอนออโต้ได้เองจากมือถือ พร้อมเช็กโปรสมาชิกใหม่ก่อนกดรับทุกครั้ง";

const announcement =
  "PIGAUTO เว็บสล็อตออโต้แท้ ปั่นได้ทุกค่ายจากยูสเดียว ไม่มีขั้นต่ำในการเข้าเล่น • รองรับวอลเล็ทเต็มระบบ ฝากถอนออโต้ส่งรายการเองได้ตลอด 24 ชั่วโมง • ยูสเดิมสลับไปคาสิโนสดและบาคาร่าได้ ไม่ต้องสมัครใหม่ • โปรสมาชิกใหม่ดูยอดรับ เงื่อนไข และเทิร์นได้ก่อนกดรับทุกครั้ง • ทางเข้า PIGAUTO ใช้ยูสเดิมสลับมือถือกับคอมได้ ไม่ต้องเริ่มใหม่";

const slotBrandAlt =
  "ภาพประกอบ PIGAUTO พื้นหลังอัญมณีสีแดงและสีทองแตกกระจาย ด้านบนเป็นตัวอักษรสีทองขอบแดงคำว่า PIGAUTO และบรรทัดถัดมาว่า สล็อตอันดับ 1 ตรงกลางเป็นหมูการ์ตูนสีชมพูยิ้มกว้าง มีแสงสีทองเรืองรอบตัว ถือเหรียญทองไว้ในมือ";

const playerFitAlt =
  "ภาพประกอบ PIGAUTO พื้นหลังสีแดงเข้มมีอัญมณีสีแดงและสีทองลอยกระจาย ด้านบนเป็นตัวอักษรสีทองขอบแดงคำว่า PIGAUTO ตรงกลางเป็นหมูการ์ตูนสีชมพูสวมมงกุฎทองและกางปีกทองสองข้าง ถือเหรียญทองสัญลักษณ์ดอลลาร์ ด้านล่างเป็นข้อความว่า สล็อตอันดับ 1 พร้อมสัญลักษณ์เลข 7 สีแดง";

const signupMobileAlt =
  "ภาพโปรโมชั่น PIGAUTO โทนแดงตรุษจีนสลับทอง ด้านซ้ายเป็นพรีเซนเตอร์หญิงสวมชุดกี่เพ้าสีแดงปักลายมังกรทอง ด้านหลังเป็นวงกลมลายจีนสีทอง โคมไฟจีนสีแดง และพัดกระดาษสีทอง มุมขวาบนเป็นโลโก้หมูสีชมพูพร้อมคำว่า PIGAUTO กลางภาพเป็นตัวอักษรสีขาวขนาดใหญ่ว่า PIGAUTO และบรรทัดล่างว่า สมัครง่ายเหมือนเปิดมือถือ";

const autoWalletAlt =
  "ภาพโปรโมชั่น PIGAUTO โทนแดงตรุษจีนสลับทอง ด้านซ้ายเป็นพรีเซนเตอร์หญิงสวมชุดกี่เพ้าสีแดงปักลายทอง ด้านหลังมีโคมไฟจีนสีแดง พัดกระดาษสีทอง ไพ่เอซ ชิปคาสิโน และเหรียญทองกระจายอยู่รอบภาพ ด้านบนเป็นโลโก้หมูสีชมพูพร้อมคำว่า PIGAUTO ด้านล่างเป็นตัวอักษรสีขาวขอบทองว่า รองรับวอลเล็ท เต็มระบบ และแถบว่า pig auto wallet ใช้ง่าย";

const trustPoints = [
  {
    icon: "💰",
    title: "เครดิตขึ้นตรง",
    description: "หลังส่งรายการฝาก เครดิตจะไปแสดงในหน้าสมาชิกให้เช็กได้เอง ไม่ต้องเดาว่ายอดเข้าแล้วหรือยังก่อนกลับไปปั่นต่อ",
    accent: "gold" as const,
  },
  {
    icon: "🧾",
    title: "ประวัติรายการหาเจอ",
    description: "รายการย้อนหลังทั้งฝาก ถอน และโปรที่เคยรับ อยู่หน้าเดียวกับเครดิต เปิดดูตอนไหนก็ไล่ย้อนได้ครบ",
    accent: "blue" as const,
  },
  {
    icon: "👛",
    title: "วอลเล็ทกับธนาคารอยู่จุดเดียว",
    description: "เลือกช่องทางที่ถนัดได้ทั้งวอลเล็ทและบัญชีธนาคาร ฝาก ถอน และดูยอดคงเหลือรวมอยู่ในพื้นที่เดียวกันของหน้าสมาชิก",
    accent: "gold" as const,
  },
  {
    icon: "📱",
    title: "เปลี่ยนเครื่องข้อมูลอยู่ครบ",
    description: "สลับจากมือถือไปคอมด้วยยูสเดิม เครดิต โปร และประวัติรายการยังอยู่ที่เดิม ไม่ต้องเริ่มนับหนึ่งใหม่",
    accent: "blue" as const,
  },
];

const faqs = [
  {
    q: "PIGAUTO สล็อตออโต้ ค่ายไหนเหมาะกับสายปั่นจริง",
    a: "ค่ายสล็อตแต่ละเจ้าให้จังหวะไม่เหมือนกัน บางค่ายรอบสั้นเก็บเรื่อย ๆ บางค่ายต้องรอฟีเจอร์ยาวกว่าจะเข้าโบนัส สายปั่นจริงจึงเลือกจากจังหวะที่ตัวเองทนได้มากกว่าชื่อค่าย PIGAUTO รวมค่ายไว้ในหน้าเดียวและใช้เครดิตชุดเดิม เปลี่ยนค่ายกลางทางได้โดยไม่ต้องออกจากระบบ ลองหลายค่ายในหนึ่งวันจึงเป็นเรื่องปกติที่นี่",
  },
  {
    q: "คาสิโนสดและบาคาร่าของ PIGAUTO เลือกโต๊ะยังไงให้ตรงสไตล์",
    a: "สายบาคาร่าแต่ละคนเล่นไม่เหมือนกัน บางคนชอบโต๊ะไหลไว บางคนดูเค้าไพ่ก่อน บางคนแค่ต้องการห้องที่ภาพชัดและเข้าเดิมพันง่าย ตัวเลือกโต๊ะจึงสำคัญพอ ๆ กับจำนวนเกม PIGAUTO ให้เปิดดูห้องแล้วสลับโต๊ะจากยูสเดิมได้ ถ้าโต๊ะนี้ไม่ใช่ก็ย้าย ไม่ต้องฝืนโต๊ะเพียงเพราะนั่งมานานแล้ว",
  },
  {
    q: "โปรสมาชิกใหม่ PIGAUTO ต้องดูตรงไหนก่อนกดรับ",
    a: "โปรสมาชิกใหม่ควรดูยอดรับ เงื่อนไข เทิร์น และช่วงเวลาที่ใช้ได้ก่อนกด เพราะคำว่าโบนัสเยอะไม่ได้แปลว่าเหมาะกับทุกยูส PIGAUTO เปิดพื้นที่โปรให้สมาชิกเช็กสิทธิ์ก่อนใช้งาน เลือกอันที่เข้ากับแนวปั่นของตัวเองดีกว่ารับทุกอันจนสุดท้ายจำไม่ได้ว่าเครดิตก้อนไหนติดเงื่อนไขอะไรอยู่",
  },
  {
    q: "สมัครสมาชิก PIGAUTO ผ่านมือถือใช้เวลานานไหม",
    a: "สมัครผ่านมือถือเริ่มจากกรอกข้อมูล เปิดยูส และยืนยันตามระบบ จากนั้นล็อกอินเข้าหน้าสมาชิกเพื่อดูค่ายเกม เครดิต และโปรที่ใช้งานได้ ภาพบนหน้าเว็บเขียนไว้ตรงตัวว่าสมัครง่ายเหมือนเปิดมือถือ ซึ่งตรงกับสิ่งที่คนใช้มือถือเป็นหลักต้องการ คือจบทุกอย่างจากเครื่องเดียวโดยไม่ต้องเปิดคอม",
  },
  {
    q: "ฝากถอนออโต้และวอลเล็ทของ PIGAUTO ช่วยสายปั่นยังไง",
    a: "ระบบออโต้ตัดช่วงรอระหว่างฝากเข้า เครดิตขึ้น และกลับเข้าเกม รวมถึงตอนถอนออก สายปั่นจึงไม่ต้องหยุดยาวเพียงเพราะรอรายการ ส่วนวอลเล็ทช่วยอีกชั้นสำหรับคนที่ไม่อยากผูกบัญชีธนาคารไว้ตลอดเวลา ระบบการเงินที่ดีควรอยู่หลังฉากและทำงานของมันไปเงียบ ๆ",
  },
  {
    q: "เล่น PIGAUTO ไม่มีขั้นต่ำหมายความว่ายังไง",
    a: "ไม่มีขั้นต่ำหมายถึงเลือกได้เองว่าจะลงหนักหรือลงเบาในรอบนั้น ไม่ใช่คำสัญญาเรื่องผลลัพธ์ คนที่ตั้งงบไว้ต่อวันมักได้ประโยชน์จากข้อนี้มากที่สุด และวันไหนไม่อยากปั่นสล็อตก็เปลี่ยนไปนั่งโต๊ะสดด้วยยูสเดิมได้ เครดิตชุดเดียวใช้ได้ทั้งสองโหมด ไม่ต้องสมัครเพิ่มให้จำรหัสหลายชุด",
  },
];

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement message={announcement} />

  <ContentBoxPremium as="h1" title="PIGAUTO เว็บสล็อตออโต้ รวมสล็อต คาสิโนสด และระบบสมาชิกไว้ในยูสเดียว">
    <p class="mb-4 text-left text-base leading-relaxed">
      <strong class="text-[#f5c542]">PIGAUTO</strong> เป็นเว็บสล็อตออโต้ที่เปิดเข้ามาแล้วเลือกค่ายได้เลย ทั้งสล็อต คาสิโนสด และบาคาร่าอยู่ในยูสเดียว เครดิต โปร และประวัติรายการดูจากหน้าสมาชิกได้ทั้งหมด
    </p>

    <p class="text-left text-base leading-relaxed">
      ระบบฝากถอนออโต้รองรับวอลเล็ทเต็มระบบ เติมเสร็จแล้วกลับไปปั่นต่อจากมือถือได้ และไม่มีขั้นต่ำในการเข้าเล่น เกมเยอะไม่ใช่เรื่องใหม่ของปี 2026 แต่เข้าเกมได้ไวต่างหากที่คนเล่นเริ่มเรื่องมากขึ้น
    </p>
  </ContentBoxPremium>

  <ContentBox as="h2" title="PIGAUTO สล็อตออโต้ มีค่ายไหนเหมาะกับสายปั่นจริง">
    <p class="mb-4 text-left text-base leading-relaxed">
      ค่ายสล็อตแต่ละเจ้าให้จังหวะไม่เหมือนกัน บางค่ายรอบสั้นเก็บเรื่อย ๆ บางค่ายต้องรอฟีเจอร์ยาวกว่าจะเข้าโบนัส สายปั่นจริงจึงเลือกจากจังหวะที่ตัวเองทนได้มากกว่าชื่อค่าย
    </p>

    <p class="mb-6 text-left text-base leading-relaxed">
      PIGAUTO รวมค่ายไว้ในหน้าเดียวและใช้เครดิตชุดเดิม เปลี่ยนค่ายกลางทางได้โดยไม่ต้องออกจากระบบ ลองหลายค่ายในหนึ่งวันจึงไม่ใช่เรื่องแปลกสำหรับสมาชิกที่นี่
    </p>

    <Picture
      src={imgSlotBrand}
      alt={slotBrandAlt}
      loading="lazy"
      fetchpriority="low"
      widths={[320, 480, 560, 672, 800, 1024]}
      sizes="(max-width: 767px) calc(100vw - 96px), 672px"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      class="mx-auto h-auto w-full max-w-2xl rounded-2xl border border-[#6b2020] shadow-[0_10px_30px_rgba(239,68,68,0.24)]"
    />
  </ContentBox>

  <GameRankingBoard />

  <ContentBoxTwoPremium as="h2" title="คาสิโนสดและบาคาร่า PIGAUTO เลือกโต๊ะยังไงให้ตรงสไตล์">
    <p slot="left" class="text-left text-base leading-relaxed">
      สายบาคาร่าแต่ละคนเล่นไม่เหมือนกัน บางคนชอบโต๊ะไหลไว บางคนดูเค้าไพ่ก่อน บางคนแค่ต้องการห้องที่ภาพชัดและเข้าเดิมพันง่าย ตัวเลือกโต๊ะจึงสำคัญพอ ๆ กับจำนวนเกม
    </p>
    <p slot="right" class="text-left text-base leading-relaxed">
      PIGAUTO ให้เปิดดูห้องแล้วสลับโต๊ะจากยูสเดิมได้ ถ้าโต๊ะนี้ไม่ใช่ก็ย้าย คนเล่นมานานรู้ดีว่าอย่าฝืนโต๊ะเพียงเพราะนั่งมานานแล้ว
    </p>
  </ContentBoxTwoPremium>

  <ContentBoxCyberCut as="h2" title="เว็บใหญ่มั่นคง คนเล่นปี 2026 ดูจากอะไรบ้าง">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed">
        คนเล่นยุคนี้ไม่ได้ดูแค่หน้าเว็บสวย แต่ดูว่าเครดิตขึ้นตรงไหม ประวัติรายการหาเจอไหม ฝากถอนอยู่จุดเดียวหรือเปล่า และเปลี่ยนเครื่องแล้วข้อมูลยังอยู่ครบไหม
      </p>

      <p class="text-left text-base leading-relaxed">
        PIGAUTO รวมเรื่องพวกนี้ไว้ในหน้าสมาชิกหน้าเดียว ทั้งเครดิต โปร และรายการย้อนหลัง เงินอยู่ตรงไหนต้องรู้ก่อน เกมอยู่ตรงไหนค่อยว่ากันทีหลัง
      </p>

      <FeatureHighlights items={trustPoints} />
    </div>
  </ContentBoxCyberCut>

  <ContentBoxSpecial as="h2" title="โปรสมาชิกใหม่ PIGAUTO ดูตรงไหนก่อนกดรับ">
    <div slot="left" class="flex flex-col gap-3">
      <p class="text-left text-base leading-relaxed">
        โปรสมาชิกใหม่ควรดูยอดรับ เงื่อนไข เทิร์น และช่วงเวลาที่ใช้ได้ก่อนกด เพราะคำว่าโบนัสเยอะไม่ได้แปลว่าเหมาะกับทุกยูส
      </p>
    </div>
    <div slot="right" class="flex flex-col gap-3">
      <p class="text-left text-base leading-relaxed">
        PIGAUTO เปิดพื้นที่โปรให้เช็กสิทธิ์ก่อนใช้งาน เลือกอันที่เข้ากับแนวปั่นของตัวเองดีกว่ารับทุกอันจนจำไม่ได้ว่าเครดิตก้อนไหนติดเงื่อนไขอะไร
      </p>
    </div>
  </ContentBoxSpecial>

  <SmoothCarousel />

  <ContentBoxSevenThreePremium as="h2" titleright="สมัครสมาชิกผ่านมือถือ ใช้เวลานานไหม">
    <Picture
      slot="left"
      src={imgSignupMobile}
      alt={signupMobileAlt}
      loading="lazy"
      fetchpriority="low"
      widths={[240, 400, 600]}
      sizes="(max-width: 767px) calc(100vw - 64px), 380px"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      class="mx-auto h-auto w-full rounded-2xl border border-[#6b2020] shadow-[0_10px_30px_rgba(239,68,68,0.24)]"
    />

    <div slot="right" class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed">
