---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/Announcement3.astro";
import ContentBox from "../components/ContentBox.astro";
import ContentBoxPremium from "../components/ContentBoxPremium.astro";
import ContentBoxCyberCut from "../components/ContentBoxCyberCut.astro";
import ContentBoxSevenThreePremium from "../components/ContentBoxSevenThreePremium.astro";
import ContentBoxSevenThreeCyberCut from "../components/ContentBoxSevenThreeCyberCut.astro";
import ContentBoxTwoCyberCut from "../components/ContentBoxTwoCyberCut.astro";
import ContentBoxTwoPremium from "../components/ContentBoxTwoPremium.astro";
import FeatureHighlights from "../components/FeatureHighlights.astro";
import SmoothCarousel from "../components/SmoothCarousel.astro";
import ProviderGrid from "../components/ProviderGrid.astro";
import LatestWinners from "../components/LatestWinners.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import ReviewCardSumo2 from "../components/ReviewCardSumo2.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import imgAutoPay from "../assets/slide3.png";
import imgMobile from "../assets/slide4.png";

const pageTitle = "777RUAY | สล็อตออนไลน์ เล่นผ่านเบราว์เซอร์ ฝากถอนออโต้ 24 ชั่วโมง";

const pageDescription =
  "ทางเข้า 777RUAY สล็อตออนไลน์ เล่นผ่านเบราว์เซอร์ได้ทันที รวมหลายค่ายเกมฮิต ฝากถอนออโต้ตลอด 24 ชั่วโมง จัดการจบในมือถือ มีแอดมินดูแลและสมัครง่ายวันนี้";

const h1Title = "777RUAY สล็อตออนไลน์ เล่นผ่านเบราว์เซอร์ ฝากถอนออโต้ 24 ชั่วโมง";

const announcementMessage =
  "777RUAY สล็อตออนไลน์ เล่นผ่านเบราว์เซอร์ได้ทั้ง iOS และ Android ไม่ต้องโหลดแอป • ฝากถอนออโต้ตลอด 24 ชั่วโมง ไม่ต้องแนบสลิป • สมัคร ฝาก เล่น และถอนจบบนมือถือเครื่องเดียว • มีเรื่องติดขัดติดต่อแอดมินผ่านช่องทางบนหน้าเว็บ";

const autoPayAlt = "777RUAY ฝากถอนออโต้ รวดเร็ว ใช้งานง่าย มั่นใจได้ อัตโนมัติ ทันสมัย สะดวก ปุ่มสมัครเลย เหรียญลูกศรวนสีฟ้าข้างพรีเซนเตอร์ถือมือถือ";

const mobileAlt = "777RUAY เล่นได้ทุกที่ บนมือถือ ระบบทันสมัย พร้อมดูแลทุกขั้นตอน มือถือ ตอบไว พร้อมดูแล ปุ่มเข้าร่วมเลย พรีเซนเตอร์ชุดกี่เพ้าชี้ไปที่มือถือ";

const slotHighlights = [
  {
    icon: "🐯",
    title: "PG Soft · Fortune Tiger",
    description: "เสือทองวงล้อ 3×3 ไม่มีสแกตเตอร์และฟรีสปิน มีฟีเจอร์สุ่มที่หมุนซ้ำ",
    accent: "blue" as const,
  },
  {
    icon: "🍭",
    title: "Pragmatic Play · Sugar Rush",
    description: "ระบบร่วงหล่น จ่ายเมื่อสัญลักษณ์เหมือนกันติดกันเป็นกลุ่ม ช่องที่ชนะเป็นจุดตัวคูณ",
    accent: "gold" as const,
  },
  {
    icon: "💰",
    title: "JILI · Money Coming",
    description: "วงล้อตัวเลข 3 วงกับวงพิเศษวงที่สี่ที่ให้ตัวคูณ หมุนซ้ำ หรือเข้าโบนัส",
    accent: "gold" as const,
  },
  {
    icon: "🎏",
    title: "Habanero · Koi Gate",
    description: "ปลาคาร์ฟเป็นไวลด์ที่ขยายเต็มแถวแล้วหมุนซ้ำ",
    accent: "blue" as const,
  },
];

const graph = pageGraph(Astro, {
  name: h1Title,
  description: pageDescription,
});

const body = "text-left text-base leading-relaxed text-[#1f2a44]";
const brandMark = "font-bold text-[#8a6508]";
const inlineLink = "font-bold text-[#1a5fe0] underline underline-offset-4 transition-colors hover:text-[#8a6508]";
const slideFrame = "mx-auto h-auto w-full rounded-2xl border border-[#d6e2f7] shadow-[0_10px_30px_rgba(26,95,224,0.18)]";
const panel = "flex h-full flex-col justify-center gap-4 rounded-2xl border border-[#d6e2f7] bg-[#eef4ff] p-6";
const panelLabel = "text-lg leading-normal font-black text-[#0a1f5c]";
const panelHint = "text-sm font-bold text-[#4a5878]";
const btnPrimary =
  "flex w-full items-center justify-center gap-2 rounded-xl border-2 border-[#ffd45c] bg-gradient-to-b from-[#4d8ff5] via-[#1a5fe0] to-[#0b3a9e] px-6 py-3.5 text-base font-black text-white shadow-[0_10px_30px_rgba(26,95,224,0.35)] transition-transform hover:scale-[1.02]";
const btnSecondary =
  "flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-b from-[#ffd45c] via-[#e0a91b] to-[#b07d12] px-6 py-3.5 text-base font-black text-[#0a1f5c] shadow-[0_10px_30px_rgba(224,169,27,0.30)] transition-transform hover:scale-[1.02]";
const btnLine =
  "flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] px-6 py-3.5 text-base font-black text-white shadow-md transition-transform hover:scale-[1.02]";
const btnOutline =
  "flex w-full items-center justify-center gap-2 rounded-xl border-2 border-[#1a5fe0] bg-white px-6 py-3 text-base font-black text-[#1a5fe0] transition-colors hover:bg-[#1a5fe0] hover:text-white";
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement message={announcementMessage} />

  <SmoothCarousel />

  <ContentBoxPremium as="h1" title={h1Title}>
    <p class={body}>
      เคยไหมที่ตั้งใจจะกลับมาปั่นเกมค้างไว้แต่หาหน้าล็อกอินเดิมไม่เจอจนเสียจังหวะ ทางเข้า <strong class={brandMark}>777RUAY</strong> จึงเตรียมระบบสล็อตออนไลน์ที่เปิดเล่นผ่านเบราว์เซอร์ได้โดยไม่ต้องโหลดแอป สมาชิกเดิมใช้ยูสและรหัสเดิมเข้าได้ทุกเครื่อง เรารวมค่ายเกมฮิตคู่กับระบบฝากถอนออโต้ซึ่งใช้งานได้ตลอด 24 ชั่วโมง ทุกขั้นตอนตั้งแต่สมัครถึงถอนเงินจัดการจบบนมือถือเครื่องเดียว และมีแอดมินคอยช่วยเมื่อพบปัญหา
    </p>
  </ContentBoxPremium>

  <ContentBoxCyberCut as="h2" title="เข้าเล่น 777RUAY สล็อตออนไลน์ผ่านเบราว์เซอร์ได้ทั้ง iOS และ Android">
    <p class={body}>
      คนที่เคยเปลี่ยนโทรศัพท์หรือสลับไปใช้แท็บเล็ตแล้วต้องลงโปรแกรมใหม่คงรู้ว่าน่ารำคาญแค่ไหน เราจึงให้คุณเข้าเล่นผ่านเบราว์เซอร์ได้ทั้ง iOS และ Android แบบไม่ต้องโหลดแอป คุณเปิดเว็บหลักแล้วล็อกอินด้วยยูสและรหัสเดิมเพื่อเล่นต่อได้ทันทีโดยไม่ต้องสมัครซ้ำ ถ้าอยู่หน้าคอมก็เปิดบนจอใหญ่ได้เหมือนกัน ก่อนกรอกข้อมูลให้ตรวจชื่อเว็บบนแถบที่อยู่ให้ตรงและเก็บรหัสผ่านรวมถึง OTP ไว้เป็นความลับ เหมาะกับคนที่ชอบความคล่องตัวและเปลี่ยนอุปกรณ์ระหว่างวัน
    </p>
  </ContentBoxCyberCut>

  <ContentBox as="h2" title="รวมค่ายสล็อตออนไลน์ พร้อมกลไกเกมที่เลือกตามจังหวะของคุณได้">
    <p class={body}>ปัญหาของคนที่ชอบเปลี่ยนแนวเกมคือมักเจอเว็บที่มีตัวเลือกจำกัด เราจึงรวมหลายค่ายมาให้เลือกตามจังหวะและกติกาที่คุณถนัด</p>

    <FeatureHighlights items={slotHighlights} />

    <p class={`mt-5 ${body}`}>
      เกมที่ไม่มีฟรีสปินอย่าง Fortune Tiger เล่นคนละจังหวะกับเกมระบบร่วงหล่นอย่าง Sugar Rush คุณจึงลองดูกติกาก่อนเริ่ม แล้วเลือกเกมที่ลุ้นแบบที่ชอบได้ ส่วนคนชอบวงพิเศษมี Money Coming และคนชอบไวลด์ขยายมี Koi Gate
    </p>
  </ContentBox>

  <ProviderGrid />

  <ContentBoxSevenThreePremium as="h2" titleright="ระบบฝากถอนออโต้ปรับเครดิตให้เองตลอด 24 ชั่วโมง ไม่ต้องแนบสลิป">
    <Picture
      slot="left"
      src={imgAutoPay}
      alt={autoPayAlt}
      loading="lazy"
      fetchpriority="low"
      widths={[280, 380, 480, 600]}
      sizes="(max-width: 767px) calc(100vw - 96px), (max-width: 1279px) calc(40vw - 61px), 451px"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={70}
      class={slideFrame}
    />

    <p slot="right" class={body}>
      ความกังวลเรื่องโอนเงินแล้วต้องคอยแคปหน้าจอส่งให้พนักงานตรวจจะหมดไป เพราะระบบของเราปรับยอดเครดิตให้เอง โดยที่คุณไม่ต้องแนบสลิปยืนยันและไม่ต้องคอยแอดมินตอบรับ ไม่ว่าคุณจะเติมเครดิตตอนดึกหรือกดถอนยอดช่วงเช้าตรู่ ก็<a href="/วิธีฝากถอน/" class={inlineLink}>ทำรายการผ่านหน้าเว็บ</a>ได้ตลอด 24 ชั่วโมง การตัดขั้นตอนส่งหลักฐานทางแชททำให้ฟีลการเล่นต่อเนื่องขึ้นมาก เหมาะกับคนที่ต้องการจัดการเรื่องเงินด้วยตัวเองแบบไม่ต้องรอคิว
    </p>
  </ContentBoxSevenThreePremium>

  <ContentBoxSevenThreeCyberCut as="h2" titleright="เล่นสล็อตออนไลน์จบบนมือถือเครื่องเดียว ตั้งแต่สมัครจนถึงถอนเงิน">
    <Picture
      slot="left"
      src={imgMobile}
      alt={mobileAlt}
      loading="lazy"
      fetchpriority="low"
      widths={[280, 380, 480, 600]}
      sizes="(max-width: 767px) calc(100vw - 96px), (max-width: 1279px) calc(40vw - 51px), 461px"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={70}
      class={slideFrame}
    />

    <p slot="right" class={body}>
      หลายคนเคยหงุดหงิดกับการต้องเปิดคอมเพื่อสมัครสมาชิกแล้วย้ายมากดเติมเงินในโทรศัพท์ ที่นี่คุณจัดการทุกขั้นตอนบนมือถือเครื่องเดียวได้ ตั้งแต่กดสมัคร ฝากเครดิต เลือกค่ายเข้าปั่นสล็อตออนไลน์ ไปจนถึงกดถอนเงิน เรื่องเงินทำจากเครื่องเดียวกับที่เล่น คุณจึงไม่ต้องเปิดคอมเพิ่มเพื่อเติมหรือถอน
    </p>
  </ContentBoxSevenThreeCyberCut>

  <ContentBoxTwoCyberCut as="h2" title="ช่องทางติดต่อแอดมิน 777RUAY เมื่อพบปัญหาล็อกอินหรือรายการค้าง">
    <p slot="left" class={body}>
      เวลาเกิดเหตุขัดข้องแล้วไม่รู้จะถามใครคงทำให้คุณอารมณ์เสียได้ง่ายๆ เราจึงมีช่องทางติดต่อแอดมินไว้บนหน้าเว็บ เพื่อให้คุณขอความช่วยเหลือได้ตรงจุด หากคุณล็อกอินไม่ได้ ฝากแล้วเครดิตไม่ขึ้น หรือมีรายการค้าง ขอให้ระวังอย่าโอนเงินซ้ำเด็ดขาด ให้คุณรวบรวมช่วงเวลาที่ทำรายการและยอดเงิน แล้วแจ้งผ่านช่องทางบนหน้าเว็บเพื่อให้แอดมินตรวจสอบแก้ไข
    </p>

    <div slot="right" class={panel}>
      <p class={panelLabel}>ช่องทางติดต่อบนหน้าเว็บ</p>
      <a href="/line/" class={btnLine}>
        <span aria-hidden="true">💬</span>
        <span>ทักแอดมินทาง LINE</span>
      </a>
      <a href="/contact-us/" class={btnOutline}>
        <span aria-hidden="true">📞</span>
        <span>ดูช่องทางติดต่อทั้งหมด</span>
      </a>
      <span class="self-start rounded-full bg-[#0a1f5c] px-3 py-1 text-xs font-bold text-white">
        <span aria-hidden="true">🔒</span> ไม่ส่งรหัสผ่านหรือ OTP ให้ใคร
      </span>
    </div>
  </ContentBoxTwoCyberCut>

  <ContentBoxTwoPremium as="h2" title="เริ่มต้นสมัคร 777RUAY และเข้าสู่ระบบสำหรับสมาชิกเดิม">
    <p slot="left" class={body}>
      คนที่เพิ่งเข้าเว็บครั้งแรกอาจกังวลว่าขั้นตอนเปิดยูสจะซับซ้อน แต่ขั้นตอนไม่ยาก ผู้เล่นใหม่กด<a href="/register/" class={inlineLink}>สมัคร 777RUAY</a> แล้วกรอกข้อมูลตามที่ระบบแสดง ตรวจความถูกต้องก่อนยืนยัน ส่วนสมาชิกเดิมไปที่<a href="/ทางเข้า/" class={inlineLink}>ทางเข้า 777RUAY</a> แล้วล็อกอินด้วยยูสและรหัสเดิมได้เลย โดยไม่ต้องสมัครซ้ำ
    </p>

    <div slot="right" class={panel}>
      <span class={panelHint}>ผู้เล่นใหม่</span>
      <a href="/register/" class={btnPrimary}>
        <span aria-hidden="true">✨</span>
        <span>สมัครสมาชิก</span>
      </a>
      <span class={panelHint}>สมาชิกเดิม ใช้ยูสและรหัสเดิม</span>
      <a href="/login/" class={btnSecondary}>
        <span aria-hidden="true">🔑</span>
        <span>เข้าสู่ระบบ</span>
      </a>
    </div>
  </ContentBoxTwoPremium>

  <ContentBox>
    <p class={body}>
      <strong class={brandMark}>777RUAY</strong> ให้บริการสล็อตออนไลน์ผ่านเบราว์เซอร์บนมือถือและคอมพิวเตอร์ เรารวมเกมจาก PG Soft, Pragmatic Play, JILI และ Habanero คู่กับฝากถอนออโต้ซึ่งไม่ต้องส่งสลิปและเปิดใช้งานตลอด 24 ชั่วโมง ทุกขั้นตอนตั้งแต่เปิดยูสถึงถอนเครดิตจบในมือถือเครื่องเดียว พร้อมแอดมินบนหน้าเว็บคอยดูแล คุณสามารถกด<a href="/register/" class={inlineLink}>สมัคร</a>หรือ<a href="/login/" class={inlineLink}>เข้าสู่ระบบ</a>ได้ทันที
    </p>
  </ContentBox>

  <LatestWinners />

  <LoginRtpSection />

  <ReviewCardSumo2 />

  <Navfoot />
</MainLayout>
