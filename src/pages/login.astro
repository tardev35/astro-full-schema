---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementCyber.astro";
import CtaRedirect from "../components/CtaRedirect.astro";
import { pageGraph } from "../lib/schema";

const pageTitle = "เข้าสู่ระบบ AMBHENG88 | ปุ่มล็อกอินเข้าหน้าเมมเบอร์ สล็อตทรูวอลเล็ท";

const pageDescription =
  "หากคุณกำลังมองหาทางกลับเข้าหน้าเมมเบอร์แบบไม่ยุ่งยาก AMBHENG88 พร้อมมอบปุ่มเข้าสู่ระบบเพียงปุ่มเดียว เพื่อกลับไปหมุนสล็อตทรูมันนี่วอลเล็ทด้วยยูสเดิมได้ทันที";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เข้าสู่ระบบ", path: "/login" },
  ],
});

const targetUrl = "https://tinyurl.com/amb66tar";
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="เข้าสู่ระบบ AMBHENG88" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label="เข้าสู่ระบบ AMBHENG88"
        class="group relative mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#7d0b46]/70 bg-gradient-to-b from-[#ff74b6] via-[#ff2d8e] to-[#c20e6a] px-6 py-4 text-xl font-bold tracking-wide text-white shadow-[0_10px_30px_rgba(255,45,142,0.26)] transition-all duration-300 hover:scale-105 hover:border-[#ff2d8e] hover:shadow-[0_15px_40px_rgba(255,45,142,0.38)]">
        เข้าสู่ระบบ AMBHENG88
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="เข้าสู่ระบบ" />
</MainLayout>
