---
import { Image } from "astro:assets";
import Bg from "../assets/bg.jpg";
import "../styles/global.css";
import NavbarStyle6 from "../components/NavbarStyle11.astro";
import Footer from "../components/FooterPremiumSumo.astro";

const bannerImages = import.meta.glob<{ default: ImageMetadata }>("../assets/banner*.{png,webp,jpg,jpeg}", { eager: true });
const bannerPaths = Object.keys(bannerImages);
const preferredBannerPath = bannerPaths.find((path) => path.endsWith("banner1.webp"));
const webpBannerPath = bannerPaths.find((path) => path.endsWith(".webp"));
const mainBannerPath = preferredBannerPath ?? webpBannerPath ?? bannerPaths[0];
const mainBanner = mainBannerPath ? bannerImages[mainBannerPath].default : null;

const {
  title = "BABYSHARK88 สล็อตเว็บนอกตรงแท้จากต่างประเทศ แตกหนัก จ่ายจริง",
  description = "BABYSHARK88 สล็อตเว็บนอกตรงแท้ต่างประเทศ แตกหนัก ใช้ค่า RTP ตามลิขสิทธิ์ ระบบฝากถอน รองรับวอเล็ทเต็มระบบ ไม่ใช้บัญชีม้า สมัครง่าย",
  robots = "index, follow",
  ImageOg = "/slide3.webp",
} = Astro.props;

const currentPath = Astro.url.pathname;
const canonicalURL = new URL(currentPath, Astro.site);
const ogImageURL = new URL(ImageOg, Astro.site);
const ogSiteName = "BABYSHARK88";
---

<html lang="th">
  <head>
    <meta charset="utf-8" />
    <meta name="google-site-verification" content="THWudFWFF0XOm6rXgwUIGavBdxyu7lmo9oQ1XaoA15M" />
    <meta name="robots" content={robots} />
    <meta name="googlebot" content={robots} />
    <title>{title}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="preload" href="/fonts/kanit-v17-latin_thai-regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/kanit-v17-latin_thai-700.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/kanit-v17-latin_thai-600.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/genfavicon-32.png" sizes="32x32" />
    <link rel="icon" href="/genfavicon-16.png" sizes="16x16" />
    <link rel="apple-touch-icon" href="/apple-touch-icon-57x57.png" sizes="57x57" />
    <link rel="apple-touch-icon" href="/apple-touch-icon-114x114.png" sizes="114x114" />
    <link rel="apple-touch-icon" href="/apple-touch-icon-120x120.png" sizes="120x120" />
    <link rel="apple-touch-icon" href="/apple-touch-icon-180x180.png" sizes="180x180" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:site_name" content={ogSiteName} />
    <meta property="og:locale" content="th_TH" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <style is:global>
      body {
        background-size: cover;
        background-position: center;
        background-attachment: fixed;
        background-repeat: no-repeat;
        margin: 0;
        background-color: #ffffff;
        font-weight: 400;
        font-family: "Kanit", sans-serif !important;
        /* color: white; */
      }
    </style>
  </head>

  <body class="relative flex min-h-screen w-full flex-col">
    <Image
      src={Bg}
      alt="Website Background"
      loading="eager"
      widths={[412, 768, 1024, 1900]}
      sizes="100vw"
      format="avif"
      class="fixed inset-0 -z-50 h-full w-full object-cover"
      quality="low"
      decoding="sync"
    />

    <NavbarStyle6 />

    <div class="mb-2.5 flex w-full items-center justify-center">
      <Image
        src={mainBanner!}
        alt="BABYSHARK88 banner"
        loading="eager"
        fetchpriority="high"
        widths={[412, 768, 1900]}
        sizes="(max-width: 768px) 412px, 100vw"
        class="mx-auto h-auto w-full max-w-full object-contain shadow-xl"
        decoding="sync"
        format="avif"
        quality={60}
      />
    </div>

    <main class="w-full flex-1">
      <slot />
    </main>

    <Footer />
  </body>
</html>
