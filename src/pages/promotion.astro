---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";

import { Picture } from "astro:assets";

import pro1 from "../assets/slide1.png";
import pro2 from "../assets/slide2.png";
import pro3 from "../assets/slide3.png";
import pro4 from "../assets/slide4.png";
import { pageGraph } from "../lib/schema";

const pageTitle = "โปรโมชั่น - SUPERCLUB168 รวมโปรคืนยอดเล่นและแนะนำเพื่อน";

const pageHeading = "โปรโมชั่น SUPERCLUB168 รวมสิทธิ์และโบนัสของคลับไว้ในหน้าเดียว";

const pageDescription =
  "รวมโปรโมชั่น SUPERCLUB168 ทั้งคืนยอดเล่น แนะนำเพื่อน และสิทธิ์สมาชิกไว้ในหน้าเดียว ดูยอดรับ เงื่อนไข และรอบเวลาได้จากภาพทุกใบ แล้วเลือกใบที่ตรงกับสไตล์การเล่น";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: pro1.src,
});

const promoClass =
  "mx-auto h-auto w-full rounded-xl border border-[#0e2150] object-contain shadow-[0_10px_30px_rgba(247,208,70,0.16)] transition-all duration-300 hover:-translate-y-1 hover:border-[#f7d046]/55 hover:shadow-[0_15px_40px_rgba(247,208,70,0.28)]";
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageHeading} as="h1">
    <p class="mb-4 text-left text-base leading-relaxed">
      หากคุณกำลังมองหาโปรที่บอกยอดรับและเงื่อนไขไว้ครบตั้งแต่ก่อนกดสมัคร <strong class="text-[#ffe38a]">SUPERCLUB168</strong> รวมสิทธิ์ทั้งหมดของคลับไว้ในภาพด้านล่างนี้แล้ว
    </p>

    <p class="mb-8 text-left text-base leading-relaxed">
      ยอดรับ รอบเวลา และเงื่อนไขของแต่ละใบไม่เหมือนกัน เลือกใบที่ตรงกับงบและสไตล์การเล่นของคุณ แล้วสมัครยูสเดียวใช้ได้ทุกสิทธิ์ เพื่อประสบการณ์การเล่นที่คุ้มค่าและต่อเนื่องกว่าที่เคย
    </p>

    <div class="grid w-full grid-cols-1 gap-6 sm:grid-cols-2">
      <Picture
        src={pro1}
        alt="ภาพโปรโมชั่นพื้นทองประกาย โลโก้ SUPERCLUB168 มุมขวาบน หัวข้อ COMMISSION คืนทุกยอดเล่นตลอดทั้งวัน ตัวเลข 0.3% ขนาดใหญ่ ระบุเล่นถึง 50% ถอนได้เลย กดรับสิทธิ์ได้ที่หน้าเว็บก่อน 23.59 น. ของทุกวัน พร้อมข้อความ ยิ่งเล่นเยอะ ยิ่งได้เยอะ ด้านซ้ายเป็นพรีเซนเตอร์หญิงสวมชุดเลื่อมสีทอง"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class={promoClass}
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />

      <Picture
        src={pro2}
        alt="ภาพโปรโมชั่นแนะนำเพื่อนพื้นทองประกาย โลโก้ SUPERCLUB168 มุมซ้ายบน ข้อความ แนะนำเพื่อน รับโบนัส ตัวเลข 0.8% ขนาดใหญ่ และบรรทัดล่างระบุ สร้างรายได้ 100,000 ต่อเดือน ด้านขวาเป็นพรีเซนเตอร์หญิงสวมชุดเลื่อมสีทองพร้อมเหรียญทองลอยรอบภาพ"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class={promoClass}
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />

      <Picture
        src={pro3}
        alt="ภาพโปรโมชั่นพื้นทองประกาย โลโก้ SUPERCLUB168 มุมขวาบน ด้านซ้ายเรียงป้ายสี่ช่อง หวย บอล บาคาร่า สล็อต ข้อความใหญ่ด้านล่าง ครบจบในที่เดียว และแถบรายการ บอล คาสิโน สล็อต ยิงปลา ไก่ชน มวย ไฮโล รูเล็ต ด้านขวาเป็นพรีเซนเตอร์หญิงสวมชุดเลื่อมสีทอง"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class={promoClass}
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />

      <Picture
        src={pro4}
        alt="ภาพโปรโมชั่นหวยพื้นทองประกาย โลโก้ SUPERCLUB168 มุมซ้ายบน ข้อความ หวย อัตราจ่ายที่ดีที่สุด ระบุ 3 ตัว บาทละ 1000 และ 2 ตัว บาทละ 100 พร้อมบรรทัด ถูกตรง จ่ายจริง รับเงินรางวัลหลักล้าน และ ครบจบเรื่องหวยในเว็บเดียว รัฐบาล ลาว ฮานอย หุ้น ยี่กี่ ด้านขวาเป็นพรีเซนเตอร์หญิงสวมชุดเลื่อมสีทอง"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class={promoClass}
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />
    </div>

    <div class="mt-12 flex justify-center pb-4">
      <a
        href="/register"
        class="flex items-center justify-center rounded-lg border border-[#c99a17] bg-gradient-to-r from-[#ffe89a] via-[#f7d046] to-[#c99a17] px-10 py-3.5 text-lg font-black text-[#03091f] shadow-[0_10px_30px_rgba(247,208,70,0.24)] transition-transform hover:scale-105 hover:shadow-[0_15px_40px_rgba(247,208,70,0.34)]">
        สมัครสมาชิก SUPERCLUB168
      </a>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
