---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-xl sm:text-2xl md:text-3xl" : "text-lg sm:text-xl md:text-2xl";
---

<section class="my-10 flex w-full justify-center px-4 font-sans">
  <div
    class="relative isolate w-full max-w-[1400px] rounded-2xl border-2 border-[#2fe35f]/30 bg-gradient-to-b from-[#0c1f13]/95 to-[#050f09]/95 p-8 pt-36 text-left text-base leading-relaxed text-[#ddf3e2] shadow-[0_10px_30px_rgba(47,227,95,0.18)] md:pt-28">
    <div aria-hidden="true" class="pointer-events-none absolute -top-16 -right-10 -z-10 h-40 w-40 rounded-full bg-[#2fe35f]/25 blur-[60px]"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -bottom-16 -left-10 -z-10 h-40 w-40 rounded-full bg-[#0d4a26]/60 blur-[60px]"></div>

    {
      title && (
        <div class="absolute -top-6 left-1/2 flex w-[92%] max-w-2xl -translate-x-1/2 items-center justify-center gap-2 rounded-lg border-2 border-[#2fe35f]/40 bg-[#0a1a10] px-4 py-2.5 text-center shadow-[0_10px_30px_rgba(47,227,95,0.24)] sm:px-8">
          <span aria-hidden="true" class="shrink-0 text-[#f0c43a]">
            ✦
          </span>
          <HeadingTag class={`min-w-0 bg-gradient-to-r from-[#7bff9f] via-[#2fe35f] to-[#f0c43a] bg-clip-text ${headingSize} leading-normal font-black tracking-tight text-transparent uppercase`}>{title}</HeadingTag>
          <span aria-hidden="true" class="shrink-0 text-[#f0c43a]">
            ✦
          </span>
        </div>
      )
    }

    <slot />
  </div>
</section>
