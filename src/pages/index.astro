              <div class="rounded-xl border border-white/5 bg-white/5 px-3.5 py-2.5 transition-colors hover:border-cyan-400/40 hover:bg-white/10">
                <div class="flex items-center justify-between text-sm">
                  <span class="flex items-center gap-2 font-bold text-white">
                    <span class="w-5 text-center">{p.rank}</span> {p.name}
