---
const providers = [
  { name: "PG SOFT", desc: "สล็อตกราฟิก 3D เวอร์ชั่นใหม่ เชื่อมตรงจากค่ายแบบลิขสิทธิ์แท้ อัตราการจ่ายเป็นไปตามที่ค่ายกำหนด", tag: "ยอดนิยม", icon: "🎨" },
  { name: "Joker Gaming", desc: "ค่ายสล็อตคลาสสิก มีเกมโรม่าและเกมรอบสั้นที่คุ้นเคย เล่นได้ทันทีโดยไม่ต้องศึกษานาน", tag: "คลาสสิก", icon: "🃏" },
  { name: "Pragmatic Play", desc: "สล็อตฟีเจอร์หลายชั้น ทั้งตัวคูณรางวัลและโบนัสในเกม รายละเอียดต่างกันไปตามแต่ละเกม", tag: "ระดับสากล", icon: "💠" },
  { name: "ยิงปลา", desc: "เกมเลือกเป้าหมายและจังหวะยิงด้วยตัวคุณเอง มีหลายห้องให้เลือกตามงบที่ตั้งไว้", tag: "เลือกเป้าเอง", icon: "🎯" },
  { name: "กีฬา", desc: "ติดตามการแข่งขันและเดิมพันตามแมตช์ที่เปิดให้บริการ ดูราคาและผลได้จากหน้าเดียว", tag: "ตามแมตช์", icon: "⚽" },
  { name: "คาสิโน", desc: "เกมโต๊ะและคาสิโนสดสำหรับคนที่ชอบบรรยากาศดีลเลอร์จริง ตรวจสอบกติกาแต่ละโต๊ะก่อนเริ่ม", tag: "คาสิโนสด", icon: "🎲" },
  { name: "หวย", desc: "สำหรับคนที่สนใจการออกรางวัล ดูอัตราจ่ายและรอบที่เปิดรับได้จากระบบสมาชิก", tag: "ออกรางวัล", icon: "🎟️" },
];
---

<section aria-label="ค่ายเกมและหมวดเกมที่ VODKAFUN รวมไว้ให้ครบ" class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-6 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#f3ffe9] via-[#c8fc04] to-[#3fc20a] bg-clip-text text-3xl leading-normal font-black tracking-widest text-transparent uppercase">ค่ายเกมและหมวดเกมที่ VODKAFUN รวมไว้ให้ครบ</p>
    <div aria-hidden="true" class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#c8fc04] to-transparent"></div>
  </div>

  <p class="mb-8 text-left text-base leading-relaxed text-[#d9f7d0]">
    VODKAFUN รวมเกมห้าหมวดไว้ในบัญชีเดียว ทั้งสล็อต ยิงปลา กีฬา คาสิโน และหวย คุณเลือกค่ายหรือหมวดที่สนใจจากการ์ดด้านล่างได้เลย แต่ละหมวดมีกติกาและเงื่อนไขของตัวเอง ควรอ่านให้ครบก่อนเริ่มเล่นทุกครั้ง
  </p>

  <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4 lg:gap-5 xl:grid-cols-7">
    {
      providers.map((provider) => (
        <a
          href="/register/"
          class="group relative flex flex-col items-center justify-center overflow-hidden rounded-2xl border border-[#1d5c22] bg-[#06230a] p-5 shadow-[0_10px_30px_rgba(200,252,4,0.14)] transition-all duration-300 hover:-translate-y-2 hover:border-[#c8fc04]/55 hover:bg-[#0b3a10] hover:shadow-[0_15px_40px_rgba(200,252,4,0.28)]">
          <div aria-hidden="true" class="pointer-events-none absolute inset-0 bg-[#c8fc04]/8 opacity-0 transition-opacity duration-300 group-hover:opacity-100" />

          <div class="absolute top-2 right-2 z-10 rounded-full bg-gradient-to-r from-[#e6ff6a] via-[#c8fc04] to-[#7ee000] px-2 py-0.5 text-[9px] font-black tracking-wide whitespace-nowrap text-[#0b2a05] shadow-sm transition-transform duration-300 group-hover:scale-110">
            {provider.tag}
          </div>

          <div aria-hidden="true" class="mb-3 text-4xl transition-transform duration-300 group-hover:scale-125 group-hover:rotate-3">
            {provider.icon}
          </div>
          <p class="text-center text-sm font-black text-[#e6ff6a] transition-colors group-hover:text-[#f3ffe9]">{provider.name}</p>
          <p class="mt-1 text-center text-[10px] text-[#a9d9a0]">{provider.desc}</p>

          <span class="relative z-10 mt-4 block w-full rounded-full border border-[#1d5c22] bg-[#0b3a10] py-1.5 text-center text-[11px] font-bold text-[#e6ffcc] shadow-inner transition-colors duration-300 group-hover:border-transparent group-hover:bg-gradient-to-r group-hover:from-[#e6ff6a] group-hover:via-[#c8fc04] group-hover:to-[#7ee000] group-hover:text-[#0b2a05]">
            สมัครเข้าเล่น
          </span>
        </a>
      ))
    }
  </div>
</section>
