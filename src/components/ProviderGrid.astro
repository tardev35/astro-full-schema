---
const providers = [
  { name: "PG Soft", desc: "เกมลิขสิทธิ์แท้จากผู้พัฒนาโดยตรง ค่า RTP ตรงตามที่ค่ายตั้งไว้ เลือกธีมและโบนัสที่ถนัดได้เอง", tag: "ลิขสิทธิ์แท้", icon: "🎰" },
  { name: "Joker", desc: "ค่ายวงล้อคลาสสิกที่คนไทยคุ้นมือ เข้าเล่นต่อจากยูสเดิมได้ทุกเวลา ไม่ต้องเปิดบัญชีใหม่", tag: "ลิขสิทธิ์แท้", icon: "🃏" },
  { name: "Pragmatic Play", desc: "ค่ายใหญ่ระดับอินเตอร์ จังหวะเกมนิ่ง ฟีเจอร์แน่น สลับเข้ามาเล่นด้วยเครดิตชุดเดิมได้เลย", tag: "ลิขสิทธิ์แท้", icon: "🎲" },
  { name: "JILI", desc: "ค่ายที่มาแรงฝั่งเอเชีย มีฟีเจอร์โบนัสให้ไล่เก็บ เหมาะกับคนที่เล่นเป็นรอบสั้นระหว่างวัน", tag: "ลิขสิทธิ์แท้", icon: "🍀" },
  { name: "ฝากถอนออโต้", desc: "ส่งรายการฝากถอนและเช็กสถานะได้จากหน้าเมมเบอร์จุดเดียว ก่อนกลับไปเล่นสล็อตต่อ", tag: "ระบบออโต้", icon: "⚡" },
  { name: "หน้าเมมเบอร์", desc: "รวมเครดิต โปรโมชั่น ประวัติรายการ และทางเข้าเกมจากหลายค่ายไว้ในหน้าเดียว", tag: "จุดรวมข้อมูล", icon: "👤" },
  { name: "เล่นผ่านมือถือ", desc: "เปิดผ่านเบราว์เซอร์ได้เลย ไม่ต้องโหลดapp ล็อกอินด้วยยูสเดิมแล้วเข้าเกมต่อจากเครื่องเดิม", tag: "ใช้งานผ่านเว็บ", icon: "📱" },
];
---

<section aria-label="ค่ายเกมลิขสิทธิ์แท้และระบบออโต้ที่ OSIRIS168 รวมไว้ในยูสเดียว" class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#4ff0bb] via-[#f8ecc9] to-[#e8b52c] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      ค่ายเกมลิขสิทธิ์แท้และระบบออโต้ที่ <span class="text-[#e8b52c]">OSIRIS168</span> รวมไว้ในยูสเดียว
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#e8b52c] to-transparent"></div>
  </div>

  <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4 lg:gap-5 xl:grid-cols-7">
    {
      providers.map((provider) => (
        <a
          href="/register"
          class="group relative flex flex-col items-center justify-center overflow-hidden rounded-2xl border border-[#064c39] bg-[#0f241d] p-5 shadow-[0_10px_30px_rgba(18,196,143,0.14)] transition-all duration-300 hover:-translate-y-2 hover:border-[#12c48f]/60 hover:bg-[#123128] hover:shadow-[0_15px_40px_rgba(18,196,143,0.28)]">
          <div class="pointer-events-none absolute inset-0 bg-[#12c48f]/8 opacity-0 transition-opacity duration-300 group-hover:opacity-100" />

          <div class="absolute top-2 right-2 z-10 rounded-full bg-gradient-to-r from-[#ffdd8a] via-[#e8b52c] to-[#8a6314] px-2 py-0.5 text-[9px] font-black tracking-wide whitespace-nowrap text-[#0a1a15] shadow-sm transition-transform duration-300 group-hover:scale-110">
            {provider.tag}
          </div>

          <div aria-hidden="true" class="mb-3 text-4xl transition-transform duration-300 group-hover:scale-125 group-hover:rotate-3">
            {provider.icon}
          </div>
          <p class="text-center text-sm font-black text-[#f8ecc9] transition-colors group-hover:text-[#ffdd8a]">{provider.name}</p>
          <p class="mt-1 text-center text-[10px] text-[#b9d6c9]">{provider.desc}</p>

          <span class="relative z-10 mt-4 block w-full rounded-full border border-[#064c39] bg-[#050d0b] py-1.5 text-center text-[11px] font-bold text-[#b9d6c9] shadow-inner transition-colors duration-300 group-hover:border-[#12c48f]/60 group-hover:bg-gradient-to-r group-hover:from-[#4ff0bb] group-hover:via-[#12c48f] group-hover:to-[#0a8f68] group-hover:text-[#03251c]">
            สมัครเข้าเล่น
          </span>
        </a>
      ))
    }
  </div>
</section>
