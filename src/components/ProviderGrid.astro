---
const providers = [
  { name: "เติมผ่านทรูมันนี่วอลเล็ท", desc: "เติมยอดเข้าสู่ยูสเดิมแล้วเลือกเกมสล็อตต่อได้ทันที ไม่ต้องสลับช่องทางหรือสมัครยูสใหม่", tag: "ยูสเดียว", icon: "👛" },
  { name: "เติม ฝาก ถอนออโต้", desc: "ระบบประมวลผลอัตโนมัติ ไม่ได้ใช้แอดมินตรวจทีละยอด ส่งคำขอแล้วติดตามสถานะได้จากระบบ", tag: "ออโต้ไว", icon: "⚡" },
  { name: "ไม่มีขั้นต่ำตั้งแต่รายการแรก", desc: "ขอบเขตของเงื่อนไขไม่มีขั้นต่ำระบุไว้ในคู่มือสมาชิก ควรอ่านก่อนทำรายการทุกครั้ง", tag: "อ่านเงื่อนไข", icon: "💳" },
  { name: "ใช้งานต่อเนื่อง 24 ชั่วโมง", desc: "รองรับทั้งมือถือและเว็บเบราว์เซอร์ ความเร็วจริงยังขึ้นอยู่กับอุปกรณ์และเครือข่ายของผู้ใช้", tag: "ทุกช่วงเวลา", icon: "🕐" },
  { name: "เกมสล็อตหลายสไตล์", desc: "จัดกลุ่มตามรูปแบบการเล่นได้หลายแบบ เลือกเกมให้เหมาะกับเครื่องเพื่อให้หมุนได้ลื่นกว่าเดิม", tag: "เลือกอิสระ", icon: "🎰" },
  { name: "จ่ายเต็มทุกบาท", desc: "ชนะเท่าไหร่จ่ายหมด ถอนไม่จำกัดวงเงินต่อวัน และไม่มีการหักค่าธรรมเนียมจากยอดที่ถอน", tag: "ไม่หักค่าธรรมเนียม", icon: "💰" },
  { name: "ดูแลข้อมูลสมาชิก", desc: "ใช้ข้อมูลเท่าที่จำเป็นต่อการสร้างบัญชีและยืนยันตัวตน ตั้งรหัสผ่านที่คาดเดายากไว้เสมอ", tag: "ปลอดภัย", icon: "🔐" },
];
---

<section aria-label="จุดเด่นของ AMBHENG88 สล็อตทรูมันนี่วอลเล็ท" class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#ff74b6] via-[#ff2d8e] to-[#ffe814] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      สิ่งที่ <span class="text-[#ffe814]">AMBHENG88</span> รวมไว้ในยูสเดียว
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#ff2d8e] to-transparent"></div>
  </div>

  <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4 lg:gap-5 xl:grid-cols-7">
    {
      providers.map((provider) => (
        <a
          href="/register"
          class="group relative flex flex-col items-center justify-center overflow-hidden rounded-2xl border border-[#4a1030] bg-[#170512] p-5 shadow-[0_10px_30px_rgba(255,45,142,0.14)] transition-all duration-300 hover:-translate-y-2 hover:border-[#ff2d8e]/55 hover:bg-[#280a1c] hover:shadow-[0_15px_40px_rgba(255,45,142,0.28)]">
          <div class="pointer-events-none absolute inset-0 bg-[#ffe814]/6 opacity-0 transition-opacity duration-300 group-hover:opacity-100" />

          <div class="absolute top-2 right-2 z-10 rounded-full bg-gradient-to-r from-[#fff27a] via-[#ffe814] to-[#c9a800] px-2 py-0.5 text-[9px] font-black tracking-wide whitespace-nowrap text-[#170512] shadow-sm transition-transform duration-300 group-hover:scale-110">
            {provider.tag}
          </div>

          <div aria-hidden="true" class="mb-3 text-4xl transition-transform duration-300 group-hover:scale-125 group-hover:rotate-3">
            {provider.icon}
          </div>
          <p class="text-center text-sm font-black text-[#ffe814] transition-colors group-hover:text-[#fff27a]">{provider.name}</p>
          <p class="mt-1 text-center text-[10px] text-[#c49ab6]">{provider.desc}</p>

          <span class="relative z-10 mt-4 block w-full rounded-full border border-[#7d0b46] bg-[#280a1c] py-1.5 text-center text-[11px] font-bold text-[#ff74b6] shadow-inner transition-colors duration-300 group-hover:border-transparent group-hover:bg-gradient-to-r group-hover:from-[#ff74b6] group-hover:via-[#ff2d8e] group-hover:to-[#c20e6a] group-hover:text-[#170512]">
            สมัครเข้าเล่น
          </span>
        </a>
      ))
    }
  </div>
</section>
