---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";

import { Picture } from "astro:assets";

import pro1 from "../assets/slide1.png";
import pro2 from "../assets/slide2.png";
import pro3 from "../assets/slide3.png";
import pro4 from "../assets/slide4.png";
import { pageGraph } from "../lib/schema";

const pageTitle = "โปรโมชั่น RIEL38 รวมภาพโปรสมาชิกใหม่และสมาชิกเดิม เว็บสล็อตมาใหม่";

const pageHeading = "โปรโมชั่น RIEL38 รวมสิทธิ์สำหรับสมาชิก";

const pageDescription =
  "รวมภาพโปรโมชั่น RIEL38 ทั้งโปรฝาก 39 รับรวม 69 โปรต้อนรับสมาชิกใหม่ และสิทธิ์ของสมาชิกเดิม เงื่อนไขระบุไว้บนภาพทุกใบ สมัครยูสเดียวรับสิทธิ์จากหน้าเมมเบอร์";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: pro1.src,
});

const promoClass =
  "mx-auto h-auto w-full rounded-xl border border-[#f9a8d4] object-contain shadow-[0_10px_30px_rgba(236,72,153,0.16)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#ec4899]/60 hover:shadow-[0_15px_40px_rgba(236,72,153,0.26)]";
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageHeading} as="h1">
    <p class="mb-4 text-left text-base leading-relaxed text-[#5b2140]">
      หากคุณกำลังมองหาโปรที่ดูจบได้ในหน้าเดียว <strong class="text-[#9d174d]">RIEL38</strong> รวมภาพโปรของสมาชิกไว้ให้ครบ ตั้งแต่โปรฝาก 39 รับรวม 69 ไปจนถึงสิทธิ์ของสมาชิกเดิม
    </p>

    <p class="mb-8 text-left text-base leading-relaxed text-[#5b2140]">
      ยอดรับและเงื่อนไขของแต่ละใบไม่เหมือนกัน ระบุไว้บนภาพแล้วทุกใบ เลือกใบที่ตรงกับงบของคุณ แล้วสมัครยูสเดียวรับสิทธิ์ต่อจากหน้าเมมเบอร์ได้เลย
    </p>

    <div class="grid w-full grid-cols-1 gap-6 sm:grid-cols-2">
      <Picture
        src={pro1}
        alt="ภาพโปรโมชั่น RIEL38 ข้อความ AI หลังบ้าน RIEL38 ช่วยจัดข้อมูลเกม RTP โบนัส เครดิต ด้านซ้ายเป็นหุ่นยนต์สีชมพูและหน้าจอมือถือที่ไล่รายการ ข้อมูลเกม RTP โบนัส และเครดิต ด้านล่างมีสี่การ์ดว่า รวมข้อมูลเกม เช็ก RTP ง่าย ติดตามโบนัส และสรุปเครดิตไว ด้านขวาเป็นพรีเซนเตอร์หญิงสวมเสื้อไหมพรมสีชมพู"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class={promoClass}
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />

      <Picture
        src={pro2}
        alt="ภาพโปรโมชั่น RIEL38 ข้อความ กว่า 2,000 เกม รวม 30+ ค่ายดัง พร้อมปุ่มใหญ่ว่า ทดลองเล่นฟรี ด้านหลังเป็นภาพหน้าล็อบบี้เกมสล็อต ด้านล่างเรียงโลโก้ค่าย PG PRAGMATIC PLAY JILI HABANERO JOKER และข้อความ และอีกมากมาย ด้านขวาเป็นพรีเซนเตอร์หญิงชี้มาที่กล้อง"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class={promoClass}
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />

      <Picture
        src={pro3}
        alt="ภาพโปรโมชั่น RIEL38 ข้อความ เล่นได้ทุกอุปกรณ์ Mobile Tablet PC เข้าสู่ระบบด้วยยูสเดิม แสดงหน้าจอมือถือ คอมพิวเตอร์ และแท็บเล็ตที่เปิดหน้าล็อบบี้เกมของ RIEL38 พร้อมกัน มีมาสคอตกระต่ายสีชมพูยืนอยู่ข้างหน้าจอบนพื้นหลังสีพาสเทล"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class={promoClass}
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />

      <Picture
        src={pro4}
        alt="ภาพโปรโมชั่น RIEL38 ข้อความ Smart Wallet สลับเกมหลายค่าย เครดิตไม่สะดุด ตรงกลางเป็นกระเป๋าเงินสามมิติสีชมพู ล้อมด้วยวงกลม SLOT LIVE CASINO FISHING CRASH และ SPORTS ด้านล่างมีสามป้ายว่า รวมเครดิตไว้จุดเดียว เข้าเกมต่อเนื่อง และสลับค่ายง่าย"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class={promoClass}
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />
    </div>

    <div class="mt-12 flex justify-center pb-4">
      <a
        href="/register"
        class="flex items-center justify-center rounded-lg border border-[#db2777]/45 bg-gradient-to-r from-[#f472b6] via-[#ec4899] to-[#a855f7] px-10 py-3.5 text-lg font-black text-white shadow-[0_10px_30px_rgba(236,72,153,0.28)] transition-transform hover:scale-105 hover:shadow-[0_15px_40px_rgba(236,72,153,0.35)]">
        สมัครสมาชิก RIEL38
      </a>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
