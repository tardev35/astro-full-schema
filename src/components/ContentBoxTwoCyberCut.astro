---
export interface Props {
  title?: string;
  titleleft?: string;
  titleright?: string;
  label?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, titleleft, titleright, label, as } = Astro.props;
const TitleTag = as ?? "p";
const intro = Astro.slots.has("default") ? (await Astro.slots.render("default")).trim() : "";

const sectionLabel = label ?? title ?? titleleft ?? titleright ?? "ข้อมูลประกอบ";
---

<section aria-label={sectionLabel} class="mx-auto mb-6 w-full max-w-7xl px-4 font-sans">
  <div
    class="relative isolate w-full border border-[#2fe35f]/30 bg-[#0a1a10]/92 p-8 text-[#ddf3e2] shadow-[0_10px_30px_rgba(47,227,95,0.18)] backdrop-blur-md transition-all duration-300 hover:border-[#2fe35f]/55 hover:shadow-[0_15px_40px_rgba(47,227,95,0.28)]"
    style="clip-path: polygon(30px 0, 100% 0, 100% calc(100% - 30px), calc(100% - 30px) 100%, 0 100%, 0 30px);">
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-[2px] w-24 bg-gradient-to-r from-[#2fe35f] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-[2px] w-24 bg-gradient-to-l from-[#f0c43a] to-transparent"></div>
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-16 w-[2px] bg-gradient-to-b from-[#2fe35f] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-16 w-[2px] bg-gradient-to-t from-[#f0c43a] to-transparent"></div>

    {
      title && (
        <TitleTag class="mb-4 bg-gradient-to-r from-[#7bff9f] via-[#2fe35f] to-[#f0c43a] bg-clip-text text-center text-2xl leading-normal font-black text-transparent uppercase">
          {title}
        </TitleTag>
      )
    }

    {intro && <div class="mb-8 text-left text-base leading-relaxed text-[#ddf3e2]" set:html={intro} />}

    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <article class="relative flex flex-col gap-4 text-left text-base leading-relaxed text-[#ddf3e2]">
        {
          titleleft && (
            <p class="flex items-center gap-2 border-b border-[#0b6b34]/60 pb-2 text-xl leading-normal font-black text-[#2fe35f] uppercase">
              <span aria-hidden="true" class="inline-block h-2 w-2 shrink-0 bg-[#2fe35f] shadow-[0_0_5px_rgba(47,227,95,0.7)]" /> {titleleft}
            </p>
          )
        }
        <slot name="left" />
      </article>

      <article class="relative flex flex-col gap-4 text-left text-base leading-relaxed text-[#ddf3e2] md:border-l md:border-[#0b6b34]/60 md:pl-8">
        {
          titleright && (
            <p class="flex items-center gap-2 border-b border-[#0b6b34]/60 pb-2 text-xl leading-normal font-black text-[#2fe35f] uppercase">
              <span aria-hidden="true" class="inline-block h-2 w-2 shrink-0 bg-[#f0c43a] shadow-[0_0_5px_rgba(240,196,58,0.8)]" /> {titleright}
            </p>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
