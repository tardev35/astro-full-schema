---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementCyber.astro";

import { Picture } from "astro:assets";

import pro1 from "../assets/slide1.png";
import pro2 from "../assets/slide2.png";
import pro3 from "../assets/slide3.png";
import pro4 from "../assets/slide4.png";
import { pageGraph } from "../lib/schema";

const pageTitle = "โปรโมชั่น DOLLAR789 รวมภาพโปรคาสิโนสด บาคาร่า และโปรสมาชิกใหม่";

const pageHeading = "โปรโมชั่น DOLLAR789";

const pageDescription =
  "รวมภาพโปรโมชั่น DOLLAR789 ไว้ในหน้าเดียว ทั้งโปรสมาชิกใหม่ คาสิโนสด บาคาร่า แทงบอล และระบบฝากถอนออโต้ ดูยอดรับและเงื่อนไขบนภาพก่อนกดสมัครสมาชิกเพื่อใช้สิทธิ์";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: pro1.src,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageHeading} as="h1">
    <p class="mb-4 text-left text-base leading-relaxed text-[#e7dcf7]">
      หากคุณกำลังมองหาความคุ้มค่าที่ไม่เหมือนใคร <strong class="text-[#f5c542]">DOLLAR789</strong> พร้อมมอบโปรโมชั่นและโบนัสที่หลากหลาย
      ทั้งโปรสมาชิกใหม่ คาสิโนสด บาคาร่า และแทงบอล รวมไว้ให้เลือกครบในหน้าเดียว
    </p>

    <p class="mb-8 text-left text-base leading-relaxed text-[#e7dcf7]">
      ทุกรายการระบุยอดรับ เงื่อนไขเทิร์น และช่วงเวลาที่ใช้ได้ไว้บนภาพอย่างชัดเจน คุณจึงเลือกโปรที่ตรงกับสไตล์การเล่นและงบของตัวเองได้ทันที
      สมัครเพียงครั้งเดียวใช้ได้ทุกสิทธิ์ พร้อมระบบฝากถอนออโต้และหน้าเมมเบอร์ที่ติดตามเครดิตกับโปรที่ใช้อยู่ได้ตลอดเวลา
      เพื่อประสบการณ์การเล่นที่คุ้มค่าและต่อเนื่องกว่าที่เคย
    </p>

    <div class="grid w-full grid-cols-1 gap-6 sm:grid-cols-2">
      <Picture
        src={pro1}
        alt="ภาพโปรโมชั่น DOLLAR789 โทนม่วงทอง ข้อความว่า สมัครสมาชิกใหม่ ลุ้นรับของรางวัลใหญ่ และ คาสิโนสด บาคาร่า เว็บใหญ่มั่นคง พร้อมป้ายเขียนว่า โปรสมาชิกใหม่ ระบบออโต้ 24 ชม. เล่นง่าย ถอนไว และ ลุ้นทองคำ 1 บาท ในภาพมีวงล้อรางวัลสีทอง เครื่องประดับทองและทองแท่ง ด้านข้างเป็นพรีเซนเตอร์หญิงสวมชุดสีม่วง มุมภาพเป็นโลโก้ DOLLAR789 สีทอง"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class="mx-auto h-auto w-full rounded-xl border border-[#3b1a63] object-contain shadow-[0_10px_30px_rgba(168,85,247,0.16)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#a855f7]/50 hover:shadow-[0_15px_40px_rgba(168,85,247,0.26)]"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />

      <Picture
        src={pro2}
        alt="ภาพโปรโมชั่น DOLLAR789 พื้นม่วงเข้ม หัวเรื่องว่า คาสิโนสด บาคาร่า เว็บใหญ่มั่นคง ถัดลงมาเขียนว่า สมัครใหม่ รับโปรสมาชิก ระบบออโต้ 24 ชม. เล่นง่ายบนมือถือ และ สายบาคาร่า สายคาสิโนสด เข้าใช้งานสะดวก ด้านหน้าเป็นพรีเซนเตอร์หญิงชุดสีทองถือไพ่เอซกับไพ่เค ล้อมด้วยลูกเต๋าสีม่วงและชิปคาสิโน มุมภาพเป็นโลโก้ DOLLAR789 สีทอง"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class="mx-auto h-auto w-full rounded-xl border border-[#3b1a63] object-contain shadow-[0_10px_30px_rgba(168,85,247,0.16)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#a855f7]/50 hover:shadow-[0_15px_40px_rgba(168,85,247,0.26)]"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />

      <Picture
        src={pro3}
        alt="ภาพโปรโมชั่น DOLLAR789 พื้นม่วงนีออน หัวเรื่องว่า แทงบอลออนไลน์ ถัดลงมาเขียนว่า คาสิโนสด บาคาร่าสด เว็บใหญ่มั่นคง สมัครรับโปรสมาชิกใหม่ เริ่มต้น 10 บาท และ เล่นมัน เชียร์สด ฝากถอนลื่น ด้านหน้าเป็นพรีเซนเตอร์หญิงสวมชุดวอร์มสีม่วง ข้างกันเป็นลูกฟุตบอลเรืองแสงและกองเหรียญทอง มุมภาพเป็นโลโก้ DOLLAR789 สีทอง"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class="mx-auto h-auto w-full rounded-xl border border-[#3b1a63] object-contain shadow-[0_10px_30px_rgba(168,85,247,0.16)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#a855f7]/50 hover:shadow-[0_15px_40px_rgba(168,85,247,0.26)]"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />

      <Picture
        src={pro4}
        alt="ภาพโปรโมชั่น DOLLAR789 พื้นม่วงเข้ม หัวเรื่องว่า ฝาก-ถอน ระบบออโต้ ถัดลงมาเขียนว่า DOLLAR789 คาสิโนสด บาคาร่า เว็บใหญ่มั่นคง สมัครรับโปรสมาชิกใหม่ รวดเร็วตลอด 24 ชม. Auto Wallet เล่นง่าย บริการ 24 ชั่วโมง และ มั่นคง ปลอดภัย จ่ายจริง 100% ในภาพมีกระเป๋าหนังสีน้ำตาลใส่บัตรวางคู่กับเหรียญทอง ด้านข้างเป็นพรีเซนเตอร์หญิงสวมสูทสีม่วง มุมภาพเป็นโลโก้ DOLLAR789 สีทอง"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class="mx-auto h-auto w-full rounded-xl border border-[#3b1a63] object-contain shadow-[0_10px_30px_rgba(168,85,247,0.16)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#a855f7]/50 hover:shadow-[0_15px_40px_rgba(168,85,247,0.26)]"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />
    </div>

    <div class="mt-12 flex justify-center pb-4">
      <a
        href="/register"
        class="flex items-center justify-center rounded-lg border border-[#a855f7]/40 bg-gradient-to-r from-[#ffe9a8] via-[#f5c542] to-[#ffd75e] px-10 py-3.5 text-lg font-black text-[#150826] shadow-[0_10px_30px_rgba(168,85,247,0.24)] transition-transform hover:scale-105 hover:shadow-[0_15px_40px_rgba(245,197,66,0.30)]">
        สมัครสมาชิก DOLLAR789
      </a>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
