---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement6.astro";
import CtaRedirect from "../components/CtaRedirect.astro";
import { pageGraph } from "../lib/schema";

const pageTitle = "เข้าสู่ระบบ TGA99 | ทางเข้าหน้าสมาชิก สล็อต ฝากถอนออโต้";

const pageDescription =
  "หน้าเข้าสู่ระบบ TGA99 มีปุ่มเดียวสำหรับกดกลับเข้ายูสเดิม ใช้ยูสและรหัสผ่านชุดเดิมได้ทุกเครื่อง เล่นสล็อตต่อบนมือถือ iOS และ Android ผ่านเบราว์เซอร์ ไม่ต้องโหลด";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เข้าสู่ระบบ", path: "/login" },
  ],
});

const targetUrl = "https://yoalink.com/22hs";
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="เข้าสู่ระบบ TGA99" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label="เข้าสู่ระบบ TGA99"
        class="group relative mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-full bg-gradient-to-r from-[#e061e3] via-[#c13fc4] to-[#9c2193] px-6 py-4 text-xl font-bold tracking-wide text-white shadow-[0_0_15px_rgba(193,63,196,0.45)] transition-all duration-300 hover:scale-105 hover:brightness-110 hover:shadow-[0_15px_40px_rgba(193,63,196,0.45)]">
        เข้าสู่ระบบ TGA99
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="เข้าสู่ระบบ" />
</MainLayout>
