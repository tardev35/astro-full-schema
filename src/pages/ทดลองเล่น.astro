---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement2.astro";

import { Picture } from "astro:assets";
import { itemList, pageGraph, schemaCtx } from "../lib/schema";
import image1 from "../assets/gamedemo7.webp";
import image2 from "../assets/gamedemo8.webp";
import image3 from "../assets/gamedemo9.webp";
import image4 from "../assets/gamedemo10.webp";
import image5 from "../assets/gamedemo11.webp";
import image6 from "../assets/gamedemo12.webp";
import image7 from "../assets/gamedemo13.webp";
import image8 from "../assets/gamedemo14.webp";
import image9 from "../assets/gamedemo15.webp";
import image10 from "../assets/gamedemo16.webp";
import image11 from "../assets/gamedemo17.webp";
import image12 from "../assets/gamedemo18.webp";

const demoGames = [
  { name: "AskmeSlot", src: image1, alt: "แบนเนอร์ค่าย askmeslot โลโก้โพดำสีทองที่มีสัญลักษณ์ไพ่อยู่ข้างใน คู่กับตัวการ์ตูนเด็กชายสวมหมวกแดงติดดาว กางแขนวิ่งบนถนนในเมืองยุโรปที่มีกังหันลม" },
  { name: "Popular Game", src: image2, alt: "แบนเนอร์ Popular Game ตัวอักษรทองนูนหน้าวงแหวนชิปคาสิโนสีทอง ขนาบด้วยกระต่ายถือหีบสมบัติกับแมวใส่แว่นกันแดด ท่ามกลางเหรียญทองและชิปที่ลอยฟุ้ง" },
  { name: "SlotXO", src: image3, alt: "แบนเนอร์ค่าย SLOTXO โลโก้ตู้สล็อตล้อมด้วยเหรียญทอง คู่กับนักรบโรมันผมขาวสวมมงกุฎใบลอเรลและเกราะทอง ยืนหน้าโคลอสเซียมกับทหารอีกสองนาย" },
  { name: "Skywind Group", src: image4, alt: "แบนเนอร์ค่าย Skywind Group โลโก้วงกลมสี่สีบนพื้นดำ คู่กับแมวกวักนำโชคสีขาวคาดกระพรวนทอง ยืนข้างไหทองและถุงเงินสีม่วงใต้ต้นซากุระ" },
  { name: "PG Soft", src: image5, alt: "แบนเนอร์ค่าย PG Pocket Games Soft โลโก้ตัวอักษรพิกเซลบนพื้นดำ คู่กับตัวละครหญิงนักรบผิวแทนสวมเครื่องประดับทองและหมวกขนนกสไตล์แอซเท็ก" },
  { name: "SBOBET", src: image6, alt: "แบนเนอร์ค่ายเกม SBOBET โลโก้ตัวอักษรขาวบนพื้นดำ คู่กับตัวการ์ตูนอนิเมะสาวหูจิ้งจอกผมบลอนด์ในชุดกิโมโนสีชมพู มือถืออมยิ้มเกลียวหลากสี" },
  { name: "Sexy Slot", src: image7, alt: "แบนเนอร์ค่าย Sexy Slot ตัวอักษรสีชมพูม่วงมีประกายวิบวับ คู่กับตัวการ์ตูนสาวผมน้ำตาลในชุดรัดรูปสีม่วง นั่งอยู่ในกรอบวงกลมที่ล้อมด้วยหัวใจสีชมพู" },
  { name: "JILI", src: image8, alt: "แบนเนอร์ค่ายเกม JILI ตัวอักษรทองบนพื้นดำ คู่กับนางเงือกผมแดงสวมเกราะเปลือกหอยสีทอง ยกหอยสังข์แนบหูอยู่ใต้ทะเลที่มีปลาการ์ตูนและปะการัง" },
  { name: "Ask Me Bet", src: image9, alt: "แบนเนอร์ค่ายเกม ask me bet โลโก้สามช่องสีขาวเขียวเหลืองบนพื้นดำ คู่กับหัวสิงโตเชิดสีแดงทองตาโต ใต้แถวโคมไฟสีแดงหน้าศาลเจ้า" },
  { name: "New Game", src: image10, alt: "แบนเนอร์ New Game ตัวอักษรสีขาวนูนกลางภาพ ขนาบด้วยตัวการ์ตูนฟักทองหัวไฟกับโครงกระดูกยิ้ม ยืนบนฟลอร์นีออนสีชมพูฟ้าที่เกลื่อนด้วยชิปและลูกเต๋า" },
  { name: "JOKER", src: image11, alt: "แบนเนอร์ค่ายเกม JOKER ตัวอักษรขาวทองบนพื้นดำ คู่กับนักรบโรมันสวมหมวกเหล็กติดขนนกและถือโล่ ยืนเคียงสิงโตกำลังคำรามกลางสนามประลอง" },
  { name: "AFB Gaming", src: image12, alt: "แบนเนอร์ค่ายเกม AFB Gaming โลโก้ตัวอักษรทองบนพื้นดำ คู่กับเทพซุสเคราขาวตาเรืองแสงสีฟ้า สวมมงกุฎใบลอเรลและกำไลทองหน้าวิหารกรีก" },
];

const gameList = demoGames.map((game) => ({ name: game.name, imagePath: game.src.src }));

const pageTitle = "ทดลองเล่น WON22 ลองสล็อตออนไลน์เว็บตรงหลายค่ายก่อนลงเครดิตจริง";

const pageHeading = "ทดลองเล่น WON22 ลองสล็อตออนไลน์เว็บตรงหลายค่ายให้พอใจก่อนลงเครดิตจริง";

const pageDescription =
  "อยากลองก่อนตัดสินใจ WON22 รวมค่ายสล็อตออนไลน์เว็บตรงไว้ให้เลือกทดลองเล่นหลายค่าย ดูเดิมพันต่อรอบและฟีเจอร์จนพอใจ แล้วค่อยสมัครยูสเดียวไปเล่นด้วยเครดิตจริง";

const ctx = schemaCtx(Astro);
const graph = pageGraph(Astro, {
  type: "CollectionPage",
  name: pageHeading,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  ],
  extra: [
    itemList(ctx, {
      name: "ทดลองเล่นเกมของ WON22",
      alternateName: "WON22 โหมดทดลองเกมหลายค่ายบนมือถือก่อนเล่นด้วยเครดิตจริง",
      itemType: "Game",
      items: gameList,
    }),
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox as="h1" title={pageHeading}>
    <p class="mb-4 text-left text-base leading-relaxed text-[#f8e3d2]">
      อยากลองก่อนตัดสินใจใช่ไหม <strong class="text-[#fbbf24]">WON22</strong> เปิดให้คุณลองได้ฟรี ทั้งสล็อตออนไลน์เว็บตรงหลายค่ายและห้องคาสิโนสด
    </p>

    <p class="mb-4 text-left text-base leading-relaxed text-[#f8e3d2]">
      เลือกค่ายที่สนใจ สมัครยูสเดียวใช้เวลาไม่กี่นาที แล้วเข้าไปลองโหมดทดลองของค่ายนั้นได้เลย เปิดผ่านเบราว์เซอร์ได้ทั้งบนมือถือ แท็บเล็ต และคอมพิวเตอร์
      ไม่ต้องติดตั้งโปรแกรมเพิ่ม
    </p>

    <p class="text-left text-base leading-relaxed text-[#f8e3d2]">
      ลองจนเจอเกมที่ใช่และจังหวะที่ถูกใจ แล้วค่อยเริ่มเล่นด้วยเครดิตจริงจากยูสเดิม ไม่ต้องเปิดบัญชีที่สอง
    </p>
  </ContentBox>

  <ContentBox as="h2" title="เลือกค่ายที่ถูกใจ แล้วกดเข้าไปลองกับ WON22 ได้เลย">
    <p class="mb-4 text-left text-base leading-relaxed text-[#f8e3d2]">
      เริ่มจากค่ายไหนก็ได้ที่สะดุดตา แต่ละค่ายมีธีมและฟีเจอร์เป็นของตัวเอง ทั้งสล็อตหมุนคลาสสิก เกมโบนัสฟีเจอร์ และห้องคาสิโนสด
      พร้อมเกมใหม่ที่ทยอยเพิ่มเข้ามาตลอดทั้งปี
    </p>

    <p class="mb-8 text-left text-base leading-relaxed text-[#f8e3d2]">
      กดที่ภาพค่ายที่สนใจเพื่อไปยังขั้นตอนสมัคร แล้วเข้าใช้งานค่ายนั้นได้ทันที เพราะเป็นระบบเว็บตรง ยูสเดียวจึงสลับไปมาได้ทุกค่าย
      ไม่ต้องเปิดบัญชีใหม่ทุกครั้งที่อยากเปลี่ยนแนว
    </p>
    <div class="mb-5 grid grid-cols-2 gap-5 sm:grid-cols-2 md:grid-cols-4">
      {
        demoGames.map((game) => (
          <div class="group/game relative mx-auto w-full max-w-[400px] overflow-hidden rounded-xl">
            <Picture
              src={game.src}
              alt={game.alt}
              loading="lazy"
              fetchpriority="low"
              widths={[200, 400, 600]}
              sizes="(max-width: 768px) 50vw, 25vw"
              class="block h-auto w-full object-cover shadow-[0_10px_30px_rgba(249,115,22,0.16)] transition-transform duration-300 group-hover/game:scale-105"
              decoding="async"
              formats={["avif", "webp"]}
              fallbackFormat="webp"
              quality={60}
            />
            <a
              href="/register"
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`สมัครสมาชิกเพื่อเล่น ${game.name} ที่ WON22`}
              class="absolute inset-0 flex items-center justify-center bg-[#0d0502]/85 opacity-0 transition-opacity duration-300 group-hover/game:opacity-100 focus-visible:opacity-100">
              <span class="rounded-full border border-[#fb923c]/60 bg-gradient-to-r from-[#fcd34d] via-[#fbbf24] to-[#fde68a] px-6 py-2 font-bold text-[#241004] shadow-[0_10px_30px_rgba(249,115,22,0.32)] transition-transform hover:scale-110">เล่นเลย</span>
            </a>
          </div>
        ))
      }
    </div>
  </ContentBox>

  <ContentBox as="h2" title="ทดลองเล่นฟรีไม่จำกัดรอบ ลองให้พอใจก่อนใช้เครดิตจริง">
    <p class="mb-4 text-left text-base leading-relaxed text-[#f8e3d2]">
      พอเข้าไปถึงโหมดทดลองแล้วหมุนได้ไม่จำกัดรอบ เพราะเป็นเครดิตสมมติล้วน ๆ จะลองผิดลองถูกกี่ครั้งก็ได้โดยไม่ต้องเสี่ยงอะไรเลย
    </p>

    <p class="mb-4 text-left text-base leading-relaxed text-[#f8e3d2]">
      ดูว่าเดิมพันต่อรอบเริ่มที่เท่าไร ฟีเจอร์เข้าง่ายแค่ไหน หนึ่งรอบใช้เวลานานไหม แล้วเก็บไว้เป็นข้อมูลตอนเลือกเกมที่จะเล่นจริง
    </p>

    <p class="mb-4 text-left text-base leading-relaxed text-[#f8e3d2]">
      มีสองเรื่องที่อยากให้รู้ไว้ก่อน เครดิตในโหมดทดลองถอนไม่ได้ และไม่นับเป็นยอดเทิร์นของโปรใด ๆ
    </p>

    <p class="text-left text-base leading-relaxed text-[#f8e3d2]">
      อีกเรื่องคือไม่ใช่ทุกเกมที่มีปุ่มทดลอง โดยเฉพาะห้องคาสิโนสดที่ต้องเข้าโต๊ะจริงถึงจะเห็นบรรยากาศได้ครบ ถ้าเกมที่อยากลองยังไม่มีให้ทดลอง
      สมัครสมาชิกแล้วเข้าไปดูของจริงได้เลย
    </p>
  </ContentBox>

  <ContentBox as="h2" title="พร้อมเมื่อไหร่ สมัครสมาชิก WON22 แล้วเริ่มเล่นจริงได้ทันที">
    <p class="mb-4 text-left text-base leading-relaxed text-[#f8e3d2]">
      สมัครใช้เวลาไม่นาน แล้วได้ยูสเดียวที่ครอบคลุมทั้งสล็อตออนไลน์เว็บตรงหลายค่ายและห้องคาสิโนสด
    </p>

    <p class="mb-4 text-left text-base leading-relaxed text-[#f8e3d2]">
      หน้าเมมเบอร์รวมเกม เครดิต โปร และประวัติรายการไว้ที่เดียว เช็กสถานะของตัวเองได้ตลอดโดยไม่ต้องออกจากระบบ
      ส่วนระบบฝากถอนออโต้ทำรายการจากมือถือได้ตลอด 24 ชั่วโมง
    </p>

    <p class="mb-4 text-left text-base leading-relaxed text-[#f8e3d2]">
      ก่อนลงเดิมพันรอบแรก แนะนำให้ตั้งงบต่อรอบที่รับไหวไว้ก่อน และเปิดดูเงื่อนไขของโปรที่จะใช้ว่าครอบคลุมหมวดไหน ยอดรับเท่าไร เทิร์นเท่าไร
    </p>

    <p class="mb-4 text-left text-base leading-relaxed text-[#f8e3d2]">
      เข้าใช้งานผ่านเว็บหลักของ WON22 ได้ด้วยยูสเดิมทุกอุปกรณ์ เมนูจัดมาให้ใช้มือเดียวบนจอเล็กได้สะดวก และช่วยเลี่ยงโดเมนชื่อใกล้เคียงบนผลค้นหา
    </p>

    <p class="text-left text-base leading-relaxed text-[#f8e3d2]">
      อีกอย่างที่ควรติดตัวไว้เสมอ อย่าบอกรหัสผ่านหรือรหัส OTP ให้ใครทั้งนั้น
    </p>
  </ContentBox>

  <Navfoot />
</MainLayout>
