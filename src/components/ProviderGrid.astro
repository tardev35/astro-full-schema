---
const providers = [
  { name: "PG Soft", desc: "ภาพจำชัด เล่นบนมือถือสะดวก ฟีเจอร์เรียนรู้ไม่ยาก มี Mahjong Ways 2 และ Lucky Neko ให้ลองก่อน", tag: "สายมือถือ", icon: "🎰" },
  { name: "Pragmatic Play", desc: "สายรอรอบโบนัสจะคุ้นกับ Sweet Bonanza, Gates of Olympus และ Starlight Princess อยู่แล้ว", tag: "ฟรีสปิน", icon: "🎁" },
  { name: "JILI", desc: "เกมเดินจังหวะไว ฟีเจอร์หลากหลาย เช่น Super Ace, Fortune Gems และ Money Coming", tag: "จังหวะไว", icon: "⚡" },
  { name: "Joker Gaming", desc: "วงล้อคลาสสิกที่คนไทยคุ้นมือ กติกาตรงไปตรงมา เปิดเล่นต่อจากยูสเดิมได้ทันที", tag: "คลาสสิก", icon: "🃏" },
  { name: "เกมยิงปลา", desc: "หมวดยิงปลาอยู่ในยูสเดียวกับสล็อต เปลี่ยนไปพักมือแล้วกลับมาปั่นต่อได้ไม่ต้องออกจากระบบ", tag: "ยิงปลา", icon: "🐟" },
  { name: "ทรูมันนี่วอเลท", desc: "ไม่สะดวกผูกบัญชีธนาคารก็เติมจากวอเลทได้เต็มระบบ ยอดเข้าเหมือนกันทุกช่องทาง", tag: "รองรับวอเลท", icon: "👛" },
  { name: "ฝากถอนออโต้ 3 วิ", desc: "ระบบประมวลผลเอง ไม่ต้องส่งสลิป ฝากได้ตั้งแต่ 1 บาท ถอนเท่าไหร่ก็ไม่มียอดขั้นต่ำ", tag: "ไม่มีขั้นต่ำ", icon: "⏱️" },
];
---

<section aria-label="ค่ายเกมและระบบที่ PIGAUTO รวมไว้ในยูสเดียว" class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#ffe08a] via-[#f5c542] to-[#d99e1f] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      ค่ายเกมและระบบที่ <span class="text-[#f5c542]">PIGAUTO</span> รวมไว้ในยูสเดียว
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#f5c542] to-transparent"></div>
  </div>

  <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4 lg:gap-5 xl:grid-cols-7">
    {
      providers.map((provider) => (
        <a
          href="/register"
          class="group relative flex flex-col items-center justify-center overflow-hidden rounded-2xl border border-[#f5c542]/40 bg-[#2a0505] p-5 shadow-[0_10px_30px_rgba(245,197,66,0.12)] transition-all duration-300 hover:-translate-y-2 hover:border-[#f5c542]/80 hover:bg-[#3a0808] hover:shadow-[0_15px_40px_rgba(245,197,66,0.24)]">
          <div class="pointer-events-none absolute inset-0 bg-[#f5c542]/6 opacity-0 transition-opacity duration-300 group-hover:opacity-100" />

          <div class="absolute top-2 right-2 z-10 rounded-full bg-gradient-to-r from-[#ffe08a] via-[#f5c542] to-[#d99e1f] px-2 py-0.5 text-[9px] font-black tracking-wide whitespace-nowrap text-[#1f0303] shadow-sm transition-transform duration-300 group-hover:scale-110">
            {provider.tag}
          </div>

          <div aria-hidden="true" class="mb-3 text-4xl transition-transform duration-300 group-hover:scale-125 group-hover:rotate-3">
            {provider.icon}
          </div>
          <p class="text-center text-sm font-black text-[#ffe08a] transition-colors group-hover:text-[#f5c542]">{provider.name}</p>
          <p class="mt-1 text-center text-[10px] text-[#d7b9a4]">{provider.desc}</p>

          <span class="relative z-10 mt-4 block w-full rounded-full border border-[#b07d12]/60 bg-[#3a0808] py-1.5 text-center text-[11px] font-bold text-[#ffe08a] shadow-inner transition-colors duration-300 group-hover:border-transparent group-hover:bg-gradient-to-r group-hover:from-[#ffe08a] group-hover:via-[#f5c542] group-hover:to-[#d99e1f] group-hover:text-[#1f0303]">
            สมัครเข้าเล่น
          </span>
        </a>
      ))
    }
  </div>
</section>
