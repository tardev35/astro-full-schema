---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import { pageGraph } from "../lib/schema";

const pageTitle = "เกี่ยวกับเรา ANKERSPIN เว็บตรงลิขสิทธิ์แท้ สล็อต คาสิโนสด กีฬา";

const pageDescription =
  "เกี่ยวกับเรา ANKERSPIN หน้ารวมข้อมูลเว็บตรงลิขสิทธิ์แท้ อธิบายหมวดสล็อต คาสิโนสด กีฬา ระบบสมาชิก และฝากถอน Auto Wallet ที่รวมไว้ในบัญชีเดียว ใช้งานผ่านมือถือ";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox as="h1" title={pageTitle}>
    <p class="mb-4 text-left text-base leading-relaxed text-[#f9dcec]">
      <strong class="text-[#ff2d8f]">ANKERSPIN</strong> รวมสล็อต คาสิโนสด กีฬา ระบบสมาชิก และการจัดการเครดิตไว้ในบัญชีเดียว สมาชิกเข้าสู่ระบบครั้งเดียวแล้วเลือกเกม
      ดูเครดิต หรือจัดการข้อมูลบัญชีต่อได้ทันที ทั้งบนมือถือและคอมพิวเตอร์ ทำให้เลือกเกมหรือเปลี่ยนหมวดได้โดยไม่ต้องเริ่มใหม่หลายรอบ
    </p>

    <p class="text-left text-base leading-relaxed text-[#f9dcec]">
      หน้านี้ทำหน้าที่เป็นหน้าข้อมูลและแนะนำตัว อธิบายว่าเราเปิดให้บริการอะไร วางระบบสมาชิกและระบบ Auto Wallet ไว้อย่างไร และเหมาะกับผู้เล่นแบบไหน
      เพื่อให้อ่านแล้วนำไปเทียบกับสิ่งที่เห็นในหน้าสมาชิกจริงได้ เพราะเวลามีราคา เรื่องง่าย ๆ จึงไม่ควรใช้เวลาระดับประชุมผู้ถือหุ้น
    </p>
  </ContentBox>

  <ContentBox as="h2" title="ANKERSPIN เปิดให้บริการเกมและบริการอะไรบ้าง">
    <p class="mb-4 text-left text-base leading-relaxed text-[#f9dcec]">
      เราวางบริการหลักไว้ครบทั้งสล็อต คาสิโนสด และกีฬาออนไลน์ พร้อมระบบสมาชิกและฝากถอนอัตโนมัติ สมาชิกจึงเลือกความบันเทิงได้ตามสไตล์จากบัญชีเดียว
      แต่ละหมวดเข้าถึงได้จากเมนูหลักบนมือถือ ไม่ต้องเปิดหลายเว็บเพื่อเปลี่ยนเกม
    </p>

    <p class="text-left text-base leading-relaxed text-[#f9dcec]">
      หน้าเกมแบ่งหมวดไว้ชัด ทำให้กดเข้าเกมที่อยากเล่นได้เร็วตั้งแต่เปิดหน้าแรก ของเยอะเป็นเรื่องดี ถ้าจัดไว้เป็นที่ก็ยิ่งดูแพง
      สิ่งที่เราให้ความสำคัญคือทางเลือกเยอะแล้วยังหาเจอง่ายอยู่
    </p>
  </ContentBox>

  <ContentBox as="h2" title="สล็อต คาสิโนสด และกีฬาของ ANKERSPIN ต่างกันอย่างไร">
    <p class="mb-4 text-left text-base leading-relaxed text-[#f9dcec]">
      ฝั่งสล็อตรวมเกมหลายรูปแบบ ตั้งแต่เกมคลาสสิก เกมโบนัส ไปจนถึงเกมที่มีฟีเจอร์แตกต่างกัน และแบ่งเป็นหมวดไว้ให้ค้นหาง่ายขึ้น เลือกแล้วเข้าเล่นต่อได้ทันที
      ทั้งสายที่มีเกมประจำและสายชอบลองของใหม่จึงมีตัวเลือก ตัวเลือกเยอะควรสร้างความสนุก ไม่ใช่สร้างโอทีให้นิ้วโป้ง
    </p>

    <p class="text-left text-base leading-relaxed text-[#f9dcec]">
      ฝั่งคาสิโนสดเพิ่มทางเลือกอย่างบาคาร่า รูเล็ต และเกมโต๊ะ สำหรับคนที่อยากเปลี่ยนบรรยากาศจากเกมหมุนไปเป็นเกมแบบเรียลไทม์
      ส่วนหมวดกีฬาออนไลน์จัดการแข่งขันและรายการให้เลือกจากหน้าเดียว คนที่ติดตามฟุตบอลหรือกีฬาประเภทอื่นจึงเข้าถึงคู่ที่สนใจได้ง่ายขึ้น
      ทั้งสามหมวดใช้บัญชีสมาชิกชุดเดิม วันนี้ชอบไพ่ พรุ่งนี้ชอบวงล้อก็ไม่มีปัญหา รสนิยมเปลี่ยนได้โดยไม่ต้องเปลี่ยนยูสตาม
    </p>
  </ContentBox>

  <ContentBox as="h2" title="ระบบ Auto Wallet ของ ANKERSPIN ช่วยเรื่องฝากถอนอย่างไร">
    <p class="mb-4 text-left text-base leading-relaxed text-[#f9dcec]">
      Auto Wallet ช่วยให้การฝากถอนเชื่อมกับเครดิตในบัญชีสมาชิกโดยตรง ลดขั้นตอนก่อนเข้าเกมและทำให้ตรวจสอบยอดได้จากระบบเดียว
      ระบบออโต้ของเรารองรับการส่งรายการตลอด 24 ชั่วโมง สมาชิกจึงเช็กเครดิตและสถานะจากบัญชีของตัวเองได้โดยไม่ต้องรอขั้นตอนแบบแมนนวลทุกครั้ง
    </p>

    <p class="text-left text-base leading-relaxed text-[#f9dcec]">
      เมื่อตัดขั้นตอนที่ไม่จำเป็นออก การใช้งานก็ไหลต่อจากฝากเงินไปเลือกเกมได้ง่ายขึ้น เงินมีหน้าที่ทำงาน ส่วนเจ้าของเงินไม่ควรเสียเวลาเดินตามเมนู
    </p>
  </ContentBox>

  <ContentBox as="h2" title="ระบบสมาชิก ANKERSPIN รวมเครดิตและประวัติรายการไว้ตรงไหน">
    <p class="mb-4 text-left text-base leading-relaxed text-[#f9dcec]">
      หน้าสมาชิกรวมข้อมูลเครดิต โปรโมชั่น และประวัติรายการไว้ในพื้นที่เดียว ทำให้ตรวจสอบบัญชีและสิทธิ์ที่ใช้อยู่ได้ง่ายขึ้นโดยไม่ต้องเปิดหลายหน้าพร้อมกัน
      สมาชิกที่เล่นหลายหมวดจึงยังตามข้อมูลของตัวเองได้เป็นระเบียบ ของสำคัญควรอยู่ถูกที่ โดยเฉพาะเครดิต เรื่องนี้ไม่เหมาะกับการเล่นซ่อนหา
    </p>

    <p class="text-left text-base leading-relaxed text-[#f9dcec]">
      การสมัครสมาชิกทำผ่านมือถือได้ตั้งแต่กรอกข้อมูล ตั้งค่าบัญชี ไปจนถึงยืนยันตามขั้นตอนของระบบ หลังจากนั้นจึงเข้าสู่หน้าสมาชิกและเลือกบริการที่ต้องการได้
      และขอย้ำเสมอว่าไม่ควรส่งรหัสผ่านหรือรหัส OTP ให้บุคคลอื่นไม่ว่ากรณีใด เพราะทีมงานจริงไม่มีความจำเป็นต้องขอสองสิ่งนี้
    </p>
  </ContentBox>

  <ContentBox as="h2" title="ANKERSPIN เหมาะกับผู้เล่นแบบไหน">
    <p class="mb-4 text-left text-base leading-relaxed text-[#f9dcec]">
      ANKERSPIN เหมาะกับคนที่ชอบสลับระหว่างสล็อต คาสิโนสด และกีฬา พร้อมต้องการระบบฝากถอนอัตโนมัติและการใช้งานผ่านมือถือในบัญชีเดียว
      เลือกเกมที่ชอบ จัดการเครดิต แล้วเปลี่ยนหมวดได้ตามอารมณ์โดยไม่ต้องจัดการหลายระบบ หลายเกมมีไว้เลือก แต่หลายบัญชีส่วนใหญ่มีไว้ปวดหัว
    </p>

    <p class="text-left text-base leading-relaxed text-[#f9dcec]">
      ทางเข้าเว็บหลักรองรับทั้งมือถือและคอม สมาชิกใช้ข้อมูลบัญชีเดิมเพื่อเข้าสู่ระบบและเข้าถึงสล็อต คาสิโน กีฬา รวมถึงระบบ Auto Wallet ได้จากจุดเดียว
      การใช้ช่องทางหลักยังช่วยลดความสับสนจากชื่อหรือโดเมนใกล้เคียงบนผลค้นหา จำทางที่ถูกไว้หนึ่งครั้ง ดูมีระดับกว่ากดทุกลิงก์แล้วค่อยลุ้น
    </p>
  </ContentBox>

  <Navfoot />
</MainLayout>
