---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement6.astro";
import CtaRedirect from "../components/CtaRedirect.astro";
import { pageGraph } from "../lib/schema";

const pageDescription =
  "เข้าสู่ระบบ NORWAY89 ด้วยบัญชีเดิมเพื่อเล่นบาคาร่า สล็อต บอล และหวย ตรวจยอดเครดิต รับโปรโมชั่น และดูประวัติรายการฝากถอนออโต้ได้จากหน้าสมาชิกเดียวทุกอุปกรณ์";

const graph = pageGraph(Astro, {
  name: "เข้าสู่ระบบ NORWAY89 เว็บหลัก",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เข้าสู่ระบบ", path: "/login" },
  ],
});

const targetUrl = "https://yoalink.com/22hs";
---

<MainLayout title="เข้าสู่ระบบ NORWAY89 | ล็อกอินเว็บหลัก รองรับทุกอุปกรณ์" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="เข้าสู่ระบบ NORWAY89" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label="เข้าระบบเกม"
        class="group relative mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#e0aa2e]/60 bg-[#241809] px-6 py-4 text-xl font-bold tracking-wide text-[#e0aa2e] shadow-[0_10px_30px_rgba(224,170,46,0.22)] transition-all duration-300 hover:scale-105 hover:border-[#f5d488] hover:bg-[#160f07] hover:text-[#f5d488] hover:shadow-[0_15px_40px_rgba(224,170,46,0.34)]">
        เข้าระบบเกม
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="เข้าสู่ระบบ" />
</MainLayout>
