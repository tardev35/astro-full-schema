---
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";
import { gameIcon } from "../lib/gameIcons";

export interface GameTypeItem {
  icon: string;
  name: string;
  desc: string;
}

export interface Props {
  art: ImageMetadata;
  artAlt: string;
  kicker: string;
  title: string;
  tags?: string[];
  items: GameTypeItem[];
  cols?: 1 | 2;
  class?: string;
}

const { art, artAlt, kicker, title, tags = [], items, cols = 2, class: className = "" } = Astro.props;
const tileCols = cols === 2 ? "sm:grid-cols-2" : "";
const medallion = [
  "from-[#0b7cf4] to-[#2b95ff] shadow-[0_6px_16px_rgba(11,124,244,0.45)]",
  "from-[#e8202a] to-[#ff4b55] shadow-[0_6px_16px_rgba(232,32,42,0.4)]",
];
---

<div class={`rounded-[22px] bg-gradient-to-br from-[#2b95ff]/60 via-[#1a4a9c]/35 to-[#e8202a]/50 p-px shadow-[0_12px_32px_rgba(0,0,0,0.35)] ${className}`}>
  <div class="relative h-full overflow-hidden rounded-[21px] bg-[#041a45] p-4 sm:p-5">
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-16 h-48 w-48 rounded-full bg-[#0b7cf4]/20 blur-3xl"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-16 -bottom-20 h-48 w-48 rounded-full bg-[#e8202a]/15 blur-3xl"></div>

    <div class="relative flex items-center gap-3.5">
      <span class="shrink-0 rounded-full bg-gradient-to-br from-[#0b7cf4] via-[#4da3ff] to-[#e8202a] p-[2px] shadow-[0_0_24px_rgba(11,124,244,0.4)]">
        <Picture
          src={art}
          alt={artAlt}
          loading="lazy"
          decoding="async"
          fetchpriority="low"
          widths={[128, 192]}
          sizes="64px"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={74}
          class="h-14 w-14 rounded-full object-cover sm:h-16 sm:w-16"
        />
      </span>
      <div class="min-w-0 flex-1">
        <p class="text-[10px] font-extrabold tracking-[0.22em] text-[#4da3ff] uppercase">{kicker}</p>
        <p class="mt-0.5 text-base leading-snug font-black text-white sm:text-lg">{title}</p>
      </div>
    </div>

    {
      tags.length > 0 && (
        <ul class="relative mt-3.5 flex flex-wrap gap-2">
          {tags.map((t) => (
            <li class="rounded-full border border-[#4da3ff]/40 bg-[#06204f] px-3 py-1 text-[11px] font-bold text-[#dbe9ff]">{t}</li>
          ))}
        </ul>
      )
    }

    <ul class={`relative mt-4 grid grid-cols-1 gap-2.5 ${tileCols}`}>
      {
        items.map((it, i) => (
          <li class="flex items-start gap-3 rounded-2xl border border-[#1a4a9c]/80 bg-[#06204f]/85 p-3 transition-all duration-300 hover:-translate-y-0.5 hover:border-[#4da3ff]">
            <span
              class={`flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-gradient-to-br text-white ${medallion[i % 2]}`}
              set:html={gameIcon(it.icon, 20)}
            />
            <span class="min-w-0">
              <strong class="block text-sm font-black text-white md:text-[15px]">{it.name}</strong>
              <span class="block text-xs leading-relaxed text-[#9fb8dc] md:text-[13px]">{it.desc}</span>
            </span>
          </li>
        ))
      }
    </ul>
  </div>
</div>
