---
const providers = [
  { name: "PG Soft", desc: "เกมภาพสวย ค่าย RTP เป็นที่นิยม", tag: "HOT", initial: "PG", color: "from-blue-500 to-blue-800", category: "hot", online: 3241 },
  { name: "Pragmatic Play", desc: "ซื้อฟรีสปินสุดคุ้ม RTP เดิม", tag: "HOT", initial: "PP", color: "from-sky-500 to-blue-800", category: "hot", online: 2876 },
  { name: "JILI", desc: "เกมยอดฮิต ธีมหลากหลาย เข้าฟีเจอร์ง่าย", tag: "แนะนำ", initial: "JL", color: "from-blue-600 to-slate-900", category: "recommend", online: 1954 },
  { name: "Habanero", desc: "โบนัสจัดเต็ม เบทต่ำลุ้นใหญ่", tag: "ใหม่", initial: "HB", color: "from-orange-500 to-red-700", category: "new", online: 1327 },
  { name: "CQ9 Gaming", desc: "แจ็คพอตแตกบ่อย เข้าฟีเจอร์ง่าย", tag: "แนะนำ", initial: "CQ", color: "from-blue-700 to-slate-900", category: "recommend", online: 2108 },
  { name: "Microgaming", desc: "สล็อตค่ายใหญ่ ยืนหนึ่งด้านความเสถียร", tag: "แนะนำ", initial: "MG", color: "from-indigo-600 to-blue-800", category: "recommend", online: 1689 },
];

const filters = [
  { key: "all", label: "ทั้งหมด" },
  { key: "hot", label: "มาแรง 🔥" },
  { key: "new", label: "ใหม่ 🌟" },
  { key: "recommend", label: "แนะนำ" },
];
---

<div class="mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans relative z-10">
  <div class="mb-6 flex w-full flex-col items-center justify-center gap-2 text-center">
    <h2 class="text-3xl font-black uppercase tracking-widest text-transparent bg-clip-text bg-gradient-to-r from-blue-400 via-gray-200 to-gray-400 drop-shadow-[0_2px_10px_rgba(255,255,255,0.2)]">
      ค่ายเกมยอดนิยม <span class="text-blue-400">HENGJUD365</span>
    </h2>
    <div class="h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-blue-500 to-transparent mt-2"></div>
  </div>

  <!-- แท็บกรองหมวดหมู่ -->
  <div class="mb-6 flex flex-wrap items-center justify-center gap-2">
    {
      filters.map((f, i) => (
        <button
          type="button"
          data-filter-btn={f.key}
          class={`rounded-full border px-4 py-1.5 text-xs font-bold tracking-wide transition-colors duration-200 ${
            i === 0 ? "border-blue-400 bg-blue-600 text-white" : "border-white/10 bg-white/5 text-gray-400 hover:border-blue-400/40 hover:text-white"
          }`}>
          {f.label}
        </button>
      ))
    }
  </div>

  <div id="provider-grid" class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-6 lg:gap-5">
    {
      providers.map((game) => (
        <div
          data-category={game.category}
          class="group relative flex flex-col overflow-hidden rounded-2xl border border-blue-500/20 bg-[#050d16]/80 p-5 shadow-lg backdrop-blur-md transition-all duration-300 hover:-translate-y-1.5 hover:border-blue-400/50 hover:shadow-[0_10px_30px_rgba(37,99,235,0.25)]">

          <div class="mb-3 flex items-start justify-between">
            <div class={`flex h-11 w-11 items-center justify-center rounded-xl border border-white/10 bg-gradient-to-br ${game.color} text-xs font-black text-white shadow-inner transition-transform duration-300 group-hover:scale-110`}>
              {game.initial}
            </div>
            <span class="rounded-full border border-yellow-400/30 bg-yellow-400/10 px-2 py-0.5 text-[9px] font-black tracking-wide text-yellow-400">{game.tag}</span>
          </div>

          <h2 class="text-sm font-black text-white transition-colors group-hover:text-yellow-400">{game.name}</h2>
          <p class="mt-1 text-[10px] leading-relaxed text-gray-400">{game.desc}</p>

          <div class="mt-3 flex items-center gap-1.5 text-[10px] text-gray-500">
            <span class="h-1.5 w-1.5 rounded-full bg-green-400 shadow-[0_0_6px_rgba(74,222,128,0.7)] animate-pulse"></span>
            ผู้เล่นออนไลน์ {game.online.toLocaleString("en-US")}
          </div>

          <div class="mt-4 w-full rounded-lg border border-blue-500/20 bg-blue-950/40 py-2 text-center text-[11px] font-bold text-blue-300 shadow-inner transition-colors duration-300 group-hover:border-blue-400 group-hover:bg-gradient-to-r group-hover:from-blue-600 group-hover:to-blue-700 group-hover:text-white">
            เข้าเล่นเกม
          </div>
        </div>
      ))
    }
  </div>

  <p id="provider-empty" class="mt-6 hidden text-center text-sm text-gray-500">ยังไม่มีค่ายเกมในหมวดนี้</p>
</div>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>("[data-filter-btn]");
  const cards = document.querySelectorAll<HTMLElement>("#provider-grid [data-category]");
  const emptyState = document.getElementById("provider-empty");

  buttons.forEach((btn) => {
    btn.addEventListener("click", () => {
      buttons.forEach((b) => {
        b.classList.remove("border-blue-400", "bg-blue-600", "text-white");
        b.classList.add("border-white/10", "bg-white/5", "text-gray-400");
      });
      btn.classList.remove("border-white/10", "bg-white/5", "text-gray-400");
      btn.classList.add("border-blue-400", "bg-blue-600", "text-white");

      const filter = btn.dataset.filterBtn;
      let visibleCount = 0;
      cards.forEach((card) => {
        const show = filter === "all" || card.dataset.category === filter;
        card.style.display = show ? "" : "none";
        if (show) visibleCount++;
      });
      if (emptyState) emptyState.classList.toggle("hidden", visibleCount > 0);
    });
  });
</script>

<style>
  .font-sans {
    font-family: "Kanit", sans-serif;
  }
</style>
