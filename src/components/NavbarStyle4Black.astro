---
import { isActivePath } from "../lib/nav";
import { Picture } from "astro:assets";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });

const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

const currentPath = Astro.url.pathname;

const isActive = (path: string) => isActivePath(currentPath, path);

const links = [
  { name: "หน้าแรก", path: "/", icon: "🏠" },
  { name: "โปรโมชั่น", path: "/promotion", icon: "🎁" },
  { name: "ทดลองเล่น", path: "/ทดลองเล่น", icon: "🎰" },
  { name: "ทางเข้า", path: "/ทางเข้า", icon: "🌐" },
  { name: "เกี่ยวกับเรา", path: "/about-us", icon: "💎" },
  { name: "ติดต่อเรา", path: "/contact-us", icon: "📞" },
];
---

<nav class="sticky top-0 z-50 w-full border-b border-[#12b84f]/50 bg-[#040a06] shadow-[0_0_20px_rgba(18,184,79,0.25)]">
  <div class="flex h-[75px] w-full items-center justify-between px-4 xl:px-8">
    <div class="z-50 flex items-center">
      <a href="/" class="group relative flex items-center">
        <div aria-hidden="true" class="absolute inset-0 scale-0 rounded-full bg-[#12b84f]/25 blur-xl transition-transform duration-500 group-hover:scale-150"></div>
        {
          mainLogo ? (
            <Picture
              src={mainLogo}
              alt="โลโก้ YOK789 สล็อตเว็บตรง คาสิโน หวย กีฬา"
              loading="eager"
              fetchpriority="high"
              widths={[110, 220, 330]}
              sizes="110px"
              class="relative h-[40px] w-auto drop-shadow-[0_0_10px_rgba(92,255,155,0.35)] transition-transform group-hover:scale-105 xl:h-[45px]"
              formats={["avif", "webp"]}
              fallbackFormat="webp"
            />
          ) : (
            <span class="relative bg-gradient-to-b from-[#5cff9b] to-[#0a6b2f] bg-clip-text text-3xl font-black text-transparent drop-shadow-[0_0_10px_rgba(18,184,79,0.45)]">YOK789</span>
          )
        }
      </a>
    </div>

    <div class="z-10 hidden items-center gap-2 lg:gap-3 xl:flex">
      {
        links.map((link) => (
          <a
            href={link.path}
            class={`group relative px-5 py-2.5 skew-x-[-15deg] overflow-hidden border transition-all duration-300 ${isActive(link.path) ? "bg-[#12b84f]/20 border-[#5cff9b] shadow-[0_0_15px_rgba(18,184,79,0.45)]" : "bg-white/5 border-white/10 hover:border-[#12b84f]/60"}`}>
            <div
              aria-hidden="true"
              class={`absolute inset-0 bg-gradient-to-r from-[#0a6b2f] to-[#12b84f] translate-y-full transition-transform duration-300 ${isActive(link.path) ? "translate-y-0 opacity-25" : "group-hover:translate-y-0 opacity-40"}`}
            />
            <span class={`block skew-x-[15deg] relative z-10 font-bold tracking-wide transition-colors ${isActive(link.path) ? "text-[#ffd94a]" : "text-[#c3d8c9] group-hover:text-white"}`}>
              <span aria-hidden="true" class="mr-1">
                {link.icon}
              </span>
              {link.name}
            </span>
          </a>
        ))
      }
    </div>

    <div class="z-50 flex items-center gap-2">
      <button
        id="hamburger-btn"
        class="relative flex h-[45px] w-[45px] flex-col items-center justify-center space-y-1.5 rounded-md border border-[#12b84f]/40 bg-[#0a6b2f]/25 p-2 transition-all hover:bg-[#0a6b2f]/45 xl:hidden"
        aria-label="Toggle menu">
        <span class="hamburger-line h-[2px] w-6 origin-center bg-white transition-all duration-300"></span>
        <span class="hamburger-line h-[2px] w-6 bg-white transition-all duration-300"></span>
        <span class="hamburger-line h-[2px] w-6 origin-center bg-white transition-all duration-300"></span>
      </button>
    </div>
  </div>

  <div id="mobile-overlay" class="pointer-events-none fixed inset-0 z-30 bg-black/80 opacity-0 backdrop-blur-sm transition-opacity duration-300 xl:hidden"></div>

  <div
    id="mobile-sidebar"
    class="fixed top-0 right-0 z-40 h-screen w-[280px] translate-x-full transform overflow-y-auto border-l border-[#12b84f]/50 bg-[#040a06] shadow-[-10px_0_30px_rgba(0,0,0,0.8)] transition-transform duration-300 ease-out xl:hidden">
    <div class="flex flex-col space-y-3 px-6 pt-24 pb-10">
      {
        links.map((link) => (
          <a
            href={link.path}
            class={`sidebar-item flex items-center px-4 py-3.5 rounded-lg border transition-all ${isActive(link.path) ? "bg-[#12b84f]/20 border-[#5cff9b] text-[#ffd94a] shadow-[inset_4px_0_0_rgba(18,184,79,1)]" : "bg-white/5 border-transparent text-[#c3d8c9] hover:bg-white/10 hover:text-white"}`}>
            <span aria-hidden="true" class="mr-3 text-xl">
              {link.icon}
            </span>
            <span class="text-sm font-bold">{link.name}</span>
          </a>
        ))
      }
    </div>
  </div>
</nav>

<style>
  nav a {
    font-family: var(--font-sans);
  }
  #hamburger-btn.active .hamburger-line:nth-child(1) {
    transform: translateY(8px) rotate(45deg);
  }
  #hamburger-btn.active .hamburger-line:nth-child(2) {
    opacity: 0;
    transform: scaleX(0);
  }
  #hamburger-btn.active .hamburger-line:nth-child(3) {
    transform: translateY(-8px) rotate(-45deg);
  }

  .sidebar-item {
    opacity: 0;
    transform: translateX(20px);
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .sidebar-item.item-show {
    opacity: 1;
    transform: translateX(0);
  }

  .sidebar-item:nth-child(1) {
    transition-delay: 0.1s;
  }
  .sidebar-item:nth-child(2) {
    transition-delay: 0.15s;
  }
  .sidebar-item:nth-child(3) {
    transition-delay: 0.2s;
  }
  .sidebar-item:nth-child(4) {
    transition-delay: 0.25s;
  }
  .sidebar-item:nth-child(5) {
    transition-delay: 0.3s;
  }
  .sidebar-item:nth-child(6) {
    transition-delay: 0.35s;
  }

  @media (prefers-reduced-motion: reduce) {
    .sidebar-item {
      transition: none;
      opacity: 1;
      transform: none;
    }
  }
</style>

<script>
  const hamburgerBtn = document.getElementById("hamburger-btn");
  const overlay = document.getElementById("mobile-overlay");
  const sidebar = document.getElementById("mobile-sidebar");
  const sidebarItems = document.querySelectorAll(".sidebar-item");

  const toggleMenu = () => {
    hamburgerBtn?.classList.toggle("active");

    sidebar?.classList.toggle("translate-x-full");
    sidebar?.classList.toggle("translate-x-0");

    overlay?.classList.toggle("opacity-0");
    overlay?.classList.toggle("opacity-100");
    overlay?.classList.toggle("pointer-events-none");
    overlay?.classList.toggle("pointer-events-auto");

    if (sidebar?.classList.contains("translate-x-0")) {
      document.body.style.overflow = "hidden";
      sidebarItems.forEach((item) => item.classList.add("item-show"));
    } else {
      document.body.style.overflow = "";
      sidebarItems.forEach((item) => item.classList.remove("item-show"));
    }
  };

  hamburgerBtn?.addEventListener("click", toggleMenu);
  overlay?.addEventListener("click", toggleMenu);

  sidebarItems.forEach((item) => {
    item.addEventListener("click", () => {
      if (sidebar?.classList.contains("translate-x-0")) {
        toggleMenu();
      }
    });
  });
</script>
