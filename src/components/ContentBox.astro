---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#5a2a12] bg-[#1a100c] p-8 text-left text-base leading-relaxed text-[#f2e7de] shadow-[0_10px_30px_rgba(242,107,29,0.12)] transition-all duration-500 hover:border-[#f26b1d]/55 hover:shadow-[0_15px_40px_rgba(242,107,29,0.22)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#f26b1d]/14 blur-[60px] transition-all duration-500 group-hover:bg-[#f26b1d]/24"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#b3121b]/16 blur-[60px] transition-all duration-500 group-hover:bg-[#b3121b]/26"></div>

    {
      title && (
        <header class="mb-6 flex items-center gap-4 border-b border-[#5a2a12] pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffd77a] to-[#cd4604] shadow-[0_0_10px_rgba(242,107,29,0.45)]" />
          <HeadingTag class="text-2xl leading-normal font-black tracking-wide text-[#ffd77a]">{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
