---
import ContentBoxTwo from "./ContentBoxTwo.astro";

const steps = [
  { icon: "🎰", name: "สล็อตเวอร์ชั่นใหม่", detail: "เกมสล็อตหลายรูปแบบ ทั้งฟรีสปิน ตัวคูณรางวัล และโบนัสในเกม จาก PG SOFT, Joker Gaming และ Pragmatic Play เลือกได้จากบัญชีเดียว", tag: "หลายค่าย" },
  { icon: "🎯", name: "ยิงปลา กีฬา คาสิโน หวย", detail: "หมวดเกมอื่นนอกจากสล็อตอยู่ในบัญชี WINDRAGON เดียวกัน สลับหมวดที่สนใจได้โดยไม่ต้องสมัครแยกตามประเภทเกม", tag: "ครบในเว็บเดียว" },
  { icon: "⚡", name: "ฝากถอนระบบออโต้", detail: "ทำรายการเองได้ตลอดเวลา ตรวจสอบสถานะและประวัติธุรกรรมได้จากหน้าบัญชี หากยอดยังไม่ปรากฏให้ตรวจสอบก่อนโอนซ้ำ", tag: "ออโต้" },
  { icon: "👛", name: "รองรับทรูมันนี่วอเล็ต", detail: "เพิ่มช่องทางฝากถอนนอกจากบัญชีธนาคาร ควรตรวจสอบยอดขั้นต่ำและเงื่อนไขล่าสุดจากระบบก่อนทำรายการ", tag: "ทรูมันนี่" },
  { icon: "📱", name: "ทางเข้ารองรับทุกอุปกรณ์", detail: "ใช้ได้ทั้ง iOS และ Android รวมถึงคอมพิวเตอร์และแท็บเล็ต เมนูภาษาไทยอ่านง่าย ตรวจสอบ URL ให้ถูกต้องก่อนเข้าสู่ระบบทุกครั้ง", tag: "ทุกอุปกรณ์" },
];
const chips = ["สล็อตเวอร์ชั่นใหม่", "ยิงปลา", "กีฬา", "คาสิโน", "หวย", "ฝากถอนออโต้", "ทรูมันนี่วอเล็ต", "iOS และ Android"];
---

<ContentBoxTwo
  titleleft="เข้าสู่ระบบ WINDRAGON"
  titleright="ระบบและบริการที่ WINDRAGON จัดไว้ให้ครบจากบัญชีเดียว"
  label="เข้าสู่ระบบ WINDRAGON และระบบที่ใช้ได้จากบัญชีเดียว">
  <div slot="left" class="flex h-full flex-col gap-4">
    <div class="relative overflow-hidden rounded-2xl border border-[#5a2a12] bg-[#26150e] p-6 shadow-[0_10px_30px_rgba(242,107,29,0.18)]">
      <div aria-hidden="true" class="pointer-events-none absolute -top-10 -right-10 h-32 w-32 rounded-full bg-[#f26b1d]/18 blur-[50px]"></div>

      <div class="relative z-10 mb-5 flex items-center gap-3">
        <span
          aria-hidden="true"
          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#f26b1d] bg-gradient-to-br from-[#ff8a2a] via-[#f26b1d] to-[#e2550a] text-xl shadow-inner">
          🐉
        </span>
        <div class="flex flex-col">
          <p class="text-base font-black text-[#ff9a4d]">ยินดีต้อนรับกลับสู่ WINDRAGON</p>
          <span class="text-[11px] text-[#c9b5a6]">บัญชีเดียวใช้เลือกเกม ฝากถอนผ่านระบบออโต้ และดูสถานะกับประวัติธุรกรรมของคุณได้ครบจากหน้าบัญชี</span>
        </div>
      </div>

      <div class="relative z-10 flex flex-col gap-3.5">
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#f26b1d]">👤</span>
          <input
            type="text"
            aria-label="เบอร์โทรศัพท์หรือยูสเซอร์เนม"
            placeholder="เบอร์โทรศัพท์ / ยูสเซอร์เนม"
            class="w-full rounded-xl border border-[#5a2a12] bg-[#0f0a09] py-3 pr-4 pl-12 text-[#f2e7de] transition-all outline-none placeholder:text-[#c9b5a6] focus:border-[#f26b1d] focus:ring-1 focus:ring-[#f26b1d]/50"
          />
        </div>
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#f26b1d]">🔑</span>
          <input
            type="password"
            aria-label="รหัส PIN 4 หลัก"
            placeholder="รหัส PIN 4 หลัก"
            class="w-full rounded-xl border border-[#5a2a12] bg-[#0f0a09] py-3 pr-4 pl-12 text-[#f2e7de] transition-all outline-none placeholder:text-[#c9b5a6] focus:border-[#f26b1d] focus:ring-1 focus:ring-[#f26b1d]/50"
          />
        </div>

        <div class="flex items-center justify-between px-1 text-xs">
          <label class="flex items-center gap-2 text-[#c9b5a6]">
            <input type="checkbox" class="h-3.5 w-3.5 rounded border-[#5a2a12] bg-[#0f0a09] accent-[#f26b1d]" />
            จดจำฉันไว้
          </label>
          <a href="/login/" class="text-[#c9b5a6] transition-colors hover:text-[#fff4ea]">ลืมรหัส PIN?</a>
        </div>

        <button
          type="button"
          class="mt-1 w-full rounded-xl border border-[#f26b1d] bg-gradient-to-r from-[#ff8a2a] via-[#f26b1d] to-[#e2550a] p-3.5 font-black text-[#1a0701] shadow-[0_10px_30px_rgba(242,107,29,0.4)] transition-all hover:scale-[1.02] hover:shadow-[0_15px_40px_rgba(242,107,29,0.5)]">
          เข้าสู่ระบบ
        </button>

        <div class="flex items-center gap-3 py-1 text-[11px] text-[#c9b5a6]">
          <span class="h-px flex-1 bg-[#5a2a12]"></span>
          หรือ
          <span class="h-px flex-1 bg-[#5a2a12]"></span>
        </div>

        <a
          href="/line/"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] p-3 text-sm font-bold text-white shadow-md transition-all hover:scale-[1.02]">
          <span aria-hidden="true">💬</span> ทักไลน์ทีมงาน
        </a>

        <div class="mt-1 flex items-center justify-between px-1">
          <div class="flex gap-2">
            <span class="rounded-full border border-[#5a2a12] bg-[#0f0a09] px-2.5 py-1 text-[10px] font-bold text-[#ff9a4d]"><span aria-hidden="true">🔒</span> ตรวจสอบ URL ก่อนเข้า</span>
            <span class="rounded-full border border-[#5a2a12] bg-[#0f0a09] px-2.5 py-1 text-[10px] font-bold text-[#fff4ea]"><span aria-hidden="true">📱</span> รองรับทุกอุปกรณ์</span>
          </div>
          <a href="/register/" class="text-xs font-bold text-[#c9b5a6] transition-colors hover:text-[#fff4ea]">สมัครสมาชิกใหม่</a>
        </div>
      </div>
    </div>
  </div>

  <div slot="right" class="h-full">
    <div class="flex h-full flex-col rounded-2xl border border-[#5a2a12] bg-[#26150e] p-5 shadow-[0_10px_30px_rgba(242,107,29,0.18)]">
      <div class="mb-5 flex items-center justify-between gap-3">
        <div>
          <span class="text-xs font-bold tracking-wide text-[#c9b5a6]">สรุปสิ่งที่ WINDRAGON จัดเตรียมไว้ให้คุณ ตั้งแต่หน้าเกมจนถึงหน้าฝากถอน</span>
          <div class="bg-gradient-to-r from-[#ffd77a] via-[#f5b942] to-[#f26b1d] bg-clip-text text-2xl leading-normal font-black text-transparent sm:text-3xl">สล็อตเวอร์ชั่นใหม่ • รวมเกมครบครัน</div>
        </div>
        <span class="flex items-center gap-1.5 self-start rounded-full border border-green-400/40 bg-[#0f0a09] px-2.5 py-1">
          <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-green-400 shadow-[0_0_8px_rgba(74,222,128,0.7)]"></span>
          <span class="text-[10px] font-bold tracking-widest text-green-400 uppercase">Live</span>
        </span>
      </div>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#c9b5a6] uppercase">
        <span>ระบบ / บริการในเว็บ</span>
        <span>จุดเด่น</span>
      </div>

      <div class="flex flex-1 flex-col gap-2.5">
        {
          steps.map((s) => (
            <div class="rounded-xl border border-[#5a2a12] bg-[#1a100c] px-3.5 py-2.5 transition-colors hover:border-[#f26b1d]/55 hover:bg-[#0f0a09]">
              <div class="flex items-center justify-between gap-2 text-sm">
                <span class="flex min-w-0 items-center gap-2 font-bold text-[#ffe4cc]">
                  <span aria-hidden="true" class="w-5 shrink-0 text-center">
                    {s.icon}
                  </span>{" "}
                  <span class="truncate">{s.name}</span>
                </span>
                <span class="shrink-0 rounded-full border border-[#5a2a12] bg-[#26150e] px-2.5 py-0.5 text-[10px] font-bold text-[#fff4ea]">{s.tag}</span>
              </div>
              <div class="mt-1.5 text-[11px] tracking-wide text-[#c9b5a6]">{s.detail}</div>
            </div>
          ))
        }
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
        {chips.map((c) => <span class="rounded-full border border-[#5a2a12] bg-[#1a100c] px-3 py-1 text-[10px] font-bold text-[#ff9a4d]">{c}</span>)}
      </div>

      <div class="mt-3 text-center text-[10px] tracking-wide text-[#c9b5a6]">
        รายละเอียดของแต่ละบริการสรุปจากที่ WINDRAGON แจ้งไว้บนหน้าเว็บ เงื่อนไขการทำรายการให้ยึดตามหน้าบัญชีของคุณก่อนทำรายการทุกครั้ง และอย่าบอกรหัสผ่านหรือ OTP กับใคร
        หากติดขัดตรงไหนทักไลน์ทีมงานได้เลย
      </div>
    </div>
  </div>
</ContentBoxTwo>
