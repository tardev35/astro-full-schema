---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
  label?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label } = Astro.props;

const sectionLabel = label ?? title ?? titleleft ?? titleright ?? "ข้อมูลประกอบ";
---

<section aria-label={sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#f9a8d4] bg-white/92 p-8 text-[#5b2140] shadow-[0_10px_30px_rgba(236,72,153,0.14)] backdrop-blur-xl transition-all duration-500 hover:border-[#ec4899]/70 md:p-10">
    {
      title && (
        <header class="mb-6 flex items-center gap-4 border-b border-[#fbcfe8] pb-4">
          <span aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ec4899] to-[#a855f7] shadow-[0_0_10px_rgba(236,72,153,0.35)]" />
          <HeadingTag class="bg-gradient-to-r from-[#9d174d] via-[#db2777] to-[#7e22ce] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#5b2140]">
        {
          titleleft && (
            <p class="flex items-center gap-3 border-b border-[#fbcfe8] pb-3 text-xl leading-normal font-black tracking-widest text-[#9d174d] uppercase">
              <span
                aria-hidden="true"
                class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#f9a8d4] bg-gradient-to-br from-[#f472b6] via-[#ec4899] to-[#db2777] text-sm text-white shadow-[0_5px_15px_rgba(236,72,153,0.28)]">
                🔐
              </span>
              {titleleft}
            </p>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#5b2140]">
        {
          titleright && (
            <p class="flex items-center gap-3 border-b border-[#fbcfe8] pb-3 text-xl leading-normal font-black tracking-widest text-[#9d174d] uppercase">
              <span
                aria-hidden="true"
                class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#e9d5ff] bg-gradient-to-br from-[#c084fc] via-[#a855f7] to-[#7e22ce] text-sm text-white shadow-[0_5px_15px_rgba(168,85,247,0.28)]">
                📊
              </span>
              {titleright}
            </p>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
