---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import { pageGraph } from "../lib/schema";

const pageTitle = "เกี่ยวกับเรา OKHENG เว็บบาคาร่า คาสิโนสด สล็อตลิขสิทธิ์ API แท้";

const pageHeading = "เกี่ยวกับเรา OKHENG เว็บบาคาร่าและคาสิโนสด พร้อมสล็อตลิขสิทธิ์ผ่าน API แท้";

const pageDescription =
  "เกี่ยวกับเรา OKHENG รวมข้อมูลเว็บบาคาร่า คาสิโนสด และสล็อตลิขสิทธิ์ผ่าน API แท้ พร้อมระบบสมาชิก ฝากถอนออโต้ ถอนได้จริง 10 ล้าน และใช้งานผ่านมือถือในยูสเดียว";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox as="h1" title={pageHeading}>
    <p class="mb-4 text-left text-base leading-relaxed text-[#f9dfe3]">
      <strong class="text-[#f0b429]">OKHENG</strong> รวมบาคาร่า คาสิโนสด และสล็อตลิขสิทธิ์จากหลายค่ายไว้ในยูสเดียว เข้าสู่ระบบครั้งเดียวแล้วเลือกโต๊ะ เช็กเครดิต หรือดูโปรที่เปิดอยู่ต่อได้ทันที
    </p>

    <p class="mb-4 text-left text-base leading-relaxed text-[#f9dfe3]">
      ฝั่งระบบใช้ API แท้เชื่อมเกมทุกค่ายเข้ากับหน้าเมมเบอร์เดียว ใช้ยูสเดิมได้ทั้งบนมือถือและคอมพิวเตอร์
    </p>

    <p class="text-left text-base leading-relaxed text-[#f9dfe3]">
      ที่รวมไว้จุดเดียวไม่ใช่เพราะอยากให้เมนูดูเยอะ แต่เพราะการสลับเว็บกลางทางคือจังหวะที่คนเล่นเสียไปเปล่า ๆ
    </p>
  </ContentBox>

  <ContentBox as="h2" title="OKHENG วางบาคาร่าและคาสิโนสดไว้เป็นหมวดหลักอย่างไร">
    <p class="mb-4 text-left text-base leading-relaxed text-[#f9dfe3]">
      บาคาร่าคือหมวดหลักของ OKHENG เข้าเล่นผ่านห้องคาสิโนสดแบบเรียลไทม์ เลือกโต๊ะตามสไตล์ที่ถนัด จะชอบโต๊ะเดินไวหรือชอบนั่งดูจังหวะก่อนลงก็ไล่ดูได้จากหน้าเดียว
    </p>

    <p class="mb-4 text-left text-base leading-relaxed text-[#f9dfe3]">
      สายโต๊ะรู้กันดีว่าไม่ได้มีโต๊ะไหนถูกใจทุกวัน
    </p>

    <p class="text-left text-base leading-relaxed text-[#f9dfe3]">
      ถ้าบรรยากาศไม่ใช่ก็เปลี่ยนห้องได้เลย อย่าฝืนเพราะนั่งมานาน คนเล่นเป็นเขารู้จักย้ายก่อนอารมณ์พาไปไกล
    </p>
  </ContentBox>

  <ContentBox as="h2" title="เข้าสู่ระบบ OKHENG แล้วใช้งานหน้าเมมเบอร์ส่วนไหนได้บ้าง">
    <p class="mb-4 text-left text-base leading-relaxed text-[#f9dfe3]">
      หลังเข้าสู่ระบบ เปิดโต๊ะบาคาร่า เข้าห้องคาสิโนสด เลือกค่ายสล็อต ดูเครดิต และเช็กโปรได้จากหน้าเดียว ด้วยยูสเดิมทั้งบนมือถือและคอมพิวเตอร์
    </p>

    <p class="mb-4 text-left text-base leading-relaxed text-[#f9dfe3]">
      เมนูสำคัญวางไว้ให้กดถึงได้เร็ว เพราะการล็อกอินควรเป็นประตูเข้าเกม ไม่ใช่ด่านทดสอบความอดทน
    </p>

    <p class="mb-4 text-left text-base leading-relaxed text-[#f9dfe3]">
      หน้าเมมเบอร์รวมเครดิต โปร และประวัติรายการไว้ที่เดียว จึงย้อนดูได้ว่าทำรายการไหนไปแล้วและใช้สิทธิ์โปรใดอยู่
    </p>

    <p class="text-left text-base leading-relaxed text-[#f9dfe3]">
      คนเล่นดูจากตรงนี้เป็นหลักว่าเครดิตขึ้นตรงไหมและรายการย้อนหลังหาเจอไหม
    </p>
  </ContentBox>

  <ContentBox as="h2" title="สล็อตลิขสิทธิ์และ API แท้ของ OKHENG เปิดไว้ให้สายไหน">
    <p class="mb-4 text-left text-base leading-relaxed text-[#f9dfe3]">
      สล็อตลิขสิทธิ์ใน OKHENG มีทั้งสล็อตคลาสสิก ฟรีสปิน เกมโบนัส และฟีเจอร์ใหม่จากผู้ให้บริการหลายค่าย จึงเหมาะทั้งคนมีเกมประจำและสายชอบไล่ลองของใหม่
    </p>

    <p class="mb-4 text-left text-base leading-relaxed text-[#f9dfe3]">
      หน้าเกมจัดให้เลือกค่ายหรือหมวดได้ง่าย เพราะเกมเยอะมีประโยชน์ก็ต่อเมื่อหาเจอ
    </p>

    <p class="text-left text-base leading-relaxed text-[#f9dfe3]">
      API แท้คือส่วนที่เชื่อมเกมจากหลายผู้ให้บริการเข้ากับบัญชีสมาชิกเดียว เปลี่ยนจากบาคาร่าไปสล็อตแล้วกลับมาดูเครดิตจากหน้าเดิมได้โดยไม่ต้องสมัครใหม่
    </p>
  </ContentBox>

  <ContentBox as="h2" title="ฝากถอนออโต้และการถอนยอดใหญ่ของ OKHENG ทำงานอย่างไร">
    <p class="mb-4 text-left text-base leading-relaxed text-[#f9dfe3]">
      ระบบออโต้ลดช่วงรอระหว่างฝากเข้า เครดิตขึ้น และเข้าเกม รวมถึงตอนถอนออก ส่งรายการและเช็กสถานะได้จากหน้าเมมเบอร์ตลอด 24 ชั่วโมง
    </p>

    <p class="mb-4 text-left text-base leading-relaxed text-[#f9dfe3]">
      รองรับการถอนเงินจริงสูงสุด 10 ล้านบาท ยอดทั่วไปหรือยอดใหญ่ก็ทำรายการจากบัญชีเดียวกัน ไม่ต้องเจอปัญหาเล่นได้แล้วมาติดเพดานตอนถอน
    </p>

    <p class="mb-4 text-left text-base leading-relaxed text-[#f9dfe3]">
      รองรับทรูวอลเล็ตและธนาคารชั้นนำ จึงจบรายการได้จากมือถือเครื่องเดียว
    </p>

    <p class="text-left text-base leading-relaxed text-[#f9dfe3]">
      และขอย้ำไว้ตรงนี้ ไม่ควรส่งรหัสผ่านหรือรหัส OTP ให้บุคคลอื่นไม่ว่ากรณีใด
    </p>
  </ContentBox>

  <ContentBox as="h2" title="สมัครสมาชิกและทางเข้าผ่านมือถือใช้เวลานานไหม">
    <p class="mb-4 text-left text-base leading-relaxed text-[#f9dfe3]">
      สมัครผ่านมือถือเริ่มจากกรอกข้อมูล เปิดยูส และยืนยันตามขั้นตอนของระบบ จากนั้นล็อกอินเข้าหน้าเมมเบอร์เพื่อดูเกม เครดิต และโปรที่ใช้ได้
    </p>

    <p class="mb-4 text-left text-base leading-relaxed text-[#f9dfe3]">
      โครงแบบนี้เหมาะกับคนที่ใช้มือถือเป็นหลักและอยากจบทุกอย่างจากเครื่องเดียว
    </p>

    <p class="mb-4 text-left text-base leading-relaxed text-[#f9dfe3]">
      จำทางเข้าหลักที่ใช้อยู่ประจำไว้ จะกลับเข้าหน้าเมมเบอร์และกลับโต๊ะเดิมได้ไว ทั้งยังช่วยลดความสับสนจากชื่อเว็บคล้ายกันบนผลค้นหา
    </p>

    <p class="text-left text-base leading-relaxed text-[#f9dfe3]">
      ส่วนความเร็วในการโหลดเกมขึ้นอยู่กับเครื่อง เบราว์เซอร์ และสัญญาณอินเทอร์เน็ตของแต่ละคน
    </p>
  </ContentBox>

  <ContentBox as="h2" title="OKHENG เหมาะกับนักเล่นแบบไหน">
    <p class="mb-4 text-left text-base leading-relaxed text-[#f9dfe3]">
      เหมาะกับคนที่เล่นบาคาร่าเป็นหลัก แต่ยังสลับไปสล็อตลิขสิทธิ์และคาสิโนสด และอยากให้เกมหลายค่าย เครดิต โปร กับระบบฝากถอนอยู่ในยูสเดียว
    </p>

    <p class="mb-4 text-left text-base leading-relaxed text-[#f9dfe3]">
      เลือกโต๊ะที่ถูกใจ เช็กโปรที่เหมาะกับงบ แล้วจัดการเครดิตต่อได้จากที่เดียว
    </p>

    <p class="mb-4 text-left text-base leading-relaxed text-[#f9dfe3]">
      หลายค่ายมีไว้เลือก ส่วนหลายบัญชีส่วนใหญ่มีไว้ลืมรหัส ยูสเดียวจึงจบง่ายกว่าเกือบทุกกรณี
    </p>

    <p class="text-left text-base leading-relaxed text-[#f9dfe3]">
      เลือกเกมที่สนุกกับตัวเองก่อน แล้วค่อยให้ระบบที่เหลือทำงานตามหน้าที่ของมันไป
    </p>
  </ContentBox>

  <Navfoot />
</MainLayout>
