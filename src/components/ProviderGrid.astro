---
const providers = [
  { name: "PG", desc: "เกมส่วนใหญ่เปิดผ่านมือถือได้ทันที ภาพลื่นไม่กระตุก ปั่นยาวก็ไม่หน่วง", tag: "เล่นบนมือถือ", icon: "🎰" },
  { name: "JILI", desc: "รวมเกมรอบสั้น จังหวะจ่ายไวๆ เหมาะกับสายขำๆ คั่นเวลาแบบไม่ต้องรอนาน", tag: "รอบสั้น", icon: "🎲" },
  { name: "JOKER", desc: "มีทั้งเกมคลาสสิกและเกมที่ทำภาพใหม่ เลือกตามสไตล์การเล่นของตัวเองได้เลย", tag: "คลาสสิกและใหม่", icon: "🃏" },
  { name: "SLOTXO", desc: "หมวดเกมแบ่งชัด จิ้มปุ๊บเจอเลยครับ ไม่ต้องเลื่อนจนเมื่อยนิ้วก่อนได้ปั่น", tag: "หาเกมง่าย", icon: "💎" },
  { name: "HABANERO", desc: "เน้นเกมฟีเจอร์โบนัส บทจะเข้าฟรีสปินก็ไหลยาวเป็นหางว่าวจริงๆ", tag: "ฟีเจอร์แน่น", icon: "🔥" },
  { name: "เกมคลาสสิก", desc: "รูปแบบเข้าใจง่าย เหมาะกับสายประหยัด ฝาก 1 บาทก็เริ่มปั่นได้แล้วครับ", tag: "เริ่มต้นง่าย", icon: "🍒" },
  { name: "เกมใหม่สำหรับมือถือ", desc: "เมนูภาษาไทยตัวใหญ่ กดง่ายด้วยมือเดียวตั้งแต่หน้าแรก คนไทยเข้าใจคนไทย", tag: "อัปเดตต่อเนื่อง", icon: "📱" },
];
---

<section aria-label="ค่ายเกมและหมวดสล็อตที่ YIMSIAM88 รวมไว้ให้" class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#ffd98a] via-[#f6c475] to-[#ff7a18] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      ค่ายเกมและหมวดสล็อตที่ <span class="text-[#ff7a18]">YIMSIAM88</span> รวมไว้ให้ครบ
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#ff7a18] to-transparent"></div>
  </div>

  <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4 lg:gap-5 xl:grid-cols-7">
    {
      providers.map((provider) => (
        <a
          href="/register"
          class="group relative flex flex-col items-center justify-center overflow-hidden rounded-2xl border border-[#ff7a18]/25 bg-[#24100a]/92 p-5 shadow-[0_10px_30px_rgba(255,122,24,0.18)] backdrop-blur-md transition-all duration-300 hover:-translate-y-2 hover:border-[#ff7a18]/50 hover:bg-[#3a1a0e]/95 hover:shadow-[0_15px_40px_rgba(255,122,24,0.3)]">
          <div class="pointer-events-none absolute inset-0 bg-[#ffa347]/10 opacity-0 transition-opacity duration-300 group-hover:opacity-100" />

          <div class="absolute top-2 right-2 z-10 rounded-full bg-gradient-to-r from-[#ffd98a] via-[#f6c475] to-[#c8921e] px-2 py-0.5 text-[9px] font-black tracking-wide whitespace-nowrap text-[#160604] shadow-sm transition-transform duration-300 group-hover:scale-110">
            {provider.tag}
          </div>

          <div aria-hidden="true" class="mb-3 text-4xl transition-transform duration-300 group-hover:scale-125 group-hover:rotate-3">
            {provider.icon}
          </div>
          <p class="text-center text-sm font-black text-[#f7e6d4] transition-colors group-hover:text-[#ffd98a]">{provider.name}</p>
          <p class="mt-1 text-center text-[10px] text-[#c9ac91]">{provider.desc}</p>

          <span class="relative z-10 mt-4 block w-full rounded-full border border-[#ff7a18]/25 bg-[#160604] py-1.5 text-center text-[11px] font-bold text-[#ff7a18] shadow-inner transition-colors duration-300 group-hover:border-[#ff7a18]/50 group-hover:bg-gradient-to-r group-hover:from-[#ffa347] group-hover:via-[#ff7a18] group-hover:to-[#8d2b09] group-hover:text-[#160604]">
            เข้าดูเกม
          </span>
        </a>
      ))
    }
  </div>
</section>
