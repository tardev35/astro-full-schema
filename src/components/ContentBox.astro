---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#f9c2d9] bg-[#ffffff]/92 p-8 text-left text-base leading-relaxed text-[#7a1038] shadow-[0_10px_30px_rgba(190,24,93,0.12)] backdrop-blur-xl transition-all duration-500 hover:border-[#ec4899]/60 hover:shadow-[0_15px_40px_rgba(236,72,153,0.18)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#f9a8d4]/45 blur-[60px] transition-all duration-500 group-hover:bg-[#ec4899]/25"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#f7c948]/35 blur-[60px] transition-all duration-500 group-hover:bg-[#f472b6]/30"></div>

    {
      title && (
        <header class="mb-6 flex items-center gap-4 border-b border-[#f9c2d9] pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#f472b6] to-[#9d174d] shadow-[0_0_10px_rgba(236,72,153,0.35)]" />
          <HeadingTag class="bg-gradient-to-r from-[#ec4899] via-[#9d174d] to-[#be185d] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
