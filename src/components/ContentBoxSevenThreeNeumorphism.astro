---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;
const rightHeading = titleright ?? title;
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="w-full rounded-[25px] border border-[#1a4a9c] bg-[#041a45] p-8 shadow-[10px_10px_24px_#010d28,-8px_-8px_20px_#0a2a66] transition-all duration-300 hover:border-[#2f7bff] hover:shadow-[15px_15px_30px_#010d28,-10px_-10px_24px_#1a4a9c]">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#dbe9ff]">
        {titleleft && <p class="text-2xl leading-normal font-black text-[#ff5a60]">{titleleft}</p>}
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#dbe9ff] md:border-l md:border-[#1a4a9c] md:pl-8">
        {rightHeading && <HeadingTag class="border-l-4 border-[#0b7cf4] pl-3 text-2xl leading-normal font-black text-white">{rightHeading}</HeadingTag>}
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
