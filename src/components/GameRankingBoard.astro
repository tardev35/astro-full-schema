---
import { Picture } from "astro:assets";
import img1 from "../assets/providers/game1.avif";
import img2 from "../assets/providers/game2.avif";
import img3 from "../assets/providers/game3.avif";
import img4 from "../assets/providers/game4.avif";
import img5 from "../assets/providers/game5.avif";
import img6 from "../assets/providers/game6.avif";

const games = [
  { rank: 1, name: "สล็อตแตกหนักระดับ God Tier", type: "คัดเนื้อๆ เน้นๆ สถิติการแตกดีตรงตามต้นฉบับ โบนัสเข้าบ่อยที่สุด", menus: ["ยอดนิยม", "เล่นล่าสุด"], players: 5124, img: img6 },
  { rank: 2, name: "PG SOFT ภาพสวยฟีเจอร์แน่น", type: "ค่ายเกมมหาชน เข้าฟรีสปินรัว ค่า RTP เต็มจำนวนถูกต้องตามเซิร์ฟเวอร์นอก", menus: ["ยอดนิยม", "รายการโปรด"], players: 3842, img: img2 },
  { rank: 3, name: "Pragmatic Play สายซื้อฟรีสปิน", type: "กดเข้าโบนัสได้ทันที ลุ้นตัวคูณโหดๆ แบบไม่ต้องรอจังหวะ", menus: ["ยอดนิยม", "รายการโปรด"], players: 3517, img: img3 },
  { rank: 4, name: "Joker & SlotXO คลาสสิกยังขลัง", type: "ค่ายเกมสุดเก๋าที่แตกทีมีสะดุ้ง เล่นได้จากยูสเซอร์เดียวไม่ต้องโยกเงิน", menus: ["เกมใหม่", "เล่นล่าสุด"], players: 2905, img: img4 },
  { rank: 5, name: "สล็อตทุนน้อยเริ่มที่ 1 บาท", type: "รองรับวอเล็ทไม่มีขั้นต่ำ ฝากต่อเนื่องก็เป็นลูกค้า VIP ได้เหมือนกัน", menus: ["เกมใหม่", "รายการโปรด"], players: 2431, img: img1 },
  { rank: 6, name: "เกมใหม่สำหรับมือถือ", type: "เทคโนโลยีล้ำหน้าเว็บเก่าหลายปีแสง ทั้งความลื่นไหลและกราฟิก", menus: ["เกมใหม่", "เล่นล่าสุด"], players: 2108, img: img5 },
];

const medal = (rank: number) => (rank === 1 ? "🥇" : rank === 2 ? "🥈" : rank === 3 ? "🥉" : null);
---

<section aria-label="หมวดสล็อตยอดนิยมของ GODKINGKONG" class="mx-auto w-full max-w-[1300px] px-4 py-8 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <span aria-hidden="true" class="text-2xl">🏆</span>
    <p class="bg-gradient-to-r from-[#7bff9f] via-[#2fe35f] to-[#f0c43a] bg-clip-text text-2xl font-black tracking-widest text-transparent uppercase">
      หมวดสล็อตยอดนิยมของ GODKINGKONG ที่สมาชิกหมุนกันมากที่สุด
    </p>
    <p class="max-w-3xl text-base leading-relaxed text-[#ddf3e2]/75">
      ทุกเกมที่ GODKINGKONG ส่งตรงผ่าน API จากค่ายแม่เหมือนกันหมด อัตราการชนะจึงเป็นไปตามค่า RTP เต็มจำนวนถูกต้องตามเซิร์ฟเวอร์นอก ไม่มีการดัดแปลงค่าใดๆ
      ลำดับความนิยมในตารางนี้ขยับตามคนที่เข้ามาหมุนในแต่ละช่วง ไม่ได้แปลว่าเกมไหนแตกดีกว่าเกมไหน
    </p>
    <div class="mt-2 h-[3px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#2fe35f] to-transparent"></div>
  </div>

  <div class="flex flex-col gap-3">
    {
      games.map((g) => {
        const top = g.rank === 1;
        return (
          <article
            class={`group relative flex items-center gap-3 overflow-hidden rounded-2xl border p-3 backdrop-blur-md transition-all duration-300 hover:-translate-y-0.5 sm:gap-5 sm:p-4 ${
              top
                ? "border-[#2fe35f]/55 bg-gradient-to-r from-[#0c1f13]/95 via-[#0a1a10]/92 to-[#0a1a10]/92 shadow-[0_15px_40px_rgba(47,227,95,0.30)]"
                : "border-[#2fe35f]/25 bg-[#0a1a10]/92 shadow-[0_10px_30px_rgba(5,15,9,0.5)] hover:border-[#2fe35f]/55 hover:shadow-[0_15px_40px_rgba(47,227,95,0.30)]"
            }`}>
            <div aria-hidden="true" class="pointer-events-none absolute top-1/2 -left-10 h-24 w-24 -translate-y-1/2 rounded-full bg-[#0d4a26]/60 blur-[40px] transition-all duration-500 group-hover:bg-[#2fe35f]/25" />

            <div class="relative z-10 flex w-8 shrink-0 flex-col items-center justify-center sm:w-12">
              {medal(g.rank) ? (
                <span class="text-2xl sm:text-3xl">
                  <span aria-hidden="true">{medal(g.rank)}</span>
                  <span class="sr-only">อันดับ {g.rank}</span>
                </span>
              ) : (
                <span class="text-xl font-black text-[#0b6b34] sm:text-2xl">#{g.rank}</span>
              )}
            </div>

            <div class={`relative z-10 h-14 w-14 shrink-0 overflow-hidden rounded-xl border sm:h-16 sm:w-16 ${top ? "border-[#2fe35f]/55" : "border-[#2fe35f]/25"}`}>
              <Picture
                src={g.img}
                alt={`ภาพหน้าปกเกมสล็อตในหมวด ${g.name} บนกระดานหมวดสล็อตยอดนิยมของ GODKINGKONG`}
                formats={["avif", "webp"]}
                fallbackFormat="webp"
                loading="lazy"
                fetchpriority="low"
                widths={[100, 200]}
                sizes="(max-width: 640px) 56px, 64px"
                decoding="async"
                class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-110"
              />
            </div>

            <div class="relative z-10 min-w-0 flex-1">
              <div class="flex items-center gap-2">
                <p class="truncate text-base font-black text-[#ddf3e2] sm:text-lg">{g.name}</p>
                {top && (
                  <span class="hidden shrink-0 rounded-full border border-[#f0c43a]/60 bg-[#050f09] px-2 py-0.5 text-[9px] font-black tracking-wider text-[#f0c43a] sm:inline">ยอดนิยมสูงสุด</span>
                )}
              </div>
              <p class="truncate text-[11px] text-[#ddf3e2]/70 sm:text-xs">{g.type}</p>

              <div class="mt-2 flex flex-wrap items-center gap-1.5">
                {g.menus.map((m) => (
                  <span class="rounded-full border border-[#2fe35f]/25 bg-[#050f09] px-2.5 py-0.5 text-[10px] font-bold text-[#2fe35f]">{m}</span>
                ))}
              </div>
            </div>

            <div class="relative z-10 hidden shrink-0 flex-col items-end gap-1 sm:flex">
              <span class="flex items-center gap-1.5 text-[11px] text-[#ddf3e2]/70">
                <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-green-500 shadow-[0_0_6px_rgba(34,197,94,0.6)]" />
                <span class="tabular-nums" data-players data-base={g.players}>
                  {g.players.toLocaleString("en-US")}
                </span>{" "}
                ออนไลน์
              </span>
              <a
                href="/register"
                class={`rounded-full px-4 py-1.5 text-xs font-black transition-transform hover:scale-105 ${
                  top
                    ? "bg-gradient-to-r from-[#7bff9f] via-[#2fe35f] to-[#0b6b34] text-[#04170b] shadow-[0_10px_30px_rgba(47,227,95,0.28)]"
                    : "border border-[#2fe35f]/60 bg-[#050f09] text-[#2fe35f] hover:border-[#2fe35f] hover:bg-[#0c1f13]"
                }`}>
                เข้าดูเกม
              </a>
            </div>
          </article>
        );
      })
    }
  </div>
</section>

<script>
  import { startLiveCounters } from "../lib/liveCounter";

  startLiveCounters();
</script>
