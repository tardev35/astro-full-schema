---
const { titleleft, titleright } = Astro.props;
---

<section class="mx-auto mb-10 w-full max-w-5xl px-4 font-sans">
  <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
    <article class="flex flex-col gap-4">
      {titleleft && <h2 class="border-l-4 border-[#ffd60a] pl-3 text-xl font-black tracking-widest text-[#0a1128] uppercase">{titleleft}</h2>}
      <div class="text-base leading-relaxed text-gray-700"><slot name="left" /></div>
    </article>

    <article class="flex flex-col gap-4">
      {titleright && <h2 class="border-l-4 border-[#ffd60a] pl-3 text-xl font-black tracking-widest text-[#0a1128] uppercase">{titleright}</h2>}
      <div class="text-base leading-relaxed text-gray-700"><slot name="right" /></div>
    </article>
  </div>
</section>
<style>
  .font-sans {
    font-family: "Kanit", sans-serif;
  }
</style>
