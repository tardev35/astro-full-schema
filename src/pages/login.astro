---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import CtaRedirect from "../components/CtaRedirect.astro";
import { pageGraph } from "../lib/schema";

const pageTitle = "เข้าสู่ระบบ BABYSHARK8899 | ปุ่มล็อกอินเข้าหน้าเมมเบอร์ เว็บนอกลิขสิทธิ์แท้";

const pageDescription =
  "หากคุณกำลังมองหาทางกลับเข้าหน้าเมมเบอร์แบบไม่ต้องค้นหน้าเข้าเว็บ BABYSHARK8899 พร้อมมอบปุ่มเข้าสู่ระบบเพียงปุ่มเดียว เพื่อกลับไปเล่นต่อด้วยยูสเดิมได้ทันที";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เข้าสู่ระบบ", path: "/login" },
  ],
});

const targetUrl = "https://yoalink.com/gf78";
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="เข้าสู่ระบบ BABYSHARK8899" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label="เข้าสู่ระบบ BABYSHARK8899"
        class="group relative mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#00397f]/70 bg-gradient-to-b from-[#0b83fa] via-[#0057c7] to-[#00397f] px-6 py-4 text-xl font-bold tracking-wide text-white shadow-[0_10px_30px_rgba(11,131,250,0.26)] transition-all duration-300 hover:scale-105 hover:border-[#38a9ff] hover:shadow-[0_15px_40px_rgba(11,131,250,0.38)]">
        เข้าสู่ระบบ BABYSHARK8899
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="เข้าสู่ระบบ" />
</MainLayout>
