---
const {
  message = "GODDUBAI สล็อตเว็บตรงระดับสุลต่าน เชื่อม API แท้จากค่ายเกมยักษ์ใหญ่ทั่วโลก ไม่ผ่านเอเย่นต์ • ฝากถอนไม่มีขั้นต่ำ เริ่มต้นที่ 1 บาทก็เข้าเล่นได้ • ระบบออโต้ประมวลผลเฉลี่ย 1–3 วินาที ทั้งฝากและถอน ตลอด 24 ชั่วโมง • รองรับบัญชีธนาคารชั้นนำและทรูมันนี่วอลเล็ท ไม่ต้องส่งสลิป • ค่า RTP ตามมาตรฐานสากล ไม่ปรับแต่งหลังบ้าน ตรวจสอบได้ทุกการสปิน",
} = Astro.props;
---

<div class="mx-auto w-full max-w-7xl px-4 py-4 font-sans">
  <div
    class="relative flex overflow-hidden rounded-full border border-[#e8a13c]/35 bg-[#12251b]/92 shadow-[0_8px_20px_rgba(232,161,60,0.18)] backdrop-blur-lg transition-shadow duration-300 hover:shadow-[0_8px_25px_rgba(232,161,60,0.30)]">
    <div
      class="relative z-10 flex shrink-0 items-center justify-center rounded-full bg-gradient-to-r from-[#f7cf8a] via-[#e8a13c] to-[#a8611a] px-8 py-2.5 font-black text-[#091310] shadow-[4px_0_15px_rgba(232,161,60,0.25)]">
      <span aria-hidden="true" class="mr-2 text-lg">👑</span> ประกาศ
    </div>

    <div class="marquee-container relative flex-1 overflow-hidden py-2.5 pr-6">
      <div class="pointer-events-none absolute top-0 left-0 z-10 h-full w-12 bg-gradient-to-r from-[#12251b] to-transparent"></div>

      <div class="marquee-content inline-block pl-4 text-sm font-medium tracking-wide whitespace-nowrap text-[#f1e6d3]">
        <span class="mr-10 inline-flex items-center gap-3"><span class="h-2 w-2 rounded-full bg-[#e8a13c] shadow-[0_0_8px_rgba(232,161,60,0.6)]"></span>{message}</span>
        <span class="mr-10 inline-flex items-center gap-3"><span class="h-2 w-2 rounded-full bg-[#e8a13c] shadow-[0_0_8px_rgba(232,161,60,0.6)]"></span>{message}</span>
      </div>
    </div>
  </div>
</div>

<style>
  .marquee-content {
    animation: marquee 25s linear infinite;
  }
  .marquee-container:hover .marquee-content {
    animation-play-state: paused;
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee-content {
      animation: none;
    }
  }
  @keyframes marquee {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }
</style>
