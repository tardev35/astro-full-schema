---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";

import { Picture } from "astro:assets";
import { itemList, pageGraph, schemaCtx } from "../lib/schema";
import image1 from "../assets/gamedemo7.webp";
import image2 from "../assets/gamedemo8.webp";
import image3 from "../assets/gamedemo9.webp";
import image4 from "../assets/gamedemo10.webp";
import image5 from "../assets/gamedemo11.webp";
import image6 from "../assets/gamedemo12.webp";
import image7 from "../assets/gamedemo13.webp";
import image8 from "../assets/gamedemo14.webp";
import image9 from "../assets/gamedemo15.webp";
import image10 from "../assets/gamedemo16.webp";
import image11 from "../assets/gamedemo17.webp";
import image12 from "../assets/gamedemo18.webp";

// One list, two consumers: the gallery below and the ItemList in the JSON-LD.
// They used to be two hand-kept arrays that had to stay in the same order, and
// the name shown to a reader could drift from the name handed to a crawler.
const demoGames = [
  { name: "AskmeSlot", src: image1, alt: "แบนเนอร์เกมสล็อตค่าย AskmeSlot ที่เปิดให้ทดลองเล่นบน OKG777" },
  { name: "Popular Game", src: image2, alt: "แบนเนอร์รวมเกมยอดนิยม Popular Game พร้อมกองชิปและเหรียญทอง" },
  { name: "SlotXO", src: image3, alt: "แบนเนอร์เกมสล็อตค่าย SlotXO ที่เปิดให้ทดลองเล่นบน OKG777" },
  { name: "Skywind Group", src: image4, alt: "แบนเนอร์เกมสล็อตค่าย Skywind Group ที่เปิดให้ทดลองเล่นบน OKG777" },
  { name: "PG Soft", src: image5, alt: "แบนเนอร์เกมสล็อตค่าย PG Soft ที่เปิดให้ทดลองเล่นบน OKG777" },
  { name: "SBOBET", src: image6, alt: "แบนเนอร์ค่ายเกม SBOBET พร้อมตัวละครการ์ตูนถือลูกอม" },
  { name: "Sexy Slot", src: image7, alt: "แบนเนอร์เกมสล็อตค่าย Sexy Slot ที่เปิดให้ทดลองเล่นบน OKG777" },
  { name: "JILI", src: image8, alt: "แบนเนอร์เกมสล็อตค่าย JILI ที่เปิดให้ทดลองเล่นบน OKG777" },
  { name: "Ask Me Bet", src: image9, alt: "แบนเนอร์ค่ายเกม Ask Me Bet ที่เปิดให้ทดลองเล่นบน OKG777" },
  { name: "New Game", src: image10, alt: "แบนเนอร์เกมออกใหม่ New Game พร้อมตัวการ์ตูนฟักทองและโครงกระดูก" },
  { name: "JOKER", src: image11, alt: "แบนเนอร์เกมสล็อตค่าย JOKER ที่เปิดให้ทดลองเล่นบน OKG777" },
  { name: "AFB Gaming", src: image12, alt: "แบนเนอร์ค่ายเกม AFB Gaming ที่เปิดให้ทดลองเล่นบน OKG777" },
];

// The URL each entry resolves to is schema.ts's problem, not this file's — an
// older version pasted a hand-built page URL onto all 12 and got the trailing
// slash and the Thai encoding wrong on every one of them.
const gameList = demoGames.map((game) => ({ name: game.name, imagePath: game.src.src }));

const pageDescription =
  "ทดลองเล่นเกมของ OKG777 เปิดดูหน้าสล็อตเว็บตรงหลายค่ายและคาสิโนสดก่อนใช้เครดิตจริง พร้อมจุดที่ควรดูทั้งเดิมพันเริ่มต้นต่อรอบ ฟีเจอร์โบนัส และความผันผวนของเกม";

const ctx = schemaCtx(Astro);
const graph = pageGraph(Astro, {
  type: "CollectionPage",
  name: "ทดลองเล่นเกมของ OKG777 ลองระบบก่อนเล่นด้วยเงินจริง",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  ],
  extra: [
    itemList(ctx, {
      name: "ทดลองเล่นเกมสล็อตและคาสิโนของ OKG777",
      alternateName: "OKG777 โหมดทดลองเล่นสล็อตหลายค่ายบนมือถือก่อนเล่นด้วยเงินจริง",
      itemType: "Game",
      items: gameList,
    }),
  ],
});
---

<MainLayout title="ทดลองเล่น OKG777 ลองสล็อตเว็บตรงและคาสิโนสดก่อนเล่นจริง" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="ทดลองเล่นเกมของ OKG777 ลองระบบก่อนเล่นด้วยเงินจริง">
    <div>
      <h2 class="mb-6 bg-gradient-to-r from-[#ffe94d] via-[#ffd400] to-[#ff4fd8] bg-clip-text text-2xl leading-normal font-bold text-transparent">โหมดทดลองของ OKG777 มีไว้ทำอะไร และควรดูอะไรก่อนเลือกเกม</h2>

      <p class="mb-8 text-left text-base leading-relaxed text-[#ece2fb]">
        OKG777 เป็นเว็บตรงที่รวมสล็อต คาสิโนสด และกีฬาไว้ในบัญชีเดียว หมวดสล็อตแบ่งตามค่ายและรูปแบบการเล่นค่อนข้างชัด ทั้ง PG, JILI, JOKER, SLOTXO และ HABANERO ให้เลือกอยู่ในเมนูเดียวกัน จึงไล่ดูตามค่ายหรือตามเกมยอดนิยมได้โดยไม่ต้องเลื่อนจนเมื่อยนิ้ว
        หน้านี้จึงเป็นที่ให้กดเปิดดูหน้าเกมก่อนว่าหน้าตาระบบเป็นแบบไหน ปุ่มปรับเดิมพันอยู่ตรงไหน ฟีเจอร์โบนัสทำงานอย่างไร และหนึ่งรอบกินเวลาแค่ไหน โดยยังไม่ต้องใส่เงินจริงและไม่มีการได้เสียเกิดขึ้น
        สิ่งที่ควรดูจริงคือเดิมพันเริ่มต้นต่อรอบ ความผันผวน และรูปแบบการจ่าย มากกว่าดูว่าเกมไหนกำลังดังที่สุด เกมดังช่วยให้หารีวิวง่าย แต่ไม่ได้ช่วยเจรจากับระบบสุ่มเป็นการส่วนตัว ถือเป็นการอ่านคู่มือก่อนขับ ซึ่งน่าเบื่อกว่าการลองขับเลยอยู่แล้ว แต่ค่าซ่อมมันถูกกว่ากันเยอะ
      </p>

      <div class="mb-5 grid grid-cols-2 gap-5 sm:grid-cols-2 md:grid-cols-4">
        {
          demoGames.map((game) => (
            <div class="group/game relative mx-auto w-full max-w-[400px] overflow-hidden rounded-xl">
              <Picture
                src={game.src}
                alt={game.alt}
                loading="lazy"
                fetchpriority="low"
                widths={[200, 400, 600]}
                sizes="(max-width: 768px) 100vw, 25vw"
                class="block h-auto w-full object-cover shadow-[0_10px_30px_rgba(255,212,0,0.18)] transition-transform duration-300 group-hover/game:scale-105"
                decoding="async"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
                quality={60}
              />
              <a
                href="/register"
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`สมัครสมาชิกเพื่อเล่น ${game.name} ที่ OKG777`}
                class="absolute inset-0 flex items-center justify-center bg-[#0d0320]/75 opacity-0 transition-opacity duration-300 group-hover/game:opacity-100 focus-visible:opacity-100">
                <span class="rounded-full border border-[#ffd400]/60 bg-gradient-to-r from-[#ffe94d] via-[#ff4fd8] to-[#8f1080] px-6 py-2 font-bold text-[#1a0330] shadow-[0_10px_30px_rgba(255,212,0,0.30)] transition-transform hover:scale-110">เล่นเลย</span>
              </a>
            </div>
          ))
        }
      </div>

      <h2 class="mt-8 mb-6 bg-gradient-to-r from-[#ffe94d] via-[#ffd400] to-[#ff4fd8] bg-clip-text text-2xl leading-normal font-bold text-transparent">โหมดทดลองบอกอะไรได้ และบอกอะไรไม่ได้</h2>

      <p class="mb-4 text-left text-base leading-relaxed text-[#ece2fb]">
        โหมดทดลองบอกได้ว่าเกมทำงานอย่างไร เมนูอยู่ตรงไหน ฟีเจอร์ซื้อฟรีสปินเรียกใช้ยังไง และหนึ่งรอบใช้เวลาเท่าไร แต่เครดิตในโหมดนี้เป็นยอดสมมติ ถอนไม่ได้ และผลที่ออกมาก็ไม่ได้บอกว่าเล่นจริงจะได้ผลเหมือนกัน
        ต่อให้กดในโหมดทดลองแล้วจังหวะเข้ามือ ก็ไม่ใช่หลักฐานว่าเกมนั้นกำลังอารมณ์ดีรอเราอยู่ โหมดนี้มีไว้ศึกษาระบบ ไม่ใช่ไว้ดูดวงผ่านหน้าจอ
      </p>

      <p class="mb-4 text-left text-base leading-relaxed text-[#ece2fb]">
        อีกเรื่องที่ควรเผื่อใจคือโหมดทดลองไม่ได้มีให้ครบทุกเกม จึงควรเปิดหน้ารายละเอียดของเกมดูก่อนเลือก และยอดที่หมุนในโหมดทดลองไม่นับเป็นยอดเทิร์นของบัญชีหรือของโปรโมชั่นใด
        ถ้าเกมที่อยากลองไม่มีปุ่มทดลอง ให้ถือว่าวันนี้โชคไม่ดี ไม่ใช่สัญญาณลับที่ระบบส่งมาให้เราคนเดียว ส่วนคาสิโนสดอย่างบาคาร่า รูเล็ต และเกมโต๊ะรูปแบบอื่นเป็นโต๊ะเรียลไทม์ที่ไม่มีโหมดทดลองให้กดลองผล จึงต้องอาศัยการอ่านกติกา ดูวงเงินโต๊ะ ความเร็วรอบ และสถานะเปิดรับเดิมพันให้แม่นแทน เช่นเดียวกับหมวดกีฬาที่ต้องดูคู่แข่งขัน ตลาดเดิมพัน ราคา และเวลาเริ่มแข่งจากหน้าจริงเท่านั้น
      </p>

      <h2 class="mt-8 mb-6 bg-gradient-to-r from-[#ffe94d] via-[#ffd400] to-[#ff4fd8] bg-clip-text text-2xl leading-normal font-bold text-transparent">จากโหมดทดลองไปเล่นจริงบน OKG777 ควรเช็กอะไรก่อน</h2>

      <p class="mb-2 text-left text-base leading-relaxed text-[#ece2fb]">
        ถ้าจะขยับจากโหมดทดลองไปเล่นด้วยเงินจริง เรื่องที่ควรดูก่อนคือบัญชี งบต่อรอบ โปรโมชั่น และลิงก์ ด้านบัญชี ควรเตรียมเบอร์โทรที่ใช้งานจริงและรับข้อความได้ ชื่อบัญชีธนาคารที่ตรงกับผู้สมัคร และรหัส PIN 4 หลักที่ไม่ใช่เลขวันเกิด เลขเรียง หรือเลขซ้ำทั้งชุด เพราะระบบฝากถอนอัตโนมัติของ OKG777 ช่วยลดเวลารอได้ก็จริง แต่กรอกชื่อบัญชีผิดตั้งแต่แรกแล้วตามแก้ทีหลัง ความเร็วก็หายหมด
        ด้านงบ เกมสล็อตงบน้อยอาจเริ่มที่ประมาณ 1–10 บาทต่อรอบ ตัวเลขนี้เป็นเดิมพันของเกมที่รองรับ ไม่ใช่ขั้นต่ำของการฝากหรือการถอน จึงควรดูยอดบนหน้าฝากและหน้าเกมแยกกันอีกครั้ง ส่วนคาสิโนสดควรเริ่มจากโต๊ะวงเงินต่ำแล้วค่อยปรับตามงบจริง และถ้าจะกดรับสิทธิ์สมาชิกใหม่รับฟรี 18 บาท เครดิตฟรี 38 บาท หรือรางวัลชวนเพื่อน 88 บาท ก็ต้องอ่านให้จบทั้งรอบรับสิทธิ์ จำนวนเทิร์น หมวดเกมที่ร่วมรายการ และเพดานถอน
        สุดท้ายควรเข้าใช้งานผ่านทางเข้าจริงของ OKG777 ที่ตรวจชื่อเว็บไซต์แล้วและเชื่อมต่อแบบ HTTPS เท่านั้น ไม่ใช่ลิงก์ที่ส่งต่อกันมาในแชตพร้อมคำโฆษณา เพราะลิงก์แบบนั้นมักพาไปเจออะไรจริง แค่ไม่ใช่ในทางที่เราหวัง
      </p>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
