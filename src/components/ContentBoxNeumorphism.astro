---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";
---

<section class="relative z-10 my-6 flex w-full justify-center px-4 font-sans">
  <div
    class="w-full max-w-[1400px] rounded-[25px] border border-[#064c39] bg-[#0a1a15] p-8 text-left text-base leading-relaxed text-[#dfeee6] shadow-[10px_10px_20px_#03251c,-10px_-10px_20px_#0f241d]">
    {
      title && (
        <header class="mb-8 border-b border-[#064c39] pb-4 text-center">
          <HeadingTag class={`bg-gradient-to-r from-[#ffdd8a] via-[#e8b52c] to-[#4ff0bb] bg-clip-text ${headingSize} leading-normal font-black tracking-wide text-transparent`}>{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
