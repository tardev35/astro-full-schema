---
import ContentBoxTwo from "./ContentBoxTwo.astro";

const menus = [
  { icon: "🀄", name: "Mahjong Ways 2", detail: "เกมฟรีสปินตัวคูณสะสม สายมีเกมประจำเข้าเกมเดิมได้ไวจากหมวดสล็อต", tag: "RTP 96.95%" },
  { icon: "🐂", name: "Fortune Ox", detail: "ธีมคลาสสิกจังหวะกระชับ เหมาะกับคนที่อยากลองรอบสั้นก่อนเลือกเกมประจำ", tag: "RTP 96.75%" },
  { icon: "🧧", name: "Caishen Wins", detail: "มีสัญลักษณ์ไวลด์แจกตัวคูณ เล่นต่อเนื่องได้ยาว ๆ ด้วยเครดิตชุดเดิม", tag: "RTP 96.72%" },
  { icon: "🐱", name: "Lucky Neko", detail: "แถวขยายตัวคูณ เป็นหนึ่งในเกมที่สมาชิกสายลองเกมใหม่เปิดดูบ่อย", tag: "RTP 96.73%" },
  { icon: "🏺", name: "Treasures of Aztec", detail: "ฟีเจอร์โบนัสหลายรูปแบบ สำหรับคนที่ชอบลุ้นรอบใหญ่ในเกมเดียว", tag: "RTP 96.71%" },
  { icon: "🌵", name: "Wild Bandito", detail: "เข้าถึงฟีเจอร์ฟรีสปินได้เร็ว ตัดเวลาหาเกมให้สั้นลงกว่าเดิม", tag: "RTP 96.72%" },
  { icon: "🦌", name: "Ways of the Qilin", detail: "เกมไลน์จ่ายหลายทาง เปิดจากหมวดสล็อตได้โดยตรงทั้งมือถือและคอม", tag: "RTP 96.73%" },
];

const chips = ["รวมเกมสล็อต", "คาสิโนสดเรียลไทม์", "ระบบออโต้ฝากถอน", "ระบบสมาชิกบัญชีเดียว", "เช็กเครดิตได้เอง", "ประวัติรายการครบ", "เข้าสู่ระบบผ่านมือถือ"];
---

<ContentBoxTwo titleleft="เข้าสู่ระบบ 888NEO" titleright="ตารางเกมสล็อตค่า RTP สูงที่ 888NEO เปิดให้เล่น" label="เข้าสู่ระบบ 888NEO และตารางเกมสล็อตค่า RTP สูง">
  <div slot="left" class="flex h-full flex-col gap-4">
    <div class="relative overflow-hidden rounded-2xl border border-[#e01b1b]/45 bg-[#1c0a06]/92 p-6 shadow-[0_10px_30px_rgba(11,5,3,0.65)] backdrop-blur-md">
      <div aria-hidden="true" class="pointer-events-none absolute -top-10 -right-10 h-32 w-32 rounded-full bg-[#e01b1b]/45 blur-[50px]"></div>

      <div class="relative z-10 mb-5 flex items-center gap-3">
        <span
          aria-hidden="true"
          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#f5c542]/40 bg-gradient-to-br from-[#ffe9a8] via-[#f5c542] to-[#b8860b] text-xl shadow-inner">
          👑
        </span>
        <div class="flex flex-col">
          <p class="text-base font-black text-[#f5c542]">เข้าสู่ระบบแล้วเลือกเกมต่อได้ทันที</p>
          <span class="text-[11px] text-[#f3e3c6]/70">บัญชีเดียวใช้เลือกสล็อต เปิดคาสิโนสด เช็กเครดิต และตามประวัติรายการของ 888NEO ได้จากหน้าเดียว</span>
        </div>
      </div>

      <div class="relative z-10 flex flex-col gap-3.5">
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#f5c542]">👤</span>
          <input
            type="text"
            placeholder="เบอร์โทรศัพท์ / ยูสเซอร์เนม"
            class="w-full rounded-xl border border-[#e01b1b]/60 bg-[#2a1109]/95 py-3 pr-4 pl-12 text-[#f3e3c6] transition-all outline-none placeholder:text-[#f3e3c6]/50 focus:border-[#f5c542] focus:ring-1 focus:ring-[#f5c542]/50"
          />
        </div>
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#f5c542]">🔑</span>
          <input
            type="password"
            placeholder="รหัส PIN 4 หลัก"
            class="w-full rounded-xl border border-[#e01b1b]/60 bg-[#2a1109]/95 py-3 pr-4 pl-12 text-[#f3e3c6] transition-all outline-none placeholder:text-[#f3e3c6]/50 focus:border-[#f5c542] focus:ring-1 focus:ring-[#f5c542]/50"
          />
        </div>

        <div class="flex items-center justify-between px-1 text-xs">
          <label class="flex items-center gap-2 text-[#f3e3c6]/70">
            <input type="checkbox" class="h-3.5 w-3.5 rounded border-[#e01b1b]/60 bg-[#2a1109] accent-[#e01b1b]" />
            จดจำฉันไว้
          </label>
          <a href="/login" class="text-[#f3e3c6]/70 transition-colors hover:text-[#ffe9a8]">ลืมรหัส PIN?</a>
        </div>

        <button
          class="mt-1 w-full rounded-xl border border-[#f5c542]/40 bg-gradient-to-r from-[#ffe9a8] via-[#f5c542] to-[#b8860b] p-3.5 font-black text-[#0b0503] shadow-[0_10px_30px_rgba(245,197,66,0.30)] transition-all hover:scale-[1.02] hover:shadow-[0_15px_40px_rgba(245,197,66,0.40)]">
          เข้าสู่ระบบ
        </button>

        <div class="flex items-center gap-3 py-1 text-[11px] text-[#f3e3c6]/60">
          <span class="h-px flex-1 bg-[#e01b1b]/60"></span>
          หรือ
          <span class="h-px flex-1 bg-[#e01b1b]/60"></span>
        </div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] p-3 text-sm font-bold text-white shadow-md transition-all hover:scale-[1.02]">
          <span aria-hidden="true">💬</span> ทักไลน์ทีมงานตลอด 24 ชั่วโมง
        </a>

        <div class="mt-1 flex items-center justify-between px-1">
          <div class="flex gap-2">
            <span class="rounded-full border border-[#f5c542]/30 bg-[#2a1109] px-2.5 py-1 text-[10px] font-bold text-[#f5c542]"><span aria-hidden="true">🔒</span> เข้ารหัสข้อมูล</span>
            <span class="rounded-full border border-[#ff5a4d]/50 bg-[#2a1109]/80 px-2.5 py-1 text-[10px] font-bold text-[#ff5a4d]"><span aria-hidden="true">🕐</span> ระบบออโต้</span>
          </div>
          <a href="/register" class="text-xs font-bold text-[#f3e3c6]/70 transition-colors hover:text-[#ffe9a8]">สมัครสมาชิกใหม่</a>
        </div>
      </div>
    </div>
  </div>

  <div slot="right" class="h-full">
    <div class="flex h-full flex-col rounded-2xl border border-[#e01b1b]/45 bg-[#1c0a06]/92 p-5 shadow-[0_10px_30px_rgba(11,5,3,0.65)] backdrop-blur-md">
      <div class="mb-5 flex items-center justify-between gap-3">
        <div>
          <span class="text-xs font-bold tracking-wide text-[#f3e3c6]/70">เกมสล็อตที่ 888NEO เปิดให้เล่นจากหมวดสล็อต พร้อมค่า RTP ตามที่ค่ายเกมประกาศ</span>
          <div class="bg-gradient-to-r from-[#ffe9a8] via-[#f5c542] to-[#ff5a4d] bg-clip-text text-3xl font-black text-transparent sm:text-4xl">สล็อต • คาสิโนสด • บัญชีเดียว</div>
        </div>
        <span class="flex items-center gap-1.5 self-start rounded-full border border-green-500/40 bg-green-900/40 px-2.5 py-1">
          <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-green-500 shadow-[0_0_8px_rgba(34,197,94,0.7)]"></span>
          <span class="text-[10px] font-bold tracking-widest text-green-300 uppercase">Live</span>
        </span>
      </div>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#f3e3c6]/60 uppercase">
        <span>เกมสล็อตลิขสิทธิ์แท้</span>
        <span>ค่า RTP</span>
      </div>

      <div class="flex flex-1 flex-col gap-2.5">
        {
          menus.map((m) => (
            <div class="rounded-xl border border-[#e01b1b]/45 bg-[#2a1109]/95 px-3.5 py-2.5 transition-colors hover:border-[#f5c542]/50 hover:bg-[#3a180c]">
              <div class="flex items-center justify-between gap-2 text-sm">
                <span class="flex min-w-0 items-center gap-2 font-bold text-[#f3e3c6]">
                  <span aria-hidden="true" class="w-5 shrink-0 text-center">
                    {m.icon}
                  </span>{" "}
                  <span class="truncate">{m.name}</span>
                </span>
                <span class="shrink-0 rounded-full border border-[#f5c542]/40 bg-[#1c0a06] px-2.5 py-0.5 text-[10px] font-bold text-[#f5c542]">{m.tag}</span>
              </div>
              <div class="mt-1.5 text-[11px] tracking-wide text-[#f3e3c6]/70">{m.detail}</div>
            </div>
          ))
        }
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
        {chips.map((c) => <span class="rounded-full border border-[#e01b1b]/45 bg-[#2a1109] px-3 py-1 text-[10px] font-bold text-[#ff5a4d]">{c}</span>)}
      </div>

      <div class="mt-3 text-center text-[10px] tracking-wide text-[#f3e3c6]/60">
        ค่า RTP ในตารางสรุปจากที่ค่ายเกมประกาศไว้ เป็นค่าเฉลี่ยระยะยาวไม่ใช่ผลของรอบใดรอบหนึ่ง เงื่อนไขจริงให้ยึดตามหน้าเกมของ 888NEO หากติดขัดตรงไหนทักไลน์ทีมงานได้ตลอด 24 ชั่วโมง
      </div>
    </div>
  </div>
</ContentBoxTwo>
