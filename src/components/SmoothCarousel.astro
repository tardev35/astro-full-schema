---
import { Picture } from "astro:assets";

import slide2 from "../assets/slide2.png";
import slide3 from "../assets/slide3.png";

const images = [
  {
    src: slide2,
    alt: "ภาพโปรโมชั่น OKHENG โทนแดงตรุษจีนสลับทอง มีโคมไฟจีนสีแดงห้อยอยู่ด้านบนและพรีเซนเตอร์หญิงสวมชุดกี่เพ้าสีแดงถือเหรียญทอง ตัวอักษรสีทองขนาดใหญ่ว่า คืนยอดเสีย สูงถึง 5% บรรทัดถัดมาว่า ทุกวันอาทิตย์ หลังเที่ยงคืน 12.00 น. และ ระบบรีเซ็ตทุก 7 วัน ด้านล่างเป็นข้อความว่า ยอดเสียมีคืน เล่นต่อได้สบายกว่าเดิม พร้อมแถวไอคอน บาคาร่าครบทุกค่าย สล็อตลิขสิทธิ์แท้ API แท้เชื่อมตรงทุกค่าย ระบบออโต้ 24 ชม. และ มั่นคง ปลอดภัย 100%",
  },
  {
    src: slide3,
    alt: "ภาพโปรโมชั่น OKHENG โทนแดงตรุษจีนสลับทอง ด้านขวาเป็นพรีเซนเตอร์หญิงสวมชุดกี่เพ้าสีแดงถือการ์ด OK HENG ข้างหม้อทองที่มีทองแท่งกองอยู่ ตัวอักษรสีทองว่า ฝากประจำต่อเนื่องทุกวัน บรรทัดถัดมาว่า รับเพิ่มเครดิตฟรี และด้านล่างว่า ถอนได้ทันที ไม่ติดเทิร์น",
  },
];

const COPIES = 3;
const slides = Array.from({ length: COPIES }, () => images).flat();
---

<div class="marquee mx-auto w-full max-w-7xl overflow-hidden px-4 py-5">
  <input id="carousel-pause" type="checkbox" class="peer sr-only" />
  <label
    for="carousel-pause"
    class="sr-only cursor-pointer peer-focus-visible:not-sr-only peer-focus-visible:mb-3 peer-focus-visible:inline-block peer-focus-visible:rounded-full peer-focus-visible:border peer-focus-visible:border-[#ed0133]/60 peer-focus-visible:bg-[#2a0509] peer-focus-visible:px-4 peer-focus-visible:py-2 peer-focus-visible:text-sm peer-focus-visible:font-bold peer-focus-visible:text-[#ffdb7d]">
    หยุด / เล่นสไลด์ภาพ
  </label>

  <div class="marquee-track flex">
    {
      slides.map((slide, index) => {
        const isDuplicate = index >= images.length;
        return (
          <div class="marquee-slide" aria-hidden={isDuplicate ? "true" : undefined}>
            <Picture
              src={slide.src}
              alt={isDuplicate ? "" : slide.alt}
              class="block w-full rounded-xl border border-[#6b0d1e] object-cover shadow-[0_10px_30px_rgba(237,1,51,0.20)]"
              width={slide.src.width}
              height={slide.src.height}
              loading="lazy"
              fetchpriority="low"
              decoding="async"
              widths={[300, 360, 420, 480, 540, 600]}
              sizes="(max-width: 767px) calc(100vw - 32px), (max-width: 1279px) calc((100vw - 48px) / 2), 403px"
              formats={["avif", "webp"]}
              fallbackFormat="webp"
              quality={60}
            />
          </div>
        );
      })
    }
  </div>
</div>

<style>
  .marquee {
    --gap: 12px;
    --per-view: 1;
    --shift: calc(-200% - 24px);
  }

  @media (min-width: 768px) {
    .marquee {
      --gap: 16px;
      --per-view: 2;
      --shift: calc(-100% - 16px);
    }
  }

  @media (min-width: 1280px) {
    .marquee {
      --gap: 20px;
      --per-view: 3;
      --shift: calc(-66.6667% - 13.3333px);
    }
  }

  .marquee-track {
    gap: var(--gap);
    width: 100%;
    animation: carousel-scroll 24s linear infinite;
    will-change: transform;
  }

  .marquee-slide {
    flex: 0 0 calc((100% - (var(--per-view) - 1) * var(--gap)) / var(--per-view));
  }

  @keyframes carousel-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(var(--shift));
    }
  }

  .marquee:hover .marquee-track,
  .marquee:focus-within .marquee-track,
  .marquee > input:checked ~ .marquee-track {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
    }
  }
</style>
