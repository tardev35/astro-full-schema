---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;
---

<section class="mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="w-full rounded-[25px] border border-[#064c39] bg-[#0a1a15] p-8 shadow-[10px_10px_20px_#03251c,-10px_-10px_20px_#0f241d] transition-all duration-300 hover:shadow-[15px_15px_30px_#03251c,-15px_-15px_30px_#12352b]">
    {
      title && (
        <header class="mb-8 border-b border-[#064c39] pb-4 text-center">
          <HeadingTag class="bg-gradient-to-r from-[#ffdd8a] via-[#e8b52c] to-[#4ff0bb] bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#dfeee6]">
        {titleleft && <p class="text-xl leading-normal font-black tracking-wide text-[#f8ecc9] drop-shadow-[0_0_10px_rgba(18,196,143,0.35)]">{titleleft}</p>}
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#dfeee6] md:border-l md:border-[#064c39] md:pl-8">
        {titleright && <p class="text-xl leading-normal font-black tracking-wide text-[#f8ecc9] drop-shadow-[0_0_10px_rgba(18,196,143,0.35)]">{titleright}</p>}
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
