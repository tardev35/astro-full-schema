---
import { Picture } from "astro:assets";
import BankStrip from "./BankStrip.astro";
import { BRAND_ADDRESS, BRAND_NAME } from "../lib/brandProfile";

const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });
const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

const logoAlt = "โลโก้ TGA99 ตัวอักษร TGA สีม่วงอมชมพูไล่เฉดเงาและเลข 99 สีเงินโครเมียม ขอบม่วงเข้ม";

const menu = [
  { name: "หน้าแรก", path: "/" },
  { name: "โปรโมชั่น", path: "/promotion/" },
  { name: "สมัครสมาชิก", path: "/register/" },
  { name: "เข้าสู่ระบบ", path: "/login/" },
  { name: "ทางเข้า", path: "/ทางเข้า/" },
  { name: "ทดลองเล่น", path: "/ทดลองเล่น/" },
  { name: "วิธีฝากถอน", path: "/วิธีฝากถอน/" },
  { name: "เกี่ยวกับเรา", path: "/about-us/" },
  { name: "ติดต่อเรา", path: "/contact-us/" },
];

const services = ["สล็อตออนไลน์ (Slot)", "คาสิโนสด (Live Casino)", "หวยออนไลน์ (Lotto)", "เกมยิงปลา (Fishing)", "ฝากถอนออโต้ (Auto)"];
---

<footer class="relative w-full overflow-hidden border-t-[3px] border-[#c13fc4] bg-[#0d010f] pt-16 pb-8 text-[#ead9ec] shadow-[0_-10px_30px_rgba(193,63,196,0.25)]">
  <div aria-hidden="true" class="pointer-events-none absolute top-0 right-0 h-96 w-96 rounded-full bg-[#c13fc4]/15 blur-[100px]"></div>
  <div aria-hidden="true" class="pointer-events-none absolute bottom-0 left-0 h-96 w-96 rounded-full bg-[#f5c542]/12 blur-[100px]"></div>

  <div class="relative z-10 mx-auto w-full max-w-[1200px] px-6">
    <div class="mb-12 grid grid-cols-1 gap-10 md:grid-cols-2 lg:grid-cols-4 lg:gap-8">
      <div class="flex flex-col gap-5">
        <a href="/" class="inline-block origin-left transition-transform hover:scale-105">
          {
            mainLogo ? (
              <Picture src={mainLogo} alt={logoAlt} widths={[110, 220, 330]} sizes="110px" class="h-[50px] w-auto drop-shadow-[0_0_15px_rgba(224,97,227,0.55)]" formats={["avif", "webp"]} fallbackFormat="webp" />
            ) : (
              <span class="bg-gradient-to-b from-[#e061e3] to-[#9c2193] bg-clip-text text-4xl font-black text-transparent drop-shadow-[0_0_10px_rgba(193,63,196,0.45)]">{BRAND_NAME}</span>
            )
          }
        </a>
        <p class="text-base leading-relaxed text-[#c9a8cc]">
          {BRAND_NAME} รวมสล็อต คาสิโนสด หวย และเกมยิงปลาไว้ในบัญชีเดียว พร้อมระบบฝากถอนออโต้ที่สมาชิกทำรายการเองได้ตลอด 24 ชั่วโมง ฝากขั้นต่ำ 20 บาท ถอนขั้นต่ำ 50 บาท ใช้งานได้ทั้งมือถือ แท็บเล็ต และคอมพิวเตอร์
        </p>
        <div class="mt-2 flex items-center gap-3">
          <div class="flex items-center gap-1.5 rounded border border-[#c13fc4]/50 bg-[#c13fc4]/10 px-3 py-1.5 text-xs font-bold text-[#e8a9ea] shadow-[0_0_10px_rgba(193,63,196,0.25)]">
            <span aria-hidden="true" class="text-base">🛡️</span> SSL/TLS 256-BIT
          </div>
          <div class="flex items-center gap-1.5 rounded border border-[#f5c542]/50 bg-[#f5c542]/10 px-3 py-1.5 text-xs font-bold text-[#ffe08a]">
            <span aria-hidden="true" class="text-base">⚡</span> AUTO 24H
          </div>
        </div>
      </div>

      <nav aria-label="เมนูหลัก" class="flex flex-col gap-4 lg:pl-8">
        <p class="flex items-center gap-2 text-lg font-extrabold text-[#ffe08a]">
          <span aria-hidden="true" class="h-6 w-1.5 rounded-full bg-gradient-to-b from-[#e061e3] to-[#62035b]"></span> เมนูหลัก
        </p>
        <ul class="flex flex-col gap-3 text-sm">
          {
            menu.map((link) => (
              <li>
                <a href={link.path} class="group flex items-center text-[#c9a8cc] transition-all hover:text-[#ffe08a]">
                  <span aria-hidden="true" class="mr-2 -ml-4 text-[#e061e3] opacity-0 transition-all group-hover:ml-0 group-hover:opacity-100">
                    ➤
                  </span>
                  {link.name}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav aria-label="หมวดหมู่บริการ" class="flex flex-col gap-4">
        <p class="flex items-center gap-2 text-lg font-extrabold text-[#ffe08a]">
          <span aria-hidden="true" class="h-6 w-1.5 rounded-full bg-gradient-to-b from-[#e061e3] to-[#62035b]"></span> หมวดเกมและบริการ
        </p>
        <ul class="flex flex-col gap-3 text-sm">
          {
            services.map((game) => (
              <li>
                <a href="/register/" class="group flex items-center text-[#c9a8cc] transition-all hover:text-[#ffe08a]">
                  <span aria-hidden="true" class="mr-3 h-1.5 w-1.5 rounded-full bg-[#62035b] transition-colors group-hover:bg-[#e061e3] group-hover:shadow-[0_0_8px_rgba(224,97,227,0.8)]" />
                  {game}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="flex flex-col gap-5">
        <p class="flex items-center gap-2 text-lg font-extrabold text-[#ffe08a]">
          <span aria-hidden="true" class="h-6 w-1.5 rounded-full bg-gradient-to-b from-[#e061e3] to-[#62035b]"></span> บริการลูกค้า
        </p>

        <a
          href="/line/"
          class="flex w-full items-center justify-center gap-2 rounded-lg bg-[#00B900] py-3 font-bold text-white shadow-[0_0_15px_rgba(0,185,0,0.3)] transition-transform hover:scale-105">
          <span class="text-xl font-black">LINE</span> @{BRAND_NAME}
        </a>

        {
          BRAND_ADDRESS.lines.length > 0 && (
            <address aria-label={BRAND_ADDRESS.label} class="mt-2 rounded-xl border border-white/15 bg-black/20 p-4 text-xs leading-relaxed not-italic opacity-90">
              <p class="mb-2 flex items-center gap-2 text-[11px] font-bold tracking-wider uppercase opacity-80">
                <span aria-hidden="true" class="text-sm">📍</span>
                {BRAND_ADDRESS.label}
              </p>
              {BRAND_ADDRESS.lines.map((line) => (
                <span class="block">{line}</span>
              ))}
              {BRAND_ADDRESS.email && (
                <a href={`mailto:${BRAND_ADDRESS.email}`} class="mt-3 inline-flex items-center gap-2 font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                  <span aria-hidden="true" class="text-sm">✉️</span>
                  {BRAND_ADDRESS.email}
                </a>
              )}
            </address>
          )
        }

        <div class="mt-2">
          <p class="mb-3 text-xs font-bold tracking-wider text-[#ffe08a]/90 uppercase">รองรับทุกธนาคาร &amp; True Wallet</p>
          <BankStrip size={26} />
        </div>
      </div>
    </div>

    <div class="mb-6 flex flex-wrap justify-center gap-4 border-y border-[#c13fc4]/25 py-6 opacity-60 grayscale transition-all duration-500 hover:opacity-100 hover:grayscale-0 md:gap-8">
      <span class="text-lg font-black text-[#e8e8ee] italic md:text-2xl">PG<span class="text-[#e061e3]">SOFT</span></span>
      <span class="text-lg font-black text-[#e8e8ee] italic md:text-2xl">PRAGMATIC<span class="text-[#e061e3]">PLAY</span></span>
      <span class="text-lg font-black text-[#e8e8ee] italic md:text-2xl">JOKER<span class="text-[#e061e3]">GAMING</span></span>
      <span class="text-lg font-black text-[#e8e8ee] italic md:text-2xl">JI<span class="text-[#e061e3]">LI</span></span>
    </div>

    <div class="flex flex-col items-center justify-between gap-4 text-xs text-[#c9a8cc] md:flex-row">
      <p>&copy; {new Date().getFullYear()} <span class="font-bold text-[#e061e3]">{BRAND_NAME}</span>. All rights reserved. สล็อต คาสิโนสด หวย ยิงปลา จบในบัญชีเดียว</p>
      <div class="flex gap-4">
        <a href="/terms/" class="transition-colors hover:text-[#ffe08a]">เงื่อนไขการให้บริการ</a>
        <a href="/privacy/" class="transition-colors hover:text-[#ffe08a]">นโยบายความเป็นส่วนตัว</a>
      </div>
    </div>
  </div>
</footer>

<style>
  footer a {
    text-decoration: none;
  }
  footer {
    font-family: var(--font-sans);
  }
</style>
