---
const { titleleft, titlecenter, titleright } = Astro.props;
---

<section class="mx-auto mb-6 w-full max-w-7xl px-4 font-sans">
  <div
    class="relative isolate w-full border border-[#6d28d9]/60 bg-[#1c0a30]/90 p-8 text-[#ede4fb] shadow-[0_0_25px_rgba(168,85,247,0.15)] backdrop-blur-md transition-all duration-300 hover:border-[#a855f7] hover:shadow-[0_0_40px_rgba(168,85,247,0.3)]"
    style="clip-path: polygon(30px 0, 100% 0, 100% calc(100% - 30px), calc(100% - 30px) 100%, 0 100%, 0 30px);">
    <div class="absolute top-0 left-0 -z-10 h-[2px] w-24 bg-gradient-to-r from-[#a855f7] to-transparent"></div>
    <div class="absolute right-0 bottom-0 -z-10 h-[2px] w-24 bg-gradient-to-l from-[#a855f7] to-transparent"></div>
    <div class="absolute top-0 left-0 -z-10 h-16 w-[2px] bg-gradient-to-b from-[#a855f7] to-transparent"></div>
    <div class="absolute right-0 bottom-0 -z-10 h-16 w-[2px] bg-gradient-to-t from-[#a855f7] to-transparent"></div>

    <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
      <article class="flex flex-col gap-4 border-b border-[#6d28d9]/40 pb-6 text-left text-base leading-relaxed text-[#ede4fb] md:border-r md:border-b-0 md:pr-6 md:pb-0">
        {
          titleleft && (
            <h2 class="flex items-center gap-2 text-lg leading-normal font-black tracking-widest text-[#ffe680] uppercase">
              <span class="h-2 w-2 bg-[#fdc700] shadow-[0_0_5px_rgba(253,199,0,0.8)]" /> {titleleft}
            </h2>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 border-b border-[#6d28d9]/40 pb-6 text-left text-base leading-relaxed text-[#ede4fb] md:border-r md:border-b-0 md:px-4 md:pb-0">
        {
          titlecenter && (
            <h2 class="flex items-center gap-2 text-lg leading-normal font-black tracking-widest text-[#ffe680] uppercase">
              <span class="h-2 w-2 bg-[#fdc700] shadow-[0_0_5px_rgba(253,199,0,0.8)]" /> {titlecenter}
            </h2>
          )
        }
        <slot name="center" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#ede4fb] md:pl-6">
        {
          titleright && (
            <h2 class="flex items-center gap-2 text-lg leading-normal font-black tracking-widest text-[#ffe680] uppercase">
              <span class="h-2 w-2 bg-[#fdc700] shadow-[0_0_5px_rgba(253,199,0,0.8)]" /> {titleright}
            </h2>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
