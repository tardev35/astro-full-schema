---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";

import { Picture } from "astro:assets";

import pro1 from "../assets/slide1.png";
import pro2 from "../assets/slide2.png";
import pro3 from "../assets/slide3.png";
import pro4 from "../assets/slide4.png";
import { pageGraph } from "../lib/schema";

const pageTitle = "โปรโมชั่น - YIMSIAM889";

const pageHeading = "โปรโมชั่น YIMSIAM889 ยิ้มรับโปรสมาชิกใหม่ คุ้มค่าตั้งแต่ก้าวแรก";

const pageDescription =
  "รวมโปรโมชั่น YIMSIAM889 สล็อตสยาม เว็บตรงแตกดีจริง ยิ้มรับโปรสมาชิกใหม่ตั้งแต่ก้าวแรก ฝากถอนผ่านระบบอัตโนมัติรวดเร็ว รองรับธนาคารชั้นนำและทรูวอลเลท ตลอด 24 ชม.";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: pro1.src,
});

const promoClass =
  "mx-auto h-auto w-full rounded-xl border border-[#16357a] object-contain shadow-[0_10px_30px_rgba(47,140,255,0.16)] transition-all duration-300 hover:-translate-y-1 hover:border-[#2f8cff]/55 hover:shadow-[0_15px_40px_rgba(47,140,255,0.28)]";
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageHeading} as="h1">
    <p class="mb-4 text-left text-base leading-relaxed">
      หากท่านกำลังมองหาการต้อนรับที่คุ้มค่าตั้งแต่ก้าวแรก <strong class="text-[#9cc9ff]">YIMSIAM889</strong> พร้อมมอบโปรสมาชิกใหม่ ทั้งโบนัสเพิ่มทุนและสิทธิพิเศษที่จัดสรรไว้อย่างสมเกียรติ ให้ท่านยิ้มรับได้ตั้งแต่วันแรกที่ก้าวเข้าเรือนขอรับ
    </p>

    <p class="mb-8 text-left text-base leading-relaxed">
      ทุกสิทธิ์มาพร้อมมาตรฐานเว็บตรง ทางเข้าที่รองรับทุกอุปกรณ์ และธุรกรรมว่องไวด้วยระบบอัตโนมัติ สมัครปุ๊บ รับสิทธิ์ปั๊บ เพื่อให้ท่านเริ่มต้นความสนุกได้อย่างมั่นใจ ไม่ต้องกังวลเรื่องทุนรอน
    </p>

    <div class="grid w-full grid-cols-1 gap-6 sm:grid-cols-2">
      <Picture
        src={pro1}
        alt="ภาพโปรโมชั่น YIMSIAM889 ข้อความตัวอักษรโครเมียมขอบน้ำเงินว่า ยิ้มรับโปรสมาชิกใหม่ คุ้มค่าตั้งแต่ก้าวแรก ด้านซ้ายเป็นพรีเซนเตอร์หญิงชุดราตรีเลื่อมสีน้ำเงินเงิน ด้านหลังเป็นมงกุฎคริสตัลบนแท่นในห้องคาสิโนแสงนีออนสีฟ้า มีชิปและไพ่ลอยรอบภาพ"
        loading="lazy"
        fetchpriority="low"
        widths={[400, 600]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class={promoClass}
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />

      <Picture
        src={pro2}
        alt="ภาพโปรโมชั่น YIMSIAM889 ข้อความตัวอักษรโครเมียมขอบน้ำเงินว่า ทางเข้า YIMSIAM889 รองรับทุกอุปกรณ์ ด้านซ้ายเป็นพรีเซนเตอร์หญิงชุดราตรีเลื่อมสีน้ำเงินเงินถือไพ่คลี่เป็นพัด ด้านหลังเป็นมงกุฎรูปสิงห์ในห้องคาสิโนแสงนีออนสีฟ้า มีชิปและไพ่ลอยรอบภาพ"
        loading="lazy"
        fetchpriority="low"
        widths={[400, 600]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class={promoClass}
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />

      <Picture
        src={pro3}
        alt="ภาพโปรโมชั่น YIMSIAM889 ข้อความตัวอักษรโครเมียมขอบน้ำเงินว่า ธุรกรรมว่องไว ระบบอัตโนมัติ ด้านขวาเป็นพรีเซนเตอร์หญิงชุดราตรีเลื่อมสีน้ำเงินเงินผายมือไปทางโลโก้ยักษ์ของแบรนด์ มีชิปคาสิโนสีน้ำเงินและไพ่ลอยเป็นวงโค้งแสงนีออน"
        loading="lazy"
        fetchpriority="low"
        widths={[400, 600]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class={promoClass}
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />

      <Picture
        src={pro4}
        alt="ภาพโปรโมชั่น YIMSIAM889 ข้อความตัวอักษรโครเมียมขอบน้ำเงินว่า เว็บตรงแตกดีจริง มาตรฐานสากล ด้านขวาเป็นพรีเซนเตอร์หญิงชุดราตรีเลื่อมสีน้ำเงินเงินถือไพ่ ด้านหลังเป็นมงกุฎคริสตัลบนแท่นขั้นบันไดแสงนีออนสีฟ้า มีชิปและไพ่ลอยรอบภาพ"
        loading="lazy"
        fetchpriority="low"
        widths={[400, 600]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class={promoClass}
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />
    </div>

    <div class="mt-12 flex justify-center pb-4">
      <a
        href="/register/"
        class="flex items-center justify-center rounded-lg border border-[#2f8cff]/70 bg-gradient-to-r from-[#eaf4ff] via-[#9cc9ff] to-[#4d9dff] px-10 py-3.5 text-lg font-black text-[#03133c] shadow-[0_10px_30px_rgba(47,140,255,0.4)] transition-transform hover:scale-105 hover:shadow-[0_15px_40px_rgba(47,140,255,0.55)]">
        สมัครสมาชิก YIMSIAM889
      </a>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
