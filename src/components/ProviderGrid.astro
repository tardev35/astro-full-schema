---
const providers = [
  { name: "สล็อต", desc: "รวมเกมหลายค่ายหลายสไตล์ ทั้งเกมคลาสสิก เกมโบนัส และเกมที่มีฟีเจอร์ต่างกัน", tag: "หมวดหลัก", icon: "🎰" },
  { name: "คาสิโนสด", desc: "บาคาร่า รูเล็ต และเกมโต๊ะ เลือกประเภทเกมและโต๊ะที่ต้องการได้จากหน้าเดียว", tag: "หมวดหลัก", icon: "🎲" },
  { name: "กีฬาออนไลน์", desc: "เลือกคู่แข่งขันและรายการที่สนใจได้จากหน้าเดียว ทั้งฟุตบอลและกีฬาประเภทอื่น", tag: "หมวดหลัก", icon: "⚽" },
  { name: "Auto Wallet", desc: "ฝากถอนเชื่อมกับเครดิตในบัญชีสมาชิกโดยตรง รองรับทรูวอลเล็ตและธนาคารหลัก", tag: "ช่องทางหลัก", icon: "👛" },
  { name: "ระบบออโต้", desc: "ส่งรายการฝากถอนได้ตลอด 24 ชั่วโมง เช็กเครดิตและสถานะจากบัญชีของตัวเองได้เลย", tag: "24 ชั่วโมง", icon: "🔁" },
  { name: "ระบบสมาชิก", desc: "รวมเครดิต โปรโมชั่น และประวัติรายการไว้ในพื้นที่เดียว ตรวจสอบบัญชีได้ง่ายขึ้น", tag: "บัญชีเดียว", icon: "🧾" },
  { name: "เล่นผ่านมือถือ", desc: "สมัคร เข้าสู่ระบบ และเลือกบริการผ่านเบราว์เซอร์มือถือได้โดยไม่ต้องพึ่งคอม", tag: "ทุกอุปกรณ์", icon: "📱" },
];
---

<section aria-label="หมวดเกมและบริการที่ ANKERSPIN รวมไว้ในบัญชีเดียว" class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#ffa6d5] via-[#ff2d8f] to-[#ff6bb5] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      หมวดเกมและบริการที่ <span class="text-[#ff2d8f]">ANKERSPIN</span> รวมไว้ในบัญชีเดียว
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#ff2d8f] to-transparent"></div>
  </div>

  <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4 lg:gap-5 xl:grid-cols-7">
    {
      providers.map((provider) => (
        <a
          href="/register"
          class="group relative flex flex-col items-center justify-center overflow-hidden rounded-2xl border border-[#ff2d8f]/35 bg-[#2c0a1a]/92 p-5 shadow-[0_10px_30px_rgba(13,2,7,0.6)] backdrop-blur-md transition-all duration-300 hover:-translate-y-2 hover:border-[#ff6bb5]/55 hover:bg-[#3d0f24]/95 hover:shadow-[0_15px_40px_rgba(255,45,143,0.38)]">
          <div class="pointer-events-none absolute inset-0 bg-[#6d0a42]/45 opacity-0 transition-opacity duration-300 group-hover:opacity-100" />

          <div class="absolute top-2 right-2 z-10 rounded-full bg-gradient-to-r from-[#ffa6d5] via-[#ff6bb5] to-[#a4126b] px-2 py-0.5 text-[9px] font-black tracking-wide whitespace-nowrap text-[#0d0207] shadow-sm transition-transform duration-300 group-hover:scale-110">
            {provider.tag}
          </div>

          <div aria-hidden="true" class="mb-3 text-4xl transition-transform duration-300 group-hover:scale-125 group-hover:rotate-3">
            {provider.icon}
          </div>
          <p class="text-center text-sm font-black text-[#f9dcec] transition-colors group-hover:text-[#ffa6d5]">{provider.name}</p>
          <p class="mt-1 text-center text-[10px] text-[#f9dcec]/70">{provider.desc}</p>

          <span class="relative z-10 mt-4 block w-full rounded-full border border-[#ff6bb5]/30 bg-[#0d0207] py-1.5 text-center text-[11px] font-bold text-[#ff6bb5] shadow-inner transition-colors duration-300 group-hover:border-[#ff6bb5]/60 group-hover:bg-gradient-to-r group-hover:from-[#ffa6d5] group-hover:via-[#ff6bb5] group-hover:to-[#a4126b] group-hover:text-[#0d0207]">
            เข้าดูหมวดนี้
          </span>
        </a>
      ))
    }
  </div>
</section>
