---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxCyberCut.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";

import { Picture } from "astro:assets";

import pro2 from "../assets/slide2.png";
import pro3 from "../assets/slide3.png";
import pro4 from "../assets/slide4.png";
import { pageGraph } from "../lib/schema";

const pageTitle = "โปรโมชั่น 888NEO";

const pageDescription =
  "รวมภาพโปรโมชั่นของ 888NEO ไว้ครบในหน้าเดียว ทั้งโบนัสสมาชิกใหม่ โบนัสฝากแรก และสิทธิ์สำหรับสมาชิกเก่า อ่านเงื่อนไขและเกมที่ร่วมรายการบนภาพก่อนกดรับสิทธิ์";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: pro2.src,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="โปรโมชั่น 888NEO" as="h1">
    <p class="mb-8 text-left text-base leading-relaxed text-[#f3e3c6]">
      หน้านี้รวมภาพโปรโมชั่นที่ <strong class="text-[#f5c542]">888NEO</strong> เปิดให้สมาชิกเลือกใช้ ทั้งสล็อต คาสิโนสด และสิทธิ์ที่มาพร้อมระบบออโต้
      แต่ละรายการมีเกมที่ร่วม ยอดเริ่มต้น และเงื่อนไขถอนไม่เท่ากัน จึงควรอ่านรายละเอียดบนภาพให้ครบก่อนกดรับสิทธิ์ทุกครั้ง
      เลือกโปรที่ตรงกับรูปแบบการเล่นได้แล้ว สมัครสมาชิกจากปุ่มด้านล่างเพื่อเริ่มใช้สิทธิ์ได้ทันที
    </p>

    <div class="grid w-full grid-cols-1 gap-6 sm:grid-cols-2">
      <Picture
        src={pro2}
        alt="ภาพโปรโมชั่น 888NEO โลโก้ 888NEO อยู่ด้านบน ข้อความใหญ่ว่า เว็บสล็อต คาสิโนสด ระบบออโต้ เข้าเล่นผ่านมือถือง่ายๆ กลางภาพเป็นโทรศัพท์ที่เปิดหน้าล็อบบี้ 888NEO แสดงเครดิต 88,888.00 พร้อมแถวเกมให้เลือก ด้านล่างเขียนว่า ฝากถอนเร็ว 24 ชม. และ สมัครง่าย เล่นได้เลย มีพรีเซนเตอร์หญิงชุดเลื่อมสีแดงยืนอยู่ข้างกองเหรียญทอง"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class="mx-auto h-auto w-full rounded-xl border border-[#8c0f12]/70 object-contain shadow-[0_10px_30px_rgba(224,27,27,0.22)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#f5c542]/60 hover:shadow-[0_15px_40px_rgba(245,197,66,0.28)]"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />

      <Picture
        src={pro3}
        alt="ภาพโปรโมชั่น 888NEO มีโลโก้ 888NEO ทั้งด้านบนและด้านล่าง ข้อความใหญ่ว่า สมัครง่าย เล่นผ่านมือถือ ตามด้วยบรรทัด เว็บสล็อต คาสิโนสด และ ระบบออโต้ ฝากถอนสะดวก กลางภาพมีชิปคาสิโนสามใบเขียนว่า รวมเกมสล็อต คาสิโนสด และ เข้าเล่นง่าย 24 ชม. ปิดท้ายด้วยปุ่มสีแดงเขียนว่า สมัครสมาชิก"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class="mx-auto h-auto w-full rounded-xl border border-[#8c0f12]/70 object-contain shadow-[0_10px_30px_rgba(224,27,27,0.22)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#f5c542]/60 hover:shadow-[0_15px_40px_rgba(245,197,66,0.28)]"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />

      <Picture
        src={pro4}
        alt="ภาพโปรโมชั่น 888NEO ข้อความใหญ่ว่า 888NEO สล็อตเกมฮิต ตามด้วยบรรทัด คาสิโนสด ระบบออโต้ เล่นผ่านมือถือ กลางภาพเป็นโทรศัพท์ที่แสดงวงล้อสล็อตพร้อมยอด WIN 8,888.00 ล้อมด้วยป้ายเขียนว่า เริ่มต้น 1 บาท ฝากถอนเร็ว 24 ชม. และ สมัครง่าย เล่นได้ทันที ด้านล่างเป็นไหเหรียญทองล้นออกมา"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class="mx-auto h-auto w-full rounded-xl border border-[#8c0f12]/70 object-contain shadow-[0_10px_30px_rgba(224,27,27,0.22)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#f5c542]/60 hover:shadow-[0_15px_40px_rgba(245,197,66,0.28)]"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />
    </div>

    <div class="mt-12 flex justify-center pb-4">
      <a
        href="/register"
        class="flex items-center justify-center rounded-lg border border-[#ff5a4d]/60 bg-gradient-to-r from-[#ffe9a8] via-[#f5c542] to-[#b8860b] px-10 py-3.5 text-lg font-black text-[#0b0503] shadow-[0_10px_30px_rgba(224,27,27,0.28)] transition-transform hover:scale-105 hover:shadow-[0_15px_40px_rgba(245,197,66,0.4)]">
        สมัครสมาชิก 888NEO
      </a>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
