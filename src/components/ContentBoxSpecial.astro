---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h2" } = Astro.props;
---

<section class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#f6c9c6] bg-white p-6 text-[#2d1214] shadow-[0_10px_30px_rgba(230,0,18,0.12)] transition-all duration-500 hover:border-[#e60012]/45 md:p-10">
    <div
      aria-hidden="true"
      class="pointer-events-none absolute top-0 left-1/2 -z-10 h-[3px] w-1/2 -translate-x-1/2 bg-gradient-to-r from-transparent via-[#e60012] to-transparent opacity-60 transition-opacity duration-500 group-hover:opacity-100">
    </div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#f6c9c6] pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#e60012] to-[#d4a017] shadow-[0_0_10px_rgba(230,0,18,0.35)]" />
          <HeadingTag class="bg-gradient-to-r from-[#8a0208] via-[#e60012] to-[#8a6410] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-2 lg:gap-10">
      <article
        class="relative flex gap-4 rounded-2xl border border-[#f6c9c6] bg-[#fff7f6] p-6 text-left text-base leading-relaxed text-[#2d1214] transition-all duration-300 hover:-translate-y-2 hover:border-[#e60012]/45 hover:bg-[#ffe9e7] hover:shadow-[0_15px_40px_rgba(230,0,18,0.16)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#b30009]/40 bg-gradient-to-br from-[#ff4b41] via-[#e60012] to-[#b30009] text-2xl shadow-[0_5px_15px_rgba(230,0,18,0.28)]">
          ⚙️
        </div>
        <slot name="left" />
      </article>

      <article
        class="relative flex gap-4 rounded-2xl border border-[#f6c9c6] bg-[#fff7f6] p-6 text-left text-base leading-relaxed text-[#2d1214] transition-all duration-300 hover:-translate-y-2 hover:border-[#d4a017]/60 hover:bg-[#ffe9e7] hover:shadow-[0_15px_40px_rgba(212,160,23,0.20)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#8a6410]/40 bg-gradient-to-br from-[#ffe9a8] via-[#f5c542] to-[#d4a017] text-2xl shadow-[0_5px_15px_rgba(212,160,23,0.28)]">
          🎯
        </div>
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
