---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement2.astro";
import CtaRedirect from "../components/CtaRedirect.astro";
import { pageGraph } from "../lib/schema";

const pageDescription =
  "สมัครสมาชิก WON22 เปิดยูสใหม่ผ่านมือถือจบในไม่กี่นาที กดปุ่มเดียวไปยังหน้าสมัคร รับโปรสมาชิกใหม่ แล้วใช้ยูสเดียวเล่นสล็อตออนไลน์เว็บตรงพร้อมฝากถอนออโต้";

const graph = pageGraph(Astro, {
  name: "สมัครสมาชิก WON22 สล็อตออนไลน์เว็บตรง ไม่ติดเทิร์น",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "สมัครสมาชิก", path: "/register" },
  ],
});

const targetUrl = "https://yoalink.com/22hs";
---

<MainLayout title="สมัครสมาชิก WON22 | ปุ่มเปิดยูสใหม่ผ่านมือถือ รับโปรสมาชิกใหม่" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="สมัครสมาชิก WON22" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label="สมัครสมาชิก WON22"
        class="group relative mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#b45309]/60 bg-gradient-to-b from-[#fcd34d] to-[#fbbf24] px-6 py-4 text-xl font-bold tracking-wide text-[#180a03] shadow-[0_10px_30px_rgba(251,191,36,0.20)] transition-all duration-300 hover:scale-105 hover:border-[#f97316]/70 hover:shadow-[0_15px_40px_rgba(249,115,22,0.24)]">
        สมัครสมาชิก WON22
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="สมัครสมาชิก" />
</MainLayout>
