---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import ContentBoxTwo from "../components/ContentBoxTwo.astro";
import ContentBoxSevenThree from "../components/ContentBoxSevenThree.astro";
import ContentBoxThreeColums from "../components/ContentBox3Three.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement4.astro";
import SmoothCarousel from "../components/SmoothCarousel.astro";
import ProviderGrid from "../components/ProviderGrid.astro";
import LatestWinners from "../components/LatestWinners.astro";

import { Picture } from "astro:assets";
import image1 from "../assets/pro1.webp";
import image2 from "../assets/pro2.jpg";
import image3 from "../assets/slide4.jpg";
import banner1 from "../assets/banner1.webp";

const currentPath = Astro.url.pathname;
const homePage = Astro.url.origin;
const logoUrl = homePage + "/logo.webp";

const webPageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: "TEENOI69 ทางเข้าเว็บตรง 2026 สมัครวันนี้ถอนได้จริง ไม่ผ่านเอเย่นต์",
  description: "TEENOI69 ทางเข้าเว็บตรง เว็บแท้ รวมความบันเทิงครบวงจรที่ TEENOI69 สล็อต คาสิโน กีฬาในที่เดียว สมัคร พร้อมรับสิทธิพิเศษ ฝากถอนได้ง่าย ระบบออโต้ จ่ายจริง",
  url: currentPath,
};

const webSiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "TEENOI69",
  alternateName: ["teeno69", "TEENOI69official", "TEENOI69officials", "TEENOI69"],
  url: "https://teenoi69z.com/",
};

const orgSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "TEENOI69",
  logo: logoUrl,
  url: homePage,
};

const allSchemas = [webPageSchema, orgSchema, webSiteSchema];
---

<MainLayout>
  <script type="application/ld+json" set:html={JSON.stringify(allSchemas)} />
  <Announcement />

  <ContentBox title="TEENOI69 ทางเข้าเว็บตรง 2026 สมัครวันนี้ถอนได้จริง ไม่ผ่านเอเย่นต์">
    <p>
      <strong class="text-amber-400">TEENOI69Z</strong> ขอต้นรับสู่ เว็บไซต์อย่างเป็นทางการที่รวมทุกความต้องการของผู้เล่นไว้ในที่เดียว เราคือ <strong class="text-amber-400">ทางเข้า TEENOI69</strong> หลักที่อัปเดตใหม่ล่าสุดในปี
      2026 เพื่อให้คุณเข้าถึงความสนุกได้โดยตรง ไม่ต้องกังวลเรื่องการโดนบล็อกหรือลิงก์เสีย มั่นใจได้ในความเป็น เว็บตรง ที่มีความมั่นคงทางการเงินสูงสุด
    </p>

    <div class="mt-3.5 flex flex-wrap justify-center gap-4">
      <a
        href="/register"
        aria-label="สมัครสมาชิก"
        class="to-red to-red to-red flex items-center justify-center rounded-lg border border-gray-400 bg-gradient-to-b from-red-900 to-red-700 px-8 py-3 font-bold text-white transition-transform hover:scale-105">
        สมัครสมาชิก
      </a>

      <a
        href="/login"
        aria-label="เข้าเล่นเกม"
        class="flex items-center justify-center rounded-lg border border-yellow-600 bg-gradient-to-b from-yellow-200 to-yellow-500 px-8 py-3 font-extrabold text-black shadow-[0_0_15px_rgba(255,215,0,0.4)] transition-transform hover:scale-105">
        เข้าเล่นเกม
      </a>

      <a
        href="/line"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="ติดต่อเราผ่าน Line"
        class="flex items-center justify-center rounded-lg border border-green-300 bg-gradient-to-b from-green-400 to-green-700 px-8 py-3 font-bold text-white transition-transform hover:scale-105">
        ติดต่อเรา
      </a>
    </div>
  </ContentBox>
  <ProviderGrid />
  <ContentBoxTwo>
    <div slot="left">
      <h2 class="text-blue-gradient mb-4 text-2xl font-bold">ทำความรู้จัก TEENOI69 เว็บแท้ที่ออกแบบมาเพื่อผู้เล่นยุคใหม่</h2>
      <p>
        <strong class="text-amber-400">TEENOI69Z</strong> เกิดขึ้นจากความตั้งใจที่จะยกระดับการให้บริการขึ้นไปอีกขั้น เราไม่ใช่แค่เว็บไซต์เดิมพันทั่วไป แต่เราคือแพลตฟอร์มที่เน้นความโปร่งใสเป็นหัวใจหลัก ข้อมูลทุกอย่างตรวจสอบได้จริง
        ระบบหลังบ้านมีความเสถียรสูง พร้อมลบทุกภาพจำด้านลบที่คุณเคยเจอมา เพราะที่นี่เราให้ความสำคัญกับเครดิตและความเชื่อใจของสมาชิกเป็นอันดับหนึ่ง ทุกยอดการเล่นคือความปลอดภัย
      </p>
    </div>
    <div slot="right">
      <h2 class="text-blue-gradient mb-4 text-2xl font-bold">ทางเข้า TEENOI69 อัปเดตลิงก์ใหม่ทุกวัน เข้าใช้งานได้แน่นอน</h2>
      <p>
        ที่นี่คือ <strong class="text-amber-400">ทางเข้า teenoi69</strong> ที่อัปเดตแบบ Real-time ทุกวัน ทีมงานของเราตรวจสอบระบบตลอด 24 ชั่วโมง เพื่อให้มั่นใจว่าสมาชิกจะเข้าใช้งานได้ทุกแพลตฟอร์ม ทั้งมือถือและคอมพิวเตอร์
        ไม่ว่าคุณจะอยู่ที่ไหน หรือใช้เครือข่ายอะไร ก็เข้าเล่นได้ทันทีแบบไม่มีสะดุด จบปัญหาลิงก์เสียหรือหน้าเว็บโดนแบนอย่างถาวร
      </p>
    </div>
  </ContentBoxTwo>
  <ContentBox>
    <h2 class="text-blue-gradient mb-7 text-2xl font-semibold">ระบบฝาก-ถอนออโต้ของ TEENOI69 รวดเร็ว ทันใจ มั่นใจทุกยอดถอน</h2>
    <p>
      ระบบฝาก-ถอนของ <strong class="text-amber-400">TEENOI69Z</strong> เป็นระบบออโต้ 100% ที่ทำงานได้รวดเร็ว ทำรายการเสร็จภายในไม่กี่วินาที หมดปัญหาเรื่องยอดไม่เข้าหรือรอนานจนน่ารำคาญ ยืนยันจากผู้ใช้งานจริงว่าที่นี่
      ถอนได้จริง ทุกยอด ไม่ว่าจะเป็นกำไรหลักร้อยหรือรางวัลใหญ่หลักล้าน เราจ่ายครบ จ่ายไว และไม่มีเงื่อนไขยุ่งยาก เพราะเราคือเว็บตรงที่ไม่ผ่านเอเย่นต์
    </p>
  </ContentBox>
  <SmoothCarousel />
  <LatestWinners />
  <ContentBox>
    <h2 class="text-blue-gradient mb-7 text-2xl font-semibold">สมัครสมาชิก TEENOI69 ง่ายๆ ใน 3 ขั้นตอน พร้อมรับสิทธิพิเศษ</h2>
    <p>
      เริ่มต้นความสนุกและรับประสบการณ์ที่ดีกว่าเดิมได้ง่ายๆ เพียง ทำดังนี้
      <ol class="mt-3 list-inside list-decimal space-y-2">
        <li>สมัครสมาชิก: คลิกปุ่มสมัครบนหน้าเว็บแล้วกรอกข้อมูลเพียงเล็กน้อย</li>
        <li>ฝากเงิน: ทำรายการผ่านระบบออโต้ที่รองรับทุกธนาคารและวอเลท</li>
        <li>
          เข้าเล่น: เลือกเกมที่ชอบแล้วเริ่มต้นทำกำไรได้ทันที พิเศษสำหรับสมาชิก <strong class="text-amber-400">teenoi69z</strong> วันนี้ รับสิทธิ์เข้าร่วมกิจกรรมและโปรโมชั่นใหม่ๆ ที่เราคัดสรรมาให้คุ้มค่ากว่าใคร
        </li>
      </ol>
    </p>
  </ContentBox>
  <ContentBoxSevenThree>
    <div slot="left">
      <div class="rounded-xl p-5">
        <Picture
          src={image3}
          alt="ทางเข้า teenoi69 ล่าสุด"
          loading="lazy"
          fetchpriority="low"
          widths={[200, 400, 600, 800]}
          sizes="(max-width: 768px) 100vw, 33vw"
          class="mx-auto h-auto w-full max-w-[400px] object-contain shadow-xl"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
          fallbackFormat="webp"
        />
      </div>
    </div>
    <div slot="right">
      <h2 class="text-blue-gradient mb-7 text-2xl font-semibold">รวมความบันเทิงครบวงจรที่ TEENOI69 สล็อต คาสิโน และกีฬาในที่เดียว</h2>
      <p class="mb-5">
        ที่เดียวจบครบทุกความต้องการ ไม่ว่าคุณจะเป็นสายปั่นสล็อตแตกง่าย คอคาสิโนสดที่ส่งตรงจากค่ายดังระดับโลก หรือจะลุ้นผลกีฬาทุกแมตช์สำคัญ <strong class="text-amber-400">TEENOI69Z</strong> ก็มีให้เลือกเล่นแบบจุใจ
        พร้อมระบบ API แท้ที่ช่วยให้การเดิมพันของคุณลื่นไหล ยุติธรรม และมีโอกาสทำกำไรได้มากกว่าเดิม
      </p>
    </div>
  </ContentBoxSevenThree>

  <Navfoot />

  <style>
    .text-blue-gradient {
      background: linear-gradient(to bottom, #ea0000 0%, #e92a2a 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }
  </style>
</MainLayout>
