---
const {
  message = "77RUAY สล็อตออนไลน์ เล่นผ่านเบราว์เซอร์ได้ทั้ง iOS และ Android ไม่ต้องโหลดแอป • ฝากถอนออโต้ตลอด 24 ชั่วโมง ไม่ต้องแนบสลิป • สมัคร ฝาก เล่น และถอนจบบนมือถือเครื่องเดียว • มีเรื่องติดขัดติดต่อแอดมินผ่านช่องทางบนหน้าเว็บ",
} = Astro.props;

const SCROLL_PX_PER_SEC = 55;
const PX_PER_CHAR = 6.2;
const scrollSeconds = Math.max(14, Math.round((message.length * PX_PER_CHAR + 48) / SCROLL_PX_PER_SEC));
---

<div class="mx-auto mt-4 max-w-[900px] px-4 md:px-0">
  <div
    class="relative flex h-[46px] items-center rounded-r-full border border-[#d6e2f7] bg-white py-2 pr-4 pl-12 shadow-[0_6px_18px_rgba(10,31,92,0.10)]"
    style="background-image: linear-gradient(in oklab to right, #eef4ff, #ffffff 45%);">
    <div
      class="absolute top-1/2 -left-2 flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full border-[3px] border-[#e0a91b] shadow-[0_0_14px_rgba(224,169,27,0.40)]"
      style="background-image: linear-gradient(in oklab to bottom, #4d8ff5, #1a5fe0, #0b3a9e);">
      <span aria-hidden="true" class="text-xl">📢</span>
    </div>

    <div aria-hidden="true" class="mr-4 h-full w-[1px] bg-[#e0a91b]/40"></div>

    <div class="flex-1 overflow-hidden [mask-image:linear-gradient(90deg,transparent_0%,#000_5%,#000_95%,transparent_100%)]">
      <div class="ticker-track flex w-max gap-12 text-sm font-bold whitespace-nowrap text-[#0a1f5c]" style={`animation-duration:${scrollSeconds}s`}>
        <span>{message}</span>
        <span aria-hidden="true">{message}</span>
      </div>
    </div>
  </div>
</div>

<style>
  @keyframes announcement3-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(calc(-50% - 24px));
    }
  }

  .ticker-track {
    animation: announcement3-scroll 25s linear infinite;
  }

  @media (prefers-reduced-motion: reduce) {
    .ticker-track {
      animation: none;
    }
  }
</style>
