---
const { titleleft, titleright } = Astro.props;
---

<section
  class="mx-auto mb-3 w-full max-w-7xl rounded-[15px] border-2 border-[#c70000] bg-[#0a0000] p-8 text-center shadow-2xl"
  style="box-shadow: 0 0 14px rgba(247, 85, 85, 0.5), inset 0 0 12px rgba(247, 85, 85, 0.5)">
  <div class="grid grid-cols-1 gap-5 md:grid-cols-2 lg:grid-cols-2">
    <article class="flex flex-col gap-4">
      {titleleft && <h2 class="mb-4 text-3xl font-bold">{titleleft}</h2>}
      <div class="text-white">
        <slot name="left" />
      </div>
    </article>

    <article class="flex flex-col gap-4">
      {titleright && <h2 class="mb-4 text-3xl font-bold">{titleright}</h2>}
      <div class="text-white">
        <slot name="right" />
      </div>
    </article>
  </div>
</section>
<style>
  .bg-red-gold-oklab {
    background-image: linear-gradient(in oklab to right, #1b8d3b, #399537, #27a544);
  }
</style>
