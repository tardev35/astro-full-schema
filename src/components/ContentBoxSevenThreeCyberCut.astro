---
export interface Props {
  titleleft?: string;
  titleright?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { titleleft, titleright, as: HeadingTag = "h2" } = Astro.props;
---

<section class="mx-auto mb-6 w-full max-w-7xl px-4 font-sans">
  <div
    class="relative isolate w-full border border-[#f9c2d9] bg-[#ffffff]/92 p-8 text-[#7a1038] shadow-[0_10px_30px_rgba(190,24,93,0.12)] backdrop-blur-md transition-all duration-300 hover:border-[#ec4899]/60 hover:shadow-[0_15px_40px_rgba(236,72,153,0.18)]"
    style="clip-path: polygon(30px 0, 100% 0, 100% calc(100% - 30px), calc(100% - 30px) 100%, 0 100%, 0 30px);">
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-[2px] w-24 bg-gradient-to-r from-[#ec4899] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-[2px] w-24 bg-gradient-to-l from-[#f7c948] to-transparent"></div>
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-16 w-[2px] bg-gradient-to-b from-[#ec4899] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-16 w-[2px] bg-gradient-to-t from-[#f7c948] to-transparent"></div>

    <div class="grid grid-cols-1 gap-8 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#7a1038]">
        {
          titleleft && (
            <div class="flex items-baseline gap-2 border-b border-[#f9c2d9] pb-2">
              <span aria-hidden="true" class="font-mono text-[#ec4899]">
                &gt;_
              </span>
              <HeadingTag class="text-xl leading-normal font-black text-[#9d174d] uppercase">{titleleft}</HeadingTag>
            </div>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#7a1038] md:border-l md:border-[#f9c2d9] md:pl-8">
        {
          titleright && (
            <div class="flex items-baseline gap-2 border-b border-[#f9c2d9] pb-2">
              <span aria-hidden="true" class="font-mono text-[#ec4899]">
                &gt;_
              </span>
              <HeadingTag class="text-xl leading-normal font-black text-[#9d174d] uppercase">{titleright}</HeadingTag>
            </div>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
