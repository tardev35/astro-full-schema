---
const reviews = [
  {
    name: "สมาชิกใหม่ที่เริ่มจากงบเบา ๆ",
    role: "ใช้สิทธิ์รับฟรี 18 บาทสำรวจระบบก่อนเติมเอง",
    stars: 5,
    tag: "สมาชิกใหม่รับฟรี 18 บาท",
    content:
      "สิทธิ์รับฟรี 18 บาทของสมาชิกใหม่ช่วยให้ได้ลองเปิดเมนู เลือกเกมที่สนใจ และดูว่าหมวดไหนถูกใจก่อนจะเพิ่มเครดิตด้วยตัวเอง ขั้นตอนรับสิทธิ์ผูกกับการสมัครสมาชิกและยืนยันข้อมูล พอบัญชีพร้อมใช้งานก็กดรับจากหน้าสมาชิกได้ ถือว่าเริ่มต้นแบบไม่ต้องเปิดเกมพร้อมเปิดกระเป๋าหนักตั้งแต่นาทีแรก",
    avatar: "🎁",
  },
  {
    name: "สมาชิกที่เล่นหลายหมวดในวันเดียว",
    role: "สลับสล็อต คาสิโนสด และกีฬาจากบัญชีเดียว",
    stars: 5,
    tag: "บัญชีเดียวครบทุกหมวด",
    content:
      "ลองสลับจากสล็อตไปคาสิโนและกีฬาแล้วระบบยังใช้เครดิตจากบัญชีเดียว ไม่ต้องโอนยอดแยกระหว่างหมวดจึงเปลี่ยนเกมได้ต่อเนื่อง คาสิโนมีเกมโต๊ะยอดนิยม ส่วนหมวดกีฬาจัดคู่แข่งขันและตลาดเดิมพันเป็นหมวดชัด เปลี่ยนจากโต๊ะสดไปดูบอลได้เร็วพอ ๆ กับเปลี่ยนช่องทีวี เพียงแต่ตื่นเต้นกว่านิดหน่อย",
    avatar: "🎴",
  },
  {
    name: "สมาชิกที่ใช้ระบบฝากถอนอัตโนมัติ",
    role: "เปิดประวัติธุรกรรมดูสถานะก่อนกดซ้ำทุกครั้ง",
    stars: 4,
    tag: "ฝากถอนอัตโนมัติและโปรโมชั่น",
    content:
      "ระบบฝากถอนอัตโนมัติช่วยลดเวลารอ และตรวจสถานะรายการกับประวัติธุรกรรมได้จากหน้าบัญชีโดยไม่ต้องทักถามทุกขั้นตอน ส่วนโปรโมชั่นควรแยกให้ชัดว่าเครดิตฟรี 38 บาทมาจากการเข้าร่วมกิจกรรม ขณะที่รางวัลชวนเพื่อน 88 บาทให้จากการแนะนำผู้ใช้ใหม่ ต่างเป้าหมายกันแต่เพิ่มความคุ้มค่าให้บัญชีเหมือนกัน",
    avatar: "🔁",
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label="เสียงจากสมาชิก OKG777" class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#ffe94d] via-[#ffd400] to-[#ff4fd8] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      เสียงจากสมาชิก <span class="text-[#ff4fd8]">OKG777</span>
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#ffd400] to-transparent"></div>
  </div>

  <div class="mx-auto mb-8 flex max-w-md items-center justify-center gap-5 rounded-2xl border border-[#ffd400]/25 bg-[#170733]/92 px-6 py-4 shadow-[0_10px_30px_rgba(255,212,0,0.18)] backdrop-blur-xl">
    <div class="flex flex-col items-center">
      <span class="bg-gradient-to-b from-[#ffe94d] to-[#b8860a] bg-clip-text text-4xl leading-none font-black text-transparent">{average}</span>
      <span class="mt-1 text-[10px] font-bold tracking-widest text-[#b9a8d8] uppercase">คะแนนเฉลี่ย</span>
    </div>
    <div class="h-12 w-px bg-[#33195c]"></div>
    <div class="flex flex-col gap-1.5">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#ffd400]" : "text-[#33195c]"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#b9a8d8]">คะแนนเฉลี่ย {average} จาก 5 ดาว จากการใช้งานจริงของสมาชิก {reviews.length} ด้าน</span>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
    {
      reviews.map((review) => (
        <article class="group relative isolate flex flex-col gap-4 overflow-hidden rounded-2xl border border-[#ffd400]/25 bg-[#170733]/92 p-6 text-left shadow-[0_10px_30px_rgba(255,212,0,0.18)] backdrop-blur-xl transition-all duration-300 hover:-translate-y-1 hover:border-[#ffd400]/50 hover:shadow-[0_15px_40px_rgba(255,212,0,0.3)]">
          <span class="absolute inset-y-0 left-0 -z-10 w-1 bg-gradient-to-b from-[#ffe94d] to-[#b8860a] opacity-80 transition-opacity duration-300 group-hover:opacity-100" />
          <span class="pointer-events-none absolute -top-14 -right-14 -z-10 h-32 w-32 rounded-full bg-[#8f1080]/45 blur-[50px] transition-all duration-300 group-hover:bg-[#ff4fd8]/45" />

          <div class="flex items-center justify-between gap-3">
            <span class="inline-flex items-center gap-1.5 rounded-full border border-[#ffd400]/25 bg-[#0d0320] px-3 py-1 text-[10px] font-bold tracking-widest text-[#ffd400] uppercase">
              <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#ff4fd8]" />
              {review.tag}
            </span>
            <span class="flex gap-0.5 text-sm">
              <span aria-hidden="true" class="flex gap-0.5">
                {Array.from({ length: 5 }).map((_, i) => (
                  <span class={i < review.stars ? "text-[#ffd400]" : "text-[#33195c]"}>★</span>
                ))}
              </span>
              <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
            </span>
          </div>

          <p class="text-left text-base leading-relaxed text-[#ece2fb]">{review.content}</p>

          <div class="mt-auto flex items-center gap-3 border-t border-[#33195c] pt-4">
            <span aria-hidden="true" class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#ffd400]/30 bg-gradient-to-br from-[#ffe94d] via-[#ffd400] to-[#b8860a] text-xl shadow-inner transition-transform duration-300 group-hover:scale-110">
              {review.avatar}
            </span>
            <span class="flex flex-col">
              <span class="text-sm font-black text-[#ece2fb] transition-colors group-hover:text-[#ffe94d]">{review.name}</span>
              <span class="text-[10px] font-bold tracking-wider text-[#b9a8d8] uppercase">{review.role}</span>
            </span>
          </div>
        </article>
      ))
    }
  </div>
</section>
