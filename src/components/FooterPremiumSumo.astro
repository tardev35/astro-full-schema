---
import { Picture } from "astro:assets";
import BankStrip from "./BankStrip.astro";
import { BRAND_ADDRESS } from "../lib/brandProfile";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });
const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;
---

<footer class="relative mt-16 w-full overflow-hidden rounded-t-[3rem] border-t border-[#f6c475]/60 bg-[#0e0402] pt-16 pb-8 font-sans text-[#f7e6d4] shadow-[0_-15px_40px_rgba(255,122,24,0.25)]">
  <div class="pointer-events-none absolute inset-x-0 -top-20 mx-auto h-[250px] w-full max-w-4xl rounded-full bg-[#ff7a18]/20 blur-[100px]"></div>
  <div class="pointer-events-none absolute inset-x-0 -bottom-24 mx-auto h-[220px] w-full max-w-2xl rounded-full bg-[#8d2b09]/30 blur-[100px]"></div>

  <div class="relative z-10 mx-auto w-full max-w-[1200px] px-6">
    <div class="mb-12 grid grid-cols-1 gap-12 md:grid-cols-12">
      <div class="flex flex-col gap-5 md:col-span-5">
        <a href="/" class="inline-block max-w-max rounded-xl border border-[#f6c475]/30 bg-[#24100a] px-4 py-2 transition-transform duration-300 hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt="โลโก้ YIMSIAM88 รูปหน้าจั่ววัดไทยสีทองมีลายกนกและช่อฟ้า ด้านล่างเขียนว่า Yimsiam88"
                class="h-[50px] w-auto object-contain"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <span class="text-3xl font-black tracking-widest text-[#f7e6d4]">
                YIMSIAM<span class="text-[#f6c475]">88</span>
              </span>
            )
          }
        </a>
        <p class="border-l-2 border-[#f6c475]/50 pl-4 text-sm leading-relaxed text-[#c9b6a3]">
          YIMSIAM88 (ยิ้มสยาม88) สล็อตเว็บตรงไทยแท้ เกมรันด้วยระบบ RNG มาตรฐานโลก โบนัสแตกตามธรรมชาติ ฝากถอนออโต้ไม่มีขั้นต่ำ รองรับทุกช่องทางรวมถึงวอเล็ท และจ่ายเต็มไม่มีหักทุกยอด
        </p>
        <div class="mt-4 flex flex-wrap gap-3">
          <span class="rounded-full border border-[#f6c475]/30 bg-[#24100a] px-4 py-1 text-xs font-medium text-[#f6c475] backdrop-blur-sm">จ่ายเต็มไม่มีหัก</span>
          <span class="rounded-full border border-[#ff7a18]/40 bg-[#2a0f06] px-4 py-1 text-xs font-medium text-[#ffb37a] backdrop-blur-sm">ฝาก–ถอนไม่มีขั้นต่ำ</span>
        </div>
      </div>

      <nav class="flex flex-col gap-4 md:col-span-3 lg:pl-8">
        <p class="text-lg font-black tracking-widest text-[#f7e6d4] uppercase drop-shadow-sm">ทางลัด</p>
        <div class="h-[1px] w-12 bg-[#f6c475]"></div>
        <ul class="flex flex-col gap-3 text-sm font-medium text-[#c9b6a3]">
          <li><a href="/" class="transition-colors hover:text-[#f6c475]">หน้าหลัก</a></li>
          <li><a href="/promotion" class="transition-colors hover:text-[#f6c475]">โปรโมชั่น</a></li>
          <li><a href="/ทดลองเล่น" class="transition-colors hover:text-[#f6c475]">ทดลองเล่น</a></li>
          <li><a href="/ทางเข้า" class="transition-colors hover:text-[#f6c475]">ทางเข้า</a></li>
          <li><a href="/about-us" class="transition-colors hover:text-[#f6c475]">เกี่ยวกับเรา</a></li>
          <li><a href="/contact-us" class="transition-colors hover:text-[#f6c475]">ติดต่อเรา</a></li>
        </ul>
      </nav>

      <div class="flex flex-col gap-5 md:col-span-4">
        <p class="text-lg font-black tracking-widest text-[#f7e6d4] uppercase drop-shadow-sm">บริการลูกค้า 24 ชม.</p>
        <div class="h-[1px] w-12 bg-[#f6c475]"></div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] py-3.5 font-bold text-white shadow-[0_5px_15px_rgba(0,185,0,0.3)] transition-all hover:-translate-y-1 hover:shadow-[0_8px_20px_rgba(0,185,0,0.4)]">
          ติดต่อแอดมิน LINE
        </a>

        {
          BRAND_ADDRESS.lines.length > 0 && (
            <address aria-label={BRAND_ADDRESS.label} class="mt-2 rounded-xl border border-white/15 bg-black/20 p-4 text-xs leading-relaxed not-italic opacity-90">
              <p class="mb-2 flex items-center gap-2 text-[11px] font-bold tracking-wider uppercase opacity-80">
                <span aria-hidden="true" class="text-sm">
                  📍
                </span>
                {BRAND_ADDRESS.label}
              </p>
              {BRAND_ADDRESS.lines.map((line) => (
                <span class="block">{line}</span>
              ))}
              {BRAND_ADDRESS.email && (
                <a href={`mailto:${BRAND_ADDRESS.email}`} class="mt-3 inline-flex items-center gap-2 font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                  <span aria-hidden="true" class="text-sm">
                    ✉️
                  </span>
                  {BRAND_ADDRESS.email}
                </a>
              )}
            </address>
          )
        }

        <div class="mt-4 text-xs font-medium tracking-widest text-[#c9b6a3] uppercase">Supported Payments</div>
        <BankStrip size={30} />
      </div>
    </div>

    <div class="flex flex-col items-center justify-between border-t border-[#8d2b09]/60 pt-8 text-xs font-medium tracking-wide text-[#c9b6a3] md:flex-row">
      <p>COPYRIGHT &copy; {new Date().getFullYear()} YIMSIAM88-HOMEPAGE.NET. ALL RIGHTS RESERVED.</p>
      <div class="mt-4 flex gap-4 md:mt-0">
        <a href="/terms/" class="transition-colors hover:text-[#f6c475]">เงื่อนไขข้อตกลง</a>
        <a href="/privacy/" class="transition-colors hover:text-[#f6c475]">นโยบายความเป็นส่วนตัว</a>
      </div>
    </div>
  </div>
</footer>

<style>
  footer a {
    text-decoration: none;
    font-family: var(--font-sans);
  }
  footer {
    font-family: var(--font-sans);
  }
</style>
