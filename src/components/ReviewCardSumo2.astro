---
const reviews = [
  {
    name: "สมาชิกที่ปั่นสล็อตทุกวัน",
    role: "เล่นผ่านค่ายที่เชื่อม API แท้",
    stars: 5,
    tag: "API แท้",
    content:
      "กด Login แล้วเลือกค่ายได้เลยครับ เกมเชื่อมตรงจากค่ายแม่ ภาพกับเสียงเดินต่อเนื่องไม่มีดีเลย์ ก่อนเริ่มหมุนผมเปิดดูตารางจ่ายกับข้อมูล RTP ของเกมนั้นจากหน้าเกมก่อนทุกที",
    avatar: "🎰",
  },
  {
    name: "สมาชิกที่ถอนยอดเป็นประจำ",
    role: "ตรวจสถานะรายการก่อนกดยืนยัน",
    stars: 5,
    tag: "ถอนเต็มจำนวน",
    content:
      "ถอนหลักพันหรือหลักหมื่นก็เด้งไวเท่ากันค่ะ ไม่แบ่งจ่าย ไม่จำกัดรอบ ส่วนตัวจะเช็กยอดคงเหลือกับสถานะรายการก่อนยืนยันทุกครั้ง แล้วอ่านเงื่อนไขของสิทธิ์ที่ใช้อยู่ให้จบก่อนถอน",
    avatar: "💰",
  },
  {
    name: "สมาชิกที่สลับเครื่องบ่อย",
    role: "ใช้ทั้งมือถือและคอมพิวเตอร์",
    stars: 5,
    tag: "กระเป๋าเดียว",
    content: "กลางวันเล่นบนมือถือ กลับถึงบ้านค่อยต่อบนคอมครับ ใช้ข้อมูลบัญชีชุดเดิมได้เลย ย้ายค่ายก็ไม่ต้องโยกเงิน เมนูไม่บังหน้าจอเกม สลับไปมาแล้วไม่ต้องตั้งค่าอะไรเพิ่ม",
    avatar: "📱",
  },
];
const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label="เสียงจากสมาชิก SUPERCLUB168" class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#ffeeb8] via-[#ffd95e] to-[#ff9a7a] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      เสียงจากสมาชิก <span class="text-[#ff9a7a]">SUPERCLUB168</span>
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#f7d046] to-transparent"></div>
  </div>

  <div class="mx-auto mb-8 flex max-w-md items-center justify-center gap-5 rounded-2xl border border-[#0e2150] bg-[#03091f] px-6 py-4 shadow-[0_10px_30px_rgba(247,208,70,0.18)]">
    <div class="flex flex-col items-center">
      <span class="bg-gradient-to-b from-[#ffeeb8] to-[#ffd95e] bg-clip-text text-4xl leading-none font-black text-transparent">{average}</span>
      <span class="mt-1 text-[10px] font-bold tracking-widest text-[#cdb888] uppercase">คะแนนเฉลี่ย</span>
    </div>
    <div class="h-12 w-px bg-[#0e2150]"></div>
    <div class="flex flex-col gap-1.5">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#ff5a4a]" : "text-[#16305f]"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#cdb888]">คะแนนเฉลี่ย {average} จาก 5 ดาว จากการใช้งานจริงของสมาชิก {reviews.length} ด้าน</span>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
    {
      reviews.map((review) => (
        <article class="group relative isolate flex flex-col gap-4 overflow-hidden rounded-2xl border border-[#0e2150] bg-[#03091f] p-6 text-left shadow-[0_10px_30px_rgba(247,208,70,0.16)] transition-all duration-300 hover:-translate-y-1 hover:border-[#f7d046]/55 hover:shadow-[0_15px_40px_rgba(247,208,70,0.28)]">
          <span aria-hidden="true" class="absolute inset-y-0 left-0 -z-10 w-1 bg-gradient-to-b from-[#f7d046] to-[#e12b27] opacity-80 transition-opacity duration-300 group-hover:opacity-100" />
          <span aria-hidden="true" class="pointer-events-none absolute -top-14 -right-14 -z-10 h-32 w-32 rounded-full bg-[#f7d046]/16 blur-[50px] transition-all duration-300 group-hover:bg-[#e12b27]/18" />

          <div class="flex items-center justify-between gap-3">
            <span class="inline-flex items-center gap-1.5 rounded-full border border-[#0e2150] bg-[#071230] px-3 py-1 text-[10px] font-bold tracking-widest text-[#ffe38a] uppercase">
              <span aria-hidden="true" class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#f7d046]" />
              {review.tag}
            </span>
            <span class="flex gap-0.5 text-sm">
              <span aria-hidden="true" class="flex gap-0.5">
                {Array.from({ length: 5 }).map((_, i) => (
                  <span class={i < review.stars ? "text-[#ff5a4a]" : "text-[#16305f]"}>★</span>
                ))}
              </span>
              <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
            </span>
          </div>

          <p class="text-left text-base leading-relaxed text-[#f5e7c2]">{review.content}</p>

          <div class="mt-auto flex items-center gap-3 border-t border-[#0e2150] pt-4">
            <span
              aria-hidden="true"
              class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#63120a] bg-gradient-to-br from-[#ff9a7a] via-[#e12b27] to-[#a31a12] text-xl shadow-inner transition-transform duration-300 group-hover:scale-110">
              {review.avatar}
            </span>
            <span class="flex flex-col">
              <span class="text-sm font-black text-[#ffe38a] transition-colors group-hover:text-[#ffeeb8]">{review.name}</span>
              <span class="text-[10px] font-bold tracking-wider text-[#cdb888] uppercase">{review.role}</span>
            </span>
          </div>
        </article>
      ))
    }
  </div>
</section>
