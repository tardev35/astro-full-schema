---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#f1d2d3] bg-white p-8 text-left text-base leading-relaxed text-[#2b2627] shadow-[0_10px_30px_rgba(20,20,20,0.06)] transition-all duration-500 hover:border-[#e9b7b9] hover:shadow-[0_15px_40px_rgba(236,27,36,0.12)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute top-0 left-0 -z-10 h-1.5 w-full bg-gradient-to-r from-[#ec1b24] via-[#ff4d55] to-[#b5121a]"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#ec1b24]/6 blur-[60px] transition-all duration-500 group-hover:bg-[#ec1b24]/10"></div>

    {
      title && (
        <header class="mb-6 flex items-center gap-4 border-b border-[#f1d2d3] pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ff4d55] to-[#b5121a]" />
          <HeadingTag class="text-2xl leading-normal font-black tracking-wide text-[#141414]">{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
