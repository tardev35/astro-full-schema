---
export interface FaqItem {
  q: string;
  a: string;
}

export interface Props {
  title?: string;
  faqs?: FaqItem[];
}

const { title, faqs = [] } = Astro.props;
---

<div class="mx-auto max-w-[1000px] px-4 py-10 font-sans">
  {
    title && (
      <div
        class="mb-8 flex items-center gap-3 border-l-4 border-[#21d4f2] bg-gradient-to-r from-[#062a4f] via-[#062a4f]/60 to-transparent px-4 py-2.5"
        style="clip-path: polygon(0 0, 100% 0, calc(100% - 15px) 100%, 0 100%);">
        <h2 class="text-xl leading-normal font-black tracking-widest text-[#7fe6ff] uppercase md:text-2xl">{title}</h2>
      </div>
    )
  }

  <div class="space-y-4">
    {
      faqs.map((faq) => (
        <details
          name="faq-terminal"
          class="faq-item group relative overflow-hidden border border-[#21d4f2]/25 bg-[#04182f]/92 backdrop-blur-sm transition-all duration-300 hover:border-[#21d4f2]/50 hover:shadow-[0_15px_40px_rgba(33,212,242,0.30)]"
          style="clip-path: polygon(15px 0, 100% 0, 100% calc(100% - 15px), calc(100% - 15px) 100%, 0 100%, 0 15px);">
          <div aria-hidden="true" class="absolute top-0 left-0 h-[2px] w-16 bg-gradient-to-r from-[#fdb524] to-transparent" />

          <summary class="flex w-full cursor-pointer items-center justify-between p-5 text-left transition-all">
            <h3 class="flex items-center gap-2 text-base leading-normal font-bold text-[#dbeefb] transition-colors group-hover:text-[#7fe6ff] md:text-lg">
              <span aria-hidden="true" class="font-mono text-[#fdb524]">
                &gt;_
              </span>
              {faq.q}
            </h3>

            <span
              aria-hidden="true"
              class="faq-icon ml-4 flex h-8 w-8 shrink-0 items-center justify-center border border-[#21d4f2]/30 bg-[#062a4f] text-lg font-black text-[#21d4f2] transition-all duration-300 group-hover:border-[#21d4f2]/50 group-hover:text-[#7fe6ff]"
              style="clip-path: polygon(25% 0, 100% 0, 100% 75%, 75% 100%, 0 100%, 0 25%);">
              +
            </span>
          </summary>

          <div class="faq-answer border-t border-[#0a3a68] p-5 pt-4 text-left text-base leading-relaxed text-[#dbeefb]">{faq.a}</div>
        </details>
      ))
    }
  </div>
</div>

<style>
  .faq-item > summary {
    list-style: none;
  }
  .faq-item > summary::-webkit-details-marker {
    display: none;
  }
  .faq-item[open] {
    border-color: rgba(33, 212, 242, 0.6);
    box-shadow: 0 15px 40px rgba(33, 212, 242, 0.3);
  }
  .faq-item[open] .faq-icon {
    transform: rotate(45deg);
    border-color: #21d4f2;
    color: #7fe6ff;
  }
  .faq-item[open] .faq-answer {
    animation: faq-reveal 0.25s ease-out;
  }

  @keyframes faq-reveal {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-item[open] .faq-answer {
      animation: none;
    }
  }
</style>
