---
const providers = [
  { name: "PG Slot", desc: "ภาพชัด เมนูไม่ซับซ้อน หลายเกมออกแบบมาให้เหมาะกับหน้าจอมือถือ เข้าเกมได้ไวจากบัญชีเดิม", tag: "สายมือถือ", icon: "🎰" },
  { name: "Pragmatic Play", desc: "รวมกลุ่มเกมที่มีฟรีสปิน ตัวคูณ และรอบโบนัสชัดเจน เลือกแนวที่ถนัดได้หลายรูปแบบ", tag: "ฟรีสปิน", icon: "🎁" },
  { name: "Joker และค่ายอื่น ๆ", desc: "วงล้อคลาสสิกที่คุ้นมือ พร้อมค่ายอื่นในระบบให้สลับไปลองธีมและฟีเจอร์ใหม่", tag: "ลองเกมใหม่", icon: "🃏" },
  { name: "คาสิโนสด", desc: "บาคาร่า รูเล็ต ไฮโล แบล็กแจ็ก และเกม Live อื่น ๆ ตามรายการที่เปิดให้บริการ", tag: "เกมโต๊ะ", icon: "🎴" },
  { name: "กีฬาและ eSports", desc: "ไม่ได้มีแค่ฟุตบอล ยังมีบาสเกตบอล เทนนิส มวย และ eSports ตามรายการแข่งขันที่เปิดอยู่", tag: "หลายชนิดกีฬา", icon: "⚽" },
  { name: "หวยออนไลน์", desc: "หวยรัฐบาลไทย หวยลาว หวยหุ้น หวยยี่กี และตลาดอื่น ๆ ตามรอบที่ระบบกำหนดไว้", tag: "เลือกตลาด", icon: "🔢" },
  { name: "ฝากถอนออโต้", desc: "เลือกเมนูฝากหรือถอน ตรวจยอดเครดิตและดูสถานะรายการได้เองจากหน้าเมมเบอร์", tag: "โอนไว", icon: "⏱️" },
];
---

<section aria-label="หมวดเกมและระบบที่ AMD365 รวมไว้ในบัญชีเดียว" class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#ffe9a8] via-[#fec93a] to-[#d4840e] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      หมวดเกมและระบบที่ <span class="text-[#fec93a]">AMD365</span> รวมไว้ในบัญชีเดียว
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#fec93a] to-transparent"></div>
  </div>

  <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4 lg:gap-5 xl:grid-cols-7">
    {
      providers.map((provider) => (
        <a
          href="/register"
          class="group relative flex flex-col items-center justify-center overflow-hidden rounded-2xl border border-[#fec93a]/40 bg-[#221703] p-5 shadow-[0_10px_30px_rgba(254,201,58,0.12)] transition-all duration-300 hover:-translate-y-2 hover:border-[#fec93a]/80 hover:bg-[#33220a] hover:shadow-[0_15px_40px_rgba(254,201,58,0.24)]">
          <div class="pointer-events-none absolute inset-0 bg-[#fec93a]/6 opacity-0 transition-opacity duration-300 group-hover:opacity-100" />

          <div class="absolute top-2 right-2 z-10 rounded-full bg-gradient-to-r from-[#ffe9a8] via-[#fec93a] to-[#d4840e] px-2 py-0.5 text-[9px] font-black tracking-wide whitespace-nowrap text-[#160e03] shadow-sm transition-transform duration-300 group-hover:scale-110">
            {provider.tag}
          </div>

          <div aria-hidden="true" class="mb-3 text-4xl transition-transform duration-300 group-hover:scale-125 group-hover:rotate-3">
            {provider.icon}
          </div>
          <p class="text-center text-sm font-black text-[#ffe9a8] transition-colors group-hover:text-[#fec93a]">{provider.name}</p>
          <p class="mt-1 text-center text-[10px] text-[#cdbb93]">{provider.desc}</p>

          <span class="relative z-10 mt-4 block w-full rounded-full border border-[#a06a09]/60 bg-[#33220a] py-1.5 text-center text-[11px] font-bold text-[#ffe9a8] shadow-inner transition-colors duration-300 group-hover:border-transparent group-hover:bg-gradient-to-r group-hover:from-[#ffe9a8] group-hover:via-[#fec93a] group-hover:to-[#d4840e] group-hover:text-[#160e03]">
            สมัครเข้าเล่น
          </span>
        </a>
      ))
    }
  </div>
</section>
