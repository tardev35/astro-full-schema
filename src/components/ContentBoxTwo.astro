---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
  label?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label } = Astro.props;

const sectionLabel = label ?? title ?? titleleft ?? titleright ?? "ข้อมูลประกอบ";
---

<section aria-label={sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#4a1030] bg-[#170512] p-8 text-[#f3e3ee] shadow-[0_10px_30px_rgba(255,45,142,0.16)] transition-all duration-500 hover:border-[#ff2d8e]/55 md:p-10">
    {
      title && (
        <header class="mb-6 flex items-center gap-4 border-b border-[#4a1030] pb-4">
          <span aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ff2d8e] to-[#ffe814] shadow-[0_0_10px_rgba(255,45,142,0.45)]" />
          <HeadingTag class="bg-gradient-to-r from-[#ff74b6] via-[#ff2d8e] to-[#ffe814] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f3e3ee]">
        {
          titleleft && (
            <p class="flex items-center gap-3 border-b border-[#4a1030] pb-3 text-xl leading-normal font-black tracking-widest text-[#ffe814] uppercase">
              <span
                aria-hidden="true"
                class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#7d0b46] bg-gradient-to-br from-[#ff74b6] via-[#ff2d8e] to-[#c20e6a] text-sm text-[#170512] shadow-[0_5px_15px_rgba(255,45,142,0.32)]">
                🔐
              </span>
              {titleleft}
            </p>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f3e3ee]">
        {
          titleright && (
            <p class="flex items-center gap-3 border-b border-[#4a1030] pb-3 text-xl leading-normal font-black tracking-widest text-[#ffe814] uppercase">
              <span
                aria-hidden="true"
                class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#c9a800] bg-gradient-to-br from-[#fff27a] via-[#ffe814] to-[#c9a800] text-sm text-[#170512] shadow-[0_5px_15px_rgba(255,232,20,0.30)]">
                📊
              </span>
              {titleright}
            </p>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
