---
export interface Props {
  titleleft?: string;
  titleright?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { titleleft, titleright, as: HeadingTag = "h2" } = Astro.props;
---

<section class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-t-4 border-[#f1d2d3] border-t-[#ec1b24] bg-white p-8 text-[#2b2627] shadow-[0_10px_30px_rgba(236,27,36,0.10)] transition-all duration-500 hover:border-[#e9b7b9] hover:border-t-[#ec1b24] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -right-20 -z-10 h-40 w-40 rounded-full bg-[#ec1b24]/6 blur-[60px] transition-all duration-500 group-hover:bg-[#ec1b24]/10">
    </div>
    <div aria-hidden="true" class="pointer-events-none absolute -bottom-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#d4a017]/8 blur-[60px] transition-all duration-500 group-hover:bg-[#d4a017]/12">
    </div>

    <div class="grid grid-cols-1 gap-8 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 border-b border-[#f1d2d3] pb-6 text-center text-base font-medium text-[#6b6264] md:border-r md:border-b-0 md:pr-6 md:pb-0 md:text-left">
        {titleleft && <p class="text-center text-4xl leading-normal font-black tracking-wider text-[#ec1b24] uppercase md:text-left">{titleleft}</p>}
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#2b2627] md:pl-6">
        {titleright && <HeadingTag class="flex items-center gap-2 text-2xl leading-normal font-black text-[#141414]">{titleright}</HeadingTag>}
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
