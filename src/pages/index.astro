---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import ContentBoxSpecial from "../components/ContentBoxSpecial.astro";
import ContentBoxSevenThreeNeumorphism from "../components/ContentBoxSevenThreeNeumorphism.astro";
import ContentBoxTwoNeumorphism from "../components/ContentBoxTwoNeumorphism.astro";
import ContentBoxTwoCyberCut from "../components/ContentBoxTwoCyberCut.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import Announcement from "../components/Announcement3.astro";
import ProviderGrid from "../components/ProviderGrid.astro";
import GameRankingBoard from "../components/GameRankingBoard.astro";
import LatestWinners from "../components/LatestWinners3.astro";
import SmoothCarousel from "../components/SmoothCarousel.astro";
import ReviewCardSumo from "../components/ReviewCardSumo2.astro";
import Navfoot from "../components/Navfoot.astro";
const currentPath = Astro.url.pathname;
const homePage = Astro.url.origin;
const logoUrl = homePage + "/logo.webp";

const webPageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: "คู่มือ MAFIA168 กติกาเกม วิธีเล่น โปรโมชั่น การสมัคร",
  description: "คู่มือการใช้งานเว็บ MAFIA168 กติกาการเล่นเกม โปรโมชั่น วิธีฝากถอน ขั้นตอนการสมัคร คำแนะนำอื่นๆ ติดต่อไลน์",
  url: currentPath,
};
const webSiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "MAFIA168",
  alternateName: ["MAFIA168", "MAFIA168 คู่มือการใช้งานเว็บ"],
  url: "https://www.mafia168-guide.com/",
};
const orgSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "MAFIA168",
  logo: logoUrl,
  url: homePage,
};
const allSchemas = [webPageSchema, orgSchema, webSiteSchema];

import { Picture } from "astro:assets";
import imgPromotion from "../assets/slide2.png";
import imgGameGuide from "../assets/slide1.png";
---

<MainLayout
  title="คู่มือ MAFIA168 กติกาเกม วิธีเล่น โปรโมชั่น การสมัคร"
  description="คู่มือการใช้งานเว็บ MAFIA168 กติกาการเล่นเกม โปรโมชั่น วิธีฝากถอน ขั้นตอนการสมัคร คำแนะนำอื่นๆ ติดต่อไลน์">
  <script type="application/ld+json" set:html={JSON.stringify(allSchemas)} />

  <Announcement message="📢 MAFIA168 คู่มือการใช้งานเว็บ โปรโมชั่น วิธีฝากถอน ขั้นตอนสมัครสมาชิก กติกาเกมอัปเดตใหม่ทุกวัน แอดมินดูแล 24 ชม. www.mafia168-guide.com" />

  <div class="mx-auto w-full max-w-5xl px-4 py-8 text-center">
    <p class="bg-gradient-to-b from-gray-100 to-gray-400 bg-clip-text text-4xl leading-tight font-black text-transparent drop-shadow-sm md:text-5xl">
      MAFIA<span class="bg-gradient-to-b from-lime-300 to-green-600 bg-clip-text text-transparent">168</span>
      <br />
    </p>
  </div>

  <ContentBoxSpecial title="คู่มือการใช้งานเว็บ MAFIA168 คำแนะนำที่ควรอ่าน">
    <p class="leading-relaxed">
      สำหรับสมาชิกใหม่ที่เพิ่งเริ่มใช้งาน <strong class="text-lime-300">MAFIA168</strong> หรือผู้เล่นที่ต้องการศึกษาข้อมูลเพิ่มเติมเกี่ยวกับระบบต่าง ๆ ภายในเว็บไซต์
      หน้านี้ได้รวบรวมข้อมูลสำคัญเอาไว้ครบถ้วน ไม่ว่าจะเป็นโปรโมชั่น วิธีฝากถอน ขั้นตอนการสมัครสมาชิก กติกาการเล่นเกมเบื้องต้น รวมถึงช่องทางการติดต่อทีมงาน
      เพื่อช่วยให้สมาชิกสามารถใช้งานเว็บไซต์ได้อย่างสะดวกและเข้าใจระบบมากยิ่งขึ้น
    </p>

    <div class="mt-8 flex flex-wrap justify-center gap-6">
      <a
        href="/login"
        class="group relative flex items-center justify-center rounded-full border border-green-500/50 bg-[#03120a]/80 px-10 py-3.5 font-black text-lime-300 backdrop-blur-sm transition-all duration-300 hover:scale-105 hover:bg-green-900/60 hover:shadow-[0_0_15px_rgba(34,197,94,0.4)]">
        เข้าสู่ระบบ
      </a>

      <a
        href="/register"
        class="group relative flex items-center justify-center rounded-full bg-gradient-to-r from-green-400 via-green-500 to-green-600 px-10 py-3.5 font-black text-white shadow-[0_5px_20px_rgba(34,197,94,0.4)] transition-all duration-300 hover:-translate-y-1 hover:scale-105 hover:shadow-[0_8px_25px_rgba(34,197,94,0.6)]">
        สมัครสมาชิก
      </a>
    </div>
  </ContentBoxSpecial>

  <ContentBoxSevenThreeNeumorphism titleright="แนะนำโปรโมชั่น MAFIA168 ที่น่าสนใจ">
    <div slot="left" class="flex h-full flex-col justify-center">
      <Picture
        src={imgPromotion}
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600, 800]}
        sizes="(max-width: 768px) 100vw, 30vw"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
        alt="MAFIA168 โปรโมชั่น แนะนำเพื่อนรับ 0.8% เล่นเสียมีคืนรับ 0.3%"
        class="mx-auto h-auto w-full rounded-2xl border-2 border-green-400/30 shadow-[0_10px_30px_rgba(34,197,94,0.3)]"
      />
    </div>
    <div slot="right">
      <p class="leading-relaxed">
        <strong class="text-lime-300">MAFIA168</strong> มีการจัดโปรโมชั่นสำหรับสมาชิกอยู่เป็นประจำ เพื่อเพิ่มความคุ้มค่าในการใช้งาน
        โดยรายละเอียดและเงื่อนไขอาจมีการเปลี่ยนแปลงตามช่วงเวลา สมาชิกสามารถติดตามข้อมูลล่าสุดได้จากหน้าเว็บไซต์หรือสอบถามทีมงานโดยตรง
      </p>
    </div>
  </ContentBoxSevenThreeNeumorphism>

  <ContentBoxTwoNeumorphism titleleft="โปรโมชั่น แนะนำเพื่อนรับ 0.8%" titleright="โปรโมชั่น เล่นเสียมีคืนรับ 0.3%">
    <div slot="left" class="flex flex-col gap-4">
      <p class="leading-relaxed">สมาชิกที่ต้องการสร้างรายได้เพิ่มเติมสามารถเข้าร่วมโปรแกรมแนะนำเพื่อนได้</p>
      <ul class="flex flex-col gap-3">
        <li class="flex items-start gap-3"><span class="mt-1 text-lime-400">◆</span> รับค่าคอมมิชชัน 0.8% ตามเงื่อนไขของระบบ</li>
        <li class="flex items-start gap-3"><span class="mt-1 text-lime-400">◆</span> สามารถแนะนำเพื่อนได้หลายคน</li>
        <li class="flex items-start gap-3"><span class="mt-1 text-lime-400">◆</span> ระบบคำนวณยอดให้อัตโนมัติ</li>
        <li class="flex items-start gap-3"><span class="mt-1 text-lime-400">◆</span> ตรวจสอบข้อมูลผ่านบัญชีสมาชิกได้ตลอดเวลา</li>
      </ul>
      <p class="leading-relaxed">เหมาะสำหรับผู้ที่ต้องการแบ่งปันเว็บไซต์ให้เพื่อนหรือคนรู้จัก</p>
    </div>
    <div slot="right" class="flex flex-col gap-4">
      <p class="leading-relaxed">อีกหนึ่งโปรโมชั่นที่ได้รับความสนใจจากสมาชิกจำนวนมาก</p>
      <ul class="flex flex-col gap-3">
        <li class="flex items-start gap-3"><span class="mt-1 text-lime-400">◆</span> รับเครดิตคืน 0.3% จากยอดที่เข้าเงื่อนไข</li>
        <li class="flex items-start gap-3"><span class="mt-1 text-lime-400">◆</span> ระบบคำนวณให้อัตโนมัติ</li>
        <li class="flex items-start gap-3"><span class="mt-1 text-lime-400">◆</span> สามารถนำเครดิตที่ได้รับไปใช้งานต่อได้</li>
        <li class="flex items-start gap-3"><span class="mt-1 text-lime-400">◆</span> ช่วยเพิ่มความคุ้มค่าในการเล่นเกม</li>
      </ul>
      <p class="leading-relaxed">ติดตามเงื่อนไขล่าสุดได้จากทีมงานหรือหน้าโปรโมชั่น</p>
    </div>
  </ContentBoxTwoNeumorphism>

  <ContentBoxTwoCyberCut title="วิธีฝากถอนเงินกับ MAFIA168 ทั้งแบบธนาคารและวอเลท" titleleft="วิธีฝากเงิน" titleright="วิธีถอนเงิน">
    <p class="leading-relaxed">
      <strong class="text-lime-300">MAFIA168</strong> รองรับการทำธุรกรรมทั้งผ่านบัญชีธนาคารและทรูมันนี่วอเลท เพื่อให้สมาชิกเลือกใช้งานได้ตามความสะดวก
      โดยระบบได้รับการออกแบบให้ใช้งานง่ายและสามารถดำเนินการได้ด้วยตนเอง
    </p>
    <div slot="left">
      <ol class="flex flex-col gap-3">
        <li class="flex items-start gap-3"><span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-green-500/20 text-xs font-black text-lime-400">1</span> เข้าสู่ระบบสมาชิก</li>
        <li class="flex items-start gap-3"><span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-green-500/20 text-xs font-black text-lime-400">2</span> เลือกเมนูฝากเงิน</li>
        <li class="flex items-start gap-3"><span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-green-500/20 text-xs font-black text-lime-400">3</span> เลือกช่องทางที่ต้องการใช้งาน</li>
        <li class="flex items-start gap-3"><span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-green-500/20 text-xs font-black text-lime-400">4</span> กรอกจำนวนเงินตามต้องการ</li>
        <li class="flex items-start gap-3"><span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-green-500/20 text-xs font-black text-lime-400">5</span> ยืนยันรายการและรอระบบดำเนินการ</li>
      </ol>
    </div>
    <div slot="right" class="flex flex-col gap-4">
      <ol class="flex flex-col gap-3">
        <li class="flex items-start gap-3"><span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-green-500/20 text-xs font-black text-lime-400">1</span> เข้าสู่ระบบสมาชิก</li>
        <li class="flex items-start gap-3"><span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-green-500/20 text-xs font-black text-lime-400">2</span> เลือกเมนูถอนเงิน</li>
        <li class="flex items-start gap-3"><span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-green-500/20 text-xs font-black text-lime-400">3</span> ระบุจำนวนเงินที่ต้องการถอน</li>
        <li class="flex items-start gap-3"><span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-green-500/20 text-xs font-black text-lime-400">4</span> ตรวจสอบข้อมูลให้ถูกต้อง</li>
        <li class="flex items-start gap-3"><span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-green-500/20 text-xs font-black text-lime-400">5</span> กดยืนยันรายการผ่านระบบ</li>
      </ol>
      <p class="leading-relaxed">ก่อนทำรายการทุกครั้งควรตรวจสอบข้อมูลบัญชีให้ถูกต้อง เพื่อช่วยลดความผิดพลาดในการทำธุรกรรม</p>
    </div>
  </ContentBoxTwoCyberCut>

  <LatestWinners />

  <ContentBox as="h2" title="ขั้นตอนการสมัครสมาชิก MAFIA168">
    <p class="leading-relaxed">สมาชิกใหม่สามารถสมัครใช้งานได้ง่ายตามขั้นตอนดังต่อไปนี้</p>

    <div class="mx-auto mt-8 grid max-w-4xl grid-cols-1 gap-6 text-left md:grid-cols-3">
      <div class="rounded-2xl border border-green-500/30 bg-[#03120a]/70 p-6">
        <span class="mb-4 flex h-10 w-10 items-center justify-center rounded-full bg-gradient-to-br from-green-400 to-green-600 text-base font-black text-white shadow-[0_0_10px_rgba(34,197,94,0.5)]">1</span>
        <p class="leading-relaxed text-gray-300"><strong class="text-lime-300">ขั้นตอนที่ 1</strong> กดปุ่มสมัครสมาชิก</p>
      </div>
      <div class="rounded-2xl border border-green-500/30 bg-[#03120a]/70 p-6">
        <span class="mb-4 flex h-10 w-10 items-center justify-center rounded-full bg-gradient-to-br from-green-400 to-green-600 text-base font-black text-white shadow-[0_0_10px_rgba(34,197,94,0.5)]">2</span>
        <p class="leading-relaxed text-gray-300"><strong class="text-lime-300">ขั้นตอนที่ 2</strong> กรอกข้อมูลตามแบบฟอร์มที่ระบบกำหนด</p>
      </div>
      <div class="rounded-2xl border border-green-500/30 bg-[#03120a]/70 p-6">
        <span class="mb-4 flex h-10 w-10 items-center justify-center rounded-full bg-gradient-to-br from-green-400 to-green-600 text-base font-black text-white shadow-[0_0_10px_rgba(34,197,94,0.5)]">3</span>
        <p class="leading-relaxed text-gray-300"><strong class="text-lime-300">ขั้นตอนที่ 3</strong> กดยืนยันการสมัครและเข้าสู่ระบบ</p>
      </div>
    </div>

    <p class="mt-8 leading-relaxed">หลังจากสมัครเรียบร้อย สามารถเข้าใช้งานระบบต่าง ๆ ภายในเว็บไซต์ได้ทันทีผ่านมือถือหรือคอมพิวเตอร์</p>
  </ContentBox>

  <ContentBoxSevenThreeNeumorphism titleright="คู่มือการเล่นเกม กติกาเกมต่างๆ อัปเดตใหม่ทุกวัน">
    <div slot="left" class="flex h-full flex-col justify-center">
      <Picture
        src={imgGameGuide}
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600, 800]}
        sizes="(max-width: 768px) 100vw, 30vw"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
        alt="MAFIA168 คู่มือการเล่นเกม กติกาเกมต่างๆ อัปเดตใหม่ทุกวัน"
        class="mx-auto h-auto w-full rounded-2xl border-2 border-green-400/30 shadow-[0_10px_30px_rgba(34,197,94,0.3)]"
      />
    </div>
    <div slot="right" class="flex flex-col gap-4">
      <p class="leading-relaxed">
        ภายในเว็บไซต์มีเกมหลากหลายประเภท ซึ่งแต่ละเกมอาจมีรูปแบบการเล่นและกติกาที่แตกต่างกัน สมาชิกควรศึกษารายละเอียดของเกมก่อนเริ่มใช้งานทุกครั้ง
        เพื่อให้เข้าใจวิธีการเล่นและฟีเจอร์ต่าง ๆ ได้มากขึ้น
      </p>
      <p class="text-base font-black tracking-wide text-lime-300">ข้อมูลที่ควรศึกษา</p>
      <ul class="flex flex-col gap-3">
        <li class="flex items-start gap-3"><span class="mt-1 text-lime-400">◆</span> วิธีการเล่นเบื้องต้น</li>
        <li class="flex items-start gap-3"><span class="mt-1 text-lime-400">◆</span> กติกาของแต่ละเกม</li>
        <li class="flex items-start gap-3"><span class="mt-1 text-lime-400">◆</span> รูปแบบการคำนวณผลรางวัล</li>
        <li class="flex items-start gap-3"><span class="mt-1 text-lime-400">◆</span> ฟีเจอร์โบนัสภายในเกม</li>
        <li class="flex items-start gap-3"><span class="mt-1 text-lime-400">◆</span> เทคนิคและคำแนะนำสำหรับผู้เล่นใหม่</li>
        <li class="flex items-start gap-3"><span class="mt-1 text-lime-400">◆</span> ข้อมูลอัปเดตเกมใหม่ประจำวัน</li>
      </ul>
      <p class="leading-relaxed">การศึกษาข้อมูลก่อนเล่นจะช่วยให้ใช้งานเกมได้อย่างมั่นใจและเข้าใจระบบมากยิ่งขึ้น</p>
    </div>
  </ContentBoxSevenThreeNeumorphism>

  <LoginRtpSection />
  <ProviderGrid />
  <GameRankingBoard />

  <ContentBox as="h2" title="แนะนำช่องทางการติดต่อไลน์ แอดมินบริการ 24 ชม.">
    <p class="leading-relaxed">หากสมาชิกต้องการสอบถามข้อมูลเพิ่มเติม หรือพบปัญหาในการใช้งาน สามารถติดต่อทีมงานผ่านช่องทางไลน์ได้ตลอดเวลา</p>

    <div class="mx-auto mt-8 max-w-2xl rounded-2xl border border-green-500/30 bg-[#03120a]/70 p-6 text-left">
      <p class="mb-4 text-lg font-black tracking-wide text-lime-300">ช่องทางที่สามารถสอบถามได้</p>
      <ul class="flex flex-col gap-3 text-gray-300">
        <li class="flex items-start gap-3"><span class="mt-1 text-lime-400">◆</span> สอบถามข้อมูลการสมัครสมาชิก</li>
        <li class="flex items-start gap-3"><span class="mt-1 text-lime-400">◆</span> ขอคำแนะนำเกี่ยวกับการใช้งาน</li>
        <li class="flex items-start gap-3"><span class="mt-1 text-lime-400">◆</span> สอบถามรายละเอียดโปรโมชั่น</li>
        <li class="flex items-start gap-3"><span class="mt-1 text-lime-400">◆</span> แจ้งปัญหาการฝากถอน</li>
        <li class="flex items-start gap-3"><span class="mt-1 text-lime-400">◆</span> แจ้งปัญหาการเข้าสู่ระบบ</li>
        <li class="flex items-start gap-3"><span class="mt-1 text-lime-400">◆</span> ติดตามข่าวสารและข้อมูลอัปเดตต่าง ๆ</li>
      </ul>
    </div>

    <div class="mt-8 flex justify-center">
      <a
        href="/line"
        class="inline-flex items-center bg-[#00B900] px-8 py-3 font-bold text-white shadow-lg transition-transform hover:scale-105"
        style="clip-path: polygon(15% 0, 100% 0, 100% 70%, 85% 100%, 0 100%, 0 30%);">
        <span class="mr-2 text-xl">LINE</span> ติดต่อแอดมิน
      </a>
    </div>

    <p class="mt-8 leading-relaxed">
