---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import CtaRedirect from "../components/CtaRedirect.astro";
import { pageGraph } from "../lib/schema";

const pageDescription =
  "สมัครสมาชิก ANDAMAN168 หน้าสมัครเว็บหลัก กดปุ่มเดียวเริ่มสร้างบัญชีผ่านมือถือ เข้าเล่นบาคาร่า สล็อต ฟุตบอล และคาสิโน พร้อมระบบฝากถอนออโต้ตลอด 24 ชั่วโมง";

const graph = pageGraph(Astro, {
  name: "สมัครสมาชิก ANDAMAN168 เว็บหลัก",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "สมัครสมาชิก", path: "/register" },
  ],
});

const targetUrl = "https://yoalink.com/22hs";
---

<MainLayout title="สมัครสมาชิก ANDAMAN168 | บัญชีเดียวเล่นครบทุกหมวด" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="สมัครสมาชิก ANDAMAN168" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label="สมัครสมาชิก"
        class="group relative mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#fdb524]/60 bg-gradient-to-b from-[#ffe999] via-[#fdb524] to-[#b06f00] px-6 py-4 text-xl font-bold tracking-wide text-[#04182f] shadow-[0_10px_30px_rgba(253,181,36,0.24)] transition-all duration-300 hover:scale-105 hover:shadow-[0_15px_40px_rgba(253,181,36,0.4)]">
        สมัครสมาชิก
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="สมัครสมาชิก" />
</MainLayout>
