---
import { Picture } from "astro:assets";

import slide1 from "../assets/slide1.png";
import slide2 from "../assets/slide2.png";

const images = [
  {
    src: slide1,
    alt: "ภาพโปรโมชั่น PIGAUTO พื้นหลังสีแดงลายกิ่งดอกไม้จีน มีโคมไฟจีนสีแดงและเหรียญทองลอยอยู่รอบภาพ ด้านบนเป็นโลโก้หมูสีชมพูบนเฟืองสีเงินพร้อมตัวอักษร PIGAUTO ถัดลงมาเป็นตัวอักษรขาวขนาดใหญ่ว่า COMMISSION และบรรทัด คืนทุกยอดเล่นตลอดทั้งวัน ตรงกลางเป็นกล่องสีแดงที่มีตัวเลขทองขนาดใหญ่ว่า 0.3% ใต้ลงมาเขียนว่า เล่นถึง 50% ถอนได้เลย ตามด้วยข้อความ สามารถกดรับง่ายๆ ที่หน้าเว็บได้เลยค่ะ และ รับสิทธิ์ก่อน 23.59 น. ของทุกวัน แถบล่างสุดเป็นตัวอักษรทองว่า ยิ่งเล่นเยอะ ยิ่งได้เยอะ ด้านซ้ายบนเป็นพรีเซนเตอร์หญิงชุดสีแดงปักลายทอง",
  },
  {
    src: slide2,
    alt: "ภาพโปรโมชั่น PIGAUTO พื้นหลังสีแดงลายกิ่งดอกไม้จีน มีโคมไฟจีนสีแดงและเหรียญทองลอยอยู่ ด้านบนซ้ายเป็นโลโก้หมูสีชมพูบนเฟืองสีเงินพร้อมตัวอักษร PIGAUTO ตรงกลางเป็นตัวอักษรขาวขนาดใหญ่ว่า แนะนำเพื่อน รับโบนัส ถัดลงมาเป็นกล่องสีแดงที่มีตัวเลขทองขนาดใหญ่ว่า 0.8% ใต้ลงมาเขียนว่า สร้างรายได้ 100,000/เดือน ด้านขวาเป็นพรีเซนเตอร์หญิงชุดสูทสีทองยืนอยู่หน้าฉากสีแดง",
  },
];

const COPIES = 3;
const slides = Array.from({ length: COPIES }, () => images).flat();
---

<div class="marquee mx-auto w-full max-w-7xl overflow-hidden px-4 py-5">
  <input id="carousel-pause" type="checkbox" class="peer sr-only" />
  <label
    for="carousel-pause"
    class="sr-only cursor-pointer peer-focus-visible:not-sr-only peer-focus-visible:mb-3 peer-focus-visible:inline-block peer-focus-visible:rounded-full peer-focus-visible:border peer-focus-visible:border-[#f5c542]/60 peer-focus-visible:px-4 peer-focus-visible:py-2 peer-focus-visible:text-sm peer-focus-visible:font-bold peer-focus-visible:text-[#ffe9a8]">
    หยุด / เล่นสไลด์ภาพ
  </label>

  <div class="marquee-track flex">
    {
      slides.map((slide, index) => {
        const isDuplicate = index >= images.length;
        return (
          <div class="marquee-slide" aria-hidden={isDuplicate ? "true" : undefined}>
            <Picture
              src={slide.src}
              alt={isDuplicate ? "" : slide.alt}
              class="block w-full rounded-xl border border-[#f5c542]/40 object-cover shadow-[0_10px_30px_rgba(216,31,38,0.30)]"
              width={slide.src.width}
              height={slide.src.height}
              loading="lazy"
              fetchpriority="low"
              decoding="async"
              widths={[300, 360, 420, 480, 540, 600]}
              sizes="(max-width: 767px) calc(100vw - 32px), (max-width: 1279px) calc((100vw - 48px) / 2), 403px"
              formats={["avif", "webp"]}
              fallbackFormat="webp"
              quality={60}
            />
          </div>
        );
      })
    }
  </div>
</div>

<style>
  .marquee {
    --gap: 12px;
    --per-view: 1;
    --shift: calc(-200% - 24px);
  }

  @media (min-width: 768px) {
    .marquee {
      --gap: 16px;
      --per-view: 2;
      --shift: calc(-100% - 16px);
    }
  }

  @media (min-width: 1280px) {
    .marquee {
      --gap: 20px;
      --per-view: 3;
      --shift: calc(-66.6667% - 13.3333px);
    }
  }

  .marquee-track {
    gap: var(--gap);
    width: 100%;
    animation: carousel-scroll 24s linear infinite;
    will-change: transform;
  }

  .marquee-slide {
    flex: 0 0 calc((100% - (var(--per-view) - 1) * var(--gap)) / var(--per-view));
  }

  @keyframes carousel-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(var(--shift));
    }
  }

  .marquee:hover .marquee-track,
  .marquee:focus-within .marquee-track,
  .marquee > input:checked ~ .marquee-track {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
    }
  }
</style>
