---
const { titleleft, titleright } = Astro.props;
---

<section
  class="mx-auto mb-4 w-full max-w-7xl rounded-xl border-2 border-red-900/50 bg-[#050000]/90 p-8 text-center text-white/90 shadow-[0_0_20px_rgba(185,28,28,0.15),inset_0_0_15px_rgba(185,28,28,0.05)] backdrop-blur-md transition-all duration-300 hover:border-red-500/50 hover:drop-shadow-[0_0_8px_rgba(185,28,28,0.6)]">
  <div class="grid grid-cols-1 gap-5 md:grid-cols-2 lg:grid-cols-2">
    <article class="flex flex-col gap-4">
      {titleleft && <h2 class="text-crimson-gradient mb-4 text-3xl font-bold drop-shadow-[0_0_8px_rgba(185,28,28,0.6)]">{titleleft}</h2>}
      <div class="text-cyan-50/80">
        <slot name="left" />
      </div>
    </article>

    <article class="flex flex-col gap-4">
      {titleright && <h2 class="text-crimson-gradient mb-4 text-3xl font-bold drop-shadow-[0_0_8px_rgba(185,28,28,0.6)]">{titleright}</h2>}
      <div class="text-cyan-50/80">
        <slot name="right" />
      </div>
    </article>
  </div>
</section>

<style>
  .font-sans {
    font-family: "Kanit", sans-serif;
  }
  :global(.text-crimson-gradient) {
    background: linear-gradient(to bottom, #ffffff 0%, #b91c1c 100%) !important;
    -webkit-background-clip: text !important;
    -webkit-text-fill-color: transparent !important;
  }
</style>
