---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;
---

<section class="mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="w-full rounded-[25px] border border-[#b07d12]/55 bg-[#2a0505] p-8 shadow-[10px_10px_20px_#160202,-10px_-10px_20px_#3a0808] transition-all duration-300 hover:shadow-[15px_15px_30px_#160202,-15px_-15px_30px_#451010]">
    {
      title && (
        <header class="mb-8 border-b border-[#b07d12]/45 pb-4 text-center">
          <HeadingTag class="bg-gradient-to-r from-[#ffe08a] via-[#f5c542] to-[#d99e1f] bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f7e4d4]">
        {titleleft && <p class="text-xl leading-normal font-black tracking-wide text-[#ffe08a] drop-shadow-[0_0_10px_rgba(245,197,66,0.35)]">{titleleft}</p>}
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f7e4d4] md:border-l md:border-[#b07d12]/45 md:pl-8">
        {titleright && <p class="text-xl leading-normal font-black tracking-wide text-[#ffe08a] drop-shadow-[0_0_10px_rgba(245,197,66,0.35)]">{titleright}</p>}
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
