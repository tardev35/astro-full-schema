---
const providers = [
  { name: "สล็อตเว็บตรง", desc: "หมวดหลักของเว็บ รวมเกมหมุนไว้หลังยูสเดียว เปลี่ยนเกมกี่รอบก็ใช้บัญชีเดิม", tag: "เกมหลัก", icon: "🎰" },
  { name: "เกมฟรีสปิน", desc: "เกมที่มีรอบหมุนฟรีในตัว เหมาะกับคนที่ชอบรอจังหวะฟีเจอร์มากกว่าหมุนรัวยาว", tag: "หมวดเกม", icon: "🌀" },
  { name: "สล็อตโบนัสฟีเจอร์", desc: "เกมที่มีฟีเจอร์โบนัสหลายชั้น เลือกจากหน้ารวมเกมแล้วเปิดเล่นต่อได้ทันที", tag: "หมวดเกม", icon: "🍀" },
  { name: "สล็อตรุ่นใหม่", desc: "เกมที่เพิ่งเปิดให้เล่น สำหรับสายเปลี่ยนเกมตามอารมณ์ ไม่ต้องไล่เปิดเว็บเพิ่ม", tag: "ของใหม่", icon: "✨" },
  { name: "ฝากถอนออโต้", desc: "ส่งรายการฝากเข้า ถอนออก และเช็กสถานะจากหน้าเมมเบอร์ได้ตลอด 24 ชั่วโมง", tag: "ระบบออโต้", icon: "💳" },
  { name: "ไม่ติดเทิร์น", desc: "เครดิตที่เข้าเงื่อนไขจัดการต่อได้โดยไม่ต้องปั่นยอดหลายรอบก่อนถอน ตามที่ระบบกำหนด", tag: "เงื่อนไขเครดิต", icon: "🔓" },
  { name: "โปรโมชั่นสมาชิก", desc: "ดูยอดรับ เทิร์น และช่วงเวลาที่ใช้ได้ก่อนเลือกสิทธิ์ให้เข้ากับสไตล์เล่นของตัวเอง", tag: "สิทธิ์สมาชิก", icon: "🎁" },
];
---

<section aria-label="หมวดเกมสล็อตและบริการที่ WON22 รวมไว้ในยูสเดียว" class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#fb923c] via-[#f8e3d2] to-[#fbbf24] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      หมวดเกมสล็อตและบริการที่ <span class="text-[#fbbf24]">WON22</span> รวมไว้ในยูสเดียว
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#f97316] to-transparent"></div>
  </div>

  <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4 lg:gap-5 xl:grid-cols-7">
    {
      providers.map((provider) => (
        <a
          href="/register"
          class="group relative flex flex-col items-center justify-center overflow-hidden rounded-2xl border border-[#6b2f0b] bg-[#241004] p-5 shadow-[0_10px_30px_rgba(249,115,22,0.14)] transition-all duration-300 hover:-translate-y-2 hover:border-[#f97316]/60 hover:bg-[#331608] hover:shadow-[0_15px_40px_rgba(249,115,22,0.28)]">
          <div class="pointer-events-none absolute inset-0 bg-[#f97316]/8 opacity-0 transition-opacity duration-300 group-hover:opacity-100" />

          <div class="absolute top-2 right-2 z-10 rounded-full bg-gradient-to-r from-[#fb923c] via-[#f97316] to-[#9a3412] px-2 py-0.5 text-[9px] font-black tracking-wide whitespace-nowrap text-[#fcd34d] shadow-sm transition-transform duration-300 group-hover:scale-110">
            {provider.tag}
          </div>

          <div aria-hidden="true" class="mb-3 text-4xl transition-transform duration-300 group-hover:scale-125 group-hover:rotate-3">
            {provider.icon}
          </div>
          <p class="text-center text-sm font-black text-[#fcd34d] transition-colors group-hover:text-[#fbbf24]">{provider.name}</p>
          <p class="mt-1 text-center text-[10px] text-[#dcb99a]">{provider.desc}</p>

          <span class="relative z-10 mt-4 block w-full rounded-full border border-[#6b2f0b] bg-[#180a03] py-1.5 text-center text-[11px] font-bold text-[#fb923c] shadow-inner transition-colors duration-300 group-hover:border-[#fbbf24]/60 group-hover:bg-gradient-to-r group-hover:from-[#fcd34d] group-hover:via-[#fbbf24] group-hover:to-[#b45309] group-hover:text-[#180a03]">
            เข้าดูหมวดนี้
          </span>
        </a>
      ))
    }
  </div>
</section>
