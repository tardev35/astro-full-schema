---
import { BRAND_NAME } from "../lib/brandProfile";

export interface Props {
  title?: string;
}

const { title = `เสียงจากสมาชิก ${BRAND_NAME}` } = Astro.props;

const reviews = [
  {
    name: "คุณภูมิ",
    role: "สลับ iOS กับ Android",
    stars: 5,
    tag: "ไม่ต้องโหลดแอป",
    content: "เปลี่ยนจากมือถือ Android มาใช้ iPhone ก็ไม่ต้องสมัครใหม่ เปิดเว็บในเบราว์เซอร์แล้วล็อกอินด้วยยูสกับรหัสเดิมได้เลย ก่อนกรอกรหัสจะดูชื่อเว็บบนแถบที่อยู่ให้แน่ใจทุกครั้ง",
    avatar: "📱",
  },
  {
    name: "คุณต้น",
    role: "สลับเล่นหลายค่าย",
    stars: 5,
    tag: "เลือกเกมจากกลไก",
    content:
      "ชอบที่มีทั้ง Wild Bandito กับ The Dog House ให้สลับจังหวะ วันไหนอยากลุ้นตัวคูณที่เพิ่มตอนชนะต่อเนื่องก็เข้า Wild Bandito อยากลุ้นไวลด์ค้างในรอบฟรีสปินก็ไป The Dog House ก่อนลองเกมใหม่จะเปิดอ่านกติกาในเกมก่อนทุกครั้ง",
    avatar: "🎰",
  },
  {
    name: "คุณแนน",
    role: "ฝากถอนช่วงดึก",
    stars: 4,
    tag: "ฝากถอนออโต้",
    content:
      "ฝากตอนดึกโดยไม่ต้องแนบสลิปหรือรอแอดมินตอบ ระบบปรับเครดิตให้เอง ถอนก็กดจากมือถือเครื่องเดียวกับที่เล่น ให้ 4 ดาวเพราะครั้งแรกหาเมนูถอนไม่เจอ ทักแอดมินผ่านช่องทางบนหน้าเว็บก็มีคนช่วยดูให้",
    avatar: "🌙",
  },
];
const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label={title} class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="text-2xl leading-normal font-black tracking-wide text-[#1f1611] md:text-3xl">{title}</p>
    <div aria-hidden="true" class="mt-2 h-1 w-24 rounded-full bg-gradient-to-r from-[#ffc94a] via-[#f47b20] to-[#1f6fd6]"></div>
  </div>

  <div class="mx-auto mb-8 flex max-w-md items-center justify-center gap-5 rounded-2xl border border-[#3a2a1e] bg-[#1a120c] px-6 py-4 text-[#fff1e4] shadow-[0_10px_30px_rgba(31,22,17,0.18)]">
    <div class="flex flex-col items-center">
      <span class="text-4xl leading-none font-black text-[#ffc94a]">{average}</span>
      <span class="mt-1 text-[10px] font-bold tracking-widest text-[#d9bfa8]">คะแนนเฉลี่ย</span>
    </div>
    <div aria-hidden="true" class="h-12 w-px bg-[#3a2a1e]"></div>
    <div class="flex flex-col gap-1.5">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#ffc94a]" : "text-[#3a2a1e]"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#d9bfa8]">คะแนนเฉลี่ย {average} จาก 5 ดาว จากรีวิวของสมาชิก {reviews.length} คน</span>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
    {
      reviews.map((review) => (
        <article class="group relative isolate flex flex-col gap-4 overflow-hidden rounded-2xl border border-[#f1d9c4] bg-white p-6 text-left shadow-[0_10px_30px_rgba(31,22,17,0.08)] transition-[transform,border-color,box-shadow] duration-300 hover:-translate-y-1 hover:border-[#f0a868] hover:shadow-[0_15px_40px_rgba(244,123,32,0.18)] motion-reduce:transition-none motion-reduce:hover:translate-y-0">
          <span
            aria-hidden="true"
            class="absolute inset-x-0 top-0 -z-10 h-1 bg-gradient-to-r from-[#ffc94a] via-[#f47b20] to-[#c85a0c] opacity-80 transition-opacity duration-300 group-hover:opacity-100"
          />

          <div class="flex items-center justify-between gap-3">
            <span class="inline-flex items-center gap-1.5 rounded-full border border-[#f47b20]/40 bg-[#fff3e8] px-3 py-1 text-[10px] font-bold tracking-widest text-[#a84a06]">
              <span aria-hidden="true" class="h-1.5 w-1.5 rounded-full bg-[#1f6fd6]" />
              {review.tag}
            </span>
            <span class="flex gap-0.5 text-sm">
              <span aria-hidden="true" class="flex gap-0.5">
                {Array.from({ length: 5 }).map((_, i) => (
                  <span class={i < review.stars ? "text-[#f47b20]" : "text-[#f1d9c4]"}>★</span>
                ))}
              </span>
              <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
            </span>
          </div>

          <p class="text-left text-base leading-relaxed text-[#2b2622]">{review.content}</p>

          <div class="mt-auto flex items-center gap-3 border-t border-[#f1d9c4] pt-4">
            <span
              aria-hidden="true"
              class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border-2 border-[#ffe3b8] bg-gradient-to-b from-[#ffc94a] via-[#f47b20] to-[#c85a0c] text-xl shadow-[0_5px_15px_rgba(244,123,32,0.30)] transition-transform duration-300 group-hover:scale-110 motion-reduce:group-hover:scale-100">
              {review.avatar}
            </span>
            <span class="flex flex-col">
              <span class="text-sm font-black text-[#1f1611] transition-colors group-hover:text-[#a84a06]">{review.name}</span>
              <span class="text-[10px] font-bold tracking-wider text-[#6b5f56]">{review.role}</span>
            </span>
          </div>
        </article>
      ))
    }
  </div>
</section>
