---
import { Picture } from "astro:assets";
import img1 from "../assets/providers/game1.avif";
import img2 from "../assets/providers/game2.avif";
import img3 from "../assets/providers/game3.avif";
import img4 from "../assets/providers/game4.avif";
import img5 from "../assets/providers/game5.avif";
import img6 from "../assets/providers/game6.avif";

const games = [
  { rank: 1, name: "สล็อต PG Slot", type: "ค่ายที่สมาชิก BUNNY555 เปิดบ่อยที่สุด มีเกมหลายธีมให้เลือกจากเมนูเดียว", menus: ["ยอดนิยม", "หลายธีม"], players: 5124, img: img2 },
  { rank: 2, name: "สล็อต JILI", type: "อีกค่ายใหญ่ในระบบเดียวกัน เลือกเกมต่อได้โดยไม่ต้องออกจากบัญชีสมาชิก", menus: ["ค่ายใหญ่", "เลือกต่อได้"], players: 3842, img: img5 },
  { rank: 3, name: "เกมโบนัสและฟรีสปิน", type: "หมวดเกมที่มีรอบโบนัสในตัว ดูรูปแบบฟีเจอร์ของแต่ละเกมก่อนกดเข้าเล่นได้", menus: ["เกมโบนัส", "ฟรีสปิน"], players: 3517, img: img6 },
  { rank: 4, name: "สล็อตธีมแฟนตาซี", type: "เกมภาพจัดเต็มสำหรับคนที่เลือกจากธีมก่อนเป็นหลัก หาเจอได้จากหน้ารวมเกม", menus: ["ตามธีม", "ภาพจัดเต็ม"], players: 2905, img: img3 },
  { rank: 5, name: "สล็อตวงล้อคลาสสิก", type: "เกมรูปแบบเรียบง่ายสำหรับคนที่ชอบวงล้อแบบดั้งเดิม เข้าเล่นจากเครดิตชุดเดิม", menus: ["เล่นง่าย", "คลาสสิก"], players: 2431, img: img4 },
  { rank: 6, name: "เกมที่เล่นล่าสุดและรายการโปรด", type: "กลับไปเปิดเกมที่เคยเล่นได้ทันทีจากระบบสมาชิก BUNNY555", menus: ["เล่นประจำ", "รายการโปรด"], players: 2108, img: img1 },
];

const medal = (rank: number) => (rank === 1 ? "🥇" : rank === 2 ? "🥈" : rank === 3 ? "🥉" : null);
---

<section aria-label="หมวดเกมสล็อตที่สมาชิก BUNNY555 เลือกเปิดใช้บ่อย" class="mx-auto w-full max-w-[1300px] px-4 py-8 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <span aria-hidden="true" class="text-2xl">🏆</span>
    <p class="bg-gradient-to-r from-[#9d174d] via-[#be185d] to-[#ec4899] bg-clip-text text-2xl font-black tracking-widest text-transparent uppercase">หมวดเกมสล็อตที่สมาชิก BUNNY555 เปิดใช้บ่อยที่สุด</p>
    <p class="max-w-3xl text-base leading-relaxed text-[#7a1038]">
      ทุกหมวดในตารางนี้ใช้บัญชีและเครดิตชุดเดียวกัน สลับค่ายไปมาได้โดยไม่ต้องออกจากระบบ ลำดับความนิยมขยับตามคนที่เข้ามาใช้งานในแต่ละช่วง ไม่ได้แปลว่าเกมไหนให้อัตราจ่ายดีกว่าเกมไหน เลือกจากสไตล์ที่ชอบแล้วเข้าเล่นต่อจากหน้าสมาชิกได้เลย
    </p>
    <div class="mt-2 h-[3px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#e8a020] to-transparent"></div>
  </div>

  <div class="flex flex-col gap-3">
    {
      games.map((g) => {
        const top = g.rank === 1;
        return (
          <article
            class={`group relative flex items-center gap-3 overflow-hidden rounded-2xl border p-3 backdrop-blur-md transition-all duration-300 hover:-translate-y-0.5 sm:gap-5 sm:p-4 ${
              top
                ? "border-[#e8a020]/55 bg-gradient-to-r from-[#fff2f7]/95 via-[#ffffff]/92 to-[#ffffff]/92 shadow-[0_15px_40px_rgba(232,160,32,0.20)]"
                : "border-[#f9c2d9] bg-[#ffffff]/92 shadow-[0_10px_30px_rgba(157,23,77,0.10)] hover:border-[#ec4899]/60 hover:shadow-[0_15px_40px_rgba(190,24,93,0.18)]"
            }`}>
            <div
              aria-hidden="true"
              class="pointer-events-none absolute top-1/2 -left-10 h-24 w-24 -translate-y-1/2 rounded-full bg-[#f9a8d4]/45 blur-[40px] transition-all duration-500 group-hover:bg-[#ec4899]/25"
            />

            <div class="relative z-10 flex w-8 shrink-0 flex-col items-center justify-center sm:w-12">
              {medal(g.rank) ? (
                <span class="text-2xl sm:text-3xl">
                  <span aria-hidden="true">{medal(g.rank)}</span>
                  <span class="sr-only">อันดับ {g.rank}</span>
                </span>
              ) : (
                <span class="text-xl font-black text-[#be185d] sm:text-2xl">#{g.rank}</span>
              )}
            </div>

            <div class={`relative z-10 h-14 w-14 shrink-0 overflow-hidden rounded-xl border sm:h-16 sm:w-16 ${top ? "border-[#e8a020]/55" : "border-[#f9c2d9]"}`}>
              <Picture
                src={g.img}
                alt={`ภาพหน้าปกเกมของ ${g.name} บนกระดานหมวดเกมยอดนิยมของ BUNNY555`}
                formats={["avif", "webp"]}
                fallbackFormat="webp"
                loading="lazy"
                fetchpriority="low"
                widths={[100, 200]}
                sizes="(max-width: 640px) 56px, 64px"
                decoding="async"
                class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-110"
              />
            </div>

            <div class="relative z-10 min-w-0 flex-1">
              <div class="flex items-center gap-2">
                <p class="truncate text-base font-black text-[#7a1038] sm:text-lg">{g.name}</p>
                {top && (
                  <span class="hidden shrink-0 rounded-full border border-[#e8a020]/60 bg-[#fff2f7] px-2 py-0.5 text-[9px] font-black tracking-wider text-[#a86a10] sm:inline">ยอดนิยมสูงสุด</span>
                )}
              </div>
              <p class="truncate text-[11px] text-[#a8577a] sm:text-xs">{g.type}</p>

              <div class="mt-2 flex flex-wrap items-center gap-1.5">
                {g.menus.map((m) => (
                  <span class="rounded-full border border-[#f9c2d9] bg-[#fff2f7] px-2.5 py-0.5 text-[10px] font-bold text-[#9d174d]">{m}</span>
                ))}
              </div>
            </div>

            <div class="relative z-10 hidden shrink-0 flex-col items-end gap-1 sm:flex">
              <span class="flex items-center gap-1.5 text-[11px] text-[#a8577a]">
                <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-green-600 shadow-[0_0_6px_rgba(22,163,74,0.5)]" />
                <span class="tabular-nums" data-players data-base={g.players}>
                  {g.players.toLocaleString("en-US")}
                </span>{" "}
                ออนไลน์
              </span>
              <a
                href="/register"
                class={`rounded-full px-4 py-1.5 text-xs font-black transition-transform hover:scale-105 ${
                  top
                    ? "bg-gradient-to-r from-[#f7c948] via-[#e8a020] to-[#a86a10] text-[#7a1038] shadow-[0_10px_30px_rgba(232,160,32,0.20)]"
                    : "border border-[#ec4899]/60 bg-[#fff2f7] text-[#be185d] hover:border-[#ec4899] hover:bg-[#ffe4f0]"
                }`}>
                เข้าดูหมวดนี้
              </a>
            </div>
          </article>
        );
      })
    }
  </div>
</section>

<script>
  import { startLiveCounters } from "../lib/liveCounter";

  startLiveCounters();
</script>
