---
const {
  message = "SCLASS88 รวมสล็อตแท้เว็บตรง เกมค่ายใหญ่ โบนัส และระบบออโต้ไว้ในบัญชีเดียว • เข้าสู่ระบบแล้วเลือกเกม ดูเครดิต และเช็กโบนัสได้จากหน้าเดียว ทั้งมือถือและคอมพิวเตอร์ • สล็อตหลายค่ายหลายสไตล์ ทั้งเกมคลาสสิก เกมฟีเจอร์ โบนัส และฟรีสปิน • โบนัสและสิทธิ์สมาชิกรวมไว้ในหน้าสมาชิก เช็กเงื่อนไขก่อนเลือกใช้ได้ทุกครั้ง • ระบบออโต้ฝากถอนเชื่อมเครดิตกับบัญชีสมาชิกโดยตรง ทำรายการได้ตลอด 24 ชั่วโมง • ทางเข้าและหน้าล็อกอินรองรับมือถือ ใช้บัญชีเดิมเข้าเล่นต่อได้ทันที",
} = Astro.props;

const SCROLL_PX_PER_SEC = 50;
const PX_PER_CHAR = 6.2;
const TRAILING_PX = 81;
const scrollSeconds = Math.max(12, Math.round((message.length * PX_PER_CHAR + TRAILING_PX) / SCROLL_PX_PER_SEC));
---

<div class="mx-auto w-full max-w-7xl px-4 py-3 font-sans">
  <div class="relative overflow-hidden rounded-md border border-[#f5c542]/45 bg-[#0d0904] shadow-[0_0_15px_rgba(245,197,66,0.18)]">
    <div aria-hidden="true" class="absolute top-0 -left-4 h-full w-8 -skew-x-12 bg-gradient-to-b from-[#ffe9a8] to-[#bc7b14]"></div>
    <div aria-hidden="true" class="absolute top-0 -right-4 h-full w-8 -skew-x-12 bg-[#f5c542]/20"></div>

    <div class="flex items-center">
      <div class="relative z-10 flex w-12 shrink-0 items-center justify-center bg-gradient-to-b from-[#ffe9a8] to-[#bc7b14] py-2.5">
        <span aria-hidden="true" class="animate-pulse text-lg drop-shadow-[0_0_5px_rgba(245,197,66,0.85)]">🔔</span>
      </div>

      <div class="marquee-container relative flex-1 overflow-hidden py-2.5 pr-6">
        <div aria-hidden="true" class="pointer-events-none absolute top-0 left-0 z-10 h-full w-8 bg-gradient-to-r from-[#0d0904] to-transparent"></div>
        <div aria-hidden="true" class="pointer-events-none absolute top-0 right-0 z-10 h-full w-12 bg-gradient-to-l from-[#0d0904] to-transparent"></div>

        <div class="marquee-content inline-block pl-4 text-sm font-bold tracking-wide whitespace-nowrap text-[#ffe9a8]" style={`animation-duration:${scrollSeconds}s`}>
          <span class="mr-8 inline-flex items-center gap-2"><span aria-hidden="true" class="h-1.5 w-1.5 rounded-full bg-[#f5c542] shadow-[0_0_5px_rgba(245,197,66,0.85)]"></span>{message}</span>
          <span aria-hidden="true" class="mr-8 inline-flex items-center gap-2"><span class="h-1.5 w-1.5 rounded-full bg-[#f5c542] shadow-[0_0_5px_rgba(245,197,66,0.85)]"></span>{message}</span>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .marquee-content {
    animation: marquee 25s linear infinite;
  }
  .marquee-container:hover .marquee-content {
    animation-play-state: paused;
  }
  @keyframes marquee {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee-content {
      animation: none;
    }
  }
</style>
