---
const providers = [
  { name: "เว็บนอกลิขสิทธิ์แท้", desc: "เชื่อมกับระบบตรง มีเกมให้เล่นจริงมากกว่าคำโฆษณา ไม่ต้องผ่านเอเย่นต์หลายชั้นก่อนถึงหน้าเกม", tag: "ระบบตรง", icon: "🦈" },
  { name: "ยูสเดียวเข้าได้ทุกค่าย", desc: "เลือกเกมจากค่ายที่เปิดให้บริการได้ทันที เส้นทางตั้งแต่ Login ถึงหน้าเกมสั้นและเข้าใจง่าย", tag: "ยูสเดียว", icon: "🔑" },
  { name: "จ่ายเต็มทุกบิล 100%", desc: "จ่ายเต็มทุกยอดทุกบิล ไม่มีลดทอนยอดที่สมาชิกได้รับจากระบบไม่ว่ารายการจะใหญ่แค่ไหน", tag: "ไม่ลดทอน", icon: "💰" },
  { name: "ฝากถอนออโต้", desc: "รับคำขอ ตรวจสอบข้อมูล และอัปเดตสถานะรายการด้วยการประมวลผลอัตโนมัติของระบบเอง", tag: "ออโต้", icon: "⚡" },
  { name: "ตรวจสอบก่อนยืนยัน", desc: "ดูยอดคงเหลือ ยอดถอน และสถานะรายการได้ก่อนกดยืนยัน เห็นข้อมูลตรงกันตั้งแต่ต้นจนจบ", tag: "เห็นตรงกัน", icon: "🔎" },
  { name: "ข้อมูลเกมแสดงครบ", desc: "ตารางจ่าย ฟีเจอร์โบนัส และข้อมูล RTP อ่านได้จากหน้าของเกมที่ให้บริการโดยตรง", tag: "ดู RTP ได้", icon: "🎰" },
  { name: "ใช้ได้ทุกอุปกรณ์", desc: "มือถือ แท็บเล็ต และคอมพิวเตอร์ ใช้ข้อมูลบัญชีชุดเดียวกัน ไม่ต้องเริ่มใหม่เมื่อเปลี่ยนเครื่อง", tag: "ทุกหน้าจอ", icon: "📱" },
];
---

<section aria-label="จุดเด่นของ BABYSHARK8899 เว็บนอกลิขสิทธิ์แท้" class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#9ed4ff] via-[#38a9ff] to-[#ff8080] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      สิ่งที่ <span class="text-[#ff8080]">BABYSHARK8899</span> รวมไว้ในยูสเดียว
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#0b83fa] to-transparent"></div>
  </div>

  <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4 lg:gap-5 xl:grid-cols-7">
    {
      providers.map((provider) => (
        <a
          href="/register"
          class="group relative flex flex-col items-center justify-center overflow-hidden rounded-2xl border border-[#0a2258] bg-[#000b24] p-5 shadow-[0_10px_30px_rgba(11,131,250,0.14)] transition-all duration-300 hover:-translate-y-2 hover:border-[#0b83fa]/55 hover:bg-[#04143c] hover:shadow-[0_15px_40px_rgba(11,131,250,0.28)]">
          <div class="pointer-events-none absolute inset-0 bg-[#0b83fa]/8 opacity-0 transition-opacity duration-300 group-hover:opacity-100" />

          <div class="absolute top-2 right-2 z-10 rounded-full bg-gradient-to-r from-[#ff8080] via-[#e8202a] to-[#b0121a] px-2 py-0.5 text-[9px] font-black tracking-wide whitespace-nowrap text-white shadow-sm transition-transform duration-300 group-hover:scale-110">
            {provider.tag}
          </div>

          <div aria-hidden="true" class="mb-3 text-4xl transition-transform duration-300 group-hover:scale-125 group-hover:rotate-3">
            {provider.icon}
          </div>
          <p class="text-center text-sm font-black text-[#6cc5ff] transition-colors group-hover:text-[#9ed4ff]">{provider.name}</p>
          <p class="mt-1 text-center text-[10px] text-[#9fb8dc]">{provider.desc}</p>

          <span class="relative z-10 mt-4 block w-full rounded-full border border-[#00397f] bg-[#04143c] py-1.5 text-center text-[11px] font-bold text-[#6cc5ff] shadow-inner transition-colors duration-300 group-hover:border-transparent group-hover:bg-gradient-to-r group-hover:from-[#9ed4ff] group-hover:via-[#38a9ff] group-hover:to-[#0057c7] group-hover:text-[#000b24]">
            สมัครเข้าเล่น
          </span>
        </a>
      ))
    }
  </div>
</section>
