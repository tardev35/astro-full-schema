---
import { Picture } from "astro:assets";

import slide2 from "../assets/slide2.png";
import slide3 from "../assets/slide3.png";

const images = [
  {
    src: slide2,
    alt: "ภาพโปรโมชั่น POE888 พื้นหลังโทนน้ำเงินเข้ม มีลูกบอลหวยหมายเลข 8 3 5 และ 9 ลอยอยู่ ด้านบนเป็นโลโก้ POE888 พร้อมมงกุฎ ตรงกลางเป็นตัวอักษรทองขนาดใหญ่ว่า POE888 คู่กับคำว่า หวยออนไลน์ ถัดลงมาเขียนว่า แทงหวยไทยลาว ตรวจผลไว ถอนง่าย ใต้ลงมาเป็นแถบสี่ช่องเขียนว่า หวยไทย หวยลาว หวยฮานอย และ หวยมาเลย์ ตามด้วยป้ายสองอันเขียนว่า เว็บสีฟ้า และ อัตราจ่ายชัดเจน ด้านซ้ายเป็นพรีเซนเตอร์หญิงสวมชุดสีน้ำเงินสกรีนคำว่า POE888 ชูนิ้วชี้ขึ้น ข้างตัวเป็นกล่องทองเขียนว่า 3 ตัวบน สูงสุด 1,200 และ 2 ตัวบน สูงสุด 120 ด้านขวาเป็นตารางหัวข้อ อัตราจ่าย ระบุว่า 3 ตัวบน บาทละ 950, 3 ตัวโต๊ด บาทละ 150, 3 ตัวล่าง บาทละ 200, 2 ตัวบน บาทละ 95 และ 2 ตัวล่าง บาทละ 95 แถบล่างสุดเขียนว่า ระบบปลอดภัย มั่นคง เชื่อถือได้, ออกรางวัลไว อัปเดตทันที, ถอนง่าย จ่ายจริง มั่นใจ 100% และไลน์ไอดี @POE888",
  },
  {
    src: slide3,
    alt: "ภาพโปรโมชั่น POE888 พื้นหลังโทนน้ำเงิน มีลูกบอลหวยหมายเลข 5 8 1 3 และ 9 กระจายอยู่ ด้านบนซ้ายเป็นโลโก้ POE888 รูปหมีแพนด้าถือปึกธนบัตร ตรงกลางเป็นตัวอักษรทองขนาดใหญ่ว่า POE888 คู่กับคำว่า หวยออนไลน์ ถัดลงมาเป็นป้ายเขียนว่า แทงหวยไทยลาว และ เว็บสีฟ้า ตรวจผลไว ถอนง่าย ด้านซ้ายเป็นพรีเซนเตอร์หญิงสวมชุดสีน้ำเงินสลับเหลืองสกรีนคำว่า POE888 ถือสลากลอตเตอรี่คลี่เป็นพัด ด้านขวาเป็นปุ่มธงสี่ตลาดเรียงลงมาเขียนว่า หวยไทย หวยลาว ฮานอย และ หวยมาเลย์ แถวล่างสุดเป็นกล่องสองอันเขียนว่า 2 ตัว บาทละ 95 และ 3 ตัว บาทละ 950",
  },
];

const COPIES = 3;
const slides = Array.from({ length: COPIES }, () => images).flat();
---

<div class="marquee mx-auto w-full max-w-7xl overflow-hidden px-4 py-5">
  <input id="carousel-pause" type="checkbox" class="peer sr-only" />
  <label
    for="carousel-pause"
    class="sr-only cursor-pointer peer-focus-visible:not-sr-only peer-focus-visible:mb-3 peer-focus-visible:inline-block peer-focus-visible:rounded-full peer-focus-visible:border peer-focus-visible:border-[#2e8bff]/60 peer-focus-visible:px-4 peer-focus-visible:py-2 peer-focus-visible:text-sm peer-focus-visible:font-bold peer-focus-visible:text-[#a8d4ff]">
    หยุด / เล่นสไลด์ภาพ
  </label>

  <div class="marquee-track flex">
    {
      slides.map((slide, index) => {
        const isDuplicate = index >= images.length;
        return (
          <div class="marquee-slide" aria-hidden={isDuplicate ? "true" : undefined}>
            <Picture
              src={slide.src}
              alt={isDuplicate ? "" : slide.alt}
              class="block w-full rounded-xl border border-[#ffd93d]/40 object-cover shadow-[0_10px_30px_rgba(11,78,168,0.30)]"
              width={slide.src.width}
              height={slide.src.height}
              loading="lazy"
              fetchpriority="low"
              decoding="async"
              widths={[300, 360, 420, 480, 540, 600]}
              sizes="(max-width: 767px) calc(100vw - 32px), (max-width: 1279px) calc((100vw - 48px) / 2), 403px"
              formats={["avif", "webp"]}
              fallbackFormat="webp"
              quality={60}
            />
          </div>
        );
      })
    }
  </div>
</div>

<style>
  .marquee {
    --gap: 12px;
    --per-view: 1;
    --shift: calc(-200% - 24px);
  }

  @media (min-width: 768px) {
    .marquee {
      --gap: 16px;
      --per-view: 2;
      --shift: calc(-100% - 16px);
    }
  }

  @media (min-width: 1280px) {
    .marquee {
      --gap: 20px;
      --per-view: 3;
      --shift: calc(-66.6667% - 13.3333px);
    }
  }

  .marquee-track {
    gap: var(--gap);
    width: 100%;
    animation: carousel-scroll 24s linear infinite;
    will-change: transform;
  }

  .marquee-slide {
    flex: 0 0 calc((100% - (var(--per-view) - 1) * var(--gap)) / var(--per-view));
  }

  @keyframes carousel-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(var(--shift));
    }
  }

  .marquee:hover .marquee-track,
  .marquee:focus-within .marquee-track,
  .marquee > input:checked ~ .marquee-track {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
    }
  }
</style>
