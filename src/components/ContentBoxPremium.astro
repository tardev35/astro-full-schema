---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#f6c9c6] bg-white p-8 text-left text-base leading-relaxed text-[#2d1214] shadow-[0_10px_30px_rgba(230,0,18,0.12)] transition-all duration-500 hover:border-[#e60012]/45 hover:shadow-[0_15px_40px_rgba(230,0,18,0.20)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#e60012]/14 blur-[55px] transition-all duration-500 group-hover:bg-[#ff4b41]/22"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#d4a017]/20 blur-[55px] transition-all duration-500 group-hover:bg-[#f5c542]/28"></div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#f6c9c6] pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#e60012] via-[#b30009] to-[#d4a017] shadow-[0_0_10px_rgba(230,0,18,0.35)]" />
          <HeadingTag class={`bg-gradient-to-r from-[#8a0208] via-[#e60012] to-[#8a6410] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
            {title}
          </HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
