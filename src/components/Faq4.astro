---
const faqs = [
  { q: "S8P888 ต้องโยกเงินก่อนเล่นไหม?", a: "ไม่จำเป็นครับ ระบบของเราใช้กระเป๋าเงินเดียว (Single Wallet) เล่นได้ทุกค่ายเกมในยูสเซอร์เดียว" },
  { q: "หากมีปัญหาเข้าใช้งานไม่ได้ ต้องทำอย่างไร?", a: "สามารถติดต่อ Call Center ของเราได้ทันทีตลอด 24 ชั่วโมง เรามีทีมงานพร้อมให้คำแนะนำและส่งลิงก์ทางเข้าล่าสุดให้คุณเสมอ" },
  { q: "รับโบนัส 100% ต้องทำอย่างไร?", a: "เพียงสมัครสมาชิกใหม่และทำตามเงื่อนไขที่ระบุหน้าเว็บไซต์ โบนัสจะถูกเติมเข้าสู่ระบบให้ทันที" },
];
---


 <div class="mx-auto max-w-[1000px] px-4 py-10 font-sans">
  <div class="mb-8 flex items-center gap-3 border-l-4 border-emerald-500 bg-gradient-to-r from-emerald-900/40 via-emerald-900/10 to-transparent py-2.5 px-4"
       style="clip-path: polygon(0 0, 100% 0, calc(100% - 15px) 100%, 0 100%);">
    <h3 class="text-xl font-black uppercase tracking-widest text-amber-400 drop-shadow-[0_0_8px_rgba(16,185,129,0.5)] md:text-2xl">คำถามที่พบบ่อย (FAQ) เกี่ยวกับการใช้งาน S8P888
    </h3>
  </div>

  <div class="space-y-4">
    {
      faqs.map((faq, index) => (
        <div class="faq-item group relative overflow-hidden bg-[#01120a]/80 border border-emerald-500/30 transition-all duration-300 hover:border-emerald-400 hover:shadow-[0_0_20px_rgba(16,185,129,0.2)] backdrop-blur-sm"
             style="clip-path: polygon(15px 0, 100% 0, 100% calc(100% - 15px), calc(100% - 15px) 100%, 0 100%, 0 15px);">
          
          <div class="absolute top-0 left-0 h-[2px] w-16 bg-gradient-to-r from-emerald-500 to-transparent"></div>
          
          <button class="faq-trigger flex w-full items-center justify-between p-5 text-left transition-all">
            <span class="text-sm font-bold text-white/90 transition-colors group-hover:text-emerald-300 md:text-lg flex items-center gap-2">
              <span class="text-yellow-400 font-mono">>_</span> {faq.q}
            </span>
            
            <span class="icon ml-4 flex h-8 w-8 shrink-0 items-center justify-center border border-emerald-500/40 bg-[#064e3b]/50 text-emerald-400 transition-all duration-300 group-hover:border-yellow-400 group-hover:text-yellow-400 group-hover:shadow-[0_0_10px_rgba(255,215,0,0.5)]"
                  style="clip-path: polygon(25% 0, 100% 0, 100% 75%, 75% 100%, 0 100%, 0 25%);">
              <i class="fa-solid fa-plus text-xs" />
            </span>
          </button>
          
          <div class="faq-content max-h-0 overflow-hidden transition-all duration-300 ease-in-out">
            <div class="border-t border-emerald-500/20 p-5 pt-0 text-sm leading-relaxed text-emerald-50/70 md:text-base">
              {faq.a}
            </div>
          </div>
        </div>
      ))
    }
  </div>
</div>

<script>
  const triggers = document.querySelectorAll(".faq-trigger");
  triggers.forEach((trigger) => {
    trigger.addEventListener("click", () => {
      const parent = trigger.parentElement;
      const content = trigger.nextElementSibling;
      const icon = trigger.querySelector(".icon");

  
      document.querySelectorAll(".faq-item").forEach((item) => {
        if (item !== parent) {
          item.classList.remove("active");
          (item.querySelector(".faq-content") as HTMLElement).style.maxHeight = "0";
          item.querySelector(".icon")?.classList.remove("rotate-45");
        }
      });

      parent?.classList.toggle("active");
      if (parent?.classList.contains("active")) {
        (content as HTMLElement).style.maxHeight = content?.scrollHeight + "px";
        icon?.classList.add("rotate-45");
      } else {
        (content as HTMLElement).style.maxHeight = "0";
        icon?.classList.remove("rotate-45");
      }
    });
  });
</script>

<style>
  .rotate-45 {
    transform: rotate(45deg);
    border-color: #ef4444 !important;
    color: #ef4444 !important;
  }
  .faq-item.active {
    border-color: rgba(234, 179, 8, 0.6);
    box-shadow: 0 0 20px rgba(0, 0, 0, 0.5);
  }
  h3,
  .space-y-4 {
    font-family: "kanit", sans-serif;
  }
</style>
