---
import ContentBoxTwo from "./ContentBoxTwo.astro";

const jackpotProviders = [
  { rank: "🥇", name: "PG Soft", rtp: 98.8 },
  { rank: "🥈", name: "Pragmatic Play", rtp: 98.5 },
  { rank: "🥉", name: "JILI", rtp: 97.9 },
  { rank: "4", name: "Habanero", rtp: 97.4 },
  { rank: "5", name: "CQ9 Gaming", rtp: 97.1 },
];
---

<ContentBoxTwo titleleft="เข้าสู่ระบบ 999LORD" titleright="RTP ค่ายเกมยอดนิยม">
  <div slot="left" class="flex h-full flex-col gap-4">
    <div class="relative overflow-hidden rounded-2xl border border-blue-500/30 bg-gradient-to-br from-blue-900/40 to-black/60 p-6 shadow-[0_0_20px_rgba(37,99,235,0.1)] backdrop-blur-md">
      <div class="pointer-events-none absolute -top-10 -right-10 h-32 w-32 rounded-full bg-blue-600/10 blur-[50px]"></div>

      <div class="relative z-10 mb-5 flex items-center gap-3">
        <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-red-400/40 bg-gradient-to-br from-blue-700 to-black text-xl shadow-inner">🎰</span>
        <div class="flex flex-col">
          <h3 class="text-base font-black text-white">ยินดีต้อนรับกลับ</h3>
          <span class="text-[11px] text-gray-400">บัญชีเดียว เชื่อมต่อทุกฟังก์ชันของ 999LORD</span>
        </div>
      </div>

      <div class="relative z-10 flex flex-col gap-3.5">
        <div class="relative">
          <span class="absolute top-3.5 left-4 text-blue-400">👤</span>
          <input
            type="text"
            placeholder="ยูสเซอร์เนม / เบอร์โทรศัพท์"
            class="w-full rounded-xl border border-blue-500/50 bg-black/60 py-3 pr-4 pl-12 text-white transition-all outline-none focus:border-red-400 focus:ring-1 focus:ring-red-400/50"
          />
        </div>
        <div class="relative">
          <span class="absolute top-3.5 left-4 text-blue-400">🔑</span>
          <input
            type="password"
            placeholder="รหัสผ่าน"
            class="w-full rounded-xl border border-blue-500/50 bg-black/60 py-3 pr-4 pl-12 text-white transition-all outline-none focus:border-red-400 focus:ring-1 focus:ring-red-400/50"
          />
        </div>

        <div class="flex items-center justify-between px-1 text-xs">
          <label class="flex items-center gap-2 text-gray-400">
            <input type="checkbox" class="h-3.5 w-3.5 rounded border-blue-500/50 bg-black/60 accent-blue-500" />
            จดจำฉันไว้
          </label>
          <a href="#" class="text-gray-400 transition-colors hover:text-white">ลืมรหัสผ่าน?</a>
        </div>

        <button
          class="mt-1 w-full rounded-xl border border-red-400/50 bg-gradient-to-r from-red-500 to-red-600 p-3.5 font-black text-white shadow-[0_5px_15px_rgba(239,68,68,0.5)] transition-all hover:scale-[1.02] hover:shadow-[0_8px_25px_rgba(239,68,68,0.7)]">
          เข้าสู่ระบบ
        </button>

        <div class="flex items-center gap-3 py-1 text-[11px] text-gray-500">
          <span class="h-px flex-1 bg-white/10"></span>
          หรือ
          <span class="h-px flex-1 bg-white/10"></span>
        </div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] p-3 text-sm font-bold text-white shadow-md transition-all hover:scale-[1.02]">
          💬 ติดต่อแอดมิน LINE
        </a>

        <div class="mt-1 flex items-center justify-between px-1">
          <div class="flex gap-2">
            <span class="rounded-full border border-green-500/30 bg-green-900/20 px-2.5 py-1 text-[10px] font-bold text-green-400">🔒 SSL Secure</span>
            <span class="rounded-full border border-blue-500/30 bg-blue-900/20 px-2.5 py-1 text-[10px] font-bold text-blue-400">⚡ เว็บตรง</span>
          </div>
          <a href="/register" class="animate-pulse text-xs font-bold text-red-400 transition-colors hover:text-red-300">สมัครสมาชิกใหม่</a>
        </div>
      </div>
    </div>
  </div>

  <div slot="right" class="h-full">
    <div class="flex h-full flex-col rounded-2xl border border-blue-500/30 bg-gradient-to-br from-blue-900/40 to-black/60 p-5 backdrop-blur-md">
      <div class="mb-5 flex items-center justify-between">
        <div>
          <span class="text-xs font-bold tracking-wide text-gray-400">RTP เฉลี่ยจากข้อมูลที่เปิดเผย (%)</span>
          <div class="bg-gradient-to-r from-cyan-300 via-blue-400 to-blue-500 bg-clip-text text-3xl font-black text-transparent drop-shadow-[0_2px_10px_rgba(56,189,248,0.4)] sm:text-4xl">
            96.7% RTP รวม
          </div>
        </div>
        <span class="flex items-center gap-1.5 self-start rounded-full border border-green-500/40 bg-green-900/20 px-2.5 py-1">
          <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-green-400 shadow-[0_0_8px_rgba(74,222,128,0.8)]"></span>
          <span class="text-[10px] font-bold tracking-widest text-green-400 uppercase">Live</span>
        </span>
      </div>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-gray-500 uppercase">
        <span>ค่ายเกม</span>
        <span>RTP</span>
      </div>

      <div class="flex flex-1 flex-col gap-2.5">
        {
          jackpotProviders.map((p) => (
            <div class="rounded-xl border border-white/5 bg-white/5 px-3.5 py-2.5 transition-colors hover:border-blue-400/40 hover:bg-white/10">
              <div class="flex items-center justify-between text-sm">
                <span class="flex items-center gap-2 font-bold text-white">
                  <span class="w-5 text-center">{p.rank}</span> {p.name}
                </span>
                <span class="font-black text-green-400">{p.rtp}%</span>
              </div>
              <div class="mt-1.5 h-1.5 w-full overflow-hidden rounded-full bg-black/40">
                <div class="h-full rounded-full bg-gradient-to-r from-green-500 to-emerald-400" style={`width:${p.rtp}%`} />
              </div>
            </div>
          ))
        }
      </div>

      <div class="mt-4 text-center text-[10px] tracking-wide text-gray-500">ข้อมูล RTP อ้างอิงจากการวิเคราะห์เกมของแต่ละค่าย ควรตรวจสอบก่อนเริ่มเล่นทุกครั้ง</div>
    </div>
  </div>
</ContentBoxTwo>
