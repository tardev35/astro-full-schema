---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";

import { Picture } from "astro:assets";

import pro1 from "../assets/slide1.png";
import pro2 from "../assets/slide2.png";
import pro3 from "../assets/slide3.png";
import pro4 from "../assets/slide4.png";
import { pageGraph } from "../lib/schema";

const pageTitle = "โปรโมชั่น 77RUAY สมาชิกใหม่ รวมเกมหลายค่าย ฝากถอนออโต้ เล่นได้ทุกที่บนมือถือ";

const pageHeading = "โปรโมชั่น 77RUAY สำหรับสมาชิกใหม่ รวมเกมหลายค่าย ฝากถอนออโต้ เล่นได้ทุกที่บนมือถือ";

const pageDescription =
  "โปรโมชั่น 77RUAY สำหรับสมาชิกใหม่ สมัครง่ายทุกอุปกรณ์ รวมสล็อตออนไลน์จาก PG Soft, Pragmatic Play, JILI และ Habanero ฝากถอนออโต้ 24 ชั่วโมง เล่นได้ทุกที่บนมือถือ";

const announcementMessage =
  "77RUAY สล็อตออนไลน์ เล่นผ่านเบราว์เซอร์ได้ทั้ง iOS และ Android ไม่ต้องโหลดแอป • ฝากถอนออโต้ตลอด 24 ชั่วโมง ไม่ต้องแนบสลิป • สมัคร ฝาก เล่น และถอนจบบนมือถือเครื่องเดียว • มีเรื่องติดขัดติดต่อแอดมินผ่านช่องทางบนหน้าเว็บ";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: pro1.src,
});

const promos = [
  {
    src: pro1,
    alt: "77RUAY สมาชิกใหม่ เริ่มต้นง่าย สมัครสะดวก ใช้งานได้ทุกอุปกรณ์ สมัครง่าย ระบบมั่นคง พร้อมดูแล",
  },
  {
    src: pro2,
    alt: "77RUAY สนุกครบหลายค่าย รวมเกมยอดนิยมไว้ในที่เดียว เกมหลากหลาย ใช้งานสะดวก เลือกได้ครบ",
  },
  {
    src: pro3,
    alt: "77RUAY ฝากถอนออโต้ รวดเร็ว ใช้งานง่าย มั่นใจได้ อัตโนมัติ ทันสมัย สะดวก",
  },
  {
    src: pro4,
    alt: "77RUAY เล่นได้ทุกที่ บนมือถือ ระบบทันสมัย พร้อมดูแลทุกขั้นตอน มือถือ ตอบไว พร้อมดูแล",
  },
];

const promoClass =
  "mx-auto h-auto w-full rounded-xl border border-[#d6e2f7] object-contain shadow-[0_10px_30px_rgba(10,31,92,0.08)] transition-all duration-300 hover:-translate-y-1 hover:border-[#9dbcf0] hover:shadow-[0_15px_40px_rgba(26,95,224,0.16)]";
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement message={announcementMessage} />

  <ContentBox title={pageHeading} as="h1">
    <p class="mb-4 text-left text-base leading-relaxed text-[#1f2a44]">
      หากคุณกำลังมองหาเว็บสล็อตที่เริ่มต้นง่ายและเล่นได้ทุกที่ <strong class="font-bold text-[#8a6508]">77RUAY</strong> พร้อมรวมเกมจากหลายค่ายไว้ในที่เดียว คู่กับระบบฝากถอนออโต้ตลอด 24 ชั่วโมง เพื่อให้คุณสนุกได้ต่อเนื่องบนมือถือเครื่องเดียว
    </p>

    <p class="mb-8 text-left text-base leading-relaxed text-[#1f2a44]">
      แต่ละภาพสรุปสิ่งที่สมาชิกได้ใช้ไว้ในตัว ส่วนเงื่อนไขของแต่ละโปรอาจต่างกัน ไม่แน่ใจตรงไหนทักแอดมินผ่านช่องทางบนหน้าเว็บก่อนรับสิทธิ์ได้เลย
    </p>

    <div class="grid w-full grid-cols-1 gap-6 sm:grid-cols-2">
      {
        promos.map((promo) => (
          <Picture
            src={promo.src}
            alt={promo.alt}
            loading="lazy"
            fetchpriority="low"
            widths={[400, 600]}
            sizes="(max-width: 768px) 100vw, 50vw"
            class={promoClass}
            decoding="async"
            formats={["avif", "webp"]}
            fallbackFormat="webp"
            quality={70}
          />
        ))
      }
    </div>

    <div class="mt-12 flex justify-center pb-4">
      <a
        href="/register/"
        class="flex items-center justify-center rounded-xl border-2 border-[#ffd45c] bg-gradient-to-b from-[#4d8ff5] via-[#1a5fe0] to-[#0b3a9e] px-10 py-3.5 text-lg font-black text-white shadow-[0_10px_30px_rgba(26,95,224,0.35)] transition-all hover:scale-105 hover:brightness-110 hover:shadow-[0_15px_40px_rgba(26,95,224,0.45)]">
        สมัครสมาชิก 77RUAY
      </a>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
