---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6" | "p";
  titleleft?: string;
  titleright?: string;
  label?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label } = Astro.props;

const sectionLabel = label ?? title ?? titleleft ?? titleright ?? "ข้อมูลประกอบ";
---

<section aria-label={sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#cfe9f4] bg-white p-6 text-[#23323f] shadow-[0_10px_30px_rgba(12,53,80,0.08)] transition-all duration-500 hover:border-[#8ed3ee] md:p-10">
    {
      title && (
        <header class="mb-6 flex items-center gap-4 border-b border-[#cfe9f4] pb-4">
          <span aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffd23f] to-[#f7941d]" />
          <HeadingTag class="text-2xl leading-normal font-black tracking-wide text-[#0c3550]">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#23323f]">
        {
          titleleft && (
            <p class="flex items-center gap-3 border-b border-[#cfe9f4] pb-3 text-xl leading-normal font-black tracking-wide text-[#0c3550]">
              <span
                aria-hidden="true"
                class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border-2 border-white bg-gradient-to-b from-[#19b2e0] to-[#0077b3] text-sm text-white shadow-[0_5px_15px_rgba(0,164,212,0.35)]">
                🔐
              </span>
              {titleleft}
            </p>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#23323f]">
        {
          titleright && (
            <p class="flex items-center gap-3 border-b border-[#cfe9f4] pb-3 text-xl leading-normal font-black tracking-wide text-[#0c3550]">
              <span
                aria-hidden="true"
                class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border-2 border-white bg-gradient-to-b from-[#ffd23f] via-[#ffb84d] to-[#f7941d] text-sm text-[#4a1d00] shadow-[0_5px_15px_rgba(247,148,29,0.40)]">
                🎰
              </span>
              {titleright}
            </p>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
