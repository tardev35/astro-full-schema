---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#064c39] bg-[#0f241d]/92 p-8 text-left text-base leading-relaxed text-[#dfeee6] shadow-[0_10px_30px_rgba(18,196,143,0.16)] transition-all duration-500 hover:border-[#12c48f]/60 hover:shadow-[0_15px_40px_rgba(18,196,143,0.26)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#12c48f]/20 blur-[60px] transition-all duration-500 group-hover:bg-[#4ff0bb]/28"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#e8b52c]/16 blur-[60px] transition-all duration-500 group-hover:bg-[#ffdd8a]/24"></div>

    {
      title && (
        <header class="mb-6 flex items-center gap-4 border-b border-[#064c39] pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#e8b52c] to-[#12c48f] shadow-[0_0_10px_rgba(232,181,44,0.5)]" />
          <HeadingTag class="bg-gradient-to-r from-[#ffdd8a] via-[#e8b52c] to-[#4ff0bb] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
