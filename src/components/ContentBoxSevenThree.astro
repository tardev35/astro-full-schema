---
const { titleleft, titleright } = Astro.props;
---

<section
  class="mx-auto mb-4 w-full max-w-7xl rounded-[30px] border-2 border-cyan-900/50 bg-[#001a33]/90 p-8 px-4 text-center font-sans shadow-[0_0_20px_rgba(6,182,212,0.15),inset_0_0_15px_rgba(6,182,212,0.05)] backdrop-blur-md transition-all duration-300 hover:border-cyan-500/50 hover:shadow-[0_0_30px_rgba(6,182,212,0.3)]">
  <div class="grid grid-cols-1 gap-5 md:grid-cols-[3fr_7fr]">
    <article class="flex flex-col gap-4">
      {titleleft && <h2 class="mb-4 text-3xl font-bold text-cyan-400 drop-shadow-[0_0_5px_rgba(6,182,212,0.4)]">{titleleft}</h2>}
      <div class="text-cyan-50/80">
        <slot name="left" />
      </div>
    </article>

    <article class="flex flex-col gap-4">
      {titleright && <h2 class="mb-4 text-3xl font-bold text-cyan-400 drop-shadow-[0_0_5px_rgba(6,182,212,0.4)]">{titleright}</h2>}
      <div class="text-cyan-50/80">
        <slot name="right" />
      </div>
    </article>
  </div>
</section>

<style>
  .font-sans {
    font-family: "Kanit", sans-serif;
  }
</style>
