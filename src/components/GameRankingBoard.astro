---
import { Picture } from "astro:assets";
import img1 from "../assets/providers/game1.avif";
import img2 from "../assets/providers/game2.avif";
import img3 from "../assets/providers/game3.avif";
import img4 from "../assets/providers/game4.avif";
import img5 from "../assets/providers/game5.avif";
import img6 from "../assets/providers/game6.avif";

const games = [
  { rank: 1, name: "สล็อต PG Soft", type: "ค่ายหลักในหมวดสล็อตของ TEMMAX69 มีเกมหลายสไตล์ให้เลือกต่อจากบัญชีเดียว", menus: ["ยอดนิยม", "หลายสไตล์"], players: 5124, img: img2 },
  { rank: 2, name: "สล็อตซื้อฟรีสปิน", type: "เข้าถึงฟีเจอร์ฟรีสปินได้เร็ว เหมาะกับสายโบนัสที่อยากลองรอบสั้นก่อนเลือกเกมประจำ", menus: ["ฟรีสปิน", "เข้าโบนัสไว"], players: 3842, img: img5 },
  { rank: 3, name: "สล็อต JILI", type: "เกมไลน์จ่ายหลายทาง สายลองเกมใหม่เปลี่ยนเกมได้เรื่อย ๆ จากหมวดสล็อตเดียว", menus: ["เกมใหม่", "เล่นล่าสุด"], players: 3517, img: img6 },
  { rank: 4, name: "สล็อต Joker Gaming", type: "เกมคลาสสิกที่คนมีเกมประจำหาเจอง่าย ใช้เครดิตชุดเดิมจากระบบสมาชิกได้ทันที", menus: ["เล่นประจำ", "รายการโปรด"], players: 2905, img: img3 },
  { rank: 5, name: "คาสิโนสดและเกมโต๊ะ", type: "หมวดสำหรับคนที่อยากเปลี่ยนบรรยากาศจากสล็อต โดยใช้บัญชีและเครดิตชุดเดียวกัน", menus: ["เกมสด", "เกมโต๊ะ"], players: 2431, img: img4 },
  { rank: 6, name: "เล่นผ่านมือถือ", type: "เปิดผ่านเบราว์เซอร์บนจอเล็กได้ เมนูใช้ด้วยมือเดียว ใช้บัญชีเดิมต่อจากคอมได้เลย", menus: ["ทุกอุปกรณ์", "จอเล็กใช้ง่าย"], players: 2108, img: img1 },
];

const medal = (rank: number) => (rank === 1 ? "🥇" : rank === 2 ? "🥈" : rank === 3 ? "🥉" : null);
---

<section aria-label="เกมยอดนิยมของ TEMMAX69" class="mx-auto w-full max-w-[1300px] px-4 py-8 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <span aria-hidden="true" class="text-2xl">🏆</span>
    <p class="bg-gradient-to-r from-[#67e8f9] via-[#22d3ee] to-[#c084fc] bg-clip-text text-2xl font-black tracking-widest text-transparent uppercase">เกมที่สมาชิก TEMMAX69 เปิดเล่นกันมากที่สุด</p>
    <p class="max-w-3xl text-base leading-relaxed text-[#ece4ff]/75">
      ทุกเกมในตารางนี้ใช้บัญชีและเครดิตชุดเดียวกัน เปลี่ยนหมวดไปมาได้โดยไม่ต้องสลับบัญชี ลำดับความนิยมขยับตามคนที่เข้ามาเล่นในแต่ละช่วง ไม่ได้แปลว่าเกมไหนให้อัตราจ่ายดีกว่าเกมไหน
    </p>
    <div class="mt-2 h-[3px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#a855f7] to-transparent"></div>
  </div>

  <div class="flex flex-col gap-3">
    {
      games.map((g) => {
        const top = g.rank === 1;
        return (
          <article
            class={`group relative flex items-center gap-3 overflow-hidden rounded-2xl border p-3 backdrop-blur-md transition-all duration-300 hover:-translate-y-0.5 sm:gap-5 sm:p-4 ${
              top
                ? "border-[#22d3ee]/55 bg-gradient-to-r from-[#35107a]/95 via-[#160735]/92 to-[#160735]/92 shadow-[0_15px_40px_rgba(34,211,238,0.28)]"
                : "border-[#a855f7]/40 bg-[#160735]/92 shadow-[0_10px_30px_rgba(7,2,24,0.55)] hover:border-[#22d3ee]/55 hover:shadow-[0_15px_40px_rgba(168,85,247,0.35)]"
            }`}>
            <div
              aria-hidden="true"
              class="pointer-events-none absolute top-1/2 -left-10 h-24 w-24 -translate-y-1/2 rounded-full bg-[#a855f7]/45 blur-[40px] transition-all duration-500 group-hover:bg-[#22d3ee]/25"
            />

            <div class="relative z-10 flex w-8 shrink-0 flex-col items-center justify-center sm:w-12">
              {medal(g.rank) ? (
                <span class="text-2xl sm:text-3xl">
                  <span aria-hidden="true">{medal(g.rank)}</span>
                  <span class="sr-only">อันดับ {g.rank}</span>
                </span>
              ) : (
                <span class="text-xl font-black text-[#a855f7] sm:text-2xl">#{g.rank}</span>
              )}
            </div>

            <div class={`relative z-10 h-14 w-14 shrink-0 overflow-hidden rounded-xl border sm:h-16 sm:w-16 ${top ? "border-[#22d3ee]/55" : "border-[#a855f7]/40"}`}>
              <Picture
                src={g.img}
                alt={`ภาพหน้าปกเกมของ ${g.name} บนกระดานเกมยอดนิยมของ TEMMAX69`}
                formats={["avif", "webp"]}
                fallbackFormat="webp"
                loading="lazy"
                fetchpriority="low"
                widths={[100, 200]}
                sizes="(max-width: 640px) 56px, 64px"
                decoding="async"
                class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-110"
              />
            </div>

            <div class="relative z-10 min-w-0 flex-1">
              <div class="flex items-center gap-2">
                <p class="truncate text-base font-black text-[#ece4ff] sm:text-lg">{g.name}</p>
                {top && (
                  <span class="hidden shrink-0 rounded-full border border-[#22d3ee]/60 bg-[#2b0a5e] px-2 py-0.5 text-[9px] font-black tracking-wider text-[#22d3ee] sm:inline">ยอดนิยมสูงสุด</span>
                )}
              </div>
              <p class="truncate text-[11px] text-[#ece4ff]/70 sm:text-xs">{g.type}</p>

              <div class="mt-2 flex flex-wrap items-center gap-1.5">
                {g.menus.map((m) => (
                  <span class="rounded-full border border-[#a855f7]/45 bg-[#2b0a5e] px-2.5 py-0.5 text-[10px] font-bold text-[#c084fc]">{m}</span>
                ))}
              </div>
            </div>

            <div class="relative z-10 hidden shrink-0 flex-col items-end gap-1 sm:flex">
              <span class="flex items-center gap-1.5 text-[11px] text-[#ece4ff]/70">
                <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-green-500 shadow-[0_0_6px_rgba(34,197,94,0.6)]" />
                <span class="tabular-nums" data-players data-base={g.players}>
                  {g.players.toLocaleString("en-US")}
                </span>{" "}
                ออนไลน์
              </span>
              <a
                href="/register"
                class={`rounded-full px-4 py-1.5 text-xs font-black transition-transform hover:scale-105 ${
                  top
                    ? "bg-gradient-to-r from-[#67e8f9] via-[#22d3ee] to-[#0e7490] text-[#070218] shadow-[0_10px_30px_rgba(34,211,238,0.30)]"
                    : "border border-[#22d3ee]/60 bg-[#2b0a5e] text-[#22d3ee] hover:border-[#22d3ee] hover:bg-[#35107a]"
                }`}>
                เข้าดูเกมนี้
              </a>
            </div>
          </article>
        );
      })
    }
  </div>
</section>

<script>
  import { startLiveCounters } from "../lib/liveCounter";

  startLiveCounters();
</script>
