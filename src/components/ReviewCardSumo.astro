---
// ข้อมูลรีวิวอ้างอิงจาก Requirement ของลูกพี่ พร้อมแต่งคอนเทนต์ให้ดูแพงและน่าเชื่อถือ
const reviews = [
  {
    name: "ทีม web develop หมีขาว",
    role: "ผู้เชี่ยวชาญด้านระบบเว็บไซต์",
    stars: 4,
    content: "ระบบหลังบ้านแน่นและเสถียรมากครับ โครงสร้าง API ของระบบฝาก-ถอนออโต้ทำงานได้ไวระดับเสี้ยววินาที ไร้รอยต่อจริงๆ แถม UI/UX ออกแบบมาให้ผู้เล่นใช้งานง่ายมาก หัก 1 ดาวเพราะอยากให้มีฟีเจอร์ปรับโหมดสว่างบ้าง รวมๆ คือโคตรตึง!",
    avatar: "🐻‍❄️"
  },
  {
    name: "ชุมนุม เว็บสล็อตออนไลน์",
    role: "คอมมูนิตี้รีวิวเว็บตรง",
    stars: 4,
    content: "ทางเพจเราเทสแล้ว คอนเฟิร์มว่าที่นี่คือ 'สล็อตเว็บตรงของแท้ 100%' รวมค่ายเกมไว้เยอะมาก และที่สำคัญคืออัตราการแตก (RTP) สูงกว่าเว็บเอเย่นต์ทั่วไป ไม่มีการปรับเรทหรือล็อคยูสเซอร์แน่นอน จ่ายจริงทุกบิล เป็นเว็บคุณภาพที่อยากแนะนำ",
    avatar: "🎰"
  },
  {
    name: "อาสาสมัครนักเล่นสล็อต",
    role: "ผู้เล่นระดับ VIP",
    stars: 5,
    content: "ลองเทสมาแล้วหลายเว็บ สุดท้ายจบที่ SUMOHENG ครับ! สล็อตแตกง่ายมาก ฟรีสปินเข้าบ่อยจัด โปรโมชั่นก็ให้มาแบบจัดเต็มคุ้มค่าสุดๆ แอดมินบริการดีตอบไว 24 ชม. เงินเข้าปุ๊บปั๊บ เอาไปเลย 5 ดาวเต็มๆ ไม่ผิดหวังแน่นอนครับ!",
    avatar: "👑"
  }
];
---

<section class="mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans relative z-10">
  
  <!-- Section Header -->
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <h2 class="text-3xl font-black uppercase tracking-widest text-transparent bg-clip-text bg-gradient-to-r from-red-500 via-gray-900 to-gray-400 drop-shadow-[0_2px_10px_rgba(255,255,255,0.2)]">
      เสียงตอบรับจาก <span class="text-red-500">ผู้ใช้งานจริง</span>
    </h2>
    <div class="h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-red-600 to-transparent mt-2"></div>
  </div>

  <!-- Review Cards Grid -->
  <div class="grid grid-cols-1 gap-6 md:grid-cols-3 lg:gap-8">
    {reviews.map((review) => (
      <article class="group relative flex flex-col justify-between rounded-3xl border border-red-600/30 bg-[#0a0a0a]/80 p-8 shadow-[0_10px_30px_rgba(0,0,0,0.8)] backdrop-blur-xl transition-all duration-500 hover:-translate-y-2 hover:border-red-500/60 hover:shadow-[0_15px_40px_rgba(220,38,38,0.3)]">
        
        <!-- แสงตกกระทบมุมการ์ด -->
        <div class="pointer-events-none absolute -left-10 -top-10 h-32 w-32 rounded-full bg-red-600/10 blur-[50px] transition-all duration-500 group-hover:bg-red-500/20"></div>
        
        <div class="relative z-10 flex flex-col gap-4">
          <!-- Quote Icon & Stars -->
          <div class="flex items-center justify-between border-b border-red-900/50 pb-4">
            <span class="text-4xl text-red-600/50 drop-shadow-[0_0_5px_rgba(220,38,38,0.5)] leading-none font-serif">"</span>
            <div class="flex gap-1 text-lg">
              {Array.from({ length: 5 }).map((_, i) => (
                <span class={`${i < review.stars ? 'text-yellow-400 drop-shadow-[0_0_5px_rgba(250,204,21,0.8)] animate-pulse' : 'text-gray-600'}`}>
                  ★
                </span>
              ))}
            </div>
          </div>
          
          <!-- Review Content -->
          <p class="text-sm leading-relaxed text-gray-300 min-h-[100px] italic">
            "{review.content}"
          </p>
        </div>

        <!-- Reviewer Info -->
        <div class="relative z-10 mt-6 flex items-center gap-4 pt-4 border-t border-white/5">
          <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-gradient-to-br from-red-700 to-black border border-red-500/30 text-2xl shadow-inner group-hover:scale-110 transition-transform duration-300">
            {review.avatar}
          </div>
          <div class="flex flex-col">
            <h4 class="text-base font-black text-white group-hover:text-red-400 transition-colors">{review.name}</h4>
            <span class="text-[11px] font-bold tracking-wider text-red-500/70 uppercase">{review.role}</span>
          </div>
        </div>

      </article>
    ))}
  </div>
</section>
<style>
  .font-sans {
    font-family: "Kanit", sans-serif;
  }
</style>