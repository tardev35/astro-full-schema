---
import { Picture } from "astro:assets";
import img1 from "../assets/providers/game1.avif";
import img2 from "../assets/providers/game2.avif";
import img3 from "../assets/providers/game3.avif";
import img4 from "../assets/providers/game4.avif";
import img5 from "../assets/providers/game5.avif";
import img6 from "../assets/providers/game6.avif";

const games = [
  {
    rank: 1,
    name: "สล็อตแตกง่าย รอบสั้น หมุนไว",
    type: "กลุ่มที่สมาชิกเปิดบ่อยที่สุด จังหวะเกมกระชับ ระบบแท้ 100% รันด้วยค่า RTP มาตรฐานสากลจากค่ายแม่ ไม่ล็อกยูส",
    menus: ["ระบบแท้ 100%", "รอบกระชับ"],
    players: 5124,
    img: img4,
  },
  {
    rank: 2,
    name: "สล็อตสายฟีเจอร์และฟรีสปิน",
    type: "เกมที่มีฟีเจอร์มาเต็มและรอบฟรีสปินให้ลุ้น ภาพสวย เสียงชัด เล่นลื่นไหลไม่มีสะดุด",
    menus: ["ฟีเจอร์เต็ม", "ฟรีสปิน"],
    players: 3842,
    img: img5,
  },
  {
    rank: 3,
    name: "สล็อตแจ็คพอต",
    type: "ลุ้นรางวัลใหญ่ตั้งแต่หลักแสนถึงหลักล้าน ยอดเท่าไหร่ก็โอนให้ครบทุกบาท ไม่มีผ่อนจ่าย ไม่หักค่าธรรมเนียม",
    menus: ["แจ็คพอต", "จ่ายไม่อั้น"],
    players: 3517,
    img: img6,
  },
  {
    rank: 4,
    name: "สล็อตเล่นลื่น ไม่กินเน็ต",
    type: "ระบบเสถียร ลื่นไหล ไม่ต้องโหลดแอป เปิดเล่นได้ทั้งมือถือ ไอแพด และคอมพิวเตอร์ด้วยยูสเซอร์เดียว",
    menus: ["ไม่กินเน็ต", "ทุกแพลตฟอร์ม"],
    players: 2905,
    img: img2,
  },
  {
    rank: 5,
    name: "บาคาร่าและคาสิโนสด",
    type: "สลับบรรยากาศจากสล็อตมาที่โต๊ะไพ่ได้จากยูสเซอร์เดิม ฝากถอนผ่านธนาคารหรือ True Wallet ได้เหมือนกัน",
    menus: ["ยูสเดียว", "True Wallet"],
    players: 2431,
    img: img1,
  },
  {
    rank: 6,
    name: "ยิงปลาและเกมจังหวะไว",
    type: "เล่นพร้อมกันหลายคนในห้องเดียว ระบบเดินต่อเนื่อง กลับเข้าเกมเดิมได้จากเมนูเดียวกับสล็อต",
    menus: ["ห้องรวม", "กลับเข้าเกมง่าย"],
    players: 2108,
    img: img3,
  },
];

const medal = (rank: number) => (rank === 1 ? "🥇" : rank === 2 ? "🥈" : rank === 3 ? "🥉" : null);
---

<section aria-label="กลุ่มเกมที่สมาชิก VODKAFUN เปิดเล่นบ่อย" class="mx-auto w-full max-w-[1300px] px-4 py-8 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <span aria-hidden="true" class="text-2xl">🏆</span>
    <p class="bg-gradient-to-r from-[#9bf2fb] via-[#ff8fe0] to-[#ff3dc8] bg-clip-text text-2xl font-black tracking-widest text-transparent uppercase">
      กลุ่มเกมที่สมาชิก VODKAFUN เปิดเล่นบ่อยที่สุด
    </p>
    <p class="max-w-3xl text-base leading-relaxed text-[#ece6ff]">
      ทุกกลุ่มในตารางนี้เข้าเล่นได้จากยูสเซอร์เดียว เลือกค่ายแล้วสลับไปมาได้ทันที ลำดับความนิยมขยับตามคนที่เข้ามาใช้งานในแต่ละช่วง ไม่ได้แปลว่ากลุ่มไหนจ่ายดีกว่ากลุ่มไหน
      รายละเอียดเกม ตารางจ่าย และข้อมูล RTP ให้ยึดตามหน้าของเกมที่ให้บริการจริง
    </p>
    <div class="mt-2 h-[3px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#ff3dc8] to-transparent"></div>
  </div>

  <div class="flex flex-col gap-3">
    {
      games.map((g) => {
        const top = g.rank === 1;
        return (
          <article
            class={`group relative flex items-center gap-3 overflow-hidden rounded-2xl border p-3 transition-all duration-300 hover:-translate-y-0.5 sm:gap-5 sm:p-4 ${
              top
                ? "border-[#ff3dc8]/55 bg-gradient-to-r from-[#120633] via-[#0a0320] to-[#120633] shadow-[0_15px_40px_rgba(255,61,200,0.26)]"
                : "border-[#1f0b4d] bg-[#0a0320] shadow-[0_10px_30px_rgba(255,61,200,0.14)] hover:border-[#ff3dc8]/45 hover:shadow-[0_15px_40px_rgba(255,61,200,0.22)]"
            }`}>
            <div
              aria-hidden="true"
              class="pointer-events-none absolute top-1/2 -left-10 h-24 w-24 -translate-y-1/2 rounded-full bg-[#ff3dc8]/18 blur-[40px] transition-all duration-500 group-hover:bg-[#1be5f4]/20"
            />

            <div class="relative z-10 flex w-8 shrink-0 flex-col items-center justify-center sm:w-12">
              {medal(g.rank) ? (
                <span class="text-2xl sm:text-3xl">
                  <span aria-hidden="true">{medal(g.rank)}</span>
                  <span class="sr-only">อันดับ {g.rank}</span>
                </span>
              ) : (
                <span class="text-xl font-black text-[#ff3dc8] sm:text-2xl">#{g.rank}</span>
              )}
            </div>

            <div class={`relative z-10 h-14 w-14 shrink-0 overflow-hidden rounded-xl border sm:h-16 sm:w-16 ${top ? "border-[#ff3dc8]/55" : "border-[#1f0b4d]"}`}>
              <Picture
                src={g.img}
                alt={`ภาพหน้าปกเกมประกอบรายการกลุ่ม ${g.name} บนกระดานกลุ่มเกมยอดนิยมของ VODKAFUN`}
                formats={["avif", "webp"]}
                fallbackFormat="webp"
                loading="lazy"
                fetchpriority="low"
                widths={[100, 200]}
                quality={60}
                sizes="(max-width: 640px) 56px, 64px"
                decoding="async"
                class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-110"
              />
            </div>

            <div class="relative z-10 min-w-0 flex-1">
              <div class="flex items-center gap-2">
                <p class="truncate text-base font-black text-[#ff8fe0] sm:text-lg">{g.name}</p>
                {top && (
                  <span class="hidden shrink-0 rounded-full border border-[#2c1266] bg-[#120633] px-2 py-0.5 text-[9px] font-black tracking-wider text-[#9bf2fb] sm:inline">ยอดนิยมสูงสุด</span>
                )}
              </div>
              <p class="truncate text-[11px] text-[#b9a9e6] sm:text-xs">{g.type}</p>

              <div class="mt-2 flex flex-wrap items-center gap-1.5">
                {g.menus.map((m) => (
                  <span class="rounded-full border border-[#1f0b4d] bg-[#120633] px-2.5 py-0.5 text-[10px] font-bold text-[#ff8fe0]">{m}</span>
                ))}
              </div>
            </div>

            <div class="relative z-10 hidden shrink-0 flex-col items-end gap-1 sm:flex">
              <span class="flex items-center gap-1.5 text-[11px] text-[#b9a9e6]">
                <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-green-400 shadow-[0_0_6px_rgba(74,222,128,0.7)]" />
                <span class="tabular-nums" data-players data-base={g.players}>
                  {g.players.toLocaleString("en-US")}
                </span>{" "}
                ออนไลน์
              </span>
              <a
                href="/register/"
                class={`rounded-full px-4 py-1.5 text-xs font-black transition-transform hover:scale-105 ${
                  top
                    ? "bg-gradient-to-r from-[#ff8fe0] via-[#ff3dc8] to-[#ff3dc8] text-[#14042e] shadow-[0_10px_30px_rgba(255,61,200,0.34)]"
                    : "border border-[#1f0b4d] bg-[#120633] text-[#ff8fe0] hover:border-[#ff3dc8]/55 hover:bg-[#1f0b4d]"
                }`}>
                สมัครเข้าเล่น
              </a>
            </div>
          </article>
        );
      })
    }
  </div>
</section>

<script>
  import { startLiveCounters } from "../lib/liveCounter";

  startLiveCounters();
</script>
