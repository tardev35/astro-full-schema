---
export interface Props {
  title?: string;
  titleleft?: string;
  titleright?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, titleleft, titleright, as: HeadingTag = "h2" } = Astro.props;
---

<section class="my-12 flex w-full justify-center px-4 font-sans">
  <div
    class="relative isolate w-full max-w-7xl rounded-2xl border-2 border-[#1d5c22] bg-[#06230a] p-8 pt-44 text-[#d9f7d0] shadow-[0_10px_30px_rgba(200,252,4,0.14)] md:pt-40">
    <div aria-hidden="true" class="pointer-events-none absolute -right-10 -bottom-16 -z-10 h-40 w-40 rounded-full bg-[#3fc20a]/22 blur-[60px]"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -top-16 -left-10 -z-10 h-40 w-40 rounded-full bg-[#c8fc04]/16 blur-[60px]"></div>

    {
      title && (
        <div class="absolute -top-6 left-1/2 w-[92%] max-w-2xl -translate-x-1/2 rounded-lg border-2 border-[#c8fc04]/70 bg-gradient-to-r from-[#0b3a10] via-[#1a7a08] to-[#0b3a10] px-4 py-2.5 text-center shadow-[0_10px_30px_rgba(63,194,10,0.30)] sm:px-8">
          <HeadingTag class="text-lg leading-normal font-black tracking-tight text-[#e6ff6a] uppercase sm:text-xl md:text-2xl">{title}</HeadingTag>
        </div>
      )
    }

    <div class="grid grid-cols-1 gap-10 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#d9f7d0]">
        {titleleft && <p class="text-2xl leading-normal font-bold text-[#c8fc04]">{titleleft}</p>}
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#d9f7d0] md:border-l md:border-[#1d5c22] md:pl-10">
        {titleright && <p class="text-2xl leading-normal font-bold text-[#c8fc04]">{titleright}</p>}
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
