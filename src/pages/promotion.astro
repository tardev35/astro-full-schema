---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";

import { Picture } from "astro:assets";

import pro1 from "../assets/pro1.png";

import pro2 from "../assets/pro2.png";

import pro3 from "../assets/pro3.jpg";

import pro4 from "../assets/pro4.jpg";

import pro5 from "../assets/pro5.jpg";

import pro6 from "../assets/pro6.jpg";

import pro7 from "../assets/pro7.png";

import pro8 from "../assets/pro8.jpg";

import pro9 from "../assets/pro9.jpg";

import pro10 from "../assets/pro10.jpg";

import pro11 from "../assets/pro11.jpg";

import pro12 from "../assets/pro12.png";

import pro13 from "../assets/pro13.jpg";

import pro14 from "../assets/pro14.jpg";
---

<MainLayout
  title="HYDRA888 โปรโมชั่น เครดิตฟรี สมาชิกใหม่และโบนัสยอดฝากล่าสุด"
  description="รวมโปรโมชั่น HYDRA888 ล่าสุด สมาชิกใหม่รับเครดิตฟรีทันที โบนัสต้อนรับและคืนยอดเสียทุกวัน เงื่อนไขถอนง่าย ระบบออโต้กดรับเองได้เลยไม่ต้องรอแอดมิน">
  <Announcement />

  <ContentBox>
    <h1 class="mb-7 bg-gradient-to-b from-[#ffffff] to-[#b91c1c] bg-clip-text text-3xl font-black text-transparent drop-shadow-[0_0_8px_rgba(185,28,28,0.5)]">
      HYDRA888 โปรโมชั่น เครดิตฟรี สมาชิกใหม่และโบนัสยอดฝากล่าสุด
    </h1>

    <div class="mx-auto grid w-full max-w-7xl grid-cols-1 gap-6 px-4 sm:grid-cols-2 lg:grid-cols-2 xl:grid-cols-2">
      <Picture
        src={pro1}
        alt="กิจกรรมแจกรางวัลรวม 30 ล้านบาท"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600, 800]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class="mx-auto h-auto w-full rounded-xl border border-red-900/50 object-contain shadow-lg transition-transform duration-300 hover:-translate-y-1 hover:border-red-500 hover:shadow-[0_10px_20px_rgba(185,28,28,0.4)]"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />
      <Picture
        src={pro2}
        alt="สมัครใหม่รับโบนัส 100% ทันที"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600, 800]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class="mx-auto h-auto w-full rounded-xl border border-red-900/50 object-contain shadow-lg transition-transform duration-300 hover:-translate-y-1 hover:border-red-500 hover:shadow-[0_10px_20px_rgba(185,28,28,0.4)]"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />
      <Picture
        src={pro3}
        alt="ต้อนรับสมาชิกใหม่แจก เครดิตฟรี 50"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600, 800]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class="mx-auto h-auto w-full rounded-xl border border-red-900/50 object-contain shadow-lg transition-transform duration-300 hover:-translate-y-1 hover:border-red-500 hover:shadow-[0_10px_20px_rgba(185,28,28,0.4)]"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />
      <Picture
        src={pro4}
        alt="สมัครใหม่รับโบนัส 60% ทันที"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600, 800]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class="mx-auto h-auto w-full rounded-xl border border-red-900/50 object-contain shadow-lg transition-transform duration-300 hover:-translate-y-1 hover:border-red-500 hover:shadow-[0_10px_20px_rgba(185,28,28,0.4)]"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />
      <Picture
        src={pro5}
        alt="โปรฝากยอดแรกของวัน รับโบนัส 20%"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600, 800]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class="mx-auto h-auto w-full rounded-xl border border-red-900/50 object-contain shadow-lg transition-transform duration-300 hover:-translate-y-1 hover:border-red-500 hover:shadow-[0_10px_20px_rgba(185,28,28,0.4)]"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />
      <Picture
        src={pro6}
        alt="คืนกำไรให้สมาชิก รับโบนัส 150%"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600, 800]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class="mx-auto h-auto w-full rounded-xl border border-red-900/50 object-contain shadow-lg transition-transform duration-300 hover:-translate-y-1 hover:border-red-500 hover:shadow-[0_10px_20px_rgba(185,28,28,0.4)]"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />
      <Picture
        src={pro7}
        alt="โปรโมชั่นแทงสเต็ปตายหมด รับคืน"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600, 800]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class="mx-auto h-auto w-full rounded-xl border border-red-900/50 object-contain shadow-lg transition-transform duration-300 hover:-translate-y-1 hover:border-red-500 hover:shadow-[0_10px_20px_rgba(185,28,28,0.4)]"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />
      <Picture
        src={pro8}
        alt="แนะนำเพื่อนร่วมสนุก รับค่าคอมมิชชั่น 0.8%"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600, 800]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class="mx-auto h-auto w-full rounded-xl border border-red-900/50 object-contain shadow-lg transition-transform duration-300 hover:-translate-y-1 hover:border-red-500 hover:shadow-[0_10px_20px_rgba(185,28,28,0.4)]"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />
      <Picture
        src={pro9}
        alt="ทุกยอดฝากของการเล่น รับเงินคืน"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600, 800]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class="mx-auto h-auto w-full rounded-xl border border-red-900/50 object-contain shadow-lg transition-transform duration-300 hover:-translate-y-1 hover:border-red-500 hover:shadow-[0_10px_20px_rgba(185,28,28,0.4)]"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />
      <Picture
        src={pro10}
        alt="โปรโมชั่นวันเกิด รับทันที 500 บาท"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600, 800]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class="mx-auto h-auto w-full rounded-xl border border-red-900/50 object-contain shadow-lg transition-transform duration-300 hover:-translate-y-1 hover:border-red-500 hover:shadow-[0_10px_20px_rgba(185,28,28,0.4)]"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />
      <Picture
        src={pro11}
        alt="แทงถูกหรือแทงผิดติดกัน 10 ตา รับเงินคืน"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600, 800]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class="mx-auto h-auto w-full rounded-xl border border-red-900/50 object-contain shadow-lg transition-transform duration-300 hover:-translate-y-1 hover:border-red-500 hover:shadow-[0_10px_20px_rgba(185,28,28,0.4)]"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />
      <Picture
        src={pro12}
        alt="กิจกรรมเปิดไพ่ลุ้นล้าน"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600, 800]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class="mx-auto h-auto w-full rounded-xl border border-red-900/50 object-contain shadow-lg transition-transform duration-300 hover:-translate-y-1 hover:border-red-500 hover:shadow-[0_10px_20px_rgba(185,28,28,0.4)]"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />
      <Picture
        src={pro13}
        alt="ปั่นกงล้อเสี่ยงโชค แจกทองทุกวัน"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600, 800]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class="mx-auto h-auto w-full rounded-xl border border-red-900/50 object-contain shadow-lg transition-transform duration-300 hover:-translate-y-1 hover:border-red-500 hover:shadow-[0_10px_20px_rgba(185,28,28,0.4)]"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />
      <Picture
        src={pro14}
        alt="ระบบ RANKING เลื่อนขั้นรับโบนัส"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600, 800]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class="mx-auto h-auto w-full rounded-xl border border-red-900/50 object-contain shadow-lg transition-transform duration-300 hover:-translate-y-1 hover:border-red-500 hover:shadow-[0_10px_20px_rgba(185,28,28,0.4)]"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />
    </div>

    <div class="mt-12 flex justify-center pb-4">
      <a
        href="/register"
        class="flex items-center justify-center rounded-lg bg-gradient-to-r from-red-700 to-red-900 px-10 py-3.5 text-lg font-black text-white shadow-[0_0_20px_rgba(185,28,28,0.6)] transition-transform hover:scale-105">
        รับโปรโมชั่นทันที
      </a>
    </div>
  </ContentBox>
</MainLayout>

<Navfoot />
