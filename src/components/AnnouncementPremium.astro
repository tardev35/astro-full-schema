---
const { message = "💎 QQ882 VIP CLUB: รับสิทธิพิเศษระดับ VIP รับโบนัส คืนยอดเสีย พร้อมบริการระดับพรีเมียมตลอด 24 ชั่วโมง ยิ่งเล่น ยิ่งได้รับสิทธิ์มากขึ้น!" } = Astro.props;
---

<div class="mx-auto w-full max-w-7xl px-4 py-4 font-sans">
  <div
    class="relative flex overflow-hidden rounded-full border border-purple-600/40 bg-[#260b42]/80 shadow-[0_8px_20px_rgba(59,7,100,0.4)] backdrop-blur-lg transition-shadow duration-300 hover:shadow-[0_8px_25px_rgba(147,51,234,0.3)]">
    <div
      class="relative z-10 flex shrink-0 items-center justify-center rounded-full bg-gradient-to-r from-yellow-600 via-yellow-500 to-yellow-600 px-8 py-2.5 font-black text-[#120322] shadow-[4px_0_15px_rgba(0,0,0,0.3)]">
      <span class="mr-2 text-lg">💎</span> ประกาศ
    </div>

    <div class="marquee-container relative flex-1 overflow-hidden py-2.5 pr-6">
      <div class="pointer-events-none absolute top-0 left-0 z-10 h-full w-12 bg-gradient-to-r from-[#260b42] to-transparent"></div>

      <div class="marquee-content inline-block pl-4 text-sm font-medium tracking-wide whitespace-nowrap text-purple-100">
        <span class="mr-10 inline-flex items-center gap-3"><span class="h-2 w-2 rounded-full bg-yellow-400 shadow-[0_0_8px_rgba(234,179,8,0.8)]"></span>{message}</span>
        <span class="mr-10 inline-flex items-center gap-3"><span class="h-2 w-2 rounded-full bg-yellow-400 shadow-[0_0_8px_rgba(234,179,8,0.8)]"></span>{message}</span>
      </div>
    </div>
  </div>
</div>

<style>
  .font-sans {
    font-family: "Kanit", sans-serif;
  }
  .marquee-content {
    animation: marquee 25s linear infinite;
  }
  .marquee-container:hover .marquee-content {
    animation-play-state: paused;
  }
  @keyframes marquee {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }
</style>
