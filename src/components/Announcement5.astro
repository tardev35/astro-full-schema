---
const {
  message = "OKG777 รวมสล็อต คาสิโนสด และกีฬาไว้ในบัญชีเดียว สลับหมวดเกมได้ต่อเนื่องโดยไม่ต้องย้ายเว็บ • สมาชิกใหม่รับฟรี 18 บาท ตามเงื่อนไขของกิจกรรมที่กำหนด • เครดิตฟรี 38 บาท และรางวัลชวนเพื่อน 88 บาท ตามช่วงโปรโมชั่น • ระบบฝากถอนอัตโนมัติ ตรวจสถานะรายการและประวัติธุรกรรมได้จากหน้าบัญชี",
} = Astro.props;
---

<div class="mx-auto w-full max-w-7xl px-4 py-3 font-sans">
  <div class="relative overflow-hidden rounded-md border border-[#ffd400]/45 bg-[#170733] shadow-[0_0_15px_rgba(255,212,0,0.18)]">
    <div class="absolute top-0 -left-4 h-full w-8 -skew-x-12 bg-gradient-to-b from-[#ff4fd8] to-[#8f1080]"></div>
    <div class="absolute top-0 -right-4 h-full w-8 -skew-x-12 bg-[#ffe94d]/20"></div>

    <div class="flex items-center">
      <div class="relative z-10 flex w-12 shrink-0 items-center justify-center bg-gradient-to-b from-[#ff4fd8] to-[#8f1080] py-2.5">
        <span aria-hidden="true" class="animate-pulse text-lg drop-shadow-[0_0_5px_rgba(255,233,77,0.85)]">🔔</span>
      </div>

      <div class="marquee-container relative flex-1 overflow-hidden py-2.5 pr-6">
        <div class="pointer-events-none absolute top-0 left-0 z-10 h-full w-8 bg-gradient-to-r from-[#170733] to-transparent"></div>
        <div class="pointer-events-none absolute top-0 right-0 z-10 h-full w-12 bg-gradient-to-l from-[#170733] to-transparent"></div>

        <div class="marquee-content inline-block pl-4 text-sm font-bold tracking-wide whitespace-nowrap text-[#ffe94d]">
          <span class="mr-8 inline-flex items-center gap-2"><span class="h-1.5 w-1.5 rounded-full bg-[#ff4fd8] shadow-[0_0_5px_rgba(255,79,216,0.85)]"></span>{message}</span>
          <span class="mr-8 inline-flex items-center gap-2"><span class="h-1.5 w-1.5 rounded-full bg-[#ff4fd8] shadow-[0_0_5px_rgba(255,79,216,0.85)]"></span>{message}</span>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .marquee-content {
    animation: marquee 25s linear infinite;
  }
  .marquee-container:hover .marquee-content {
    animation-play-state: paused;
  }
  @keyframes marquee {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }
</style>
