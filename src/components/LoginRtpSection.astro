---
import ContentBoxTwo from "./ContentBoxTwo.astro";

const steps = [
  { icon: "🔑", name: "เข้าสู่ระบบด้วยบัญชีเดิม", detail: "ใช้เบอร์โทรศัพท์หรือยูสเซอร์เนมที่สมัครไว้ เข้าได้ทั้งจากมือถือและคอม", tag: "ขั้นที่ 1" },
  { icon: "🎰", name: "เปิดหมวดสล็อตแล้วเลือกค่าย", detail: "เลือกค่ายดังที่สนใจก่อน แล้วค่อยไล่ดูเกมลิขสิทธิ์แท้ในค่ายนั้นจากหน้ารวมเกม", tag: "ขั้นที่ 2" },
  { icon: "🎁", name: "เช็กสิทธิ์โบนัสที่เปิดอยู่", detail: "ดูรูปแบบและเงื่อนไขของโบนัสแต่ละช่วงจากหน้าสมาชิกก่อนเลือกใช้", tag: "ขั้นที่ 3" },
  { icon: "💳", name: "จัดการเครดิตผ่านระบบออโต้", detail: "ส่งรายการฝากถอนจากหน้าบัญชีเดิม ดูยอดคงเหลือได้ก่อนกลับเข้าเกมต่อ", tag: "ขั้นที่ 4" },
  { icon: "🧾", name: "ย้อนดูประวัติรายการ", detail: "เครดิต โบนัส และรายการฝากถอนรวมอยู่ในบัญชีเดียว ตรวจย้อนหลังได้เอง", tag: "ขั้นที่ 5" },
];

const chips = ["เกมลิขสิทธิ์แท้", "สล็อตค่ายดัง", "หลายค่าย", "เกมโบนัส", "ฟรีสปิน", "โบนัสสมาชิก", "ฝากถอนออโต้"];
---

<ContentBoxTwo titleleft="เข้าสู่ระบบ ONEHENG89" titleright="ลำดับการใช้งานบนหน้าสมาชิก" label="เข้าสู่ระบบ ONEHENG89 และลำดับการใช้งานบนหน้าสมาชิก">
  <div slot="left" class="flex h-full flex-col gap-4">
    <div class="relative overflow-hidden rounded-2xl border border-[#c7dcfb] bg-white p-6 shadow-[0_10px_30px_rgba(11,63,184,0.12)]">
      <div aria-hidden="true" class="pointer-events-none absolute -top-10 -right-10 h-32 w-32 rounded-full bg-[#0b3fb8]/12 blur-[50px]"></div>

      <div class="relative z-10 mb-5 flex items-center gap-3">
        <span
          aria-hidden="true"
          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#c7dcfb] bg-gradient-to-br from-[#3b74e8] via-[#0b3fb8] to-[#062c85] text-xl shadow-inner">
          🎰
        </span>
        <div class="flex flex-col">
          <p class="text-base font-black text-[#0a1c3a]">เข้าสู่ระบบแล้วเลือกเกมค่ายที่ชอบต่อได้ทันที</p>
          <span class="text-[11px] text-[#5b7099]">บัญชีเดียวใช้เลือกค่ายเกม เช็กโบนัส ดูเครดิต และย้อนดูประวัติรายการของ ONEHENG89 ได้จากหน้าเดียว</span>
        </div>
      </div>

      <div class="relative z-10 flex flex-col gap-3.5">
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#0b3fb8]">👤</span>
          <input
            type="text"
            placeholder="เบอร์โทรศัพท์ / ยูสเซอร์เนม"
            class="w-full rounded-xl border border-[#c7dcfb] bg-[#f3f8ff] py-3 pr-4 pl-12 text-[#1b2c4a] transition-all outline-none placeholder:text-[#5b7099] focus:border-[#0b3fb8] focus:ring-1 focus:ring-[#0b3fb8]/40"
          />
        </div>
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#0b3fb8]">🔑</span>
          <input
            type="password"
            placeholder="รหัส PIN 4 หลัก"
            class="w-full rounded-xl border border-[#c7dcfb] bg-[#f3f8ff] py-3 pr-4 pl-12 text-[#1b2c4a] transition-all outline-none placeholder:text-[#5b7099] focus:border-[#0b3fb8] focus:ring-1 focus:ring-[#0b3fb8]/40"
          />
        </div>

        <div class="flex items-center justify-between px-1 text-xs">
          <label class="flex items-center gap-2 text-[#5b7099]">
            <input type="checkbox" class="h-3.5 w-3.5 rounded border-[#c7dcfb] bg-[#f3f8ff] accent-[#0b3fb8]" />
            จดจำฉันไว้
          </label>
          <a href="/login" class="text-[#5b7099] transition-colors hover:text-[#0b3fb8]">ลืมรหัส PIN?</a>
        </div>

        <button
          class="mt-1 w-full rounded-xl border border-[#0b3fb8]/40 bg-gradient-to-r from-[#0b3fb8] via-[#3b74e8] to-[#16a34a] p-3.5 font-black text-white shadow-[0_10px_30px_rgba(11,63,184,0.22)] transition-all hover:scale-[1.02] hover:shadow-[0_15px_40px_rgba(11,63,184,0.28)]">
          เข้าสู่ระบบ
        </button>

        <div class="flex items-center gap-3 py-1 text-[11px] text-[#5b7099]">
          <span class="h-px flex-1 bg-[#c7dcfb]"></span>
          หรือ
          <span class="h-px flex-1 bg-[#c7dcfb]"></span>
        </div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] p-3 text-sm font-bold text-white shadow-md transition-all hover:scale-[1.02]">
          <span aria-hidden="true">💬</span> ทักไลน์ทีมงานตลอด 24 ชั่วโมง
        </a>

        <div class="mt-1 flex items-center justify-between px-1">
          <div class="flex gap-2">
            <span class="rounded-full border border-[#c7dcfb] bg-[#f3f8ff] px-2.5 py-1 text-[10px] font-bold text-[#062c85]"><span aria-hidden="true">🔒</span> เข้ารหัสข้อมูล</span>
            <span class="rounded-full border border-[#a7e6c2] bg-[#e3f8ec] px-2.5 py-1 text-[10px] font-bold text-[#0f7a37]"><span aria-hidden="true">🕐</span> ใช้งานได้ตลอด 24 ชม.</span>
          </div>
          <a href="/register" class="text-xs font-bold text-[#5b7099] transition-colors hover:text-[#0b3fb8]">สมัครสมาชิกใหม่</a>
        </div>
      </div>
    </div>
  </div>

  <div slot="right" class="h-full">
    <div class="flex h-full flex-col rounded-2xl border border-[#c7dcfb] bg-white p-5 shadow-[0_10px_30px_rgba(11,63,184,0.12)]">
      <div class="mb-5 flex items-center justify-between gap-3">
        <div>
          <span class="text-xs font-bold tracking-wide text-[#5b7099]">ลำดับการใช้งานที่ ONEHENG89 วางไว้บนหน้าสมาชิก หลังเข้าสู่ระบบด้วยบัญชีเดิม</span>
          <div class="bg-gradient-to-r from-[#062c85] via-[#0b3fb8] to-[#16a34a] bg-clip-text text-2xl font-black text-transparent sm:text-3xl">เกมลิขสิทธิ์แท้ • โบนัส • ระบบออโต้</div>
        </div>
        <span class="flex items-center gap-1.5 self-start rounded-full border border-[#a7e6c2] bg-[#e3f8ec] px-2.5 py-1">
          <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-green-500 shadow-[0_0_8px_rgba(22,163,74,0.7)]"></span>
          <span class="text-[10px] font-bold tracking-widest text-[#0f7a37] uppercase">Live</span>
        </span>
      </div>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#5b7099] uppercase">
        <span>ขั้นตอนการใช้งาน</span>
        <span>ลำดับ</span>
      </div>

      <div class="flex flex-1 flex-col gap-2.5">
        {
          steps.map((s) => (
            <div class="rounded-xl border border-[#c7dcfb] bg-[#f3f8ff] px-3.5 py-2.5 transition-colors hover:border-[#0b3fb8]/45 hover:bg-[#e6efff]">
              <div class="flex items-center justify-between gap-2 text-sm">
                <span class="flex min-w-0 items-center gap-2 font-bold text-[#0a1c3a]">
                  <span aria-hidden="true" class="w-5 shrink-0 text-center">
                    {s.icon}
                  </span>{" "}
                  <span class="truncate">{s.name}</span>
                </span>
                <span class="shrink-0 rounded-full border border-[#0b3fb8]/35 bg-white px-2.5 py-0.5 text-[10px] font-bold text-[#062c85]">{s.tag}</span>
              </div>
              <div class="mt-1.5 text-[11px] tracking-wide text-[#5b7099]">{s.detail}</div>
            </div>
          ))
        }
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
        {chips.map((c) => <span class="rounded-full border border-[#c7dcfb] bg-[#f3f8ff] px-3 py-1 text-[10px] font-bold text-[#062c85]">{c}</span>)}
      </div>

      <div class="mt-3 text-center text-[10px] tracking-wide text-[#5b7099]">
        ลำดับในตารางสรุปจากที่หน้าเว็บแสดงไว้ รายละเอียดของเกมและเงื่อนไขโบนัสจริงให้ยึดตามหน้าสมาชิกและหน้าโปรโมชั่นของ ONEHENG89 ก่อนเลือกใช้ทุกครั้ง หากติดขัดตรงไหนทักไลน์ทีมงานได้ตลอด 24 ชั่วโมง
      </div>
    </div>
  </div>
</ContentBoxTwo>
