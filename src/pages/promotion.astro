---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement4.astro";

import { Picture } from "astro:assets";

import pro1 from "../assets/slide1.png";
import pro2 from "../assets/slide2.png";
import pro3 from "../assets/slide3.png";
import pro4 from "../assets/slide4.png";
import { pageGraph } from "../lib/schema";

const pageTitle = "โปรโมชั่น OSIRIS168 รวมภาพโปรสมาชิกใหม่ เว็บสล็อตระบบใหม่ 2026";

const pageHeading = "โปรโมชั่น OSIRIS168 รวมสิทธิ์สำหรับสมาชิก";

const pageDescription =
  "รวมภาพโปรโมชั่น OSIRIS168 ทั้งโปรเปิดยูสใหม่ โบนัสต้อนรับ และค่าคอมชวนเพื่อน ยอดรับกับเงื่อนไขระบุไว้บนภาพทุกใบ แล้วสมัครยูสเดียวรับสิทธิ์จากหน้าเมมเบอร์ได้เลย";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: pro1.src,
});

const promoClass =
  "mx-auto h-auto w-full rounded-xl border border-[#064c39] object-contain shadow-[0_10px_30px_rgba(18,196,143,0.16)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#12c48f]/60 hover:shadow-[0_15px_40px_rgba(18,196,143,0.26)]";
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageHeading} as="h1">
    <p class="mb-4 text-left text-base leading-relaxed text-[#dfeee6]">
      หากคุณกำลังมองหาโปรที่ดูจบได้ในหน้าเดียว <strong class="text-[#e8b52c]">OSIRIS168</strong> รวมภาพโปรของสมาชิกไว้ให้ครบ ตั้งแต่โปรเปิดยูสใหม่ โบนัสต้อนรับ ไปจนถึงค่าคอมชวนเพื่อน
    </p>

    <p class="mb-8 text-left text-base leading-relaxed text-[#dfeee6]">
      ยอดรับและเงื่อนไขของแต่ละโปรไม่เหมือนกัน ระบุไว้บนภาพแล้วทุกใบ เลือกใบที่ตรงกับงบของคุณ แล้วสมัครยูสเดียวรับสิทธิ์ต่อจากหน้าเมมเบอร์ เพื่อกดใช้ได้เองโดยไม่ต้องรอแอดมิน
    </p>

    <div class="grid w-full grid-cols-1 gap-6 sm:grid-cols-2">
      <Picture
        src={pro1}
        alt="ภาพโปรโมชั่น OSIRIS168 โปรเปิดยูสใหม่ เริ่มฝาก 50 รับเพิ่ม 150 โบนัสต้อนรับสมาชิกใหม่ ปุ่มเช็กโปรล่าสุด พรีเซนเตอร์หญิงชุดอียิปต์ดำทองชี้ไปที่ข้อความ ล้อมด้วยเหรียญทองบนพื้นหลังวิหารสีเขียวเข้ม บรรทัดล่างว่า เล่นผ่านมือถือสะดวก ระบบออโต้เต็มรูปแบบ"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class={promoClass}
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />

      <Picture
        src={pro2}
        alt="ภาพโปรโมชั่น OSIRIS168 ชวนเพื่อนรับค่าคอม 0.8% รับส่วนแบ่งทุกยอด เพื่อนสมัคร เพื่อนเล่น รับได้ต่อเนื่อง ปุ่มดูรายละเอียด พรีเซนเตอร์หญิงชุดอียิปต์ดำทอง ตัวเลข 0.8% สีเขียวมรกตขอบทอง บนพื้นหลังเสาวิหารทอง"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class={promoClass}
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />

      <Picture
        src={pro3}
        alt="ภาพโปรโมชั่น OSIRIS168 เว็บสล็อตระบบใหม่ปี 2026 สมัครใหม่รับโบนัส 100% สูงสุด 10,000 บาท รวมค่ายเกมดัง PG Pragmatic Play Joker Habanero Play'n GO พร้อมไอคอนสี่ช่องว่า เล่นผ่านมือถือไม่ต้องโหลดapp ฝากถอนออโต้เต็มระบบ 24 ชม. เกมสล็อตคุณภาพสูง และโปรสมาชิกใหม่คุ้มทุกยูส ด้านขวาเป็นพรีเซนเตอร์หญิงชุดอียิปต์ทอง"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class={promoClass}
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />

      <Picture
        src={pro4}
        alt="ภาพโปรโมชั่น OSIRIS168 สมาชิกใหม่ 100% โบนัสต้อนรับ สมัครวันนี้รับสิทธิ์ทันที ปุ่มดูโปรโมชั่น ตัวเลข 100% สีเขียวมรกตขอบทอง ด้านขวาเป็นพรีเซนเตอร์หญิงชุดอียิปต์ขาวทอง ด้านล่างมีปิรามิดทอง ไพ่ และกองเหรียญทอง"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class={promoClass}
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />
    </div>

    <div class="mt-12 flex justify-center pb-4">
      <a
        href="/register"
        class="flex items-center justify-center rounded-lg border border-[#e8b52c]/45 bg-gradient-to-r from-[#ffdd8a] via-[#e8b52c] to-[#8a6314] px-10 py-3.5 text-lg font-black text-[#050d0b] shadow-[0_10px_30px_rgba(232,181,44,0.28)] transition-transform hover:scale-105 hover:shadow-[0_15px_40px_rgba(232,181,44,0.35)]">
        สมัครสมาชิก OSIRIS168
      </a>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
