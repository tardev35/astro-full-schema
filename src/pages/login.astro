---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import CtaRedirect from "../components/CtaRedirect.astro";
import { pageGraph } from "../lib/schema";

const pageDescription =
  "หน้าเข้าสู่ระบบ ANKERSPIN เว็บหลัก มีปุ่มเดียวสำหรับกดไปยังหน้าล็อกอินด้วยบัญชีเดิม เพื่อเข้าเล่นสล็อต คาสิโนสด กีฬา เช็กเครดิต และดูประวัติฝากถอนผ่านมือถือ";

const graph = pageGraph(Astro, {
  name: "เข้าสู่ระบบ ANKERSPIN เว็บหลัก",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เข้าสู่ระบบ", path: "/login" },
  ],
});

const targetUrl = "https://yoalink.com/22hs";
---

<MainLayout title="เข้าสู่ระบบ ANKERSPIN | ปุ่มล็อกอินเว็บหลัก สล็อตและคาสิโนสด" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="เข้าสู่ระบบ ANKERSPIN" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label="เข้าระบบเกม"
        class="group relative mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#ff2d8f]/60 bg-[#1f0611] px-6 py-4 text-xl font-bold tracking-wide text-[#ffa6d5] shadow-[0_10px_30px_rgba(164,18,107,0.35)] transition-all duration-300 hover:scale-105 hover:border-[#a4126b] hover:bg-[#2c0a1a] hover:text-[#ff6bb5] hover:shadow-[0_15px_40px_rgba(255,45,143,0.30)]">
        เข้าระบบเกม
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="เข้าสู่ระบบ" />
</MainLayout>
