---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";

import { Picture } from "astro:assets";
import imgLine from "../assets/contact-line.webp";
import { pageGraph } from "../lib/schema";
import { BRAND_ADDRESS } from "../lib/brandProfile";

const pageTitle = "ติดต่อทีมงาน WINDRAGON | สอบถามผ่าน LINE Official";

const pageDescription =
  "ติดต่อทีมงาน WINDRAGON ผ่าน LINE Official สอบถามเรื่องสมัครสมาชิก เข้าสู่ระบบ ฝากถอนออโต้ หรือเครดิตที่ยังไม่ขึ้น พร้อมที่อยู่และอีเมลติดต่อของเว็บไซต์ครบ";

const graph = pageGraph(Astro, {
  type: "ContactPage",
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ติดต่อเรา", path: "/contact-us" },
  ],
  org: {
    alternateName: "WINDRAGON สล็อตออนไลน์ ค่ายเด่นแตกโหด ฝากถอนออโต้",
    contactPoints: [
      {
        contactType: "customer service",
        availableLanguage: ["Thai", "English"],
        path: "/line",
        description: "ติดต่อทีมงาน WINDRAGON ผ่าน LINE Official สอบถามการสมัครสมาชิก การเข้าสู่ระบบ และการฝากถอนออโต้",
      },
    ],
  },
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="ติดต่อทีมงาน WINDRAGON" as="h1">
    <div>
      <Picture
        src={imgLine}
        alt="ภาพช่องทางติดต่อทีมงาน WINDRAGON ทาง LINE ไอคอนแอป LINE สีเขียวทรงสี่เหลี่ยมมุมมน มีกรอบข้อความสีครีมที่เขียนคำว่า LINE อยู่ตรงกลาง ด้านบนเป็นวงกลมลูกศรสีเขียวล้อมตัวเลข 24h และมีผู้หญิงผมดำรวบตึง สวมชุดราตรีซาตินสีเขียวเข้มเปิดไหล่ ใส่สร้อยคอสีทอง ยืนอยู่ทางขวาของภาพ"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600]}
        sizes="(max-width: 768px) 100vw, 400px"
        class="mx-auto h-auto w-full max-w-[400px] object-contain"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={60}
      />
      {
        BRAND_ADDRESS.lines.length > 0 && (
          <address aria-label={BRAND_ADDRESS.label} class="mt-8 mb-8 rounded-r-xl border-l-4 border-[#f26b1d] bg-[#26150e] py-4 pr-4 pl-6 text-left text-base leading-relaxed not-italic">
            <span class="mb-1 block font-bold text-[#ff9a4d]">{BRAND_ADDRESS.label}</span>
            {BRAND_ADDRESS.lines.map((line) => (
              <span class="block">{line}</span>
            ))}
            {BRAND_ADDRESS.email && (
              <span class="mt-3 block">
                <span aria-hidden="true" class="mr-2">
                  ✉️
                </span>
                <a href={`mailto:${BRAND_ADDRESS.email}`} class="font-bold text-[#ffd77a] underline underline-offset-4 transition-colors hover:text-[#fff3d6]">
                  {BRAND_ADDRESS.email}
                </a>
              </span>
            )}
          </address>
        )
      }

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/register/"
          aria-label="สมัครสมาชิก WINDRAGON"
          class="flex items-center justify-center rounded-xl bg-gradient-to-r from-[#ff8a2a] to-[#e2550a] px-8 py-3 font-bold text-[#1a0701] shadow-[0_10px_30px_rgba(242,107,29,0.35)] transition-all hover:scale-105 hover:brightness-110 hover:shadow-[0_15px_40px_rgba(242,107,29,0.5)]">
          สมัครสมาชิก
        </a>

        <a
          href="/login/"
          aria-label="เข้าสู่ระบบ WINDRAGON"
          class="flex items-center justify-center rounded-xl border border-[#f26b1d]/70 bg-[#26150e] px-8 py-3 font-extrabold text-[#f2e7de] shadow-[0_4px_14px_rgba(242,107,29,0.22)] transition-all hover:scale-105 hover:bg-[#3a1d10]">
          เข้าสู่ระบบ
        </a>

        <a
          href="/line/"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="ติดต่อทีมงาน WINDRAGON ผ่าน Line Official"
          class="flex items-center justify-center rounded-xl border border-[#00B900]/70 bg-[#00B900] px-8 py-3 font-bold text-white shadow-[0_8px_24px_rgba(0,185,0,0.35)] transition-transform hover:scale-105 hover:bg-[#00a300]">
          ติดต่อผ่าน Line Official
        </a>
      </div>
    </div>
  </ContentBox>
  <Navfoot />
</MainLayout>
