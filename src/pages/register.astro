---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import CtaRedirect from "../components/CtaRedirect.astro";
import { pageGraph } from "../lib/schema";

const pageTitle = "สมัครสมาชิก MEEHAY569 | สมัครง่าย 4 ขั้นตอน ฝากถอนทรูวอเลท เริ่ม 1 บาท";

const pageDescription =
  "หากคุณกำลังมองหาสล็อตเว็บตรงที่สมัครง่าย MEEHAY569 พร้อมเปิดยูสใหม่ใน 4 ขั้นตอนด้วยเบอร์โทรที่รับ OTP ได้ ไม่ต้องมีบัญชีธนาคาร เพื่อเริ่มฝากทรูวอเลทจาก 1 บาท";

const announcementMessage =
  "MEEHAY569 สล็อตเว็บตรง ไม่ผ่านเอเย่นต์ • ฝากถอนทรูวอเลทออโต้ เริ่ม 1 บาท ตลอด 24 ชั่วโมง ไม่ต้องส่งสลิป • ทดลองเล่นสล็อตได้โดยไม่ต้องฝากเงินหรือสมัครก่อน • สมัครง่าย 4 ขั้นตอน เล่นได้ทั้งเว็บมือถือ แอป และคอม";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "สมัครสมาชิก", path: "/register" },
  ],
});

const targetUrl = "https://yoalink.com/22hs";
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement message={announcementMessage} />

  <ContentBox title="สมัครสมาชิก MEEHAY569" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label="สมัครสมาชิก MEEHAY569"
        class="group relative mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-full border-2 border-white bg-gradient-to-b from-[#ffd23f] via-[#ffb84d] to-[#f7941d] px-6 py-4 text-xl font-black tracking-wide text-[#4a1d00] shadow-[0_0_15px_rgba(247,148,29,0.40)] transition-all duration-300 hover:scale-105 hover:brightness-105 hover:shadow-[0_15px_40px_rgba(247,148,29,0.40)]">
        สมัครสมาชิก MEEHAY569
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="สมัครสมาชิก" />
</MainLayout>
