---
import { Picture } from "astro:assets";

import slide1 from "../assets/slide1.png";
import slide3 from "../assets/slide3.png";

const images = [
  {
    src: slide1,
    alt: "ภาพโปรโมชั่น TEMMAX69 พื้นหลังสีม่วงนีออนมีเหรียญทองลอยอยู่ ด้านบนซ้ายเป็นโลโก้มงกุฎพร้อมตัวอักษรว่า TEMMAX69 และข้อความว่า สล็อต คาสิโน ครบจบในที่เดียว ตรงกลางเป็นตัวอักษรขนาดใหญ่ว่า สมัครวันนี้ รับโบนัสฝากแรก 10% ใต้ลงมาเขียนว่า เล่นง่าย ฝากไว คุ้มตั้งแต่บาทแรก ด้านซ้ายมีตู้สล็อตคำว่า JACKPOT และเลข 777 พร้อมมาสคอตปลาฉลามและเพนกวินการ์ตูน ด้านขวาเป็นพรีเซนเตอร์หญิงสวมชุดเลื่อมสีม่วงถือไพ่ A กับ K แถบล่างเป็นไอคอนสามช่องเขียนว่า ระบบออโต้ ฝาก-ถอน อัตโนมัติ, รองรับมือถือ เล่นได้ทุกที่ ทุกเวลา และ เล่นได้ 24 ชม. ไม่มีวันหยุด ปิดท้ายด้วยแถบเขียนว่า มั่นคง ปลอดภัย 100% ระบบมาตรฐานสากล คู่กับปุ่มสีม่วงเขียนว่า คลิก",
  },
  {
    src: slide3,
    alt: "ภาพโปรโมชั่น TEMMAX69 พื้นหลังสีม่วงนีออนมีเหรียญทอง ไพ่ ลูกเต๋า และชิปคาสิโนลอยอยู่ ด้านบนซ้ายเป็นโลโก้ลูกเต๋าและไพ่พร้อมตัวอักษรว่า TEMMAX69 ตรงกลางเป็นตัวอักษรขนาดใหญ่ว่า เว็บสล็อต มาใหม่ ถัดลงมาเขียนว่า สมัครรับโบนัสง่าย คุ้มตั้งแต่บาทแรก ใต้ลงมาเป็นแถบเขียนว่า ระบบใหม่ เกมใหม่ เล่นง่ายกว่าเดิม ตามด้วยป้ายสามช่องเขียนว่า รวดเร็ว, ปลอดภัย และ รองรับวอลเล็ต แถบล่างสุดเขียนว่า เล่นได้ 24 ชม. ฝากถอนออโต้ และ สมัครง่าย ด้านขวาเป็นพรีเซนเตอร์หญิงสวมชุดซาตินสีม่วง",
  },
];

const COPIES = 3;
const slides = Array.from({ length: COPIES }, () => images).flat();
---

<div class="marquee mx-auto w-full max-w-7xl overflow-hidden px-4 py-5">
  <input id="carousel-pause" type="checkbox" class="peer sr-only" />
  <label
    for="carousel-pause"
    class="sr-only cursor-pointer peer-focus-visible:not-sr-only peer-focus-visible:mb-3 peer-focus-visible:inline-block peer-focus-visible:rounded-full peer-focus-visible:border peer-focus-visible:border-[#22d3ee]/60 peer-focus-visible:px-4 peer-focus-visible:py-2 peer-focus-visible:text-sm peer-focus-visible:font-bold peer-focus-visible:text-[#67e8f9]">
    หยุด / เล่นสไลด์ภาพ
  </label>

  <div class="marquee-track flex">
    {
      slides.map((slide, index) => {
        const isDuplicate = index >= images.length;
        return (
          <div class="marquee-slide" aria-hidden={isDuplicate ? "true" : undefined}>
            <Picture
              src={slide.src}
              alt={isDuplicate ? "" : slide.alt}
              class="block w-full rounded-xl border border-[#22d3ee]/40 object-cover shadow-[0_10px_30px_rgba(168,85,247,0.30)]"
              width={slide.src.width}
              height={slide.src.height}
              loading="lazy"
              fetchpriority="low"
              decoding="async"
              widths={[300, 360, 420, 480, 540, 600]}
              sizes="(max-width: 767px) calc(100vw - 32px), (max-width: 1279px) calc((100vw - 48px) / 2), 403px"
              formats={["avif", "webp"]}
              fallbackFormat="webp"
              quality={60}
            />
          </div>
        );
      })
    }
  </div>
</div>

<style>
  .marquee {
    --gap: 12px;
    --per-view: 1;
    --shift: calc(-200% - 24px);
  }

  @media (min-width: 768px) {
    .marquee {
      --gap: 16px;
      --per-view: 2;
      --shift: calc(-100% - 16px);
    }
  }

  @media (min-width: 1280px) {
    .marquee {
      --gap: 20px;
      --per-view: 3;
      --shift: calc(-66.6667% - 13.3333px);
    }
  }

  .marquee-track {
    gap: var(--gap);
    width: 100%;
    animation: carousel-scroll 24s linear infinite;
    will-change: transform;
  }

  .marquee-slide {
    flex: 0 0 calc((100% - (var(--per-view) - 1) * var(--gap)) / var(--per-view));
  }

  @keyframes carousel-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(var(--shift));
    }
  }

  .marquee:hover .marquee-track,
  .marquee:focus-within .marquee-track,
  .marquee > input:checked ~ .marquee-track {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
    }
  }
</style>
