---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/AnnouncementPremium.astro";
import ContentBoxPremium from "../components/ContentBoxPremium.astro";
import ContentBoxCyberCut from "../components/ContentBoxCyberCut.astro";
import ContentBoxSpecial from "../components/ContentBoxSpecial.astro";
import ContentBoxTwoPremium from "../components/ContentBoxTwoPremium.astro";
import ContentBoxTwoCyberCut from "../components/ContentBoxTwoCyberCut.astro";
import ContentBoxSevenThreePremium from "../components/ContentBoxSevenThreePremium.astro";
import ContentBoxSevenThreeCyberCut from "../components/ContentBoxSevenThreeCyberCut.astro";
import GameRankingBoard from "../components/GameRankingBoard.astro";
import FeatureHighlights from "../components/FeatureHighlights.astro";
import SmoothCarousel from "../components/SmoothCarousel.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import LatestWinnersCyber from "../components/LatestWinnersCyber.astro";
import ProviderGrid from "../components/ProviderGrid.astro";
import ReviewCardSumo2 from "../components/ReviewCardSumo2.astro";
import Faq2 from "../components/Faq2.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import imgNoMinimum from "../assets/slide2.png";
import imgWallet from "../assets/slide1.png";

const pageTitle = "PIGAUTO เว็บสล็อตออโต้ไม่มีขั้นต่ำ อันดับ1 ฝากถอนตรง รองรับวอเล็ท";

const pageDescription = "PIGAUTO เว็บสล็อตออโต้ไม่มีขั้นต่ำ อันดับ 1 ลิขสิทธิ์แท้ ระบบเร็ว ฝากถอนตรง เฉียมคม รองรับวอเล็ท ปลอดภัยสูง สมัครเข้าระบบในไม่กี่วินาที";

const announcement =
  "PIGAUTO เว็บสล็อตออโต้ไม่มีขั้นต่ำ อันดับ 1 ใช้เทคโนโลยีออโต้ตัวเดียวกับที่คาสิโนระดับอินเตอร์ใช้ ทำงานเรียลไทม์ตั้งแต่สมัครจนเข้าเล่นเกม • ฝากถอนตรง เฉียมคม ฝากปุ๊บเข้าปั๊บ ถอนปุ๊บยอดขึ้นปั๊บ ไม่มีคนกลาง ไม่มีพักระบบ • ไม่มีขั้นต่ำจริง อยากฝากเท่าไหร่ก็ฝากได้ อยากถอนเท่าไหร่ก็ถอนได้ ไม่ต้องกลัวว่าระบบจะบังคับยอด • รองรับ True Wallet เต็มระบบ สมัครได้โดยไม่ต้องผูกบัญชีธนาคาร ระบบ pig auto wallet โอนไวเท่าธนาคาร • รวมเกมลิขสิทธิ์แท้จาก PG Soft, Joker, Pragmatic Play และ JILI ทุกเกมทำงานตามค่า RTP จริง ไม่มีปรับเรท • สมัครเข้าระบบในไม่กี่วินาที ไม่ต้องคุยกับแอดมิน ไม่ต้องส่งบัตร กดครั้งเดียวก็เข้าใช้งานได้เลย • ทุกขั้นตอนมีระบบชัดเจน โปร่งใส ตรวจสอบได้ และรองรับผู้เล่นพร้อมกันได้เยอะ";

const noMinimumAlt =
  "ภาพโปรโมชั่น PIGAUTO โทนแดงเข้มลายตรุษจีน ด้านบนเป็นโลโก้หมูการ์ตูนสีชมพูในวงเฟืองสีเงินกับคำว่า PIGAUTO ฉากหลังมีโคมไฟจีนสีแดง พัดกระดาษสีทอง ไพ่ ชิปคาสิโน และเหรียญทองปลิว ด้านขวาเป็นพรีเซนเตอร์หญิงสวมชุดกี่เพ้าสีแดงปักลายมังกรทอง ข้อความตัวใหญ่ว่า เว็บสล็อตออโต้ไม่มีขั้นต่ำ และบรรทัดล่างว่า เล่นได้อย่างเป็นมิตร ปลอดภัยสูง";

const walletAlt =
  "ภาพโปรโมชั่น PIGAUTO โทนแดงเข้มลายตรุษจีน ด้านบนเป็นโลโก้หมูการ์ตูนสีชมพูในวงเฟืองสีเงินกับคำว่า PIGAUTO ฉากหลังมีโคมไฟจีนสีแดง พัดกระดาษสีทอง ไพ่โพดำโพแดง ชิปคาสิโน และเหรียญทองปลิว ด้านซ้ายเป็นพรีเซนเตอร์หญิงสวมชุดกี่เพ้าสีแดงปักลายทอง ข้อความตัวใหญ่ว่า รองรับวอเล็ท เต็มระบบ และบรรทัดล่างว่า pig auto wallet ใช้ง่าย";

const trustPoints = [
  {
    icon: "🌐",
    title: "เทคโนโลยีออโต้ระดับอินเตอร์",
    description: "PIGAUTO อาจเป็นแบรนด์ใหม่ แต่หัวใจของระบบไม่ใช่มือใหม่ เพราะใช้เทคโนโลยีออโต้ตัวเดียวกับที่คาสิโนระดับอินเตอร์ใช้กันอยู่",
    accent: "gold" as const,
  },
  {
    icon: "⚡",
    title: "เรียลไทม์ ไม่สะดุด",
    description: "ตั้งแต่สมัคร ฝาก ถอน ไปจนถึงการเข้าเล่นเกม ทำได้แบบเรียลไทม์ ลดขั้นตอนที่ไม่เป็นมิตรต่อสมาชิก และไม่ต้องคอยตามแอดมิน",
    accent: "blue" as const,
  },
  {
    icon: "🔎",
    title: "โปร่งใส ตรวจสอบได้",
    description: "ทุกขั้นตอนมีระบบชัดเจน สมาชิกดูสถานะรายการของตัวเองได้เอง ไม่มีอะไรซ่อนไว้หลังบ้านให้ต้องเดา",
    accent: "gold" as const,
  },
  {
    icon: "👥",
    title: "รองรับผู้เล่นพร้อมกันได้เยอะ",
    description: "ระบบรองรับจำนวนผู้เล่นพร้อมกันได้เยอะมาก ช่วงคนเข้าหนาแน่นก็ยังทำรายการและเข้าเกมได้ตามปกติ",
    accent: "blue" as const,
  },
];

const faqs = [
  {
    q: "ฝากเงินกับ PIGAUTO มีขั้นต่ำไหม?",
    a: "ไม่มีขั้นต่ำ ฝากเท่าไหร่ก็ได้ คุณสามารถเริ่มลองเล่นด้วยยอดเล็ก ๆ ก่อนเพื่อเช็กระบบ หรือจะฝากหนักตั้งแต่ต้นก็ทำได้ตามสะดวก",
  },
  {
    q: "ถอนเงินจาก PIGAUTO ใช้เวลานานแค่ไหน?",
    a: "ระบบถอนเป็นออโต้เต็มระบบ เมื่อคุณยืนยันการถอน ยอดจะถูกส่งเข้าธนาคารหรือวอเล็ทที่ผูกไว้ภายในเวลาสั้น ๆ หากข้อมูลถูกต้องตามระบบ",
  },
  {
    q: "PIGAUTO รองรับการฝากถอนผ่าน True Wallet หรือไม่?",
    a: "รองรับเต็มระบบ คุณสามารถใช้ True Wallet ในการฝากและถอนผ่านเมนูฝากถอนของ PIGAUTO ได้ทันที โดยไม่ต้องผูกบัญชีธนาคารก็ใช้งานได้",
  },
  {
    q: "ต้องส่งสลิปให้แอดมินทุกครั้งที่ฝากเงินไหม?",
    a: "ไม่จำเป็น ระบบฝากของ PIGAUTO เป็นออโต้ ตรวจจับยอดและปรับเครดิตให้อัตโนมัติ หากโอนตามยอดและช่องทางที่ระบบแสดงไว้",
  },
  {
    q: "ถอนยอดเล็ก ๆ ได้ไหม หรือบังคับให้ถอนยอดสูงเท่านั้น?",
    a: "ถอนยอดเล็ก–ใหญ่ได้ทั้งหมด ตามยอดคงเหลือที่ระบบอนุญาต ไม่มีบังคับให้ต้องถอนยอดสูงอย่างเดียว",
  },
  {
    q: "ถ้าระบบล่มหรือเน็ตหลุดระหว่างทำรายการฝาก–ถอน ทำอย่างไร?",
    a: "โดยปกติระบบจะบันทึกสถานะการทำรายการไว้ หากเน็ตหลุดหรือล็อกเอาต์กลางคัน เมื่อกลับมาเข้าสู่ระบบอีกครั้งให้ตรวจสอบยอดในกระเป๋า หากยังไม่อัปเดตสามารถติดต่อทีมงานเพื่อช่วยตรวจสอบได้",
  },
];

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement message={announcement} />

  <ContentBoxPremium as="h1" title="PIGAUTO เว็บสล็อตออโต้ไม่มีขั้นต่ำ อันดับ 1">
    <p class="mb-4 text-left text-base leading-relaxed">
      <strong class="text-[#ffe9a8]">PIGAUTO</strong> ขอต้อนรับเข้าสู่เว็บสล็อตออโต้ที่ตั้งใจเปิดตัว เพื่อให้ผู้เล่นสัมผัส “ความลื่น + ความเร็ว + ความจริงใจ” แบบที่หาได้ยากในวงการเว็บสล็อตออนไลน์ตอนนี้
      ในฐานะเจ้าของเว็บ เราตั้งใจสร้าง PIGAUTO ให้เป็นพื้นที่ที่ทุกคนเข้ามาแล้วสบายใจ ฝั่งระบบก็ไฮเทคเต็มร้อย ฝั่งบริการก็เป็นกันเองไม่ยัดเยียดเหมือนเว็บเก่า ๆ ที่คุณเคยเจอ
    </p>

    <p class="text-left text-base leading-relaxed">
      เพราะผมรู้ดีว่าผู้เล่นทุกคนต้องการเว็บที่เชื่อถือได้ ปลอดภัย โปร่งใส ไม่ซ่อนไม้ซ่อนมือ และที่สำคัญ ฝาก–ถอนต้องเร็ว แม่นยำ เฉียบคม แบบไม่ต้องทักตามยอดเงินจากแอดมิน
    </p>
  </ContentBoxPremium>

  <ContentBoxTwoCyberCut as="h2" title="ทำไม PIGAUTO ถึงเป็นเว็บออโต้ อันดับ1 ที่มั่นใจว่าผู้เล่นจะไว้ใจ ใช้บริการ">
    <div slot="left" class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed">
        PIGAUTO อาจเป็นแบรนด์ใหม่ แต่หัวใจของระบบไม่ใช่มือใหม่เลย เราใช้เทคโนโลยีออโต้ตัวเดียวกับที่คาสิโนระดับอินเตอร์ใช้ ทำให้ทุกอย่างตั้งแต่สมัคร ฝาก ถอน ไปจนถึงการเข้าเล่นเกม ทำได้แบบเรียลไทม์
        ไม่มีสะดุด
      </p>
      <p class="text-left text-base leading-relaxed">
        ลดขั้นตอนที่ไม่เป็นมิตรต่อสมาชิกผู้ใช้บริการ และไม่ต้องคอยตามแอดมิน แต่ทุกขั้นตอนมีระบบชัดเจน โปร่งใส ตรวจสอบได้ และรองรับจำนวนผู้เล่นพร้อมกันได้เยอะมาก
      </p>
    </div>

    <FeatureHighlights slot="right" items={trustPoints} />
  </ContentBoxTwoCyberCut>

  <ContentBoxCyberCut as="h2" title="PIGAUTO สล็อตออโต้ที่เร็วแรงที่สุด ฝากถอนตรง เฉียมคม">
    <p class="mb-4 text-left text-base leading-relaxed">
      จุดเด่นแรกของ PIGAUTO คือ “ความเร็วของระบบออโต้” ฝากถอนตรง เฉียมคม ที่ใครเล่นก็ต้องบอกต่อ เพราะฝากปุ๊บเข้าปั๊บ ถอนปุ๊บยอดขึ้นปั๊บทันที ไม่มีคนกลาง ไม่มีพักระบบ และไม่มีช่วงเวลาอืดให้ผู้เล่นกังวล
      ระบบนี้สร้างมาเพื่อให้คุณเล่นได้ต่อเนื่อง ไม่ติดขัด ไม่สะดุด ไม่ต้องรีเฟรชให้เสียเวลา
    </p>

    <p class="text-left text-base leading-relaxed">
      ความเร็วคือคาแรกเตอร์หลักของ PIGAUTO ใครที่เคยช้ำใจกับเว็บที่ปรับยอดช้า ลองที่นี่แล้วจะรู้ทันทีว่านี่คือเว็บที่ “เกิดมาเพื่อเป็นเว็บสล็อตออโต้ อันดับ 1 จริง ๆ”
    </p>
  </ContentBoxCyberCut>

  <LatestWinnersCyber />

  <ContentBoxSevenThreePremium as="h2" title="เว็บสล็อตออโต้ไม่มีขั้นต่ำ เล่นได้อย่างเป็นมิตร ปลอดภัยสูง">
    <Picture
      slot="left"
      src={imgNoMinimum}
      alt={noMinimumAlt}
      loading="lazy"
      fetchpriority="low"
      widths={[240, 400, 600]}
      sizes="(max-width: 767px) calc(100vw - 64px), 380px"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      class="mx-auto h-auto w-full rounded-2xl border border-[#7f1d1d] shadow-[0_10px_30px_rgba(239,68,68,0.24)]"
    />

    <div slot="right" class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed">
        หลายเว็บบอกว่าไม่มีขั้นต่ำ แต่เวลาเล่นจริงมีเงื่อนไขมากมาย แต่ที่ PIGAUTO เราตั้งกฎแบบตรงไปตรงมา ไม่มีขั้นต่ำจริง อยากฝากเท่าไหร่ก็ฝากได้ อยากถอนเท่าไหร่ก็ถอนได้ ไม่ต้องกลัวว่าระบบจะบังคับยอด
      </p>
      <p class="text-left text-base leading-relaxed">
        แนวคิดของเราคือ “ผู้เล่นทุกคนต้องมีสิทธิ์เริ่มต้นเท่ากัน” และถ้าคุณอยากลองเชิงก่อนก็ได้ ไม่ต้องอาย เพราะเว็บนี้ออกแบบเพื่อรองรับทุกงบ ทุกสไตล์การเล่น ปลอดภัยสูง กับทุกคน
      </p>
    </div>
  </ContentBoxSevenThreePremium>

  <ContentBoxSevenThreeCyberCut as="h2" titleright="รองรับวอเล็ท เต็มระบบ pig auto wallet ใช้ง่าย โอนไว ถูกใจผู้เล่นไทย">
    <Picture
      slot="left"
      src={imgWallet}
      alt={walletAlt}
      loading="lazy"
      fetchpriority="low"
      widths={[240, 400, 600]}
      sizes="(max-width: 767px) calc(100vw - 64px), 380px"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      class="mx-auto h-auto w-full rounded-2xl border border-[#7f1d1d] shadow-[0_10px_30px_rgba(239,68,68,0.24)]"
    />

    <div slot="right" class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed">
        PIGAUTO รองรับ True Wallet เต็มระบบ แบบไม่ต้องใช้บัญชีธนาคารก็สมัครได้ เหมาะกับผู้เล่นยุคใหม่ที่ต้องการความสะดวก ปลอดภัย และไม่อยากผูกบัญชีไว้กับเว็บพนัน
      </p>
      <p class="text-left text-base leading-relaxed">
        การทำรายการผ่านวอเล็ทเร็วเท่าธนาคาร ไม่มีดีเลย์ เงินเข้าไวเหมือนกันทั้งสองแบบ ระบบ pig auto wallet ช่วยให้ผู้เล่นมีทางเลือกมากขึ้น และได้รับประสบการณ์ใช้งานที่ง่ายที่สุดเท่าที่จะเป็นไปได้
      </p>
    </div>
  </ContentBoxSevenThreeCyberCut>

  <ContentBoxSpecial as="h2" title="รวมเกมแตกง่ายจากค่ายใหญ่ pigauto slot ลิขสิทธิ์แท้">
    <div slot="left" class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed">
        ถึงแม้ว่า PIGAUTO จะเป็นแบรนด์ใหม่ แต่ผมคัดเฉพาะเกมลิขสิทธิ์แท้จากผู้พัฒนาโดยตรง เช่น PG Soft, Joker, Pragmatic Play, JILI และค่ายใหญ่ระดับอินเตอร์
      </p>
      <p class="text-left text-base leading-relaxed">ทุกเกมทำงานตามค่า RTP จริง ไม่มีปรับแต้ม ไม่มีปรับเรท ไม่มีเซตยูสลับหลังบ้าน</p>
    </div>

    <div slot="right" class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed">จะเข้าเล่นเวลาไหนก็ยังลื่นไหล มี bonus time แทบทุกช่วงเวลา</p>
      <p class="text-left text-base leading-relaxed">เหมาะกับทั้งมือใหม่และสายเล่นแบบจริงจัง กะฟันเงินเน้นที่ต้องการระบบมั่นคง</p>
    </div>
  </ContentBoxSpecial>

  <ProviderGrid />

  <GameRankingBoard />

  <ContentBoxTwoPremium as="h2" title="PIGAUTO สมัครเข้าระบบในไม่กี่วินาที ง่ายเหมือนเปิดมือถือ">
    <p slot="left" class="text-left text-base leading-relaxed">
