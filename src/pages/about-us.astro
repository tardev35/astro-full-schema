---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import { pageGraph } from "../lib/schema";

const pageTitle = "เกี่ยวกับเรา ANDAMAN168 เว็บรวมบาคาร่า สล็อต ฟุตบอล และคาสิโนไว้ในบัญชีเดียว";

const pageDescription =
  "เกี่ยวกับเรา ANDAMAN168 เว็บที่รวมบาคาร่า สล็อต ฟุตบอล และคาสิโนไว้ในบัญชีเดียว รู้จักการจัดหมวดเกม ระบบออโต้ฝากถอน 24 ชม. และหน้าสมาชิกที่ใช้งานง่ายบนมือถือ";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox as="h1" title={pageTitle}>
    <p class="mb-4 text-left text-base leading-relaxed text-[#dbeefb]">
      <strong class="text-[#fdb524]">ANDAMAN168</strong> เป็นเว็บที่รวมบาคาร่า สล็อต ฟุตบอล และคาสิโนไว้ในบัญชีสมาชิกเดียว เปิดเข้ามาแล้วเลือกหมวดที่ต้องการได้จากเมนูเดิม
      อยากหมุนสล็อต ต่อบาคาร่า หรือเปลี่ยนไปดูฟุตบอลก็สลับได้โดยไม่ต้องเปิดหลายหน้าให้รกจอ สิ่งที่เราให้ความสำคัญคือหน้าเว็บที่รองรับมือถือ ระบบออโต้สำหรับฝากถอนและเช็กยอดตลอด 24 ชั่วโมง
      และหน้าสมาชิกที่รวมเครดิต โปรโมชั่น และประวัติรายการไว้ครบในที่เดียว
    </p>

    <p class="text-left text-base leading-relaxed text-[#dbeefb]">
      หน้านี้ทำหน้าที่เป็นหน้าข้อมูลและแนะนำตัว อธิบายว่าเว็บนี้ให้บริการอะไร จัดหน้าเว็บอย่างไร และเหมาะกับผู้ใช้แบบไหน เพื่อให้อ่านแล้วนำไปเทียบกับสิ่งที่เห็นในหน้าสมาชิกจริงได้
      ส่วนรายละเอียดของโปรโมชั่นและเงื่อนไขแต่ละรายการจะอยู่ในหน้ารายการของโปรนั้นโดยตรง จึงควรเปิดดูก่อนใช้สิทธิ์ทุกครั้ง
    </p>
  </ContentBox>

  <ContentBox as="h2" title="วิธีที่ ANDAMAN168 จัดหมวดเกมให้เลือกได้จากเมนูเดียว">
    <p class="mb-4 text-left text-base leading-relaxed text-[#dbeefb]">
      เมนูของเราแบ่งบริการหลักเป็นบาคาร่า สล็อต ฟุตบอล และคาสิโน แต่ละหมวดถูกแยกให้เห็นชัดตั้งแต่หน้าแรก สมาชิกจึงเข้าเกมที่ต้องการได้โดยไม่ต้องไล่เปิดเมนูทีละชั้น
      หมวดสล็อตมีพื้นที่สำหรับเกมใหม่ปี 2026 และเกมหลายสไตล์ ส่วนบาคาร่ากับคาสิโนเน้นการเลือกโต๊ะและรูปแบบเกมที่ต้องการ
      ด้านฟุตบอลแยกไว้ให้เลือกรายการและตลาดที่เปิดให้เล่นได้จากบัญชีเดียวกับเกมคาสิโน
    </p>

    <p class="text-left text-base leading-relaxed text-[#dbeefb]">
      การแยกหมวดแบบนี้ทำให้คนที่มีเกมประจำหาเจอเร็ว ส่วนคนที่ชอบลองของใหม่ก็เลือกต่อได้ง่าย ช่วงหนึ่งเล่นสล็อต อีกช่วงเปลี่ยนไปดูฟุตบอล หรืออยากต่อคาสิโนก็เลือกจากหน้าเดิมได้
      ความชอบเปลี่ยนได้ทุกชั่วโมง แต่หน้าเว็บไม่จำเป็นต้องเปลี่ยนตามจนคนใช้ตามไม่ทัน
    </p>
  </ContentBox>

  <ContentBox as="h2" title="ระบบออโต้และหน้าสมาชิกที่ ANDAMAN168 รวมไว้จุดเดียว">
    <p class="mb-4 text-left text-base leading-relaxed text-[#dbeefb]">
      ANDAMAN168 ใช้ระบบออโต้จัดการฝากถอนและเครดิต สมาชิกทำรายการและดูยอดของตัวเองได้จากหน้าสมาชิกตลอด 24 ชั่วโมง ขั้นตอนก่อนเข้าเกมจึงไม่ถูกแยกออกเป็นหลายส่วน
      ทำรายการเสร็จแล้วกลับไปเลือกเกมต่อได้ทันที ไม่ว่าจะเข้าใช้งานช่วงกลางวันหรือดึก
    </p>

    <p class="text-left text-base leading-relaxed text-[#dbeefb]">
      เมื่อเครดิต โปรโมชั่น และประวัติรายการอยู่ในพื้นที่เดียวกัน การย้อนดูรายการของตัวเองก็ไม่ต้องไล่เปิดหลายเมนูเพื่อหาข้อมูลชิ้นเดียว ตั้งค่าบัญชีครั้งเดียวแล้วใช้ต่อได้ทุกหมวด
      เพราะเวลาที่ควรลุ้นคือตอนอยู่ในเกม ไม่ใช่นั่งลุ้นว่าปุ่มฝากอยู่ตรงไหน
    </p>
  </ContentBox>

  <ContentBox as="h2" title="ทางเข้า ANDAMAN168 กับการใช้งานบนอุปกรณ์ที่สมาชิกถนัด">
    <p class="mb-4 text-left text-base leading-relaxed text-[#dbeefb]">
      ทางเข้าของเรารองรับโทรศัพท์ แท็บเล็ต และคอมพิวเตอร์ สมาชิกเข้าสู่ระบบผ่านเบราว์เซอร์แล้วเลือกเกม ดูโปรโมชั่น หรือจัดการเครดิตได้ตามอุปกรณ์ที่ใช้อยู่ในขณะนั้น
      หน้าเว็บบนมือถือเน้นเมนูหลักที่กดง่ายและไม่อัดข้อมูลจนแน่นเกินจอ จอเล็กพอแล้ว ปุ่มไม่ควรเล็กตามจนต้องใช้สมาธิระดับผ่าตัด
    </p>

    <p class="text-left text-base leading-relaxed text-[#dbeefb]">
      การใช้บัญชีเดิมบนหลายอุปกรณ์ช่วยให้เปลี่ยนหน้าจอได้ตามสถานการณ์ อยู่บ้านใช้คอม ออกข้างนอกใช้มือถือ เมนูและข้อมูลสมาชิกยังอยู่ในระบบเดียวกัน
      หน้าเว็บจึงเปลี่ยนตามขนาดจอได้ แต่ข้อมูลไม่ควรเล่นมุกหายตัวตามไปด้วย และไม่ควรส่งรหัสผ่านหรือรหัส OTP ให้บุคคลอื่นไม่ว่ากรณีใด
    </p>
  </ContentBox>

  <ContentBox as="h2" title="ANDAMAN168 เหมาะกับผู้ใช้แบบไหน">
    <p class="mb-4 text-left text-base leading-relaxed text-[#dbeefb]">
      ANDAMAN168 เหมาะกับคนที่เล่นมากกว่าหนึ่งประเภท ทั้งบาคาร่า สล็อต ฟุตบอล และคาสิโน แต่ต้องการใช้งานทั้งหมดจากบัญชีเดียว
      รวมถึงคนที่ใช้มือถือเป็นหลักและอยากจัดการเครดิตกับโปรโมชั่นจากจุดเดียวได้ตลอดวัน ภาพรวมของเราจึงเน้นเกมครบ เลือกง่าย และใช้งานต่อเนื่อง
    </p>

    <p class="text-left text-base leading-relaxed text-[#dbeefb]">
      การสมัครเริ่มจากกรอกข้อมูลตามที่ระบบสมาชิกกำหนด ตั้งค่าบัญชี แล้วเข้าหน้าหลักเพื่อเลือกหมวดเกมได้จากเมนูเดียว ขั้นตอนถูกออกแบบให้ทำบนมือถือได้ จึงไม่ต้องรอเปิดคอมเพื่อเริ่มสมัคร
      ชีวิตออนไลน์มี OTP กับรหัสผ่านให้จำเยอะพอแล้ว ขั้นตอนสมัครไม่ควรเพิ่มข้อสอบอีกชุด ส่วนเงื่อนไขของโปรโมชั่นแต่ละรายการยังคงต้องอ่านจากหน้ารายการของโปรนั้นก่อนกดรับเสมอ
    </p>
  </ContentBox>

  <Navfoot />
</MainLayout>
