---
import { Picture } from "astro:assets";

import slide1 from "../assets/slide1.png";
import slide2 from "../assets/slide2.png";
import slide3 from "../assets/slide3.png";
import slide4 from "../assets/slide4.png";

const images = [
  {
    src: slide1,
    alt: "แบนเนอร์ YIMSIAM889 ข้อความสีทองขอบแดงว่า ธุรกรรมว่องไว และข้อความสีขาวว่า ระบบอัตโนมัติ มุมซ้ายบนเป็นโลโก้หน้าจั่ววัดไทยสีทองพร้อมคำว่า Yimsiam889 ด้านขวาเป็นพรีเซนเตอร์หญิงในชุดราตรีเลื่อมทองยกนิ้วชี้ขึ้น รอบตัวมีเหรียญทอง ชิปคาสิโนและไพ่ลอยอยู่บนพื้นหลังลาวาและเปลวไฟ",
  },
  {
    src: slide2,
    alt: "แบนเนอร์ YIMSIAM889 ข้อความสีทองขอบแดงว่า ทางเข้า YIMSIAM889 และข้อความสีขาวว่า รองรับทุกอุปกรณ์ ด้านบนกลางเป็นโลโก้หน้าจั่ววัดไทยสีทองพร้อมคำว่า Yimsiam889 ด้านซ้ายเป็นพรีเซนเตอร์หญิงในชุดราตรีเลื่อมทองถือไพ่คลี่เป็นพัด รอบตัวมีเหรียญทอง ชิปคาสิโนและไพ่ลอยอยู่บนพื้นหลังลาวาและเปลวไฟ",
  },
  {
    src: slide3,
    alt: "แบนเนอร์ YIMSIAM889 ข้อความสีทองขอบแดงว่า ยิ้มรับโปรสมาชิกใหม่ และข้อความสีขาวว่า คุ้มค่าตั้งแต่ก้าวแรก มุมซ้ายบนเป็นโลโก้หน้าจั่ววัดไทยสีทองพร้อมคำว่า Yimsiam889 ด้านซ้ายเป็นพรีเซนเตอร์หญิงในชุดราตรีเลื่อมทองแดงยืนยิ้ม รอบตัวมีเหรียญทอง ชิปคาสิโนและไพ่ลอยอยู่บนพื้นหลังลาวาและเปลวไฟ",
  },
  {
    src: slide4,
    alt: "แบนเนอร์ YIMSIAM889 ข้อความสีทองขอบแดงว่า เว็บตรงแตกดีจริง และข้อความสีขาวว่า มาตรฐานสากล มุมซ้ายบนเป็นโลโก้หน้าจั่ววัดไทยสีทองพร้อมคำว่า Yimsiam889 ด้านขวาเป็นพรีเซนเตอร์หญิงในชุดราตรีเลื่อมทองถือไพ่คลี่เป็นพัด รอบตัวมีเหรียญทอง ชิปคาสิโนและไพ่ลอยอยู่บนพื้นหลังลาวาและเปลวไฟ",
  },
];

const COPIES = 3;
const slides = Array.from({ length: COPIES }, () => images).flat();
---

<div class="marquee mx-auto w-full max-w-[1301px] overflow-hidden px-4 py-5">
  <input id="carousel-pause" type="checkbox" class="peer sr-only" />
  <label
    for="carousel-pause"
    class="sr-only cursor-pointer peer-focus-visible:not-sr-only peer-focus-visible:mb-3 peer-focus-visible:inline-block peer-focus-visible:rounded-full peer-focus-visible:border peer-focus-visible:border-[#e9b949]/60 peer-focus-visible:px-4 peer-focus-visible:py-2 peer-focus-visible:text-sm peer-focus-visible:font-bold peer-focus-visible:text-[#f8dc9a]">
    หยุด / เล่นสไลด์ภาพ
  </label>

  <div class="marquee-track flex">
    {
      slides.map((slide, index) => {
        const isDuplicate = index >= images.length;
        return (
          <div class="marquee-slide" aria-hidden={isDuplicate ? "true" : undefined}>
            <Picture
              src={slide.src}
              alt={isDuplicate ? "" : slide.alt}
              class="block w-full rounded-xl border border-[#e9b949]/25 object-cover shadow-[0_10px_30px_rgba(168,31,26,0.22)]"
              width={slide.src.width}
              height={slide.src.height}
              loading="lazy"
              fetchpriority="low"
              decoding="async"
              widths={[200, 400, 600]}
              sizes="(max-width: 768px) 50vw, 33vw"
              formats={["avif", "webp"]}
              fallbackFormat="webp"
              quality={60}
            />
          </div>
        );
      })
    }
  </div>
</div>

<style>
  .marquee {
    --gap: 12px;
    --per-view: 2;
    --shift: calc(-200% - 24px);
  }

  @media (min-width: 768px) {
    .marquee {
      --gap: 16px;
      --per-view: 3;
      --shift: calc(-133.3333% - 21.3333px);
    }
  }

  .marquee-track {
    gap: var(--gap);
    width: 100%;
    animation: carousel-scroll 32s linear infinite;
    will-change: transform;
  }

  .marquee-slide {
    flex: 0 0 calc((100% - (var(--per-view) - 1) * var(--gap)) / var(--per-view));
  }

  @keyframes carousel-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(var(--shift));
    }
  }

  .marquee:hover .marquee-track,
  .marquee:focus-within .marquee-track,
  .marquee > input:checked ~ .marquee-track {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
    }
  }
</style>
