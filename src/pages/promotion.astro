---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxCyberCut.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement6.astro";

import { Picture } from "astro:assets";

import pro1 from "../assets/slide1.png";
import pro2 from "../assets/slide2.png";
import pro3 from "../assets/slide3.png";
import pro4 from "../assets/slide4.png";
import { pageGraph } from "../lib/schema";

const pageTitle = "โปรโมชั่น NORWAY89 โบนัสสมาชิกใหม่ โปรฝากประจำวัน และคืนยอดเสีย";

const pageDescription =
  "รวมโปรโมชั่น NORWAY89 ทั้งโบนัสสมาชิกใหม่ โปรฝากประจำวัน และสิทธิ์คืนยอดเสีย ดูเงื่อนไขการรับสิทธิ์ เกมที่ร่วมรายการ และรอบเดิมพันก่อนกดใช้งานได้ในหน้าเดียว";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: pro1.src,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="โปรโมชั่น NORWAY89" as="h1">
    <p class="mb-8 text-left text-base leading-relaxed text-[#efe0c4]">
      หน้านี้รวมโปรโมชั่นและสิทธิ์ที่ <strong class="text-[#e0aa2e]">NORWAY89</strong> เปิดให้สมาชิกใช้งาน ทั้งโบนัสสำหรับสมาชิกใหม่ โปรฝากประจำวัน สิทธิ์คืนยอดเสีย
      และรายการแนะนำเพื่อน ทุกอย่างผูกกับบัญชีเดียวกับที่ใช้เล่นบาคาร่า สล็อต บอล และหวย จึงกดรับและตรวจสถานะได้จากหน้าสมาชิกหน้าเดิม ไม่ต้องเปิดบัญชีแยกตามหมวดเกม
      เงื่อนไขของแต่ละโปรไม่เหมือนกัน จึงควรอ่านรายละเอียดในหน้ารายการของโปรนั้นก่อนกดรับทุกครั้ง
    </p>

    <div class="grid w-full grid-cols-1 gap-6 sm:grid-cols-2">
      <Picture
        src={pro1}
        alt="ภาพโปรโมชั่นพื้นดำทอง มีโลโก้วงกลม NORWAY89 ที่มุมขวาบน ตัวอักษรใหญ่ NORWAY89 พร้อมแถบข้อความ เว็บตรงครบทุกหมวด และ บาคาร่า สล็อต บอล หวย ใต้ลงมาเป็นแถบ ฝากถอนออโต้ เล่นผ่านมือถือ และ ทางเข้าเว็บหลัก ด้านขวาเป็นพรีเซ็นเตอร์หญิงชุดดำยืนข้างวงล้อรูเล็ต ชิปคาสิโน และไพ่โพดำ"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class="mx-auto h-auto w-full rounded-xl border border-[#e0aa2e]/35 object-contain shadow-[0_10px_30px_rgba(224,170,46,0.18)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#f5d488]/60 hover:shadow-[0_15px_40px_rgba(224,170,46,0.28)]"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />

      <Picture
        src={pro2}
        alt="ภาพโปรโมชั่นพื้นดำทอง มีโลโก้วงกลม NORWAY89 ที่มุมขวาบน ข้อความ NORWAY89 รีวิวเว็บตรง และแถบ รวมบาคาร่า สล็อต บอล หวย ในบัญชีเดียว ใต้ลงมาเป็นบรรทัด ฝากถอนออโต้ ใช้งานง่าย ผ่านมือถือ กับ เว็บตรงโทนหรู เน้นระบบเสถียรและเล่นลื่น ปิดท้ายด้วยปุ่ม เข้าใช้งาน NORWAY89 ด้านขวาเป็นพรีเซ็นเตอร์หญิงชุดเดรสสีทองยืนข้างวงล้อรูเล็ตและไพ่"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class="mx-auto h-auto w-full rounded-xl border border-[#e0aa2e]/35 object-contain shadow-[0_10px_30px_rgba(224,170,46,0.18)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#f5d488]/60 hover:shadow-[0_15px_40px_rgba(224,170,46,0.28)]"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />

      <Picture
        src={pro3}
        alt="ภาพโปรโมชั่นพื้นดำทอง ข้อความ NORWAY89 ครบทั้งบาคาร่า สล็อต บอล หวย และบรรทัด เว็บตรงใช้งานง่าย ฝากถอนออโต้ ด้านซ้ายเป็นมือถือที่เปิดหน้าสมาชิกแสดงยอดเครดิตกับเมนูบาคาร่า สล็อต และฟุตบอล ใต้ลงมาเป็นแถบ บัญชีเดียว เล่นได้ครบ พร้อมแถวโลโก้ธนาคารและไลน์ไอดีของทีมงาน ด้านขวาเป็นพรีเซ็นเตอร์หญิงชุดสีเบจยืนข้างวงล้อรูเล็ตและไพ่เอซ"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class="mx-auto h-auto w-full rounded-xl border border-[#e0aa2e]/35 object-contain shadow-[0_10px_30px_rgba(224,170,46,0.18)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#f5d488]/60 hover:shadow-[0_15px_40px_rgba(224,170,46,0.28)]"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />

      <Picture
        src={pro4}
        alt="ภาพโปรโมชั่นพื้นดำทอง ข้อความ NORWAY89 แนะนำเพื่อน รับค่าคอม 2.5 เปอร์เซ็นต์ รับต่อเนื่องทุกวัน ใต้ลงมาเป็นสามแถบ บทความแน่น อัปเดตทุกวัน รวมสล็อต บาคาร่า บอล หวย ในบัญชีเดียว และ ระบบออโต้ ฝากถอนรวดเร็ว ปลอดภัย ด้านล่างเป็นแถวโลโก้ธนาคารกับไลน์ไอดีของทีมงาน ด้านขวาเป็นพรีเซ็นเตอร์หญิงชุดเดรสสีเงินยืนข้างวงล้อรูเล็ต ชิปคาสิโน และไพ่เอซ"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class="mx-auto h-auto w-full rounded-xl border border-[#e0aa2e]/35 object-contain shadow-[0_10px_30px_rgba(224,170,46,0.18)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#f5d488]/60 hover:shadow-[0_15px_40px_rgba(224,170,46,0.28)]"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />
    </div>

    <div class="mt-12 flex justify-center pb-4">
      <a
        href="/register"
        class="flex items-center justify-center rounded-lg border border-[#e0aa2e]/60 bg-gradient-to-r from-[#f5d488] via-[#e0aa2e] to-[#b87814] px-10 py-3.5 text-lg font-black text-[#120b04] shadow-[0_10px_30px_rgba(224,170,46,0.22)] transition-transform hover:scale-105 hover:shadow-[0_15px_40px_rgba(224,170,46,0.36)]">
        สมัครสมาชิก NORWAY89
      </a>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
