---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";

import { Picture } from "astro:assets";
import image1 from "../assets/gamedemo7.webp";
import image2 from "../assets/gamedemo8.webp";
import image3 from "../assets/gamedemo9.webp";
import image4 from "../assets/gamedemo10.webp";
import image5 from "../assets/gamedemo11.webp";
import image6 from "../assets/gamedemo12.webp";
import image7 from "../assets/gamedemo13.webp";
import image8 from "../assets/gamedemo14.webp";
import image9 from "../assets/gamedemo15.webp";
import image10 from "../assets/gamedemo16.webp";
import image11 from "../assets/gamedemo17.webp";
import image12 from "../assets/gamedemo18.webp";

const demoGames = [
  { id: 1, src: image1, alt: "AskmeSlot", link: "/register" },
  { id: 2, src: image2, alt: "Popular Game", link: "/register" },
  { id: 3, src: image3, alt: "SlotXO", link: "/register" },
  { id: 4, src: image4, alt: "Skywind Group", link: "/register" },
  { id: 5, src: image5, alt: "PG Soft", link: "/register" },
  { id: 6, src: image6, alt: "SBOBET", link: "/register" },
  { id: 7, src: image7, alt: "Sexy Slot", link: "/register" },
  { id: 8, src: image8, alt: "JILI", link: "/register" },
  { id: 9, src: image9, alt: "Ask Me Bet", link: "/register" },
  { id: 10, src: image10, alt: "New Game", link: "/register" },
  { id: 11, src: image11, alt: "JOKER", link: "/register" },
  { id: 12, src: image12, alt: "AFB Gaming", link: "/register" },
];
const homePage = Astro.url.origin;
const gameList = [
  { name: "AskmeSlot", image: homePage + image1.src },
  { name: "Popular Game", image: homePage + image2.src },
  { name: "SlotXO", image: homePage + image3.src },
  { name: "Skywind Group", image: homePage + image4.src },
  { name: "PG Soft", image: homePage + image5.src },
  { name: "SBOBET", image: homePage + image6.src },
  { name: "Sexy Slot", image: homePage + image7.src },
  { name: "JILI", image: homePage + image8.src },
  { name: "Ask Me Bet", image: homePage + image9.src },
  { name: "New Game", image: homePage + image10.src },
  { name: "JOKER", image: homePage + image11.src },
  { name: "AFB Gaming", image: homePage + image12.src },
];
---

<script type="application/ld+json" set:html={JSON.stringify(gameList)} />
<MainLayout
  title="ทดลองเล่น FUNNEMO สล็อตทดลองเล่นฟรี ระบบ DEMO API แท้ทุกค่ายเกม"
  description="ทดลองเล่น FUNNEMO ฟรีทุกค่ายเกมชั้นนำปี ระบบ DEMO API แท้ทุกค่ายเกม ลองฟีเจอร์ใหม่ๆ ก่อนเดิมพันจริง โดยไม่มีค่าใช้จ่าย">
  <Announcement />

  <ContentBox title="ทดลองเล่น FUNNEMO สล็อตทดลองเล่นฟรี ระบบ DEMO API แท้ทุกค่ายเกม">
    <div class="mb-5 grid grid-cols-2 gap-5 sm:grid-cols-2 md:grid-cols-4">
      {
        demoGames.map((game) => (
          <div class="group relative flex flex-col gap-4 overflow-hidden rounded-xl">
            <Picture
              src={game.src}
              alt={game.alt}
              loading="lazy"
              fetchpriority="low"
              widths={[200, 400, 600]}
              sizes="(max-width: 768px) 100vw, 25vw"
              class="mx-auto h-auto w-full max-w-[400px] object-cover shadow-xl transition-transform duration-300 group-hover:scale-105"
              decoding="async"
              formats={["avif", "webp"]}
              fallbackFormat="webp"
              quality={60}
            />
            <a
              href={game.link}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`ทดลองเล่น ${game.alt}`}
              class="absolute inset-0 flex items-center justify-center bg-black/50 opacity-0 transition-opacity duration-300 group-hover:opacity-100">
              <span class="rounded-full bg-gradient-to-r from-yellow-400 to-yellow-600 px-6 py-2 font-bold text-black shadow-lg transition-transform hover:scale-110">เล่นเลย</span>
            </a>
          </div>
        ))
      }
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
