---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#a20d12]/50 bg-[#170707]/92 p-8 text-left text-base leading-relaxed text-[#f2dede] shadow-[0_10px_30px_rgba(224,30,38,0.16)] backdrop-blur-xl transition-all duration-500 hover:border-[#e01e26]/55 hover:shadow-[0_15px_40px_rgba(224,30,38,0.26)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#6e0709]/45 blur-[60px] transition-all duration-500 group-hover:bg-[#e01e26]/25"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#a20d12]/40 blur-[60px] transition-all duration-500 group-hover:bg-[#f5c542]/25"></div>

    {
      title && (
        <header class="mb-6 flex items-center gap-4 border-b border-[#a20d12]/50 pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ff5a5f] to-[#f5c542] shadow-[0_0_10px_rgba(224,30,38,0.5)]" />
          <HeadingTag class="bg-gradient-to-r from-[#ff5a5f] via-[#e01e26] to-[#f5c542] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
