---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
---

<section class="my-3 flex w-full justify-center px-4 font-sans">
  <div
    class="w-full max-w-7xl rounded-[15px] border-2 border-[#c70000] bg-[#0a0000] p-8 text-center text-white/90 shadow-[0_0_20px_rgba(220,38,38,0.2),inset_0_0_15px_rgba(250,204,21,0.05)] transition-all hover:border-red-500/50 hover:shadow-[0_0_25px_rgba(250,204,21,0.2)]">
    {
      title && (
        <header class="mb-6">
          <HeadingTag class="bg-gradient-to-b from-[#fef08a] to-[#eab308] bg-clip-text text-3xl font-black text-transparent drop-shadow-[0_0_5px_rgba(250,204,21,0.4)]">{title}</HeadingTag>
        </header>
      )
    }

    <div class="text-lg leading-relaxed text-white/80">
      <slot />
    </div>
  </div>
</section>

<style>
  .bg-green-yellow-oklab {
    background-image: linear-gradient(in oklab to right, #1b8d3b, #399537, #27a544);
  }
  .font-sans {
    font-family: "Kanit";
  }
</style>
