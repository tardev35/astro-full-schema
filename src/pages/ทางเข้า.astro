---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement6.astro";

const builtAt = new Date();
const updatedIso = builtAt.toLocaleDateString("sv-SE", { timeZone: "Asia/Bangkok" });
const updatedTh = builtAt.toLocaleDateString("th-TH", { timeZone: "Asia/Bangkok", day: "numeric", month: "short", year: "numeric" });

const sections = [
  { h: "BABYSHARK8899 เข้าไม่ได้ เกิดจากอะไร", p: "เว็บหลักเข้าไม่ได้ในบางช่วงเป็นเรื่องปกติ ส่วนใหญ่เกิดจากผู้ให้บริการอินเทอร์เน็ตบางค่ายปิดกั้นชั่วคราว ไม่ได้แปลว่าเว็บปิดหรือยอดเงินหายไปไหน บัญชีของคุณยังอยู่ครบทุกอย่าง วิธีแก้ง่ายที่สุดคือกดลิงก์ทางเข้าสำรองด้านบนนี้ หรือลองสลับจากเน็ตบ้านเป็นเน็ตมือถือ ก็มักจะเข้าได้ทันที" },
  { h: "ทางเข้า BABYSHARK8899 ล่าสุด อัปเดตทุกวัน", p: "ลิงก์ด้านบนคือทางเข้าที่ใช้งานได้ล่าสุด ทีมงานตรวจสอบและเปลี่ยนให้ใหม่ทุกครั้งที่ลิงก์เดิมใช้ไม่ได้ ถ้าวันไหนกดแล้วไม่ขึ้น ให้กลับมาที่หน้านี้อีกครั้ง จะมีลิงก์ใหม่รออยู่เสมอ แนะนำให้บันทึกหน้านี้ไว้ในบุ๊กมาร์ก จะได้ไม่ต้องเสียเวลาค้นหาใหม่ทุกรอบ" },
  { h: "เข้าสู่ระบบ BABYSHARK88 ด้วยยูสเซอร์เดิม", p: "ลิงก์สำรองเชื่อมเข้าระบบเดียวกับเว็บหลัก เข้าสู่ระบบด้วยชื่อผู้ใช้และรหัสผ่านเดิมได้ทันที ไม่ต้องสมัครใหม่ ยอดเงินคงเหลือ ประวัติการฝาก-ถอน และโปรโมชั่นที่รับไว้แล้วยังอยู่ครบเหมือนเดิมทุกรายการ" },
  { h: "ทางเข้า BABYSHARK8899 มือถือและคอมพิวเตอร์", p: "ใช้ลิงก์เดียวกันได้ทั้งมือถือและคอมพิวเตอร์ ระบบปรับขนาดหน้าจอให้อัตโนมัติ ไม่ต้องติดตั้งแอปเพิ่ม รองรับทั้ง iOS และ Android เปิดผ่านเบราว์เซอร์ได้เลย ฝาก-ถอนออโต้ใช้งานได้ตามปกติทั้งสองอุปกรณ์" },
  { h: "สมัครสมาชิก BABYSHARK8899 ผ่านลิงก์สำรอง", p: "ผู้เล่นใหม่สมัครผ่านลิงก์ด้านบนได้เช่นกัน กรอกข้อมูลไม่กี่ขั้นตอนก็เริ่มเล่นได้ รับโปรโมชั่นสมาชิกใหม่ได้ตามปกติ ฝากขั้นต่ำเริ่มต้นน้อย ถอนได้จริงทุกยอดผ่านระบบออโต้" },
];
---

<MainLayout title="ทางเข้า BABYSHARK8899 ล่าสุด เข้าไม่ได้ใช้ลิงก์นี้" description="รวมลิงก์ทางเข้า BABYSHARK8899 ล่าสุด ใช้ได้จริง อัปเดตทุกวัน เข้าเว็บหลักไม่ได้กดลิงก์สำรองในหน้านี้ เข้าสู่ระบบด้วยยูสเดิมได้ทันที ฝาก-ถอนออโต้ 24 ชม.">
  <Announcement />

  <ContentBox title="ทางเข้า BABYSHARK8899 ล่าสุด — เข้าเว็บหลักไม่ได้ ใช้ลิงก์นี้">
    <div class="mb-5 grid grid-cols-1 gap-8 md:grid-cols-2">
      <div class="flex flex-col items-center justify-center gap-4">
        <a
          href="/login"
          aria-label="เข้าสู่ระบบ"
          class="group relative mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-orange-300 bg-gradient-to-b from-amber-800 to-orange-400 px-6 py-4 shadow-[0_0_20px_rgba(234,88,12,0.5),inset_0_-4px_8px_rgba(0,0,0,0.2)] transition-all duration-300 hover:scale-105 hover:shadow-[0_0_30px_rgba(234,88,12,0.8)]">
          <div class="absolute inset-x-0 top-0 h-1/2 bg-gradient-to-b from-white/40 to-transparent"></div>

          <svg class="relative z-10 h-9 w-9 text-white drop-shadow-md" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"></path>
          </svg>

          <span class="relative z-10 text-3xl font-bold tracking-wide text-white [text-shadow:_0_2px_4px_rgb(0_0_0_/_60%)]">เข้าสู่ระบบ</span>
        </a>
      </div>

      <div class="flex flex-col items-center justify-center gap-4">
        <a
          href="/register"
          aria-label="สมัครสมาชิก"
          class="group relative mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-cyan-300 bg-gradient-to-b from-cyan-400 to-blue-700 px-6 py-4 shadow-[0_0_20px_rgba(6,182,212,0.5),inset_0_-4px_8px_rgba(0,0,0,0.2)] transition-all duration-300 hover:scale-105 hover:shadow-[0_0_30px_rgba(6,182,212,0.8)]">
          <div class="absolute inset-x-0 top-0 h-1/2 bg-gradient-to-b from-white/40 to-transparent"></div>

          <svg class="relative z-10 h-9 w-9 text-white drop-shadow-md" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"></path>
          </svg>

          <span class="relative z-10 text-3xl font-bold tracking-wide text-white [text-shadow:_0_2px_4px_rgb(0_0_0_/_60%)]">สมัครสมาชิก</span>
        </a>
      </div>
    </div>

    <p class="mb-5 text-center text-sm text-gray-300">
      อัปเดตล่าสุด <time datetime={updatedIso} class="font-bold text-amber-400">{updatedTh}</time>
    </p>

    <p class="leading-relaxed">หน้านี้รวมลิงก์ทางเข้า BABYSHARK8899 ที่ใช้ได้ล่าสุด ถ้าเข้าเว็บหลักแล้วหน้าไม่โหลด หรือเน็ตบ้านเปิดไม่ขึ้น ให้กดลิงก์ทางเข้าด้านบนนี้ได้เลย ใช้ยูสเซอร์เดิมเข้าสู่ระบบได้ทันที ยอดเงิน โปรโมชั่น และประวัติการเล่นอยู่ครบเหมือนเดิมทุกอย่าง ทีมงานอัปเดตลิงก์ใหม่ทุกครั้งที่ทางเข้าเดิมใช้ไม่ได้ แนะนำให้บุ๊กมาร์กหน้านี้ไว้ จะได้หาทางเข้าใหม่ได้เร็วที่สุด</p>
  </ContentBox>
  <ContentBox>
    <div class="flex flex-col gap-8">
      {
        sections.map((s) => (
          <section>
            <h2 class="mb-4 text-3xl font-black tracking-[0.2em] text-yellow-400 uppercase drop-shadow-[0_0_10px_rgba(0,0,0,0.05)]">{s.h}</h2>
            <p class="leading-relaxed">{s.p}</p>
          </section>
        ))
      }
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
