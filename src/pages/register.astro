---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";
import CtaRedirect from "../components/CtaRedirect.astro";
import { pageGraph } from "../lib/schema";

const pageTitle = "สมัครสมาชิก TOPGAMEVIP | ปุ่มเปิดยูสใหม่ผ่านมือถือ ระบบออโต้ทั้งเว็บ";

const pageDescription =
  "หากคุณกำลังมองหาเว็บตรงที่สมัครจบในไม่กี่นาที TOPGAMEVIP พร้อมมอบปุ่มเปิดยูสใหม่ผ่านมือถือ เพื่อเข้าเล่นเกมสล็อตลิขสิทธิ์แท้ด้วยระบบออโต้ ฝากถอนไม่มีขั้นต่ำ";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "สมัครสมาชิก", path: "/register" },
  ],
});

const targetUrl = "https://yoalink.com/22hs";
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="สมัครสมาชิก TOPGAMEVIP" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label="สมัครสมาชิก TOPGAMEVIP"
        class="group relative mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#8a6410] bg-gradient-to-r from-[#ffe9a8] via-[#f5c542] to-[#d4a017] px-6 py-4 text-xl font-bold tracking-wide text-[#2a0709] shadow-[0_10px_30px_rgba(212,160,23,0.26)] transition-all duration-300 hover:scale-105 hover:border-[#ffe9a8] hover:shadow-[0_15px_40px_rgba(212,160,23,0.35)]">
        สมัครสมาชิก TOPGAMEVIP
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="สมัครสมาชิก" />
</MainLayout>
