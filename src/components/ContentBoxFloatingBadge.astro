---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-xl sm:text-2xl md:text-3xl" : "text-lg sm:text-xl md:text-2xl";
---

<section class="my-10 flex w-full justify-center px-4 font-sans">
  <div
    class="relative isolate w-full max-w-[1400px] rounded-2xl border-2 border-[#ff3ddb]/30 bg-gradient-to-b from-[#1a0414]/95 to-[#0a0208]/95 p-8 pt-36 text-left text-base leading-relaxed text-[#f7e3f4] shadow-[0_10px_30px_rgba(255,61,219,0.22)] md:pt-32">
    <div aria-hidden="true" class="pointer-events-none absolute -top-16 -right-10 -z-10 h-40 w-40 rounded-full bg-[#ff3ddb]/25 blur-[60px]"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -bottom-16 -left-10 -z-10 h-40 w-40 rounded-full bg-[#b07d1c]/45 blur-[60px]"></div>

    {
      title && (
        <div class="absolute -top-6 left-1/2 flex w-[92%] max-w-2xl -translate-x-1/2 items-center justify-center gap-2 rounded-lg border-2 border-[#f5c451]/40 bg-[#2b0722] px-4 py-2.5 text-center shadow-[0_10px_30px_rgba(245,196,81,0.26)] sm:px-8">
          <span aria-hidden="true" class="shrink-0 text-[#ffa3ee]">
            ✦
          </span>
          <HeadingTag class={`min-w-0 bg-gradient-to-r from-[#ffe6a3] via-[#f5c451] to-[#ffa3ee] bg-clip-text ${headingSize} leading-normal font-black tracking-tight text-transparent uppercase`}>
            {title}
          </HeadingTag>
          <span aria-hidden="true" class="shrink-0 text-[#ffa3ee]">
            ✦
          </span>
        </div>
      )
    }

    <slot />
  </div>
</section>
