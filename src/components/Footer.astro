---
import { Picture } from "astro:assets";

const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });

const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;
---

--- ---

<footer class="mt-12 w-full border-t-2 border-emerald-900/50 bg-[#050c0a] py-10 font-sans text-white shadow-[0_-10px_30px_rgba(16,185,129,0.15)]">
  <div class="mx-auto w-full max-w-[1101px] px-4">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-3">
      <div class="flex flex-col gap-4">
        <h3 class="bg-gradient-to-b from-[#a7f3d0] to-[#10b981] bg-clip-text text-3xl font-black text-transparent drop-shadow-[0_0_5px_rgba(16,185,129,0.3)]">SIXSLOT-BKK</h3>
        <p class="text-sm leading-relaxed text-white/70">
          SIXSLOT-BKK ทางเข้าเว็บตรง เว็บแท้ รวมความบันเทิงครบวงจร สล็อต คาสิโน กีฬาในที่เดียว สมัคร พร้อมรับสิทธิพิเศษ ฝากถอนได้ง่าย ระบบออโต้ จ่ายจริง
        </p>
      </div>

      <nav aria-label="เมนู" class="flex flex-col gap-4">
        <p class="text-lg font-bold text-emerald-400 drop-shadow-[0_0_5px_rgba(16,185,129,0.4)]">เมนูหลัก</p>
        <ul class="flex flex-col gap-2 text-sm text-white/70">
          <li><a href="/" class="transition-colors hover:text-emerald-400">หน้าแรก</a></li>
          <li><a href="/promotion" class="transition-colors hover:text-emerald-400">โปรโมชั่น</a></li>
          <li><a href="/register" class="transition-colors hover:text-emerald-400">สมัครสมาชิก</a></li>
          <li><a href="/contact-us" class="transition-colors hover:text-emerald-400">ติดต่อเรา</a></li>
        </ul>
      </nav>

      <div class="flex flex-col gap-4">
        <h3 class="text-lg font-bold text-emerald-400 drop-shadow-[0_0_5px_rgba(16,185,129,0.4)]">บริการลูกค้า</h3>
        <address class="text-sm text-white/70 not-italic">
          <p class="mb-2">เปิดให้บริการตลอด 24 ชั่วโมง ไม่มีวันหยุด</p>
          <p class="flex items-center gap-2">
            <span class="font-bold text-emerald-400">Line:</span>
            <a href="/line" class="transition-colors hover:text-white">@SIXSLOTBKK</a>
          </p>
        </address>
      </div>
    </div>

    <div class="mt-8 border-t border-emerald-900/30 pt-6 text-center text-xs text-white/40">
      <p>&copy; {new Date().getFullYear()} SIXSLOT-BKK. All rights reserved.</p>
    </div>
  </div>
</footer>

<style>
  footer a {
    text-decoration: none;
  }
  footer {
    font-family: "Kanit", sans-serif;
  }
</style>
