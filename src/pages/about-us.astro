---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";
import { pageGraph } from "../lib/schema";

const pageTitle = "เกี่ยวกับเรา GGHENG สล็อตเว็บตรงสายเฮง ระบบแท้100% จ่ายไม่อั้น";

const pageHeading = "เกี่ยวกับเรา GGHENG สล็อตเว็บตรงสายเฮง ที่ตั้งใจทำระยะยาว";

const pageDescription =
  "รู้จัก GGHENG สล็อตเว็บตรงสายเฮง ระบบแท้100% ใช้ค่า RTP มาตรฐานสากลจากค่ายแม่ ไม่ล็อกยูส ไม่มีขั้นต่ำ ฝากถอน True Money Wallet ออโต้ อ่านว่าเว็บนี้ทำงานอย่างไร";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox as="h1" title={pageHeading}>
    <p class="mb-4 text-left text-base leading-relaxed">
      <strong class="text-[#ffdf80]">GGHENG</strong> หรือจีจีเฮง คือสล็อตเว็บตรงสายเฮงที่ใช้ระบบแท้100% จากต่างประเทศ สมาชิกใช้ยูสเซอร์เดียวเข้าเล่นได้ทั้งมือถือ ไอแพด และคอมพิวเตอร์ โดยไม่ต้องโหลดแอปเพิ่ม
    </p>

    <p class="mb-4 text-left text-base leading-relaxed">
      เราเลือกทำเว็บนี้แบบจริงจังระยะยาว ไม่ใช่เว็บที่หวังผลชั่วคราว การตัดสินใจเกือบทุกเรื่องในระบบจึงเริ่มจากคำถามเดียวกัน คือสมาชิกจะยังอยากกลับมาเล่นอีกไหม
    </p>

    <p class="text-left text-base leading-relaxed">เว็บที่คิดจะอยู่นาน ไม่มีเหตุผลต้องเอาชื่อตัวเองไปแลกกับกำไรรอบเดียว</p>
  </ContentBox>

  <ContentBox as="h2" title="ระบบแท้100% ค่า RTP มาตรฐานสากลจากค่ายแม่ ไม่ล็อกยูส">
    <p class="mb-4 text-left text-base leading-relaxed">
      เกมทุกเกมบน GGHENG รันด้วยค่า RTP หรือ Return to Player มาตรฐานสากลที่ค่ายแม่กำหนดมาโดยตรง เว็บไม่ได้เข้าไปยุ่งกับค่าแพ้ชนะ และไม่ปรับอัตราใด ๆ ระหว่างทาง
    </p>

    <p class="mb-4 text-left text-base leading-relaxed">
      ไม่มีการล็อกยูสรายบัญชี ไม่ว่าจะเล่นเบทเล็กหรือเบทใหญ่ ผลของแต่ละรอบมาจากระบบของค่ายเกมชุดเดียวกันทุกคน ที่เหลือจึงเป็นเรื่องของดวงและจังหวะของผู้เล่นเอง
    </p>

    <p class="text-left text-base leading-relaxed">ความเฮงของที่นี่ไม่ได้มาจากสูตรลับ มันมาจากความแฟร์ที่ไม่มีใครเข้าไปแตะ</p>
  </ContentBox>

  <ContentBox as="h2" title="ค่ายเกมลิขสิทธิ์แท้ที่เปิดให้เล่นบน GGHENG">
    <p class="mb-4 text-left text-base leading-relaxed">
      ค่ายที่รวมไว้มีทั้ง PG SOFT, Pragmatic Play และ Joker Gaming พร้อมค่ายชั้นนำอื่น ๆ ทุกเกมเป็นลิขสิทธิ์แท้ ภาพและเสียงมาครบตามต้นฉบับ และมีเกมใหม่อัปเดตเข้ามาต่อเนื่อง
    </p>

    <p class="mb-4 text-left text-base leading-relaxed">
      แต่ละค่ายวางจังหวะเกมและฟีเจอร์ไว้ไม่เหมือนกัน บางค่ายเด่นที่ฟรีสปิน บางค่ายเด่นที่เกมโบนัส การมีหลายค่ายในเว็บเดียวจึงหมายถึงมีตัวเลือกให้ตรงกับสไตล์ของแต่ละคนมากขึ้น
    </p>

    <p class="text-left text-base leading-relaxed">เกมดีไม่ได้วัดกันที่จำนวน วัดกันที่เล่นแล้วลื่นไหลไม่สะดุดกลางรอบ</p>
  </ContentBox>

  <ContentBox as="h2" title="จ่ายไม่อั้น ถอนหลักล้านโอนครบ และไม่มีขั้นต่ำ">
    <p class="mb-4 text-left text-base leading-relaxed">
      GGHENG เตรียมสภาพคล่องทางการเงินไว้รองรับยอดถอนทุกขนาด ไม่ว่าจะเป็นหลักแสนหรือหลักล้านก็โอนครบทุกบาท ไม่มีการผ่อนจ่าย และไม่หักค่าธรรมเนียมจากยอดที่ถอน
    </p>

    <p class="mb-4 text-left text-base leading-relaxed">
      ฝั่งฝากก็ไม่มีขั้นต่ำเช่นกัน ทุนมากหรือน้อยเริ่มต้นได้เท่ากัน จะฝากหลักสิบหรือหลักร้อยก็เข้าเล่นเกมเดียวกับสมาชิกคนอื่นได้ทุกเกม
    </p>

    <p class="mb-4 text-left text-base leading-relaxed">
      ระบบการเงินรองรับ True Money Wallet แบบเต็มรูปแบบ คนที่ไม่สะดวกใช้บัญชีธนาคารก็ฝากถอนผ่านวอลเล็ตได้ ระบบออโต้ทำงานเร็วเท่ากันทั้งสองช่องทาง และตรวจสอบย้อนหลังได้ทุกยอดธุรกรรม
    </p>

    <p class="text-left text-base leading-relaxed">เงินที่เล่นได้เป็นของสมาชิก หน้าที่ของเว็บคือส่งมันให้ถึงมือ</p>
  </ContentBox>

  <ContentBox as="h2" title="เข้าได้ทุกแพลตฟอร์ม และการดูแลบัญชีสมาชิก GGHENG">
    <p class="mb-4 text-left text-base leading-relaxed">
      เว็บไซต์ทำมาให้เสถียรและไม่กินเน็ต เปิดจากเบราว์เซอร์ได้ทันทีโดยไม่ต้องติดตั้งอะไรลงเครื่อง ยูสเซอร์เดียวใช้ต่อได้ทุกอุปกรณ์ สลับจากมือถือไปคอมพิวเตอร์แล้วยอดเครดิตยังเป็นชุดเดิม
    </p>

    <p class="mb-4 text-left text-base leading-relaxed">
      รหัสผ่านควรตั้งให้ไม่ซ้ำกับบัญชีสำคัญอื่น และไม่ส่งรหัสผ่านหรือรหัส OTP ให้ใคร ไม่ว่าอีกฝ่ายจะอ้างว่าเป็นใครก็ตาม ทีมงานจริงไม่มีเหตุต้องขอข้อมูลสองอย่างนี้
    </p>

    <p class="text-left text-base leading-relaxed">บัญชีที่ปลอดภัยไม่ได้ทำให้เล่นเก่งขึ้น แต่ทำให้ไม่ต้องคอยระแวงมัน</p>
  </ContentBox>

  <Navfoot />
</MainLayout>
