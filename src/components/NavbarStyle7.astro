---
import { isActivePath } from "../lib/nav";
import { Picture } from "astro:assets";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });

const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

const currentPath = Astro.url.pathname;

const isActive = (path: string) => isActivePath(currentPath, path);

const affUrl = "https://yoalink.com/22hs";

const links = [
  { name: "หน้าแรก", path: "/", icon: "🏠" },
  { name: "โปรโมชั่น", path: "/promotion/", icon: "🎁" },
  { name: "ทดลองเล่น", path: "/ทดลองเล่น/", icon: "🎰" },
  { name: "วิธีฝากถอน", path: "/วิธีฝากถอน/", icon: "💳" },
  { name: "เกี่ยวกับเรา", path: "/about-us/", icon: "💎" },
  { name: "ติดต่อเรา", path: "/contact-us/", icon: "💬" },
];

const logoAlt = "โลโก้ 77RUAY ตัวอักษร 77RUAY สีทองนูนแบบสามมิติ ขอบทองเข้มเงาวาว";
---

<header class="sticky top-0 z-50 w-full font-sans">
  <nav
    aria-label="เมนูหลัก"
    class="relative z-40 w-full border-b-2 border-[#e0a91b] bg-[#0a1f5c] shadow-[0_6px_24px_rgba(10,31,92,0.25)]"
    style="background-image: linear-gradient(in oklab to right, #0a1f5c, #0b3a9e 55%, #0a1f5c);">
    <div class="mx-auto flex h-[66px] max-w-[1400px] items-center justify-between gap-4 px-4 lg:h-[78px] xl:px-8">
      <a href="/" class="flex-shrink-0 transition-transform hover:scale-105">
        {
          mainLogo ? (
            <Picture
              src={mainLogo}
              alt={logoAlt}
              widths={[110, 220, 330]}
              sizes="110px"
              loading="eager"
              fetchpriority="high"
              class="h-[38px] w-auto drop-shadow-[0_2px_6px_rgba(224,169,27,0.45)] lg:h-[50px]"
              formats={["avif", "webp"]}
              fallbackFormat="webp"
            />
          ) : (
            <span class="bg-gradient-to-b from-[#fff3c4] via-[#ffd45c] to-[#b07d12] bg-clip-text text-2xl font-black text-transparent lg:text-3xl">77RUAY</span>
          )
        }
      </a>

      <ul class="hidden h-full items-center justify-center gap-6 xl:flex 2xl:gap-8">
        {
          links.map((link) => (
            <li class="h-full">
              <a
                href={link.path}
                aria-current={isActive(link.path) ? "page" : undefined}
                class="group relative flex h-full shrink-0 items-center gap-1.5 text-[15px] font-bold whitespace-nowrap transition-colors">
                <span aria-hidden="true" class="text-base leading-none">
                  {link.icon}
                </span>
                <span class={isActive(link.path) ? "text-[#ffd45c]" : "text-[#dbe6fb] group-hover:text-white"}>{link.name}</span>
                <span
                  aria-hidden="true"
                  class={`absolute inset-x-0 bottom-0 h-[3px] rounded-t-full bg-[#ffd45c] transition-transform duration-300 ${isActive(link.path) ? "scale-x-100" : "scale-x-0 group-hover:scale-x-100"}`}
                />
              </a>
            </li>
          ))
        }
      </ul>

      <div class="flex items-center gap-3">
        <a
          href={affUrl}
          rel="nofollow sponsored"
          style="background-image: linear-gradient(in oklab to bottom, #ffd45c, #e0a91b, #b07d12);"
          class="hidden items-center justify-center rounded-full px-6 py-2.5 text-sm font-extrabold text-[#0a1f5c] shadow-[0_0_16px_rgba(224,169,27,0.40)] transition-all hover:brightness-110 lg:flex">
          เข้าสู่ระบบ
        </a>
        <a
          href={affUrl}
          rel="nofollow sponsored"
          style="background-image: linear-gradient(in oklab to bottom, #4d8ff5, #1a5fe0, #0b3a9e);"
          class="hidden items-center justify-center rounded-full border-2 border-[#ffd45c] px-6 py-2 text-sm font-extrabold text-white shadow-[0_0_18px_rgba(26,95,224,0.45)] transition-all hover:brightness-110 lg:flex">
          สมัครสมาชิก
        </a>

        <button
          id="hamburger-btn"
          type="button"
          aria-label="เปิดเมนู"
          aria-expanded="false"
          aria-controls="mobile-bottom-sheet"
          class="flex h-11 w-11 flex-col items-center justify-center space-y-1.5 rounded-xl border border-[#ffd45c]/50 bg-white/10 xl:hidden">
          <span class="hamburger-line h-[2px] w-6 origin-center rounded-full bg-[#ffd45c] transition-all duration-300"></span>
          <span class="hamburger-line h-[2px] w-6 rounded-full bg-[#ffd45c] transition-all duration-300"></span>
          <span class="hamburger-line h-[2px] w-6 origin-center rounded-full bg-[#ffd45c] transition-all duration-300"></span>
        </button>
      </div>
    </div>
  </nav>

  <div id="mobile-overlay" class="pointer-events-none fixed inset-0 z-[105] bg-[#0a1f5c]/55 opacity-0 transition-opacity duration-300 xl:hidden"></div>

  <div
    id="mobile-bottom-sheet"
    class="pb-safe fixed bottom-0 left-0 z-[110] max-h-[85vh] w-full translate-y-full transform overflow-y-auto rounded-t-3xl border-t-4 border-[#e0a91b] bg-white shadow-[0_-12px_40px_rgba(10,31,92,0.30)] transition-transform duration-300 ease-[cubic-bezier(0.3,1,0.3,1)] xl:hidden">
    <button type="button" id="close-sheet-btn" aria-label="ปิดเมนู" class="flex w-full cursor-pointer justify-center pt-3 pb-2">
      <span aria-hidden="true" class="h-1.5 w-12 rounded-full bg-[#9dbcf0]"></span>
    </button>

    <ul class="flex flex-col gap-2 px-5 pt-1">
      {
        links.map((link) => (
          <li>
            <a
              href={link.path}
              aria-current={isActive(link.path) ? "page" : undefined}
              class={`sheet-item flex items-center justify-between rounded-2xl border px-5 py-3.5 transition-colors ${isActive(link.path) ? "border-[#1a5fe0] bg-[#eef4ff] text-[#0b3a9e]" : "border-[#d6e2f7] bg-white text-[#0a1f5c]"}`}>
              <span class="flex items-center gap-4">
                <span aria-hidden="true" class="text-2xl">
                  {link.icon}
                </span>
                <span class="text-base font-bold">{link.name}</span>
              </span>
              {isActive(link.path) && <span aria-hidden="true" class="h-2.5 w-2.5 rounded-full bg-[#e0a91b] shadow-[0_0_8px_rgba(224,169,27,0.8)]" />}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="mt-4 flex flex-col gap-3 border-t border-[#d6e2f7] px-5 pt-4 pb-8">
      <a
        href={affUrl}
        rel="nofollow sponsored"
        style="background-image: linear-gradient(in oklab to bottom, #4d8ff5, #1a5fe0, #0b3a9e);"
        class="flex w-full items-center justify-center rounded-xl border-2 border-[#ffd45c] py-3.5 text-base font-extrabold text-white shadow-[0_0_15px_rgba(26,95,224,0.35)]">
        สมัครสมาชิก
      </a>
      <a
        href={affUrl}
        rel="nofollow sponsored"
        style="background-image: linear-gradient(in oklab to bottom, #ffd45c, #e0a91b, #b07d12);"
        class="flex w-full items-center justify-center rounded-xl py-3.5 text-base font-extrabold text-[#0a1f5c] shadow-[0_0_12px_rgba(224,169,27,0.35)]">
        เข้าสู่ระบบ
      </a>
    </div>
  </div>
</header>

<script>
  const hamburgerBtn = document.getElementById("hamburger-btn");
  const mobileBottomSheet = document.getElementById("mobile-bottom-sheet");
  const mobileOverlay = document.getElementById("mobile-overlay");
  const closeSheetBtn = document.getElementById("close-sheet-btn");
  const hamburgerLines = document.querySelectorAll(".hamburger-line");

  function setMenu(open: boolean) {
    mobileBottomSheet?.classList.toggle("translate-y-full", !open);
    mobileBottomSheet?.classList.toggle("translate-y-0", open);
    mobileOverlay?.classList.toggle("pointer-events-none", !open);
    mobileOverlay?.classList.toggle("opacity-0", !open);
    mobileOverlay?.classList.toggle("opacity-100", open);
    hamburgerBtn?.setAttribute("aria-expanded", String(open));

    hamburgerLines[0]?.classList.toggle("rotate-45", open);
    hamburgerLines[0]?.classList.toggle("translate-y-[8px]", open);
    hamburgerLines[1]?.classList.toggle("opacity-0", open);
    hamburgerLines[2]?.classList.toggle("-rotate-45", open);
    hamburgerLines[2]?.classList.toggle("-translate-y-[8px]", open);
  }

  const isOpen = () => mobileBottomSheet?.classList.contains("translate-y-0") ?? false;

  hamburgerBtn?.addEventListener("click", () => setMenu(!isOpen()));
  mobileOverlay?.addEventListener("click", () => setMenu(false));
  closeSheetBtn?.addEventListener("click", () => setMenu(false));
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && isOpen()) setMenu(false);
  });

  document.querySelectorAll(".sheet-item").forEach((item) => {
    item.addEventListener("click", () => {
      if (isOpen()) setMenu(false);
    });
  });
</script>
