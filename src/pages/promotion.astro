---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";

import { Picture } from "astro:assets";

import pro1 from "../assets/slide1.png";
import pro2 from "../assets/slide2.png";
import pro3 from "../assets/slide3.png";
import { pageGraph } from "../lib/schema";

const pageTitle = "โปรโมชั่น PIGAUTO รวมภาพโปรสมาชิกใหม่ สล็อตออโต้ และคาสิโนสด";

const pageHeading = "โปรโมชั่น PIGAUTO";

const pageDescription =
  "หากคุณกำลังมองหาโปรที่คุ้มกว่าเดิม PIGAUTO รวมภาพโปรสมาชิกใหม่ สล็อตออโต้ คาสิโนสด และสิทธิ์สายวอลเล็ทไว้หน้าเดียว ดูยอดรับและเงื่อนไขบนภาพก่อนกดสมัครใช้สิทธิ์";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: pro1.src,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageHeading} as="h1">
    <p class="mb-4 text-left text-base leading-relaxed text-[#f7e2d6]">
      หากคุณกำลังมองหาโปรโมชั่นที่คุ้มค่าและใช้ได้จริง <strong class="text-[#f5c542]">PIGAUTO</strong> พร้อมมอบทั้งโปรสมาชิกใหม่ สล็อตออโต้
      คาสิโนสด และสิทธิ์สำหรับสายวอลเล็ท รวมไว้ให้เลือกครบในหน้าเดียว
    </p>

    <p class="mb-8 text-left text-base leading-relaxed text-[#f7e2d6]">
      แต่ละใบระบุยอดรับ เงื่อนไขเทิร์น และช่วงเวลาที่ใช้ได้ไว้บนภาพ เลือกโปรที่ตรงกับงบและสไตล์ของคุณ แล้วสมัครครั้งเดียวใช้สิทธิ์ต่อได้ยาว ๆ
      เพื่อให้ทุกยอดฝากคุ้มค่ากว่าที่เคย
    </p>

    <div class="grid w-full grid-cols-1 gap-6 sm:grid-cols-2">
      <Picture
        src={pro1}
        alt="ภาพโปรโมชั่น PIGAUTO โทนแดงทองแบบตรุษจีน พรีเซนเตอร์หญิงสวมชุดกี่เพ้าสีแดงปักลายทอง ยืนท่ามกลางโคมไฟจีนสีแดง พัดทอง ไพ่ ชิปคาสิโน และเหรียญทองที่ลอยฟุ้ง ด้านบนเป็นโลโก้หมูสีชมพู PIGAUTO ข้อความบนภาพเขียนว่า รองรับวอลเล็ท เต็มระบบ และ pig auto wallet ใช้ง่าย"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class="mx-auto h-auto w-full rounded-xl border border-[#6b2020] object-contain shadow-[0_10px_30px_rgba(239,68,68,0.16)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#ef4444]/50 hover:shadow-[0_15px_40px_rgba(239,68,68,0.26)]"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />

      <Picture
        src={pro2}
        alt="ภาพโปรโมชั่น PIGAUTO พื้นแดงเข้มโทนตรุษจีน มีโคมไฟแดงและพัดทองเรียงอยู่รอบภาพ พรีเซนเตอร์หญิงชุดกี่เพ้าแดงปักลายทองยืนอยู่ด้านขวา ล้อมด้วยไพ่ ชิปคาสิโน และเหรียญทอง ข้อความบนภาพเขียนว่า เว็บสล็อตออโต้ไม่มีขั้นต่ำ และ เล่นได้อย่างเป็นมิตร ปลอดภัยสูง"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class="mx-auto h-auto w-full rounded-xl border border-[#6b2020] object-contain shadow-[0_10px_30px_rgba(239,68,68,0.16)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#ef4444]/50 hover:shadow-[0_15px_40px_rgba(239,68,68,0.26)]"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />

      <Picture
        src={pro3}
        alt="ภาพโปรโมชั่น PIGAUTO พรีเซนเตอร์หญิงชุดกี่เพ้าแดงยืนอยู่ด้านซ้าย ด้านหลังเป็นวงกลมลายจีนสีทองบนผ้าม่านแดง มีโคมไฟแดง พัดทอง เหรียญจีน และไพ่กระจายรอบภาพ มุมบนขวาเป็นโลโก้หมูสีชมพู PIGAUTO ตัวอักษรใหญ่กลางภาพเขียนว่า PIGAUTO และ สมัครง่ายเหมือนเปิดมือถือ"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class="mx-auto h-auto w-full rounded-xl border border-[#6b2020] object-contain shadow-[0_10px_30px_rgba(239,68,68,0.16)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#ef4444]/50 hover:shadow-[0_15px_40px_rgba(239,68,68,0.26)]"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />
    </div>

    <div class="mt-12 flex justify-center pb-4">
      <a
        href="/register"
        class="flex items-center justify-center rounded-lg border border-[#ef4444]/40 bg-gradient-to-r from-[#ffe9a8] via-[#f5c542] to-[#ffd75e] px-10 py-3.5 text-lg font-black text-[#280707] shadow-[0_10px_30px_rgba(239,68,68,0.24)] transition-transform hover:scale-105 hover:shadow-[0_15px_40px_rgba(245,197,66,0.30)]">
        สมัครสมาชิก PIGAUTO
      </a>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
