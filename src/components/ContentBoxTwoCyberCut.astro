---
const { titleleft, titleright } = Astro.props;
---

<section class="mx-auto mb-6 w-full max-w-7xl px-4 font-sans">
  <div
    class="relative w-full border border-red-500/40 bg-[#2a0800]/90 p-8 text-white/90 shadow-[0_0_25px_rgba(239,68,68,0.15)] backdrop-blur-md transition-all duration-300 hover:border-red-400 hover:shadow-[0_0_40px_rgba(239,68,68,0.3)]"
    style="clip-path: polygon(30px 0, 100% 0, 100% calc(100% - 30px), calc(100% - 30px) 100%, 0 100%, 0 30px);">
    <div class="absolute top-0 left-0 h-[2px] w-24 bg-gradient-to-r from-red-500 to-transparent"></div>
    <div class="absolute right-0 bottom-0 h-[2px] w-24 bg-gradient-to-l from-red-500 to-transparent"></div>
    <div class="absolute top-0 left-0 h-16 w-[2px] bg-gradient-to-b from-red-500 to-transparent"></div>
    <div class="absolute right-0 bottom-0 h-16 w-[2px] bg-gradient-to-t from-red-500 to-transparent"></div>

    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <article class="relative flex flex-col gap-4">
        {
          titleleft && (
            <h2 class="flex items-center gap-2 border-b border-red-500/30 pb-2 text-xl font-black tracking-widest text-red-400 uppercase">
              <span class="inline-block h-2 w-2 bg-yellow-400 shadow-[0_0_5px_rgba(255,215,0,0.8)]" /> {titleleft}
            </h2>
          )
        }
        <div class="text-sm leading-relaxed text-red-100/80">
          <slot name="left" />
        </div>
      </article>

      <article class="relative flex flex-col gap-4 md:border-l md:border-red-500/30 md:pl-8">
        {
          titleright && (
            <h2 class="flex items-center gap-2 border-b border-red-500/30 pb-2 text-xl font-black tracking-widest text-red-400 uppercase">
              <span class="inline-block h-2 w-2 bg-yellow-400 shadow-[0_0_5px_rgba(255,215,0,0.8)]" /> {titleright}
            </h2>
          )
        }
        <div class="text-sm leading-relaxed text-red-100/80">
          <slot name="right" />
        </div>
      </article>
    </div>
  </div>
</section>

<style>
  .font-sans {
    font-family: "Kanit", sans-serif;
  }
</style>
