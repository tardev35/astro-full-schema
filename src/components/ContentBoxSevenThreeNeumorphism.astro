---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;
const rightHeading = titleright ?? title;
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="w-full rounded-[25px] border border-[#f1d2d3] bg-white p-8 shadow-[10px_10px_24px_rgba(236,27,36,0.10),-8px_-8px_20px_#ffffff] transition-all duration-300 hover:border-[#e9b7b9] hover:shadow-[15px_15px_30px_rgba(236,27,36,0.14),-10px_-10px_24px_#ffffff]">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#2b2627]">
        {titleleft && <p class="text-2xl leading-normal font-black text-[#b5121a]">{titleleft}</p>}
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#2b2627] md:border-l md:border-[#f1d2d3] md:pl-8">
        {rightHeading && <HeadingTag class="border-l-4 border-[#ec1b24] pl-3 text-2xl leading-normal font-black text-[#141414]">{rightHeading}</HeadingTag>}
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
