---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import { pageGraph } from "../lib/schema";

const pageTitle = "เกี่ยวกับเรา OKG777 เว็บตรงที่รวมสล็อต คาสิโนสด และกีฬาไว้ในบัญชีเดียว";

const pageDescription =
  "เกี่ยวกับเรา OKG777 หน้ารีวิวที่อธิบายว่าเว็บรวมสล็อต คาสิโนสด และกีฬาไว้ในบัญชีเดียวอย่างไร พร้อมเงื่อนไขสมาชิกใหม่รับฟรี 18 บาท และระบบฝากถอนอัตโนมัติ";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle}>
    <p class="mb-4 text-left text-base leading-relaxed text-[#ece2fb]">
      OKG777 วางตัวเป็นแพลตฟอร์มเกมออนไลน์ที่รวมสล็อต คาสิโนสด และกีฬาไว้ภายในบัญชีเดียว จุดที่ทำให้ต่างจากเว็บทั่วไปจึงไม่ได้อยู่ที่จำนวนเกมอย่างเดียว
      แต่อยู่ที่การสลับหมวดได้ต่อเนื่องโดยไม่ต้องสมัครหลายเว็บหรือโยกเครดิตไปมาจนขั้นตอนยาวเกินจำเป็น สมาชิกจัดการเครดิต โปรโมชั่น และประวัติการใช้งานได้จากบัญชีเดียวกัน
      ส่วนงานหลังบ้านอย่างการฝากถอนเป็นระบบอัตโนมัติ ตรวจสถานะรายการและย้อนดูประวัติธุรกรรมได้เองจากหน้าบัญชี โดยไม่ต้องทักถามทุกขั้นตอน
    </p>

    <p class="mb-4 text-left text-base leading-relaxed text-[#ece2fb]">
      ฝั่งโปรโมชั่นที่เห็นชัดบนหน้าเว็บมีสามชุดหลัก คือ สมาชิกใหม่รับฟรี 18 บาท ตามเงื่อนไขของกิจกรรมที่กำหนด เครดิตฟรี 38 บาท ที่ให้ตามช่วงโปรโมชั่น
      และรางวัลชวนเพื่อน 88 บาท ที่ตอบแทนสมาชิกซึ่งแนะนำผู้ใช้ใหม่เข้ามา ทั้งสามอย่างมีเป้าหมายต่างกัน จึงควรอ่านเงื่อนไขของแต่ละตัวแยกกันก่อนกดรับสิทธิ์
      ส่วนอาร์ตเวิร์กของเว็บยังระบุคืนยอดเสีย 8% เอาไว้ด้วย ซึ่งเป็นตัวเลขที่ต้องไปเปิดอ่านรายละเอียดจากหน้าโปรโมชั่นจริงอีกที ไม่ใช่ตัวเลขที่หน้านี้รับรองแทน
    </p>

    <p class="text-left text-base leading-relaxed text-[#ece2fb]">
      หน้าเว็บชุดนี้ทำหน้าที่เป็นหน้ารีวิวและให้ข้อมูล ไม่ได้รับเดิมพัน ไม่ได้เก็บยอดเงินของใครเอง และไม่ได้ทำรายการฝากถอนแทนผู้ใช้ สิ่งที่เราเขียนจึงตั้งใจให้อ่านแล้วเอาไปตรวจต่อได้จริง
      เช่น คำว่าจ่ายจริงควรดูจากสถานะการถอนและประวัติรายการในบัญชีของตัวเอง ไม่ใช่จากข้อความบนแบนเนอร์ และควรตรวจชื่อเว็บไซต์กับการเชื่อมต่อ HTTPS ทุกครั้งก่อนล็อกอิน
      หน้ารีวิวที่ดีควรช่วยให้ผู้อ่านตัดสินใจเองได้ มากกว่าจะเร่งให้กดสมัครภายในสามวินาที ระบบรวมหลายบริการไว้ในที่เดียวได้ก็จริง แต่ปุ่มหยุดยังต้องเป็นคนกดเองอยู่ดี
    </p>
  </ContentBox>

  <Navfoot />
</MainLayout>
