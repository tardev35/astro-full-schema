---
const reviews = [
  {
    name: "สมาชิกที่เล่นหลายหมวดในบัญชีเดียว",
    role: "สลับบาคาร่า สล็อต และฟุตบอลจากหน้าเดิม",
    stars: 5,
    tag: "บัญชีเดียวครบทุกหมวด",
    content:
      "ที่ชอบคือไม่ต้องเปลี่ยนบัญชีตามอารมณ์ครับ เช้าเช็กฟุตบอล เย็นหมุนสล็อต ค่ำไปนั่งโต๊ะบาคาร่าก็ใช้เครดิตชุดเดิม ประวัติรายการกับโปรโมชั่นอยู่ในหน้าสมาชิกเดียวกัน เลยไม่ต้องไล่หาว่าเมื่อวานเล่นอะไรไว้ตรงไหน",
    avatar: "🌊",
  },
  {
    name: "สมาชิกที่เล่นผ่านมือถือเป็นหลัก",
    role: "เปิดผ่านเบราว์เซอร์ ไม่ได้ลงโปรแกรมเพิ่ม",
    stars: 5,
    tag: "ทางเข้ารองรับทุกอุปกรณ์",
    content:
      "ใช้โทรศัพท์เครื่องเดียวตั้งแต่สมัคร เข้าสู่ระบบ เลือกหมวด ไปจนถึงเปิดเกมค่ะ เมนูสำคัญอย่างเกม โปรโมชั่น และฝากถอนอยู่ตรงที่กดถึงง่ายบนจอเล็ก อยู่บ้านสลับไปใช้คอมก็ยังเป็นบัญชีเดิม ไม่ต้องเริ่มใหม่",
    avatar: "📱",
  },
  {
    name: "สมาชิกที่ทำรายการเองทุกครั้ง",
    role: "ดูสถานะและประวัติจากหน้าสมาชิก",
    stars: 5,
    tag: "ระบบออโต้ 24 ชั่วโมง",
    content: "ผมว่างไม่ตรงกับคนอื่น บางวันเพิ่งได้เข้าหลังเที่ยงคืน ระบบออโต้เลยช่วยได้เยอะ ฝากถอนและเช็กยอดจากหน้าสมาชิกได้เอง ขั้นตอนสั้นกว่าที่คิด ทำรายการเสร็จก็กลับไปเลือกเกมต่อได้เลย",
    avatar: "🔁",
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label="เสียงจากสมาชิก ANDAMAN168" class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#ffe999] via-[#fdb524] to-[#7fe6ff] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      เสียงจากสมาชิก <span class="text-[#fdb524]">ANDAMAN168</span>
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#fdb524] to-transparent"></div>
  </div>

  <div class="mx-auto mb-8 flex max-w-md items-center justify-center gap-5 rounded-2xl border border-[#fdb524]/25 bg-[#04182f]/92 px-6 py-4 shadow-[0_10px_30px_rgba(3,19,36,0.5)] backdrop-blur-xl">
    <div class="flex flex-col items-center">
      <span class="bg-gradient-to-b from-[#ffe999] to-[#b06f00] bg-clip-text text-4xl leading-none font-black text-transparent">{average}</span>
      <span class="mt-1 text-[10px] font-bold tracking-widest text-[#dbeefb]/70 uppercase">คะแนนเฉลี่ย</span>
    </div>
    <div class="h-12 w-px bg-[#0a3a68]"></div>
    <div class="flex flex-col gap-1.5">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#fdb524]" : "text-[#0a3a68]"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#dbeefb]/70">คะแนนเฉลี่ย {average} จาก 5 ดาว จากการใช้งานจริงของสมาชิก {reviews.length} ด้าน</span>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
    {
      reviews.map((review) => (
        <article class="group relative isolate flex flex-col gap-4 overflow-hidden rounded-2xl border border-[#fdb524]/25 bg-[#04182f]/92 p-6 text-left shadow-[0_10px_30px_rgba(3,19,36,0.5)] backdrop-blur-xl transition-all duration-300 hover:-translate-y-1 hover:border-[#fdb524]/55 hover:shadow-[0_15px_40px_rgba(253,181,36,0.30)]">
          <span class="absolute inset-y-0 left-0 -z-10 w-1 bg-gradient-to-b from-[#ffe999] to-[#21d4f2] opacity-80 transition-opacity duration-300 group-hover:opacity-100" />
          <span class="pointer-events-none absolute -top-14 -right-14 -z-10 h-32 w-32 rounded-full bg-[#21d4f2]/40 blur-[50px] transition-all duration-300 group-hover:bg-[#fdb524]/25" />

          <div class="flex items-center justify-between gap-3">
            <span class="inline-flex items-center gap-1.5 rounded-full border border-[#fdb524]/25 bg-[#031324] px-3 py-1 text-[10px] font-bold tracking-widest text-[#fdb524] uppercase">
              <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#fdb524]" />
              {review.tag}
            </span>
            <span class="flex gap-0.5 text-sm">
              <span aria-hidden="true" class="flex gap-0.5">
                {Array.from({ length: 5 }).map((_, i) => (
                  <span class={i < review.stars ? "text-[#fdb524]" : "text-[#0a3a68]"}>★</span>
                ))}
              </span>
              <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
            </span>
          </div>

          <p class="text-left text-base leading-relaxed text-[#dbeefb]">{review.content}</p>

          <div class="mt-auto flex items-center gap-3 border-t border-[#0a3a68] pt-4">
            <span
              aria-hidden="true"
              class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#fdb524]/30 bg-gradient-to-br from-[#ffe999] via-[#fdb524] to-[#0a3a68] text-xl shadow-inner transition-transform duration-300 group-hover:scale-110">
              {review.avatar}
            </span>
            <span class="flex flex-col">
              <span class="text-sm font-black text-[#dbeefb] transition-colors group-hover:text-[#ffe999]">{review.name}</span>
              <span class="text-[10px] font-bold tracking-wider text-[#dbeefb]/70 uppercase">{review.role}</span>
            </span>
          </div>
        </article>
      ))
    }
  </div>
</section>
