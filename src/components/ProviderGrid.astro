---
const providers = [
  { name: "หวยออนไลน์", desc: "หวยไทย หวยลาว หวยฮานอย และหวยมาเลย์ เลือกตลาดที่ติดตามแล้วจัดโพยได้จากบัญชีเดียว", tag: "หมวดหลัก", icon: "🎫" },
  { name: "จัดโพยและตรวจผล", desc: "เลือกเลข จัดรายการไว้ในโพย ยืนยัน แล้วกลับมาเทียบกับผลรางวัลได้จากบัญชีเดิม", tag: "หมวดหลัก", icon: "📝" },
  { name: "สล็อต", desc: "หมวดเกมสำหรับสมาชิกที่อยากเปลี่ยนรูปแบบการใช้งานจากตลาดหวยเป็นบางช่วง", tag: "ทางเลือก", icon: "🎰" },
  { name: "กีฬาออนไลน์", desc: "เลือกคู่แข่งขันและรายการที่สนใจได้จากหน้าเดียว ใช้บัญชีสมาชิกชุดเดิมเข้าใช้งาน", tag: "ทางเลือก", icon: "⚽" },
  { name: "ระบบสมาชิก", desc: "รวมโพย เครดิต และประวัติรายการไว้ในพื้นที่เดียว ตรวจสอบรายการที่ส่งแล้วได้ง่าย", tag: "บัญชีเดียว", icon: "🧾" },
  { name: "ฝากถอนเครดิต", desc: "จัดการเครดิตผ่านหน้าบัญชี พร้อมตรวจสอบรายการฝากถอนและยอดที่เกี่ยวข้องจากระบบเดียว", tag: "ช่องทางหลัก", icon: "💳" },
  { name: "ใช้งานผ่านมือถือ", desc: "เลือกเลข เช็กโพย และดูผลรางวัลผ่านเบราว์เซอร์มือถือได้โดยไม่ต้องพึ่งคอม", tag: "ทุกอุปกรณ์", icon: "📱" },
];
---

<section aria-label="ตลาดหวยและบริการที่ POE888 รวมไว้ในบัญชีเดียว" class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#a8d4ff] via-[#2e8bff] to-[#5aa9ff] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      ตลาดหวยและบริการที่ <span class="text-[#ffd93d]">POE888</span> รวมไว้ในบัญชีเดียว
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#2e8bff] to-transparent"></div>
  </div>

  <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4 lg:gap-5 xl:grid-cols-7">
    {
      providers.map((provider) => (
        <a
          href="/register"
          class="group relative flex flex-col items-center justify-center overflow-hidden rounded-2xl border border-[#2e8bff]/35 bg-[#062459]/92 p-5 shadow-[0_10px_30px_rgba(2,10,30,0.6)] backdrop-blur-md transition-all duration-300 hover:-translate-y-2 hover:border-[#ffd93d]/55 hover:bg-[#083066]/95 hover:shadow-[0_15px_40px_rgba(46,139,255,0.38)]">
          <div class="pointer-events-none absolute inset-0 bg-[#0b4ea8]/45 opacity-0 transition-opacity duration-300 group-hover:opacity-100" />

          <div class="absolute top-2 right-2 z-10 rounded-full bg-gradient-to-r from-[#ffe98a] via-[#ffd93d] to-[#cd994e] px-2 py-0.5 text-[9px] font-black tracking-wide whitespace-nowrap text-[#02143a] shadow-sm transition-transform duration-300 group-hover:scale-110">
            {provider.tag}
          </div>

          <div aria-hidden="true" class="mb-3 text-4xl transition-transform duration-300 group-hover:scale-125 group-hover:rotate-3">
            {provider.icon}
          </div>
          <p class="text-center text-sm font-black text-[#dbeafe] transition-colors group-hover:text-[#ffe98a]">{provider.name}</p>
          <p class="mt-1 text-center text-[10px] text-[#b9cdf0]">{provider.desc}</p>

          <span class="relative z-10 mt-4 block w-full rounded-full border border-[#2e8bff]/30 bg-[#020a1e] py-1.5 text-center text-[11px] font-bold text-[#5aa9ff] shadow-inner transition-colors duration-300 group-hover:border-[#ffd93d]/60 group-hover:bg-gradient-to-r group-hover:from-[#ffe98a] group-hover:via-[#ffd93d] group-hover:to-[#cd994e] group-hover:text-[#02143a]">
            เข้าดูหมวดนี้
          </span>
        </a>
      ))
    }
  </div>
</section>
