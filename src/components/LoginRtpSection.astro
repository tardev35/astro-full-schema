---
import ContentBoxTwo from "./ContentBoxTwo.astro";

const steps = [
  { icon: "📝", name: "สมัครยูสเดียวใช้ได้ทุกหมวด", detail: "กรอกข้อมูลไม่กี่ช่องก็เข้าหน้าเมมเบอร์ได้ ใช้บัญชีเดิมทั้งสล็อต คาสิโนสด กีฬา และหวย", tag: "ขั้นที่ 1" },
  { icon: "💳", name: "ฝากจากเมนูเดียวในหน้าเมมเบอร์", detail: "เลือกเมนูฝาก ทำรายการตามช่องทางที่ระบบเปิดให้บริการ แล้วดูยอดเครดิตของตัวเองได้ทันที", tag: "ขั้นที่ 2" },
  { icon: "⏱️", name: "ระบบออโต้ตัดยอดและแจ้งสถานะเอง", detail: "ไม่ต้องสลับไปหลายหน้าเพื่อทำเรื่องเดียว สถานะรายการฝากถอนแสดงอยู่ในบัญชีสมาชิกของตัวเอง", tag: "ขั้นที่ 3" },
  { icon: "🎮", name: "เลือกหมวดที่อยากเล่นในวันนั้น", detail: "สล็อตจาก PG Slot, Pragmatic Play, Joker คาสิโนสด กีฬา eSports หรือหวยออนไลน์ อยู่ในเมนูเดียวกัน", tag: "ขั้นที่ 4" },
  { icon: "🕹️", name: "ลองโหมด DEMO ก่อนใช้เครดิตจริง", detail: "เกมที่รองรับทดลองเล่นเปิดดูสัญลักษณ์ ฟรีสปิน โบนัส และจังหวะเกมได้ก่อนตัดสินใจ", tag: "ขั้นที่ 5" },
];

const chips = ["บัญชีเดียวครบ", "ฝากถอนออโต้", "คาสิโนสด", "กีฬา eSports", "หวยออนไลน์", "PG Slot", "Pragmatic Play", "ทดลองเล่น DEMO"];
---

<ContentBoxTwo titleleft="เข้าสู่ระบบ AMD365" titleright="ลำดับการใช้งานตั้งแต่สมัครถึงถอนยอด" label="เข้าสู่ระบบ AMD365 และลำดับการใช้งานตั้งแต่สมัครถึงถอนยอด">
  <div slot="left" class="flex h-full flex-col gap-4">
    <div class="relative overflow-hidden rounded-2xl border border-[#a06a09]/55 bg-[#33220a] p-6 shadow-[0_10px_30px_rgba(254,201,58,0.16)]">
      <div aria-hidden="true" class="pointer-events-none absolute -top-10 -right-10 h-32 w-32 rounded-full bg-[#fec93a]/14 blur-[50px]"></div>

      <div class="relative z-10 mb-5 flex items-center gap-3">
        <span
          aria-hidden="true"
          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#ffe9a8]/55 bg-gradient-to-br from-[#ffe9a8] via-[#fec93a] to-[#a06a09] text-xl shadow-inner">
          🎲
        </span>
        <div class="flex flex-col">
          <p class="text-base font-black text-[#ffe9a8]">ล็อกอินแล้วเลือกหมวดที่อยากเล่นต่อได้ทันที</p>
          <span class="text-[11px] text-[#cdbb93]">
            บัญชีเดียวเข้าได้ทั้งสล็อต คาสิโนสด กีฬา eSports และหวยออนไลน์ ยอดฝากถอนเดินผ่านระบบออโต้ชุดเดียวกัน เช็กเครดิต ดูโปรโมชั่น และย้อนดูประวัติรายการได้จากหน้าเมมเบอร์
          </span>
        </div>
      </div>

      <div class="relative z-10 flex flex-col gap-3.5">
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#fec93a]">👤</span>
          <input
            type="text"
            placeholder="เบอร์โทรศัพท์ / ยูสเซอร์เนม"
            class="w-full rounded-xl border border-[#a06a09]/60 bg-[#160e03] py-3 pr-4 pl-12 text-[#f4e8d2] transition-all outline-none placeholder:text-[#cdbb93] focus:border-[#fec93a] focus:ring-1 focus:ring-[#fec93a]/40"
          />
        </div>
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#fec93a]">🔑</span>
          <input
            type="password"
            placeholder="รหัส PIN 4 หลัก"
            class="w-full rounded-xl border border-[#a06a09]/60 bg-[#160e03] py-3 pr-4 pl-12 text-[#f4e8d2] transition-all outline-none placeholder:text-[#cdbb93] focus:border-[#fec93a] focus:ring-1 focus:ring-[#fec93a]/40"
          />
        </div>

        <div class="flex items-center justify-between px-1 text-xs">
          <label class="flex items-center gap-2 text-[#cdbb93]">
            <input type="checkbox" class="h-3.5 w-3.5 rounded border-[#a06a09]/60 bg-[#160e03] accent-[#fec93a]" />
            จดจำฉันไว้
          </label>
          <a href="/login" class="text-[#cdbb93] transition-colors hover:text-[#ffe9a8]">ลืมรหัส PIN?</a>
        </div>

        <button
          class="mt-1 w-full rounded-xl border border-[#ffe9a8]/50 bg-gradient-to-r from-[#ffe9a8] via-[#fec93a] to-[#d4840e] p-3.5 font-black text-[#160e03] shadow-[0_10px_30px_rgba(254,201,58,0.28)] transition-all hover:scale-[1.02] hover:shadow-[0_15px_40px_rgba(254,201,58,0.38)]">
          เข้าสู่ระบบ
        </button>

        <div class="flex items-center gap-3 py-1 text-[11px] text-[#cdbb93]">
          <span class="h-px flex-1 bg-[#a06a09]/55"></span>
          หรือ
          <span class="h-px flex-1 bg-[#a06a09]/55"></span>
        </div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] p-3 text-sm font-bold text-white shadow-md transition-all hover:scale-[1.02]">
          <span aria-hidden="true">💬</span> ทักไลน์ทีมงานตลอด 24 ชั่วโมง
        </a>

        <div class="mt-1 flex items-center justify-between px-1">
          <div class="flex gap-2">
            <span class="rounded-full border border-[#a06a09]/60 bg-[#221703] px-2.5 py-1 text-[10px] font-bold text-[#ffe9a8]"><span aria-hidden="true">🔒</span> เข้ารหัสข้อมูล</span>
            <span class="rounded-full border border-[#c9ccd4]/55 bg-[#2b1d05] px-2.5 py-1 text-[10px] font-bold text-[#e6e8ee]"><span aria-hidden="true">🕐</span> ใช้งานได้ตลอด 24 ชม.</span>
          </div>
          <a href="/register" class="text-xs font-bold text-[#cdbb93] transition-colors hover:text-[#ffe9a8]">สมัครสมาชิกใหม่</a>
        </div>
      </div>
    </div>
  </div>

  <div slot="right" class="h-full">
    <div class="flex h-full flex-col rounded-2xl border border-[#a06a09]/55 bg-[#33220a] p-5 shadow-[0_10px_30px_rgba(254,201,58,0.16)]">
      <div class="mb-5 flex items-center justify-between gap-3">
        <div>
          <span class="text-xs font-bold tracking-wide text-[#cdbb93]">ลำดับการใช้งานที่ AMD365 วางไว้ ตั้งแต่สมัครยูสจนถอนยอดออก อยู่ในระบบออโต้ชุดเดียวกันทั้งหมด</span>
          <div class="bg-gradient-to-r from-[#ffe9a8] via-[#fec93a] to-[#d4840e] bg-clip-text text-2xl font-black text-transparent sm:text-3xl">สมัคร • ฝาก • เล่น • ถอน</div>
        </div>
        <span class="flex items-center gap-1.5 self-start rounded-full border border-[#c9ccd4]/55 bg-[#2b1d05] px-2.5 py-1">
          <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#c9ccd4] shadow-[0_0_8px_rgba(201,204,212,0.7)]"></span>
          <span class="text-[10px] font-bold tracking-widest text-[#e6e8ee] uppercase">Live</span>
        </span>
      </div>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#cdbb93] uppercase">
        <span>ขั้นตอนการใช้งาน</span>
        <span>ลำดับ</span>
      </div>

      <div class="flex flex-1 flex-col gap-2.5">
        {
          steps.map((s) => (
            <div class="rounded-xl border border-[#a06a09]/45 bg-[#221703] px-3.5 py-2.5 transition-colors hover:border-[#fec93a]/65 hover:bg-[#3c2606]">
              <div class="flex items-center justify-between gap-2 text-sm">
                <span class="flex min-w-0 items-center gap-2 font-bold text-[#f4e8d2]">
                  <span aria-hidden="true" class="w-5 shrink-0 text-center">
                    {s.icon}
                  </span>{" "}
                  <span class="truncate">{s.name}</span>
                </span>
                <span class="shrink-0 rounded-full border border-[#c9ccd4]/55 bg-[#2b1d05] px-2.5 py-0.5 text-[10px] font-bold text-[#e6e8ee]">{s.tag}</span>
              </div>
              <div class="mt-1.5 text-[11px] tracking-wide text-[#cdbb93]">{s.detail}</div>
            </div>
          ))
        }
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
        {chips.map((c) => <span class="rounded-full border border-[#a06a09]/45 bg-[#221703] px-3 py-1 text-[10px] font-bold text-[#ffe9a8]">{c}</span>)}
      </div>

      <div class="mt-3 text-center text-[10px] tracking-wide text-[#cdbb93]">
        ลำดับในตารางสรุปจากที่หน้าเว็บแสดงไว้ รายละเอียดของค่ายเกม เงื่อนไขเครดิต และรายการที่เปิดให้บริการจริงให้ยึดตามหน้าเมมเบอร์ของ AMD365 ก่อนทำรายการทุกครั้ง และอย่าบอกรหัสผ่านหรือ OTP กับใคร
        หากติดขัดตรงไหนทักไลน์ทีมงานได้ตลอด 24 ชั่วโมง
      </div>
    </div>
  </div>
</ContentBoxTwo>
