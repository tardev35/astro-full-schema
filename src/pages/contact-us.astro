---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxPremium.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement2.astro";

import { Picture } from "astro:assets";
import imgLine from "../assets/contact-line.webp";
import { pageGraph } from "../lib/schema";
import { BRAND_ADDRESS } from "../lib/brandProfile";

const pageDescription =
  "ช่องทางติดต่อทีมงาน WINNOW168 เว็บตรงรวมบาคาร่า สล็อต คาสิโนสด และกีฬา แจ้งปัญหาสมัครสมาชิก เข้าสู่ระบบ และฝากถอนออโต้ผ่าน LINE Official ได้ตลอด 24 ชั่วโมง";

const graph = pageGraph(Astro, {
  type: "ContactPage",
  name: "ติดต่อทีมงาน WINNOW168 ผ่าน LINE Official",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ติดต่อเรา", path: "/contact-us" },
  ],
  org: {
    alternateName: "WINNOW168 เว็บตรงรวมบาคาร่า สล็อต คาสิโน กีฬา เล่นผ่านมือถือได้ในบัญชีเดียว",
    contactPoints: [
      {
        contactType: "customer service",
        availableLanguage: ["Thai", "English"],
        path: "/line",
        description: "ติดต่อแอดมินผ่าน LINE Official",
      },
    ],
  },
});
---

<MainLayout title="ติดต่อ WINNOW168 | ทีมงานตอบไวผ่าน LINE Official 24 ชม." description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="ติดต่อทีมงาน WINNOW168" as="h1">
    <Picture
      src={imgLine}
      alt="พนักงานหญิงชุดเลื่อมสีชมพูยิ้มกอดอก ยืนอยู่ข้างปุ่มสีขาวที่มีโลโก้ LINE สีเขียวและคำว่า Support"
      loading="lazy"
      fetchpriority="low"
      widths={[200, 400, 600]}
      sizes="(max-width: 768px) 100vw"
      class="mx-auto h-auto w-full max-w-[400px] object-contain shadow-[0_10px_30px_rgba(224,30,38,0.16)]"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={60}
    />
    {
      BRAND_ADDRESS.lines.length > 0 && (
        <address aria-label={BRAND_ADDRESS.label} class="mt-8 mb-8 border-l-4 border-[#e01e26] pl-6 text-left text-base leading-relaxed text-[#f2dede] not-italic">
          <p class="mb-1 font-bold text-[#f5c542]">{BRAND_ADDRESS.label}</p>
          {BRAND_ADDRESS.lines.map((line) => (
            <span class="block">{line}</span>
          ))}
          {BRAND_ADDRESS.email && (
            <span class="mt-3 block">
              <span aria-hidden="true" class="mr-2">
                ✉️
              </span>
              <a href={`mailto:${BRAND_ADDRESS.email}`} class="font-bold text-[#f5c542] underline decoration-[#e01e26]/60 underline-offset-4 transition-colors hover:text-[#ffdf8a]">
                {BRAND_ADDRESS.email}
              </a>
            </span>
          )}
        </address>
      )
    }

    <div class="flex flex-wrap justify-center gap-4">
      <a
        href="/register"
        aria-label="สมัครสมาชิก"
        class="flex items-center justify-center rounded-lg border border-[#e01e26]/60 bg-gradient-to-b from-[#ff5a5f] via-[#e01e26] to-[#a20d12] px-8 py-3 font-bold text-[#1a0202] shadow-[0_10px_30px_rgba(224,30,38,0.24)] transition-transform hover:scale-105 hover:shadow-[0_15px_40px_rgba(224,30,38,0.4)]">
        สมัครสมาชิก
      </a>

      <a
        href="/login"
        aria-label="เข้าสู่ระบบ"
        class="flex items-center justify-center rounded-lg border border-[#f5c542]/60 bg-[#210a08] px-8 py-3 font-extrabold text-[#f5c542] shadow-[0_4px_14px_rgba(245,197,66,0.24)] transition-transform hover:scale-105 hover:bg-[#170707]">
        เข้าสู่ระบบ
      </a>

      <a
        href="/line"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="ติดต่อทีมงานผ่าน Line Official"
        class="flex items-center justify-center rounded-lg border border-green-300 bg-gradient-to-b from-green-400 to-green-700 px-8 py-3 font-bold text-white transition-transform hover:scale-105">
        ติดต่อผ่าน Line Official
      </a>
    </div>
  </ContentBox>
  <Navfoot />
</MainLayout>
