---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "./components/ContentBox.astro";
import ContentBoxTwo from "./components/ContentBoxTwo.astro";
import ContentBoxSevenThree from "./components/ContentBoxSevenThree.astro";
import ContentBoxThreeColums from "./components/ContentBox3Three.astro";
import Navfoot from "./components/Navfoot.astro";
import Footer from "./components/Footer.astro";
import Footer2 from "./components/FooterStyle2.astro";
import Announcement from "./components/Announcement.astro";
import SmoothCarousel from "./components/SmoothCarousel.astro";

import { Picture } from "astro:assets";
import image1 from "../assets/pro1.jpg";
import image2 from "../assets/pro2.jpg";
import image3 from "../assets/pro3.jpg";
import image4 from "../assets/pro4.jpg";

const currentPath = Astro.url.pathname;
const homePage = Astro.url.origin;
const logoUrl = homePage + "/logo.webp";

const webPageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: "KINGDOM66 ทางเข้าเว็บคาสิโนสด อันดับ 1 เว็บตรง พรีเมียม ระบบออโต้",
  description: "KINGDOM66 ทางเข้าเว็บคาสิโนสด อันดับ 1 อัปเดตล่าสุด เว็บตรง มีเกมคาสิโนโลก ครบทุกค่าย เล่นลื่น บริการระดับพรีเมียม ระบบออโต้ ฝากถอน ฉับไว",
  url: currentPath,
};

const orgSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "KINGDOM66",
  logo: logoUrl,
  url: homePage,
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: "KINGDOM66 คืออะไร และเป็นเว็บคาสิโนออนไลน์ แบบไหน?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "KINGDOM66 คือเว็บคาสิโนออนไลน์ เต็มรูปแบบที่ให้บริการครบวงจร ทั้งสล็อต คาสิโนสด และเกมเดิมพันยอดนิยม โดยไม่ผ่านเอเย่นต์ สมาชิกทุกท่านสามารถเข้าถึงระบบและเกมโดยตรงจากค่ายเกมคาสิโนชั้นนำ เป็นเว็บที่เข้าถึงง่าย ปลอดภัยมาก และมีมาตรฐานการให้บริการที่ชัดเจน",
      },
    },
    {
      "@type": "Question",
      name: "KINGDOM66 ทางเข้าเว็บคาสิโนสด อัปเดตล่าสุด เข้าใช้งานอย่างไร",
      acceptedAnswer: {
        "@type": "Answer",
        text: "วิธีเข้าใช้งานที่ถูกต้องเพื่อป้องกันปัญหาลิงก์เสียหรือเว็บปลอม คือเลือกใช้ลิงก์ทางเข้าอัปเดตล่าสุด จากนั้นเข้าสู่หน้าเว็บไซต์หลักและกดเข้าสู่ระบบ หรือสมัครสมาชิกก่อนเริ่มเล่น ระบบรองรับทั้งบนมือถือและคอมพิวเตอร์ ทำให้เข้าเล่นได้อย่างปลอดภัย",
      },
    },
    {
      "@type": "Question",
      name: "KINGDOM66 เว็บตรง มีเกมคาสิโน อะไรให้เล่นบ้าง?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "สมาชิกสามารถใช้บัญชีเดียวเพื่อเข้าเล่นได้ทุกเกม ไม่ว่าจะเป็นคาสิโนสดแบบเรียลไทม์ บาคาร่าเล่นกับคนจริงๆ สล็อตจากค่ายมาตรฐานระดับโลก เกมยิงปลา และเดิมพันกีฬา สามารถเลือกเล่น สลับเกม หรือเปลี่ยนแนวการเดิมพันได้ทันทีโดยไม่ต้องสมัครหลายบัญชี",
      },
    },
    {
      "@type": "Question",
      name: "บริการระดับพรีเมียมของ KINGDOM66 แตกต่างจากเว็บทั่วไป มากแค่ไหน",
      acceptedAnswer: {
        "@type": "Answer",
        text: "ความพรีเมียมของเราวัดกันที่คุณภาพที่สัมผัสได้จริง เริ่มจากคาสิโนสด Full HD สตรีมมิ่งลื่นไหล ระบบกระเป๋าเดียว (Seamless Wallet) สลับเล่นได้ทุกค่ายทันทีไม่ต้องกดโยกเงิน และระบบฝากถอนออโต้ที่เงินเข้าบัญชีใน 5 วินาที ตอบโจทย์ผู้เล่นระดับมืออาชีพ",
      },
    },
    {
      "@type": "Question",
      name: "ระบบออโต้ ฝากถอน ฉับไว ช่วยผู้เล่นได้อย่างไร",
      acceptedAnswer: {
        "@type": "Answer",
        text: "ระบบออโต้เต็มรูปแบบช่วยให้สมาชิกทำรายการฝากถอนได้ด้วยตัวเองตลอด 24 ชั่วโมง ไม่ต้องรอแอดมินหรือส่งสลิป ทุกธุรกรรมใช้เวลาเพียงไม่กี่วินาที เงินเข้า-ออกไว ทำให้สามารถเดิมพันต่อได้ทันทีโดยไม่เสียจังหวะ เหมาะกับสายทำกำไรที่ต้องการความรวดเร็ว",
      },
    },
  ],
};

const allSchemas = [webPageSchema, orgSchema, faqSchema];
---

<MainLayout>
  <script type="application/ld+json" set:html={JSON.stringify(allSchemas)} />
  <Announcement />

  <ContentBox>
    <p class="text-gray-200">
      <h1 class="mb-2 text-2xl text-white xl:text-4xl">KINGDOM66 ทางเข้าเว็บคาสิโนสด อันดับ 1 เว็บตรง พรีเมียม ระบบออโต้</h1>
      <strong class="text-yellow-400">KINGDOM66 ทางเข้าเว็บคาสิโนสด อันดับ 1 อัปเดตล่าสุด</strong> ที่พร้อมเปิดประตูต้อนรับนักลงทุนทุกท่านสู่ประสบการณ์ทำกำไรที่สมบูรณ์แบบที่สุด ในฐานะ <strong
        class="text-yellow-400">
        เว็บตรง
      </strong> มาตรฐานสากลที่ไม่ผ่านเอเย่นต์ เราได้รวบรวมศูนย์รวมความบันเทิงที่ มีเกมคาสิโนโลก ครบทุกค่าย แบรนด์ดังระดับแนวหน้ามาเสิร์ฟให้คุณถึงหน้าจอ บริการระดับพรีเมียม ที่ดูแลสมาชิกทุกท่านดุจลูกค้า
      VIP และตัดทุกความยุ่งยากทิ้งไปด้วย ระบบออโต้ ฝากถอน ฉับไว ให้คุณจัดการเงินรางวัลเข้าบัญชีได้เองภายในไม่กี่วินาที <strong class="text-yellow-400">KINGDOM66</strong> ที่นี่คือจุดเริ่มต้นที่จะเปลี่ยนแปลง
      เว็บมาตราฐานใหม่ของการเดิมพัน
    </p>

    <div class="mt-3.5 flex flex-wrap justify-center gap-4">
      <a
        href="/signup"
        aria-label="สมัครสมาชิก"
        class="to-red to-red to-red flex items-center justify-center rounded-lg border border-gray-400 bg-gradient-to-b from-red-900 to-red-700 px-8 py-3 font-bold text-white transition-transform hover:scale-105">
        สมัครสมาชิก
      </a>

      <a
        href="/signup"
        aria-label="เข้าเล่นเกม"
        class="flex items-center justify-center rounded-lg border border-yellow-600 bg-gradient-to-b from-yellow-200 to-yellow-500 px-8 py-3 font-extrabold text-black shadow-[0_0_15px_rgba(255,215,0,0.4)] transition-transform hover:scale-105">
        เข้าเล่นเกม
      </a>

      <a
        href="/line"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="ติดต่อเราผ่าน Line"
        class="flex items-center justify-center rounded-lg border border-green-300 bg-gradient-to-b from-green-400 to-green-700 px-8 py-3 font-bold text-white transition-transform hover:scale-105">
        ติดต่อเรา
      </a>
    </div>
  </ContentBox>
  <ContentBoxThreeColums>
    <div slot="left">
      <div class="p-1">
        <Picture
          src={image1}
          alt="mahagame66 คาสิโนเว็บตรง"
          loading="lazy"
          fetchpriority="low"
          widths={[200, 400, 600]}
          sizes="(max-width: 768px) 100vw, 33vw"
          class="mx-auto h-auto w-full max-w-[700px] object-contain shadow-xl"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={60}
        />
      </div>
    </div>

    <div slot="center">
      <div class="p-1">
        <Picture
          src={image2}
          alt="mahagame66 2026"
          loading="lazy"
          fetchpriority="low"
          widths={[200, 400, 600]}
          sizes="(max-width: 768px) 100vw, 33vw"
          class="mx-auto h-auto w-full max-w-[700px] object-contain shadow-xl"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={60}
        />
      </div>
    </div>

    <div slot="right">
      <div class="p-1">
        <Picture
          src={image3}
          alt="mahagame66 เกมAPIแท้"
          loading="lazy"
          fetchpriority="low"
          widths={[200, 400, 600]}
          sizes="(max-width: 768px) 100vw, 33vw"
          class="mx-auto h-auto w-full max-w-[700px] object-contain shadow-xl"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={60}
        />
      </div>
    </div>
    <div slot="right2">
      <div class="p-1">
        <Picture
          src={image4}
          alt="mahagame66 แตกง่าย"
          loading="lazy"
          fetchpriority="low"
          widths={[200, 400, 600]}
          sizes="(max-width: 768px) 100vw, 33vw"
          class="mx-auto h-auto w-full max-w-[700px] object-contain shadow-xl"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={60}
        />
      </div>
    </div>
  </ContentBoxThreeColums>

  <ContentBox>
    <h2 class="mb-4 text-2xl font-bold">KINGDOM66 คืออะไร และเป็นเว็บคาสิโนออนไลน์ แบบไหน</h2>
    <p>
      <strong>KINGDOM66</strong> คือเว็บคาสิโนออนไลน์ เต็มรูปแบบที่ให้บริการครบวงจร ทั้งสล็อต คาสิโนสด และเกมเดิมพันยอดนิยม โดยไม่ผ่านเอเย่นต์ สมาชิกทุกท่าน สามารถเข้าถึงระบบและเกมโดยตรงจากค่ายเกมคาสิโนชั้นนำ
      KINGDOM66 เป็นเว็บที่เข้าถึงง่าย ปลอดภัยมาก และมีมาตรฐานการให้บริการที่ชัดเจน เหมาะกับทั้งผู้ทุกระดับ
    </p>
  </ContentBox>
  <SmoothCarousel />
  <ContentBoxTwo>
    <div slot="left">
      <h2 class="mb-7 text-2xl font-semibold text-amber-500">MAHAGAME66 คือเว็บให้บริการกับผู้เล่น คาสิโนเว็บตรง</h2>
      <p>
        MAHAGAME66 คือเว็บคาสิโนเว็บตรงที่ให้บริการครบทุกด้านในแพลตฟอร์มเดียว ไม่ว่าจะเป็นสล็อต คาสิโนสด หรือเกมเดิมพันยอดนิยม จุดเด่นคือไม่ผ่านเอเย่นต์ ทำให้ระบบมีความเสถียร
        ผู้เล่นสามารถเข้าถึงเกมได้โดยตรงจากผู้ให้บริการที่ถูกต้อง <strong>MAHAGAME66</strong> เว็บใหญ่ คาสิโนออนไลน์ รองรับทั้งสายเล่นสนุกหรือสายเล่นแบบจริงจัง ต้องการการบริการแบบมืออาชีพ แบบมาตรฐานเว็บตรงมีใบเซอร์
      </p>
    </div>

    <div slot="right">
      <h2 class="mb-7 text-2xl font-semibold text-amber-500">KINGDOM66 ทางเข้าเว็บคาสิโนสด อัปเดตล่าสุด เข้าใช้งานอย่างไร</h2>
      <p>
        ปัจจุบันมีเว็บเลียนแบบ <strong>KINGDOM66</strong> จำนวนมาก ทำมให้หลายคนคงเคยเจอ ปัญหาลิงก์เสียหรือเว็บปลอม ดังนั้น การเลือกใช้ลิงก์ที่ถูกต้องจะช่วยป้องกันความเสี่ยงทั้งด้านข้อมูลและการเงิน ดังนั้น
        วิธีเข้าใช้งาน KINGDOM66 ที่ถูกต้อง คือเลือกใช้ลิงก์ทางเข้า อัปเดตล่าสุด จากนั้นเข้าสู่หน้าเว็บไซต์หลักและกดเข้าสู่ระบบ หรือสมัครสมาชิกก่อนเริ่มเล่น ระบบรองรับทั้งมือถือและคอมพิวเตอร์ ทำให้สามารถเข้าเล่นได้ทันทีโดยอย่างปลอดภัย
      </p>
    </div>
  </ContentBoxTwo>

  <ContentBox>
    <h2 class="mb-7 text-2xl font-semibold text-amber-500">KINGDOM66 เว็บตรง มีเกมคาสิโน อะไรให้เล่นบ้าง</h2>
    <p>
      ภายในเกม KINGDOM66 สมาชิกสามารถเข้าเล่นได้ทุกเกม (ย้ำว่าทุกเกม) มาลองเล่นได้เลย บัญชีสมาชิกเดียว ไม่ว่าจะเป็นคาสิโนสดแบบเรียลไทม์ สล็อตจากค่ายมาตราฐานระดับโลก บาคาร่าเล่นกับคนขริงๆ ไม่มีบอท
      หรือเกมไพ่ และเดิมพันกีฬาอื่นๆ ที่ได้รับความนิยม ไม่ต้องสมัครหลายบัญชีเพื่อเล่นเกมที่ต่างประเภทกัน สามารถเลือกเล่น สลับเกม หรือเปลี่ยนแนวการเดิมพันได้ทันที
      ช่วยให้การใช้งานสะดวกและต่อเนื่องมากขึ้น โดยเฉพาะสำหรับคนที่ต้องการเดิมพันหลายรูปแบบในเวลาเดียวกัน
    </p>
  </ContentBox>

  <ContentBoxTwo>
    <div slot="left">
      <h3 class="mb-7 text-2xl font-semibold text-amber-500">สล็อต KINGDOM66 รวมเกมยอดนิยม แตกง่ายจากหลายค่าย</h3>
      <p>
        สล็อตของ KINGDOM66 รวบรวมเกมจากหลายค่ายชั้นนำมาไว้ในระบบเดียว ไม่ว่าจะเป็นเกมแนวโบนัส ฟรีสปิน หรือแจ็คพอต ผู้เล่นสามารถเลือกเล่นได้ตามสไตล์ จุดเด่นคือระบบโหลดไว เล่นลื่น และมีตัวเลือกจำนวนมาก
        เหมาะทั้งสายปั่นทั่วไปและสายทำกำไรที่ต้องการจังหวะเกมที่ต่อเนื่อง
      </p>
    </div>

    <div slot="right">
      <h3 class="mb-7 text-2xl font-semibold text-amber-500">บาคาร่า KINGDOM66 คาสิโนสด เล่นเรียลไทม์ ลื่นทุกจังหวะ</h3>
      <p>
        สำหรับสายคาสิโนสด KINGDOM66 มีบริการบาคาร่าและเกมโต๊ะอื่น ๆ แบบเรียลไทม์ ที่เชื่อมต่อกับผู้ให้บริการโดยตรง ทำให้ภาพคมชัด ไม่มีดีเลย์ และเล่นได้อย่างต่อเนื่อง
        ผู้เล่นสามารถสัมผัสบรรยากาศเหมือนอยู่ในคาสิโนจริง พร้อมควบคุมจังหวะการเดิมพันได้อย่างมั่นใจ
      </p>
    </div>
  </ContentBoxTwo>

  <ContentBoxTwo>
    <div slot="left">
      <h3 class="mb-7 text-2xl font-semibold text-amber-500">ยิงปลา KINGDOM66 เล่นง่าย ได้ไว เพิ่มทางเลือกในการทำกำไร</h3>
      <p>
        เกมยิงปลาใน KINGDOM66 เป็นอีกหนึ่งตัวเลือกที่ช่วยเพิ่มความหลากหลายในการเล่น เหมาะสำหรับผู้เล่นที่ต้องการเกมที่เข้าใจง่าย เล่นสนุก และมีโอกาสทำกำไรได้ในเวลาไม่นาน ด้วยระบบที่ลื่นและตอบสนองเร็ว
        ทำให้สามารถเล่นได้ต่อเนื่องโดยไม่สะดุด
      </p>
    </div>

    <div slot="right">
      <h3 class="mb-7 text-2xl font-semibold text-amber-500">กีฬา KINGDOM66 รองรับการเดิมพันครบทุกลีกยอดนิยม</h3>
      <p>
        KINGDOM66 ยังรองรับการเดิมพันกีฬาในหลากหลายรายการ ไม่ว่าจะเป็นฟุตบอลหรือกีฬายอดนิยมอื่น ๆ ผู้เล่นสามารถเลือกเดิมพันได้ตามความถนัด พร้อมระบบที่อัปเดตข้อมูลแบบรวดเร็ว
        ทำให้วางเดิมพันได้ทันเหตุการณ์ เหมาะสำหรับสายวิเคราะห์และสายตามกระแส
      </p>
    </div>
  </ContentBoxTwo>

  <ContentBoxSevenThree>
    <div slot="left">
      <div class="rounded-xl p-5">
        <Picture
          src={image1}
          alt="ทางเข้า kingdom66 ล่าสุด"
          loading="lazy"
          fetchpriority="low"
