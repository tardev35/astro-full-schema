---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import ContentBoxTwo from "../components/ContentBoxTwo.astro";
import ContentBoxSevenThree from "../components/ContentBoxSevenThree.astro";
import ContentBoxThreeColums from "../components/ContentBox3Three.astro";
import ContentBoxSpecial from "../components/ContentBoxSpecial.astro";
import Announcement from "../components/Announcement6.astro";
import ProviderGrid from "../components/ProviderGrid.astro";
import LatestWinners from "../components/LatestWinnersPremium.astro";
import SmoothCarousel from "../components/SmoothCarousel.astro";
import ReviewCardSumo from "../components/ReviewCardSumo.astro";
import Navfoot from "../components/Navfoot.astro";
import Faq from "../components/FaqHuay.astro";
const currentPath = Astro.url.pathname;
const homePage = Astro.url.origin;
const logoUrl = homePage + "/logo.webp";

const webPageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: "SUMOHENG ทางเข้าหลัก สล็อตแท้ ฝากถอนออโต้ จ่ายจริง เฮงทุกสปิน",
  description: "SUMOHENG ทางเข้าหลัก เว็บไซต์ทางการ ให้บริการสล็อตแท้ ฝากถอนออโต้ จ่ายจริง สมัครง่าย พร้อมโปรโมชั่นและผลทดสอบการใช้งาน เฮงทุกสปิน",
  url: currentPath,
};
const webSiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "SUMOHENG",
  alternateName: ["SUMOHENG", "SUMOHENG สล็อตออนไลน์"],
  url: "https://sumoheng-brand.com/",
};
const orgSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "SUMOHENG",
  logo: logoUrl,
  url: homePage,
};
const allSchemas = [webPageSchema, orgSchema, webSiteSchema];

import { Picture } from "astro:assets";
import image1 from "../assets/slide1.png";
import image2 from "../assets/banner1.webp";
---

<MainLayout>
  <script type="application/ld+json" set:html={JSON.stringify(allSchemas)} />

  <Announcement />
  <div class="mx-auto w-full max-w-5xl px-4 py-8 text-center">
    <p class="text-4xl leading-tight font-black text-[#470000] drop-shadow-sm md:text-5xl">
      SUMOHENG <br />
      <span class="text-[#ffdb0e]">เว็บใหญ่ ใจปล้ำ</span>
    </p>
  </div>
  <ContentBox title="SUMOHENG ทางเข้าหลัก สล็อตแท้ ฝากถอนออโต้ จ่ายจริง เฮงทุกสปิน">
    <p class="leading-relaxed">
      <strong class="text-amber-400">SUMOHENG</strong> คือเว็บไซต์ทางเข้าหลักที่รวบรวมบริการสล็อตแท้จากค่ายเกมชั้นนำ พร้อมระบบฝากถอนออโต้ที่ให้ความสำคัญกับความถูกต้องของทุกธุรกรรมและการจ่ายจริง เพื่อให้สมาชิกใช้งานได้อย่างมั่นใจ
      ภายใต้แนวคิด "เฮงทุกสปิน" ที่สะท้อนตัวตนของแบรนด์ในทุกประสบการณ์การใช้งาน
    </p>

    <div class="mt-8 flex flex-wrap justify-center gap-6">
      <a
        href="/login"
        class="group relative flex items-center justify-center rounded-full border border-red-500/50 bg-[#450a0a]/80 px-10 py-3.5 font-black text-yellow-500 backdrop-blur-sm transition-all duration-300 hover:scale-105 hover:bg-red-900/60 hover:shadow-[0_0_15px_rgba(220,38,38,0.4)]">
        เข้าระบบเกม
      </a>

      <a
        href="/register"
        class="group relative flex items-center justify-center rounded-full bg-gradient-to-r from-yellow-500 via-yellow-400 to-yellow-500 px-10 py-3.5 font-black text-[#450a0a] shadow-[0_5px_20px_rgba(251,191,36,0.4)] transition-all duration-300 hover:-translate-y-1 hover:scale-105 hover:shadow-[0_8px_25px_rgba(251,191,36,0.6)]">
        สมัครสมาชิก
      </a>
    </div>
  </ContentBox>

  <ContentBoxTwo titleleft="ทางเข้า SUMOHENG" titleright="JACKPOT แตกพาร์ทเนอร์">
    <div slot="left" class="flex flex-col gap-4">
      <div class="rounded-2xl border border-red-500/30 bg-white/5 p-6 shadow-[0_0_20px_rgba(220,38,38,0.1)] backdrop-blur-md">
        <div class="flex flex-col gap-4">
          <div class="relative">
            <span class="absolute top-3.5 left-4 text-red-500">👤</span>
            <input
              type="text"
              placeholder="ยูสเซอร์เนม / เบอร์โทรศัพท์"
              class="w-full rounded-full border border-red-500/50 bg-black/60 py-3 pr-4 pl-12 text-white transition-all outline-none focus:border-yellow-400 focus:ring-1 focus:ring-yellow-400/50"
            />
          </div>
          <div class="relative">
            <span class="absolute top-3.5 left-4 text-red-500">🔑</span>
            <input
              type="password"
              placeholder="รหัสผ่าน"
              class="w-full rounded-full border border-red-500/50 bg-black/60 py-3 pr-4 pl-12 text-white transition-all outline-none focus:border-yellow-400 focus:ring-1 focus:ring-yellow-400/50"
            />
          </div>
          <button
            class="mt-2 w-full rounded-full border border-red-400/50 bg-gradient-to-r from-red-600 to-red-700 p-3.5 font-black text-white shadow-[0_5px_15px_rgba(220,38,38,0.5)] transition-all hover:scale-[1.02] hover:shadow-[0_8px_25px_rgba(220,38,38,0.7)]">
            เข้าสู่ระบบ
          </button>
          <div class="mt-2 flex items-center justify-between px-2 text-sm">
            <a href="#" class="text-gray-400 transition-colors hover:text-white">ลืมรหัสผ่าน?</a>
            <a href="/register" class="animate-pulse font-bold text-yellow-400 transition-colors hover:text-yellow-300">สมัครสมาชิกใหม่</a>
          </div>
        </div>
      </div>
    </div>
    <div slot="right">
      <div class="flex h-full flex-col justify-center rounded-2xl border border-red-500/30 bg-gradient-to-br from-red-900/40 to-black/60 p-5 backdrop-blur-md">
        <div class="mb-4 text-center">
          <span class="text-sm font-bold text-gray-300">แจ็คพอตรวม (THB)</span>
          <div class="bg-gradient-to-r from-yellow-300 via-yellow-400 to-yellow-500 bg-clip-text text-4xl font-black text-transparent drop-shadow-[0_2px_10px_rgba(250,204,21,0.4)]">8,459,230.50</div>
        </div>
        <table class="mt-2 w-full text-sm">
          <thead>
            <tr class="border-b border-red-500/30 text-red-400">
              <th class="py-2 pl-2 text-left">ค่ายเกม</th>
              <th class="py-2 pr-2 text-right">RTP</th>
            </tr>
          </thead>
          <tbody class="text-white">
            <tr class="border-b border-white/5 transition-colors hover:bg-white/10">
              <td class="flex items-center gap-2 py-3 pl-2 font-bold"><span class="h-2 w-2 animate-ping rounded-full bg-green-500"></span> PG Soft</td><td
                class="pr-2 text-right font-black text-green-400">
                98.5%
              </td>
            </tr>
            <tr class="border-b border-white/5 transition-colors hover:bg-white/10">
              <td class="flex items-center gap-2 py-3 pl-2 font-bold"><span class="h-2 w-2 rounded-full bg-green-500"></span> Joker Gaming</td><td class="pr-2 text-right font-black text-green-400">
                97.2%
              </td>
            </tr>
            <tr class="transition-colors hover:bg-white/10">
              <td class="flex items-center gap-2 py-3 pl-2 font-bold"><span class="h-2 w-2 rounded-full bg-green-500"></span> Pragmatic Play</td><td class="pr-2 text-right font-black text-green-400">
                96.8%
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </ContentBoxTwo>

  <LatestWinners />

  <ContentBoxThreeColums titleleft="รวมครบจบในที่เดียว" titlecenter="RTP สูง แตกง่าย" titleright="ฝาก-ถอน ระบบออโต้">
    <div slot="left">สล็อตทุกค่าย คาสิโน กีฬา หวย มีครบจบที่ SUMOHENG เว็บตรงไม่ผ่านเอเย่นต์ มั่นคง ปลอดภัย มาตรฐานระดับสากล</div>
    <div slot="center">เกมสล็อตคุณภาพ คัดสรรมาอย่างดี อัตราการชนะ (RTP) สูง โบนัสจัดเต็ม โปรแรงแจกหนักทุกวัน แจ็คพอตแตกง่ายสุดๆ</div>
    <div slot="right">ทำรายการรวดเร็วทันใจด้วยระบบออโต้ 100% รองรับทุกธนาคารและทรูมันนี่วอเลท เงินเข้าไวภายใน 5 วินาที</div>
  </ContentBoxThreeColums>
  <ProviderGrid />
  <ContentBox>
    <h2 class="mb-4 text-3xl font-black tracking-[0.2em] text-amber-400 uppercase drop-shadow-[0_0_10px_rgba(0,0,0,0.05)]">SUMOHENG ทางเข้าหลัก เว็บไซต์ทางการ พร้อมลิงก์เข้าใช้งานที่ถูกต้อง</h2>
    <p class="leading-relaxed">
      <strong class="text-yellow-500">SUMOHENG</strong> คือทางเข้าหลักของเว็บไซต์ทางการ ที่ใช้สำหรับเข้าใช้งานผ่านลิงก์ที่ถูกต้อง ช่วยลดโอกาสพบเว็บไซต์ปลอมหรือลิงก์ที่ไม่เกี่ยวข้อง สมาชิกสามารถตรวจสอบความถูกต้องของเว็บไซต์ก่อนเข้าสู่ระบบ
      เพื่อให้สามารถเข้าสู่ระบบได้อย่างมั่นใจ พร้อมใช้งานบริการต่าง ๆ ได้จากเว็บไซต์เดียว
    </p>
  </ContentBox>
  <ContentBoxSevenThree titleleft="" titleright="บริการ สล็อตแท้ จากค่ายเกมชั้นนำ เป็นหนึ่งในจุดเด่นของ SUMOHENG">
    <div slot="left" class="flex h-full flex-col justify-center">
      <Picture
        src={image1}
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600, 800]}
        sizes="(max-width: 768px) 100vw, 50vw"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
        alt="sumoheng VIP Service"
        class="mx-auto h-auto w-full rounded-2xl border-2 border-yellow-500/30 shadow-[0_10px_30px_rgba(220,38,38,0.3)]"
      />
    </div>
    <div slot="right">
      <p>
        เกมสล็อตทั้งหมดมาจากค่ายเกมชั้นนำที่ได้รับความนิยม แต่ละเกมยังคงรูปแบบการเล่น ฟีเจอร์ และอัตราการจ่ายรางวัลตามต้นฉบับ <strong class="text-amber-400">SUMOHENG</strong> เปิดโอกาสให้ท่านเลือกได้อย่าง
        อิสระ ทั้งเกมยอดนิยม เกมใหม่ และเกมที่ได้รับความนิยมในแต่ละช่วงเวลา เมื่อเลือกเกมได้แล้ว การทำรายการฝากและถอนสามารถดำเนินการผ่านระบบอัตโนมัติของเว็บไซต์
      </p>

      <a
        href="/line"
        class="inline-flex items-center bg-[#00B900] px-8 py-3 font-bold text-white shadow-lg transition-transform hover:scale-105"
        style="clip-path: polygon(15% 0, 100% 0, 100% 70%, 85% 100%, 0 100%, 0 30%);">
        <span class="mr-2 text-xl">LINE</span> ติดต่อแอดมิน
      </a>
    </div>
  </ContentBoxSevenThree>
  <SmoothCarousel />
  <ContentBox>
    <div class="mt-4 flex flex-col gap-5">
      <!-- หัวข้อที่ 1 -->
      <div
        class="group flex flex-col items-start gap-4 rounded-2xl border border-red-900/30 bg-[#171717]/50 p-6 transition-all duration-300 hover:-translate-y-1 hover:border-yellow-500/50 hover:bg-[#1a1505] hover:shadow-[0_10px_20px_rgba(250,204,21,0.1)] sm:flex-row">
        <div
          class="flex h-14 w-14 shrink-0 items-center justify-center rounded-xl border border-yellow-300/50 bg-gradient-to-br from-yellow-400 to-yellow-600 text-3xl shadow-[0_0_15px_rgba(250,204,21,0.4)] transition-transform duration-300 group-hover:scale-110 group-hover:rotate-3">
          🎰
        </div>
        <div class="flex flex-col gap-2">
          <h3 class="bg-gradient-to-r from-yellow-300 to-yellow-500 bg-clip-text text-xl font-black tracking-wide text-transparent drop-shadow-sm">รวมค่ายเกมสล็อตที่ได้รับความนิยมจากผู้เล่น</h3>
          <p class="text-sm leading-relaxed text-gray-400 transition-colors group-hover:text-gray-300">
            ค่ายเกมที่เปิดให้บริการมีทั้ง PG Soft, Pragmatic Play, JILI, Joker Gaming, Habanero, CQ9 Gaming, Microgaming, NetEnt และผู้พัฒนาเกมอีกหลายราย
            แต่ละค่ายมีจุดเด่นและรูปแบบการเล่นที่แตกต่างกัน สมาชิกสามารถเลือกเล่นได้ตามความชอบจากบัญชีเดียว
          </p>
        </div>
      </div>

      <!-- หัวข้อที่ 2 -->
      <div
        class="group flex flex-col items-start gap-4 rounded-2xl border border-red-900/30 bg-[#171717]/50 p-6 transition-all duration-300 hover:-translate-y-1 hover:border-red-500/50 hover:bg-[#1a0505] hover:shadow-[0_10px_20px_rgba(220,38,38,0.15)] sm:flex-row">
        <div
          class="flex h-14 w-14 shrink-0 items-center justify-center rounded-xl border border-red-400/50 bg-gradient-to-br from-red-600 to-red-800 text-3xl shadow-[0_0_15px_rgba(220,38,38,0.4)] transition-transform duration-300 group-hover:scale-110">
          🌟
        </div>
        <div class="flex flex-col gap-2">
          <h3 class="bg-gradient-to-r from-white to-gray-300 bg-clip-text text-xl font-black tracking-wide text-transparent drop-shadow-sm transition-colors group-hover:text-yellow-400">
            สล็อตใหม่และเกมยอดนิยมอัปเดตอยู่เสมอ
          </h3>
          <p class="text-sm leading-relaxed text-gray-400 transition-colors group-hover:text-gray-300">
            รายชื่อเกมและค่ายผู้พัฒนาจะมีการอัปเดตตามรอบการให้บริการของแต่ละค่าย ทำให้สมาชิกสามารถพบทั้งเกมสล็อตยอดนิยม เกมเปิดใหม่ และเกมที่กำลังได้รับความนิยมในช่วงเวลาต่างๆ
          </p>
        </div>
      </div>

      <!-- หัวข้อที่ 3 -->
      <div
        class="group flex flex-col items-start gap-4 rounded-2xl border border-red-900/30 bg-[#171717]/50 p-6 transition-all duration-300 hover:-translate-y-1 hover:border-red-500/50 hover:bg-[#1a0505] hover:shadow-[0_10px_20px_rgba(220,38,38,0.15)] sm:flex-row">
        <div
          class="flex h-14 w-14 shrink-0 items-center justify-center rounded-xl border border-red-400/50 bg-gradient-to-br from-red-600 to-red-800 text-3xl shadow-[0_0_15px_rgba(220,38,38,0.4)] transition-transform duration-300 group-hover:scale-110">
          🔑
        </div>
        <div class="flex flex-col gap-2">
          <h2 class="bg-gradient-to-r from-white to-gray-300 bg-clip-text text-xl font-black tracking-wide text-transparent drop-shadow-sm transition-colors group-hover:text-yellow-400">
            เลือกเล่นได้หลายค่ายภายในบัญชีเดียว
          </h2>
          <p class="text-sm leading-relaxed text-gray-400 transition-colors group-hover:text-gray-300">
            สมาชิกไม่จำเป็นต้องสมัครหลายเว็บไซต์เพื่อเข้าเล่นเกมจากแต่ละค่าย เพราะระบบรวบรวมผู้ให้บริการไว้ในที่เดียว ช่วยให้สลับเกมและเลือกเล่นได้สะดวกมากขึ้น
          </p>
        </div>
      </div>
    </div>
  </ContentBox>
  <ContentBox>
    <h2 class="mb-4 text-3xl font-black tracking-[0.2em] text-yellow-400 uppercase drop-shadow-[0_0_10px_rgba(0,0,0,0.05)]">เฮงทุกสปิน มากกว่าสโลแกน แต่คือแนวคิดของ SUMOHENG</h2>
    <p class="leading-relaxed">
      คำว่า "เฮงทุกสปิน" ไม่ได้หมายถึงการรับประกันผลลัพธ์ของการเล่น แต่เป็นแนวคิดที่สะท้อนถึงประสบการณ์การใช้งานของเว็บไซต์ ตั้งแต่การเข้าใช้งาน ระบบฝากถอนออโต้
      ไปจนถึงการเลือกเล่นสล็อตแท้จากค่ายเกมชั้นนำ ทุกองค์ประกอบถูกจัดวางให้ใช้งานได้สะดวกและเป็นระเบียบ
    </p>
  </ContentBox>

  <ContentBox>
    <Picture
      src={image2}
      loading="lazy"
      fetchpriority="low"
      widths={[200, 400, 600, 800]}
      sizes="(max-width: 768px) 100vw, 50vw"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="sumoheng VIP Service"
      class="mx-auto h-auto w-full max-w-2xl rounded-2xl border-2 border-yellow-500/30 shadow-[0_10px_30px_rgba(220,38,38,0.3)] transition-transform hover:scale-[1.02]"
    />
    <h2 class="mb-4 text-2xl font-black tracking-[0.2em] text-yellow-400 uppercase drop-shadow-[0_0_10px_rgba(0,0,0,0.05)]">
      ระบบ ฝากถอนออโต้ ที่ให้ความสำคัญกับยอดที่ถูกต้อง จ่ายจริง รวดเร็วและแม่นยำ
    </h2>
    <p class="leading-relaxed">
      ระบบฝากถอนออโต้ <strong class="text-yellow-500">SUMOHENG</strong> เป็นส่วนสำคัญที่ช่วยให้การทำธุรกรรมมีความรวดเร็วและเป็นระเบียบ ทุกยอดฝากและถอนผ่านการตรวจสอบของระบบก่อนดำเนินการ พร้อมบันทึกสถานะของรายการเพื่อให้สมาชิกสามารถตรวจสอบได้ทุกขั้นตอน
      ความถูกต้องของข้อมูลและการจ่ายจริงจึงเป็นอีกหนึ่งปัจจัยที่ช่วยสร้างความมั่นใจในการใช้งานเว็บไซต์ และเป็นส่วนหนึ่งของประสบการณ์ที่ทีมรีวิวเว็บไซต์นำไปใช้ในการประเมินระบบ
    </p>
  </ContentBox>

  <ContentBox>
    <h2 class="mb-4 text-3xl font-black tracking-[0.2em] text-yellow-400 uppercase drop-shadow-[0_0_10px_rgba(0,0,0,0.05)]">ผลทดสอบการใช้งาน SUMOHENG โดยทีมรีวิวเว็บไซต์</h2>
    <p class="leading-relaxed">
      ทีมรีวิวเว็บไซต์ได้ และ ทีมอาสาสมัครจากหลายแหล่ง ทดสอบการใช้งานในหลายส่วน ตั้งแต่การเข้าสู่ระบบ การเลือกเล่นสล็อตแท้ การฝากถอนออโต้ ไปจนถึงการใช้งานผ่านอุปกรณ์ต่าง ๆ พร้อมตรวจสอบความรวดเร็ว
