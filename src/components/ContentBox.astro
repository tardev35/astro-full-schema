---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#fec93a]/40 bg-[#221703]/92 p-8 text-left text-base leading-relaxed text-[#f4e8d2] shadow-[0_10px_30px_rgba(254,201,58,0.14)] transition-all duration-500 hover:border-[#fec93a]/75 hover:shadow-[0_15px_40px_rgba(254,201,58,0.24)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#fec93a]/16 blur-[60px] transition-all duration-500 group-hover:bg-[#ffe9a8]/26"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#c9ccd4]/18 blur-[60px] transition-all duration-500 group-hover:bg-[#e6e8ee]/24"></div>

    {
      title && (
        <header class="mb-6 flex items-center gap-4 border-b border-[#fec93a]/25 pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffe9a8] to-[#c9ccd4] shadow-[0_0_10px_rgba(254,201,58,0.45)]" />
          <HeadingTag class="bg-gradient-to-r from-[#ffe9a8] via-[#fec93a] to-[#d4840e] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
