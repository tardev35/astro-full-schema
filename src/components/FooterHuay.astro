---
import { Picture } from "astro:assets";

const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.*", { eager: true });
const imagePaths = Object.keys(images);
const targetPath = imagePaths.find((path) => path.endsWith(".webp")) || imagePaths.find((path) => path.endsWith(".png")) || (imagePaths.length > 0 ? imagePaths[0] : null);
const mainLogo = targetPath ? images[targetPath].default : null;
---

<footer class="mt-12 w-full border-t-4 border-[#ffd60a] bg-[#0a1128] pt-12 pb-8 font-sans text-white">
  <div class="mx-auto w-full max-w-[1200px] px-6">
    <div class="mb-10 grid grid-cols-1 gap-10 md:grid-cols-12">
      <div class="flex flex-col gap-4 md:col-span-5">
        <a href="/" class="inline-block transition-transform duration-300 hover:scale-105">
          {
            mainLogo ? (
              <Picture src={mainLogo} alt="FINNBET Logo" class="h-[45px] w-auto" formats={["avif", "webp"]} fallbackFormat="webp" />
            ) : (
              <h2 class="text-3xl font-black tracking-widest text-white">
                <span class="text-[#ffd60a]">FINN</span>BET
              </h2>
            )
          }
        </a>
        <p class="mt-2 border-l-2 border-[#ffd60a] pl-4 text-sm leading-relaxed text-gray-400">
          แพลตฟอร์มการเดิมพันออนไลน์ที่เสถียรที่สุด ให้บริการหวยออนไลน์และคาสิโน ครบจบในที่เดียว ปลอดภัย มั่นคง การันตีด้วยผู้ใช้งานนับแสนคน
        </p>
      </div>

      <nav class="flex flex-col gap-3 md:col-span-3 lg:pl-8">
        <h3 class="text-lg font-bold text-white uppercase">เมนูหลัก</h3>
        <ul class="flex flex-col gap-2 text-sm text-gray-400">
          <li><a href="/" class="transition-colors hover:text-[#ffd60a]">หน้าหลัก</a></li>
          <li><a href="/แทงหวย" class="transition-colors hover:text-[#ffd60a]">แทงหวยออนไลน์</a></li>
          <li><a href="/โปรโมชั่น" class="transition-colors hover:text-[#ffd60a]">โปรโมชั่นทั้งหมด</a></li>
          <li><a href="/ติดต่อเรา" class="transition-colors hover:text-[#ffd60a]">ศูนย์ช่วยเหลือ</a></li>
        </ul>
      </nav>

      <div class="flex flex-col gap-3 md:col-span-4">
        <h3 class="text-lg font-bold text-white uppercase">ติดต่อและฝากถอน</h3>
        <a href="/line" class="flex w-full max-w-xs items-center justify-center gap-2 rounded-md bg-[#00B900] py-3 font-bold text-white transition-colors hover:bg-[#009900]">LINE Official (24 ชม.)</a>
        <div class="mt-2 flex flex-wrap gap-2">
          <span class="rounded-sm bg-white/10 px-2 py-1 text-[10px] font-bold text-white">KBANK</span>
          <span class="rounded-sm bg-white/10 px-2 py-1 text-[10px] font-bold text-white">SCB</span>
          <span class="rounded-sm bg-white/10 px-2 py-1 text-[10px] font-bold text-white">KTB</span>
          <span class="rounded-sm bg-white/10 px-2 py-1 text-[10px] font-bold text-white">BBL</span>
          <span class="rounded-sm bg-white/10 px-2 py-1 text-[10px] font-bold text-white">TRUE WALLET</span>
        </div>
      </div>
    </div>

    <div class="flex flex-col items-center justify-between border-t border-white/10 pt-6 text-xs text-gray-500 md:flex-row">
      <p>COPYRIGHT &copy; {new Date().getFullYear()} FINNBET. ALL RIGHTS RESERVED.</p>
      <div class="mt-4 flex gap-4 md:mt-0">
        <a href="/" class="hover:text-white">ข้อตกลงและเงื่อนไข</a>
        <a href="/" class="hover:text-white">นโยบายความเป็นส่วนตัว</a>
      </div>
    </div>
  </div>
</footer>
<style>
  .font-sans {
    font-family: "Kanit", sans-serif;
  }
</style>
