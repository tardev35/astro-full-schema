---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxPremium.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";

import { Picture } from "astro:assets";

import pro1 from "../assets/slide1.png";
import pro2 from "../assets/slide2.png";
import pro3 from "../assets/slide3.png";
import pro4 from "../assets/slide4.png";
import { pageGraph } from "../lib/schema";

const pageTitle = "โปรโมชั่น PIGAUTO";

const pageDescription =
  "สมัครสมาชิกใหม่กับ PIGAUTO รวมภาพโปรโมชั่นทุกแคมเปญไว้ที่เดียว ทั้งคืนคอมมิชชั่นจากยอดเล่นรายวัน โบนัสแนะนำเพื่อน และสิทธิ์อื่น อ่านเงื่อนไขก่อนกดรับสิทธิ์";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: pro1.src,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="โปรโมชั่น PIGAUTO ทุกแคมเปญรวมไว้ที่เดียว" as="h1">
    <p class="mb-8 text-left text-base leading-relaxed text-[#f7e2e2]">
      หน้านี้รวมภาพโปรโมชั่นที่ <strong class="text-[#f5c542]">PIGAUTO</strong> เปิดให้สมาชิกเลือกใช้ ทั้งคืนคอมมิชชั่นจากยอดเล่นในแต่ละวัน โบนัสจากการแนะนำเพื่อน
      และสิทธิ์อื่นที่เปิดรับตามช่วงเวลา แต่ละรายการมีเงื่อนไข ยอดเริ่มต้น และเวลาปิดรับสิทธิ์ไม่เท่ากัน จึงควรอ่านรายละเอียดที่ระบุอยู่บนภาพก่อนกดใช้งานทุกครั้ง
      เมื่อเลือกรายการที่ต้องการได้แล้ว สมัครสมาชิกจากปุ่มด้านล่างเพื่อเริ่มรับสิทธิ์ได้ทันที
    </p>

    <div class="grid w-full grid-cols-1 gap-6 sm:grid-cols-2">
      <Picture
        src={pro1}
        alt="ภาพโปรโมชั่น PIGAUTO คืนคอมมิชชั่นทุกยอดเล่นตลอดทั้งวัน 0.3 เปอร์เซ็นต์ เล่นถึง 50 เปอร์เซ็นต์ ถอนได้เลย พื้นหลังสีแดงลายตรุษจีนมีโคมไฟแดงและเหรียญทองลอย โลโก้หมูสีชมพูบนเฟือง PIGAUTO อยู่ด้านบน พรีเซนเตอร์หญิงชุดจีนสีแดงทองยืนอยู่ด้านซ้าย พร้อมข้อความ สามารถกดรับง่ายๆ ที่หน้าเว็บได้เลยค่ะ รับสิทธิ์ก่อน 23.59 น. ของทุกวัน และ ยิ่งเล่นเยอะ ยิ่งได้เยอะ"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class="mx-auto h-auto w-full rounded-xl border border-[#8c0f12]/70 object-contain shadow-[0_10px_30px_rgba(216,31,38,0.22)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#f5c542]/60 hover:shadow-[0_15px_40px_rgba(245,197,66,0.28)]"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />

      <Picture
        src={pro2}
        alt="ภาพโปรโมชั่น PIGAUTO แนะนำเพื่อนรับโบนัส 0.8 เปอร์เซ็นต์ สร้างรายได้ 100,000 ต่อเดือน พื้นหลังสีแดงลายตรุษจีนมีโคมไฟแดงและเหรียญทองลอยรอบภาพ โลโก้หมูสีชมพูบนเฟือง PIGAUTO อยู่ด้านซ้ายบน และพรีเซนเตอร์หญิงชุดสูทสีทองยืนอยู่ด้านขวา"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class="mx-auto h-auto w-full rounded-xl border border-[#8c0f12]/70 object-contain shadow-[0_10px_30px_rgba(216,31,38,0.22)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#f5c542]/60 hover:shadow-[0_15px_40px_rgba(245,197,66,0.28)]"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />

      <Picture
        src={pro3}
        alt="ภาพโปรโมชั่น PIGAUTO ปุ่มสีแดงเรียงสี่ปุ่มด้านซ้ายเขียนว่า หวย บอล บาคาร่า สล็อต ใต้ภาพเป็นข้อความ ครบจบในที่เดียว พร้อมแถบรายการ บอล คาสิโน สล็อต ยิงปลา ไก่ชน มวย ไฮโล รูเล็ต พรีเซนเตอร์หญิงชุดจีนสีแดงทองถือไพ่บังใบหน้า ฉากหลังสีแดงมีโคมไฟและเหรียญทอง โลโก้หมูสีชมพู PIGAUTO อยู่มุมขวาบน"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class="mx-auto h-auto w-full rounded-xl border border-[#8c0f12]/70 object-contain shadow-[0_10px_30px_rgba(216,31,38,0.22)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#f5c542]/60 hover:shadow-[0_15px_40px_rgba(245,197,66,0.28)]"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />

      <Picture
        src={pro4}
        alt="ภาพโปรโมชั่น PIGAUTO หวยอัตราจ่ายที่ดีที่สุด 3 ตัวบาทละ 1000 และ 2 ตัวบาทละ 100 พร้อมข้อความ ถูกตรง จ่ายจริง รับเงินรางวัลหลักล้าน และ ครบจบเรื่องหวยในเว็บเดียว รัฐบาล ลาว ฮานอย หุ้น ยี่กี ฉากหลังสีแดงลายตรุษจีนมีโคมไฟแดงและเหรียญทอง โลโก้หมูสีชมพู PIGAUTO อยู่มุมซ้ายบน พรีเซนเตอร์หญิงชุดสีทองยืนอยู่ด้านขวา"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class="mx-auto h-auto w-full rounded-xl border border-[#8c0f12]/70 object-contain shadow-[0_10px_30px_rgba(216,31,38,0.22)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#f5c542]/60 hover:shadow-[0_15px_40px_rgba(245,197,66,0.28)]"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />
    </div>

    <div class="mt-12 flex justify-center pb-4">
      <a
        href="/register"
        class="flex items-center justify-center rounded-lg border border-[#f5c542]/60 bg-gradient-to-r from-[#ffe9a8] via-[#f5c542] to-[#a9761a] px-10 py-3.5 text-lg font-black text-[#1c0403] shadow-[0_10px_30px_rgba(245,197,66,0.24)] transition-transform hover:scale-105 hover:shadow-[0_15px_40px_rgba(245,197,66,0.38)]">
        สมัครสมาชิก PIGAUTO
      </a>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
