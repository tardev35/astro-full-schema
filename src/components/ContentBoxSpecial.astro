---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h2" } = Astro.props;
---

<section class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#1d5c22] bg-[#06230a] p-6 text-[#d9f7d0] shadow-[0_10px_30px_rgba(200,252,4,0.14)] transition-all duration-500 hover:border-[#c8fc04]/55 md:p-10">
    <div
      aria-hidden="true"
      class="pointer-events-none absolute top-0 left-1/2 -z-10 h-[3px] w-1/2 -translate-x-1/2 bg-gradient-to-r from-transparent via-[#c8fc04] to-transparent opacity-60 transition-opacity duration-500 group-hover:opacity-100">
    </div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#1d5c22] pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#e6ff6a] to-[#3fc20a] shadow-[0_0_10px_rgba(200,252,4,0.45)]" />
          <HeadingTag class="bg-gradient-to-r from-[#f3ffe9] via-[#c8fc04] to-[#3fc20a] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-2 lg:gap-10">
      <article
        class="relative flex gap-4 rounded-2xl border border-[#1d5c22] bg-[#0b3a10]/60 p-6 text-left text-base leading-relaxed text-[#d9f7d0] transition-all duration-300 hover:-translate-y-2 hover:border-[#c8fc04]/55 hover:bg-[#0b3a10] hover:shadow-[0_15px_40px_rgba(200,252,4,0.22)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#7ee000] bg-gradient-to-br from-[#e6ff6a] via-[#c8fc04] to-[#7ee000] text-2xl shadow-[0_5px_15px_rgba(200,252,4,0.35)]">
          🔍
        </div>
        <slot name="left" />
      </article>

      <article
        class="relative flex gap-4 rounded-2xl border border-[#1d5c22] bg-[#0b3a10]/60 p-6 text-left text-base leading-relaxed text-[#d9f7d0] transition-all duration-300 hover:-translate-y-2 hover:border-[#3fc20a]/60 hover:bg-[#0b3a10] hover:shadow-[0_15px_40px_rgba(63,194,10,0.24)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#1a7a08] bg-gradient-to-br from-[#7ee000] via-[#3fc20a] to-[#1a7a08] text-2xl shadow-[0_5px_15px_rgba(63,194,10,0.30)]">
          🛡️
        </div>
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
