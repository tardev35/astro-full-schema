---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
---

<section class="my-3 flex w-full justify-center px-4">
  <div
    class="w-full max-w-7xl rounded-[15px] border-2 border-[#f050ff] from-green-950 p-8 text-center text-white shadow-2xl"
    style="box-shadow: 0 0 14px rgba(168,85,247,0.5), inset 0 0 12px rgba(168,85,247,0.5)">
    {
      title && (
        <header class="mb-6">
          <HeadingTag class="text-3xl font-bold text-[#facc15] drop-shadow-md">{title}</HeadingTag>
        </header>
      )
    }

    <div class="text-lg leading-relaxed">
      <slot />
    </div>
  </div>
</section>

<style>
  .bg-green-yellow-oklab {
    background-image: linear-gradient(in oklab to right, #1b8d3b, #399537, #27a544);
  }
</style>
