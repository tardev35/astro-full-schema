---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/Announcement2.astro";
import ContentBox from "../components/ContentBox.astro";
import ContentBoxNeumorphism from "../components/ContentBoxNeumorphism.astro";
import ContentBoxFloatingBadge from "../components/ContentBoxFloatingBadge.astro";
import ContentBoxTwo from "../components/ContentBoxTwo.astro";
import ContentBoxSpecial from "../components/ContentBoxSpecial.astro";
import ContentBoxSevenThreeNeumorphism from "../components/ContentBoxSevenThreeNeumorphism.astro";
import ContentBoxSevenThree from "../components/ContentBoxSevenThree.astro";
import FeatureHighlights from "../components/FeatureHighlights.astro";
import SmoothCarousel from "../components/SmoothCarousel.astro";
import GameRankingBoard from "../components/GameRankingBoard.astro";
import ProviderGrid from "../components/ProviderGrid.astro";
import LatestWinners4 from "../components/LatestWinners4.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import ReviewCardSumo2 from "../components/ReviewCardSumo2.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import imgNewMember from "../assets/slide1.png";
import imgSupport from "../assets/slide4.png";

const pageTitle = "SUPREME888 สล็อต ถอนได้เต็มทุกบิล ฝากถอนออโต้ทำเองได้ เกมหลายค่าย";

const pageDescription =
  "สมัคร SUPREME888 สล็อต จ่ายเต็มทุกยอดไม่หักเปอร์เซ็นต์ ฝากถอนออโต้กดเองได้ เลือกเกมตามกลไก โปรสมาชิกใหม่ มือถือครบทุกขั้นตอน แอดมิน 24 ชม. เปิดยูสได้เลย";

const announcementMessage =
  "SUPREME888 สล็อต จ่ายเต็มทุกยอด ไม่หักเปอร์เซ็นต์ • ฝากถอนออโต้ ฝากเริ่ม 20 บาท ถอนขั้นต่ำ 50 บาท กดเองได้ตลอด 24 ชม. ไม่ต้องส่งสลิป • ใช้ได้ทุกธนาคารและ TrueMoney Wallet ทั้งขาฝากและขาถอน • รวม PG Soft, Pragmatic Play, JILI และ Joker Gaming ไว้ในเว็บเดียว • มือถือเครื่องเดียวทำได้ครบ แอดมินดูแลตลอด 24 ชม.";

const newMemberAlt = "Supreme888 สมาชิกใหม่ เริ่มต้นง่าย สมัครสะดวก พร้อมสนุกได้ทันที สมัครง่าย ระบบเสถียร พร้อมดูแล ปุ่มสมัครสมาชิก";

const supportAlt = "Supreme888 พร้อมดูแลทุกขั้นตอน บริการรวดเร็ว เป็นกันเอง ตอบไว ใส่ใจ พร้อมดูแล ปุ่มติดต่อเรา";

const games = [
  {
    icon: "🏺",
    title: "Treasures of Aztec (PG Soft)",
    description: "สาวถ้ำที่ตัวคูณขยับขึ้นทุกครั้งที่ชนะติดกัน เหมาะกับคนชอบลุ้นยาวในรอบฟรีสปิน",
    accent: "red" as const,
  },
  {
    icon: "🍭",
    title: "Sweet Bonanza (Pragmatic Play)",
    description: "สัญลักษณ์ร่วงหล่นต่อเนื่อง ลูกอมตัวคูณในรอบฟรีสปินรวมยอดตอนท้าย และมีปุ่มซื้อฟีเจอร์สำหรับคนทุนพร้อม",
    accent: "ink" as const,
  },
  {
    icon: "💎",
    title: "Fortune Gems (JILI)",
    description: "ช่องเกมสามแถวพร้อมวงล้อตัวคูณด้านข้างที่สุ่มให้ทุกรอบ จังหวะไว เหมาะกับคนที่เล่นทีละช่วงสั้น",
    accent: "red" as const,
  },
  {
    icon: "🏛️",
    title: "Roma (Joker Gaming)",
    description: "เกมคลาสสิกที่คนไทยคุ้น กติกาเข้าใจง่าย มีฟีเจอร์พิเศษให้ลุ้นระหว่างทาง เหมาะกับคนเพิ่งเริ่ม",
    accent: "ink" as const,
  },
];

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
});

const inlineLink = "font-bold text-[#b5121a] underline underline-offset-4 transition-colors hover:text-[#ec1b24]";
const slideFrame = "mx-auto h-auto w-full rounded-2xl border border-[#f1d2d3] shadow-[0_10px_30px_rgba(236,27,36,0.12)]";
const body = "text-left text-base leading-relaxed";
const listItem = "rounded-xl border-l-4 border-[#ec1b24] bg-[#fff5f5] px-4 py-3";
const listLabel = "font-black text-[#141414]";
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement message={announcementMessage} />

  <SmoothCarousel />

  <ContentBoxNeumorphism as="h1" title="SUPREME888 สล็อต ถอนได้เต็มทุกบิล ฝากถอนออโต้ทำเองได้ เล่นครบบนมือถือ">
    <p class={body}>
      คนที่เคยแตกบิลใหญ่แล้วได้เงินไม่ครบ มักถามก่อนเปิดยูสว่าเว็บนี้จ่ายเต็มไหม SUPREME888 สล็อต ใช้ชื่อที่แปลว่าสูงสุด แต่สิ่งที่เราอยากให้สูงจริงคือยอดถอนที่สมาชิกได้รับเต็มจำนวนไม่หักเปอร์เซ็นต์ ฝากถอนออโต้ที่กดเองได้ เกมหลายค่ายที่เลือกตามกลไกได้ในเว็บเดียว โปรสมาชิกใหม่ มือถือเครื่องเดียวทำได้ครบทุกขั้นตอน และแอดมินที่รับเรื่องตลอด 24 ชั่วโมง ใครยังลังเลว่าจะ<a href="/register/" class={inlineLink}>สมัคร SUPREME888</a> ดีไหม อ่านทีละข้อแล้วค่อยตัดสินใจครับ
    </p>
  </ContentBoxNeumorphism>

  <ContentBoxFloatingBadge as="h2" title="ถอนเยอะแล้วจ่ายไหม SUPREME888 สล็อต จ่ายเต็มทุกยอด ไม่หักเปอร์เซ็นต์">
    <p class={body}>
      ถ้าแตกหลักแสนจะได้ครบไหม คำตอบของเราสั้นมาก ยอดที่กดถอนได้จะโอนเข้าบัญชีเต็มจำนวน ไม่หักเปอร์เซ็นต์จากบิลใหญ่ บิลเล็กบิลใหญ่ใช้กติกาเดียวกัน ถ้ารับโปรไว้ ให้เปิดดูเงื่อนไขการถอนของโปรนั้นใน<a href="/promotion/" class={inlineLink}>หน้าโปรโมชั่น</a>ก่อนกดถอน จะได้ไม่งงว่าทำไมยอดยังถอนไม่ได้ เหมาะกับคนที่เคยโดนหักหัวคิวจนไม่กล้าถอนก้อนใหญ่ครับ
    </p>
  </ContentBoxFloatingBadge>

  <LatestWinners4 />

  <ContentBoxTwo as="h2" title="ฝากถอนออโต้เริ่ม 20 บาท ถอนเองได้ตลอด 24 ชม. ไม่ต้องส่งสลิป">
    <p slot="left" class={body}>
      ทุนน้อยกับทุนหนาใช้ระบบฝากถอนออโต้ชุดเดียวกันที่นี่ ฝากเริ่มที่ 20 บาท จะโอนจากแอปธนาคารหรือเติมผ่านวอเลทก็ได้ พอยอดเข้า ระบบปรับเครดิตให้ทันทีภายในไม่กี่วินาที ขาถอนกดได้เองทั้ง 24 ชั่วโมง ถอนตอนตีสามก็ไม่ต้องรอแอดมินตื่น สรุปสั้นๆ ครับ
    </p>

    <div slot="right" class="flex flex-col gap-4">
      <ul class="flex flex-col gap-3">
        <li class={listItem}><strong class={listLabel}>ช่องทาง:</strong> ทุกธนาคารและ TrueMoney Wallet (ทรูวอเลท) ใช้ได้ทั้งขาฝากและขาถอน</li>
        <li class={listItem}><strong class={listLabel}>ขั้นต่ำ:</strong> ฝาก 20 บาท ถอน 50 บาท</li>
        <li class={listItem}><strong class={listLabel}>เวลา:</strong> ปรับเครดิตให้เองในไม่กี่วินาที ไม่ต้องส่งสลิปให้แอดมิน</li>
      </ul>
      <p class={body}>
        ถ้าโอนแล้วเครดิตยังไม่ขึ้น อย่าเพิ่งโอนซ้ำ จดเวลาและยอดที่โอน แล้วทักแอดมินผ่านช่องทางบนหน้าเว็บ รายการที่ข้อมูลครบจะตามเจอไวกว่าครับ
      </p>
    </div>
  </ContentBoxTwo>

  <ContentBox as="h2" title="เลือกเกมสล็อตจากกลไกฟรีสปิน ตัวคูณ ซื้อฟีเจอร์ หลายค่ายในเว็บเดียว">
    <p class={body}>
      หลายคนเข้ามาแล้วถามว่าจะเริ่มเกมไหนดี เราไม่ตอบด้วยชื่อเกมเดียว ที่นี่รวมค่ายที่สายปั่นไทยเปิดบ่อยไว้ในเว็บเดียว มี PG Soft กับ Pragmatic Play และมี JILI กับ Joker Gaming ให้สลับเล่น วิธีเลือกที่เราแนะนำคือดูกลไกก่อนดูหน้าปก รอบฟรีสปินเข้าแบบไหน ตัวคูณทำงานตอนไหน เบทต่ำสุดต่อรอบของเกมนั้นเท่าไร แล้วคัดไว้สองสามเกมที่ตรงกับทุนของตัวเองครับ
    </p>

    <FeatureHighlights items={games} />

    <p class={`mt-5 ${body}`}>
      วิธีแบ่งทุนที่เราแนะนำคือ ตั้งงบของวันนั้นไว้ก่อนเปิดเกม ลองเกมละไม่กี่รอบด้วยเบทเล็กเพื่อดูจังหวะ ถ้าเกมไหนรอบฟรีสปินเข้ายากกว่าที่ทุนรับไหว ให้สลับไปเกมที่จังหวะสั้นกว่าแทนการเพิ่มเบทไล่ทุน ทุนจะอยู่ได้นานกว่าครับ
    </p>
  </ContentBox>

  <ProviderGrid />

  <GameRankingBoard />

  <ContentBoxSevenThreeNeumorphism as="h2" titleright="โปรสมาชิกใหม่ SUPREME888 อ่านเงื่อนไขในหน้าโปรโมชั่นก่อนรับ จะได้ถอนไม่ติด">
    <Picture
      slot="left"
      src={imgNewMember}
      alt={newMemberAlt}
      loading="lazy"
      fetchpriority="low"
      widths={[280, 380, 480, 600]}
      sizes="(max-width: 767px) calc(100vw - 96px), (max-width: 1399px) calc(30vw - 38px), 382px"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={70}
      class={slideFrame}
    />

    <p slot="right" class={body}>
      คนเปิดยูสครั้งแรกมีโปรสมาชิกใหม่รอรับอยู่ รายละเอียดและเงื่อนไขทั้งหมดอยู่ใน<a href="/promotion/" class={inlineLink}>หน้าโปรโมชั่น</a> ก่อนรับโปรเราอยากให้เปิดหน้านั้นดูสามเรื่อง หนึ่งคือโปรมีเงื่อนไขยอดฝากไหม สองคือต้องทำเทิร์นก่อนถอนหรือไม่ อย่างไร สามคือโปรนับยอดจากเกมไหนบ้าง รู้สามเรื่องนี้แล้วจะวางแผนถอนได้ตั้งแต่ก่อนฝาก ถ้าอ่านแล้วยังไม่แน่ใจว่าเงื่อนไขเข้ากับแผนของตัวเองไหม ทักแอดมินถามก่อนรับได้เลย เราตอบให้ก่อนที่จะฝากครับ
    </p>
  </ContentBoxSevenThreeNeumorphism>

  <ContentBoxSpecial as="h2" title="ทางเข้า SUPREME888 บนมือถือ สมัคร ฝาก ปั่น ถอน จบในเครื่องเดียว" iconleft="📱" iconright="🔑">
    <p slot="left" class={body}>
      ไม่ต้องรอกลับบ้านไปเปิดคอม ทุกขั้นตอนของเว็บนี้ทำบนมือถือได้ครบ ตั้งแต่สมัคร ฝากเครดิต ดูโปร เปิดเกม ไปจนถึงกดถอน ใช้ได้ทั้ง iOS และ Android ผ่านเบราว์เซอร์โดยไม่ต้องโหลดแอปเพิ่ม
    </p>

    <p slot="right" class={body}>
      สมาชิกเดิมที่เปลี่ยนเครื่องให้เข้าผ่าน<a href="/ทางเข้า/" class={inlineLink}>ทางเข้า SUPREME888</a> แล้วล็อกอินด้วยยูสและรหัสเดิม ไม่ต้องสมัครซ้ำครับ
    </p>
  </ContentBoxSpecial>

  <LoginRtpSection />

  <ContentBoxSevenThree as="h2" titleright="ติดตรงไหนทักแอดมินได้ตลอด 24 ชม. คนใหม่สมัครแล้วเริ่มได้ทันที">
    <Picture
      slot="left"
      src={imgSupport}
      alt={supportAlt}
      loading="lazy"
      fetchpriority="low"
      widths={[280, 380, 480, 600]}
      sizes="(max-width: 767px) calc(100vw - 96px), (max-width: 1399px) calc(30vw - 67px), 353px"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={70}
      class={slideFrame}
    />

    <p slot="right" class={body}>
      ระบบออโต้ทำงานได้เอง แต่ก็ยังมีจังหวะที่คนต้องคุยกับคน เช่น ล็อกอินไม่ผ่าน เครดิตไม่ขึ้นหลังโอน ถอนค้างสถานะนานผิดปกติ หรือโปรไม่โชว์ แอดมินของเรารับเคสตลอด 24 ชั่วโมงผ่านช่องทางติดต่อบนหน้าเว็บ ทักมาพร้อมชื่อยูส เวลาที่ทำรายการ และยอดเงิน และไม่ต้องส่งรหัสผ่านหรือ OTP ให้ใครทั้งนั้น ส่วนคนใหม่ กด<a href="/register/" class={inlineLink}>สมัคร SUPREME888</a> แล้วกรอกตามขั้นตอนที่ระบบแสดง ตรวจข้อมูลให้ถูกก่อนยืนยัน จะได้ทำรายการได้ราบรื่นตั้งแต่ครั้งแรกครับ
    </p>
  </ContentBoxSevenThree>

  <ContentBox>
    <p class={body}>
      SUPREME888 ให้สิ่งที่สายปั่นต้องการจริงหกอย่าง ยอดถอนที่เข้าเต็มไม่หักเปอร์เซ็นต์ ระบบออโต้ที่ฝากตั้งแต่ 20 บาทและถอนเองได้ทั้งวัน เกมหลายค่ายที่เลือกจากกลไกได้โดยไม่ต้องย้ายเว็บ โปรสมาชิกใหม่ที่เปิดดูเงื่อนไขได้ก่อนรับ มือถือเครื่องเดียวทำได้ครบ และแอดมินที่รับเรื่องตลอด 24 ชั่วโมง เปิดยูสไว้ก่อน แล้วลองฝากก้อนเล็กดูจังหวะระบบด้วยตัวเองครับ
    </p>
  </ContentBox>

  <ReviewCardSumo2 />

  <Navfoot />
</MainLayout>
