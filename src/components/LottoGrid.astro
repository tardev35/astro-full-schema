---
const lottos = [
  { name: "หวยรัฐบาลไทย", close: "15:00 น.", reward: "บาทละ 900", icon: "🇹🇭" },
  { name: "หวยฮานอย", close: "18:00 น.", reward: "บาทละ 95", icon: "🇻🇳" },
  { name: "หวยลาวพัฒนา", close: "20:00 น.", reward: "บาทละ 95", icon: "🇱🇦" },
  { name: "หวยยี่กี 88 รอบ", close: "ทุก 15 นาที", reward: "บาทละ 95", icon: "⏱️" },
  { name: "หวยมาเลย์", close: "18:00 น.", reward: "บาทละ 95", icon: "🇲🇾" },
  { name: "หวยหุ้นไทย", close: "16:40 น.", reward: "บาทละ 95", icon: "📈" },
];
---

<div class="mx-auto w-full max-w-[1300px] px-4 py-8 font-sans sm:px-6 lg:px-8">
  <div class="mb-6 flex w-full flex-col items-center justify-center gap-2 text-center">
    <h2 class="bg-gradient-to-r from-green-300 via-yellow-400 to-green-300 bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase drop-shadow-sm">แทงหวยออนไลน์</h2>
    <div class="mt-1 h-[2px] w-24 bg-gradient-to-r from-transparent via-green-500 to-transparent"></div>
  </div>

  <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-6 lg:gap-4">
    {
      lottos.map((lotto) => (
        <div class="group relative flex cursor-pointer flex-col items-center justify-center overflow-hidden rounded-xl border border-green-500/20 bg-[#032e1f]/60 p-5 shadow-lg backdrop-blur-sm transition-all duration-300 hover:-translate-y-2 hover:border-yellow-400/60 hover:bg-[#04402a]/80 hover:shadow-[0_10px_25px_rgba(251,191,36,0.15)]">
          <div class="mb-3 text-4xl drop-shadow-[0_0_10px_rgba(34,197,94,0.4)] transition-transform duration-300 group-hover:scale-110">{lotto.icon}</div>
          <h3 class="text-center text-sm font-bold text-white transition-colors group-hover:text-yellow-400">{lotto.name}</h3>
          <p class="mt-1 text-[10px] text-green-200/70">
            ปิดรับ: <span class="font-mono text-yellow-300">{lotto.close}</span>
          </p>
          <div class="mt-3 w-full rounded-sm border border-green-500/30 bg-black/40 px-3 py-1.5 text-center text-[11px] font-bold text-green-400 transition-colors group-hover:border-transparent group-hover:bg-gradient-to-r group-hover:from-yellow-600 group-hover:to-yellow-400 group-hover:text-[#021c13]">
            {lotto.reward}
          </div>
        </div>
      ))
    }
  </div>
</div>

<style>
  .font-sans {
    font-family: "Kanit", sans-serif;
  }
</style>
