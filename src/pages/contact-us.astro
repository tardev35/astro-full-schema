---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxPremium.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement.astro";

import { Picture } from "astro:assets";
import imgLine from "../assets/contact-line.webp";
import { pageGraph } from "../lib/schema";
import { BRAND_ADDRESS } from "../lib/brandProfile";

const pageDescription =
  "ช่องทางติดต่อทีมงานคนไทยของ YIMSIAM88 ผ่าน LINE Official ตอบเองไม่ใช้บอท ดูแลเรื่องสมัครสมาชิก เข้าสู่ระบบ ฝากถอนออโต้ พร้อมที่อยู่และอีเมลของเว็บ ตลอด 24 ชม.";

const graph = pageGraph(Astro, {
  type: "ContactPage",
  name: "ติดต่อทีมงาน YIMSIAM88 ผ่าน LINE Official",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ติดต่อเรา", path: "/contact-us" },
  ],
  org: {
    alternateName: "YIMSIAM88 สล็อตเว็บตรงไทยแท้ โบนัสแรงแตกบ่อย จ่ายเต็มไม่มีหัก",
    contactPoints: [
      {
        contactType: "customer service",
        availableLanguage: ["Thai", "English"],
        path: "/line",
        description: "ติดต่อแอดมินผ่าน LINE Official",
      },
    ],
  },
});
---

<MainLayout title="ติดต่อ - YIMSIAM88" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="ติดต่อทีมงาน YIMSIAM88" as="h1">
    <Picture
      src={imgLine}
      alt="พนักงานหญิงชุดเลื่อมสีชมพูยิ้มกอดอก ข้างปุ่มสีขาวที่มีโลโก้ LINE สีเขียวและคำว่า Support ช่องทางแชตกับทีมงานคนไทยของ YIMSIAM88"
      loading="lazy"
      fetchpriority="low"
      widths={[200, 400, 600]}
      sizes="(max-width: 768px) 100vw"
      class="mx-auto h-auto w-full max-w-[400px] object-contain shadow-[0_10px_30px_rgba(255,122,24,0.18)]"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={60}
    />
    {
      BRAND_ADDRESS.lines.length > 0 && (
        <address aria-label={BRAND_ADDRESS.label} class="mt-8 mb-8 border-l-4 border-[#ff7a18] pl-6 text-left text-base leading-relaxed text-[#f7e6d4] not-italic">
          <p class="mb-1 font-bold text-[#ffd98a]">{BRAND_ADDRESS.label}</p>
          {BRAND_ADDRESS.lines.map((line) => (
            <span class="block">{line}</span>
          ))}
          {BRAND_ADDRESS.email && (
            <span class="mt-3 block">
              <span aria-hidden="true" class="mr-2">
                ✉️
              </span>
              <a href={`mailto:${BRAND_ADDRESS.email}`} class="font-bold text-[#ffd98a] underline decoration-[#ff7a18]/60 underline-offset-4 transition-colors hover:text-[#ffa347]">
                {BRAND_ADDRESS.email}
              </a>
            </span>
          )}
        </address>
      )
    }

    <div class="flex flex-wrap justify-center gap-4">
      <a
        href="/register"
        aria-label="สมัครสมาชิก"
        class="flex items-center justify-center rounded-lg border border-[#f6c475]/60 bg-gradient-to-b from-[#ffd98a] via-[#ff7a18] to-[#8d2b09] px-8 py-3 font-bold text-[#160604] shadow-[0_10px_30px_rgba(255,122,24,0.18)] transition-transform hover:scale-105 hover:shadow-[0_15px_40px_rgba(255,122,24,0.30)]">
        สมัครสมาชิก
      </a>

      <a
        href="/login"
        aria-label="เข้าสู่ระบบ"
        class="flex items-center justify-center rounded-lg border border-[#f6c475]/60 bg-[#24100a] px-8 py-3 font-extrabold text-[#ffd98a] shadow-[0_4px_14px_rgba(255,122,24,0.18)] transition-transform hover:scale-105 hover:bg-[#2a0f06]">
        เข้าสู่ระบบ
      </a>

      <a
        href="/line"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="ติดต่อทีมงานผ่าน Line Official"
        class="flex items-center justify-center rounded-lg border border-green-300 bg-gradient-to-b from-green-400 to-green-700 px-8 py-3 font-bold text-white transition-transform hover:scale-105">
        ติดต่อผ่าน Line Official
      </a>
    </div>
  </ContentBox>
  <Navfoot />
</MainLayout>
