---
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";

export interface CategoryItem {
  title: string;
  eyebrow: string;
  desc: string;
  img: ImageMetadata;
  alt: string;
  href: string;
  cta: string;
}

export interface Props {
  items: CategoryItem[];
  kicker?: string;
}

const { items, kicker = "เลือกหมวดที่อยากเล่น" } = Astro.props;
---

<section class="relative z-10 mx-auto w-full max-w-[1400px] px-4 pb-6 font-sans">
  <p class="mb-4 flex items-center justify-center gap-3 text-[11px] font-extrabold tracking-[0.3em] text-[#4da3ff] uppercase">
    <span aria-hidden="true" class="h-px w-10 bg-gradient-to-r from-transparent to-[#4da3ff]"></span>
    {kicker}
    <span aria-hidden="true" class="h-px w-10 bg-gradient-to-l from-transparent to-[#4da3ff]"></span>
  </p>

  <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-4 lg:gap-5">
    {
      items.map((it, i) => (
        <article class="group relative rounded-[22px] bg-gradient-to-br from-[#2b95ff]/70 via-[#1a4a9c]/40 to-[#e8202a]/60 p-px shadow-[0_12px_32px_rgba(0,0,0,0.4)] transition-transform duration-300 hover:-translate-y-1">
          <div class="relative flex h-full gap-4 overflow-hidden rounded-[21px] bg-[#041a45] p-4 lg:flex-col lg:p-5">
            <div
              aria-hidden="true"
              class="pointer-events-none absolute -top-14 -right-14 h-40 w-40 rounded-full bg-[#0b7cf4]/25 blur-3xl transition-colors duration-500 group-hover:bg-[#e8202a]/30"
            />
            <span aria-hidden="true" class="absolute top-3 right-4 text-[11px] font-extrabold tracking-[0.2em] text-[#4da3ff]/60">
              {String(i + 1).padStart(2, "0")}
            </span>

            <a
              href={it.href}
              aria-label={it.title}
              class="relative shrink-0 self-start rounded-full bg-gradient-to-br from-[#0b7cf4] via-[#4da3ff] to-[#e8202a] p-[3px] shadow-[0_0_30px_rgba(11,124,244,0.45)] transition-shadow duration-300 group-hover:shadow-[0_0_34px_rgba(232,32,42,0.45)]"
            >
              <Picture
                src={it.img}
                alt={it.alt}
                loading="lazy"
                decoding="async"
                fetchpriority="low"
                widths={[96, 192, 288]}
                sizes="96px"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
                quality={74}
                class="h-20 w-20 rounded-full object-cover lg:h-24 lg:w-24"
              />
            </a>

            <div class="relative flex min-w-0 flex-1 flex-col">
              <span class="text-[10px] font-extrabold tracking-[0.22em] text-[#4da3ff] uppercase">{it.eyebrow}</span>
              <h3 class="mt-1 text-lg leading-snug font-black text-white lg:text-xl">{it.title}</h3>
              <p class="mt-1.5 text-xs leading-relaxed text-[#9fb8dc] lg:text-sm">{it.desc}</p>
              <a
                href={it.href}
                class="mt-3 inline-flex w-fit items-center gap-2 rounded-full bg-gradient-to-r from-[#0b7cf4] to-[#2b95ff] px-4 py-2 text-xs font-extrabold text-white shadow-[0_8px_20px_rgba(11,124,244,0.4)] transition-all duration-300 group-hover:from-[#e8202a] group-hover:to-[#ff4b55] group-hover:shadow-[0_8px_20px_rgba(232,32,42,0.4)] lg:mt-auto lg:pt-2"
              >
                {it.cta} <span aria-hidden="true">→</span>
              </a>
            </div>
          </div>
        </article>
      ))
    }
  </div>
</section>
