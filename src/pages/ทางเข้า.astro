---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import { pageGraph } from "../lib/schema";

const pageDescription =
  "ทางเข้า OKG777 เว็บหลัก รวมสล็อต คาสิโนสด และกีฬาในบัญชีเดียว พร้อมวิธีตรวจ 4 จุดก่อนล็อกอิน ทั้งชื่อเว็บไซต์ การเชื่อมต่อ HTTPS โลโก้ และปลายทางของปุ่ม";

const graph = pageGraph(Astro, {
  name: "ทางเข้า OKG777 ต้องตรวจ 4 จุดก่อนล็อกอิน",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทางเข้า", path: "/ทางเข้า" },
  ],
});
---

<MainLayout title="ทางเข้า OKG777 เว็บหลัก ตรวจชื่อเว็บไซต์ HTTPS และปลายทางปุ่มก่อนเข้าสู่ระบบ" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="ทางเข้า OKG777 ต้องตรวจ 4 จุดก่อนล็อกอิน" as="h1">
    <div class="mb-5 grid grid-cols-1 gap-8 md:grid-cols-2">
      <div class="flex flex-col items-center justify-center gap-4">
        <a
          href="/login"
          aria-label="เข้าสู่ระบบ OKG777"
          class="group relative mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#ffd400]/60 bg-[#170733] px-6 py-4 shadow-[0_10px_30px_rgba(255,212,0,0.18)] transition-all duration-300 hover:scale-105 hover:border-[#ff4fd8] hover:bg-[#231045] hover:shadow-[0_15px_40px_rgba(255,79,216,0.30)]">
          <div aria-hidden="true" class="absolute inset-x-0 top-0 h-1/2 bg-gradient-to-b from-[#ffd400]/20 to-transparent"></div>

          <svg
            class="relative z-10 h-9 w-9 text-[#ff4fd8]"
            aria-hidden="true"
            focusable="false"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            viewBox="0 0 24 24"
            xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"></path>
          </svg>

          <span class="relative z-10 text-3xl font-bold tracking-wide text-[#ffe94d]">เข้าสู่ระบบ</span>
        </a>
      </div>

      <div class="flex flex-col items-center justify-center gap-4">
        <a
          href="/register"
          aria-label="สมัครสมาชิก OKG777"
          class="group relative mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#ffd400]/60 bg-gradient-to-r from-[#ffe94d] via-[#ff4fd8] to-[#8f1080] px-6 py-4 shadow-[0_10px_30px_rgba(255,212,0,0.18)] transition-all duration-300 hover:scale-105 hover:shadow-[0_15px_40px_rgba(255,212,0,0.30)]">
          <div aria-hidden="true" class="absolute inset-x-0 top-0 h-1/2 bg-gradient-to-b from-white/55 to-transparent"></div>

          <svg
            class="relative z-10 h-9 w-9 text-[#1a0330]"
            aria-hidden="true"
            focusable="false"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            viewBox="0 0 24 24"
            xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"></path>
          </svg>

          <span class="relative z-10 text-3xl font-bold tracking-wide text-[#1a0330]">สมัครสมาชิก</span>
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
