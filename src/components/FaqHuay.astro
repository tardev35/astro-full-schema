---
export interface FAQ {
  q: string;
  a: string;
}

export interface Props {
  faqs?: FAQ[];
}

const {
  faqs = [
    {
      q: "หวยรัฐบาลไทยและหวยต่างประเทศ: ครบจบในที่เดียว HUAYPUNG",
      a: "เราเปิดรับแทงทั้งสลากกินแบ่งรัฐบาลไทย รวมถึงหวยต่างประเทศยอดนิยมอย่าง หวยลาว หวยฮานอย และหวยมาเลย์ คุณสามารถเลือกวางเลขได้ทุกรูปแบบ ทั้งสามตัวตรง สองตัวบน-ล่าง หรือเลขวิ่งตามสไตล์ที่คุณถนัด",
    },
    {
      q: "หวยหุ้นออนไลน์: ลุ้นสนุก ทำกำไรได้ทุกวัน",
      a: "สำหรับคอหวยที่ต้องการความถี่ในการลุ้นรางวัล หวยหุ้นคือทางเลือกที่ตอบโจทย์ที่สุด เพราะมีการออกผลรางวัลตามตลาดหลักทรัพย์ทั้งรอบเช้าและรอบบ่าย ทำให้คุณมีจังหวะทำกำไรได้ต่อเนื่องตลอดทั้งวันโดยไม่ต้องรอรอบใหญ่",
    },
    {
      q: "ระบบแทงหวยที่รองรับทุกเลขเด็ด ไม่มีปิดกั้น",
      a: "เที่ HUAYPUNG เราเข้าใจดีว่าทุกการแทงหวยคือโอกาส เราจึงออกแบบระบบให้รองรับทุกประเภทหวยที่คุณต้องการ ไม่ว่าจะเป็นหวยชุด หรือเลขเด็ดจากสำนักดังต่างๆ คุณสามารถกดส่งโพยได้ทุกเมื่อ ระบบไม่มีการปิดกั้น เพื่อให้คุณลุ้นโชคได้เต็มที่",
    },
  ],
} = Astro.props;
---

<section class="mx-auto mb-12 w-full max-w-4xl px-4 font-sans">
  <div class="mb-8 flex flex-col items-center justify-center text-center">
    <span class="text-4xl drop-shadow-[0_0_10px_rgba(251,191,36,0.8)]">❓</span>
    <h2 class="mt-3 bg-gradient-to-r from-yellow-300 to-yellow-600 bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase drop-shadow-sm">คำถามที่พบบ่อย (FAQ)</h2>
    <div class="mt-2 h-[2px] w-16 rounded-full bg-gradient-to-r from-transparent via-red-500 to-transparent"></div>
  </div>

  <div class="flex flex-col gap-4">
    {
      faqs.map((faq, index) => (
        <div class="faq-item group overflow-hidden rounded-2xl border border-red-700/40 bg-[#2a0404]/90 shadow-md backdrop-blur-md transition-all duration-300 hover:border-yellow-500/40 hover:bg-[#350505]">
          <button class="faq-btn flex w-full items-center justify-between p-5 text-left transition-colors outline-none">
            <span class="text-lg font-bold text-yellow-400 drop-shadow-sm transition-colors group-hover:text-yellow-300">{faq.q}</span>
            <span class="icon flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-red-500/30 bg-red-900/50 text-xl font-bold text-red-400 transition-all duration-300 group-hover:bg-yellow-500/20 group-hover:text-yellow-500">
              +
            </span>
          </button>

          <div class="faq-content grid grid-rows-[0fr] transition-[grid-template-rows] duration-300 ease-in-out">
            <div class="overflow-hidden">
              <p class="border-t border-red-800/50 bg-[#1a0202]/50 p-5 text-sm leading-relaxed text-red-100/80">{faq.a}</p>
            </div>
          </div>
        </div>
      ))
    }
  </div>
</section>

<script>
  const faqItems = document.querySelectorAll(".faq-item");

  faqItems.forEach((item) => {
    const btn = item.querySelector(".faq-btn");
    const content = item.querySelector(".faq-content");
    const icon = item.querySelector(".icon");

    btn?.addEventListener("click", () => {
      const isOpen = content?.classList.contains("grid-rows-[1fr]");

      document.querySelectorAll(".faq-content").forEach((c) => c.classList.remove("grid-rows-[1fr]"));
      document.querySelectorAll(".icon").forEach((i) => {
        i.classList.remove("rotate-45", "text-yellow-400", "bg-yellow-500/20", "border-yellow-500/50");
        i.textContent = "+";
      });
      document.querySelectorAll(".faq-item").forEach((i) => i.classList.remove("border-yellow-500/50", "shadow-[0_0_15px_rgba(251,191,36,0.2)]"));

      if (!isOpen) {
        content?.classList.add("grid-rows-[1fr]");
        icon?.classList.add("rotate-45", "text-yellow-400", "bg-yellow-500/20", "border-yellow-500/50");
        item.classList.add("border-yellow-500/50", "shadow-[0_0_15px_rgba(251,191,36,0.2)]");
      }
    });
  });
</script>
<style>
  .font-sans {
    font-family: "Kanit", sans-serif;
  }
</style>
