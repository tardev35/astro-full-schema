---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import CtaRedirect from "../components/CtaRedirect.astro";
import { pageGraph } from "../lib/schema";

const pageTitle = "สมัครสมาชิก PAYDAY24 | ปุ่มเปิดยูสใหม่ผ่านมือถือ เล่นครบในบัญชีเดียว";

const pageDescription =
  "หากคุณกำลังมองหาเว็บที่สมัครง่าย PAYDAY24 พร้อมมอบปุ่มเปิดยูสใหม่ผ่านมือถือ เพื่อเข้าเล่นสล็อต คาสิโนสด หวย และกีฬาในบัญชีเดียว ฝากถอนออโต้ รองรับ True Wallet";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "สมัครสมาชิก", path: "/register" },
  ],
});

const targetUrl = "https://yoalink.com/22hs";
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="สมัครสมาชิก PAYDAY24" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label="สมัครสมาชิก PAYDAY24"
        class="group relative mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#a86f00] bg-gradient-to-r from-[#ffe680] via-[#fdc700] to-[#d99400] px-6 py-4 text-xl font-bold tracking-wide text-[#150726] shadow-[0_10px_30px_rgba(253,199,0,0.26)] transition-all duration-300 hover:scale-105 hover:border-[#ffe680] hover:shadow-[0_15px_40px_rgba(253,199,0,0.35)]">
        สมัครสมาชิก PAYDAY24
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="สมัครสมาชิก" />
</MainLayout>
