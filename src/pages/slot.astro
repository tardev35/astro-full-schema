    games: ["Fortune Gems", "Money Coming"],
    img: imgJili,
    alt: "โลโก้ JILI กับนักรบชุดทองถือขวานพู่สี",
  },
  {
    tagline: "Joker Gaming",
    name: "Joker Gaming สนามกลาดิเอเตอร์ของ Roma",
    desc: "Roma (โรม่า) ให้กลาดิเอเตอร์เป็นไวลด์ สแกตเตอร์ขึ้นครบ 3 ตัวเมื่อไรได้ฟรีสปิน และในรอบนั้นยังมีโบนัสสู้สิงโตรออยู่",
    games: ["Roma"],
    img: imgJoker,
    alt: "โลโก้ Joker กับนักรบกลาดิเอเตอร์สวมหมวกเกราะหน้าสนามโคลอสเซียม",
  },
