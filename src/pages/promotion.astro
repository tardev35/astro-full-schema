---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement2.astro";

import { Picture } from "astro:assets";

import pro1 from "../assets/slide1.png";
import pro2 from "../assets/slide2.png";
import pro3 from "../assets/slide3.png";
import pro4 from "../assets/slide4.png";
import { pageGraph } from "../lib/schema";

const pageTitle = "โปรโมชั่น WON22 รวมสิทธิ์สมาชิก ฝากประจำ เครดิตฟรี ไม่ติดเทิร์น";

const pageHeading = "โปรโมชั่น WON22 รวมสิทธิ์สำหรับสมาชิก";

const pageDescription =
  "รวมภาพโปรโมชั่น WON22 ทั้งฝากประจำครบ 7 วันรับเครดิตฟรี 300 บาท ฝากถอนออโต้ ไม่ติดเทิร์น และสิทธิ์สมาชิกใหม่ ดูยอดรับกับเงื่อนไขบนภาพก่อนกดสมัครใช้สิทธิ์";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: pro1.src,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageHeading} as="h1">
    <p class="mb-4 text-left text-base leading-relaxed text-[#f8e3d2]">
      อยากได้โปรที่ดูจบในหน้าเดียวว่ารับอะไรได้บ้าง <strong class="text-[#fbbf24]">WON22</strong> รวมสิทธิ์สำหรับสมาชิกไว้ให้ครบ ทั้งฝากประจำครบ 7 วันรับเครดิตฟรี
      ระบบฝากถอนออโต้ และแนวทางไม่ติดเทิร์นตามเงื่อนไขที่ระบบกำหนด
    </p>

    <p class="mb-8 text-left text-base leading-relaxed text-[#f8e3d2]">
      ยอดรับและเงื่อนไขพิมพ์ไว้บนภาพทุกใบ เลือกใบที่ตรงกับทุนและสไตล์เล่นของคุณ แล้วสมัครยูสเดียวใช้สิทธิ์ต่อจากหน้าเมมเบอร์ได้ยาว ๆ
    </p>

    <div class="grid w-full grid-cols-1 gap-6 sm:grid-cols-2">
      <Picture
        src={pro1}
        alt="ภาพโปรโมชั่น WON22 โทนส้มไฟและทองบนพื้นดำ พรีเซนเตอร์หญิงสวมสูทดำสลับส้มชี้มือขึ้นด้านบน ข้อความบนภาพเขียนว่า ฝากประจำสัปดาห์ ต่อเนื่องครบ 7 วัน รับทันที เครดิตฟรี 300฿ มีโลโก้ WON22 สีทองบนริบบิ้นแดง และแถบด้านล่างเขียนว่า ระบบออโต้ เล่นผ่านมือถือ เข้าเกมไว"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class="mx-auto h-auto w-full rounded-xl border border-[#6b2f0b] object-contain shadow-[0_10px_30px_rgba(249,115,22,0.16)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#f97316]/50 hover:shadow-[0_15px_40px_rgba(249,115,22,0.26)]"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />

      <Picture
        src={pro2}
        alt="ภาพโปรโมชั่น WON22 พื้นดำโทนส้มทอง มีมงกุฎทองและคำว่า WON TO WIN อยู่เหนือหัวข้อ เกมสล็อต ออนไลน์เว็บตรง พรีเซนเตอร์หญิงชุดซาตินสีแดงสนิมยืนอยู่ด้านขวา ถัดมาเป็นสี่หัวข้อไอคอนทอง ฝากถอนออโต้ รวดเร็ว ทันใจ 24 ชม. ไม่ติดเทิร์น เล่นง่าย ถอนได้จริง สมัครง่าย ไม่กี่ขั้นตอน เล่นได้ทันที และ โปรโมชั่นจัดเต็ม โบนัสเยอะ ให้ทุกวัน แถบด้านล่างเขียนว่า เว็บตรง ปลอดภัย เกมสล็อต ครบทุกค่าย รองรับมือถือ เล่นได้ทุกที่"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class="mx-auto h-auto w-full rounded-xl border border-[#6b2f0b] object-contain shadow-[0_10px_30px_rgba(249,115,22,0.16)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#f97316]/50 hover:shadow-[0_15px_40px_rgba(249,115,22,0.26)]"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />

      <Picture
        src={pro3}
        alt="ภาพโปรโมชั่น WON22 พื้นดำโทนส้มทอง มีมงกุฎทองและคำว่า WON TO WIN อยู่เหนือหัวข้อ เกมสล็อตออนไลน์ เว็บตรง ฝากถอน ไม่ติดเทิร์น สมัครง่าย พรีเซนเตอร์หญิงถือโทรศัพท์มือถืออยู่ด้านขวา พร้อมห้าหัวข้อไอคอนทอง ฝากถอนออโต้ ไม่ติดเทิร์น สมัครง่าย โปรโมชั่นจัดเต็ม และ รองรับมือถือ แถบด้านล่างเขียนว่า เว็บตรง ปลอดภัย 100% เกมสล็อต ครบทุกค่าย มั่นคง ปลอดภัย ข้อมูลไม่รั่วไหล"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class="mx-auto h-auto w-full rounded-xl border border-[#6b2f0b] object-contain shadow-[0_10px_30px_rgba(249,115,22,0.16)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#f97316]/50 hover:shadow-[0_15px_40px_rgba(249,115,22,0.26)]"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />

      <Picture
        src={pro4}
        alt="ภาพโปรโมชั่น WON22 พื้นดำโทนส้มทอง มีมงกุฎทองและคำว่า WON TO WIN อยู่เหนือหัวข้อ เกมสล็อต ออนไลน์เว็บตรง ฝากถอน ไม่ติดเทิร์น สมัครง่าย พรีเซนเตอร์หญิงถือโทรศัพท์มือถืออยู่ด้านขวา พร้อมสี่หัวข้อไอคอนทอง ฝากถอนออโต้ ไม่ติดเทิร์น สมัครง่าย และ โปรโมชั่นจัดเต็ม แถบด้านล่างเขียนว่า เว็บตรง ปลอดภัย มั่นใจได้ เกมสล็อต ครบทุกค่าย รองรับมือถือ เล่นได้ทุกที่ ทุกเวลา"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class="mx-auto h-auto w-full rounded-xl border border-[#6b2f0b] object-contain shadow-[0_10px_30px_rgba(249,115,22,0.16)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#f97316]/50 hover:shadow-[0_15px_40px_rgba(249,115,22,0.26)]"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />
    </div>

    <div class="mt-12 flex justify-center pb-4">
      <a
        href="/register"
        class="flex items-center justify-center rounded-lg border border-[#f97316]/40 bg-gradient-to-r from-[#fcd34d] via-[#fbbf24] to-[#fde68a] px-10 py-3.5 text-lg font-black text-[#241004] shadow-[0_10px_30px_rgba(249,115,22,0.24)] transition-transform hover:scale-105 hover:shadow-[0_15px_40px_rgba(251,191,36,0.30)]">
        สมัครสมาชิก WON22
      </a>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
