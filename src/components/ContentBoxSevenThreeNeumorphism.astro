---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;
const rightHeading = titleright ?? title;
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="w-full rounded-[25px] border border-[#f5c542]/45 bg-[#1f0405] p-8 shadow-[10px_10px_20px_#0f0101,-10px_-10px_20px_#3a0a0d] transition-all duration-300 hover:shadow-[15px_15px_30px_#0f0101,-15px_-15px_30px_#5c0b13]">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#d4b59a]">
        {titleleft && <p class="text-2xl leading-normal font-black text-[#ffdf80]">{titleleft}</p>}
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f7e6d0] md:border-l md:border-[#f5c542]/35 md:pl-8">
        {rightHeading && <HeadingTag class="text-2xl leading-normal font-black text-[#ffdf80]">{rightHeading}</HeadingTag>}
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
