---
const {
  message = "ANDAMAN168 รวมบาคาร่า สล็อต ฟุตบอล และคาสิโนไว้ในบัญชีสมาชิกเดียว • แต่ละหมวดแยกให้เห็นชัด เข้าเกมที่ต้องการได้โดยไม่ต้องไล่เปิดเมนูทีละชั้น • ระบบออโต้จัดการฝากถอนและเช็กยอดได้ตลอด 24 ชั่วโมง • หน้าสมาชิกรวมเครดิต โปรโมชั่น และประวัติรายการไว้จุดเดียว • สมัครผ่านมือถือไม่กี่ขั้นตอนแล้วเลือกเกมต่อได้ทันที",
} = Astro.props;
---

<div class="mx-auto w-full max-w-7xl px-4 py-3 font-sans">
  <div class="relative overflow-hidden rounded-md border border-[#fdb524]/45 bg-[#062a4f] shadow-[0_0_15px_rgba(33,212,242,0.18)]">
    <div class="absolute top-0 -left-4 h-full w-8 -skew-x-12 bg-gradient-to-b from-[#7fe6ff] to-[#0a9ceb]"></div>
    <div class="absolute top-0 -right-4 h-full w-8 -skew-x-12 bg-[#ffe999]/20"></div>

    <div class="flex items-center">
      <div class="relative z-10 flex w-12 shrink-0 items-center justify-center bg-gradient-to-b from-[#7fe6ff] to-[#0a9ceb] py-2.5">
        <span aria-hidden="true" class="animate-pulse text-lg drop-shadow-[0_0_5px_rgba(255,233,153,0.85)]">🔔</span>
      </div>

      <div class="marquee-container relative flex-1 overflow-hidden py-2.5 pr-6">
        <div class="pointer-events-none absolute top-0 left-0 z-10 h-full w-8 bg-gradient-to-r from-[#062a4f] to-transparent"></div>
        <div class="pointer-events-none absolute top-0 right-0 z-10 h-full w-12 bg-gradient-to-l from-[#062a4f] to-transparent"></div>

        <div class="marquee-content inline-block pl-4 text-sm font-bold tracking-wide whitespace-nowrap text-[#ffe999]">
          <span class="mr-8 inline-flex items-center gap-2"><span class="h-1.5 w-1.5 rounded-full bg-[#21d4f2] shadow-[0_0_5px_rgba(33,212,242,0.85)]"></span>{message}</span>
          <span class="mr-8 inline-flex items-center gap-2"><span class="h-1.5 w-1.5 rounded-full bg-[#21d4f2] shadow-[0_0_5px_rgba(33,212,242,0.85)]"></span>{message}</span>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .marquee-content {
    animation: marquee 25s linear infinite;
  }
  .marquee-container:hover .marquee-content {
    animation-play-state: paused;
  }
  @keyframes marquee {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee-content {
      animation: none;
    }
  }
</style>
