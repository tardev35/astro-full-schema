---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";
---

<section class="my-6 flex w-full justify-center px-4 font-sans">
  <div
    class="relative isolate w-full max-w-7xl border border-[#16305f] bg-[#03091f] p-8 text-left text-base leading-relaxed text-[#f5e7c2] shadow-[0_10px_30px_rgba(247,208,70,0.18)]"
    style="clip-path: polygon(40px 0, 100% 0, 100% calc(100% - 40px), calc(100% - 40px) 100%, 0 100%, 0 40px);">
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-1 w-32 bg-gradient-to-r from-[#f7d046] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-1 w-32 bg-gradient-to-l from-[#ffd83a] to-transparent"></div>
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-32 w-1 bg-gradient-to-b from-[#f7d046] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-32 w-1 bg-gradient-to-t from-[#ffd83a] to-transparent"></div>

    {
      title && (
        <header class="mb-8 border-l-4 border-[#f7d046] pl-6">
          <HeadingTag class={`bg-gradient-to-r from-[#ffe89a] via-[#ffd83a] to-[#b8890f] bg-clip-text ${headingSize} leading-normal font-black text-transparent uppercase`}>{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
