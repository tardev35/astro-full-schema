---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";
import { pageGraph } from "../lib/schema";

const pageTitle = "เกี่ยวกับเรา BUNNY555 สล็อตเว็บตรง รวมเกมค่ายใหญ่ โบนัส และ True Wallet";

const pageDescription =
  "เกี่ยวกับเรา BUNNY555 หน้ารวมข้อมูลสล็อตเว็บตรงที่ให้บริการเกมค่ายใหญ่ PG Slot และ JILI พร้อมอธิบายระบบสมาชิก โบนัส และการฝากถอนผ่าน True Wallet บนมือถือ";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox as="h1" title={pageTitle}>
    <p class="mb-4 text-left text-base leading-relaxed text-[#7a1038]">
      <strong class="text-[#be185d]">BUNNY555</strong> เป็นสล็อตเว็บตรงที่วางเกมจากค่ายใหญ่ไว้เป็นหมวดหลัก รวมการเลือกค่าย เข้าเกม เช็กเครดิต และดูประวัติรายการไว้ในบัญชีเดียว
      สมาชิกเข้าสู่ระบบครั้งเดียวแล้วเลือกเกมที่ติดตาม ดูโบนัสที่เปิดอยู่ หรือจัดการข้อมูลบัญชีต่อได้ทันที ทั้งบนมือถือและคอมพิวเตอร์ จึงสลับระหว่าง PG Slot กับ JILI ได้โดยไม่ต้องเริ่มใหม่หลายรอบ
    </p>

    <p class="text-left text-base leading-relaxed text-[#7a1038]">
      หน้านี้ทำหน้าที่เป็นหน้าข้อมูลและแนะนำตัว อธิบายว่าเรารวมค่ายเกมไหนไว้บ้าง วางระบบสมาชิก โบนัส และการฝากถอนผ่าน True Wallet ไว้อย่างไร และเหมาะกับคนเล่นสล็อตแบบไหน
      เพื่อให้อ่านแล้วนำไปเทียบกับสิ่งที่เห็นในหน้าสมาชิกจริงได้ เกมมีให้เลือกเยอะเป็นเรื่องดี แต่หน้าเว็บไม่ควรทำให้การหาเกมกลายเป็นงานอีกชิ้นหนึ่ง
    </p>
  </ContentBox>

  <ContentBox as="h2" title="BUNNY555 รวมสล็อตค่ายใหญ่ค่ายไหนไว้ให้เลือกบ้าง">
    <p class="mb-4 text-left text-base leading-relaxed text-[#7a1038]">
      เรารวมสล็อตจากหลายค่ายไว้ในหมวดเดียว โดย PG Slot และ JILI เป็นชื่อที่พบเด่นในกลุ่มเกมของแบรนด์ พร้อมพื้นที่สำหรับเกมใหม่ที่ทยอยเพิ่มเข้ามาระหว่างปี
      สมาชิกจึงเลือกค่ายก่อนแล้วค่อยไล่หาเกมที่ชอบได้จากบัญชีเดียว ทุกค่ายเข้าถึงได้จากเมนูหลักบนมือถือ ไม่ต้องเปิดหลายเว็บเพื่อเปลี่ยนไปเล่นอีกค่ายหนึ่ง
    </p>

    <p class="text-left text-base leading-relaxed text-[#7a1038]">
      การมีหลายค่ายช่วยให้เปลี่ยนเกมได้ตามอารมณ์ วันนี้สายฟีเจอร์ พรุ่งนี้สายคลาสสิกก็ได้ หมวดหมู่จึงถูกแบ่งไว้ชัดเพื่อให้เห็นว่าค่ายไหนมีเกมแนวใดให้เลือก
      ความหรูไม่ได้อยู่ที่จำนวนเกมอย่างเดียว แต่อยู่ที่เลือกแล้วเข้าเล่นได้เลย
    </p>
  </ContentBox>

  <ContentBox as="h2" title="PG Slot กับ JILI บน BUNNY555 เล่นต่างกันอย่างไร">
    <p class="mb-4 text-left text-base leading-relaxed text-[#7a1038]">
      ฝั่ง PG Slot เด่นเรื่องเกมธีมแฟนตาซี ภาพเคลื่อนไหวจัดเต็ม และฟีเจอร์ฟรีสปินที่มีเงื่อนไขเข้าโบนัสต่างกันไปในแต่ละเกม คนที่ชอบไล่ดูฟีเจอร์จึงมีของให้ลองอยู่เรื่อย ๆ
      เกมสวยช่วยให้เล่นเพลิน แต่สิ่งที่ควรดูก่อนกดหมุนคือเดิมพันต่อรอบ ไม่ใช่ความอลังการของฉากเปิด
    </p>

    <p class="text-left text-base leading-relaxed text-[#7a1038]">
      ฝั่ง JILI เน้นเกมที่เข้าใจง่าย รอบสั้น และกติกาตรงไปตรงมา เหมาะกับคนที่อยากเล่นสั้น ๆ ระหว่างวัน สมาชิกเลือกค่ายจากเมนูเดียวแล้วสลับไปมาได้โดยไม่ต้องออกจากระบบ
      ตัวเลือกเยอะควรสร้างความสนุก ไม่ใช่สร้างงานประจำให้นิ้วโป้ง
    </p>
  </ContentBox>

  <ContentBox as="h2" title="ระบบสมาชิกและโบนัสของ BUNNY555 ดูแลเครดิตอย่างไร">
    <p class="mb-4 text-left text-base leading-relaxed text-[#7a1038]">
      หน้าสมาชิกรวมเครดิต โบนัส และประวัติรายการไว้ในพื้นที่เดียว ทำให้ตรวจสอบได้ว่ามีรายการไหนทำไปแล้ว ใช้สิทธิ์โปรใดอยู่ และยอดคงเหลือเป็นเท่าไร
      คนที่เล่นหลายค่ายหรือใช้หลายโปรจึงยังตามข้อมูลของตัวเองได้ง่าย ของสำคัญควรมีที่อยู่ชัด โดยเฉพาะเครดิต เรื่องนี้ไม่เหมาะกับเกมซ่อนหา
    </p>

    <p class="text-left text-base leading-relaxed text-[#7a1038]">
      โบนัสจัดไว้เป็นส่วนหนึ่งของระบบสมาชิก โดยสิทธิ์แต่ละช่วงอาจต่างกันทั้งรูปแบบการรับและเงื่อนไขการใช้งาน จึงควรเช็กโปรที่เปิดอยู่ก่อนเลือกใช้ทุกครั้ง
      คำว่าโบนัสไหลทุกชั่วโมงฟังแล้วสดชื่น แต่ของจริงต้องดูเงื่อนไขประกบเสมอ ไม่จำเป็นต้องรับทุกอันเหมือนของแจกหน้าออฟฟิศ
    </p>
  </ContentBox>

  <ContentBox as="h2" title="ฝากถอนผ่าน True Wallet กับการเข้าเล่นทำจากที่เดียวได้ไหม">
    <p class="mb-4 text-left text-base leading-relaxed text-[#7a1038]">
      True Wallet เป็นช่องทางสำหรับจัดการเครดิตผ่านมือถือ ทำให้สมาชิกฝากถอนแล้วกลับเข้าเกมต่อจากอุปกรณ์เดิมได้โดยไม่ต้องสลับหลายแอป
      ระบบเชื่อมรายการเข้ากับบัญชีสมาชิกโดยตรง จึงดูยอดและประวัติได้จากจุดเดียว เงินควรเคลื่อนที่เร็ว ส่วนเจ้าของเงินควรนั่งสบาย ๆ
    </p>

    <p class="text-left text-base leading-relaxed text-[#7a1038]">
      การสมัครสมาชิกทำผ่านมือถือได้ตั้งแต่กรอกข้อมูล ตั้งค่าบัญชี ไปจนถึงยืนยันตามขั้นตอนของระบบ หลังจากนั้นจึงเข้าสู่หน้าสมาชิกเพื่อเลือกสล็อตหรือดูโบนัสต่อได้
      และขอย้ำเสมอว่าไม่ควรส่งรหัสผ่านหรือรหัส OTP ให้บุคคลอื่นไม่ว่ากรณีใด เพราะทีมงานจริงไม่มีความจำเป็นต้องขอสองสิ่งนี้
    </p>
  </ContentBox>

  <ContentBox as="h2" title="BUNNY555 เหมาะกับคนเล่นสล็อตแบบไหน">
    <p class="mb-4 text-left text-base leading-relaxed text-[#7a1038]">
      BUNNY555 เหมาะกับคนที่ชอบสล็อตหลายค่าย โดยเฉพาะสาย PG Slot และ JILI และต้องการระบบสมาชิก โบนัส กับ True Wallet ไว้ในบัญชีเดียว
      เลือกค่ายที่ชอบ เช็กโปรที่เหมาะ แล้วจัดการเครดิตจากมือถือได้เลย มีหลายเกมไว้เลือกเป็นเรื่องดี มีหลายบัญชีไว้จำไม่ค่อยมีประโยชน์
    </p>

    <p class="text-left text-base leading-relaxed text-[#7a1038]">
      ส่วนทางเข้าเว็บหลักรองรับทั้งมือถือและคอม สมาชิกใช้บัญชีเดิมเข้าถึงสล็อต ระบบสมาชิก โบนัส และการจัดการเครดิตได้จากช่องทางเดียว
      การใช้ช่องทางหลักยังช่วยลดความสับสนจากชื่อเว็บไซต์ใกล้เคียงบนผลค้นหา คนมีเวลามีค่าไม่ควรใช้มันกับการสุ่มว่าลิงก์ไหนของจริง
    </p>
  </ContentBox>

  <Navfoot />
</MainLayout>
