---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementCyber.astro";
import CtaRedirect from "../components/CtaRedirect.astro";
import { pageGraph } from "../lib/schema";

const pageDescription =
  "เข้าสู่ระบบ TEMMAX69 หน้าล็อกอินเว็บหลัก กดปุ่มเดียวเข้าบัญชีเดิมด้วยมือถือ เลือกเกมสล็อต เช็กเครดิต ดูโบนัสสมาชิก และตรวจประวัติฝากถอนผ่านระบบออโต้ได้ทันที";

const graph = pageGraph(Astro, {
  name: "เข้าสู่ระบบ TEMMAX69 เว็บหลัก",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เข้าสู่ระบบ", path: "/login" },
  ],
});

const targetUrl = "https://yoalink.com/22hs";
---

<MainLayout title="เข้าสู่ระบบ TEMMAX69 | ล็อกอินเว็บหลัก สล็อตและวอเลท" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="เข้าสู่ระบบ TEMMAX69" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label="เข้าระบบเกม"
        class="group relative mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#22d3ee]/60 bg-[#160735] px-6 py-4 text-xl font-bold tracking-wide text-[#67e8f9] shadow-[0_10px_30px_rgba(168,85,247,0.35)] transition-all duration-300 hover:scale-105 hover:border-[#a855f7] hover:bg-[#35107a] hover:text-[#c084fc] hover:shadow-[0_15px_40px_rgba(34,211,238,0.30)]">
        เข้าระบบเกม
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="เข้าสู่ระบบ" />
</MainLayout>
