---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";

import { Picture } from "astro:assets";

import pro1 from "../assets/slide1.png";
import pro2 from "../assets/slide2.png";
import pro3 from "../assets/slide3.png";
import pro4 from "../assets/slide4.png";
import pro5 from "../assets/slide5.png";
import { pageGraph } from "../lib/schema";

const pageTitle = "โปรโมชั่น BABYSHARK8899 โบนัสฝาก 50% ฝากรับเพิ่ม 10% และคืนยอดเล่น 0.3%";

const pageHeading = "โปรโมชั่นและสิทธิ์สมาชิก BABYSHARK8899";

const pageDescription =
  "รวมภาพโปรโมชั่นของ BABYSHARK8899 ทั้งโบนัสฝาก 50% ฝากรับเพิ่ม 10% คืนยอดเล่น 0.3% และสิทธิ์แนะนำเพื่อน ระบุยอดรับ เงื่อนไขเทิร์น และยอดถอนสูงสุดไว้บนภาพครบทุกใบ";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: pro1.src,
});

const promoClass =
  "mx-auto h-auto w-full rounded-xl border border-[#0a2258] object-contain shadow-[0_10px_30px_rgba(11,131,250,0.16)] transition-all duration-300 hover:-translate-y-1 hover:border-[#0b83fa]/55 hover:shadow-[0_15px_40px_rgba(11,131,250,0.28)]";
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageHeading} as="h1">
    <p class="mb-4 text-left text-base leading-relaxed">
      หากคุณกำลังมองหาโปรที่ระบุเงื่อนไขไว้ครบตั้งแต่ก่อนสมัคร <strong class="text-[#6cc5ff]">BABYSHARK8899</strong> รวมโบนัสฝาก โปรฝากรับเพิ่ม สิทธิ์คืนยอดเล่น และรายได้จากการแนะนำเพื่อนไว้ในภาพด้านล่างนี้แล้ว
    </p>

    <p class="mb-8 text-left text-base leading-relaxed">
      ยอดรับ เงื่อนไขเทิร์น และยอดถอนสูงสุดเขียนไว้บนภาพทุกใบ เลือกใบที่ตรงกับงบและสไตล์การเล่นของคุณ แล้วสมัครยูสเดียวใช้ได้ทุกสิทธิ์ เพื่อประสบการณ์ที่คุ้มค่ากว่าเดิม
    </p>

    <div class="grid w-full grid-cols-1 gap-6 sm:grid-cols-2">
      <Picture
        src={pro1}
        alt="ภาพโปรโมชั่นพื้นฟ้า-ขาว หัวข้อ EXCLUSIVE ฝากรับโบนัสเพิ่ม 10% โลโก้ BABYSHARK8899 มุมซ้ายบน ระบุมูลค่าสูงสุด 500 บาท ยอดฝากขั้นต่ำ 100 บาทต่อบิล ทำเทิร์น 8 เท่า ถอนสูงสุด 5 เท่า จำกัดการรับสูงสุดไม่เกิน 500 บาท ครอบคลุมทั้งสมาชิกเก่าและสมาชิกใหม่ พร้อมตรา VIP EXCLUSIVE"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class={promoClass}
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />

      <Picture
        src={pro2}
        alt="ภาพโปรโมชั่นพื้นน้ำเงิน-แดง โลโก้ BABYSHARK8899 อยู่ด้านบน ข้อความ โบนัสฝาก 50% ล้อมด้วยเปลวไฟ ระบุฝาก 1,000 บาทขึ้นไปรับโบนัส 50% สูงสุด 10,000 บาท ทำเทิร์น 5 เท่า ถอนสูงสุด 2 เท่า"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class={promoClass}
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />

      <Picture
        src={pro3}
        alt="ภาพโปรโมชั่นหวยพื้นน้ำเงิน-แดง โลโก้ BABYSHARK8899 มุมซ้ายบน ระบุ 3 ตัวบาทละ 1000 และ 2 ตัวบาทละ 100 ข้อความ หวย อัตราจ่ายที่ดีที่สุด ถูกตรง จ่ายจริง ครบจบเรื่องหวยในเว็บเดียว รัฐบาล ลาว ฮานอย หุ้น ยี่กี่ ด้านขวาเป็นพรีเซนเตอร์หญิงสวมแจ็กเก็ตหนังสีดำ"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class={promoClass}
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />

      <Picture
        src={pro4}
        alt="ภาพโปรโมชั่นแนะนำเพื่อนพื้นขาว-แดง โลโก้ BABYSHARK8899 มุมซ้ายบน ข้อความ แนะนำเพื่อน 0.8% สร้างรายได้ 100,000 ต่อเดือน ด้านขวาเป็นพรีเซนเตอร์หญิงสองคนถือไพ่"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class={promoClass}
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />

      <Picture
        src={pro5}
        alt="ภาพโปรโมชั่นคืนยอดเล่นพื้นขาว-แดง โลโก้ BABYSHARK8899 มุมซ้ายบน ข้อความ COMMISSION 0.3% คืนทุกยอดเล่นตลอดทั้งวัน เล่นถึง 50% ถอนได้เลย รับสิทธิ์ก่อน 23.59 น. ของทุกวัน ยิ่งเล่นเยอะ ยิ่งได้เยอะ ด้านซ้ายเป็นพรีเซนเตอร์หญิงถือไพ่"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class={promoClass}
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />
    </div>

    <div class="mt-12 flex justify-center pb-4">
      <a
        href="/register"
        class="flex items-center justify-center rounded-lg border border-[#b0121a] bg-gradient-to-r from-[#ff4d4d] via-[#e8202a] to-[#b0121a] px-10 py-3.5 text-lg font-black text-white shadow-[0_10px_30px_rgba(232,32,42,0.24)] transition-transform hover:scale-105 hover:shadow-[0_15px_40px_rgba(232,32,42,0.34)]">
        สมัครสมาชิก BABYSHARK8899
      </a>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
