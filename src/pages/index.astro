---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/AnnouncementPremium.astro";
import ContentBox from "../components/ContentBox.astro";
import ContentBoxPremium from "../components/ContentBoxPremium.astro";
import ContentBoxCyberCut from "../components/ContentBoxCyberCut.astro";
import ContentBoxTwoPremium from "../components/ContentBoxTwoPremium.astro";
import ContentBoxSevenThreePremium from "../components/ContentBoxSevenThreePremium.astro";
import ContentBoxSevenThreeCyberCut from "../components/ContentBoxSevenThreeCyberCut.astro";
import Faq3 from "../components/Faq3.astro";
import SmoothCarousel from "../components/SmoothCarousel.astro";
import GameRankingBoard from "../components/GameRankingBoard.astro";
import ProviderGrid from "../components/ProviderGrid.astro";
import LatestWinnersPremium from "../components/LatestWinnersPremium.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import ReviewCardSumo2 from "../components/ReviewCardSumo2.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import imgWallet from "../assets/slide2.png";
import imgCashback from "../assets/slide4.png";

const pageTitle = "WINDRAGON สล็อตออนไลน์ ค่ายเด่นแตกโหด ฝากถอนออโต้ จ่ายไวเต็มยอด";

const pageDescription =
  "ทางเข้า WINDRAGON สล็อตออนไลน์ เล่นบนมือถือได้ครบ รวมค่ายเด่นแตกโหด ฝากถอนออโต้ไม่ง้อสลิป ยอดบวกจ่ายเต็ม โปรสุดคุ้มเสริมทุน เข้าเล่นได้วันนี้";

const announcementMessage = "WINDRAGON สล็อตออนไลน์ เล่นจบในมือถือ ฝากถอนออโต้ไม่ต้องส่งสลิป ยอดบวกโอนเต็มจำนวน พร้อมโปรสุดคุ้มเสริมทุนทุกวัน";

const walletAlt = "ฝาก-ถอนระบบอัตโนมัติ แค่ 1 บาทก็สนุกได้ รองรับทุกธนาคารและทรูวอเล็ท";

const cashbackAlt = "คืนยอดเสียทุกสัปดาห์ คืนให้สูงสุด 10,000.-";

const faqTitle = "ถามตรงตอบตรง เรื่องที่สายปั่นอยากรู้ก่อนเริ่มเล่นสล็อตออนไลน์";

const faqs = [
  {
    q: "ฝากเงินไปแล้ว เครดิตยังไม่ขึ้น ต้องทำยังไง",
    a: "ปกติไม่ต้องทำอะไรเลย ยอดจะเข้าเครดิตเองในไม่กี่วินาที ถ้ารอเกินนั้นแล้วยังไม่ขึ้น อย่าเพิ่งโอนซ้ำ จดเวลาที่โอนกับยอดเงินไว้ แล้วแจ้งทีมงานผ่านช่องทางติดต่อบนหน้าเว็บให้ตรวจรายการ",
  },
  {
    q: "ถอนเงินกับ WINDRAGON ต้องแนบสลิปหรือทักแอดมินก่อนไหม",
    a: "ไม่ต้องทั้งสองอย่าง กดถอนจากมือถือได้เอง ยอดที่ยืนยันจะโอนเข้าบัญชีเต็มจำนวนภายในไม่กี่วินาที จุดเดียวที่ต้องดูคือใช้บัญชีที่ชื่อตรงกับตอนสมัคร รายการจะไม่สะดุด",
  },
  {
    q: "ไม่มีคอม เล่นในมือถืออย่างเดียวได้ครบไหม",
    a: "ได้ครบ ตั้งแต่สมัคร ล็อกอิน เลือกค่าย ปั่น ไปจนถึงฝากถอน ทำจากสมาร์ทโฟนได้ทั้งหมด ใครเข้าเล่นบ่อยลองบุ๊กมาร์กทางเข้าไว้ในเบราว์เซอร์ จะเปิดกลับมาได้ในแตะเดียว",
  },
];

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});

const inlineLink = "font-bold text-[#ff9a4d] underline underline-offset-4 transition-colors hover:text-[#ffd77a]";
const slideFrame = "mx-auto h-auto w-full rounded-2xl border border-[#5a2a12] shadow-[0_10px_30px_rgba(242,107,29,0.22)]";
const cutFrame = "mx-auto h-auto w-full rounded-md border border-[#f26b1d]/40 shadow-[0_10px_30px_rgba(179,18,27,0.30)]";
const body = "text-left text-base leading-relaxed";
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement message={announcementMessage} />

  <SmoothCarousel />

  <ContentBoxPremium as="h1" title="WINDRAGON สล็อตออนไลน์ ค่ายเด่นแตกโหด ฝากถอนออโต้ ยอดบวกได้เต็ม">
    <p class={body}>
      สายปั่นที่ได้ยอดบวกแล้วยังต้องนั่งรอแอดมินโอน ลองย้ายมาปั่นกับ WINDRAGON ดูสักรอบ สล็อตออนไลน์ที่นี่เปิดจากสมาร์ทโฟนได้ตั้งแต่ทางเข้าจนถึงหน้าถอน ในล็อบบี้มีสล็อตค่ายเด่นสายแตกโหดให้เลือกตามทุน
      ฝากถอนออโต้กดทำรายการเองได้โดยไม่ต้องส่งสลิป ยอดบวกก้อนใหญ่ก็โอนเต็มจำนวนไม่หักเปอร์เซ็นต์ และยังมีโปรสุดคุ้มไว้เสริมทุนตอนอยากยืดรอบ เหมาะกับคนที่อยากเล่นให้จบในมือถือเครื่องเดียว
    </p>
  </ContentBoxPremium>

  <ContentBoxCyberCut as="h2" title="ทางเข้า WINDRAGON สล็อตออนไลน์ เปิดจากสมาร์ทโฟนแล้วเล่นได้ครบ">
    <p class={body}>
      คนที่ค้นหา<a href="/ทางเข้า/" class={inlineLink}>ทางเข้า WINDRAGON</a> ส่วนใหญ่แค่อยากกดแล้วได้เข้าเล่นเลย ที่นี่จึงให้ทุกขั้นทำจากสมาร์ทโฟนได้ครบ ตั้งแต่ล็อกอิน ฝากเงิน เลือกเกม ไปจนถึงกดถอน
      สมาชิกเดิมใช้บัญชีเดิมเข้าได้ทันทีแม้จะเปลี่ยนเครื่อง ไม่ต้องสมัครใหม่ ก่อนใส่รหัสผ่านทุกครั้งให้เช็กชื่อเว็บบนแถบที่อยู่ว่าสะกดตรงตัว จะได้ไม่หลงเข้าลิงก์ปลอม
    </p>
  </ContentBoxCyberCut>

  <LoginRtpSection />

  <ContentBox as="h2" title="รวมสล็อตค่ายเด่นแตกโหด เลือกเกมให้ตรงสายก่อนกดสปินรอบแรก">
    <p class={body}>
      แตกโหดในภาษาสายปั่นคือเกมที่อาจเงียบไปสักพัก แต่พอสแคตเตอร์ครบจนเข้าฟรีสปิน ตัวคูณจะพายอดขึ้นแรงกว่าเกมจ่ายถี่ WINDRAGON รวมสล็อตค่ายเด่นแนวนี้ไว้ ดูรายชื่อค่ายได้จากตารางด้านล่าง
      วิธีเลือกง่ายๆ คือหยิบเกมที่คุ้นมาสองสามเกม ดูช่วงเบทกับฟีเจอร์ก่อน แล้วเริ่มจากเบทต่ำเพื่อจับจังหวะ พอทุนพร้อมค่อยขยับขึ้นทีละขั้น
    </p>
  </ContentBox>

  <ProviderGrid />

  <GameRankingBoard />

  <ContentBoxSevenThreePremium as="h2" titleright="ฝากถอนออโต้ทำเองผ่านมือถือ ไม่ต้องส่งสลิป ไม่ต้องรอแอดมิน">
    <Picture
      slot="left"
      src={imgWallet}
      alt={walletAlt}
      loading="lazy"
      fetchpriority="low"
      widths={[340, 460, 600]}
      sizes="(max-width: 767px) calc(100vw - 98px), (max-width: 1279px) calc(40vw - 62px), 450px"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={70}
      class={slideFrame}
    />

    <p slot="right" class={body}>
      เคยไหมที่โอนเงินเสร็จแล้วต้องแคปสลิปส่งแชต รออีกพักใหญ่กว่าเครดิตจะขึ้น <a href="/วิธีฝากถอน/" class={inlineLink}>ระบบการเงินของ WINDRAGON</a> เป็นออโต้ทั้งขาเข้าและขาออก ผู้เล่นกดทำรายการเองในมือถือ ระบบตรวจยอดแล้วปรับเครดิตให้ในไม่กี่วินาที
      ไม่ต้องแนบหลักฐาน ไม่ต้องทักใครช่วยดัน ถอนก็แค่ใส่ยอดแล้วยืนยัน เหมาะกับคนที่อยากคุมจังหวะเงินเข้าออกเอง
    </p>
  </ContentBoxSevenThreePremium>

  <ContentBoxTwoPremium as="h2" title="ยอดบวกใหญ่แค่ไหน WINDRAGON ก็โอนเต็มจำนวน ไม่หักเปอร์เซ็นต์">
    <p slot="left" class={body}>
      คำถามที่สายปั่นถามก่อนสมัครแทบทุกเว็บคือ ถ้าแตกก้อนใหญ่จริงจะได้ครบไหม คำตอบของที่นี่คือได้ครบ ตัวเลขที่เห็นตอนกดถอนคือยอดที่เข้าบัญชีจริง
    </p>

    <p slot="right" class={body}>
      ไม่มีการตัดเปอร์เซ็นต์หรือค่าหักยิบย่อยโผล่มาตอนเงินออก และเพราะถอนผ่านระบบออโต้ ยอดจึงไม่ต้องค้างรอใครอนุมัติ รอบที่ลุ้นมาจากเกมแตกโหดเลยกลับมาถึงมือเต็มก้อน
    </p>
  </ContentBoxTwoPremium>

  <LatestWinnersPremium />

  <ContentBoxSevenThreeCyberCut as="h2" titleright="โปรสุดคุ้มของ WINDRAGON เสริมทุนให้มีรอบลุ้นนานขึ้น">
    <Picture
      slot="left"
      src={imgCashback}
      alt={cashbackAlt}
      loading="lazy"
      fetchpriority="low"
      widths={[340, 460, 600]}
      sizes="(max-width: 767px) calc(100vw - 98px), (max-width: 1279px) calc(40vw - 52px), 460px"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={70}
      class={cutFrame}
    />

    <p slot="right" class={body}>
      โชคเป็นเรื่องของรีลที่หมุน แต่ทุนเผื่อเป็นเรื่องที่เตรียมได้ก่อน โปรสุดคุ้มที่นี่ช่วยเติมเครดิตให้มีรอบปั่นมากขึ้นโดยไม่ต้องควักเงินเพิ่ม ก่อนกดรับให้อ่านสามเรื่องใน<a href="/promotion/" class={inlineLink}>หน้าโปรโมชั่น</a>
      คือใช้กับเกมไหนได้ ต้องมียอดเล่นเท่าไรก่อนถอน และหมดเขตเมื่อไร รู้ครบแล้วค่อยรับ จะได้ไม่เจอเงื่อนไขทีหลัง แค่นี้โปรก็กลายเป็นเวลาเล่นที่เพิ่มขึ้นจริงโดยไม่ต้องขยับงบ
    </p>
  </ContentBoxSevenThreeCyberCut>

  <Faq3 title={faqTitle} faqs={faqs} />

  <ContentBox>
    <p class={body}>
      WINDRAGON อาจมีมังกรอยู่ในชื่อ แต่เหตุผลที่น่าเล่นเป็นเรื่องที่จับต้องได้ เปิดจากมือถือแล้วเข้าเล่นได้ทันที มีค่ายเด่นสายแตกโหดให้เลือก ฝากถอนออโต้ไม่ต้องแนบสลิป ยอดบวกเข้าบัญชีครบไม่โดนตัด
      และมีโปรช่วยเติมทุนเวลาอยากเล่นต่อ ใครพร้อมก็<a href="/register/" class={inlineLink}>สมัคร</a>แล้วลองหมุนรอบแรกได้เลย
    </p>
  </ContentBox>

  <ReviewCardSumo2 title="เสียงจากสมาชิก WINDRAGON" />

  <Navfoot />
</MainLayout>
