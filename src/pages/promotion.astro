        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600]}
        sizes="(max-width: 768px) 100vw, 33vw"
        class="mx-auto h-auto w-full rounded-xl object-contain shadow-lg transition-transform duration-300 hover:-translate-y-1 hover:shadow-2xl"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />

      <Picture
        src={pro8}
        alt="รับโบนัสเงินคืนจากยอดเล่น คืนยอดเสีย โบนัส 0.3%"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600]}
