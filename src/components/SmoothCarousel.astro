---
import { Picture } from "astro:assets";

import slide1 from "../assets/slide1.png";
import slide2 from "../assets/slide2.png";

const images = [
  {
    src: slide1,
    alt: "ภาพโปรโมชั่น PIGAUTO โทนแดงตรุษจีนสลับทอง ด้านบนเป็นโลโก้หมูสีชมพูในเฟืองพร้อมคำว่า PIGAUTO มีโคมไฟจีนสีแดงห้อยลงมา พัดกระดาษสีทองกางอยู่ด้านหลัง ไพ่โพดำและไพ่หัวใจกระจายกลางภาพพร้อมชิปคาสิโนและเหรียญทอง ด้านซ้ายเป็นพรีเซนเตอร์หญิงสวมชุดกี่เพ้าสีแดงปักลายทอง ด้านล่างเป็นตัวอักษรสีขาวขอบทองว่า รองรับวอลเล็ท เต็มระบบ และแถบว่า pig auto wallet ใช้ง่าย",
  },
  {
    src: slide2,
    alt: "ภาพโปรโมชั่น PIGAUTO โทนแดงตรุษจีนสลับทอง ด้านบนเป็นโลโก้หมูสีชมพูในเฟืองพร้อมคำว่า PIGAUTO มีโคมไฟจีนสีแดงและพัดกระดาษสีทองเรียงอยู่ด้านหลัง ไพ่เอซ ชิปคาสิโน และเหรียญทองกระจายอยู่รอบภาพ ด้านขวาเป็นพรีเซนเตอร์หญิงสวมชุดกี่เพ้าสีแดงปักลายทอง ด้านล่างเป็นตัวอักษรสีขาวขอบทองว่า เว็บสล็อตออโต้ไม่มีขั้นต่ำ และแถบว่า เล่นได้อย่างเป็นมิตร ปลอดภัยสูง",
  },
];

const COPIES = 3;
const slides = Array.from({ length: COPIES }, () => images).flat();
---

<div class="marquee mx-auto w-full max-w-7xl overflow-hidden px-4 py-5">
  <input id="carousel-pause" type="checkbox" class="peer sr-only" />
  <label
    for="carousel-pause"
    class="sr-only cursor-pointer peer-focus-visible:not-sr-only peer-focus-visible:mb-3 peer-focus-visible:inline-block peer-focus-visible:rounded-full peer-focus-visible:border peer-focus-visible:border-[#ef4444]/60 peer-focus-visible:bg-[#280707] peer-focus-visible:px-4 peer-focus-visible:py-2 peer-focus-visible:text-sm peer-focus-visible:font-bold peer-focus-visible:text-[#ffe9a8]">
    หยุด / เล่นสไลด์ภาพ
  </label>

  <div class="marquee-track flex">
    {
      slides.map((slide, index) => {
        const isDuplicate = index >= images.length;
        return (
          <div class="marquee-slide" aria-hidden={isDuplicate ? "true" : undefined}>
            <Picture
              src={slide.src}
              alt={isDuplicate ? "" : slide.alt}
              class="block w-full rounded-xl border border-[#6b2020] object-cover shadow-[0_10px_30px_rgba(239,68,68,0.20)]"
              width={slide.src.width}
              height={slide.src.height}
              loading="lazy"
              fetchpriority="low"
              decoding="async"
              widths={[300, 360, 420, 480, 540, 600]}
              sizes="(max-width: 767px) calc(100vw - 32px), (max-width: 1279px) calc((100vw - 48px) / 2), 403px"
              formats={["avif", "webp"]}
              fallbackFormat="webp"
              quality={60}
            />
          </div>
        );
      })
    }
  </div>
</div>

<style>
  .marquee {
    --gap: 12px;
    --per-view: 1;
    --shift: calc(-200% - 24px);
  }

  @media (min-width: 768px) {
    .marquee {
      --gap: 16px;
      --per-view: 2;
      --shift: calc(-100% - 16px);
    }
  }

  @media (min-width: 1280px) {
    .marquee {
      --gap: 20px;
      --per-view: 3;
      --shift: calc(-66.6667% - 13.3333px);
    }
  }

  .marquee-track {
    gap: var(--gap);
    width: 100%;
    animation: carousel-scroll 24s linear infinite;
    will-change: transform;
  }

  .marquee-slide {
    flex: 0 0 calc((100% - (var(--per-view) - 1) * var(--gap)) / var(--per-view));
  }

  @keyframes carousel-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(var(--shift));
    }
  }

  .marquee:hover .marquee-track,
  .marquee:focus-within .marquee-track,
  .marquee > input:checked ~ .marquee-track {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
    }
  }
</style>
