---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
  label?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label } = Astro.props;

const sectionLabel = label ?? title ?? titleleft ?? titleright ?? "ข้อมูลประกอบ";
---

<section aria-label={sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#f6c9c6] bg-white p-8 text-[#2d1214] shadow-[0_10px_30px_rgba(230,0,18,0.12)] transition-all duration-500 hover:border-[#e60012]/45 md:p-10">
    {
      title && (
        <header class="mb-6 flex items-center gap-4 border-b border-[#f6c9c6] pb-4">
          <span aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#e60012] to-[#d4a017] shadow-[0_0_10px_rgba(230,0,18,0.35)]" />
          <HeadingTag class="bg-gradient-to-r from-[#8a0208] via-[#e60012] to-[#8a6410] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#2d1214]">
        {
          titleleft && (
            <p class="flex items-center gap-3 border-b border-[#f6c9c6] pb-3 text-xl leading-normal font-black tracking-widest text-[#8a0208] uppercase">
              <span
                aria-hidden="true"
                class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#b30009]/40 bg-gradient-to-br from-[#ff4b41] via-[#e60012] to-[#b30009] text-sm text-white shadow-[0_5px_15px_rgba(230,0,18,0.26)]">
                🔐
              </span>
              {titleleft}
            </p>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#2d1214]">
        {
          titleright && (
            <p class="flex items-center gap-3 border-b border-[#f6c9c6] pb-3 text-xl leading-normal font-black tracking-widest text-[#8a0208] uppercase">
              <span
                aria-hidden="true"
                class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#8a6410]/45 bg-gradient-to-br from-[#ffe9a8] via-[#f5c542] to-[#d4a017] text-sm text-[#2a0709] shadow-[0_5px_15px_rgba(212,160,23,0.28)]">
                📊
              </span>
              {titleright}
            </p>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
