---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
  label?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label } = Astro.props;

const sectionLabel = label ?? title ?? titleleft ?? titleright ?? "ข้อมูลประกอบ";
---

<section aria-label={sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  {
    title && (
      <header class="mb-6 flex items-center gap-4 border-b border-[#3b1a63] pb-4">
        <span aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#a855f7] to-[#f5c542] shadow-[0_0_10px_rgba(168,85,247,0.45)]" />
        <HeadingTag class="bg-gradient-to-r from-[#c084fc] via-[#e9d5ff] to-[#f5c542] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
      </header>
    )
  }

  <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#e7dcf7]">
      {
        titleleft && (
          <p class="flex items-center gap-3 border-b border-[#3b1a63] pb-3 text-xl leading-normal font-black tracking-widest text-[#ffe9a8] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#3b1a63] bg-gradient-to-br from-[#c084fc] via-[#a855f7] to-[#4c1d95] text-sm text-[#0b011b] shadow-[0_5px_15px_rgba(168,85,247,0.28)]">
              🔐
            </span>
            {titleleft}
          </p>
        )
      }
      <slot name="left" />
    </article>

    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#e7dcf7]">
      {
        titleright && (
          <p class="flex items-center gap-3 border-b border-[#3b1a63] pb-3 text-xl leading-normal font-black tracking-widest text-[#ffe9a8] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#3b1a63] bg-gradient-to-br from-[#ffd75e] via-[#f5c542] to-[#a3610c] text-sm text-[#0b011b] shadow-[0_5px_15px_rgba(245,197,66,0.28)]">
              📊
            </span>
            {titleright}
          </p>
        )
      }
      <slot name="right" />
    </article>
  </div>
</section>
