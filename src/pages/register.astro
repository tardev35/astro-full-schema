---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementCyber.astro";
import CtaRedirect from "../components/CtaRedirect.astro";
import { pageGraph } from "../lib/schema";

const pageTitle = "สมัครสมาชิก VODKAFUN | ปุ่มเปิดยูสใหม่ สล็อตเว็บตรงเว็บใหญ่ ไม่มีขั้นต่ำ";

const pageDescription =
  "หากคุณกำลังมองหาสล็อตเว็บตรงเว็บใหญ่ที่ไม่มีขั้นต่ำ VODKAFUN พร้อมมอบปุ่มสมัครสมาชิกเพียงปุ่มเดียว เพื่อเปิดยูสใหม่ฟรี เล่นได้ทุกอุปกรณ์ ฝากถอนผ่าน True Wallet";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "สมัครสมาชิก", path: "/register" },
  ],
});

const targetUrl = "https://yoalink.com/mojo";
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="สมัครสมาชิก VODKAFUN" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label="สมัครสมาชิก VODKAFUN"
        class="group relative mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#b3128a]/70 bg-gradient-to-b from-[#ff8fe0] to-[#ff3dc8] px-6 py-4 text-xl font-bold tracking-wide text-[#14042e] shadow-[0_10px_30px_rgba(255,61,200,0.26)] transition-all duration-300 hover:scale-105 hover:border-[#ff8fe0] hover:shadow-[0_15px_40px_rgba(255,61,200,0.38)]">
        สมัครสมาชิก VODKAFUN
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="สมัครสมาชิก" />
</MainLayout>
