---
const providers = [
  { name: "PG SOFT", desc: "กราฟิก 3D วิจิตรบรรจง เชื่อมตรงกับค่าย pg แบบลิขสิทธิ์แท้ ทุกการหมุนเป็นไปตามมาตรฐาน", tag: "ขวัญใจมหาชน", icon: "🎨" },
  { name: "Joker Gaming", desc: "ตำนานสล็อตยุคคลาสสิก มีเกมโรม่าอันเลื่องชื่อที่ยังแจกรางวัลอย่างสม่ำเสมอ", tag: "เก๋าและขลัง", icon: "🃏" },
  { name: "Pragmatic Play", desc: "ฟีเจอร์แพรวพราว มีลูกเล่นให้ลุ้นระทึกตลอดเวลา อัตราการจ่ายหนักหน่วงสมน้ำสมเนื้อ", tag: "ระดับสากล", icon: "💥" },
  { name: "สล็อตแตกง่าย", desc: "รวมเกมที่กติกาไม่ซับซ้อนซ่อนเงื่อน ถูกจริตพี่น้องชาวไทย เล่นแล้วเข้าใจได้ทันที", tag: "เล่นง่าย", icon: "🎰" },
  { name: "เกมฟีเจอร์ฟรีสปิน", desc: "สายลุ้นโบนัสเลือกหมวดนี้ได้เลย ตัวคูณซ้อนหลายชั้นตามจังหวะของเกมจริงๆ", tag: "ฟีเจอร์แน่น", icon: "🔥" },
  { name: "เกมคลาสสิกรอบสั้น", desc: "รูปแบบเข้าใจง่าย เหมาะกับท่านที่อยากเล่นในบรรยากาศไม่วุ่นวาย ไม่เร่ง ไม่กดดัน", tag: "สบายๆ", icon: "🍒" },
  { name: "เกมใหม่สำหรับมือถือ", desc: "เมนูภาษาไทยชัดเจน อ่านง่ายสบายตา รองรับทั้ง iOS และ Android ลื่นไหลไม่มีสะดุด", tag: "อัปเดตต่อเนื่อง", icon: "📱" },
];
---

<section aria-label="ค่ายเกมและหมวดสล็อตที่ YIMSIAM889 รวมไว้ให้" class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#f8dc9a] via-[#e9b949] to-[#a81f1a] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      ค่ายเกมและหมวดสล็อตที่ <span class="text-[#e9b949]">YIMSIAM889</span> รวมไว้ให้ครบ
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#e9b949] to-transparent"></div>
  </div>

  <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4 lg:gap-5 xl:grid-cols-7">
    {
      providers.map((provider) => (
        <a
          href="/register"
          class="group relative flex flex-col items-center justify-center overflow-hidden rounded-2xl border border-[#e9b949]/25 bg-[#1e0a06]/92 p-5 shadow-[0_10px_30px_rgba(168,31,26,0.22)] backdrop-blur-md transition-all duration-300 hover:-translate-y-2 hover:border-[#e9b949]/50 hover:bg-[#2e130c]/95 hover:shadow-[0_15px_40px_rgba(233,185,73,0.3)]">
          <div class="pointer-events-none absolute inset-0 bg-[#a81f1a]/15 opacity-0 transition-opacity duration-300 group-hover:opacity-100" />

          <div class="absolute top-2 right-2 z-10 rounded-full bg-gradient-to-r from-[#f8dc9a] via-[#e9b949] to-[#9c724a] px-2 py-0.5 text-[9px] font-black tracking-wide whitespace-nowrap text-[#140604] shadow-sm transition-transform duration-300 group-hover:scale-110">
            {provider.tag}
          </div>

          <div aria-hidden="true" class="mb-3 text-4xl transition-transform duration-300 group-hover:scale-125 group-hover:rotate-3">
            {provider.icon}
          </div>
          <p class="text-center text-sm font-black text-[#f2ddc4] transition-colors group-hover:text-[#f8dc9a]">{provider.name}</p>
          <p class="mt-1 text-center text-[10px] text-[#f2ddc4]/70">{provider.desc}</p>

          <span class="relative z-10 mt-4 block w-full rounded-full border border-[#e9b949]/25 bg-[#140604] py-1.5 text-center text-[11px] font-bold text-[#e9b949] shadow-inner transition-colors duration-300 group-hover:border-[#e9b949]/50 group-hover:bg-gradient-to-r group-hover:from-[#f8dc9a] group-hover:via-[#e9b949] group-hover:to-[#a81f1a] group-hover:text-[#140604]">
            เข้าดูเกม
          </span>
        </a>
      ))
    }
  </div>
</section>
