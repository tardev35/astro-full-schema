---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#f9a8d4] bg-white p-8 text-[#5b2140] shadow-[0_10px_30px_rgba(236,72,153,0.14)] transition-all duration-500 hover:border-[#ec4899]/60 hover:shadow-[0_15px_40px_rgba(236,72,153,0.22)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 bg-gradient-to-br from-[#fdf2f8] to-transparent opacity-80"></div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#fbcfe8] pb-4">
          <span aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ec4899] via-[#f472b6] to-[#a855f7] shadow-[0_0_10px_rgba(236,72,153,0.30)]" />
          <HeadingTag class="bg-gradient-to-r from-[#9d174d] via-[#db2777] to-[#7e22ce] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-10 md:grid-cols-2">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#5b2140]">
        {
          titleleft && (
            <p class="flex items-center gap-3 border-b border-[#fbcfe8] pb-3 text-xl leading-normal font-black tracking-widest text-[#9d174d] uppercase">
              <span aria-hidden="true" class="h-6 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ec4899] to-[#a855f7] shadow-[0_0_10px_rgba(236,72,153,0.30)]" />
              {titleleft}
            </p>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#5b2140] md:border-l md:border-[#fbcfe8] md:pl-10">
        {
          titleright && (
            <p class="flex items-center gap-3 border-b border-[#fbcfe8] pb-3 text-xl leading-normal font-black tracking-widest text-[#9d174d] uppercase">
              <span aria-hidden="true" class="h-6 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#a855f7] to-[#ec4899] shadow-[0_0_10px_rgba(168,85,247,0.30)]" />
              {titleright}
            </p>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
