---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-[28px] border-2 border-white bg-white p-8 text-left text-base leading-relaxed text-[#23323f] shadow-[0_10px_30px_rgba(12,53,80,0.08),0_0_0_1px_#cfe9f4] transition-shadow duration-500 hover:shadow-[0_16px_40px_rgba(0,164,212,0.18),0_0_0_1px_#8ed3ee] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-16 -right-16 -z-10 h-40 w-40 rounded-full bg-[#4cc9f0]/15 blur-[50px] transition-colors duration-500 group-hover:bg-[#ffb84d]/20"></div>
    <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 bottom-0 -z-10 h-1.5 bg-gradient-to-r from-[#00a4d4] via-[#ffd23f] to-[#f7941d]"></div>

    {
      title && (
        <header class="mb-6 flex items-start gap-3">
          <span aria-hidden="true" class="mt-1 flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-gradient-to-br from-[#4cc9f0] to-[#0077b3] shadow-[0_4px_10px_rgba(0,119,179,0.30)]">
            <span class="h-3 w-3 rounded-full bg-[#ffd23f] shadow-[0_0_0_3px_rgba(255,255,255,0.6)]" />
          </span>
          <HeadingTag class="text-2xl leading-normal font-black text-[#0c3550]">{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
