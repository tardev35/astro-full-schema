---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement6 from "../components/Announcement6.astro";
import SmoothCarousel from "../components/SmoothCarousel.astro";
import ContentBox from "../components/ContentBox.astro";
import ContentBoxCyberCut from "../components/ContentBoxCyberCut.astro";
import ContentBoxFloatingBadge from "../components/ContentBoxFloatingBadge.astro";
import ContentBoxTwoCyberCut from "../components/ContentBoxTwoCyberCut.astro";
import ContentBoxTwoFloatingBadge from "../components/ContentBoxTwoFloatingBadge.astro";
import ContentBoxSevenThreeCyberCut from "../components/ContentBoxSevenThreeCyberCut.astro";
import ContentBoxSevenThreeFloatingBadge from "../components/ContentBoxSevenThreeFloatingBadge.astro";
import ProviderGrid from "../components/ProviderGrid.astro";
import GameRankingBoard from "../components/GameRankingBoard.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import LatestWinnersPremium from "../components/LatestWinnersPremium.astro";
import Faq from "../components/Faq.astro";
import ReviewCardSumo2 from "../components/ReviewCardSumo2.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import imgAllCategories from "../assets/slide1.png";
import imgSportsLotto from "../assets/slide3.png";

const pageTitle = "NORWAY89 เว็บตรง บาคาร่า สล็อต บอล หวย ฝากถอนออโต้ เล่นง่าย";

const pageDescription = "NORWAY89 เว็บตรงรวมบาคาร่า สล็อต บอล และหวยไว้ในบัญชีเดียว พร้อมระบบฝากถอนออโต้ สมัครง่าย เล่นผ่านมือถือได้ทุกที่ รวมเครดิต โปรโมชั่น และทางเข้าไว้ครบ";

const announcement =
  "NORWAY89 เว็บตรงรวมบาคาร่า สล็อต บอล และหวยไว้ในบัญชีเดียว • เมนูเกมแบ่งชัดเป็นหมวด สลับจากบาคาร่าไปสล็อตหรือบอลได้จากหน้าเดิม • ฝากถอนออโต้ขั้นตอนสั้น ดูสถานะและประวัติรายการได้จากหน้าบัญชี • หน้าสมาชิกรวมเครดิต โปรโมชั่น และประวัติรายการไว้จุดเดียว • สมัครไม่กี่ขั้นตอนแล้วเข้าเลือกเกมได้ทันที";

const allCategoriesAlt =
  "ภาพโปรโมชั่น NORWAY89 พื้นดำลายทอง ตัวอักษรทองขนาดใหญ่ว่า NORWAY89 ใต้ลงมาเป็นแถบข้อความ เว็บตรงครบทุกหมวด และ บาคาร่า สล็อต บอล หวย ตามด้วยปุ่มไอคอนสองบรรทัดว่า ฝากถอนออโต้ และ เล่นผ่านมือถือ ปิดท้ายด้วยกรอบข้อความ ทางเข้าเว็บหลัก ด้านขวาเป็นพรีเซนเตอร์หญิงชุดดำยืนคู่กับวงล้อรูเล็ต ชิปคาสิโน และไพ่";

const sportsLottoAlt =
  "ภาพโปรโมชั่น NORWAY89 พื้นดำลายทอง ตัวอักษรทองว่า NORWAY89 ครบทั้งบาคาร่า สล็อต บอล หวย และบรรทัดรองว่า เว็บตรงใช้งานง่าย ฝากถอนออโต้ ตรงกลางเป็นภาพหน้าจอมือถือที่เปิดหน้าเว็บแสดงยอดเครดิตและเมนูหมวด บาคาร่า สล็อต ฟุตบอล แถบล่างเขียนว่า บัญชีเดียว เล่นได้ครบ พร้อมไอคอนธนาคารและไลน์ไอดีของทีมงาน ด้านขวาเป็นพรีเซนเตอร์หญิงยืนคู่กับวงล้อรูเล็ตและไพ่";

const faqs = [
  {
    q: "NORWAY89 รวมบาคาร่า สล็อต บอล และหวยไว้ในบัญชีเดียวจริงไหม",
    a: "เว็บระบุว่ารวมเกมหลักไว้ทั้งบาคาร่า สล็อต บอล และหวย สมาชิกจึงเลือกเล่นหลายแนวผ่านบัญชีเดียว โดยใช้เครดิตและข้อมูลสมาชิกชุดเดิมได้ทุกหมวด อยากเปลี่ยนแนวระหว่างวันก็สลับหมวดได้เลย ไม่ต้องตั้งค่าบัญชีใหม่ตามเกมที่เล่น",
  },
  {
    q: "บาคาร่าและสล็อตของ NORWAY89 เล่นผ่านมือถือได้เลยหรือต้องโหลดโปรแกรม",
    a: "หน้าเกมรองรับทั้งหน้าจอมือถือและคอมพิวเตอร์ เข้าสู่ระบบผ่านเบราว์เซอร์แล้วเลือกโต๊ะบาคาร่าหรือเกมสล็อตได้จากหน้าเดียว ส่วนความลื่นไหลยังขึ้นอยู่กับรุ่นมือถือ เบราว์เซอร์ และสัญญาณอินเทอร์เน็ตของแต่ละคน",
  },
  {
    q: "ระบบฝากถอนออโต้ของ NORWAY89 ใช้งานอย่างไร",
    a: "เว็บระบุว่าการเติมเครดิตและถอนยอดทำได้เป็นขั้นตอนสั้นผ่านระบบออโต้ สมาชิกดูสถานะและประวัติรายการได้จากหน้าบัญชีโดยตรง จึงไม่ต้องคุยหลายขั้นตอนก่อนเข้าเล่น ทำรายการเสร็จก็กลับไปเลือกเกมต่อได้ทันที",
  },
  {
    q: "สมัครสมาชิก NORWAY89 มีขั้นตอนอะไรบ้าง",
    a: "การสมัครเน้นขั้นตอนที่เข้าใจง่าย กรอกข้อมูลสมาชิก ตั้งค่าบัญชี แล้วเข้าสู่หน้าหลักเพื่อเลือกบาคาร่า สล็อต บอล หรือหวยได้จากเมนูเดียว บัญชีเดียวกันนี้ยังใช้จัดการเครดิต โปรโมชั่น และประวัติรายการ จึงไม่ต้องตั้งค่าแยกตามเกม",
  },
  {
    q: "ทางเข้าและหน้าสมาชิกของ NORWAY89 ดูข้อมูลอะไรได้บ้าง",
    a: "ทางเข้ารองรับมือถือ แท็บเล็ต และคอมพิวเตอร์ ใช้บัญชีเดิมเข้าสู่ระบบได้ทุกอุปกรณ์ ส่วนหน้าสมาชิกรวมยอดเครดิต โปรโมชั่น และประวัติการทำรายการไว้จุดเดียว จึงดูข้อมูลสำคัญได้จากหน้าเดียวโดยไม่ต้องเปิดหลายส่วนเพื่อไล่หายอดย้อนหลัง",
  },
];

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement6 message={announcement} />

  <SmoothCarousel />

  <ContentBoxCyberCut as="h1" title="NORWAY89 เว็บตรงรวมบาคาร่า สล็อต บอล หวย ฝากถอนออโต้ เล่นครบในบัญชีเดียว">
    <div>
      <p class="text-left text-base leading-relaxed text-[#efe0c4]">
        <strong class="text-[#e0aa2e]">NORWAY89</strong> รวมบาคาร่า สล็อต บอล หวย และเกมออนไลน์หลายสไตล์ไว้ในบัญชีเดียว เปิดเข้ามาแล้วเลือกหมวดที่ชอบได้เลย พร้อมระบบฝากถอนออโต้และหน้าสมาชิกที่รวมเครดิต
        โปรโมชั่น และประวัติรายการไว้ครบ ใช้งานง่ายทั้งบนมือถือและคอมพิวเตอร์
      </p>
      <p class="mt-3 text-left text-base leading-relaxed text-[#efe0c4]">
        จุดเด่นของ NORWAY89 คือความครบแบบไม่ทำเรื่องยากๆซับซ้อนให้กลายเป็นเรื่องง่าย สมัครไม่กี่ขั้นตอน เมนูเกมแบ่งชัด และสลับจากบาคาร่าไปสล็อตหรือกีฬาได้ตามอารมณ์ เข้าเว็บมาเพื่อเล่นเกม
        ไม่ได้เข้ามาสอบวิชาเดินหาเมนู
      </p>
    </div>
  </ContentBoxCyberCut>

  <div class="relative z-10 mx-auto mb-10 flex flex-nowrap justify-center gap-3 px-4 sm:gap-6">
    <a
      href="/login"
      class="group relative flex flex-1 items-center justify-center rounded-full bg-gradient-to-r from-[#f5d488] via-[#e0aa2e] to-[#b87814] px-4 py-3 text-sm font-black whitespace-nowrap text-[#120b04] shadow-[0_10px_30px_rgba(224,170,46,0.30)] transition-all duration-300 hover:-translate-y-1 hover:scale-105 hover:shadow-[0_15px_40px_rgba(224,170,46,0.42)] sm:flex-none sm:px-10 sm:py-3.5 sm:text-base">
      เข้าสู่ระบบ
    </a>

    <a
      href="/register"
      class="group relative flex flex-1 items-center justify-center rounded-full border border-[#e0aa2e]/70 bg-[#160f07]/85 px-4 py-3 text-sm font-black whitespace-nowrap text-[#e0aa2e] backdrop-blur-sm transition-all duration-300 hover:scale-105 hover:border-[#e0aa2e] hover:bg-[#241809]/85 hover:shadow-[0_15px_40px_rgba(224,170,46,0.35)] sm:flex-none sm:px-10 sm:py-3.5 sm:text-base">
      สมัครสมาชิก
    </a>
  </div>

  <ContentBoxSevenThreeCyberCut as="h2" titleright="NORWAY89 รวมบาคาร่า สล็อต บอล และหวยครบในบัญชีเดียว">
    <Picture
      slot="left"
      src={imgAllCategories}
      alt={allCategoriesAlt}
      loading="lazy"
      fetchpriority="low"
      widths={[200, 400, 600]}
      sizes="(max-width: 768px) 100vw, 30vw"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      class="mx-auto h-auto w-full rounded-2xl border border-[#e0aa2e]/30 shadow-[0_10px_30px_rgba(224,170,46,0.26)]"
    />
    <div slot="right">
      <p class="text-left text-base leading-relaxed text-[#efe0c4]">
        NORWAY89 รวมเกมหลักไว้ทั้งบาคาร่า สล็อต บอล และหวย สมาชิกจึงเลือกเล่นหลายแนวผ่านบัญชีเดียว พร้อมใช้เครดิตและข้อมูลสมาชิกชุดเดิมได้ทุกหมวด
      </p>
      <p class="mt-3 text-left text-base leading-relaxed text-[#efe0c4]">
        คนที่ชอบเปลี่ยนแนวระหว่างวันจึงเลือกได้อิสระ เช้าเช็กบอล เย็นเล่นสล็อต ค่ำไปบาคาร่าได้หมด ความชอบเปลี่ยนได้ ส่วนบัญชีไม่ต้องเปลี่ยนตามให้วุ่น
      </p>
    </div>
  </ContentBoxSevenThreeCyberCut>

  <ContentBoxTwoCyberCut as="h2" title="บาคาร่า NORWAY89 เลือกโต๊ะง่าย เล่นได้ทั้งมือถือและคอม">
    <p slot="left" class="text-left text-base leading-relaxed text-[#efe0c4]">
      บาคาร่า NORWAY89 รวมโต๊ะคาสิโนออนไลน์ไว้เป็นหมวดชัด สมาชิกเลือกเกมและวงเงินที่เหมาะกับตัวเองก่อนเข้าเล่นได้ พร้อมรองรับทั้งหน้าจอมือถือและคอมพิวเตอร์
    </p>
    <p slot="right" class="text-left text-base leading-relaxed text-[#efe0c4]">
      หน้าเกมเน้นเข้าถึงง่ายและเลือกโต๊ะได้เร็ว เหมาะทั้งคนมีโต๊ะประจำและคนชอบสลับรูปแบบ เล่นบาคาร่าอยู่แล้วก็ไม่ต้องเดินอ้อมผ่านสล็อตครึ่งเว็บกว่าจะเจอของที่หา
    </p>
  </ContentBoxTwoCyberCut>

  <ContentBoxFloatingBadge as="h2" title="สล็อต NORWAY89 รวมเกมหลายสไตล์ เลือกเล่นได้ตามสายที่ชอบ">
    <div>
      <p class="text-left text-base leading-relaxed text-[#efe0c4]">
        สล็อต NORWAY89 มีเกมหลายธีมและหลายรูปแบบให้เลือก ตั้งแต่เกมเล่นง่ายไปจนถึงเกมที่มีฟรีสปิน โบนัส และฟีเจอร์พิเศษ สมาชิกเข้าเลือกจากหมวดสล็อตได้โดยตรง
      </p>
      <p class="mt-3 text-left text-base leading-relaxed text-[#efe0c4]">
        การจัดเกมเป็นหมวดช่วยให้หาเกมที่ถูกใจได้เร็วขึ้น จะสายภาพสวย สายฟีเจอร์ หรือสายมีเกมประจำก็เลือกต่อได้ทันที เกมเยอะควรสร้างทางเลือก ไม่ใช่สร้างงานให้นิ้วโป้ง
      </p>
    </div>
  </ContentBoxFloatingBadge>

  <ProviderGrid />

  <ContentBoxSevenThreeFloatingBadge as="h2" title="บอลและหวย NORWAY89 เพิ่มทางเลือกให้เล่นได้มากกว่าเกมคาสิโน">
    <Picture
      slot="left"
      src={imgSportsLotto}
      alt={sportsLottoAlt}
      loading="lazy"
      fetchpriority="low"
      widths={[200, 400, 600]}
      sizes="(max-width: 768px) 100vw, 30vw"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      class="mx-auto h-auto w-full rounded-2xl border border-[#e0aa2e]/30 shadow-[0_10px_30px_rgba(224,170,46,0.26)]"
    />
    <div slot="right">
      <p class="text-left text-base leading-relaxed text-[#efe0c4]">
        NORWAY89 มีทั้งหมวดบอลและหวยสำหรับคนที่ไม่ได้เล่นเฉพาะคาสิโน สมาชิกสามารถดูรายการกีฬา เลือกตลาดที่สนใจ หรือเข้าเล่นหวยผ่านบัญชีเดียวกับบาคาร่าและสล็อต
      </p>
      <p class="mt-3 text-left text-base leading-relaxed text-[#efe0c4]">
        จุดนี้ทำให้ NORWAY89 เหมาะกับคนชอบหลายแนว เพราะวันไหนไม่อยากหมุนสล็อตก็มีตัวเลือกอื่นรออยู่ เกมเปลี่ยนตามอารมณ์ได้ โดยหน้าเว็บยังคงเป็นบ้านหลังเดิม
      </p>
    </div>
  </ContentBoxSevenThreeFloatingBadge>

  <GameRankingBoard />

  <ContentBox as="h2" title="ฝากถอนออโต้ NORWAY89 จัดการเครดิตได้สะดวกตลอดวัน">
    <div>
      <p class="text-left text-base leading-relaxed text-[#efe0c4]">
        NORWAY89 ใช้ระบบฝากถอนออโต้ช่วยให้การเติมเครดิตและถอนยอดทำได้เป็นขั้นตอนสั้น สมาชิกสามารถดูสถานะและประวัติรายการจากหน้าบัญชีได้โดยตรง
      </p>
      <p class="mt-3 text-left text-base leading-relaxed text-[#efe0c4]">
        ระบบออโต้ช่วยลดเวลารอและไม่ต้องคุยหลายขั้นตอนก่อนเข้าเล่น ทำรายการเสร็จก็กลับไปเลือกเกมต่อได้ ความตื่นเต้นควรอยู่ในเกม ไม่ใช่อยู่ตอนลุ้นว่ารายการจะเดินถึงไหน
      </p>
    </div>
  </ContentBox>

  <ContentBoxTwoFloatingBadge as="h2" title="สมัคร NORWAY89 ขั้นตอนไม่เยอะ พร้อมเข้าเลือกเกมได้ทันที">
    <p slot="left" class="text-left text-base leading-relaxed text-[#efe0c4]">
      การสมัคร NORWAY89 เน้นขั้นตอนที่เข้าใจง่าย กรอกข้อมูลสมาชิก ตั้งค่าบัญชี และเข้าสู่หน้าหลักเพื่อเลือกบาคาร่า สล็อต บอล หรือหวยได้จากเมนูเดียว
    </p>
    <p slot="right" class="text-left text-base leading-relaxed text-[#efe0c4]">
      บัญชี NORWAY89 ยังใช้จัดการเครดิต โปรโมชั่น และประวัติรายการทั้งหมด จึงไม่ต้องตั้งค่าแยกตามเกม สมัครครั้งเดียวให้จบ เพราะชีวิตประจำวันมีฟอร์มให้กรอกเยอะพอแล้ว
    </p>
  </ContentBoxTwoFloatingBadge>

  <LoginRtpSection />

  <ContentBoxCyberCut as="h2" title="ทางเข้า NORWAY89 รองรับมือถือ เปิดเกมได้จากทุกที่">
    <div>
      <p class="text-left text-base leading-relaxed text-[#efe0c4]">
        ทางเข้า NORWAY89 รองรับมือถือ แท็บเล็ต และคอมพิวเตอร์ สมาชิกเข้าสู่ระบบผ่านเบราว์เซอร์แล้วเลือกเกมหรือจัดการบัญชีได้ตามอุปกรณ์ที่ใช้อยู่
      </p>
      <p class="mt-3 text-left text-base leading-relaxed text-[#efe0c4]">
