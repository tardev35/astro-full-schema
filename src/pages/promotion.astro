---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxFloatingBadge.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";

import { Picture } from "astro:assets";

import pro1 from "../assets/pro1.webp";
import pro2 from "../assets/pro2.webp";
import pro3 from "../assets/pro3.webp";
import pro4 from "../assets/pro4.webp";
import pro5 from "../assets/pro5.webp";
import pro6 from "../assets/pro6.webp";
import pro7 from "../assets/pro7.webp";
import pro8 from "../assets/pro8.webp";
import pro9 from "../assets/pro9.webp";
import pro10 from "../assets/pro10.webp";
---

<MainLayout
  title="โปรโมชั่น VEGUS24 สล็อตแจกเครดิตฟรี คืนยอดเสีย ถอนไม่อั้น ไม่ติดเทิร์น"
  description="อัปเดต โปรโมชั่น VEGUS24 ล่าสุด แจกเครดิตฟรีสมาชิกใหม่ โบนัสสล็อตทุนน้อย คืนยอดเสียให้ทุกวัน เงื่อนไขรับง่าย ไม่ติดเทิร์นโหด กดรับเองผ่านระบบออโต้ แตกเท่าไหร่ก็ถอนได้จริง">
  <Announcement />

  <ContentBox>
    <h1 class="drop-shadow-[0_0_8px_rgba(60, 179, 113,0.5)] mb-7 bg-gradient-to-b from-[#ffffff] to-[#019201] bg-clip-text text-3xl font-black text-transparent">
      โปรโมชั่น VEGUS24 สล็อตแจกเครดิตฟรี คืนยอดเสีย ถอนไม่อั้น ไม่ติดเทิร์น
    </h1>

    <div class="mx-auto grid w-full max-w-7xl grid-cols-1 gap-6 px-4 sm:grid-cols-2 lg:grid-cols-2 xl:grid-cols-2">
      <Picture
        src={pro1}
        alt="โปรโมชั่นวันเกิด รับทันที 1,000 บาท"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600, 800]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class="mx-auto h-auto w-full rounded-xl border border-[#10b981]/50 object-contain shadow-lg transition-transform duration-300 hover:-translate-y-1 hover:border-[#34d399] hover:shadow-[0_10px_20px_rgba(16,185,129,0.4)]"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />

      <Picture
        src={pro2}
        alt="โปรโมชั่นยอดฮิต ฝาก 50 รับ 100"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600, 800]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class="mx-auto h-auto w-full rounded-xl border border-[#10b981]/50 object-contain shadow-lg transition-transform duration-300 hover:-translate-y-1 hover:border-[#34d399] hover:shadow-[0_10px_20px_rgba(16,185,129,0.4)]"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />

      <Picture
        src={pro3}
        alt="แทงบาคาร่า 6 ไม้ ชนะติดกัน รับเงินทันที 1,000 บาท"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600, 800]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class="mx-auto h-auto w-full rounded-xl border border-[#10b981]/50 object-contain shadow-lg transition-transform duration-300 hover:-translate-y-1 hover:border-[#34d399] hover:shadow-[0_10px_20px_rgba(16,185,129,0.4)]"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />

      <Picture
        src={pro4}
        alt="ฝากแรกของวัน รับโบนัสฟรี 20%"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600, 800]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class="mx-auto h-auto w-full rounded-xl border border-[#10b981]/50 object-contain shadow-lg transition-transform duration-300 hover:-translate-y-1 hover:border-[#34d399] hover:shadow-[0_10px_20px_rgba(16,185,129,0.4)]"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />

      <Picture
        src={pro5}
        alt="รับเพิ่มทุกยอดฝาก รับโบนัสฟรี 10%"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600, 800]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class="mx-auto h-auto w-full rounded-xl border border-[#10b981]/50 object-contain shadow-lg transition-transform duration-300 hover:-translate-y-1 hover:border-[#34d399] hover:shadow-[0_10px_20px_rgba(16,185,129,0.4)]"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />

      <Picture
        src={pro6}
        alt="สล็อตไม่แตก รับเงินคืน"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600, 800]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class="mx-auto h-auto w-full rounded-xl border border-[#10b981]/50 object-contain shadow-lg transition-transform duration-300 hover:-translate-y-1 hover:border-[#34d399] hover:shadow-[0_10px_20px_rgba(16,185,129,0.4)]"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />

      <Picture
        src={pro7}
        alt="คืนยอดเสีย รับ 5.0%"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600, 800]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class="mx-auto h-auto w-full rounded-xl border border-[#10b981]/50 object-contain shadow-lg transition-transform duration-300 hover:-translate-y-1 hover:border-[#34d399] hover:shadow-[0_10px_20px_rgba(16,185,129,0.4)]"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />

      <Picture
        src={pro8}
        alt="แทงรูเล็ต 5 ไม้ ชนะติดกัน รับเงินทันที 1,000 บาท"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600, 800]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class="mx-auto h-auto w-full rounded-xl border border-[#10b981]/50 object-contain shadow-lg transition-transform duration-300 hover:-translate-y-1 hover:border-[#34d399] hover:shadow-[0_10px_20px_rgba(16,185,129,0.4)]"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />

      <Picture
        src={pro9}
        alt="กิจกรรมทายผลหวยรัฐบาล รางวัลมูลค่า 5,000 บาท"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600, 800]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class="mx-auto h-auto w-full rounded-xl border border-[#10b981]/50 object-contain shadow-lg transition-transform duration-300 hover:-translate-y-1 hover:border-[#34d399] hover:shadow-[0_10px_20px_rgba(16,185,129,0.4)]"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />

      <Picture
        src={pro10}
        alt="กิจกรรมสะสมพ้อย VGCS แลกของรางวัลสุดพิเศษ"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600, 800]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class="mx-auto h-auto w-full rounded-xl border border-[#10b981]/50 object-contain shadow-lg transition-transform duration-300 hover:-translate-y-1 hover:border-[#34d399] hover:shadow-[0_10px_20px_rgba(16,185,129,0.4)]"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />
    </div>

    <div class="mt-12 flex justify-center pb-4">
      <a
        href="/register"
        class="flex items-center justify-center rounded-lg bg-gradient-to-r from-red-700 to-red-900 px-10 py-3.5 text-lg font-black text-white shadow-[0_0_20px_rgba(185,28,28,0.6)] transition-transform hover:scale-105">
        รับโปรโมชั่นทันที
      </a>
    </div>
  </ContentBox>
</MainLayout>

<Navfoot />

<style>
  :global(.text-emerald-gradient) {
    background: linear-gradient(to bottom, #34d399 0%, #10b981 100%) !important;
    -webkit-background-clip: text !important;
    -webkit-text-fill-color: transparent !important;
  }
</style>
