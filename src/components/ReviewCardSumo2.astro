---
const reviews = [
  {
    name: "กัปตันหมึกยักษ์",
    role: "ผู้เชี่ยวชาญด้านระบบเว็บไซต์",
    stars: 4,
    content: "ระบบหลังบ้านแน่นและเสถียรมากครับ โครงสร้าง API เชื่อมตรงค่ายเกมต่างประเทศ ระบบฝาก-ถอนออโต้ทำงานได้ไวระดับ 3-5 วินาที ไร้รอยต่อจริงๆ แถม UI/UX ออกแบบมาให้ผู้เล่นใช้งานง่ายมาก หัก 1 ดาวเพราะอยากให้มีฟีเจอร์ปรับโหมดสว่างบ้าง รวมๆ คือโคตรตึง!",
    avatar: "🦑",
    verified: true,
  },
  {
    name: "ทีมฉลามน้อย รีวิวเว็บนอก",
    role: "คอมมูนิตี้รีวิวเว็บนอก",
    stars: 4,
    content: "ทางเพจเราเทสแล้ว คอนเฟิร์มว่าที่นี่คือ 'เว็บนอกแท้ 100%' ค่าย RTP คงเดิมตามลิขสิทธิ์ ไม่ปรับเรทกลางอากาศ ไม่ล็อคยูสเซอร์แน่นอน จ่ายจริงทุกบิล เป็นเว็บคุณภาพที่อยากแนะนำ",
    avatar: "🦈",
  },
  {
    name: "บอสปลาวาฬ VIP",
    role: "นักเล่นระดับ VIP (Whale)",
    stars: 5,
    content: "ลองเทสมาแล้วหลายเว็บ สุดท้ายจบที่ BABYSHARK88 ครับ! สล็อตแตกง่ายมาก ฟรีสปินเข้าบ่อยจัด RTP สูงกว่าเว็บไทยทั่วไป แอดมินบริการดีตอบไว 24 ชม. เงินเข้าปุ๊บปั๊บ เอาไปเลย 5 ดาวเต็มๆ ไม่ผิดหวังแน่นอนครับ!",
    avatar: "🐋",
  },
];
---

<section class="mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans relative z-10">

  <!-- Section Header -->
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <h2 class="flex items-center gap-2 text-3xl font-black uppercase tracking-widest text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 via-gray-200 to-gray-400 drop-shadow-[0_2px_10px_rgba(255,255,255,0.2)]">
      <span class="text-2xl not-italic">🦈</span> เสียงตอบรับจาก <span class="text-cyan-400">ผู้ใช้งานจริง</span>
    </h2>
    <div class="h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-cyan-500 to-transparent mt-2"></div>
  </div>

  <!-- Equal grid: dive-tag cards -->
  <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
    {reviews.map((review) => (
      <article class="group relative flex flex-col overflow-hidden rounded-2xl border border-white/10 bg-[#050d16]/80 pl-7 shadow-[0_8px_24px_rgba(0,0,0,0.6)] backdrop-blur-xl transition-all duration-300 hover:-translate-y-1.5 hover:border-cyan-400/40 hover:shadow-[0_18px_35px_rgba(6,182,212,0.25)]">
        <!-- สันการ์ดไล่สีไซแอน-ทอง -->
        <span class="absolute left-0 top-0 h-full w-1.5 bg-gradient-to-b from-cyan-400 via-cyan-500 to-yellow-400"></span>

        <!-- ป้ายคะแนนแบบตราประทับมุมบน -->
        <span class="absolute -top-3 right-5 z-10 flex items-center gap-1 rounded-full bg-gradient-to-r from-yellow-400 to-yellow-500 px-3 py-1 text-[11px] font-black text-[#04141f] shadow-[0_4px_10px_rgba(0,0,0,0.4)]">
          ★ {review.stars.toFixed(1)}
        </span>

        <div class="relative flex flex-1 flex-col gap-3 p-6 pt-9">
          <span class="pointer-events-none absolute right-4 top-2 font-serif text-7xl leading-none text-cyan-500/10 select-none">"</span>

          <p class="relative z-10 text-sm leading-relaxed text-gray-300 italic">{review.content}</p>

          <div class="relative z-10 mt-auto flex items-center gap-3 border-t border-white/10 pt-4">
            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-gradient-to-br from-cyan-600 to-black text-lg shadow-inner">
              {review.avatar}
            </div>
            <div class="flex flex-col gap-0.5">
              <div class="flex items-center gap-1.5">
                <h4 class="text-sm font-black text-white transition-colors group-hover:text-cyan-300">{review.name}</h4>
                {review.verified && (
                  <span class="flex h-3.5 w-3.5 items-center justify-center rounded-full bg-cyan-400 text-[8px] font-black text-[#04141f]" title="ยืนยันตัวตนแล้ว">✓</span>
                )}
              </div>
              <span class="text-[10px] font-bold tracking-wider text-cyan-400/70 uppercase">{review.role}</span>
            </div>
          </div>
        </div>
      </article>
    ))}
  </div>
</section>
<style>
  .font-sans {
    font-family: "Kanit", sans-serif;
  }
</style>
