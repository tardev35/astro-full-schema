---
import { Picture } from "astro:assets";

import slide1 from "../assets/slide1.png";
import slide2 from "../assets/slide2.png";
import slide3 from "../assets/slide3.png";

const images = [
  {
    src: slide1,
    alt: "ภาพโปรโมชั่น PAYDAY24 ข้อความ ฝากถอนออโต้ รองรับ True Wallet คล่องตัว รวดเร็ว ใช้งานง่าย มีพรีเซนเตอร์ถือมือถือที่เปิดแอป True Wallet กระเป๋าเงิน หน้าจอทำรายการสำเร็จ เหรียญทอง และนาฬิกา 24 ชั่วโมง บนฉากหลังม่วงทอง",
  },
  {
    src: slide2,
    alt: "ภาพโปรโมชั่น PAYDAY24 ข้อความ รวมบริการครบใน PAYDAY24 ค่ายชั้นนำในระบบเดียว มีพรีเซนเตอร์หญิงในชุดราตรีสีม่วง มือถือแสดงหน้าเว็บ PAYDAY24 ป้าย LIVE CASINO BACCARAT LOTTERY นักฟุตบอล ลูกบอลหวย ไพ่ และกองชิป พร้อมแถบหมวด คาสิโนสด บาคาร่า หวย กีฬา",
  },
  {
    src: slide3,
    alt: "ภาพโปรโมชั่น PAYDAY24 ข้อความ กิจกรรมเครดิตทุกวัน เล่นทุกวัน มีสีสันทุกวัน ไม่ใช่แค่เข้าเกมแล้วจบ มีการ์ดเช็คอินรับเครดิตรายสัปดาห์ตั้งแต่วันจันทร์ถึงวันอาทิตย์ กล่องของขวัญ DAILY REWARDS และพรีเซนเตอร์ในชุดสีม่วง",
  },
];

const COPIES = 3;
const slides = Array.from({ length: COPIES }, () => images).flat();
---

<div class="marquee mx-auto w-full max-w-7xl overflow-hidden px-4 py-5">
  <input id="carousel-pause" type="checkbox" class="peer sr-only" />
  <label
    for="carousel-pause"
    class="sr-only cursor-pointer peer-focus-visible:not-sr-only peer-focus-visible:mb-3 peer-focus-visible:inline-block peer-focus-visible:rounded-full peer-focus-visible:border peer-focus-visible:border-[#fdc700]/70 peer-focus-visible:bg-[#1c0a30] peer-focus-visible:px-4 peer-focus-visible:py-2 peer-focus-visible:text-sm peer-focus-visible:font-bold peer-focus-visible:text-[#ffe680]">
    หยุด / เล่นสไลด์ภาพ
  </label>

  <div class="marquee-track flex">
    {
      slides.map((slide, index) => {
        const isDuplicate = index >= images.length;
        return (
          <div class="marquee-slide" aria-hidden={isDuplicate ? "true" : undefined}>
            <Picture
              src={slide.src}
              alt={isDuplicate ? "" : slide.alt}
              class="block w-full rounded-xl border border-[#fdc700]/45 object-cover shadow-[0_10px_30px_rgba(253,199,0,0.18)]"
              width={slide.src.width}
              height={slide.src.height}
              loading="lazy"
              fetchpriority="low"
              decoding="async"
              widths={[300, 360, 420, 480, 540, 600]}
              sizes="(max-width: 767px) calc(100vw - 32px), (max-width: 1279px) calc((100vw - 48px) / 2), 403px"
              formats={["avif", "webp"]}
              fallbackFormat="webp"
              quality={60}
            />
          </div>
        );
      })
    }
  </div>
</div>

<style>
  .marquee {
    --gap: 12px;
    --per-view: 1;
    --shift: calc(-300% - 36px);
  }

  @media (min-width: 768px) {
    .marquee {
      --gap: 16px;
      --per-view: 2;
      --shift: calc(-150% - 24px);
    }
  }

  @media (min-width: 1280px) {
    .marquee {
      --gap: 20px;
      --per-view: 3;
      --shift: calc(-100% - 20px);
    }
  }

  .marquee-track {
    gap: var(--gap);
    width: 100%;
    animation: carousel-scroll 30s linear infinite;
    will-change: transform;
  }

  .marquee-slide {
    flex: 0 0 calc((100% - (var(--per-view) - 1) * var(--gap)) / var(--per-view));
  }

  @keyframes carousel-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(var(--shift));
    }
  }

  .marquee:hover .marquee-track,
  .marquee:focus-within .marquee-track,
  .marquee > input:checked ~ .marquee-track {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
    }
  }
</style>
