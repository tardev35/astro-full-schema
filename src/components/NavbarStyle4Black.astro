---
import { Picture } from "astro:assets";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });

const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

const currentPath = Astro.url.pathname;

const isActive = (path: string) => {
  if (path === "/") return currentPath === "/";
  return currentPath.startsWith(path);
};
---

<nav class="sticky top-0 z-50 w-full border-b border-red-600/50 bg-[#050508] font-sans shadow-[0_0_20px_rgba(220,38,38,0.2)]">
  <div class="flex h-[75px] w-full items-center justify-between px-4 xl:px-8">
    <div class="z-50 flex items-center">
      <a href="/" class="group relative flex items-center">
        <div class="absolute inset-0 scale-0 rounded-full bg-red-600/20 blur-xl transition-transform duration-500 group-hover:scale-150"></div>
        <Picture
          src={mainLogo!}
          alt="Gaming Logo"
          loading="eager"
          fetchpriority="high"
          class="relative h-[40px] w-auto drop-shadow-[0_0_10px_rgba(255,255,255,0.1)] transition-transform group-hover:scale-105 xl:h-[45px]"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
        />
      </a>
    </div>

    <div class="z-10 hidden items-center gap-2 lg:gap-4 xl:flex">
      <a
        href="/"
        class={`group relative px-6 py-2.5 skew-x-[-15deg] overflow-hidden border transition-all duration-300 ${isActive("/") ? "bg-red-600/20 border-red-500 shadow-[0_0_15px_rgba(220,38,38,0.4)]" : "bg-white/5 border-white/10 hover:border-red-500/50"}`}>
        <div
          class={`absolute inset-0 bg-gradient-to-r from-red-600 to-red-500 translate-y-full transition-transform duration-300 ${isActive("/") ? "translate-y-0 opacity-20" : "group-hover:translate-y-0 opacity-40"}`}>
        </div>
        <span class={`block skew-x-[15deg] relative z-10 font-bold tracking-wide transition-colors ${isActive("/") ? "text-yellow-400" : "text-gray-300 group-hover:text-white"}`}>
          <span class="mr-1">🏠</span> หน้าแรก
        </span>
      </a>

      <a
        href="/promotion"
        class={`group relative px-6 py-2.5 skew-x-[-15deg] overflow-hidden border transition-all duration-300 ${isActive("/promotion") ? "bg-red-600/20 border-red-500 shadow-[0_0_15px_rgba(220,38,38,0.4)]" : "bg-white/5 border-white/10 hover:border-red-500/50"}`}>
        <div
          class={`absolute inset-0 bg-gradient-to-r from-red-600 to-red-500 translate-y-full transition-transform duration-300 ${isActive("/promotion") ? "translate-y-0 opacity-20" : "group-hover:translate-y-0 opacity-40"}`}>
        </div>
        <span class={`block skew-x-[15deg] relative z-10 font-bold tracking-wide transition-colors ${isActive("/promotion") ? "text-yellow-400" : "text-gray-300 group-hover:text-white"}`}>
          <span class="mr-1">🎁</span> โปรโมชั่น
        </span>
      </a>

      <a
        href="/gamedemo"
        class={`group relative px-6 py-2.5 skew-x-[-15deg] overflow-hidden border transition-all duration-300 ${isActive("/gamedemo") ? "bg-red-600/20 border-red-500 shadow-[0_0_15px_rgba(220,38,38,0.4)]" : "bg-white/5 border-white/10 hover:border-red-500/50"}`}>
        <div
          class={`absolute inset-0 bg-gradient-to-r from-red-600 to-red-500 translate-y-full transition-transform duration-300 ${isActive("/gamedemo") ? "translate-y-0 opacity-20" : "group-hover:translate-y-0 opacity-40"}`}>
        </div>
        <span class={`block skew-x-[15deg] relative z-10 font-bold tracking-wide transition-colors ${isActive("/gamedemo") ? "text-yellow-400" : "text-gray-300 group-hover:text-white"}`}>
          <span class="mr-1">🎰</span> ทดลองเล่น
        </span>
      </a>

      <a
        href="/gamelogin"
        class={`group relative px-6 py-2.5 skew-x-[-15deg] overflow-hidden border transition-all duration-300 ${isActive("/gamelogin") ? "bg-red-600/20 border-red-500 shadow-[0_0_15px_rgba(220,38,38,0.4)]" : "bg-white/5 border-white/10 hover:border-red-500/50"}`}>
        <div
          class={`absolute inset-0 bg-gradient-to-r from-red-600 to-red-500 translate-y-full transition-transform duration-300 ${isActive("/gamelogin") ? "translate-y-0 opacity-20" : "group-hover:translate-y-0 opacity-40"}`}>
        </div>
        <span class={`block skew-x-[15deg] relative z-10 font-bold tracking-wide transition-colors ${isActive("/gamelogin") ? "text-yellow-400" : "text-gray-300 group-hover:text-white"}`}>
          <span class="mr-1">🌐</span> ทางเข้า
        </span>
      </a>

      <a
        href="/contact"
        class={`group relative px-6 py-2.5 skew-x-[-15deg] overflow-hidden border transition-all duration-300 ${isActive("/contact") ? "bg-red-600/20 border-red-500 shadow-[0_0_15px_rgba(220,38,38,0.4)]" : "bg-white/5 border-white/10 hover:border-red-500/50"}`}>
        <div
          class={`absolute inset-0 bg-gradient-to-r from-red-600 to-red-500 translate-y-full transition-transform duration-300 ${isActive("/contact") ? "translate-y-0 opacity-20" : "group-hover:translate-y-0 opacity-40"}`}>
        </div>
        <span class={`block skew-x-[15deg] relative z-10 font-bold tracking-wide transition-colors ${isActive("/contact") ? "text-yellow-400" : "text-gray-300 group-hover:text-white"}`}>
          <span class="mr-1">📞</span> ติดต่อเรา
        </span>
      </a>
    </div>

    <div class="z-50 flex items-center gap-2">
      <button
        id="hamburger-btn"
        class="relative flex h-[45px] w-[45px] flex-col items-center justify-center space-y-1.5 rounded-md border border-red-500/30 bg-red-900/20 p-2 transition-all hover:bg-red-900/40 xl:hidden"
        aria-label="Toggle menu">
        <span class="hamburger-line h-[2px] w-6 origin-center bg-white transition-all duration-300"></span>
        <span class="hamburger-line h-[2px] w-6 bg-white transition-all duration-300"></span>
        <span class="hamburger-line h-[2px] w-6 origin-center bg-white transition-all duration-300"></span>
      </button>
    </div>
  </div>

  <div id="mobile-overlay" class="pointer-events-none fixed inset-0 z-30 bg-black/80 opacity-0 backdrop-blur-sm transition-opacity duration-300 xl:hidden"></div>

  <div
    id="mobile-sidebar"
    class="fixed top-0 right-0 z-40 h-screen w-[280px] translate-x-full transform overflow-y-auto border-l border-red-600/50 bg-[#050508] shadow-[-10px_0_30px_rgba(0,0,0,0.8)] transition-transform duration-300 ease-out xl:hidden">
    <div class="flex flex-col space-y-3 px-6 pt-24 pb-10">
      <a
        href="/"
        class={`sidebar-item flex items-center px-4 py-3.5 rounded-lg border transition-all ${isActive("/") ? "bg-red-600/20 border-red-500 text-yellow-400 shadow-[inset_4px_0_0_rgba(220,38,38,1)]" : "bg-white/5 border-transparent text-gray-300 hover:bg-white/10 hover:text-white"}`}>
        <span class="mr-3 text-xl">🏠</span>
        <span class="text-sm font-bold">หน้าแรก</span>
      </a>

      <a
        href="/promotion"
        class={`sidebar-item flex items-center px-4 py-3.5 rounded-lg border transition-all ${isActive("/promotion") ? "bg-red-600/20 border-red-500 text-yellow-400 shadow-[inset_4px_0_0_rgba(220,38,38,1)]" : "bg-white/5 border-transparent text-gray-300 hover:bg-white/10 hover:text-white"}`}>
        <span class="mr-3 text-xl">🎁</span>
        <span class="text-sm font-bold">โปรโมชั่น</span>
      </a>

      <a
        href="/gamedemo"
        class={`sidebar-item flex items-center px-4 py-3.5 rounded-lg border transition-all ${isActive("/gamedemo") ? "bg-red-600/20 border-red-500 text-yellow-400 shadow-[inset_4px_0_0_rgba(220,38,38,1)]" : "bg-white/5 border-transparent text-gray-300 hover:bg-white/10 hover:text-white"}`}>
        <span class="mr-3 text-xl">🎰</span>
        <span class="text-sm font-bold">ทดลองเล่น</span>
      </a>

      <a
        href="/gamelogin"
        class={`sidebar-item flex items-center px-4 py-3.5 rounded-lg border transition-all ${isActive("/gamelogin") ? "bg-red-600/20 border-red-500 text-yellow-400 shadow-[inset_4px_0_0_rgba(220,38,38,1)]" : "bg-white/5 border-transparent text-gray-300 hover:bg-white/10 hover:text-white"}`}>
        <span class="mr-3 text-xl">🌐</span>
        <span class="text-sm font-bold">ทางเข้า</span>
      </a>

      <a
        href="/contact"
        class={`sidebar-item flex items-center px-4 py-3.5 rounded-lg border transition-all ${isActive("/contact") ? "bg-red-600/20 border-red-500 text-yellow-400 shadow-[inset_4px_0_0_rgba(220,38,38,1)]" : "bg-white/5 border-transparent text-gray-300 hover:bg-white/10 hover:text-white"}`}>
        <span class="mr-3 text-xl">📞</span>
        <span class="text-sm font-bold">ติดต่อเรา</span>
      </a>
    </div>
  </div>
</nav>

<style is:global>
  a {
    font-family: kanit, sans-serif !important;
  }
  /* อนิเมชันปุ่ม Hamburger กลายเป็น X */
  #hamburger-btn.active .hamburger-line:nth-child(1) {
    transform: translateY(8px) rotate(45deg);
  }
  #hamburger-btn.active .hamburger-line:nth-child(2) {
    opacity: 0;
    transform: scaleX(0);
  }
  #hamburger-btn.active .hamburger-line:nth-child(3) {
    transform: translateY(-8px) rotate(-45deg);
  }

  /* อนิเมชันเด้งไล่ระดับของเมนูใน Sidebar */
  .sidebar-item {
    opacity: 0;
    transform: translateX(20px);
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }
  /* คลาสนี้จะถูกยัดผ่าน JS เพื่อแสดงเมนู */
  .sidebar-item.item-show {
    opacity: 1;
    transform: translateX(0);
  }

  /* หน่วงเวลาให้เมนูวิ่งเข้ามาทีละอัน */
  .sidebar-item:nth-child(1) {
    transition-delay: 0.1s;
  }
  .sidebar-item:nth-child(2) {
    transition-delay: 0.15s;
  }
  .sidebar-item:nth-child(3) {
    transition-delay: 0.2s;
  }
  .sidebar-item:nth-child(4) {
    transition-delay: 0.25s;
  }
  .sidebar-item:nth-child(5) {
    transition-delay: 0.3s;
  }
</style>

<script>
  // 🌟 เขียน JS แบบบังคับสลับ Class Tailwind ตรงๆ ชัวร์สุดครับ
  const hamburgerBtn = document.getElementById("hamburger-btn");
  const overlay = document.getElementById("mobile-overlay");
  const sidebar = document.getElementById("mobile-sidebar");
  const sidebarItems = document.querySelectorAll(".sidebar-item");

  const toggleMenu = () => {
    // 1. สลับหน้าตาปุ่ม Hamburger
    hamburgerBtn?.classList.toggle("active");

    // 2. สไลด์ Sidebar (สลับ translate-x-full กับ translate-x-0)
    sidebar?.classList.toggle("translate-x-full");
    sidebar?.classList.toggle("translate-x-0");

    // 3. เปิด/ปิด แผ่นฟิล์มดำ
    overlay?.classList.toggle("opacity-0");
    overlay?.classList.toggle("opacity-100");
    overlay?.classList.toggle("pointer-events-none");
    overlay?.classList.toggle("pointer-events-auto");

    // 4. ล็อกหน้าจอหลังไม่ให้เลื่อนได้
    if (sidebar?.classList.contains("translate-x-0")) {
      document.body.style.overflow = "hidden";
      // เติมคลาสโชว์เมนูให้เด้งทีละอัน
      sidebarItems.forEach((item) => item.classList.add("item-show"));
    } else {
      document.body.style.overflow = "";
      // ซ่อนเมนูกลับไป
      sidebarItems.forEach((item) => item.classList.remove("item-show"));
    }
  };

  // ดักการกดปุ่ม
  hamburgerBtn?.addEventListener("click", toggleMenu);
  overlay?.addEventListener("click", toggleMenu);

  // ดักการกดลิงก์ข้างในให้ปิดเมนู
  sidebarItems.forEach((item) => {
    item.addEventListener("click", () => {
      if (sidebar?.classList.contains("translate-x-0")) {
        toggleMenu();
      }
    });
  });
</script>
