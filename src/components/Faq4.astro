---
export interface FaqItem {
  q: string;
  a: string;
}

export interface Props {
  title?: string;
  faqs?: FaqItem[];
}

const { title, faqs = [] } = Astro.props;
---

<div class="mx-auto max-w-[1000px] px-4 py-10 font-sans">
  {
    title && (
      <div
        class="mb-8 flex items-center gap-3 border-l-4 border-[#ed0133] bg-gradient-to-r from-[#4a0611] via-[#3a070f]/60 to-transparent px-4 py-2.5"
        style="clip-path: polygon(0 0, 100% 0, calc(100% - 15px) 100%, 0 100%);">
        <h2 class="text-xl leading-normal font-black tracking-widest text-[#ffdb7d] uppercase md:text-2xl">{title}</h2>
      </div>
    )
  }

  <div class="space-y-4">
    {
      faqs.map((faq) => (
        <details
          name="faq-terminal"
          class="faq-item group relative overflow-hidden border border-[#ed0133]/30 bg-[#2a0509]/92 backdrop-blur-sm transition-all duration-300 hover:border-[#ed0133]/60 hover:shadow-[0_15px_40px_rgba(237,1,51,0.30)]"
          style="clip-path: polygon(15px 0, 100% 0, 100% calc(100% - 15px), calc(100% - 15px) 100%, 0 100%, 0 15px);">
          <div aria-hidden="true" class="absolute top-0 left-0 h-[2px] w-16 bg-gradient-to-r from-[#ff3d63] to-transparent" />

          <summary class="flex w-full cursor-pointer items-center justify-between p-5 text-left transition-all">
            <span class="flex items-center gap-2 text-base leading-normal font-bold text-[#f9dfe3] transition-colors group-hover:text-[#ffdb7d] md:text-lg">
              <span aria-hidden="true" class="font-mono text-[#f0b429]">
                &gt;_
              </span>
              {faq.q}
            </span>

            <span
              aria-hidden="true"
              class="faq-icon ml-4 flex h-8 w-8 shrink-0 items-center justify-center border border-[#ed0133]/40 bg-[#3a070f] text-lg font-black text-[#f0b429] transition-all duration-300 group-hover:border-[#ed0133]/70 group-hover:text-[#ffdb7d]"
              style="clip-path: polygon(25% 0, 100% 0, 100% 75%, 75% 100%, 0 100%, 0 25%);">
              +
            </span>
          </summary>

          <div class="faq-answer border-t border-[#ed0133]/35 p-5 pt-4 text-left text-base leading-relaxed text-[#f9dfe3]">{faq.a}</div>
        </details>
      ))
    }
  </div>
</div>

<style>
  .faq-item > summary {
    list-style: none;
  }
  .faq-item > summary::-webkit-details-marker {
    display: none;
  }
  .faq-item[open] {
    border-color: rgba(237, 1, 51, 0.7);
    box-shadow: 0 15px 40px rgba(237, 1, 51, 0.3);
  }
  .faq-item[open] .faq-icon {
    transform: rotate(45deg);
    border-color: #ed0133;
    color: #ffdb7d;
  }
  .faq-item[open] .faq-answer {
    animation: faq-reveal 0.25s ease-out;
  }

  @keyframes faq-reveal {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-item[open] .faq-answer {
      animation: none;
    }
  }
</style>
