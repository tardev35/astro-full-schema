---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#ff7a18]/25 bg-[#24100a]/92 p-8 text-left text-base leading-relaxed text-[#f7e6d4] shadow-[0_10px_30px_rgba(255,122,24,0.14)] backdrop-blur-xl transition-all duration-500 hover:border-[#ff7a18]/50 hover:shadow-[0_15px_40px_rgba(255,122,24,0.26)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#ff7a18]/20 blur-[60px] transition-all duration-500 group-hover:bg-[#ffa347]/30"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#8d2b09]/30 blur-[60px] transition-all duration-500 group-hover:bg-[#f6c475]/30"></div>

    {
      title && (
        <header class="mb-6 flex items-center gap-4 border-b border-[#ff7a18]/25 pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffd98a] to-[#8d2b09] shadow-[0_0_10px_rgba(255,122,24,0.5)]" />
          <HeadingTag class="bg-gradient-to-r from-[#ffd98a] via-[#f6c475] to-[#ff7a18] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
