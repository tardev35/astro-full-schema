---
const reviews = [
  {
    name: "สมาชิกที่ไล่ดูคาสิโนหลายค่าย",
    role: "เริ่มจากเกมที่เข้าใจกติกาก่อนขยับวงเงิน",
    stars: 5,
    tag: "คาสิโนกว่า 13 ค่าย",
    content:
      "ค่ายเยอะช่วยเรื่องตัวเลือกโต๊ะ ภาษา วงเงิน และรูปแบบเกมจริง แต่ไม่ได้แปลว่าต้องลองให้ครบภายในวันเดียว วิธีที่ใช้แล้วไม่ตาลายคือเริ่มจากบาคาร่าหรือรูเล็ตที่เข้าใจกติกาอยู่แล้ว ดูจังหวะรอบกับวงเงินของโต๊ะให้ชิน แล้วค่อยเทียบประสบการณ์ระหว่างผู้ให้บริการทีละราย",
    avatar: "🎴",
  },
  {
    name: "สมาชิกที่เล่นทั้งสล็อตและกีฬา",
    role: "แยกวิธีเลือกของแต่ละหมวดออกจากกัน",
    stars: 5,
    tag: "สล็อตและกีฬา",
    content:
      "สล็อตกับกีฬาใช้เกณฑ์คนละชุด ฝั่งสล็อตจะดูเดิมพันเริ่มต้น ความผันผวน และฟีเจอร์โบนัส ส่วนฝั่งกีฬาต้องตรวจคู่แข่งขัน ตลาด และราคาปัจจุบันก่อนส่งบิลทุกครั้ง เริ่มที่ราว 1–10 บาทต่อรอบในเกมที่รองรับก็พอเห็นจังหวะแล้ว คำว่าแตกง่ายใช้เป็นเข็มทิศเดียวสำหรับทุกหมวดไม่ได้",
    avatar: "🎰",
  },
  {
    name: "สมาชิกที่ใช้กระเป๋าเดียวและระบบออโต้",
    role: "แบ่งงบต่อหมวดก่อน แล้วค่อยเริ่มทำรายการ",
    stars: 4,
    tag: "กระเป๋าเดียวและฝากถอนออโต้",
    content:
      "กระเป๋าเดียวทำให้เครดิตใช้ร่วมกันได้ทุกหมวด ไม่ต้องโยกยอดจากสล็อตไปคาสิโนหรือเปิดบัญชีใหม่ตอนอยากลองกีฬา ส่วนระบบออโต้ทำรายการเองได้ตลอด 24 ชั่วโมง ฝากราว 10–30 วินาที ถอนราว 1–3 นาที ข้อควรระวังคือระบบรวมเงินให้ แต่ไม่ได้แบ่งงบให้ ถ้าไม่ตั้งกรอบไว้ก่อน กระเป๋าเดียวก็เบาพร้อมกันทุกหมวด",
    avatar: "👛",
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label="เสียงจากสมาชิก WINSIAM88" class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#f5cf4d] via-[#d4a017] to-[#9a7112] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      เสียงจากสมาชิก <span class="text-[#a3e635]">WINSIAM88</span>
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#d4a017] to-transparent"></div>
  </div>

  <div class="mx-auto mb-8 flex max-w-md items-center justify-center gap-5 rounded-2xl border border-[#d4a017]/25 bg-[#0b1408]/92 px-6 py-4 shadow-[0_10px_30px_rgba(212,160,23,0.18)] backdrop-blur-xl">
    <div class="flex flex-col items-center">
      <span class="bg-gradient-to-b from-[#f5cf4d] to-[#9a7112] bg-clip-text text-4xl leading-none font-black text-transparent">{average}</span>
      <span class="mt-1 text-[10px] font-bold tracking-widest text-[#a3e635] uppercase">คะแนนเฉลี่ย</span>
    </div>
    <div class="h-12 w-px bg-[#25381a]"></div>
    <div class="flex flex-col gap-1.5">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#f5cf4d]" : "text-[#25381a]"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#a3e635]">คะแนนเฉลี่ย {average} จาก 5 ดาว จากการใช้งานจริงของสมาชิก {reviews.length} ด้าน</span>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
    {
      reviews.map((review) => (
        <article class="group relative isolate flex flex-col gap-4 overflow-hidden rounded-2xl border border-[#d4a017]/25 bg-[#0b1408]/92 p-6 text-left shadow-[0_10px_30px_rgba(212,160,23,0.18)] backdrop-blur-xl transition-all duration-300 hover:-translate-y-1 hover:border-[#d4a017]/50 hover:shadow-[0_15px_40px_rgba(212,160,23,0.3)]">
          <span class="absolute inset-y-0 left-0 -z-10 w-1 bg-gradient-to-b from-[#f5cf4d] to-[#9a7112] opacity-80 transition-opacity duration-300 group-hover:opacity-100" />
          <span class="pointer-events-none absolute -top-14 -right-14 -z-10 h-32 w-32 rounded-full bg-[#3f6212]/45 blur-[50px] transition-all duration-300 group-hover:bg-[#4d7c0f]/45" />

          <div class="flex items-center justify-between gap-3">
            <span class="inline-flex items-center gap-1.5 rounded-full border border-[#d4a017]/25 bg-[#071005] px-3 py-1 text-[10px] font-bold tracking-widest text-[#d4a017] uppercase">
              <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#a3e635]" />
              {review.tag}
            </span>
            <span class="flex gap-0.5 text-sm">
              <span aria-hidden="true" class="flex gap-0.5">
                {Array.from({ length: 5 }).map((_, i) => (
                  <span class={i < review.stars ? "text-[#f5cf4d]" : "text-[#25381a]"}>★</span>
                ))}
              </span>
              <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
            </span>
          </div>

          <p class="text-left text-base leading-relaxed text-[#dfeacf]">{review.content}</p>

          <div class="mt-auto flex items-center gap-3 border-t border-[#25381a] pt-4">
            <span aria-hidden="true" class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#d4a017]/30 bg-gradient-to-br from-[#f5cf4d] via-[#d4a017] to-[#9a7112] text-xl shadow-inner transition-transform duration-300 group-hover:scale-110">
              {review.avatar}
            </span>
            <span class="flex flex-col">
              <span class="text-sm font-black text-[#dfeacf] transition-colors group-hover:text-[#f5cf4d]">{review.name}</span>
              <span class="text-[10px] font-bold tracking-wider text-[#a3e635] uppercase">{review.role}</span>
            </span>
          </div>
        </article>
      ))
    }
  </div>
</section>
