---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative w-full max-w-[1400px] overflow-hidden rounded-3xl border border-red-600/30 bg-[#0a0a0a]/80 p-8 text-white/90 shadow-[0_10px_30px_rgba(0,0,0,0.8)] backdrop-blur-xl transition-all duration-500 hover:border-red-500/60 hover:shadow-[0_15px_40px_rgba(220,38,38,0.2)] md:p-10">
    <!-- แสงออร่าสีแดงสะท้อนที่มุมกล่องเมื่อเมาส์ชี้ -->
    <div class="pointer-events-none absolute -top-20 -left-20 h-40 w-40 rounded-full bg-red-600/10 blur-[60px] transition-all duration-500 group-hover:bg-red-500/20"></div>
    <div class="pointer-events-none absolute -right-20 -bottom-20 h-40 w-40 rounded-full bg-yellow-500/5 blur-[60px] transition-all duration-500 group-hover:bg-yellow-500/10"></div>

    {
      title && (
        <header class="mb-6 flex items-center gap-4 border-b border-red-600/40 pb-4">
          <div class="h-8 w-1.5 rounded-full bg-gradient-to-b from-red-500 to-red-700 shadow-[0_0_15px_rgba(220,38,38,0.6)]" />
          <HeadingTag class="bg-gradient-to-r from-white via-gray-200 to-gray-400 bg-clip-text text-2xl font-black tracking-widest text-transparent uppercase drop-shadow-sm">{title}</HeadingTag>
        </header>
      )
    }
    <div class="relative z-10 text-base leading-relaxed text-gray-300">
      <slot />
    </div>
  </div>
</section>
<style>
  .font-sans {
    font-family: "Kanit", sans-serif;
  }
</style>
