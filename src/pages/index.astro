---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxHuay.astro";
import ContentBoxTwo from "../components/ContentBoxTwoHuay.astro";
import ContentBoxSevenThree from "../components/ContentBoxSevenThreeHuay.astro";
import ContentBoxThreeColums from "../components/ContentBox3ThreeHuay.astro";
import Announcement from "../components/AnnouncementHuay.astro";
import ProviderGrid from "../components/LottoGrid.astro";
import LatestWinners from "../components/LatestWinnersHuay.astro";
import SmoothCarousel from "../components/SmoothCarousel.astro";
import Navfoot from "../components/Navfoot.astro";
import Faq from "../components/FaqHuay.astro";
const currentPath = Astro.url.pathname;
const homePage = Astro.url.origin;
const logoUrl = homePage + "/logo.webp";

const webPageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: "FINBET เล่นหวยออนไลน์ แทงหวยได้สนุก จ่ายเต็ม ไม่มีการอั้นเลข",
  description: "FINBET เล่นหวยออนไลน์ ข้าสู่ระบบ ซื้อหวยได้ตลอด 24 ชม แทงหวยได้สนุก ปิดรับช้า แต่ออกผลเร็ว จ่ายเต็มทุกเลข ไม่มีการอั้นเลข ตอบโจทย์ชีวิตคนยุค 2026",
  url: currentPath,
};
const webSiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "FINBET",
  alternateName: ["finbet", "finbet lotto"],
  url: "https://finnbet-vip.com/",
};
const orgSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "FINBET",
  logo: logoUrl,
  url: homePage,
};
const allSchemas = [webPageSchema, orgSchema, webSiteSchema];

import { Picture } from "astro:assets";
import image1 from "../assets/slide2.jpg";
import image2 from "../assets/banner1.jpg";
---

<MainLayout>
  <script type="application/ld+json" set:html={JSON.stringify(allSchemas)} />

  <Announcement />
  <div class="mx-auto w-full max-w-5xl px-4 py-8 text-center">
    <p class="text-4xl leading-tight font-black text-[#0a1128] drop-shadow-sm md:text-5xl">
      เลขเด็ด เลขดัง <br />
      <span class="text-[#007bff]">จ่ายสูงกว่าทุกเว็บ</span>
      <br />
      ไม่มีปิดเลข
    </p>
  </div>
  <ContentBox title="FINBET เล่นหวยออนไลน์ แทงหวยได้สนุก จ่ายเต็ม ไม่มีการอั้นเลข">
    <p class="leading-relaxed">
      FINBET เว็บเล่นหวยออนไลน์ ที่เน้นความสนุก มีรูปแบบการแทงที่ไม่จำกัดผู้เล่นเกินไป แทงหวยเหมือนเล่นหวยใต้ดิน บวกกับ แก้ปัญหา การเล่นหวยออนไลน์ ที่หลายคนเจอกัน แทงเลขไหนก็เข้าเป้า
      แต่โดนเว็บอั้นจนแทงไม่ได้ หรือถูกรางวัลแล้วรอเงินจนท้อ? เลิกวนลูปอยู่กับเว็บหวยเดิมๆ ที่ชอบกั๊กยอด FINBET จบทุกปัญหาเรื่องเลขอั้น เราใช้ระบบรับแทงตรงไม่ผ่านเอเย่นต์ เลขดังแค่ไหนก็รับแทงเต็มจำนวน
      ฝาก-ถอนด้วยระบบออโต้ 100% เงินเข้าไวไม่ต้องรอแอดมินอนุมัติ ใครอยากได้เว็บหวยที่กล้าจ่ายจริงไม่หมกเม็ด สมัครสมาชิกแล้วจิ้มเลขได้เลย
    </p>

    <div class="mt-8 flex flex-wrap justify-center gap-6">
      <a
        href="/login"
        class="group relative flex items-center justify-center rounded-full border border-red-500/50 bg-[#450a0a]/80 px-10 py-3.5 font-black text-yellow-500 backdrop-blur-sm transition-all duration-300 hover:scale-105 hover:bg-red-900/60 hover:shadow-[0_0_15px_rgba(220,38,38,0.4)]">
        เข้าระบบเกม
      </a>

      <a
        href="/register"
        class="group relative flex items-center justify-center rounded-full bg-gradient-to-r from-yellow-500 via-yellow-400 to-yellow-500 px-10 py-3.5 font-black text-[#450a0a] shadow-[0_5px_20px_rgba(251,191,36,0.4)] transition-all duration-300 hover:-translate-y-1 hover:scale-105 hover:shadow-[0_8px_25px_rgba(251,191,36,0.6)]">
        สมัครสมาชิก
      </a>
    </div>
  </ContentBox>

  <ContentBoxTwo titleleft="เข้าสู่ระบบ FINNBET" titleright="อัปเดตผลรางวัล">
    <div slot="left" class="flex flex-col gap-4">
      <div class="rounded-xl border border-gray-100 bg-white p-6 shadow-[0_5px_20px_rgba(0,0,0,0.05)]">
        <div class="flex flex-col gap-4">
          <input
            type="text"
            placeholder="เบอร์โทรศัพท์ / Username"
            class="w-full rounded-md border border-gray-200 bg-gray-50 px-4 py-3 text-[#0a1128] transition-all outline-none focus:border-[#ffd60a] focus:ring-1 focus:ring-[#ffd60a]"
          />
          <input
            type="password"
            placeholder="รหัสผ่าน"
            class="w-full rounded-md border border-gray-200 bg-gray-50 px-4 py-3 text-[#0a1128] transition-all outline-none focus:border-[#ffd60a] focus:ring-1 focus:ring-[#ffd60a]"
          />
          <button class="mt-2 w-full rounded-md bg-[#ffd60a] py-3.5 font-black text-[#0a1128] shadow-md transition-transform hover:-translate-y-0.5">เข้าสู่ระบบ</button>
          <button class="w-full rounded-md border-2 border-[#0a1128] bg-transparent py-3 font-bold text-[#0a1128] transition-colors hover:bg-[#0a1128] hover:text-white">สมัครสมาชิก</button>
        </div>
      </div>
    </div>
    <div slot="right">
      <div class="rounded-xl border border-gray-100 bg-white p-4 shadow-[0_5px_20px_rgba(0,0,0,0.05)]">
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b-2 border-[#0a1128] text-[#0a1128]">
              <th class="py-3 pl-2 text-left font-black">ประเภทหวย</th>
              <th class="py-3 font-black">รางวัลที่ 1 / 3 ตัวบน</th>
              <th class="py-3 font-black">2 ตัวล่าง</th>
            </tr>
          </thead>
          <tbody class="text-gray-700">
            <tr class="border-b border-gray-100 transition-colors hover:bg-gray-50">
              <td class="py-4 pl-2 font-bold">🇹🇭 หวยรัฐบาล</td><td class="text-center text-xl font-black text-[#007bff]">173770</td><td class="text-center text-lg font-bold">95</td>
            </tr>
            <tr class="border-b border-gray-100 transition-colors hover:bg-gray-50">
              <td class="py-4 pl-2 font-bold">🇻🇳 หวยฮานอย</td><td class="text-center text-xl font-black text-[#007bff]">4781</td><td class="text-center text-lg font-bold">03</td>
            </tr>
            <tr class="transition-colors hover:bg-gray-50">
              <td class="py-4 pl-2 font-bold">🇱🇦 หวยลาวพัฒนา</td><td class="text-center text-xl font-black text-[#007bff]">0852</td><td class="text-center text-lg font-bold">14</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </ContentBoxTwo>

  <LatestWinners />

  <ContentBoxThreeColums titleleft="มั่นคง ปลอดภัย 100%" titlecenter="ระบบฝาก-ถอน ออโต้" titleright="อัตราจ่ายสูงสุด">
    <div slot="left">การเงินมั่นคงระดับประเทศ จ่ายจริงทุกยอดบิล ไม่ว่าจะหลักร้อยหรือหลักล้าน ปลอดภัยไร้กังวล</div>
    <div slot="center">ทำรายการฝาก-ถอนรวดเร็วทันใจผ่านระบบอัตโนมัติภายใน 3 วินาที รองรับทุกธนาคารชั้นนำ</div>
    <div slot="right">ให้ราคาจ่ายสูงกว่าที่ไหนๆ หวยไทยบาทละ 900 หวยต่างประเทศบาทละ 95 แทงง่าย ไม่มีเลขอั้น</div>
  </ContentBoxThreeColums>
  <ProviderGrid />
  <ContentBox>
    <h2 class="mb-4 text-3xl font-black tracking-[0.2em] text-black uppercase drop-shadow-[0_0_10px_rgba(0,0,0,0.05)]">เข้าสู่ระบบ FINBET เว็บหวยออนไลน์ ปลอดภัย ซื้อหวยได้ตลอด 24 ชม.</h2>
    <p class="leading-relaxed">
      ทางเข้าเล่น FINBET ของจริงต้องกดผ่านเว็บหลักเท่านั้น เพื่อความปลอดภัยของข้อมูลและยอดเงินในบัญชี คุณกดเข้าสู่ระบบเมื่อไหร่ ก็เข้าหน้าแทงหวยได้ทันที ไม่ต้องรอคิว ไม่ต้องส่งสลิปให้ใครตรวจสอบ
      ทุกการเข้าใช้งานคือการเชื่อมต่อตรงกับเซิร์ฟเวอร์หลัก ทำให้มั่นใจได้ว่าโพยหวยของคุณจะไม่หายหรือถูกแก้ไข หน้าเว็บเปิดให้แทงตลอด 24 ชั่วโมง ตื่นมาตอนไหนหรือจะแทงหวยรอบไหนก็กดได้เลย
      ระบบเซิร์ฟเวอร์เรานิ่ง ไม่ค้าง ไม่ล่มตอนช่วงนาทีทองก่อนหวยออก ความปลอดภัยสูงที่สุดเพราะเราใช้ระบบล็อคอินที่ป้องกันการแฮ็กข้อมูล
    </p>
  </ContentBox>
  <ContentBoxSevenThree titleleft="" titleright="ถอนจริง 3 วินาที">
    <div slot="left" class="flex h-full flex-col justify-center">
      <Picture
        src={image1}
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600, 800]}
        sizes="(max-width: 768px) 100vw, 50vw"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
        alt="Vegus24 VIP Service"
        class="mx-auto h-auto w-full rounded-2xl border-2 border-yellow-500/30 shadow-[0_10px_30px_rgba(220,38,38,0.3)]"
      />
    </div>
    <div slot="right">
      <h2 class="text-yellow-4000 mb-4 text-3xl font-black tracking-[0.2em] uppercase drop-shadow-[0_0_10px_rgba(0,0,0,0.05)]">มากกว่าแค่หวยไทย ครบวงจรความบันเทิง เล่นหวยออนไลน์ ที่หลากหลาย</h2>
      <p>
        คนเล่นหวยตัวจริงเขาไม่มารอหวยรัฐบาลออกแค่เดือนละสองรอบหรอก เสียเวลา ที่นี่เราจัดหวยมาให้คุณกดแทงได้แทบทุกชั่วโมง ทั้งหวยลาว หวยฮานอย หวยหุ้น และหวยต่างประเทศอีกเพียบ ใครที่ชอบไล่เลขตัวเดียว
        หรืออยากแก้ตัวจากเลขที่พลาดไป หวยพวกนี้แหละคือทางออก แทงได้ตั้งแต่วันจันทร์ยันอาทิตย์ อยากรวยวันไหนก็กดเลขได้เลย โอกาสทำกำไรมีให้ลุ้นทุกวัน ไม่ต้องรอหวยไทยอย่างเดียวครับ
      </p>

      <a
        href="/line"
        class="inline-flex items-center bg-[#00B900] px-8 py-3 font-bold text-white shadow-lg transition-transform hover:scale-105"
        style="clip-path: polygon(15% 0, 100% 0, 100% 70%, 85% 100%, 0 100%, 0 30%);">
        <span class="mr-2 text-xl">LINE</span> ติดต่อแอดมิน
      </a>
    </div>
  </ContentBoxSevenThree>
  <SmoothCarousel />
  <ContentBox>
    <h3 class="mb-4 text-3xl font-black tracking-[0.2em] text-yellow-400 uppercase drop-shadow-[0_0_10px_rgba(0,0,0,0.05)]">หวยลาวและฮานอย: แทงได้ทุกวัน ไม่ต้องรอหวยรัฐบาล</h3>
    <p class="leading-relaxed">
      หวยรัฐบาลไทยกว่าจะออกทีก็รอคอแห้ง แต่คนเล่นหวยจริงๆ เขาไม่มารอเวลาครับ หวยลาวกับฮานอยนี่แหละคือของแก้ขัดชั้นดีที่ทำกำไรได้ทุกวัน ใครชอบตามเลขวิ่ง
      หรือสายชอบแทงเลขชุดบอกเลยว่าสองหวยนี้ทำรอบได้ไวสุด แทงวันนี้รู้ผลวันนี้ ไม่ต้องถือโพยรอข้ามสัปดาห์ให้เสียจังหวะ
    </p>
    <h3 class="mb-4 text-3xl font-black tracking-[0.2em] text-yellow-400 uppercase drop-shadow-[0_0_10px_rgba(0,0,0,0.05)]">หวยหุ้นรอบเช้า-เย็น: วัดผลไว จบเร็ว ได้เงินทันใจ</h3>
    <p class="leading-relaxed">
      สำหรับสายใจร้อนที่ไม่อยากรอผลนาน หวยหุ้นคือคำตอบที่ดีที่สุด เพราะมันอิงตามผลตลาดหลักทรัพย์ ออกรางวัลวันละหลายรอบ ทั้งเช้า สาย บ่าย เย็น มีจังหวะให้คุณแก้ตัวหรือทำกำไรได้ตลอดวัน
      ใครที่ชอบวิเคราะห์กราฟหรือดูสถิติหวยหุ้นแล้วอยากรู้ผลไวๆ เพื่อเอาทุนไปต่อยอดในรอบถัดไป นี่คือหวยที่ตอบโจทย์ที่สุดแล้วครับ
    </p>
    <h3 class="mb-4 text-3xl font-black tracking-[0.2em] text-yellow-400 uppercase drop-shadow-[0_0_10px_rgba(0,0,0,0.05)]">หวยต่างประเทศครบทุกตลาด: รวมมาให้เลือกเล่นได้ไม่จำกัด</h3>
    <p class="leading-relaxed">
      เราไม่ได้หยุดแค่ตลาดในประเทศ แต่ขนหวยต่างประเทศมาให้เลือกเล่นอีกเพียบ ทั้งหวยมาเลย์ หวยหุ้นต่างประเทศ และตลาดอื่นๆ ทั่วโลก เพื่อเปิดทางเลือกให้คุณมีช่องทางทำกำไรได้ตลอด 24 ชั่วโมง
      อยากลองเลขแปลกๆ หรืออยากตามสถิติหวยต่างแดนก็จัดได้เต็มที่ มีให้เล่นทุกวันไม่มีเว้นว่าง อยากแทงเลขไหน ตลาดไหน FINBET จัดให้ครบครับ
    </p>
  </ContentBox>

  <Faq />
  <ContentBoxTwo titleleft="จ่ายเต็มทุกเลข ไม่มีการอั้นเลข จบปัญหาการแทงหวยไม่ได้เพราะ 'เลขดัง'" titleright="แทงหวยได้สนุก ระบบ FINBET ปิดรับช้า แต่ออกผลเร็ว ไม่พลาดทุกโอกาสก่อนนาทีสุดท้าย">
    <div slot="left" class="flex flex-col gap-4">
      <p>
        เคยไหม? อุตส่าห์ตามหาเลขเด็ดมาแทบตาย ได้มาแล้ว พอจะกดแทงดันเจอระบบแจ้งว่า "เลขนี้อั้น" หรือ "งดรับแทง" บอกเลยว่านั่นคือสัญญาณเตือนว่าเว็บที่คุณเล่นอยู่ "ทุนไม่หนา"
        หรือเป็นแค่เอเย่นต์กระจอกที่บริหารความเสี่ยงเองไม่ได้ ที่ FINBET เราทิ้งปัญหานี้ไปตั้งแต่วันแรกที่วางระบบ เพราะเรามองว่าถ้าคุณกล้าแทง เราก็กล้ารับ
        ทุกตัวเลขที่คุณจิ้มมาคือความเสี่ยงที่คุณยอมรับได้ และเราคือคู่ชกที่พร้อมจ่ายจริงเมื่อคุณแทงถูก
      </p>
    </div>
    <div slot="right">
      <p>
        ปัญหาที่คอหวยเจอจนชินคือ "เว็บชอบปิดรับแทงก่อนเวลาจริง" บางเจ้าปิดหนีความเสี่ยงเร็วเกินไปจนเรากดเลขไม่ทัน หรือที่น่าหงุดหงิดกว่าคือพอถึง 15 นาทีสุดท้ายที่คนแห่เข้ามาแทง เว็บก็ดันค้าง หมุนติ้ว
        กดส่งไม่ไป ที่ FINBET เราแก้ปัญหานี้ด้วยเซิร์ฟเวอร์เกรดสูงที่รองรับ Traffic มหาศาล คุณกดแทงได้จนถึงวินาทีที่ระบบปิดรับจริง ไม่มีการดึงเกม ไม่มีการตัดรอบหนี
      </p>
    </div>
  </ContentBoxTwo>
  <ContentBox>
    <h2 class="mb-4 text-2xl font-black tracking-[0.2em] text-yellow-400 uppercase drop-shadow-[0_0_10px_rgba(0,0,0,0.05)]">ลุ้นหวย อย่างมีสไตล์ ทำไมการแทงหวยที่ FINBET ถึงตอบโจทย์ชีวิตคนยุค 2026</h2>
    <p class="leading-relaxed">
      FINBET เราออกแบบมาให้หวยออนไลน์กลายเป็นเครื่องมือทำกำไรที่รวดเร็วและปลอดภัยที่สุดสำหรับคนยุคนี้ จะแทงตอนพักเที่ยง ตอนเดินทาง หรือแทงก่อนนอน คุณก็จัดการโพยได้เอง 24 ชั่วโมง สไตล์คนยุคใหม่คือ
      "ต้องรู้ยอดทันที" เงินเข้า-ออกผ่านระบบออโต้ที่คุณกดทำรายการเอง จบปัญหาเรื่องแอดมินดึงเช็ง แทงหวยยุค 2026 มันต้องจบที่มือถือเครื่องเดียว การมีสไตล์ในที่นี้ไม่ใช่เรื่องกราฟิกสวยหรู แต่มันคือ
      "ความคล่องตัว" และ "อำนาจในการจัดการเงิน" ของตัวคุณเอง
    </p>
  </ContentBox>

  <Navfoot />

  <style>
    :global(.text-yellow-gradient) {
      background: linear-gradient(to bottom, #e7d800 0%, #ddd44e 100%) !important;
      -webkit-background-clip: text !important;
      -webkit-text-fill-color: transparent !important;
    }
  </style>
</MainLayout>
