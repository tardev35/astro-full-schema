---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement3 from "../components/Announcement3.astro";

import { Picture } from "astro:assets";
import { itemList, pageGraph, schemaCtx } from "../lib/schema";
import image1 from "../assets/gamedemo7.webp";
import image2 from "../assets/gamedemo8.webp";
import image3 from "../assets/gamedemo9.webp";
import image4 from "../assets/gamedemo10.webp";
import image5 from "../assets/gamedemo11.webp";
import image6 from "../assets/gamedemo12.webp";
import image7 from "../assets/gamedemo13.webp";
import image8 from "../assets/gamedemo14.webp";
import image9 from "../assets/gamedemo15.webp";
import image10 from "../assets/gamedemo16.webp";
import image11 from "../assets/gamedemo17.webp";
import image12 from "../assets/gamedemo18.webp";

const demoGames = [
  { name: "AskmeSlot", src: image1, alt: "แบนเนอร์ค่าย askmeslot โลโก้โพดำสีทองที่มีสัญลักษณ์ไพ่อยู่ข้างใน คู่กับตัวการ์ตูนเด็กชายสวมหมวกแดงติดดาว กางแขนวิ่งบนถนนในเมืองยุโรปที่มีกังหันลม" },
  { name: "Popular Game", src: image2, alt: "แบนเนอร์ Popular Game ตัวอักษรทองนูนหน้าวงแหวนชิปคาสิโนสีทอง ขนาบด้วยกระต่ายถือหีบสมบัติกับแมวใส่แว่นกันแดด ท่ามกลางเหรียญทองและชิปที่ลอยฟุ้ง" },
  { name: "SlotXO", src: image3, alt: "แบนเนอร์ค่าย SLOTXO โลโก้ตู้สล็อตล้อมด้วยเหรียญทอง คู่กับนักรบโรมันผมขาวสวมมงกุฎใบลอเรลและเกราะทอง ยืนหน้าโคลอสเซียมกับทหารอีกสองนาย" },
  { name: "Skywind Group", src: image4, alt: "แบนเนอร์ค่าย Skywind Group โลโก้วงกลมสี่สีบนพื้นดำ คู่กับแมวกวักนำโชคสีขาวคาดกระพรวนทอง ยืนข้างไหทองและถุงเงินสีม่วงใต้ต้นซากุระ" },
  { name: "PG Soft", src: image5, alt: "แบนเนอร์ค่าย PG Pocket Games Soft โลโก้ตัวอักษรพิกเซลบนพื้นดำ คู่กับตัวละครหญิงนักรบผิวแทนสวมเครื่องประดับทองและหมวกขนนกสไตล์แอซเท็ก" },
  { name: "SBOBET", src: image6, alt: "แบนเนอร์ค่ายเกม SBOBET โลโก้ตัวอักษรขาวบนพื้นดำ คู่กับตัวการ์ตูนอนิเมะสาวหูจิ้งจอกผมบลอนด์ในชุดกิโมโนสีชมพู มือถืออมยิ้มเกลียวหลากสี" },
  { name: "Sexy Slot", src: image7, alt: "แบนเนอร์ค่าย Sexy Slot ตัวอักษรสีชมพูม่วงมีประกายวิบวับ คู่กับตัวการ์ตูนสาวผมน้ำตาลในชุดรัดรูปสีม่วง นั่งอยู่ในกรอบวงกลมที่ล้อมด้วยหัวใจสีชมพู" },
  { name: "JILI", src: image8, alt: "แบนเนอร์ค่ายเกม JILI ตัวอักษรทองบนพื้นดำ คู่กับนางเงือกผมแดงสวมเกราะเปลือกหอยสีทอง ยกหอยสังข์แนบหูอยู่ใต้ทะเลที่มีปลาการ์ตูนและปะการัง" },
  { name: "Ask Me Bet", src: image9, alt: "แบนเนอร์ค่ายเกม ask me bet โลโก้สามช่องสีขาวเขียวเหลืองบนพื้นดำ คู่กับหัวสิงโตเชิดตรุษจีนสีแดงทองตาโต ใต้แถวโคมไฟแดงหน้าศาลเจ้า" },
  { name: "New Game", src: image10, alt: "แบนเนอร์ New Game ตัวอักษรสีขาวนูนกลางภาพ ขนาบด้วยตัวการ์ตูนฟักทองหัวไฟกับโครงกระดูกยิ้ม ยืนบนฟลอร์นีออนสีชมพูฟ้าที่เกลื่อนด้วยชิปและลูกเต๋า" },
  { name: "JOKER", src: image11, alt: "แบนเนอร์ค่ายเกม JOKER ตัวอักษรขาวทองบนพื้นดำ คู่กับนักรบโรมันสวมหมวกเหล็กติดขนนกและถือโล่ ยืนเคียงสิงโตกำลังคำรามกลางสนามประลอง" },
  { name: "AFB Gaming", src: image12, alt: "แบนเนอร์ค่ายเกม AFB Gaming โลโก้ตัวอักษรทองบนพื้นดำ คู่กับเทพซุสเคราขาวตาเรืองแสงสีฟ้า สวมมงกุฎใบลอเรลและกำไลทองหน้าวิหารกรีก" },
];

const gameList = demoGames.map((game) => ({ name: game.name, imagePath: game.src.src }));

const pageTitle = "ทดลองเล่นสล็อต YIMSIAM889 - ลองระบบเกมก่อนใช้เครดิตจริง";

const pageHeading = "ทดลองเล่นสล็อต YIMSIAM889 เปิดดูระบบเกมก่อนลงเครดิตจริง";

const pageDescription =
  "ทดลองเล่นสล็อต YIMSIAM889 เว็บตรงไม่ผ่านเอเย่นต์ เปิดดูหน้าเกมจากค่าย PG SOFT Joker Gaming และ Pragmatic Play ก่อนใช้เครดิตจริง ดูเดิมพันต่อรอบและฟีเจอร์โบนัส";

const ctx = schemaCtx(Astro);
const graph = pageGraph(Astro, {
  type: "CollectionPage",
  name: pageHeading,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  ],
  extra: [
    itemList(ctx, {
      name: "ทดลองเล่นเกมสล็อตของ YIMSIAM889",
      alternateName: "YIMSIAM889 โหมดทดลองสล็อตหลายค่ายบนมือถือก่อนเล่นด้วยเงินจริง",
      itemType: "Game",
      items: gameList,
    }),
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement3 />

  <ContentBox title={pageHeading}>
    <div>
      <h2 class="mb-6 bg-gradient-to-r from-[#f8dc9a] via-[#e9b949] to-[#a81f1a] bg-clip-text text-2xl leading-normal font-bold text-transparent">โหมดทดลองของ YIMSIAM889 มีไว้ทำอะไร และควรพิจารณาอะไรก่อนเลือกเกม</h2>

      <p class="mb-8 text-left text-base leading-relaxed text-[#f2ddc4]">
        YIMSIAM889 (ยิ้มสยาม889) ให้บริการในรูปแบบเว็บตรง ไม่ผ่านเอเย่นต์หรือนายหน้าใดทั้งสิ้น เราเชื่อมต่อสัญญาณเกมตรงจากค่ายแม่ หน้ารวมเกมจึงแบ่งตามค่ายและรูปแบบการเล่นไว้ชัดเจน ทั้ง PG SOFT, JOKER, JILI, SLOTXO, Skywind และ AFB Gaming อยู่ในเมนูภาษาไทยชุดเดียวกัน ไม่ต้องแปลไทยเป็นไทยอีกรอบขอรับ
        หน้านี้จัดไว้ให้ท่านกดเปิดดูหน้าเกมก่อนว่าระบบหน้าตาเป็นอย่างไร ปุ่มปรับเดิมพันอยู่ตรงไหน ฟีเจอร์ฟรีสปินเรียกใช้อย่างไร และหนึ่งรอบกินเวลาเท่าไร โดยที่ยังไม่ต้องใส่เงินจริงและไม่มีการได้เสียเกิดขึ้นแม้แต่บาทเดียว
        สิ่งที่ควรทัศนาจริงๆ คือเดิมพันเริ่มต้นต่อรอบ ความผันผวนของเกม และรูปแบบการจ่าย มากกว่าจะดูว่าเกมไหนกำลังเป็นที่กล่าวขานที่สุด เกมดังช่วยให้หารีวิวง่ายก็จริง แต่ไม่ได้ช่วยเจรจากับระบบสุ่มให้ท่านเป็นการส่วนตัวขอรับ
      </p>

      <div class="mb-5 grid grid-cols-2 gap-5 sm:grid-cols-2 md:grid-cols-4">
        {
          demoGames.map((game) => (
            <div class="group/game relative mx-auto w-full max-w-[400px] overflow-hidden rounded-xl">
              <Picture
                src={game.src}
                alt={game.alt}
                loading="lazy"
                fetchpriority="low"
                widths={[200, 400, 600]}
                sizes="(max-width: 768px) 100vw, 25vw"
                class="block h-auto w-full object-cover shadow-[0_10px_30px_rgba(168,31,26,0.18)] transition-transform duration-300 group-hover/game:scale-105"
                decoding="async"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
                quality={60}
              />
              <a
                href="/register"
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`สมัครสมาชิกเพื่อเล่น ${game.name} ที่ YIMSIAM889`}
                class="absolute inset-0 flex items-center justify-center bg-[#140604]/75 opacity-0 transition-opacity duration-300 group-hover/game:opacity-100 focus-visible:opacity-100">
                <span class="rounded-full border border-[#a81f1a]/60 bg-gradient-to-r from-[#f8dc9a] via-[#e9b949] to-[#5e0f06] px-6 py-2 font-bold text-[#140604] shadow-[0_10px_30px_rgba(168,31,26,0.30)] transition-transform hover:scale-110">เล่นเลย</span>
              </a>
            </div>
          ))
        }
      </div>

      <h2 class="mt-8 mb-6 bg-gradient-to-r from-[#f8dc9a] via-[#e9b949] to-[#a81f1a] bg-clip-text text-2xl leading-normal font-bold text-transparent">โหมดทดลองบอกอะไรได้ และบอกอะไรไม่ได้</h2>

      <p class="mb-4 text-left text-base leading-relaxed text-[#f2ddc4]">
        โหมดทดลองบอกได้ว่าเกมทำงานอย่างไร เมนูอยู่ตรงไหน ฟีเจอร์ซื้อฟรีสปินเรียกใช้อย่างไร และหนึ่งรอบใช้เวลาเท่าไร แต่เครดิตในโหมดนี้เป็นยอดสมมติ ถอนไม่ได้ และผลที่ออกมาก็ไม่ได้แปลว่าเล่นจริงแล้วจะออกในรูปแบบเดียวกัน
        เกมของ YIMSIAM889 ทำงานตามค่า RTP มาตรฐานสากลที่ค่ายแม่กำหนดมา ไม่มีใครมาแอบปรับหลังบ้านให้ท่านหงุดหงิดหัวใจ ฉะนั้นต่อให้กดในโหมดทดลองแล้วจังหวะเข้ามือ ก็มิใช่หลักฐานว่าเกมนั้นกำลังอารมณ์ดีรอท่านอยู่ โหมดนี้มีไว้ศึกษาระบบ ไม่ใช่ไว้ดูดวงผ่านหน้าจอขอรับ
      </p>

      <p class="mb-4 text-left text-base leading-relaxed text-[#f2ddc4]">
        อีกเรื่องที่ควรเผื่อใจไว้คือโหมดทดลองไม่ได้มีให้ครบทุกเกม จึงควรเปิดหน้ารายละเอียดของเกมดูเสียก่อนเลือก และยอดที่หมุนในโหมดทดลองไม่นับเป็นยอดเทิร์นของบัญชีหรือของโปรโมชั่นใดทั้งสิ้น
        ถ้าเกมที่อยากลองยังไม่มีปุ่มทดลอง ให้ถือเสียว่าวันนี้ยังไม่ถูกจังหวะ มิใช่สัญญาณลับที่ระบบส่งมาให้ท่านคนเดียว และเวลาเทียบเกมกัน ให้ดูที่จำนวนไลน์ ตัวคูณ และเงื่อนไขการเข้าฟรีสปิน แล้วเอามาเทียบกับงบต่อรอบของตัวท่านเอง นั่นคือข้อมูลที่นำไปตัดสินใจได้จริง ไม่ใช่ความรู้สึกว่าเกมไหนหน้าตาใจดีกว่ากัน
      </p>

      <h2 class="mt-8 mb-6 bg-gradient-to-r from-[#f8dc9a] via-[#e9b949] to-[#a81f1a] bg-clip-text text-2xl leading-normal font-bold text-transparent">จากโหมดทดลองไปเล่นจริงกับ YIMSIAM889 ควรเตรียมอะไรบ้าง</h2>

      <p class="mb-2 text-left text-base leading-relaxed text-[#f2ddc4]">
        เมื่อท่านพร้อมขยับจากโหมดทดลองไปเล่นด้วยเงินจริง เรื่องที่ควรจัดแจงก่อนคือบัญชี งบต่อรอบ และลิงก์ที่ใช้เข้า ด้านบัญชี การสมัครกับเราเรียบง่ายเพียงลัดนิ้วมือเดียว แต่ชื่อบัญชีธนาคารต้องตรงกับผู้สมัครและเบอร์โทรต้องรับข้อความได้จริง เพราะระบบจะว่องไวเพียงใด ถ้ากรอกชื่อบัญชีคลาดเคลื่อนตั้งแต่แรกแล้วมาตามแก้ทีหลัง ความเร็วนั้นก็หายไปหมดสิ้น
        ด้านงบ ท่านที่เพิ่งเข้ามาเป็นสมาชิกใหม่มีโบนัสต้อนรับจัดเตรียมไว้ให้ ถือเป็นน้ำใจเล็กๆ น้อยๆ ที่ช่วยให้มีกระสุนเริ่มต้นมากขึ้น ส่วนธุรกรรมนั้นเป็นระบบอัตโนมัติเต็มรูปแบบ ทำรายการเองได้ผ่านแอปพลิเคชันธนาคารชั้นนำหรือทรูวอลเลท ไม่ต้องส่งสลิปให้แอดมินตรวจให้เสียเวลา ฝากปุ๊บเงินเข้าปั๊บ ถอนปุ๊บโอนเข้าบัญชีทันที
        สุดท้ายควรเข้าใช้งานผ่านทางเข้าจริงของ YIMSIAM889 ที่ตรวจชื่อเว็บไซต์แล้วและเชื่อมต่อแบบ HTTPS เท่านั้น ไม่ใช่ลิงก์ที่ส่งต่อกันมาในแชตพร้อมคำโฆษณาหวือหวา เพราะลิงก์แบบนั้นมักพาไปพบอะไรจริงอยู่ แต่ไม่ใช่ในทางที่เราหวังไว้ ทางเข้าของเรารองรับทั้งมือถือ iOS และ Android รวมถึงคอมพิวเตอร์และแท็บเล็ต อยู่ที่ไหนก็สนุกได้ขอรับ
      </p>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
