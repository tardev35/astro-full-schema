---
export interface Props {
  titleleft?: string;
  titleright?: string;
  label?: string;
}
const { titleleft, titleright, label } = Astro.props;

const sectionLabel = label ?? titleleft ?? titleright ?? "ข้อมูลประกอบ";
---

<section aria-label={sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#ece2fb]">
      {
        titleleft && (
          <p class="flex items-center gap-3 border-b border-[#ffd400]/25 pb-3 text-xl leading-normal font-black tracking-widest text-[#ffd400] uppercase">
            <span aria-hidden="true" class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#ffd400]/40 bg-gradient-to-br from-[#ffe94d] via-[#ffd400] to-[#b8860a] text-sm text-[#1a0330] shadow-[0_5px_15px_rgba(255,212,0,0.3)]">
              🔐
            </span>
            {titleleft}
          </p>
        )
      }
      <slot name="left" />
    </article>

    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#ece2fb]">
      {
        titleright && (
          <p class="flex items-center gap-3 border-b border-[#ffd400]/25 pb-3 text-xl leading-normal font-black tracking-widest text-[#ffd400] uppercase">
            <span aria-hidden="true" class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#8f1080]/60 bg-gradient-to-br from-[#ff4fd8] via-[#8f1080] to-[#5c0a52] text-sm text-[#1a0330] shadow-[0_5px_15px_rgba(255,79,216,0.35)]">
              🎰
            </span>
            {titleright}
          </p>
        )
      }
      <slot name="right" />
    </article>
  </div>
</section>
