---
export interface Props {
  title?: string;
  titleleft?: string;
  titleright?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, titleleft, titleright, as: HeadingTag = "h2" } = Astro.props;
---

<section class="my-10 flex w-full justify-center px-4 font-sans">
  <div
    class="relative isolate w-full max-w-7xl rounded-2xl border-2 border-[#5a1a1e] bg-gradient-to-b from-[#170a0b] to-[#0a0506] p-8 pt-40 shadow-[0_10px_30px_rgba(224,27,45,0.20)] md:pt-36">
    <div aria-hidden="true" class="pointer-events-none absolute -top-16 -right-10 -z-10 h-40 w-40 rounded-full bg-[#bdcad2]/18 blur-[60px]"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -bottom-16 -left-10 -z-10 h-40 w-40 rounded-full bg-[#e01b2d]/24 blur-[60px]"></div>

    {
      title && (
        <div class="absolute -top-6 left-1/2 flex w-[92%] max-w-2xl -translate-x-1/2 items-center justify-center gap-2 rounded-lg border-2 border-[#e01b2d]/55 bg-[#220d0f] px-4 py-2.5 text-center shadow-[0_10px_30px_rgba(224,27,45,0.30)] sm:px-8">
          <span aria-hidden="true" class="shrink-0 text-[#bdcad2]">
            ✦
          </span>
          <HeadingTag class="min-w-0 bg-gradient-to-r from-[#ff3b46] via-[#f2f5f7] to-[#bdcad2] bg-clip-text text-lg leading-normal font-black tracking-tight text-transparent uppercase sm:text-xl md:text-2xl">
            {title}
          </HeadingTag>
          <span aria-hidden="true" class="shrink-0 text-[#bdcad2]">
            ✦
          </span>
        </div>
      )
    }

    <div class="grid grid-cols-1 gap-10 md:grid-cols-2">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#dce3e8]">
        {titleleft && <p class="text-2xl leading-normal font-bold text-[#f2f5f7]">{titleleft}</p>}
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#dce3e8] md:border-l md:border-[#5a1a1e] md:pl-10">
        {titleright && <p class="text-2xl leading-normal font-bold text-[#f2f5f7]">{titleright}</p>}
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
