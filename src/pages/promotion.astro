---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement4.astro";

import { Picture } from "astro:assets";
import pro1 from "../assets/slide1.jpg";
import pro2 from "../assets/slide2.jpg";
import pro3 from "../assets/slide3.jpg";
import pro4 from "../assets/slide4.jpg";
---

<MainLayout
  title="โปรโมชั่น CEO66 สิทธิประโยชน์เยอะ รวมโบนัสมาตรฐานเว็บใหญ่"
  ,
  description="โปรโมชั่น CEO66 เพิ่มโอกาสทำกำไรโดยเฉพาะ เงื่อนไขชัดเจน ไม่ซับซ้อน รับสิทธิประโยชน์จากระบบ CEO66 เว็บ API แท้">
  <Announcement />
  <ContentBox>
    <h1 class="mb-7 text-3xl">โปรโมชั่น CEO66 สิทธิประโยชน์เยอะ รวมโบนัสมาตรฐานเว็บใหญ่</h1>

    <div class="mx-auto grid w-full max-w-7xl grid-cols-1 gap-6 px-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-2">
      <Picture
        src={pro1}
        alt="โปรโมชั่นสมัครสมาชิกใหม่ ฝากครั้งแรกรับโบนัสฟรี 60% สำหรับคาสิโน"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600]}
        sizes="(max-width: 768px) 100vw, 33vw"
        class="mx-auto h-auto w-full rounded-xl object-contain shadow-lg transition-transform duration-300 hover:-translate-y-1 hover:shadow-2xl"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />

      <Picture
        src={pro2}
        alt="แจกโบนัสรายวัน ยอดฝากแรกรับโบนัสฟรี 20% สำหรับคาสิโน"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600]}
        sizes="(max-width: 768px) 100vw, 33vw"
        class="mx-auto h-auto w-full rounded-xl object-contain shadow-lg transition-transform duration-300 hover:-translate-y-1 hover:shadow-2xl"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />

      <Picture
        src={pro3}
        alt="โปรโมชั่นสมัครสมาชิกใหม่ ฝากครั้งแรกรับโบนัสฟรี 60% สำหรับสล็อต"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600]}
        sizes="(max-width: 768px) 100vw, 33vw"
        class="mx-auto h-auto w-full rounded-xl object-contain shadow-lg transition-transform duration-300 hover:-translate-y-1 hover:shadow-2xl"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />

      <Picture
        src={pro4}
        alt="แจกโบนัสทุกยอด ทุกยอดฝากรับโบนัสฟรี 20% สำหรับสล็อต"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600]}
        sizes="(max-width: 768px) 100vw, 33vw"
        class="mx-auto h-auto w-full rounded-xl object-contain shadow-lg transition-transform duration-300 hover:-translate-y-1 hover:shadow-2xl"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />
    </div>
  </ContentBox>
</MainLayout>
<Navfoot />
