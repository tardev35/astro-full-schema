---
const {
  message = "VODKAFUN สล็อตเวอร์ชั่นใหม่ล่าสุด รวมเกมครบครัน ทั้งสล็อต ยิงปลา กีฬา คาสิโน และหวย ในบัญชีสมาชิกเดียว • ฝากถอนระบบออโต้ รองรับทรูมันนี่วอเล็ตตามช่องทางที่เปิดให้บริการ ตรวจสอบสถานะรายการได้ทุกครั้ง • สมัครสมาชิกและเข้าสู่ระบบผ่านทางเข้า VODKAFUN ที่ตรวจสอบแล้วเท่านั้น • ตรวจชื่อเว็บไซต์และ URL ให้ตรงกับช่องทางที่แบรนด์ประกาศก่อนกรอกข้อมูลสำคัญ • เงื่อนไขโปรโมชั่นและยอดขั้นต่ำอาจเปลี่ยนตามช่วงเวลา ดูข้อมูลล่าสุดในระบบก่อนทำรายการ",
} = Astro.props;

const SCROLL_PX_PER_SEC = 50;
const PX_PER_CHAR = 6.2;
const TRAILING_PX = 81;
const scrollSeconds = Math.max(12, Math.round((message.length * PX_PER_CHAR + TRAILING_PX) / SCROLL_PX_PER_SEC));
---

<div class="mx-auto w-full max-w-7xl px-4 py-3 font-sans">
  <div class="relative overflow-hidden rounded-md border border-[#c8fc04]/45 bg-[#041a06] shadow-[0_0_15px_rgba(200,252,4,0.2)]">
    <div aria-hidden="true" class="absolute top-0 -left-4 h-full w-8 -skew-x-12 bg-gradient-to-b from-[#e6ff6a] to-[#3fc20a]"></div>
    <div aria-hidden="true" class="absolute top-0 -right-4 h-full w-8 -skew-x-12 bg-[#3fc20a]/25"></div>

    <div class="flex items-center">
      <div class="relative z-10 flex w-12 shrink-0 items-center justify-center bg-gradient-to-b from-[#e6ff6a] to-[#3fc20a] py-2.5">
        <span aria-hidden="true" class="animate-pulse text-lg drop-shadow-[0_0_5px_rgba(243,255,233,0.85)]">🍾</span>
      </div>

      <div class="marquee-container relative flex-1 overflow-hidden py-2.5 pr-6">
        <div aria-hidden="true" class="pointer-events-none absolute top-0 left-0 z-10 h-full w-8 bg-gradient-to-r from-[#041a06] to-transparent"></div>
        <div aria-hidden="true" class="pointer-events-none absolute top-0 right-0 z-10 h-full w-12 bg-gradient-to-l from-[#041a06] to-transparent"></div>

        <div class="marquee-content inline-block pl-4 text-sm font-bold tracking-wide whitespace-nowrap text-[#f3ffe9]" style={`animation-duration:${scrollSeconds}s`}>
          <span class="mr-8 inline-flex items-center gap-2"><span aria-hidden="true" class="h-1.5 w-1.5 rounded-full bg-[#c8fc04] shadow-[0_0_5px_rgba(200,252,4,0.85)]"></span>{message}</span>
          <span aria-hidden="true" class="mr-8 inline-flex items-center gap-2"><span class="h-1.5 w-1.5 rounded-full bg-[#c8fc04] shadow-[0_0_5px_rgba(200,252,4,0.85)]"></span>{message}</span>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .marquee-content {
    animation: marquee 25s linear infinite;
  }
  .marquee-container:hover .marquee-content {
    animation-play-state: paused;
  }
  @keyframes marquee {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee-content {
      animation: none;
    }
  }
</style>
