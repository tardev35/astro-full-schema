---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "./components/ContentBox.astro";
import Navfoot from "./components/Navfoot.astro";
import Footer from "./components/FooterStyle2.astro";
import Announcement from "./components/Announcement.astro";

import { Picture } from "astro:assets";
import image1 from "../assets/pro1.jpg";
import image2 from "../assets/pro2.jpg";
import image3 from "../assets/pro3.jpg";
import image4 from "../assets/pro4.jpg";

const currentPath = Astro.url.pathname;
const webPageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: "โปรโมชั่น KINGDOM66 แจกโบนัส เครดิตฟรี คืนยอดเสีย คุ้มที่สุด",
  description: "โปรโมชั่น KINGDOM66  มอบสิทธิพิเศษระดับ VIP แจกโบนัสต้อนรับสมาชิกใหม่ เครดิตฟรี และโปรคืนยอดเสียทุกวัน ต่อยอดเพิ่มทุน เงื่อนไขเทิร์นต่ำ ถอนได้จริง",
  url: currentPath,
};

const allSchemas = [webPageSchema];
---

<script type="application/ld+json" set:html={JSON.stringify(allSchemas)} />
<MainLayout
  title="โปรโมชั่น KINGDOM66 แจกโบนัส เครดิตฟรี คืนยอดเสีย คุ้มที่สุด"
  ,
  description="โปรโมชั่น KINGDOM66  มอบสิทธิพิเศษระดับ VIP แจกโบนัสต้อนรับสมาชิกใหม่ เครดิตฟรี และโปรคืนยอดเสียทุกวัน ต่อยอดเพิ่มทุน เงื่อนไขเทิร์นต่ำ ถอนได้จริง">
  <Announcement />
  <ContentBox>
    <h1 class="mb-7 text-3xl text-amber-400">โปรโมชั่น KINGDOM66 แจกโบนัส เครดิตฟรี คืนยอดเสีย คุ้มที่สุด</h1>

    <div class="mb-5 grid grid-cols-1 gap-5 md:grid-cols-3">
      <div class="flex flex-col gap-4">
        <Picture
          src={image1}
          alt="ไม่มีขั้นต่ำ"
          loading="lazy"
          fetchpriority="low"
          widths={[200, 400, 600]}
          sizes="(max-width: 768px) 100vw, 33vw"
          class="mx-auto h-auto w-full max-w-[400px] object-contain shadow-xl"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={60}
        />
      </div>

      <div class="flex flex-col gap-4">
        <Picture
          src={image2}
          alt="KINGDOM66"
          loading="lazy"
          fetchpriority="low"
          widths={[200, 400, 600]}
          sizes="(max-width: 768px) 100vw, 33vw"
          class="mx-auto h-auto w-full max-w-[400px] object-contain shadow-xl"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />
      </div>

      <div class="flex flex-col gap-4">
        <Picture
          src={image3}
          alt="KINGDOM66 API แท้"
          loading="lazy"
          fetchpriority="low"
          widths={[200, 400, 600]}
          sizes="(max-width: 768px) 100vw, 33vw"
          class="mx-auto h-auto w-full max-w-[400px] object-contain shadow-xl"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />
      </div>

      <div class="flex flex-col gap-4">
        <Picture
          src={image3}
          alt="KINGDOM66 ระบบออโต้"
          loading="lazy"
          fetchpriority="low"
          widths={[200, 400, 600]}
          sizes="(max-width: 768px) 100vw, 33vw"
          class="mx-auto h-auto w-full max-w-[400px] object-contain shadow-xl"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />
      </div>
      <div class="flex flex-col gap-4">
        <Picture
          src={image4}
          alt="KINGDOM66 แตกง่าย"
          loading="lazy"
          fetchpriority="low"
          widths={[200, 400, 600]}
          sizes="(max-width: 768px) 100vw, 33vw"
          class="mx-auto h-auto w-full max-w-[400px] object-contain shadow-xl"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />
      </div>
    </div>
  </ContentBox>
</MainLayout>
<Footer />
<Navfoot />
