---
const {
  message =
    "WINDRAGON สล็อตออนไลน์ เล่นจบในมือถือ ฝากถอนออโต้ไม่ต้องส่งสลิป ยอดบวกโอนเต็มจำนวน พร้อมโปรสุดคุ้มเสริมทุนทุกวัน",
} = Astro.props;

const SCROLL_PX_PER_SEC = 50;
const PX_PER_CHAR = 6.2;
const TRAILING_PX = 81;
const scrollSeconds = Math.max(12, Math.round((message.length * PX_PER_CHAR + TRAILING_PX) / SCROLL_PX_PER_SEC));
---

<div class="mx-auto w-full max-w-7xl px-4 py-4 font-sans">
  <div
    class="relative flex overflow-hidden rounded-full border border-[#f26b1d]/45 bg-[#1a100c]/92 shadow-[0_8px_20px_rgba(10,4,2,0.55)] transition-shadow duration-300 hover:shadow-[0_8px_25px_rgba(242,107,29,0.28)]">
    <div
      class="relative z-10 flex shrink-0 items-center justify-center rounded-full bg-gradient-to-r from-[#ffd77a] via-[#ff9a4d] to-[#f26b1d] px-8 py-2.5 font-black text-[#1a0701] shadow-[4px_0_15px_rgba(242,107,29,0.28)]">
      <span aria-hidden="true" class="mr-2 text-lg">📣</span> ประกาศ
    </div>

    <div class="marquee-container relative flex-1 overflow-hidden py-2.5 pr-6">
      <div aria-hidden="true" class="pointer-events-none absolute top-0 left-0 z-10 h-full w-12 bg-gradient-to-r from-[#1a100c] to-transparent"></div>

      <div class="marquee-content inline-block pl-4 text-sm font-medium tracking-wide whitespace-nowrap text-[#f2e7de]" style={`animation-duration:${scrollSeconds}s`}>
        <span class="mr-10 inline-flex items-center gap-3"><span aria-hidden="true" class="h-2 w-2 rounded-full bg-[#f26b1d] shadow-[0_0_8px_rgba(242,107,29,0.55)]"></span>{message}</span>
        <span aria-hidden="true" class="mr-10 inline-flex items-center gap-3"><span class="h-2 w-2 rounded-full bg-[#f26b1d] shadow-[0_0_8px_rgba(242,107,29,0.55)]"></span>{message}</span>
      </div>
    </div>
  </div>
</div>

<style>
  .marquee-content {
    animation: marquee 25s linear infinite;
  }
  .marquee-container:hover .marquee-content {
    animation-play-state: paused;
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee-content {
      animation: none;
    }
  }
  @keyframes marquee {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }
</style>
