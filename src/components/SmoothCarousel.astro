---
import { Picture } from "astro:assets";

import slide1 from "../assets/slide1.png";
import slide4 from "../assets/slide4.png";

const images = [
  {
    src: slide1,
    alt: "ภาพโปรโมชั่น KOH888 พื้นม่วงเข้มมีเมืองกลางคืนและริบบิ้นทองปลิว ด้านบนเป็นโลโก้ KOH888 ทองนูนมีมงกุฎและชิปคาสิโน ถัดลงมาเป็นตัวอักษรทองขนาดใหญ่ว่า KOH888 ต่อด้วยแถบข้อความ สิทธิ์พิเศษวันเกิด และ รับเพิ่มสูงสุด 500 บาท ใต้ลงมาเป็นสองกรอบข้อความว่า เล่นผ่านเว็บหลัก ฝากถอนออโต้ และ รวดเร็ว ปลอดภัย มั่นใจ 100% ปิดท้ายด้วยบรรทัด ตรวจสอบเงื่อนไขก่อนรับสิทธิ์ และปุ่ม สมัครสมาชิก ด้านขวาเป็นพรีเซนเตอร์หญิงชุดม่วงถือบัตร KOH888 ยืนคู่กับกล่องของขวัญทอง ชิปคาสิโน และกองเหรียญ",
  },
  {
    src: slide4,
    alt: "ภาพโปรโมชั่น KOH888 พื้นม่วงเข้มลายเหรียญทอง ข้อความใหญ่ว่า สมาชิกใหม่ KOH888 บรรทัดรองว่า เริ่มง่าย ผ่านเว็บตรง ตามด้วยกรอบไฟว่า ฝากเริ่มต้น 50 บาท ถัดลงมาเป็นแถบ รวมสล็อต คาสิโน หวย กีฬา พร้อมไอคอนตู้สล็อต วงล้อคาสิโน ลูกหวย และลูกฟุตบอล ปิดท้ายด้วยกรอบข้อความ ระบบออโต้ เล่นบนมือถือได้ คู่กับไอคอนมือถือ ด้านขวาเป็นพรีเซนเตอร์หญิงชุดชมพูยืนคู่กับไพ่ ลูกเต๋า และกองเหรียญทอง มุมบนขวาเป็นโลโก้ KOH888 ทองมีมงกุฎ",
  },
];

const COPIES = 3;
const slides = Array.from({ length: COPIES }, () => images).flat();
---

<div class="marquee mx-auto w-full max-w-7xl overflow-hidden px-4 py-5">
  <input id="carousel-pause" type="checkbox" class="peer sr-only" />
  <label
    for="carousel-pause"
    class="sr-only cursor-pointer peer-focus-visible:not-sr-only peer-focus-visible:mb-3 peer-focus-visible:inline-block peer-focus-visible:rounded-full peer-focus-visible:border peer-focus-visible:border-[#f5c542]/60 peer-focus-visible:px-4 peer-focus-visible:py-2 peer-focus-visible:text-sm peer-focus-visible:font-bold peer-focus-visible:text-[#ffe9a3]">
    หยุด / เล่นสไลด์ภาพ
  </label>

  <div class="marquee-track flex">
    {
      slides.map((slide, index) => {
        const isDuplicate = index >= images.length;
        return (
          <div class="marquee-slide" aria-hidden={isDuplicate ? "true" : undefined}>
            <Picture
              src={slide.src}
              alt={isDuplicate ? "" : slide.alt}
              class="block w-full rounded-xl border border-[#8b36d9]/40 object-cover shadow-[0_10px_30px_rgba(139,54,217,0.30)]"
              width={slide.src.width}
              height={slide.src.height}
              loading="lazy"
              fetchpriority="low"
              decoding="async"
              widths={[300, 360, 420, 480, 540, 600]}
              sizes="(max-width: 767px) calc(100vw - 32px), (max-width: 1279px) calc((100vw - 48px) / 2), 403px"
              formats={["avif", "webp"]}
              fallbackFormat="webp"
              quality={60}
            />
          </div>
        );
      })
    }
  </div>
</div>

<style>
  .marquee {
    --gap: 12px;
    --per-view: 1;
    --shift: calc(-200% - 24px);
  }

  @media (min-width: 768px) {
    .marquee {
      --gap: 16px;
      --per-view: 2;
      --shift: calc(-100% - 16px);
    }
  }

  @media (min-width: 1280px) {
    .marquee {
      --gap: 20px;
      --per-view: 3;
      --shift: calc(-66.6667% - 13.3333px);
    }
  }

  .marquee-track {
    gap: var(--gap);
    width: 100%;
    animation: carousel-scroll 24s linear infinite;
    will-change: transform;
  }

  .marquee-slide {
    flex: 0 0 calc((100% - (var(--per-view) - 1) * var(--gap)) / var(--per-view));
  }

  @keyframes carousel-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(var(--shift));
    }
  }

  .marquee:hover .marquee-track,
  .marquee:focus-within .marquee-track,
  .marquee > input:checked ~ .marquee-track {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
    }
  }
</style>
