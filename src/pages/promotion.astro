---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement6.astro";

import { Picture } from "astro:assets";

import pro1 from "../assets/slide1.png";
import pro2 from "../assets/slide2.png";
import pro3 from "../assets/slide3.png";
import pro4 from "../assets/slide4.png";
---

<MainLayout title="โปรโมชั่น HENGJUD365 รีวิวเว็บสล็อต" description="รวมโปรโมชั่น HENGJUD365 ข้อมูลเว็บตรง ระบบฝากถอนอัตโนมัติ รองรับวอเล็ทเต็มระบบ">
  <Announcement />

  <ContentBox>
    <h1 class="mb-5 bg-gradient-to-r from-yellow-300 to-yellow-500 bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase drop-shadow-sm">โปรโมชั่น HENGJUD365</h1>

    <div class="mx-auto grid w-full max-w-7xl grid-cols-1 gap-6 px-4 sm:grid-cols-2 lg:grid-cols-2 xl:grid-cols-2">
      <Picture
        src={pro1}
        alt="HENGJUD365 ทางเข้าและระบบ Auto Wallet"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600, 800]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class="mx-auto h-auto w-full rounded-xl border border-blue-400/50 object-contain shadow-lg transition-transform duration-300 hover:-translate-y-1 hover:border-blue-300 hover:shadow-[0_10px_20px_rgba(37,99,235,0.6)]"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />

      <Picture
        src={pro2}
        alt="HENGJUD365 ค่ายเกม Top Providers"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600, 800]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class="mx-auto h-auto w-full rounded-xl border border-blue-400/50 object-contain shadow-lg transition-transform duration-300 hover:-translate-y-1 hover:border-blue-300 hover:shadow-[0_10px_20px_rgba(37,99,235,0.6)]"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />

      <Picture
        src={pro3}
        alt="HENGJUD365 แตกง่ายอย่างไร RTP และ Volatility"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600, 800]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class="mx-auto h-auto w-full rounded-xl border border-blue-400/50 object-contain shadow-lg transition-transform duration-300 hover:-translate-y-1 hover:border-blue-300 hover:shadow-[0_10px_20px_rgba(37,99,235,0.6)]"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />

      <Picture
        src={pro4}
        alt="HENGJUD365 ข้อมูลเว็บตรงและโครงสร้างเว็บไซต์"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600, 800]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class="mx-auto h-auto w-full rounded-xl border border-blue-400/50 object-contain shadow-lg transition-transform duration-300 hover:-translate-y-1 hover:border-blue-300 hover:shadow-[0_10px_20px_rgba(37,99,235,0.6)]"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />
    </div>
    <div class="mt-12 flex justify-center pb-4">
      <a
        href="/register"
        class="flex items-center justify-center rounded-full bg-gradient-to-r from-yellow-500 via-yellow-400 to-yellow-500 px-10 py-3.5 text-lg font-black text-[#0b1633] shadow-[0_5px_20px_rgba(251,191,36,0.4)] transition-all duration-300 hover:-translate-y-1 hover:scale-105 hover:shadow-[0_8px_25px_rgba(251,191,36,0.6)]">
        รับโปรโมชั่นทันที
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <style>
    :global(.text-purple-gradient) {
      background: linear-gradient(to bottom, #93c5fd 0%, #2563eb 100%) !important;
      -webkit-background-clip: text !important;
      -webkit-text-fill-color: transparent !important;
    }
  </style>
</MainLayout>
