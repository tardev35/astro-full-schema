---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement2.astro";

import { Picture } from "astro:assets";
import { itemList, pageGraph, schemaCtx } from "../lib/schema";
import image1 from "../assets/gamedemo7.webp";
import image2 from "../assets/gamedemo8.webp";
import image3 from "../assets/gamedemo9.webp";
import image4 from "../assets/gamedemo10.webp";
import image5 from "../assets/gamedemo11.webp";
import image6 from "../assets/gamedemo12.webp";
import image7 from "../assets/gamedemo13.webp";
import image8 from "../assets/gamedemo14.webp";
import image9 from "../assets/gamedemo15.webp";
import image10 from "../assets/gamedemo16.webp";
import image11 from "../assets/gamedemo17.webp";
import image12 from "../assets/gamedemo18.webp";

const demoGames = [
  { name: "PG Soft", src: image5, alt: "แบนเนอร์ค่าย PG Pocket Games Soft โลโก้ตัวอักษรพิกเซลบนพื้นดำ คู่กับตัวละครหญิงนักรบผิวแทนสวมเครื่องประดับทองและหมวกขนนกสไตล์แอซเท็ก" },
  { name: "JILI", src: image8, alt: "แบนเนอร์ค่ายเกม JILI ตัวอักษรทองบนพื้นดำ คู่กับนางเงือกผมแดงสวมเกราะเปลือกหอยสีทอง ยกหอยสังข์แนบหูอยู่ใต้ทะเลที่มีปลาการ์ตูนและปะการัง" },
  { name: "Joker Gaming", src: image11, alt: "แบนเนอร์ค่ายเกม JOKER ตัวอักษรขาวทองบนพื้นดำ คู่กับนักรบโรมันสวมหมวกเหล็กติดขนนกและถือโล่ ยืนเคียงสิงโตกำลังคำรามกลางสนามประลอง" },
  { name: "AskmeSlot", src: image1, alt: "แบนเนอร์ค่าย askmeslot โลโก้โพดำสีทองที่มีสัญลักษณ์ไพ่อยู่ข้างใน คู่กับตัวการ์ตูนเด็กชายสวมหมวกแดงติดดาว กางแขนวิ่งบนถนนในเมืองยุโรปที่มีกังหันลม" },
  { name: "Popular Game", src: image2, alt: "แบนเนอร์ Popular Game ตัวอักษรทองนูนหน้าวงแหวนชิปคาสิโนสีทอง ขนาบด้วยกระต่ายถือหีบสมบัติกับแมวใส่แว่นกันแดด ท่ามกลางเหรียญทองและชิปที่ลอยฟุ้ง" },
  { name: "SlotXO", src: image3, alt: "แบนเนอร์ค่าย SLOTXO โลโก้ตู้สล็อตล้อมด้วยเหรียญทอง คู่กับนักรบโรมันผมขาวสวมมงกุฎใบลอเรลและเกราะทอง ยืนหน้าโคลอสเซียมกับทหารอีกสองนาย" },
  { name: "Skywind Group", src: image4, alt: "แบนเนอร์ค่าย Skywind Group โลโก้วงกลมสี่สีบนพื้นดำ คู่กับแมวกวักนำโชคสีขาวคาดกระพรวนทอง ยืนข้างไหทองและถุงเงินสีม่วงใต้ต้นซากุระ" },
  { name: "SBOBET", src: image6, alt: "แบนเนอร์ค่ายเกม SBOBET โลโก้ตัวอักษรขาวบนพื้นดำ คู่กับตัวการ์ตูนอนิเมะสาวหูจิ้งจอกผมบลอนด์ในชุดกิโมโนสีชมพู มือถืออมยิ้มเกลียวหลากสี" },
  { name: "Sexy Slot", src: image7, alt: "แบนเนอร์ค่าย Sexy Slot ตัวอักษรสีชมพูม่วงมีประกายวิบวับ คู่กับตัวการ์ตูนสาวผมน้ำตาลในชุดรัดรูปสีม่วง นั่งอยู่ในกรอบวงกลมที่ล้อมด้วยหัวใจสีชมพู" },
  { name: "Ask Me Bet", src: image9, alt: "แบนเนอร์ค่ายเกม ask me bet โลโก้สามช่องสีขาวเขียวเหลืองบนพื้นดำ คู่กับหัวสิงโตเชิดสีแดงทองตาโต ใต้แถวโคมไฟสีแดงหน้าศาลเจ้า" },
  { name: "New Game", src: image10, alt: "แบนเนอร์ New Game ตัวอักษรสีขาวนูนกลางภาพ ขนาบด้วยตัวการ์ตูนฟักทองหัวไฟกับโครงกระดูกยิ้ม ยืนบนฟลอร์นีออนสีชมพูฟ้าที่เกลื่อนด้วยชิปและลูกเต๋า" },
  { name: "AFB Gaming", src: image12, alt: "แบนเนอร์ค่ายเกม AFB Gaming โลโก้ตัวอักษรทองบนพื้นดำ คู่กับเทพซุสเคราขาวตาเรืองแสงสีฟ้า สวมมงกุฎใบลอเรลและกำไลทองหน้าวิหารกรีก" },
];

const gameList = demoGames.map((game) => ({ name: game.name, imagePath: game.src.src }));

const pageTitle = "ทดลองเล่นสล็อต SUPREME888 ลองค่ายดังให้คุ้นมือก่อนเล่นจริง";

const pageHeading = "ทดลองเล่นสล็อต SUPREME888 หมุนลองค่ายดังให้คุ้นมือก่อนใช้เครดิตจริง";

const pageDescription =
  "ทดลองเล่นสล็อต SUPREME888 สมัครยูสเดียวแล้วลองโหมดทดลองของ PG Soft, Pragmatic Play, JILI และ Joker Gaming ได้จากมือถือ ดูฟรีสปินและตัวคูณให้คุ้นมือก่อนเล่นจริง";

const linkClass = "font-bold text-[#b5121a] underline underline-offset-4 transition-colors hover:text-[#ec1b24]";

const ctx = schemaCtx(Astro);
const graph = pageGraph(Astro, {
  type: "CollectionPage",
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  ],
  extra: [
    itemList(ctx, {
      name: "ทดลองเล่นเกมสล็อตของ SUPREME888",
      alternateName: "SUPREME888 โหมดทดลองเล่นสล็อตหลายค่ายบนมือถือ ก่อนใช้เครดิตจริงด้วยยูสเซอร์เดียว",
      itemType: "Game",
      items: gameList,
    }),
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox as="h1" title={pageHeading}>
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed">
        หากคุณกำลังมองหาที่ลองสล็อตให้คุ้นมือก่อนลงเครดิตจริง <strong>SUPREME888</strong> พร้อมพาคุณเข้าโหมดทดลองของ PG Soft, Pragmatic Play, JILI และ Joker Gaming เพื่อให้รู้จังหวะฟรีสปินและตัวคูณก่อนตัดสินใจ
      </p>
      <p class="text-left text-base leading-relaxed">
        เลือกค่ายที่สะดุดตาจากด้านล่าง กดที่ภาพแล้วระบบจะพาไปหน้าสมัครสมาชิก สมัครครั้งเดียวก็ได้ยูสเซอร์ไว้เข้าโหมดทดลองของค่ายนั้นต่อจากหน้าสมาชิกได้ทันที
      </p>
      <p class="text-left text-base leading-relaxed">
        ทุกขั้นทำบนมือถือได้ครบ ทั้ง iOS และ Android ผ่านเบราว์เซอร์โดยไม่ต้องโหลดแอปเพิ่ม จะลองตอนพักเที่ยงหรือก่อนนอนก็ใช้เครื่องเดียวจบ ไม่ต้องรอกลับบ้านไปเปิดคอมครับ
      </p>
    </div>
  </ContentBox>

  <ContentBox as="h2" title="เลือกค่ายที่ชอบ สมัคร SUPREME888 ยูสเดียว สลับลองได้ทุกค่ายในเว็บเดียว">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed">
        SUPREME888 รวมเกมสล็อตหลายค่ายไว้ในเว็บเดียว แต่ละค่ายมีกลไกของตัวเอง บางเกมรอรอบฟรีสปินพายอดขึ้น บางเกมมีตัวคูณทำงานทุกรอบ ลองให้รู้ว่าแบบไหนถูกจริตคุณที่สุด
      </p>
      <p class="text-left text-base leading-relaxed">
        ยังไม่รู้จะเริ่มเกมไหน เราแนะนำเกมที่กลไกต่างกันชัด อย่าง Treasures of Aztec ของ PG Soft, Sweet Bonanza ของ Pragmatic Play, Fortune Gems ของ JILI และ Roma ของ Joker Gaming
      </p>
      <p class="text-left text-base leading-relaxed">
        ปุ่มบนภาพเขียนว่าสมัครเพื่อลอง เพราะจะพาคุณไปหน้า <a href="/register/" class={linkClass}>สมัครสมาชิก</a> ก่อน สมัครครั้งเดียวใช้ได้ทุกค่ายบน SUPREME888 เบื่อเกมหนึ่งก็สลับไปอีกค่ายได้เลย ไม่ต้องเปิดบัญชีใหม่ทีละค่าย
      </p>
      <div class="mt-4 mb-5 grid grid-cols-2 gap-5 sm:grid-cols-2 md:grid-cols-4">
        {
          demoGames.map((game) => (
            <div class="group/game relative mx-auto w-full max-w-[400px] overflow-hidden rounded-xl border border-[#f1d2d3] bg-white shadow-[0_10px_30px_rgba(236,27,36,0.10)] transition-colors duration-300 hover:border-[#e9b7b9]">
              <Picture
                src={game.src}
                alt={game.alt}
                loading="lazy"
                fetchpriority="low"
                widths={[200, 400, 600]}
                sizes="(max-width: 768px) 50vw, 25vw"
                class="block h-auto w-full object-cover transition-transform duration-300 group-hover/game:scale-105"
                decoding="async"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
                quality={60}
              />
              <a
                href="/register/"
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`สมัครสมาชิก SUPREME888 เพื่อลองเล่น ${game.name}`}
                class="absolute inset-0 flex items-center justify-center bg-white/80 opacity-0 transition-opacity duration-300 group-hover/game:opacity-100 focus-visible:opacity-100">
                <span class="rounded-xl bg-gradient-to-b from-[#ff4d55] to-[#d0121b] px-6 py-2 font-bold text-white shadow-[0_10px_30px_rgba(236,27,36,0.30)] transition-transform hover:scale-110 hover:brightness-110">สมัครเพื่อลอง</span>
              </a>
            </div>
          ))
        }
      </div>
    </div>
  </ContentBox>

  <ContentBox as="h2" title="ทดลองเล่นสล็อตฟรี หมุนลองให้พอใจก่อนใช้เครดิตจริง">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed">
        โหมดทดลองใช้เครดิตสมมติทั้งหมด คุณหมุนลองได้ตามสบาย ไม่มีใครเร่ง และไม่มีใครกดดันให้ฝากก่อนที่คุณจะพร้อมเล่นจริง
      </p>
      <p class="text-left text-base leading-relaxed">
        ระหว่างหมุนลองสังเกตว่าเบทต่ำสุดต่อรอบเท่าไร รอบฟรีสปินเข้าแบบไหน และตัวคูณทำงานตอนไหน แล้วคัดไว้สองสามเกมที่ตรงกับทุนของตัวเองตั้งแต่ยังไม่ลงเครดิตจริง
      </p>
      <p class="text-left text-base leading-relaxed">
        หน้าเกมและกติกาตอนทดลองเป็นชุดเดียวกับตอนเล่นจริง ต่างกันแค่เครดิตที่ใช้หมุน จังหวะที่คุณจับได้วันนี้จึงพกไปใช้ได้ทันทีเมื่อถึงรอบเล่นจริง
      </p>
      <p class="text-left text-base leading-relaxed">
        เรื่องที่ขอบอกให้ชัดตั้งแต่ต้น เครดิตในโหมดทดลองถอนออกมาไม่ได้ และไม่นับเป็นยอดเทิร์นของโปรโมชั่นใดทั้งสิ้น มีไว้ให้คุณทำความรู้จักเกมอย่างเดียวครับ
      </p>
      <p class="text-left text-base leading-relaxed">
        อีกข้อคือไม่ใช่ทุกเกมที่มีปุ่มทดลอง เพราะขึ้นอยู่กับค่ายผู้พัฒนาแต่ละราย ถ้าเกมที่หมายตาไว้ยังไม่เปิดให้ลอง <a href="/contact-us/" class={linkClass}>ทักแอดมิน</a> ให้ช่วยแนะนำเกมแนวใกล้เคียงได้เลย
      </p>
    </div>
  </ContentBox>

  <ContentBox as="h2" title="พร้อมเมื่อไหร่ สมัครสมาชิก SUPREME888 แล้วเริ่มเล่นจริงได้ทันที">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed">
        เมื่อเจอเกมที่ถูกใจ คุณเริ่มเล่นจริงได้เลยด้วยยูสเซอร์เดิม ไม่ต้องสมัครซ้ำ ตั้งงบของวันนั้นไว้ก่อนเปิดเกม แล้วเริ่มจากเบทเล็กเพื่อจับจังหวะ ทุนจะอยู่ได้นานกว่า
      </p>
      <p class="text-left text-base leading-relaxed">
        ฝากถอนของ SUPREME888 เป็นระบบออโต้ ฝากเริ่ม 20 บาท ถอนเริ่ม 50 บาท ใช้ได้ทุกธนาคารและ TrueMoney Wallet กดทำรายการเองได้ตลอด 24 ชม. ไม่ต้องส่งสลิป ดูขั้นตอนได้ที่หน้า <a href="/วิธีฝากถอน/" class={linkClass}>วิธีฝากถอน</a>
      </p>
      <p class="text-left text-base leading-relaxed">
        คนเปิดยูสครั้งแรกมีโปรสมาชิกใหม่รอรับอยู่ เปิด <a href="/promotion/" class={linkClass}>หน้าโปรโมชั่น</a> ดูก่อนรับว่าต้องทำเทิร์นหรือไม่ และนับยอดจากเกมไหนบ้าง จะได้วางแผนถอนได้ตั้งแต่ก่อนฝาก
      </p>
      <p class="text-left text-base leading-relaxed">
        อีกเรื่องที่ควรติดตัวไว้เสมอ อย่าบอกรหัสผ่านหรือรหัส OTP กับใครทั้งสิ้น แม้คนนั้นจะอ้างว่าเป็นทีมงานก็ตาม เพราะแอดมินของเราไม่มีเหตุให้ต้องขอ
      </p>
      <p class="text-left text-base leading-relaxed">
        เลือกค่ายที่ถูกใจแล้วเริ่มได้เลย เกมที่คุณลองจนคุ้นมือวันนี้ คือเกมที่คุณรู้จังหวะและกติกาดีแล้วเมื่อถึงรอบเล่นจริง เพื่อการปั่นที่มั่นใจและสนุกต่อเนื่องกว่าที่เคย
      </p>
      <div class="flex flex-col items-center justify-center gap-4 pt-2 sm:flex-row">
        <a
          href="/register/"
          class="inline-flex w-full max-w-[320px] items-center justify-center gap-2 rounded-xl bg-gradient-to-b from-[#ff4d55] to-[#d0121b] px-8 py-3.5 text-lg font-black tracking-wide text-white shadow-[0_10px_30px_rgba(236,27,36,0.30)] transition duration-300 hover:scale-105 hover:brightness-110">
          <span aria-hidden="true">🎰</span> สมัครสมาชิก SUPREME888
        </a>

        <a
          href="/login/"
          class="inline-flex w-full max-w-[320px] items-center justify-center gap-2 rounded-xl border-2 border-[#ec1b24] bg-white px-8 py-3.5 text-lg font-bold tracking-wide text-[#b5121a] transition-colors duration-300 hover:bg-[#fff5f5]">
          เข้าสู่ระบบ
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
