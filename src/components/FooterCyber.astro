---
import { Picture } from "astro:assets";
import BankStrip from "./BankStrip.astro";
import { BRAND_ADDRESS } from "../lib/brandProfile";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });
const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

const logoAlt =
  "โลโก้ AMBHENG88 ตัวอักษร AMB สีขาวและ HENG สีเหลืองสด ตัวหนาขอบสีชมพูบานเย็นสองชั้น ใต้ลงมาเป็นเลข 88 สีเหลืองขอบชมพูบนพื้นโปร่ง";
---

<footer
  class="relative mt-10 w-full overflow-hidden border-t border-[#ff2d8e]/35 bg-[#0b0209] pt-16 pb-8 font-sans text-[#f3e3ee]"
  style="clip-path: polygon(0 30px, 50vw 0, 100% 30px, 100% 100%, 0 100%);">
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 opacity-[0.12]"
    style="background-image: linear-gradient(#7d0b46 1px, transparent 1px), linear-gradient(90deg, #c9a800 1px, transparent 1px); background-size: 30px 30px;">
  </div>

  <div class="relative z-10 mx-auto w-full max-w-[1200px] px-6">
    <div class="mb-12 grid grid-cols-1 gap-10 md:grid-cols-12">
      <div class="flex flex-col gap-5 md:col-span-5">
        <a href="/" class="inline-block transition-transform hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt={logoAlt}
                widths={[160, 320, 480]}
                sizes="160px"
                loading="lazy"
                class="h-[60px] w-auto drop-shadow-[0_4px_12px_rgba(255,45,142,0.4)]"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <span class="text-3xl font-black tracking-widest text-[#ffe814]">AMBHENG88</span>
            )
          }
        </a>
        <p class="border-l-2 border-[#ff2d8e] pl-4 text-sm leading-relaxed text-[#f3e3ee]/80">
          AMBHENG88 รวมเกมสล็อตออนไลน์หลายค่าย โปรโมชั่น และการจัดการยอดผ่านทรูมันนี่วอลเล็ทไว้ในยูสเดียว สมาชิกเข้าสู่ระบบแล้วเติมยอด เลือกเกม หรือตรวจสอบรายการฝากถอนต่อได้จากหน้าเมมเบอร์เดิม
          ระบบออโต้ช่วยให้ช่วงระหว่างเติมเครดิตกับเข้าเกมสั้นลง ส่วนสมาชิกใหม่เช็กสิทธิ์ที่เปิดอยู่ได้จากหน้าโปรโมชั่น จะเปิดผ่านมือถือหรือคอมก็ใช้ยูสเดิมต่อได้
        </p>
        <div class="mt-4 flex gap-3">
          <span class="border border-[#ffe814]/45 bg-[#280a1c] px-3 py-1 font-mono text-xs text-[#fff27a]">TRUEWALLET</span>
          <span class="border border-[#ff2d8e]/45 bg-[#280a1c] px-3 py-1 font-mono text-xs text-[#ff74b6]">AUTO_24H</span>
        </div>
      </div>

      <nav aria-label="ลิงก์หน้าเว็บ AMBHENG88" class="flex flex-col gap-4 md:col-span-3 lg:pl-8">
        <p class="text-lg font-black tracking-widest text-[#fff27a] uppercase">/// DIRECTORY</p>
        <ul class="flex flex-col gap-3 font-mono text-sm text-[#f3e3ee]/80">
          <li><a href="/" class="transition-colors hover:text-[#ff74b6]">&gt; หน้าแรก</a></li>
          <li><a href="/promotion/" class="transition-colors hover:text-[#ff74b6]">&gt; โปรโมชั่น</a></li>
          <li><a href="/register/" class="transition-colors hover:text-[#ff74b6]">&gt; สมัครสมาชิก</a></li>
          <li><a href="/login/" class="transition-colors hover:text-[#ff74b6]">&gt; เข้าสู่ระบบ</a></li>
          <li><a href="/ทดลองเล่น/" class="transition-colors hover:text-[#ff74b6]">&gt; ทดลองเล่น</a></li>
          <li><a href="/ทางเข้า/" class="transition-colors hover:text-[#ff74b6]">&gt; ทางเข้า</a></li>
          <li><a href="/about-us/" class="transition-colors hover:text-[#ff74b6]">&gt; เกี่ยวกับเรา</a></li>
          <li><a href="/contact-us/" class="transition-colors hover:text-[#ff74b6]">&gt; ติดต่อเรา</a></li>
        </ul>
      </nav>

      <div class="flex flex-col gap-5 md:col-span-4">
        <p class="text-lg font-black tracking-widest text-[#fff27a] uppercase">/// SUPPORT_LINK</p>

        <a
          href="/line/"
          class="flex w-full items-center justify-center gap-2 bg-[#00B900] py-3 font-bold text-white transition-all hover:bg-[#009900]"
          style="clip-path: polygon(10px 0, 100% 0, 100% calc(100% - 10px), calc(100% - 10px) 100%, 0 100%, 0 10px);">
          LINE CONNECT
        </a>

        {
          BRAND_ADDRESS.lines.length > 0 && (
            <address aria-label={BRAND_ADDRESS.label} class="mt-2 rounded-xl border border-white/15 bg-black/20 p-4 text-xs leading-relaxed not-italic opacity-90">
              <p class="mb-2 flex items-center gap-2 text-[11px] font-bold tracking-wider uppercase opacity-80">
                <span aria-hidden="true" class="text-sm">
                  📍
                </span>
                {BRAND_ADDRESS.label}
              </p>
              {BRAND_ADDRESS.lines.map((line) => (
                <span class="block">{line}</span>
              ))}
              {BRAND_ADDRESS.email && (
                <a href={`mailto:${BRAND_ADDRESS.email}`} class="mt-3 inline-flex items-center gap-2 font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                  <span aria-hidden="true" class="text-sm">
                    ✉️
                  </span>
                  {BRAND_ADDRESS.email}
                </a>
              )}
            </address>
          )
        }

        <a
          href="#top"
          class="flex w-full items-center justify-center gap-2 border border-[#ff2d8e]/60 bg-transparent py-3 font-bold text-[#ff74b6] transition-all hover:bg-[#280a1c]/70"
          style="clip-path: polygon(10px 0, 100% 0, 100% calc(100% - 10px), calc(100% - 10px) 100%, 0 100%, 0 10px);">
          <span aria-hidden="true">↑</span> กลับขึ้นบน
        </a>

        <div class="mt-2 font-mono text-xs text-[#f3e3ee]/60">ACCEPTED_PAYMENTS</div>
        <BankStrip size={28} />
      </div>
    </div>

    <div class="flex flex-col items-center justify-between border-t border-[#ffe814]/25 pt-6 font-mono text-xs text-[#f3e3ee]/60 md:flex-row">
      <p>SYSTEM_COPYRIGHT &copy; {new Date().getFullYear()} AMBHENG88</p>
      <div class="mt-4 flex gap-4 md:mt-0">
        <a href="/terms/" class="hover:text-[#ff74b6]">TERMS_OF_SERVICE</a>
        <a href="/privacy/" class="hover:text-[#ff74b6]">PRIVACY_POLICY</a>
      </div>
    </div>
  </div>
</footer>

<style>
  footer a {
    text-decoration: none;
    font-family: var(--font-sans);
  }
  .font-mono {
    font-family: monospace;
  }
</style>
