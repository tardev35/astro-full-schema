---
import kbankLogo from "../assets/banks/kbank.png";
import scbLogo from "../assets/banks/scb.png";
import krungsriLogo from "../assets/banks/krungsri.png";
import ktbLogo from "../assets/banks/ktb.png";
import ttbLogo from "../assets/banks/ttb.png";

const bankPool = [
  { name: "KBank", color: "bg-[#1155cc]", icon: kbankLogo.src },
  { name: "SCB", color: "bg-[#4e1c80]", icon: scbLogo.src },
  { name: "Krungsri", color: "bg-[#fcd34d]", icon: krungsriLogo.src },
  { name: "KTB", color: "bg-[#0ea5e9]", icon: ktbLogo.src },
];
---

<div class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="relative overflow-hidden rounded-3xl border border-blue-500/30 bg-[#050d16]/80 shadow-[0_10px_40px_rgba(0,0,0,0.8)] backdrop-blur-xl">
    <div class="relative z-10 flex flex-col gap-4 border-b border-blue-500/30 px-5 py-5 sm:flex-row sm:items-center sm:justify-between md:px-8">
      <div class="flex items-center gap-3">
        <span class="flex h-10 w-10 items-center justify-center rounded-full border border-blue-400/30 bg-blue-600/20 text-2xl text-blue-300">🏆</span>
        <div class="flex flex-col">
          <h2 class="text-2xl font-black tracking-widest text-white drop-shadow-sm">
            รายการถอนเงินล่าสุด 999<span class="text-red-400">LORD</span>
          </h2>
          <span class="text-[11px] font-medium tracking-wide text-gray-500">อัปเดตอัตโนมัติแบบเรียลไทม์ จากระบบฝากถอนออโต้</span>
        </div>
      </div>
      <div class="flex items-center gap-2 self-start rounded-full border border-green-500/40 bg-green-900/20 px-3 py-1.5 sm:self-auto">
        <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-green-400 shadow-[0_0_8px_rgba(74,222,128,0.8)]"></span>
        <span class="text-[10px] font-bold tracking-widest text-green-400 uppercase">Live</span>
      </div>
    </div>

    <div class="relative z-10 grid grid-cols-2 gap-px overflow-hidden border-b border-blue-900/30 bg-blue-950/10 sm:grid-cols-3">
      <div class="flex flex-col items-center gap-1 bg-[#050d16] px-4 py-4">
        <span class="text-[11px] font-medium tracking-wide text-gray-500">ยอดถอนรวมวันนี้</span>
        <span id="hud-total" class="bg-gradient-to-r from-red-300 to-red-500 bg-clip-text font-mono text-lg font-black text-transparent sm:text-xl">฿0</span>
      </div>
      <div class="flex flex-col items-center gap-1 bg-[#050d16] px-4 py-4">
        <span class="text-[11px] font-medium tracking-wide text-gray-500">รายการสำเร็จวันนี้</span>
        <span id="hud-count" class="font-mono text-lg font-black text-white sm:text-xl">0</span>
      </div>
      <div class="col-span-2 flex flex-col items-center gap-1 bg-[#050d16] px-4 py-4 sm:col-span-1">
        <span class="text-[11px] font-medium tracking-wide text-gray-500">เวลาดำเนินการเฉลี่ย</span>
        <span class="font-mono text-lg font-black text-white sm:text-xl">~5 วินาที</span>
      </div>
    </div>

    <div class="relative z-10 hidden grid-cols-[2fr_1.3fr_1fr_0.8fr] gap-4 px-8 pt-4 text-[11px] font-bold tracking-widest text-gray-500 uppercase sm:grid">
      <span>ผู้ใช้งาน</span>
      <span>สถานะ</span>
      <span class="text-right">จำนวนเงิน</span>
      <span class="text-right">เวลา</span>
    </div>

    <div id="feed-sumo-hud" class="relative z-10 flex h-[380px] flex-col gap-2 overflow-hidden px-4 py-4 md:px-8"></div>
  </div>
</div>

<script define:vars={{ bankPool }}>
  const feed = document.getElementById("feed-sumo-hud");
  const hudTotal = document.getElementById("hud-total");
  const hudCount = document.getElementById("hud-count");

  const getRandomStr = (len, chars) =>
    Array.from({ length: len })
      .map(() => chars.charAt(Math.floor(Math.random() * chars.length)))
      .join("");
  const getAmount = () => Math.floor(Math.random() * (250000 - 1000 + 1)) + 1000;

  let runningTotal = 0;
  let runningCount = 0;

  const createRow = () => {
    const bank = bankPool[Math.floor(Math.random() * bankPool.length)];
    const user = `0${getRandomStr(1, "89")}***${getRandomStr(4, "0123456789")}`;
    const isBigWin = Math.random() > 0.8;
    const amount = getAmount();

    runningTotal += amount;
    runningCount += 1;

    const statusClass = isBigWin ? "text-red-400 font-black" : "text-green-400 font-bold";
    const statusText = isBigWin ? "🔥 SUPER MEGA WIN" : "✓ ถอนสำเร็จ";
    const rowBorder = isBigWin ? "border-red-500/40 shadow-[0_0_15px_rgba(239,68,68,0.15)]" : "border-blue-900/20";

    return `
      <div class="winner-row origin-top -translate-y-3 transform opacity-0 transition-all duration-500 ease-out">
        <div class="grid grid-cols-[auto_1fr] items-center gap-4 rounded-xl border ${rowBorder} bg-[#0d1b28]/80 p-3.5 shadow-sm transition-colors duration-300 hover:border-blue-400/60 hover:bg-[#0f2436] sm:grid-cols-[2fr_1.3fr_1fr_0.8fr]">
          <div class="col-span-2 flex items-center gap-3 sm:col-span-1">
            <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full border border-white/10 ${bank.color} shadow-inner">
              <img src="${bank.icon}" alt="${bank.name}" class="h-5 w-5 object-contain grayscale" />
            </div>
            <span class="font-mono text-sm font-bold text-white">${user}</span>
          </div>
          <div class="text-[11px] tracking-wide ${statusClass} sm:text-xs">${statusText}</div>
          <div class="text-right font-mono text-base font-black text-transparent bg-clip-text bg-gradient-to-r from-red-300 to-red-500 sm:text-lg">
            ฿${amount.toLocaleString("en-US")}
          </div>
          <div class="text-right text-[11px] font-medium text-gray-500 sm:text-xs">เมื่อสักครู่</div>
        </div>
      </div>
    `;
  };

  const trigger = () => {
    if (!feed) return;
    const tempDiv = document.createElement("div");
    tempDiv.innerHTML = createRow();
    const newEl = tempDiv.firstElementChild;
    feed.prepend(newEl);

    if (hudTotal) hudTotal.textContent = `฿${runningTotal.toLocaleString("en-US")}`;
    if (hudCount) hudCount.textContent = runningCount.toLocaleString("en-US");

    requestAnimationFrame(() => {
      newEl.classList.remove("-translate-y-3", "opacity-0");
      newEl.classList.add("translate-y-0", "opacity-100");
    });

    if (feed.children.length > 5) {
      const last = feed.lastElementChild;
      last.classList.add("opacity-0");
      setTimeout(() => last.remove(), 400);
    }
  };

  for (let i = 0; i < 5; i++) trigger();
  setInterval(trigger, 3500);
</script>
<style>
  .font-sans {
    font-family: "Kanit", sans-serif;
  }
  .font-mono {
    font-family: "Kanit", sans-serif;
  }
</style>
