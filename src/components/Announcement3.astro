---
const {
  message = "TOPGAMEVIP เว็บตรงเกมสล็อต ลิขสิทธิ์แท้จากค่ายผู้พัฒนาโดยตรง ทุกเกมเดินตามค่า RTP จริงของค่าย ไม่มีล็อกยูส ไม่ปรับจูนหลังบ้าน • สมัครสมาชิกเองได้จากหน้าเว็บ กรอกข้อมูลพื้นฐานแล้วรับยูสเซอร์เนมภายในไม่กี่วินาที ไม่ต้องฝากก่อนเปิดยูส • ฝากเงินเล่นไม่มีขั้นต่ำ ทุนหลักสิบหลักร้อยก็เริ่มได้ ระบบออโต้เติมเครดิตให้ทันทีโดยไม่ต้องรอแอดมินอนุมัติ • ถอนเงินได้ด้วยตัวเองตลอด 24 ชั่วโมง ระบบประมวลผลอัตโนมัติ ไม่ต้องส่งสลิป ไม่ต้องผ่านคนกลาง • ระบบ AI ช่วยสรุปรูปแบบการออกฟีเจอร์และความถี่ของโบนัสให้อ่านจังหวะเกมได้ง่ายขึ้น โดยไม่แตะตัวเกมและไม่ปรับเรท",
} = Astro.props;
---

<div class="mx-auto mt-4 max-w-[900px] px-4 md:px-0">
  <div
    class="relative flex h-[46px] items-center rounded-r-full border border-[#f6c9c6] bg-gradient-to-r from-[#ffe9e7] to-white py-2 pr-4 pl-12 shadow-[0_0_20px_rgba(230,0,18,0.14)]">
    <div class="absolute top-1/2 -left-2 flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full border-[3px] border-[#e60012] bg-white shadow-[0_0_15px_rgba(230,0,18,0.35)]">
      <span aria-hidden="true" class="animate-pulse text-xl">📢</span>
    </div>

    <div class="mr-4 h-full w-[1px] bg-[#e60012]/25"></div>

    <div class="flex-1 overflow-hidden [mask-image:linear-gradient(90deg,transparent_0%,#000_5%,#000_95%,transparent_100%)]">
      <div class="flex w-max animate-[scroll_25s_linear_infinite] gap-12 text-sm font-bold whitespace-nowrap text-[#8a0208]">
        <span>{message}</span>
        <span>{message}</span>
      </div>
    </div>
  </div>
</div>

<style>
  @keyframes scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(calc(-50% - 24px));
    }
  }
</style>
