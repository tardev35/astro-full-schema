---
import { Picture } from "astro:assets";

import slide1 from "../assets/slide1.png";
import slide2 from "../assets/slide2.png";
import slide3 from "../assets/slide3.png";
import slide4 from "../assets/slide4.png";

const images = [
  {
    src: slide1,
    alt: "777RUAY สมาชิกใหม่ เริ่มต้นง่าย สมัครสะดวก ใช้งานได้ทุกอุปกรณ์ สมัครง่าย ระบบมั่นคง พร้อมดูแล ปุ่มสมัครสมาชิก พรีเซนเตอร์ชุดกี่เพ้าสีขาวฟ้าปักทองถือมือถือ",
  },
  {
    src: slide2,
    alt: "777RUAY สนุกครบหลายค่าย รวมเกมยอดนิยมไว้ในที่เดียว เกมหลากหลาย ใช้งานสะดวก เลือกได้ครบ ปุ่มเริ่มสนุก พรีเซนเตอร์ชุดกี่เพ้าสีขาวฟ้าชี้ไปที่มือถือ",
  },
  {
    src: slide3,
    alt: "777RUAY ฝากถอนออโต้ รวดเร็ว ใช้งานง่าย มั่นใจได้ อัตโนมัติ ทันสมัย สะดวก ปุ่มสมัครเลย เหรียญลูกศรวนสีฟ้าข้างพรีเซนเตอร์ถือมือถือ",
  },
  {
    src: slide4,
    alt: "777RUAY เล่นได้ทุกที่ บนมือถือ ระบบทันสมัย พร้อมดูแลทุกขั้นตอน มือถือ ตอบไว พร้อมดูแล ปุ่มเข้าร่วมเลย พรีเซนเตอร์ชุดกี่เพ้าชี้ไปที่มือถือ",
  },
];

const COPIES = 3;
const slides = Array.from({ length: COPIES }, () => images).flat();
---

<div class="marquee mx-auto w-full max-w-7xl overflow-hidden px-4 py-5">
  <input id="carousel-pause" type="checkbox" class="peer sr-only" />
  <label
    for="carousel-pause"
    class="sr-only cursor-pointer peer-focus-visible:not-sr-only peer-focus-visible:mb-3 peer-focus-visible:inline-block peer-focus-visible:rounded-full peer-focus-visible:border peer-focus-visible:border-[#1a5fe0]/60 peer-focus-visible:bg-white peer-focus-visible:px-4 peer-focus-visible:py-2 peer-focus-visible:text-sm peer-focus-visible:font-bold peer-focus-visible:text-[#0a1f5c]">
    หยุด / เล่นสไลด์ภาพ
  </label>

  <div class="marquee-track flex">
    {
      slides.map((slide, index) => {
        const isDuplicate = index >= images.length;
        return (
          <div class="marquee-slide" aria-hidden={isDuplicate ? "true" : undefined}>
            <Picture
              src={slide.src}
              alt={isDuplicate ? "" : slide.alt}
              class="block w-full rounded-xl border border-[#d6e2f7] object-cover shadow-[0_10px_30px_rgba(10,31,92,0.12)]"
              width={slide.src.width}
              height={slide.src.height}
              loading="lazy"
              fetchpriority="low"
              decoding="async"
              widths={[300, 360, 420, 480, 540, 600]}
              sizes="(max-width: 767px) calc(100vw - 32px), (max-width: 1279px) calc((100vw - 48px) / 2), 403px"
              formats={["avif", "webp"]}
              fallbackFormat="webp"
              quality={70}
            />
          </div>
        );
      })
    }
  </div>
</div>

<style>
  .marquee {
    --gap: 12px;
    --per-view: 1;
    --shift: calc(-400% - 48px);
    --duration: 32s;
  }

  @media (min-width: 768px) {
    .marquee {
      --gap: 16px;
      --per-view: 2;
      --shift: calc(-200% - 32px);
    }
  }

  @media (min-width: 1280px) {
    .marquee {
      --gap: 20px;
      --per-view: 3;
      --shift: calc(-133.3333% - 26.6667px);
    }
  }

  .marquee-track {
    gap: var(--gap);
    width: 100%;
    animation: carousel-scroll var(--duration) linear infinite;
    will-change: transform;
  }

  .marquee-slide {
    flex: 0 0 calc((100% - (var(--per-view) - 1) * var(--gap)) / var(--per-view));
  }

  @keyframes carousel-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(var(--shift));
    }
  }

  .marquee:hover .marquee-track,
  .marquee:focus-within .marquee-track,
  .marquee > input:checked ~ .marquee-track {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
    }
  }
</style>
