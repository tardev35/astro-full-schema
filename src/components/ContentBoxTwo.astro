---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
  label?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label } = Astro.props;

const sectionLabel = label ?? title ?? titleleft ?? titleright ?? "ข้อมูลประกอบ";
---

<section aria-label={sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  {
    title && (
      <header class="mb-6 flex items-center gap-4 border-b border-[#c7dcfb] pb-4">
        <span aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#0b3fb8] to-[#16a34a] shadow-[0_0_10px_rgba(11,63,184,0.35)]" />
        <HeadingTag class="bg-gradient-to-r from-[#062c85] via-[#0b3fb8] to-[#16a34a] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
      </header>
    )
  }

  <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#1b2c4a]">
      {
        titleleft && (
          <p class="flex items-center gap-3 border-b border-[#c7dcfb] pb-3 text-xl leading-normal font-black tracking-widest text-[#0a1c3a] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#c7dcfb] bg-gradient-to-br from-[#3b74e8] via-[#0b3fb8] to-[#062c85] text-sm text-white shadow-[0_5px_15px_rgba(11,63,184,0.20)]">
              🔐
            </span>
            {titleleft}
          </p>
        )
      }
      <slot name="left" />
    </article>

    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#1b2c4a]">
      {
        titleright && (
          <p class="flex items-center gap-3 border-b border-[#c7dcfb] pb-3 text-xl leading-normal font-black tracking-widest text-[#0a1c3a] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#c7dcfb] bg-gradient-to-br from-[#31c96b] via-[#16a34a] to-[#0f7a37] text-sm text-white shadow-[0_5px_15px_rgba(22,163,74,0.22)]">
              📊
            </span>
            {titleright}
          </p>
        )
      }
      <slot name="right" />
    </article>
  </div>
</section>
