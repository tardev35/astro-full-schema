---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#f6c9c6] bg-white p-8 text-[#2d1214] shadow-[0_10px_30px_rgba(230,0,18,0.12)] transition-all duration-500 hover:border-[#e60012]/45 hover:shadow-[0_15px_40px_rgba(230,0,18,0.20)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 bg-gradient-to-br from-[#fff7f6] to-transparent"></div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#f6c9c6] pb-4">
          <span aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#e60012] via-[#b30009] to-[#d4a017] shadow-[0_0_10px_rgba(230,0,18,0.35)]" />
          <HeadingTag class="bg-gradient-to-r from-[#8a0208] via-[#e60012] to-[#8a6410] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-10 md:grid-cols-2">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#2d1214]">
        {
          titleleft && (
            <p class="flex items-center gap-3 border-b border-[#f6c9c6] pb-3 text-xl leading-normal font-black tracking-widest text-[#8a0208] uppercase">
              <span aria-hidden="true" class="h-6 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#e60012] to-[#b30009] shadow-[0_0_10px_rgba(230,0,18,0.35)]" />
              {titleleft}
            </p>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#2d1214] md:border-l md:border-[#f6c9c6] md:pl-10">
        {
          titleright && (
            <p class="flex items-center gap-3 border-b border-[#f6c9c6] pb-3 text-xl leading-normal font-black tracking-widest text-[#8a0208] uppercase">
              <span aria-hidden="true" class="h-6 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#d4a017] to-[#8a6410] shadow-[0_0_10px_rgba(212,160,23,0.40)]" />
              {titleright}
            </p>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
