---
import kbankLogo from "../assets/banks/kbank.png";
import scbLogo from "../assets/banks/scb.png";
import krungsriLogo from "../assets/banks/krungsri.png";
import ktbLogo from "../assets/banks/ktb.png";

const bankPool = [
  { name: "KBank", color: "bg-[#1155cc]", icon: kbankLogo.src },
  { name: "SCB", color: "bg-[#4e1c80]", icon: scbLogo.src },
  { name: "Krungsri", color: "bg-[#fcd34d]", icon: krungsriLogo.src },
  { name: "KTB", color: "bg-[#0ea5e9]", icon: ktbLogo.src },
];
---

<div class="mx-auto w-full max-w-[1300px] p-4">
  <div class="relative overflow-hidden rounded-[2rem] border-2 border-[#1b8d3b] bg-[#f8fcf9] px-4 py-8 shadow-[0_10px_30px_rgba(27,141,59,0.15)] md:p-10">
    <div class="bg-theme-oklab absolute top-0 left-0 h-1.5 w-full"></div>

    <div class="pointer-events-none absolute top-10 left-1/2 h-20 w-40 -translate-x-1/2 rounded-full bg-[#1b8d3b]/10 blur-[40px]"></div>

    <div class="relative z-10 mb-8 flex items-center justify-center gap-3">
      <span class="text-2xl drop-shadow-[0_0_8px_rgba(250,204,21,0.6)]">🏆</span>
      <h2 class="bg-theme-oklab bg-clip-text text-xl font-black tracking-wide text-transparent drop-shadow-sm md:text-3xl">รายการถอนเงินล่าสุด</h2>
      <span class="text-2xl drop-shadow-[0_0_8px_rgba(250,204,21,0.6)]">🏆</span>
    </div>

    <div id="live-winners-feed" class="relative z-10 flex flex-col"></div>
  </div>
</div>

<script define:vars={{ bankPool }}>
  const feedContainer = document.getElementById("live-winners-feed");

  const getRandomStr = (len, chars) =>
    Array.from({ length: len })
      .map(() => chars.charAt(Math.floor(Math.random() * chars.length)))
      .join("");
  const getAmount = () => (Math.floor(Math.random() * (95000 - 15000 + 1)) + 15000).toLocaleString("en-US");

  const getNowTime = () => {
    const d = new Date();
    return `${d.getHours().toString().padStart(2, "0")}:${d.getMinutes().toString().padStart(2, "0")}:${d.getSeconds().toString().padStart(2, "0")}`;
  };

  const createWinnerHTML = () => {
    const bank = bankPool[Math.floor(Math.random() * bankPool.length)];
    const user = `${getRandomStr(2, "abcdefghijklmnopqrstuvwxyz")}***${getRandomStr(4, "0123456789")}`;
    const isPending = Math.random() > 0.6;

    const statusClass = isPending ? "border-yellow-400 bg-yellow-100 text-yellow-600 animate-pulse" : "border-[#399537]/50 bg-[#399537]/10 text-[#27a544]";
    const statusText = isPending ? "กำลังถอน..." : "ถอนสำเร็จแล้ว";

    return `
      <div class="winner-row grid grid-rows-[0fr] opacity-0 transition-all duration-700 ease-in-out -translate-y-4">
        <div class="overflow-hidden">
          <div class="mb-3 flex items-center justify-between rounded-xl border border-[#1b8d3b]/20 bg-white p-4 shadow-sm transition-colors hover:border-[#399537] hover:bg-[#f0fdf4]">
            
            <div class="flex items-center gap-4">
              <div class="relative flex h-11 w-11 shrink-0 items-center justify-center rounded-full border border-gray-100 shadow-sm">
                <div class="flex h-9 w-9 items-center justify-center overflow-hidden rounded-full ${bank.color} shadow-inner">
                  <img src="${bank.icon}" alt="bank" class="h-6 w-6 object-contain" />
                </div>
              </div>
              <div class="flex flex-col justify-center">
                <div class="flex items-center gap-2">
                  <span class="text-sm font-bold text-gray-800 md:text-base">ยูสเซอร์: <span class="tracking-wider">${user}</span></span>
                </div>
                <div class="mt-0.5 text-[10px] text-gray-500 md:text-xs">REF#${getRandomStr(8, "0123456789")} • วันนี้ ${getNowTime()}</div>
              </div>
            </div>

            <div class="flex flex-col items-end justify-center gap-1.5">
              <div class="text-[#1b8d3b] text-base font-black tracking-tight md:text-xl">
                ${getAmount()} <span class="text-[10px] font-bold text-gray-500 md:text-xs">THB</span>
              </div>
              <div class="rounded-full border px-2.5 py-0.5 text-[9px] font-bold md:text-[10px] ${statusClass}">
                ${statusText}
              </div>
            </div>

          </div>
        </div>
      </div>
    `;
  };

  const triggerNewWinner = () => {
    const tempDiv = document.createElement("div");
    tempDiv.innerHTML = createWinnerHTML();
    const newElement = tempDiv.firstElementChild;

    feedContainer.prepend(newElement);

    newElement.getBoundingClientRect();

    newElement.classList.remove("grid-rows-[0fr]", "opacity-0", "-translate-y-4");
    newElement.classList.add("grid-rows-[1fr]", "opacity-100", "translate-y-0");

    if (feedContainer.children.length > 4) {
      const lastElement = feedContainer.lastElementChild;

      lastElement.classList.remove("grid-rows-[1fr]", "opacity-100", "translate-y-0");
      lastElement.classList.add("grid-rows-[0fr]", "opacity-0", "translate-y-4");

      setTimeout(() => {
        lastElement.remove();
      }, 700);
    }
  };

  for (let i = 0; i < 4; i++) {
    const tempDiv = document.createElement("div");
    tempDiv.innerHTML = createWinnerHTML();
    const el = tempDiv.firstElementChild;
    el.classList.remove("grid-rows-[0fr]", "opacity-0", "-translate-y-4");
    el.classList.add("grid-rows-[1fr]", "opacity-100", "translate-y-0");
    feedContainer.appendChild(el);
  }

  setInterval(triggerNewWinner, 8000);
</script>

<style>
  .bg-theme-oklab {
    background-image: linear-gradient(in oklab to right, #1b8d3b, #399537, #27a544);
  }
</style>
