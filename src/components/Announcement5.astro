---
const {
  message = "PAYDAY24 เว็บสล็อตมั่นคง เว็บตรงลิขสิทธิ์แท้ จ่ายจริง 100% รวมสล็อตจาก PG Slot, Joker Gaming และ Jili ไว้ในยูสเดียว • คาสิโนสดส่งตรงจากสตูดิโอ SA Gaming มีบาคาร่า และโต๊ะสดให้เลือกจากหน้าเดียว • หวยออนไลน์อัปเดตทุกงวด และแทงบอลออนไลน์ในราคานับบอลที่ดีที่สุด • กิจกรรมรับเครดิตทุกวัน ทั้งเช็กอินประจำวัน กงล้อ กรอกโค้ด และเครดิตฟรีตามช่วงเวลา • คืนยอดเสียเป็นสิทธิ์ที่อิงเงื่อนไขการใช้งานของบัญชี เช็กหน้ากิจกรรมรับเครดิตก่อนเริ่มเล่นทุกครั้ง • ฝากถอนออโต้รองรับ True Wallet ทำรายการและดูสถานะได้เองจากหน้าเมมเบอร์ • สมัครสมาชิกใหม่วันนี้รับโปรโมชั่นสุดคุ้ม เข้าเล่นได้ทั้งมือถือ แท็บเล็ต และคอมพิวเตอร์",
} = Astro.props;

const SCROLL_PX_PER_SEC = 50;
const PX_PER_CHAR = 6.2;
const TRAILING_PX = 81;
const scrollSeconds = Math.max(12, Math.round((message.length * PX_PER_CHAR + TRAILING_PX) / SCROLL_PX_PER_SEC));
---

<div class="mx-auto w-full max-w-7xl px-4 py-3 font-sans">
  <div class="relative overflow-hidden rounded-md border border-[#fdc700]/45 bg-[#150726] shadow-[0_0_15px_rgba(253,199,0,0.22)]">
    <div aria-hidden="true" class="absolute top-0 -left-4 h-full w-8 -skew-x-12 bg-gradient-to-b from-[#ffe680] to-[#a86f00]"></div>
    <div aria-hidden="true" class="absolute top-0 -right-4 h-full w-8 -skew-x-12 bg-[#a855f7]/20"></div>

    <div class="flex items-center">
      <div class="relative z-10 flex w-12 shrink-0 items-center justify-center bg-gradient-to-b from-[#ffe680] to-[#a86f00] py-2.5">
        <span aria-hidden="true" class="animate-pulse text-lg drop-shadow-[0_0_5px_rgba(255,230,128,0.85)]">🎰</span>
      </div>

      <div class="marquee-container relative flex-1 overflow-hidden py-2.5 pr-6">
        <div aria-hidden="true" class="pointer-events-none absolute top-0 left-0 z-10 h-full w-8 bg-gradient-to-r from-[#150726] to-transparent"></div>
        <div aria-hidden="true" class="pointer-events-none absolute top-0 right-0 z-10 h-full w-12 bg-gradient-to-l from-[#150726] to-transparent"></div>

        <div class="marquee-content inline-block pl-4 text-sm font-bold tracking-wide whitespace-nowrap text-[#f3e9ff]" style={`animation-duration:${scrollSeconds}s`}>
          <span class="mr-8 inline-flex items-center gap-2"><span aria-hidden="true" class="h-1.5 w-1.5 rounded-full bg-[#fdc700] shadow-[0_0_5px_rgba(253,199,0,0.85)]"></span>{message}</span>
          <span aria-hidden="true" class="mr-8 inline-flex items-center gap-2"><span class="h-1.5 w-1.5 rounded-full bg-[#fdc700] shadow-[0_0_5px_rgba(253,199,0,0.85)]"></span>{message}</span>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .marquee-content {
    animation: marquee 25s linear infinite;
  }
  .marquee-container:hover .marquee-content {
    animation-play-state: paused;
  }
  @keyframes marquee {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee-content {
      animation: none;
    }
  }
</style>
