---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-xl sm:text-2xl md:text-3xl" : "text-lg sm:text-xl md:text-2xl";
---

<section class="my-12 flex w-full justify-center px-4 font-sans">
  <div
    class="relative isolate w-full max-w-[1400px] rounded-2xl border-2 border-[#f6c9c6] bg-white p-8 pt-44 text-left text-base leading-relaxed text-[#2d1214] shadow-[0_10px_30px_rgba(230,0,18,0.12)] md:pt-40">
    <div aria-hidden="true" class="pointer-events-none absolute -top-16 -right-10 -z-10 h-40 w-40 rounded-full bg-[#d4a017]/20 blur-[60px]"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -bottom-16 -left-10 -z-10 h-40 w-40 rounded-full bg-[#e60012]/16 blur-[60px]"></div>

    {
      title && (
        <div class="absolute -top-6 left-1/2 flex w-[92%] max-w-2xl -translate-x-1/2 items-center justify-center gap-2 rounded-lg border-2 border-[#f5c542]/70 bg-gradient-to-r from-[#b30009] via-[#e60012] to-[#b30009] px-4 py-2.5 text-center shadow-[0_10px_30px_rgba(230,0,18,0.28)] sm:px-8">
          <span aria-hidden="true" class="shrink-0 text-[#ffe9a8]">
            ✦
          </span>
          <HeadingTag class={`min-w-0 ${headingSize} leading-normal font-black tracking-tight text-white uppercase`}>{title}</HeadingTag>
          <span aria-hidden="true" class="shrink-0 text-[#ffe9a8]">
            ✦
          </span>
        </div>
      )
    }

    <slot />
  </div>
</section>
