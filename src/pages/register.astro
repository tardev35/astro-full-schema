---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement6.astro";
import CtaRedirect from "../components/CtaRedirect.astro";
import { pageGraph } from "../lib/schema";

const pageTitle = "สมัครสมาชิก PIGAUTO | ปุ่มเปิดยูสใหม่ผ่านมือถือ สล็อตหมูเว็บตรง";

const pageDescription =
  "หากคุณกำลังมองหาเว็บสล็อตออโต้ที่สมัครง่าย PIGAUTO พร้อมมอบปุ่มเปิดยูสใหม่ผ่านมือถือ เพื่อเริ่มเล่นเกมแท้จากค่ายดัง ฝากถอนเร็วไม่มีขั้นต่ำ รองรับวอเลททุกธนาคาร";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "สมัครสมาชิก", path: "/register" },
  ],
});

const targetUrl = "https://yoalink.com/22hs";
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="สมัครสมาชิก PIGAUTO" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label="สมัครสมาชิก PIGAUTO"
        class="group relative mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#b07d12] bg-gradient-to-r from-[#ffe08a] via-[#f5c542] to-[#d99e1f] px-6 py-4 text-xl font-bold tracking-wide text-[#1f0303] shadow-[0_10px_30px_rgba(245,197,66,0.26)] transition-all duration-300 hover:scale-105 hover:border-[#ffe08a] hover:shadow-[0_15px_40px_rgba(245,197,66,0.35)]">
        สมัครสมาชิก PIGAUTO
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="สมัครสมาชิก" />
</MainLayout>
