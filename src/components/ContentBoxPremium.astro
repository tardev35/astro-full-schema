---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#5c0b13] bg-[#1f0405] p-8 text-left text-base leading-relaxed text-[#f7e6d0] shadow-[0_10px_30px_rgba(245,197,66,0.18)] transition-all duration-500 hover:border-[#f5c542]/55 hover:shadow-[0_15px_40px_rgba(245,197,66,0.30)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#f5c542]/18 blur-[55px] transition-all duration-500 group-hover:bg-[#ffd34d]/28"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#e11d1d]/16 blur-[55px] transition-all duration-500 group-hover:bg-[#ff5a4a]/24"></div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#5c0b13] pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#f5c542] via-[#c8901a] to-[#e11d1d] shadow-[0_0_10px_rgba(245,197,66,0.45)]" />
          <HeadingTag class={`bg-gradient-to-r from-[#ffe9a3] via-[#ffd34d] to-[#ff8a70] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
            {title}
          </HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
