const faqs = [
  {
    q: "สลับค่ายใน BABYSHARK8899 ต้องสมัครยูสใหม่ไหม",
    a: "ไม่ต้องครับ บัญชีเดียวเปิดได้ทุกค่ายที่เรามี เล่น Lucky Neko อยู่แล้วอยากไปต่อ Roma ก็ออกจากเกมแล้วเลือกเกมใหม่ได้เลย",
  },
  {
    q: "เพิ่งเริ่มเล่นสล็อต เริ่มจากเกมแบบไหนดี",
