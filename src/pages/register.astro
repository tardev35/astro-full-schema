---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementCyber.astro";
import CtaRedirect from "../components/CtaRedirect.astro";
import { pageGraph } from "../lib/schema";

const pageTitle = "สมัครสมาชิก AMBHENG88 | ปุ่มเปิดยูสใหม่ผ่านมือถือ ระบบออโต้ทั้งเว็บ";

const pageDescription =
  "หากคุณกำลังมองหาเว็บสล็อตที่สมัครจบในไม่กี่นาที AMBHENG88 พร้อมมอบปุ่มเปิดยูสใหม่ผ่านมือถือ เพื่อเข้าเล่นสล็อตทรูมันนี่วอลเล็ท เติมฝากถอนออโต้ ไม่มีขั้นต่ำ";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "สมัครสมาชิก", path: "/register" },
  ],
});

const targetUrl = "https://tinyurl.com/amb66tar";
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="สมัครสมาชิก AMBHENG88" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label="สมัครสมาชิก AMBHENG88"
        class="group relative mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#c9a800] bg-gradient-to-r from-[#fff27a] via-[#ffe814] to-[#c9a800] px-6 py-4 text-xl font-bold tracking-wide text-[#170512] shadow-[0_10px_30px_rgba(255,232,20,0.26)] transition-all duration-300 hover:scale-105 hover:border-[#fff27a] hover:shadow-[0_15px_40px_rgba(255,232,20,0.35)]">
        สมัครสมาชิก AMBHENG88
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="สมัครสมาชิก" />
</MainLayout>
