---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
  label?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label } = Astro.props;

const sectionLabel = label ?? title ?? titleleft ?? titleright ?? "ข้อมูลประกอบ";
---

<section aria-label={sectionLabel} class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#5a1a60] bg-[#1c0620] p-8 text-[#ead9ec] shadow-[0_10px_30px_rgba(0,0,0,0.35)] transition-all duration-500 hover:border-[#8a2f8f] hover:shadow-[0_15px_40px_rgba(193,63,196,0.26)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 bg-gradient-to-br from-[#26082c] to-transparent"></div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#5a1a60] pb-4">
          <span aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffe08a] via-[#c13fc4] to-[#62035b] shadow-[0_0_10px_rgba(193,63,196,0.45)]" />
          <HeadingTag class="bg-gradient-to-r from-[#e8e8ee] via-[#ffe08a] to-[#e061e3] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-10 md:grid-cols-2">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#ead9ec]">
        {
          titleleft && (
            <p class="flex items-center gap-3 border-b border-[#5a1a60] pb-3 text-xl leading-normal font-black tracking-widest text-[#ffe08a] uppercase">
              <span aria-hidden="true" class="h-6 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#e061e3] to-[#9c2193] shadow-[0_0_10px_rgba(193,63,196,0.45)]" />
              {titleleft}
            </p>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#ead9ec] md:border-l md:border-[#5a1a60] md:pl-10">
        {
          titleright && (
            <p class="flex items-center gap-3 border-b border-[#5a1a60] pb-3 text-xl leading-normal font-black tracking-widest text-[#e061e3] uppercase">
              <span aria-hidden="true" class="h-6 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffe08a] to-[#f5c542] shadow-[0_0_10px_rgba(245,197,66,0.45)]" />
              {titleright}
            </p>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
