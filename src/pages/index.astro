---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxHuay.astro";
import ContentBoxTwo from "../components/ContentBoxTwoHuay.astro";
import ContentBoxSevenThree from "../components/ContentBoxSevenThreeHuay.astro";
import ContentBoxThreeColums from "../components/ContentBox3ThreeHuay.astro";
import Announcement from "../components/AnnouncementHuay.astro";
import ProviderGrid from "../components/LottoGrid.astro";
import LatestWinners from "../components/LatestWinnersHuay.astro";
import SmoothCarousel from "../components/SmoothCarousel.astro";
import Navfoot from "../components/Navfoot.astro";
import Faq from "../components/FaqHuay.astro";
const currentPath = Astro.url.pathname;
const homePage = Astro.url.origin;
const logoUrl = homePage + "/logo.webp";

const webPageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: "HUAYPUNG เว็บหวยออนไลน์อันดับ 1 ซื้อแล้วมั่นใจ จ่ายจริง หวยปัง",
  description: "HUAYPUNG เว็บหวยออนไลน์อันดับ 1 อัตราจ่าย ดีงามทั้งตัวบน ตัวล่าง ซื้อออนไลน์หวยไม่ผ่านเอเย่นต์ ระบบประมวลผลผลรางวัล Real-time จ่ายจริง ผ่านบัญชีแท้",
  url: currentPath,
};
const webSiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "HUAYPUNG",
  alternateName: ["huaypung", "huaypung lotto"],
  url: "https://huaypung.com/",
};
const orgSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "HUAYPUNG",
  logo: logoUrl,
  url: homePage,
};
const allSchemas = [webPageSchema, orgSchema, webSiteSchema];

import { Picture } from "astro:assets";
import image1 from "../assets/slide2.jpg";
import image2 from "../assets/banner1.jpg";
---

<MainLayout>
  <script type="application/ld+json" set:html={JSON.stringify(allSchemas)} />

  <Announcement />
  <ContentBox title="HUAYPUNG เว็บหวยออนไลน์อันดับ 1 ซื้อแล้วมั่นใจ จ่ายจริง หวยปัง">
    <p class="leading-relaxed">
      HUAYPUNG เว็บหวยออนไลน์อันดับ 1 ที่คอหวยทั่วไทยให้ความไว้วางใจ ด้วยระบบการจัดการที่โปร่งใสและตรวจสอบได้ ซื้อแล้วมั่นใจ ว่าทุกตัวเลขที่คุณเลือกจะได้รับการดูแลอย่างดีที่สุด
      บริการในรูปแบบเว็บตรงไม่ผ่านเอเย่นต์ ตัดปัญหาการกั๊กยอดหรือการอั้นเลขที่เว็บกระจอกๆ ชอบทำ จ่ายจริง ทุกยอด รองรับการแทงทุกรูปแบบและพร้อมจ่ายรางวัลใหญ่ทันทีโดยไม่มีข้อแม้ ไม่มีการเบี้ยว ผลัดงวด
      HUAYPUNG คือจุดยืนใหม่ของคอหวยที่ต้องการความมั่นคง ระบบการเงินของเราแข็งแกร่ง
    </p>

    <div class="mt-8 flex flex-wrap justify-center gap-6">
      <a
        href="/login"
        class="group relative flex items-center justify-center rounded-full border border-red-500/50 bg-[#450a0a]/80 px-10 py-3.5 font-black text-yellow-500 backdrop-blur-sm transition-all duration-300 hover:scale-105 hover:bg-red-900/60 hover:shadow-[0_0_15px_rgba(220,38,38,0.4)]">
        เข้าระบบเกม
      </a>

      <a
        href="/register"
        class="group relative flex items-center justify-center rounded-full bg-gradient-to-r from-yellow-500 via-yellow-400 to-yellow-500 px-10 py-3.5 font-black text-[#450a0a] shadow-[0_5px_20px_rgba(251,191,36,0.4)] transition-all duration-300 hover:-translate-y-1 hover:scale-105 hover:shadow-[0_8px_25px_rgba(251,191,36,0.6)]">
        สมัครสมาชิก
      </a>
    </div>
  </ContentBox>
  <ContentBoxTwo titleleft="ทางเข้าเล่นมังกรทอง" titleright="ผลรางวัลล่าสุด">
    <div slot="left" class="flex flex-col gap-4">
      <div class="rounded-xl border border-yellow-600/30 bg-black/40 p-6">
        <p class="mb-4 text-center font-bold text-yellow-400">ล็อคอินเข้าระบบ HUAYPUNG</p>
        <div class="flex flex-col gap-3">
          <input type="text" placeholder="ชื่อผู้ใช้งาน" class="w-full rounded-lg border border-red-500/30 bg-white/10 p-3 text-white" />
          <input type="password" placeholder="รหัสผ่าน" class="w-full rounded-lg border border-red-500/30 bg-white/10 p-3 text-white" />
          <button class="mt-2 w-full rounded-lg bg-gradient-to-r from-yellow-500 to-yellow-300 p-3 font-black text-red-900 shadow-lg transition-transform hover:scale-105">เข้าสู่ระบบ</button>
          <button class="w-full rounded-lg border border-yellow-500/50 p-3 font-bold text-yellow-500 transition-colors hover:bg-yellow-500/10">สมัครสมาชิกใหม่</button>
        </div>
      </div>
    </div>
    <div slot="right">
      <div class="rounded-xl border border-yellow-600/30 bg-red-950/60 p-4">
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b border-yellow-600/30 text-yellow-400">
              <th class="py-2 text-left">ประเภทหวย</th>
              <th class="py-2">รางวัลที่ 1 / บน</th>
              <th class="py-2">2 ตัวล่าง</th>
            </tr>
          </thead>
          <tbody class="text-white">
            <tr class="border-b border-white/5"><td class="py-3">หวยรัฐบาล</td><td class="text-center font-bold text-yellow-400">173770</td><td class="text-center">95</td></tr>
            <tr class="border-b border-white/5"><td class="py-3">หวยลาว</td><td class="text-center font-bold text-yellow-400">4781</td><td class="text-center">03</td></tr>
            <tr><td class="py-3">หวยยี่กี</td><td class="text-center font-bold text-yellow-400">512</td><td class="text-center">14</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </ContentBoxTwo>
  <ProviderGrid />
  <LatestWinners />

  <ContentBoxThreeColums titleleft="มั่งคั่งปลอดภัย" titlecenter="ระบบออโต้ 3 วิ" titleright="หวยครบทุกชนิด">
    <div slot="left">การเงินมั่นคง จ่ายจริงทุกยอดหลักล้าน ปลอดภัยด้วยระบบเข้ารหัสข้อมูลขั้นสูง</div>
    <div slot="center">ฝาก-ถอน รวดเร็วทันใจด้วยระบบอัตโนมัติ AI ประมวลผลไวที่สุดในไทย</div>
    <div slot="right">รวมหวยทุกประเภทไว้ในที่เดียว ทั้งไทย ลาว ฮานอย ยี่กี หุ้น และหวยชุด</div>
  </ContentBoxThreeColums>
  <ContentBox>
    <h2 class="mb-4 text-3xl font-black tracking-[0.2em] text-yellow-400 uppercase drop-shadow-[0_0_10px_rgba(220,38,38,0.8)]">HUAYPUNG เว็บหวยออนไลน์อันดับ 1 อัตราจ่าย สองตัวบน ล่าง 95 บาท</h2>
    <p class="leading-relaxed">
      เว็บหวยออนไลน์อันดับ 1 ที่จัดเต็มทุกอัตราจ่ายดีงาม ไม่ว่าจะเป็นเลขสอง 2 ตัวบน ล่าง 95 บาท ตัวหรือสามตัว 3 ตัวบน / โต๊ด จ่ายสูงสุด 900 บาท HUAYPUNG เราให้เรทที่สูงกว่ามาตรฐานทั่วไปในตลาด
      เพื่อให้คุณได้รับผลตอบแทนที่คุ้มค่าที่สุดในทุกบิลที่แทง ความคุ้มค่านี้คือเหตุผลหลักที่คนเล่นหวยย้ายค่ายมาใช้บริการ HUAYPUNG อัตราจ่ายของที่นี่ไม่ใช่แค่คำโฆษณา
      แต่เป็นมาตรฐานที่เรากล้าชนกับทุกเว็บในตลาด
    </p>
  </ContentBox>
  <ContentBoxSevenThree titleleft="" titleright="ถอนจริง 3 วินาที">
    <div slot="left" class="flex h-full flex-col justify-center">
      <Picture
        src={image1}
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600, 800]}
        sizes="(max-width: 768px) 100vw, 50vw"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
        alt="Vegus24 VIP Service"
        class="mx-auto h-auto w-full rounded-2xl border-2 border-yellow-500/30 shadow-[0_10px_30px_rgba(220,38,38,0.3)]"
      />
    </div>
    <div slot="right">
      <h2 class="text-yellow-4000 mb-4 text-3xl font-black tracking-[0.2em] uppercase drop-shadow-[0_0_10px_rgba(220,38,38,0.8)]">ซื้อแล้วมั่นใจ ซื้อหวยออนไลน์ไม่ผ่านเอเย่นต์ ต้องเว็บ HUAYPUNG</h2>
      <p>
        หวยเว็บตรง HUAYPUNG ที่ขึ้นตรงกับเซิร์ฟเวอร์หลักเท่านั้น ระบบนี้ช่วยให้ข้อมูลการแทงของคุณปลอดภัยที่สุด ไม่มีการแทรกแซงจากคนกลาง ทุกโพยที่คุณกดยืนยันจะถูกบันทึกลงฐานข้อมูลหลักทันที
        ทำให้คุณซื้อหวยด้วยความมั่นใจ 100% ข้อมูลหลักอย่างปลอดภัยไร้กังวล หมดปัญหาเรื่องการโดนหักหัวคิว หรือการโดนปิดบัญชีโดยไม่มีสาเหตุ
      </p>

      <a
        href="/line"
        class="inline-flex items-center bg-[#00B900] px-8 py-3 font-bold text-white shadow-lg transition-transform hover:scale-105"
        style="clip-path: polygon(15% 0, 100% 0, 100% 70%, 85% 100%, 0 100%, 0 30%);">
        <span class="mr-2 text-xl">LINE</span> ติดต่อแอดมิน
      </a>
    </div>
  </ContentBoxSevenThree>
  <SmoothCarousel />
  <ContentBox>
    <h2 class="mb-4 text-3xl font-black tracking-[0.2em] text-yellow-400 uppercase drop-shadow-[0_0_10px_rgba(220,38,38,0.8)]">หวยปัง ลุ้นหวยนานาชนิด รวมทุกการแทงหวย</h2>
    <p class="leading-relaxed">
      ไม่ว่าจะเป็นหวยรัฐบาล หวยลาว หวยฮานอย หรือหวยหุ้น เราจัดมาให้ครบตามคอนเซปต์ หวยปัง ที่รวมทุกความต้องการไว้ในที่เดียว ให้คุณสามารถลุ้นรางวัลได้หลากหลายชนิดตลอด 24 ชั่วโมง
      ช่วยให้คุณกระจายความเสี่ยงและมีโอกาสทำกำไรได้มากกว่าการรอแค่หวยไทยเพียงอย่างเดียว
    </p>
  </ContentBox>

  <Faq />
  <ContentBoxTwo titleleft="ระบบประมวลผลผลรางวัล หวย และ ฉลากกินแบ่งแบบ Real-time" titleright="จ่ายจริง ไม่ผลัดวัน ผ่านบัญชีแท้ ปลอดภัย">
    <div slot="left" class="flex flex-col gap-4">
      <p>
        ระบบของเราเชื่อมต่อข้อมูลผลรางวัลโดยตรงและประมวลผลแบบ Real-time ทันทีที่หวยออก ทำให้คุณไม่ต้องนั่งลุ้นว่ายอดเงินจะเข้าเมื่อไหร่
        เพราะระบบออโต้ของเราจะทำการคำนวณและปรับยอดเครดิตให้คุณทันทีอย่างแม่นยำและเที่ยงตรงที่สุด
      </p>
    </div>
    <div slot="right">
      <p>
        เมื่อคุณถูกรางวัล การได้รับเงินคือสิ่งสำคัญที่สุด เราจึงยึดมั่นในนโยบาย จ่ายจริง ไม่ผลัดวัน ไม่มีการดึงเกม ยอดเงินทุกบาทที่คุณทำรายการถอน จะถูกโอนผ่านระบบบัญชีแท้ที่ปลอดภัย
        ตรวจสอบเส้นทางการเงินได้ เกินล้านเปร์เซ็น ทำให้คุณมั่นใจได้ว่าเงินทุกยอดที่คุณลงทุนกับเราจะกลับคืนสู่มือคุณอย่างรวดเร็วและปลอดภัยแน่นอน
      </p>
    </div>
  </ContentBoxTwo>
  <ContentBox>
    <h2 class="mb-4 text-2xl font-black tracking-[0.2em] text-yellow-400 uppercase drop-shadow-[0_0_10px_rgba(220,38,38,0.8)]">วิธีการเช็คโพยหวยว่าเข้าแล้วหรือยัง</h2>
    <p class="leading-relaxed">
      สำหรับใครที่เป็นมือใหม่หรืออยากเช็คความถูกต้อง วิธีการตรวจสอบโพยหวยกับเรานั้นง่ายมาก เพียงเข้าไปที่เมนู <a class="text-amber-400" href="/ตรวจหวย">"ประวัติการแทง"</a> ในระบบของ HUAYPUNG คุณก็จะเห็นรายการเลขที่ซื้อ
      สถานะการอนุมัติ และรายละเอียดบิลทั้งหมด ซึ่งเป็นระบบที่ชัดเจนและใช้งานง่ายที่สุด เพื่อให้สมาชิกทุกคนสัมผัสได้ถึงความสะดวกสบายในแบบฉบับเว็บหวยอันดับ 1 อย่างแท้จริงครับ
    </p>
  </ContentBox>

  <Navfoot />

  <style>
    :global(.text-yellow-gradient) {
      background: linear-gradient(to bottom, #e7d800 0%, #ddd44e 100%) !important;
      -webkit-background-clip: text !important;
      -webkit-text-fill-color: transparent !important;
    }
  </style>
</MainLayout>
