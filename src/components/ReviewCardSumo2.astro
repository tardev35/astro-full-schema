---
const reviews = [
  {
    name: "สมาชิกสายทุนน้อยที่เริ่มจาก 1 บาท",
    role: "ฝากผ่านวอเล็ทแล้วปั่นได้เลย ไม่มีขั้นต่ำ",
    stars: 5,
    tag: "ไม่มีขั้นต่ำจริง",
    content:
      "อยากฝาก 1 บาทก็ฝากได้จริงครับ ไม่มีการตั้งเงื่อนไข ไม่บังคับทำกิจกรรม รองรับทุกช่องทางรวมถึงวอเล็ทด้วย เลยเริ่มแบบสายประหยัดไปก่อนได้สบายใจ พอจับทางเกมได้ค่อยขยับ ใครจะซื้อฟรีสปินหรือปั่นขำๆ คั่นเวลาก็สนุกได้เหมือนกัน YIMSIAM88 เปิดไฟเขียวให้หมด ไม่มีใครมาบอกว่าต้องเล่นสไตล์ไหน",
    avatar: "👛",
  },
  {
    name: "สมาชิกที่เพิ่งถอนยอดใหญ่ครั้งแรก",
    role: "ยืนยันว่าจ่ายเต็มไม่มีหักจริงตามที่ประกาศ",
    stars: 5,
    tag: "จ่ายเต็มไม่มีหัก",
    content:
      "กดถอนปุ๊บเงินเด้งเข้าบัญชีปั๊บภายในไม่กี่วินาที เร็วกว่าต้มมาม่าสุกจริงอย่างที่พี่สยามว่าไว้ครับ ที่ประทับใจคือยอดที่เข้ามาตรงกับที่กดถอนเป๊ะ ไม่มีหักค่าธรรมเนียมหรือค่าดำเนินการใดๆ ทั้งสิ้น ไม่ต้องนั่งส่งสลิปรอแอดมินตอบแชทข้ามวันเหมือนที่เคยเจอ ระบบออโต้ทำงานให้เสร็จก่อนจะทันได้หงุดหงิด",
    avatar: "💸",
  },
  {
    name: "สมาชิกที่ทักแชทตอนตีสอง",
    role: "คุยกับทีมงานคนไทย ไม่เจอบอทตอบวนไปวนมา",
    stars: 5,
    tag: "ทีมงานคนไทยตอบเอง",
    content:
      "ติดปัญหาตอนดึกแล้วทักไลน์ไป นึกว่าจะเจอบอทตอบวนไปวนมาเหมือนที่อื่น กลายเป็นคนไทยตอบเองครับ คุยกันรู้เรื่อง เข้าใจมุก เคลียร์ให้จบในรอบเดียว เขาบอกว่าแสตนด์บายตลอด 24 ชั่วโมงไม่มีวันหยุดราชการ ก็เป็นแบบนั้นจริง ส่วนตอนสมัครก็ขอข้อมูลเท่าที่จำเป็น ไม่ต้องส่งบัตร ไม่ต้องถ่ายหน้า สมัครไวมาก",
    avatar: "💬",
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label="เสียงจากสมาชิก YIMSIAM88" class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#ffd98a] via-[#f6c475] to-[#ff7a18] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      เสียงจากสมาชิก <span class="text-[#ff7a18]">YIMSIAM88</span>
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#ff7a18] to-transparent"></div>
  </div>

  <div
    class="mx-auto mb-8 flex max-w-md items-center justify-center gap-5 rounded-2xl border border-[#ff7a18]/25 bg-[#24100a]/92 px-6 py-4 shadow-[0_10px_30px_rgba(255,122,24,0.18)] backdrop-blur-xl">
    <div class="flex flex-col items-center">
      <span class="bg-gradient-to-b from-[#ffd98a] to-[#c8921e] bg-clip-text text-4xl leading-none font-black text-transparent">{average}</span>
      <span class="mt-1 text-[10px] font-bold tracking-widest text-[#c9ac91] uppercase">คะแนนเฉลี่ย</span>
    </div>
    <div class="h-12 w-px bg-[#4a2311]"></div>
    <div class="flex flex-col gap-1.5">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#ff7a18]" : "text-[#4a2311]"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#c9ac91]">คะแนนเฉลี่ย {average} จาก 5 ดาว จากการใช้งานจริงของสมาชิก {reviews.length} ด้าน</span>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
    {
      reviews.map((review) => (
        <article class="group relative isolate flex flex-col gap-4 overflow-hidden rounded-2xl border border-[#ff7a18]/25 bg-[#24100a]/92 p-6 text-left shadow-[0_10px_30px_rgba(255,122,24,0.18)] backdrop-blur-xl transition-all duration-300 hover:-translate-y-1 hover:border-[#ff7a18]/50 hover:shadow-[0_15px_40px_rgba(255,122,24,0.3)]">
          <span class="absolute inset-y-0 left-0 -z-10 w-1 bg-gradient-to-b from-[#ffd98a] to-[#c8921e] opacity-80 transition-opacity duration-300 group-hover:opacity-100" />
          <span class="pointer-events-none absolute -top-14 -right-14 -z-10 h-32 w-32 rounded-full bg-[#8d2b09]/45 blur-[50px] transition-all duration-300 group-hover:bg-[#ffa347]/45" />

          <div class="flex items-center justify-between gap-3">
            <span class="inline-flex items-center gap-1.5 rounded-full border border-[#ff7a18]/25 bg-[#160604] px-3 py-1 text-[10px] font-bold tracking-widest text-[#ff7a18] uppercase">
              <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#ffa347]" />
              {review.tag}
            </span>
            <span class="flex gap-0.5 text-sm">
              <span aria-hidden="true" class="flex gap-0.5">
                {Array.from({ length: 5 }).map((_, i) => (
                  <span class={i < review.stars ? "text-[#ff7a18]" : "text-[#4a2311]"}>★</span>
                ))}
              </span>
              <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
            </span>
          </div>

          <p class="text-left text-base leading-relaxed text-[#f7e6d4]">{review.content}</p>

          <div class="mt-auto flex items-center gap-3 border-t border-[#4a2311] pt-4">
            <span
              aria-hidden="true"
              class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#ff7a18]/30 bg-gradient-to-br from-[#ffa347] via-[#ff7a18] to-[#8d2b09] text-xl shadow-inner transition-transform duration-300 group-hover:scale-110">
              {review.avatar}
            </span>
            <span class="flex flex-col">
              <span class="text-sm font-black text-[#f7e6d4] transition-colors group-hover:text-[#ffd98a]">{review.name}</span>
              <span class="text-[10px] font-bold tracking-wider text-[#c9ac91] uppercase">{review.role}</span>
            </span>
          </div>
        </article>
      ))
    }
  </div>
</section>
