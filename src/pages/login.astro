---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";
import CtaRedirect from "../components/CtaRedirect.astro";
import { pageGraph } from "../lib/schema";

const pageDescription = "หน้าเข้าสู่ระบบ BUNNY555 สล็อตเว็บตรง มีปุ่มเดียวสำหรับเข้าบัญชีเดิม เพื่อเลือกเกมค่าย PG Slot และ JILI เช็กเครดิต ดูโบนัส จัดการฝากถอน True Wallet ผ่านมือถือ";

const graph = pageGraph(Astro, {
  name: "เข้าสู่ระบบ BUNNY555 สล็อตเว็บตรง",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เข้าสู่ระบบ", path: "/login" },
  ],
});

const targetUrl = "https://yoalink.com/22hs";
---

<MainLayout title="เข้าสู่ระบบ BUNNY555 | ปุ่มล็อกอินเข้าเล่นสล็อตเว็บตรง PG Slot JILI" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="เข้าสู่ระบบ BUNNY555" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label="เข้าสู่ระบบ BUNNY555"
        class="group relative mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#be185d]/50 bg-[#ec4899] px-6 py-4 text-xl font-bold tracking-wide text-white shadow-[0_10px_30px_rgba(190,24,93,0.20)] transition-all duration-300 hover:scale-105 hover:border-[#f7c948] hover:bg-[#be185d] hover:shadow-[0_15px_40px_rgba(236,72,153,0.20)]">
        เข้าสู่ระบบ BUNNY555
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="เข้าสู่ระบบ" />
</MainLayout>
