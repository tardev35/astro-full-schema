          </div>
        </div>
      </div>
    </div>

    <div slot="right" class="h-full">
      <div class="flex h-full flex-col rounded-2xl border border-cyan-500/30 bg-gradient-to-br from-cyan-900/40 to-black/60 p-5 backdrop-blur-md">
        <div class="mb-5 flex items-center justify-between">
