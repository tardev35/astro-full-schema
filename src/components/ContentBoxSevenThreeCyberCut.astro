---
export interface Props {
  titleleft?: string;
  titleright?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { titleleft, titleright, as: HeadingTag = "h2" } = Astro.props;
---

<section class="mx-auto mb-6 w-full max-w-7xl px-4 font-sans">
  <div
    class="relative isolate w-full border border-[#2fe35f]/30 bg-[#0a1a10]/92 p-8 text-[#ddf3e2] shadow-[0_10px_30px_rgba(47,227,95,0.18)] backdrop-blur-md transition-all duration-300 hover:border-[#2fe35f]/55 hover:shadow-[0_15px_40px_rgba(47,227,95,0.28)]"
    style="clip-path: polygon(30px 0, 100% 0, 100% calc(100% - 30px), calc(100% - 30px) 100%, 0 100%, 0 30px);">
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-[2px] w-24 bg-gradient-to-r from-[#2fe35f] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-[2px] w-24 bg-gradient-to-l from-[#f0c43a] to-transparent"></div>
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-16 w-[2px] bg-gradient-to-b from-[#2fe35f] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-16 w-[2px] bg-gradient-to-t from-[#f0c43a] to-transparent"></div>

    <div class="grid grid-cols-1 gap-8 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#ddf3e2]">
        {
          titleleft && (
            <div class="flex items-baseline gap-2 border-b border-[#0b6b34]/60 pb-2">
              <span aria-hidden="true" class="font-mono text-[#f0c43a]">
                &gt;_
              </span>
              <HeadingTag class="text-xl leading-normal font-black text-[#7bff9f] uppercase">{titleleft}</HeadingTag>
            </div>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#ddf3e2] md:border-l md:border-[#0b6b34]/60 md:pl-8">
        {
          titleright && (
            <div class="flex items-baseline gap-2 border-b border-[#0b6b34]/60 pb-2">
              <span aria-hidden="true" class="font-mono text-[#f0c43a]">
                &gt;_
              </span>
              <HeadingTag class="text-xl leading-normal font-black text-[#7bff9f] uppercase">{titleright}</HeadingTag>
            </div>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
