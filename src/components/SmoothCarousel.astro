---
import { Picture } from "astro:assets";

import slide1 from "../assets/slide1.png";
import slide2 from "../assets/slide2.png";
import slide3 from "../assets/slide3.png";

const images = [
  {
    src: slide1,
    alt: "ภาพโปรโมชั่น ANDAMAN168 พื้นทะเลอันดามันสีฟ้ามีใบมะพร้าวและเหรียญทองลอยอยู่รอบภาพ ด้านบนเป็นโลโก้ ANDAMAN168 ตัวอักษรฟ้าวางบนดวงอาทิตย์ทอง ใต้ลงมาเป็นป้ายว่า ทางเข้าหลัก ตามด้วยข้อความ ฝากแรกของวัน และตัวเลขทองขนาดใหญ่ว่า 20% ถัดลงมาเป็นแถบ บาคาร่า สล็อต ฟุตบอล และสองกรอบข้อความว่า ระบบออโต้ 24 ชม. กับ เล่นผ่านมือถือ ฝากถอนอัตโนมัติ ด้านซ้ายเป็นพรีเซนเตอร์หญิงชุดทองถือไพ่โพแดง ล้อมด้วยกองเหรียญทอง ลูกเต๋า และวงล้อรูเล็ต ด้านล่างเป็นปุ่มทองเขียนว่า เข้าเล่นเลย พร้อมแถวไอคอนค่ายเกม",
  },
  {
    src: slide2,
    alt: "ภาพโปรโมชั่น ANDAMAN168 พื้นทะเลอันดามันสีฟ้ามีเกาะหินและใบมะพร้าว มุมบนซ้ายเป็นโลโก้ ANDAMAN168 ตัวอักษรฟ้าวางบนดวงอาทิตย์ทอง ถัดลงมาเป็นตัวอักษรขนาดใหญ่ว่า ANDAMAN168 ตามด้วยบรรทัด บาคาร่า สล็อต ฟุตบอล และสองแถบข้อความว่า ระบบออโต้ 24 ชม. กับ สมัครสมาชิก ฝากถอนผ่านมือถือ ด้านล่างซ้ายเป็นวงล้อลุ้นรางวัลใหญ่ที่มีช่องรางวัลเงินสด ทองคำหนัก 1 บาท iPhone 15 Pro Max สร้อยคอทองคำ และอั่งเปาโบนัส ถัดมาเป็นภาพโทรศัพท์ สร้อยคอทองคำ และทองแท่ง ด้านขวาเป็นพรีเซนเตอร์หญิงชุดสีน้ำเงินยืนคู่กับไพ่โพดำ พร้อมป้ายว่า ทางเข้าหลัก เล่นง่าย แถบล่างสุดเขียนว่า รวมเกมครบในบัญชีเดียว มั่นคง ปลอดภัย ระบบเสถียร ไม่สะดุด และ บริการรวดเร็ว มืออาชีพ",
  },
  {
    src: slide3,
    alt: "ภาพโปรโมชั่น ANDAMAN168 พื้นทะเลสีฟ้ามีเกาะและใบมะพร้าว มุมบนซ้ายเป็นโลโก้ ANDAMAN168 ตัวอักษรฟ้าวางบนดวงอาทิตย์ทอง ตรงกลางเป็นตัวอักษรทองขนาดใหญ่ว่า คืนยอดเสีย 10% ใต้ลงมาเป็นบรรทัด แนะนำเพื่อน รับค่าคอม 1% ตามด้วยสองแถบข้อความว่า ANDAMAN168 ทางเข้าหลัก ระบบออโต้ 24 ชม. และ บาคาร่า สล็อต ฟุตบอล เล่นผ่านมือถือ ด้านหลังเป็นวงล้อรูเล็ต ด้านหน้าเป็นพรีเซนเตอร์หญิงชุดทองยืนคู่กับกองเหรียญทอง ลูกเต๋า ไพ่ และชิปคาสิโน VIP",
  },
];

const COPIES = 3;
const slides = Array.from({ length: COPIES }, () => images).flat();
---

<div class="marquee mx-auto w-full max-w-7xl overflow-hidden px-4 py-5">
  <input id="carousel-pause" type="checkbox" class="peer sr-only" />
  <label
    for="carousel-pause"
    class="sr-only cursor-pointer peer-focus-visible:not-sr-only peer-focus-visible:mb-3 peer-focus-visible:inline-block peer-focus-visible:rounded-full peer-focus-visible:border peer-focus-visible:border-[#fdb524]/60 peer-focus-visible:px-4 peer-focus-visible:py-2 peer-focus-visible:text-sm peer-focus-visible:font-bold peer-focus-visible:text-[#ffe999]">
    หยุด / เล่นสไลด์ภาพ
  </label>

  <div class="marquee-track flex">
    {
      slides.map((slide, index) => {
        const isDuplicate = index >= images.length;
        return (
          <div class="marquee-slide" aria-hidden={isDuplicate ? "true" : undefined}>
            <Picture
              src={slide.src}
              alt={isDuplicate ? "" : slide.alt}
              class="block w-full rounded-xl border border-[#21d4f2]/40 object-cover shadow-[0_10px_30px_rgba(33,212,242,0.30)]"
              width={slide.src.width}
              height={slide.src.height}
              loading="lazy"
              fetchpriority="low"
              decoding="async"
              widths={[300, 360, 420, 480, 540, 600]}
              sizes="(max-width: 767px) calc(100vw - 32px), (max-width: 1279px) calc((100vw - 48px) / 2), 403px"
              formats={["avif", "webp"]}
              fallbackFormat="webp"
              quality={60}
            />
          </div>
        );
      })
    }
  </div>
</div>

<style>
  .marquee {
    --gap: 12px;
    --per-view: 1;
    --shift: calc(-300% - 36px);
  }

  @media (min-width: 768px) {
    .marquee {
      --gap: 16px;
      --per-view: 2;
      --shift: calc(-150% - 24px);
    }
  }

  @media (min-width: 1280px) {
    .marquee {
      --gap: 20px;
      --per-view: 3;
      --shift: calc(-100% - 20px);
    }
  }

  .marquee-track {
    gap: var(--gap);
    width: 100%;
    animation: carousel-scroll 24s linear infinite;
    will-change: transform;
  }

  .marquee-slide {
    flex: 0 0 calc((100% - (var(--per-view) - 1) * var(--gap)) / var(--per-view));
  }

  @keyframes carousel-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(var(--shift));
    }
  }

  .marquee:hover .marquee-track,
  .marquee:focus-within .marquee-track,
  .marquee > input:checked ~ .marquee-track {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
    }
  }
</style>
