---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
  label?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright, label } = Astro.props;

const sectionLabel = label ?? title ?? titleleft ?? titleright ?? "ข้อมูลประกอบ";
---

<section aria-label={sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#fdc700]/40 bg-[#1c0a30]/92 p-8 text-[#ede4fb] shadow-[0_10px_30px_rgba(253,199,0,0.14)] backdrop-blur-xl transition-all duration-500 hover:border-[#fdc700]/75 md:p-10">
    {
      title && (
        <header class="mb-6 flex items-center gap-4 border-b border-[#fdc700]/25 pb-4">
          <span aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffe680] to-[#a855f7] shadow-[0_0_10px_rgba(253,199,0,0.45)]" />
          <HeadingTag class="bg-gradient-to-r from-[#ffe680] via-[#fdc700] to-[#d99400] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#ede4fb]">
        {
          titleleft && (
            <p class="flex items-center gap-3 border-b border-[#fdc700]/25 pb-3 text-xl leading-normal font-black tracking-widest text-[#ffe680] uppercase">
              <span
                aria-hidden="true"
                class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#ffe680]/60 bg-gradient-to-br from-[#ffe680] via-[#fdc700] to-[#a86f00] text-sm text-[#150726] shadow-[0_5px_15px_rgba(253,199,0,0.28)]">
                🔐
              </span>
              {titleleft}
            </p>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#ede4fb]">
        {
          titleright && (
            <p class="flex items-center gap-3 border-b border-[#fdc700]/25 pb-3 text-xl leading-normal font-black tracking-widest text-[#ffe680] uppercase">
              <span
                aria-hidden="true"
                class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#c98bff]/50 bg-gradient-to-br from-[#a855f7] via-[#8b6fb8] to-[#6d28d9] text-sm text-[#150726] shadow-[0_5px_15px_rgba(168,85,247,0.32)]">
                📊
              </span>
              {titleright}
            </p>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
