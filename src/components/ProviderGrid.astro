---
const providers = [
  { name: "PG Soft", desc: "เกมลิขสิทธิ์แท้จากผู้พัฒนาโดยตรง ค่า RTP ตรงตามค่าย ไม่มีปรับแต้ม ไม่มีปรับเรท", tag: "ลิขสิทธิ์แท้", icon: "🎰" },
  { name: "Joker", desc: "ค่ายเกมหมุนคลาสสิกที่คนไทยคุ้นมือ เข้าเล่นต่อจากยูสเดิมได้ทุกเวลา", tag: "ลิขสิทธิ์แท้", icon: "🃏" },
  { name: "Pragmatic Play", desc: "ค่ายใหญ่ระดับอินเตอร์ เกมทำงานตามค่าที่ค่ายตั้งไว้ ไม่มีเซตยูสลับหลังบ้าน", tag: "ลิขสิทธิ์แท้", icon: "🎲" },
  { name: "JILI", desc: "เกมฟีเจอร์แน่นจากค่ายที่มาแรง มี bonus time แทบทุกช่วงเวลา เข้าเล่นตอนไหนก็ลื่นไหล", tag: "ลิขสิทธิ์แท้", icon: "🍀" },
  { name: "ฝากถอนออโต้", desc: "ฝากปุ๊บเข้าปั๊บ ถอนปุ๊บยอดขึ้นปั๊บ ไม่มีคนกลาง ไม่มีพักระบบ ส่งรายการเองได้จากหน้าสมาชิก", tag: "ระบบออโต้", icon: "⚡" },
  { name: "pig auto wallet", desc: "รองรับ True Wallet เต็มระบบ สมัครได้โดยไม่ต้องผูกบัญชีธนาคาร โอนไวเท่ากันทั้งสองแบบ", tag: "ช่องทางเงิน", icon: "👛" },
  { name: "ไม่มีขั้นต่ำ", desc: "อยากฝากเท่าไหร่ก็ฝากได้ อยากถอนเท่าไหร่ก็ถอนได้ ไม่มีเงื่อนไขบังคับยอดซ่อนไว้", tag: "กฎของเว็บ", icon: "🐷" },
];
---

<section aria-label="ค่ายเกมลิขสิทธิ์แท้และระบบออโต้ที่ PIGAUTO รวมไว้ในยูสเดียว" class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#f87171] via-[#fff5e6] to-[#f5c542] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      ค่ายเกมลิขสิทธิ์แท้และระบบออโต้ที่ <span class="text-[#ef4444]">PIGAUTO</span> รวมไว้ในยูสเดียว
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#ef4444] to-transparent"></div>
  </div>

  <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4 lg:gap-5 xl:grid-cols-7">
    {
      providers.map((provider) => (
        <a
          href="/register"
          class="group relative flex flex-col items-center justify-center overflow-hidden rounded-2xl border border-[#7f1d1d] bg-[#280707] p-5 shadow-[0_10px_30px_rgba(239,68,68,0.14)] transition-all duration-300 hover:-translate-y-2 hover:border-[#ef4444]/60 hover:bg-[#3a0d0d] hover:shadow-[0_15px_40px_rgba(239,68,68,0.28)]">
          <div class="pointer-events-none absolute inset-0 bg-[#ef4444]/8 opacity-0 transition-opacity duration-300 group-hover:opacity-100" />

          <div class="absolute top-2 right-2 z-10 rounded-full bg-gradient-to-r from-[#fbbccc] via-[#ef8fae] to-[#b91c1c] px-2 py-0.5 text-[9px] font-black tracking-wide whitespace-nowrap text-[#280707] shadow-sm transition-transform duration-300 group-hover:scale-110">
            {provider.tag}
          </div>

          <div aria-hidden="true" class="mb-3 text-4xl transition-transform duration-300 group-hover:scale-125 group-hover:rotate-3">
            {provider.icon}
          </div>
          <p class="text-center text-sm font-black text-[#fff5e6] transition-colors group-hover:text-[#d9b7ab]">{provider.name}</p>
          <p class="mt-1 text-center text-[10px] text-[#b08b80]">{provider.desc}</p>

          <span class="relative z-10 mt-4 block w-full rounded-full border border-[#7f1d1d] bg-[#1a0303] py-1.5 text-center text-[11px] font-bold text-[#d9b7ab] shadow-inner transition-colors duration-300 group-hover:border-[#ef4444]/60 group-hover:bg-gradient-to-r group-hover:from-[#f87171] group-hover:via-[#ef4444] group-hover:to-[#7f1d1d] group-hover:text-[#fff5e6]">
            สมัครเข้าเล่น
          </span>
        </a>
      ))
    }
  </div>
</section>
