---
import { Picture } from "astro:assets";
import img1 from "../assets/providers/game1.avif";
import img2 from "../assets/providers/game2.avif";
import img3 from "../assets/providers/game3.avif";
import img4 from "../assets/providers/game4.avif";
import img5 from "../assets/providers/game5.avif";
import img6 from "../assets/providers/game6.avif";

const games = [
  { rank: 1, name: "สล็อต PG SOFT กราฟิก 3D", type: "ภาพวิจิตรบรรจง เชื่อมตรงจากค่ายแม่แบบลิขสิทธิ์แท้", menus: ["ยอดนิยม", "เล่นล่าสุด"], players: 5124, img: img6 },
  { rank: 2, name: "สล็อตโรม่า Joker Gaming", type: "ตำนานคลาสสิกที่เล่นง่าย ไม่ซับซ้อน แต่ผลตอบแทนหอมหวาน", menus: ["ยอดนิยม", "รายการโปรด"], players: 3842, img: img2 },
  { rank: 3, name: "สล็อต Pragmatic Play ฟีเจอร์เด็ด", type: "ลูกเล่นแพรวพราว ลุ้นระทึกตลอดเวลา จ่ายหนักไม่มีกั๊ก", menus: ["ยอดนิยม", "รายการโปรด"], players: 3517, img: img3 },
  { rank: 4, name: "สล็อตสายซื้อฟรีสปิน", type: "กดเข้าโบนัสได้เลย ไม่ต้องนั่งเฝ้าจังหวะให้เมื่อยนิ้ว", menus: ["เกมใหม่", "เล่นล่าสุด"], players: 2905, img: img4 },
  { rank: 5, name: "สล็อตคลาสสิกรอบสั้น", type: "จบไวเข้าใจง่าย เหมาะกับบรรยากาศที่ไม่เร่ง ไม่กดดัน", menus: ["เกมใหม่", "รายการโปรด"], players: 2431, img: img1 },
  { rank: 6, name: "สล็อตเกมใหม่สำหรับมือถือ", type: "เมนูภาษาไทยชัดเจน รองรับทั้ง iOS และ Android", menus: ["เกมใหม่", "เล่นล่าสุด"], players: 2108, img: img5 },
];

const medal = (rank: number) => (rank === 1 ? "🥇" : rank === 2 ? "🥈" : rank === 3 ? "🥉" : null);
---

<section aria-label="หมวดสล็อตยอดนิยมของ YIMSIAM889" class="mx-auto w-full max-w-[1300px] px-4 py-8 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <span aria-hidden="true" class="text-2xl">🏆</span>
    <p class="bg-gradient-to-r from-[#f8dc9a] via-[#e9b949] to-[#a81f1a] bg-clip-text text-2xl font-black tracking-widest text-transparent uppercase">
      หมวดสล็อตยอดนิยมของ YIMSIAM889 ที่พี่น้องชาวไทยหมุนกันมากที่สุด
    </p>
    <p class="max-w-3xl text-base leading-relaxed text-[#f2ddc4]/75">
      ทุกเกมที่ YIMSIAM889 เชื่อมต่อสัญญาณตรงจากค่ายแม่เหมือนกันหมดขอรับ อัตราการชนะจึงเป็นไปตามค่า RTP มาตรฐานสากล ไม่มีใครมาแอบปรับหลังบ้าน
      ลำดับความนิยมในตารางนี้ขยับตามคนที่เข้ามาหมุนในแต่ละช่วง ไม่ได้แปลว่าเกมไหนแตกดีกว่าเกมไหน วัดกันที่ดวงและฝีมือล้วนๆ เหมือนกันทุกเกม
    </p>
    <div class="mt-2 h-[3px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#e9b949] to-transparent"></div>
  </div>

  <div class="flex flex-col gap-3">
    {
      games.map((g) => {
        const top = g.rank === 1;
        return (
          <article
            class={`group relative flex items-center gap-3 overflow-hidden rounded-2xl border p-3 backdrop-blur-md transition-all duration-300 hover:-translate-y-0.5 sm:gap-5 sm:p-4 ${
              top
                ? "border-[#e9b949]/50 bg-gradient-to-r from-[#2e130c]/95 via-[#1e0a06]/92 to-[#1e0a06]/92 shadow-[0_15px_40px_rgba(233,185,73,0.3)]"
                : "border-[#e9b949]/25 bg-[#1e0a06]/92 shadow-[0_10px_30px_rgba(168,31,26,0.22)] hover:border-[#e9b949]/50 hover:shadow-[0_15px_40px_rgba(233,185,73,0.3)]"
            }`}>
            <div class="pointer-events-none absolute top-1/2 -left-10 h-24 w-24 -translate-y-1/2 rounded-full bg-[#a81f1a]/30 blur-[40px] transition-all duration-500 group-hover:bg-[#e9b949]/25" />

            <div class="relative z-10 flex w-8 shrink-0 flex-col items-center justify-center sm:w-12">
              {medal(g.rank) ? (
                <span class="text-2xl sm:text-3xl">
                  <span aria-hidden="true">{medal(g.rank)}</span>
                  <span class="sr-only">อันดับ {g.rank}</span>
                </span>
              ) : (
                <span class="text-xl font-black text-[#9c724a] sm:text-2xl">#{g.rank}</span>
              )}
            </div>

            <div class={`relative z-10 h-14 w-14 shrink-0 overflow-hidden rounded-xl border sm:h-16 sm:w-16 ${top ? "border-[#e9b949]/50" : "border-[#e9b949]/25"}`}>
              <Picture
                src={g.img}
                alt={`ภาพหน้าปกเกมสล็อตในหมวด ${g.name} บนกระดานหมวดสล็อตยอดนิยมของ YIMSIAM889`}
                formats={["avif", "webp"]}
                fallbackFormat="webp"
                loading="lazy"
                fetchpriority="low"
                widths={[100, 200]}
                sizes="(max-width: 640px) 56px, 64px"
                decoding="async"
                class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-110"
              />
            </div>

            <div class="relative z-10 min-w-0 flex-1">
              <div class="flex items-center gap-2">
                <p class="truncate text-base font-black text-[#f2ddc4] sm:text-lg">{g.name}</p>
                {top && (
                  <span class="hidden shrink-0 rounded-full border border-[#9c724a]/60 bg-[#140604] px-2 py-0.5 text-[9px] font-black tracking-wider text-[#f8dc9a] sm:inline">ยอดนิยมสูงสุด</span>
                )}
              </div>
              <p class="truncate text-[11px] text-[#f2ddc4]/70 sm:text-xs">{g.type}</p>

              <div class="mt-2 flex flex-wrap items-center gap-1.5">
                {g.menus.map((m) => (
                  <span class="rounded-full border border-[#e9b949]/25 bg-[#140604] px-2.5 py-0.5 text-[10px] font-bold text-[#e9b949]">{m}</span>
                ))}
              </div>
            </div>

            <div class="relative z-10 hidden shrink-0 flex-col items-end gap-1 sm:flex">
              <span class="flex items-center gap-1.5 text-[11px] text-[#f2ddc4]/70">
                <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-green-500 shadow-[0_0_6px_rgba(34,197,94,0.6)]" />
                <span class="tabular-nums" data-players data-base={g.players}>
                  {g.players.toLocaleString("en-US")}
                </span>{" "}
                ออนไลน์
              </span>
              <a
                href="/register"
                class={`rounded-full px-4 py-1.5 text-xs font-black transition-transform hover:scale-105 ${
                  top
                    ? "bg-gradient-to-r from-[#f8dc9a] via-[#e9b949] to-[#9c724a] text-[#140604] shadow-[0_10px_30px_rgba(233,185,73,0.26)]"
                    : "border border-[#e9b949]/60 bg-[#140604] text-[#e9b949] hover:border-[#e9b949] hover:bg-[#2e130c]"
                }`}>
                เข้าดูเกม
              </a>
            </div>
          </article>
        );
      })
    }
  </div>
</section>

<script>
  import { startLiveCounters } from "../lib/liveCounter";

  startLiveCounters();
</script>
