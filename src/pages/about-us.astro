---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";
import { pageGraph } from "../lib/schema";

const pageTitle = "เกี่ยวกับ WINDRAGON เว็บสล็อตออนไลน์ที่เล่นจบในมือถือ ฝากถอนออโต้ จ่ายเต็มยอด";

const pageHeading = "เกี่ยวกับ WINDRAGON เว็บสล็อตออนไลน์ที่เล่นจบในมือถือ ฝากถอนออโต้ ยอดบวกจ่ายเต็ม";

const pageDescription =
  "รู้จัก WINDRAGON เว็บสล็อตออนไลน์ที่เปิดเล่นจากมือถือได้ครบ ฝากถอนออโต้ไม่ต้องส่งสลิป ยอดบวกโอนเต็มจำนวนไม่หักเปอร์เซ็นต์ มีโปรเสริมทุนและช่องทางติดต่อทีมงาน";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});

const linkClass = "font-bold text-[#ff9a4d] underline underline-offset-4 transition-colors hover:text-[#ffd77a]";
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox as="h1" title={pageHeading}>
    <p class="mb-4 text-left text-base leading-relaxed">
      <strong class="text-[#ff9a4d]">WINDRAGON</strong> คือเว็บสล็อตออนไลน์ที่ให้น้ำหนักกับเกมสล็อตเป็นหลัก ล็อบบี้รวมค่ายเด่นสายแตกโหดไว้ให้เลือกตามทุน และทุกขั้นตั้งแต่ทางเข้าจนถึงหน้าถอนเปิดจากสมาร์ทโฟนได้ครบ
    </p>

    <p class="mb-4 text-left text-base leading-relaxed">
      สิ่งที่ WINDRAGON ยึดเป็นหลักมีสามเรื่อง คือเล่นจบได้ในมือถือเครื่องเดียว ฝากถอนออโต้ที่ไม่ต้องส่งสลิป และยอดบวกที่โอนเต็มจำนวนโดยไม่หักเปอร์เซ็นต์ ส่วนโปรโมชั่นมีไว้เสริมทุนเวลาอยากเล่นต่อ
    </p>

    <p class="mb-4 text-left text-base leading-relaxed">
      บนโลโก้มีคำว่า WE WIN TOGETHER ความหมายที่จับต้องได้ของคำนี้ไม่ใช่คำสัญญาว่าจะชนะทุกรอบ แต่คือยอดที่ผู้เล่นได้มาจากเกมต้องกลับถึงมือครบทุกบาท
    </p>

    <p class="text-left text-base leading-relaxed">ชื่อเว็บจะดุแค่ไหนก็ได้ สิ่งที่ผู้เล่นจำได้จริงคือวันที่กดถอนแล้วเงินเข้าบัญชีครบโดยไม่ต้องทักถามใคร</p>
  </ContentBox>

  <ContentBox as="h2" title="สล็อตมาก่อนทุกอย่าง WINDRAGON รวมค่ายเด่นสายแตกโหดไว้ในล็อบบี้เดียว">
    <p class="mb-4 text-left text-base leading-relaxed">
      WINDRAGON ไม่ได้พยายามเป็นเว็บที่มีทุกอย่าง ล็อบบี้จัดให้สล็อตอยู่หน้าสุด รวมค่ายเด่นสายแตกโหดที่อาจเงียบไปสักพัก แต่พอเข้าฟรีสปินแล้วตัวคูณพายอดขึ้นได้แรงกว่าเกมจ่ายถี่
    </p>

    <p class="mb-4 text-left text-base leading-relaxed">
      แต่ละเกมมีช่วงเบท ฟีเจอร์ และจังหวะจ่ายไม่เหมือนกัน ถ้าอยากเห็นหน้าเกมก่อนลงเครดิต เริ่มที่หน้า <a href="/ทดลองเล่น/" class={linkClass}>ทดลองเล่น</a> แล้วค่อยเลือกเกมที่เข้ากับทุนของตัวเอง
    </p>

    <p class="mb-4 text-left text-base leading-relaxed">
      วิธีเลือกที่สายปั่นใช้กันคือหยิบเกมที่คุ้นมาสองสามเกม ดูช่วงเบทกับฟีเจอร์ก่อน แล้วเริ่มจากเบทต่ำเพื่อจับจังหวะ พอทุนพร้อมค่อยขยับขึ้นทีละขั้น
    </p>

    <p class="text-left text-base leading-relaxed">เกมแตกโหดไม่ได้แปลว่าแตกบ่อย รู้ข้อนี้ตั้งแต่ก่อนสปินแรก ทุนก็อยู่ได้นานกว่าที่คิด</p>
  </ContentBox>

  <ContentBox as="h2" title="เล่นจบในมือถือเครื่องเดียว ตั้งแต่ทางเข้า WINDRAGON จนถึงหน้าถอน">
    <p class="mb-4 text-left text-base leading-relaxed">
      สมาชิกใหม่เริ่มที่หน้า <a href="/register/" class={linkClass}>สมัครสมาชิก</a> ส่วนสมาชิกเดิมใช้บัญชีเดิม <a href="/login/" class={linkClass}>เข้าสู่ระบบ</a> ได้ทันทีแม้จะเปลี่ยนเครื่อง ไม่ต้องสมัครใหม่เพียงเพราะเปลี่ยนมือถือ
    </p>

    <p class="mb-4 text-left text-base leading-relaxed">
      ล็อกอิน ฝากเงิน เลือกค่าย ปั่น ไปจนถึงกดถอน ทำจากสมาร์ทโฟนได้ทั้งหมด ใครเข้าเล่นบ่อยลองบุ๊กมาร์กทางเข้าไว้ในเบราว์เซอร์ จะเปิดกลับมาได้ในแตะเดียว
    </p>

    <p class="mb-4 text-left text-base leading-relaxed">
      ก่อนใส่รหัสผ่านทุกครั้งให้เช็กชื่อเว็บบนแถบที่อยู่ว่าสะกดตรงตัว และอย่าส่งรหัสผ่านหรือรหัส OTP ให้ใคร ทีมงานตัวจริงไม่มีเหตุให้ต้องขอสองอย่างนี้
    </p>

    <p class="text-left text-base leading-relaxed">URL ที่สะกดถูกเป็นด่านแรก รหัสที่เก็บไว้กับตัวเป็นด่านสุดท้าย ผ่านสองด่านนี้ได้ ปัญหาเรื่องบัญชีส่วนใหญ่ก็ไม่เกิดตั้งแต่ต้น</p>
  </ContentBox>

  <ContentBox as="h2" title="ฝากถอนออโต้ของ WINDRAGON ทำรายการเอง ไม่ต้องส่งสลิป ไม่ต้องรอแอดมิน">
    <p class="mb-4 text-left text-base leading-relaxed">
      ระบบการเงินของ WINDRAGON เป็นออโต้ทั้งขาเข้าและขาออก ผู้เล่นกดทำรายการเองในมือถือ ระบบตรวจยอดแล้วปรับเครดิตให้ในไม่กี่วินาที ไม่ต้องแนบหลักฐานหรือทักใครช่วยดัน
    </p>

    <p class="mb-4 text-left text-base leading-relaxed">
      ถ้ารอเกินไม่กี่วินาทีแล้วเครดิตยังไม่ขึ้น อย่าเพิ่งโอนซ้ำ จดเวลาที่โอนกับยอดเงินไว้แล้วแจ้งทีมงาน ขั้นตอนทั้งฝากและถอนอยู่ที่หน้า <a href="/วิธีฝากถอน/" class={linkClass}>วิธีฝากถอน</a>
    </p>

    <p class="mb-4 text-left text-base leading-relaxed">
      ฝั่งถอนก็แค่ใส่ยอดแล้วยืนยัน จุดเดียวที่ต้องดูคือใช้บัญชีที่ชื่อตรงกับตอนสมัคร รายการจะได้ไม่สะดุดและไม่ต้องรอใครอนุมัติ
    </p>

    <p class="text-left text-base leading-relaxed">โอนซ้ำเพราะใจร้อนหนึ่งครั้ง อาจต้องตามเงินสองก้อนทีหลัง รอให้ระบบตรวจยอดก่อนเสียเวลาน้อยกว่าเสมอ</p>
  </ContentBox>

  <ContentBox as="h2" title="ยอดบวกโอนเต็มจำนวน และโปรที่มีไว้เสริมทุนให้ลุ้นได้นานขึ้น">
    <p class="mb-4 text-left text-base leading-relaxed">
      คำถามที่สายปั่นถามก่อนสมัครแทบทุกเว็บคือ ถ้าแตกก้อนใหญ่จะได้ครบไหม ที่ WINDRAGON ตัวเลขที่เห็นตอนกดถอนคือยอดที่เข้าบัญชีจริง ไม่มีการหักเปอร์เซ็นต์ตอนเงินออก
    </p>

    <p class="mb-4 text-left text-base leading-relaxed">
      ส่วนโปรโมชั่นมีไว้เติมเครดิตให้มีรอบปั่นมากขึ้น แต่ละรายการมีเงื่อนไขของตัวเอง ทั้งเกมที่ใช้ได้ ยอดเล่นก่อนถอน และวันหมดเขต รายละเอียดอยู่ที่หน้า <a href="/promotion/" class={linkClass}>โปรโมชั่น</a>
    </p>

    <p class="text-left text-base leading-relaxed">โปรช่วยให้เล่นได้นานขึ้น แต่ไม่ได้ทำให้เกมจ่ายดีขึ้น รู้ข้อนี้ก่อนกดรับ จะเลือกโปรได้ตรงกับงบมากกว่าเดิม</p>
  </ContentBox>

  <ContentBox as="h2" title="ช่องทางติดต่อทีมงาน WINDRAGON">
    <p class="mb-4 text-left text-base leading-relaxed">
      มีข้อสงสัยเรื่องสมัครสมาชิก เข้าสู่ระบบ หรือรายการฝากถอน ติดต่อทีมงานได้ทาง <a href="/line/" class={linkClass}>LINE Official</a> หรือดูช่องทางทั้งหมดที่หน้า <a href="/contact-us/" class={linkClass}>ติดต่อเรา</a>
    </p>

    <p class="mb-4 text-left text-base leading-relaxed">
      แจ้งปัญหาพร้อมเวลาที่ทำรายการและยอดเงินจะช่วยให้ตรวจได้เร็วขึ้น และใช้เฉพาะช่องทางที่ประกาศไว้บนเว็บ WINDRAGON เพราะช่องทางปลอมมักเริ่มจากการขอข้อมูลที่ทีมงานจริงไม่ถาม
    </p>

    <p class="text-left text-base leading-relaxed">ถามก่อนทำหนึ่งครั้ง ประหยัดเวลาตามแก้ทีหลังหลายรอบ ทีมงานช่วยตรวจรายการได้ แต่ดึงเงินที่โอนผิดบัญชีไปแล้วกลับมาไม่ได้</p>
  </ContentBox>

  <Navfoot />
</MainLayout>
