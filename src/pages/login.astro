---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";
import CtaRedirect from "../components/CtaRedirect.astro";
import { pageGraph } from "../lib/schema";

const pageTitle = "เข้าสู่ระบบ GGHENG | ปุ่มล็อกอินเข้าหน้าสมาชิก สล็อตเว็บตรงสายเฮง";

const pageDescription =
  "หากคุณกำลังมองหาทางกลับเข้าหน้าสมาชิกโดยไม่ต้องค้นหาลิงก์ GGHENG พร้อมมอบปุ่มเข้าสู่ระบบเพียงปุ่มเดียว เพื่อกลับไปเล่นสล็อตเว็บตรงต่อด้วยยูสเดิมได้ทันที";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เข้าสู่ระบบ", path: "/login" },
  ],
});

const targetUrl = "https://yoalink.com/32c3";
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="เข้าสู่ระบบ GGHENG" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label="เข้าสู่ระบบ GGHENG"
        class="group relative mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#5a0a0a]/70 bg-gradient-to-b from-[#ff5a4a] via-[#e11d1d] to-[#a31212] px-6 py-4 text-xl font-bold tracking-wide text-white shadow-[0_10px_30px_rgba(225,29,29,0.26)] transition-all duration-300 hover:scale-105 hover:border-[#ff8a70] hover:shadow-[0_15px_40px_rgba(225,29,29,0.38)]">
        เข้าสู่ระบบ GGHENG
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="เข้าสู่ระบบ" />
</MainLayout>
