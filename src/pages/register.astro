---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import CtaRedirect from "../components/CtaRedirect.astro";
import { pageGraph } from "../lib/schema";

const pageDescription =
  "หากคุณกำลังมองหายูสใหม่ที่เปิดง่ายที่สุด OKHENG ให้สมัครสมาชิกจบในไม่กี่นาทีผ่านมือถือ รับโปรสมาชิกใหม่ เข้าเล่นบาคาร่า คาสิโนสด และสล็อตลิขสิทธิ์ด้วยยูสเดียว";

const graph = pageGraph(Astro, {
  name: "สมัครสมาชิก OKHENG บาคาร่า คาสิโนสด สล็อตลิขสิทธิ์",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "สมัครสมาชิก", path: "/register" },
  ],
});

const targetUrl = "https://yoalink.com/22hs";
---

<MainLayout title="สมัครสมาชิก OKHENG | ปุ่มเปิดยูสใหม่ผ่านมือถือ รับโปรสมาชิกใหม่" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="สมัครสมาชิก OKHENG" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label="สมัครสมาชิก OKHENG"
        class="group relative mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#a8710c]/60 bg-gradient-to-b from-[#ffdb7d] to-[#f0b429] px-6 py-4 text-xl font-bold tracking-wide text-[#170206] shadow-[0_10px_30px_rgba(240,180,41,0.20)] transition-all duration-300 hover:scale-105 hover:border-[#ed0133]/70 hover:shadow-[0_15px_40px_rgba(237,1,51,0.24)]">
        สมัครสมาชิก OKHENG
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="สมัครสมาชิก" />
</MainLayout>
