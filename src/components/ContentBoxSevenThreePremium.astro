---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;
const rightHeading = titleright ?? title;
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#ec4899]/35 bg-gradient-to-br from-[#ffffff]/95 to-[#fff2f7]/92 p-8 text-[#7a1038] shadow-[0_10px_30px_rgba(236,72,153,0.14)] backdrop-blur-xl transition-all duration-500 hover:border-[#ec4899]/65 hover:shadow-[0_15px_40px_rgba(236,72,153,0.20)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-24 -left-24 -z-10 h-48 w-48 rounded-full bg-[#f9a8d4]/40 blur-[60px] transition-all duration-500 group-hover:bg-[#ec4899]/25">
    </div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-24 -bottom-24 -z-10 h-48 w-48 rounded-full bg-[#f7c948]/35 blur-[60px] transition-all duration-500 group-hover:bg-[#f472b6]/30">
    </div>

    <div class="grid grid-cols-1 gap-10 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#7a1038]">
        {
          titleleft && (
            <HeadingTag class="bg-gradient-to-r from-[#ec4899] via-[#9d174d] to-[#be185d] bg-clip-text text-center text-xl leading-normal font-black tracking-widest text-transparent uppercase md:text-left">
              {titleleft}
            </HeadingTag>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#7a1038] md:border-l md:border-[#f9c2d9] md:pl-10">
        {
          rightHeading && (
            <HeadingTag class="mb-2 bg-gradient-to-r from-[#ec4899] via-[#9d174d] to-[#be185d] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">
              {rightHeading}
            </HeadingTag>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
