---
import { Picture } from "astro:assets";

const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.*", { eager: true });
const imagePaths = Object.keys(images);
const targetPath = imagePaths.find((path) => path.endsWith(".webp")) || imagePaths.find((path) => path.endsWith(".png")) || (imagePaths.length > 0 ? imagePaths[0] : null);
const mainLogo = targetPath ? images[targetPath].default : null;

const currentPath = Astro.url.pathname;
const isActive = (path: string) => {
  if (path === "/") return currentPath === "/";
  return currentPath.startsWith(path);
};
---

<header class="sticky top-0 z-[100] w-full font-sans">
  <nav class="relative mx-auto flex h-[80px] w-full items-center justify-between border-b border-green-500/40 bg-[#021c13]/90 px-4 shadow-[0_5px_20px_rgba(0,0,0,0.8)] backdrop-blur-md xl:px-6">
    <a href="/" class="z-[110] flex-shrink-0 transition-transform duration-300 hover:scale-105">
      {
        mainLogo ? (
          <Picture src={mainLogo} alt="LOTTO432 Logo" loading="eager" class="h-[45px] w-auto drop-shadow-[0_0_8px_rgba(34,197,94,0.5)] xl:h-[55px]" formats={["avif", "webp"]} fallbackFormat="webp" />
        ) : (
          <h1 class="text-3xl font-black tracking-widest text-white drop-shadow-md">
            LOTTO<span class="text-green-500">432</span>
          </h1>
        )
      }
    </a>

    <div class="hidden h-full flex-1 items-center justify-center gap-6 lg:flex">
      {
        [
          { name: "หน้าแรก", path: "/" },
          { name: "ตรวจหวย", path: "/ตรวจหวย" },
          { name: "แนวทางหวย", path: "/แนวทาง" },
          { name: "โปรโมชั่น", path: "/promotion" },
          { name: "ติดต่อเรา", path: "/contact-us" },
        ].map((item) => (
          <a
            href={item.path}
            class={`group relative flex h-full items-center px-2 text-sm font-bold tracking-widest transition-colors ${isActive(item.path) ? "text-yellow-400" : "text-white/80 hover:text-white"}`}>
            <span>{item.name}</span>
            <div
              class={`absolute bottom-0 left-0 h-[3px] w-full bg-yellow-400 shadow-[0_-2px_8px_rgba(251,191,36,0.8)] transition-transform duration-300 ${isActive(item.path) ? "scale-x-100" : "scale-x-0 group-hover:scale-x-100"}`}
            />
          </a>
        ))
      }
    </div>

    <div class="z-[110] flex items-center gap-3">
      <a
        href="/login"
        class="hidden rounded-sm bg-gradient-to-b from-yellow-300 to-yellow-600 px-5 py-2 text-sm font-black text-[#021c13] shadow-[0_0_10px_rgba(251,191,36,0.3)] transition-all hover:scale-105 lg:flex">
        เข้าสู่ระบบ
      </a>
      <a href="/register" class="hidden items-center gap-2 rounded-sm border border-gray-400 bg-[#1f2937] px-5 py-2 text-sm font-bold text-white transition-all hover:bg-gray-700 lg:flex">
        <span class="text-xs">👤</span> สมัครสมาชิก
      </a>
      <a href="#" class="hidden items-center gap-1 rounded-sm border border-white bg-white px-3 py-2 text-sm font-bold text-[#021c13] transition-all hover:bg-gray-200 lg:flex">💬 ติดต่อเรา</a>

      <button id="hamburger-btn" class="relative flex h-[45px] w-[45px] flex-col items-center justify-center gap-[6px] rounded-md border border-green-500/50 bg-[#032e1f] lg:hidden" aria-label="Menu">
        <span class="line-1 h-[2px] w-5 origin-center rounded-full bg-white transition-all duration-300"></span>
        <span class="line-2 h-[2px] w-5 origin-center rounded-full bg-white transition-all duration-300"></span>
        <span class="line-3 h-[2px] w-5 origin-center rounded-full bg-white transition-all duration-300"></span>
      </button>
    </div>
  </nav>

  <div
    id="mobile-menu"
    class="pointer-events-none absolute top-[80px] left-0 w-full origin-top -translate-y-4 scale-y-95 flex-col border-b border-green-500/50 bg-[#021c13]/98 px-6 pt-4 pb-8 opacity-0 shadow-2xl backdrop-blur-xl transition-all duration-300 lg:hidden">
    <div class="flex flex-col gap-1">
      {
        [
          { name: "หน้าแรก", path: "/" },
          { name: "ตรวจหวย", path: "/ตรวจหวย" },
          { name: "แนวทางหวย", path: "/แนวทาง" },
          { name: "โปรโมชั่น", path: "/promotion" },
          { name: "ติดต่อเรา", path: "/contact-us" },
        ].map((item) => (
          <a
            href={item.path}
            class={`flex items-center rounded-md px-4 py-3 text-base font-bold transition-colors ${isActive(item.path) ? "border-l-4 border-yellow-400 bg-[#032e1f] text-yellow-400" : "text-white/80 hover:bg-white/5 hover:text-white"}`}>
            {item.name}
          </a>
        ))
      }
    </div>
    <div class="mt-6 flex flex-col gap-3">
      <a href="/login" class="flex w-full justify-center rounded-sm bg-gradient-to-b from-yellow-300 to-yellow-600 py-3 text-lg font-black text-[#021c13] shadow-md">เข้าสู่ระบบ</a>
      <a href="/register" class="flex w-full justify-center rounded-sm border border-gray-400 bg-[#1f2937] py-3 text-lg font-bold text-white">สมัครสมาชิก</a>
    </div>
  </div>
</header>

<style is:global>
  nav,
  header {
    font-family: "Kanit", sans-serif !important;
  }
  #hamburger-btn.active .line-1 {
    transform: translateY(8px) rotate(45deg);
  }
  #hamburger-btn.active .line-2 {
    opacity: 0;
  }
  #hamburger-btn.active .line-3 {
    transform: translateY(-8px) rotate(-45deg);
  }
  #mobile-menu.show {
    opacity: 1;
    transform: translateY(0) scaleY(100%);
    pointer-events: auto;
  }
</style>

<script>
  const hamburgerBtn = document.getElementById("hamburger-btn");
  const mobileMenu = document.getElementById("mobile-menu");
  hamburgerBtn?.addEventListener("click", () => {
    hamburgerBtn.classList.toggle("active");
    mobileMenu?.classList.toggle("show");
  });
</script>
