---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-xl sm:text-2xl md:text-3xl" : "text-lg sm:text-xl md:text-2xl";
---

<section class="my-12 flex w-full justify-center px-4 font-sans">
  <div
    class="relative isolate w-full max-w-[1400px] rounded-2xl border-2 border-[#f1d9c4] bg-white p-8 pt-32 text-left text-base leading-relaxed text-[#2b2622] shadow-[0_10px_30px_rgba(31,22,17,0.08)] sm:pt-24 md:pt-28">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 rounded-2xl bg-gradient-to-b from-[#fff3e8] to-white"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-10 -bottom-16 -z-10 h-40 w-40 rounded-full bg-[#5aa9ff]/15 blur-[60px]"></div>

    {
      title && (
        <div class="absolute -top-6 left-1/2 flex w-[92%] max-w-2xl -translate-x-1/2 items-center justify-center gap-2 rounded-xl border-2 border-[#ffe3b8] bg-gradient-to-b from-[#ffc94a] to-[#f47b20] px-4 py-2.5 text-center shadow-[0_10px_26px_rgba(244,123,32,0.40)] sm:px-8">
          <span aria-hidden="true" class="shrink-0 text-[#2a1300]">
            ✦
          </span>
          <HeadingTag class={`min-w-0 ${headingSize} leading-normal font-black tracking-tight text-[#2a1300]`}>{title}</HeadingTag>
          <span aria-hidden="true" class="shrink-0 text-[#2a1300]">
            ✦
          </span>
        </div>
      )
    }

    <slot />
  </div>
</section>
