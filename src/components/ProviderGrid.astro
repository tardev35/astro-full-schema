---
const providers = [
  { name: "PG SOFT", desc: "ค่ายเกมมหาชน ภาพสวย ฟีเจอร์แน่น แตกหนักสะใจ เข้าฟรีสปินรัวตามต้นฉบับ", tag: "ภาพสวยฟีเจอร์แน่น", icon: "🎰" },
  { name: "Pragmatic Play", desc: "สายซื้อฟรีสปินต้องค่ายนี้ ลุ้นตัวคูณโหดๆ แบบไม่ต้องรอจังหวะให้เสียเวลา", tag: "สายซื้อฟรีสปิน", icon: "🔥" },
  { name: "Joker & SlotXO", desc: "ค่ายเกมสุดเก๋า ความคลาสสิกที่ยังคงขลัง แตกทีมีสะดุ้งกันทั้งวง", tag: "คลาสสิกยังขลัง", icon: "🃏" },
  { name: "สล็อตแตกหนัก", desc: "คัดเนื้อๆ เน้นๆ ระดับ God Tier มีสถิติการแตกดีตรงตามต้นฉบับ โบนัสเข้าบ่อยที่สุด", tag: "ระดับ God Tier", icon: "🦍" },
  { name: "สล็อตทุนน้อย", desc: "วอเล็ทไม่มีขั้นต่ำ 1 บาทก็เป็นลูกค้า VIP ของเว็บเราได้ ถ้าฝากอย่างต่อเนื่อง", tag: "เริ่ม 1 บาท", icon: "🪙" },
  { name: "เกมใหม่บนมือถือ", desc: "เทคโนโลยีล้ำหน้าเว็บเก่าหลายปีแสง ทั้งความลื่นไหล กราฟิก และฟีเจอร์ที่อัปเดตก่อนใคร", tag: "อัปเดตก่อนใคร", icon: "📱" },
  { name: "ยูสเซอร์เดียวครบ", desc: "ไม่ว่าคุณจะชอบสไตล์ไหน เรามีให้ครบจบในยูสเซอร์เดียว ไม่ต้องโยกเงินให้ปวดหัว", tag: "ไม่ต้องโยกเงิน", icon: "👑" },
];
---

<section aria-label="ค่ายเกมและหมวดสล็อตที่ GODKINGKONG คัดมาให้ครบ" class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#7bff9f] via-[#2fe35f] to-[#f0c43a] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      ค่ายเกมและหมวดสล็อตที่ <span class="text-[#2fe35f]">GODKINGKONG</span> คัดมาให้ครบ
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#2fe35f] to-transparent"></div>
  </div>

  <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4 lg:gap-5 xl:grid-cols-7">
    {
      providers.map((provider) => (
        <a
          href="/register"
          class="group relative flex flex-col items-center justify-center overflow-hidden rounded-2xl border border-[#2fe35f]/25 bg-[#0a1a10]/92 p-5 shadow-[0_10px_30px_rgba(5,15,9,0.55)] backdrop-blur-md transition-all duration-300 hover:-translate-y-2 hover:border-[#2fe35f]/55 hover:bg-[#0c1f13]/95 hover:shadow-[0_15px_40px_rgba(47,227,95,0.30)]">
          <div class="pointer-events-none absolute inset-0 bg-[#0d4a26]/35 opacity-0 transition-opacity duration-300 group-hover:opacity-100" />

          <div class="absolute top-2 right-2 z-10 rounded-full bg-gradient-to-r from-[#7bff9f] via-[#2fe35f] to-[#0b6b34] px-2 py-0.5 text-[9px] font-black tracking-wide whitespace-nowrap text-[#04170b] shadow-sm transition-transform duration-300 group-hover:scale-110">
            {provider.tag}
          </div>

          <div aria-hidden="true" class="mb-3 text-4xl transition-transform duration-300 group-hover:scale-125 group-hover:rotate-3">
            {provider.icon}
          </div>
          <p class="text-center text-sm font-black text-[#ddf3e2] transition-colors group-hover:text-[#7bff9f]">{provider.name}</p>
          <p class="mt-1 text-center text-[10px] text-[#ddf3e2]/70">{provider.desc}</p>

          <span class="relative z-10 mt-4 block w-full rounded-full border border-[#2fe35f]/25 bg-[#050f09] py-1.5 text-center text-[11px] font-bold text-[#2fe35f] shadow-inner transition-colors duration-300 group-hover:border-[#2fe35f]/50 group-hover:bg-gradient-to-r group-hover:from-[#7bff9f] group-hover:via-[#2fe35f] group-hover:to-[#0b6b34] group-hover:text-[#04170b]">
            เข้าดูเกม
          </span>
        </a>
      ))
    }
  </div>
</section>
