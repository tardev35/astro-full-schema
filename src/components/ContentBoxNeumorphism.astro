---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";
---

<section class="relative z-10 my-6 flex w-full justify-center px-4 font-sans">
  <div
    class="w-full max-w-[1400px] rounded-[25px] border border-[#b07d12]/55 bg-[#2a0505] p-8 text-left text-base leading-relaxed text-[#f7e4d4] shadow-[10px_10px_20px_#160202,-10px_-10px_20px_#3a0808]">
    {
      title && (
        <header class="mb-8 border-b border-[#b07d12]/45 pb-4 text-center">
          <HeadingTag class={`bg-gradient-to-r from-[#ffe08a] via-[#f5c542] to-[#d99e1f] bg-clip-text ${headingSize} leading-normal font-black tracking-wide text-transparent`}>{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
