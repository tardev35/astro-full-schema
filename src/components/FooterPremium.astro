---
import { Picture } from "astro:assets";
import BankStrip from "./BankStrip.astro";
import { BRAND_ADDRESS } from "../lib/brandProfile";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });
const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

const logoAlt =
  "โลโก้ ANKERSPIN ตัวอักษร ANKER สีชมพูบานเย็นไล่เฉดขอบขาว ต่อด้วยคำว่า SPIN สีขาวเงิน มีรูปสมอเรือสีชมพูวางทับอยู่ด้านบนตัวอักษร พร้อมเส้นแสงสีชมพูเรืองรอบตัวโลโก้";
---

<footer
  class="relative mt-16 w-full overflow-hidden rounded-t-[3rem] border-t border-[#ff6bb5]/40 bg-[#0d0207] pt-16 pb-8 font-sans text-[#f9dcec] shadow-[0_-15px_40px_rgba(255,45,143,0.26)]">
  <div class="pointer-events-none absolute inset-x-0 -top-20 mx-auto h-[250px] w-full max-w-4xl rounded-full bg-[#ff2d8f]/20 blur-[100px]"></div>

  <div class="relative z-10 mx-auto w-full max-w-[1200px] px-6">
    <div class="mb-12 grid grid-cols-1 gap-12 md:grid-cols-12">
      <div class="flex flex-col gap-5 md:col-span-5">
        <a href="/" class="inline-block transition-transform duration-300 hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt={logoAlt}
                widths={[130, 260, 390]}
                sizes="130px"
                class="h-[65px] w-auto drop-shadow-[0_5px_15px_rgba(255,107,181,0.35)]"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <span class="bg-gradient-to-r from-[#ff2d8f] to-[#c2185b] bg-clip-text text-4xl font-black tracking-widest text-transparent">
                ANKER<span class="bg-gradient-to-r from-[#eae4f0] to-[#ffa6d5] bg-clip-text text-transparent">SPIN</span>
              </span>
            )
          }
        </a>
        <p class="border-l-2 border-[#ff6bb5]/50 pl-4 text-sm leading-relaxed text-[#f9dcec]/65">
          ANKERSPIN เว็บตรงลิขสิทธิ์แท้ รวมสล็อต คาสิโนสด กีฬา ระบบสมาชิก และการจัดการเครดิตไว้ในบัญชีเดียว รองรับฝากถอน Auto Wallet และระบบออโต้ตลอด 24 ชั่วโมง ใช้งานผ่านมือถือได้ตั้งแต่สมัครจนถึงเลือกเกม
        </p>
        <div class="mt-4 flex gap-3">
          <span class="rounded-full border border-[#ff6bb5]/30 bg-[#ff2d8f]/25 px-4 py-1 text-xs font-medium text-[#ffa6d5] backdrop-blur-sm">Auto Wallet</span>
          <span class="rounded-full border border-[#ffa6d5]/30 bg-[#ff2d8f]/25 px-4 py-1 text-xs font-medium text-[#ffc4e2] backdrop-blur-sm">ออโต้ 24 ชม.</span>
        </div>
      </div>

      <nav class="flex flex-col gap-4 md:col-span-3 lg:pl-8">
        <p class="text-lg font-black tracking-widest text-white uppercase drop-shadow-sm">เมนูลัด</p>
        <div class="h-[1px] w-12 bg-[#ff6bb5]"></div>
        <ul class="flex flex-col gap-3 text-sm font-medium text-[#f9dcec]/65">
          <li><a href="/" class="transition-colors hover:text-[#ffa6d5]">หน้าหลัก</a></li>
          <li><a href="/promotion" class="transition-colors hover:text-[#ffa6d5]">โปรโมชั่น</a></li>
          <li><a href="/register" class="transition-colors hover:text-[#ffa6d5]">สมัครสมาชิก</a></li>
          <li><a href="/login" class="transition-colors hover:text-[#ffa6d5]">เข้าสู่ระบบ</a></li>
          <li><a href="/ทางเข้า" class="transition-colors hover:text-[#ffa6d5]">ทางเข้า</a></li>
          <li><a href="/ทดลองเล่น" class="transition-colors hover:text-[#ffa6d5]">ทดลองเล่น</a></li>
          <li><a href="/about-us" class="transition-colors hover:text-[#ffa6d5]">เกี่ยวกับเรา</a></li>
          <li><a href="/contact-us" class="transition-colors hover:text-[#ffa6d5]">ติดต่อเรา</a></li>
        </ul>
      </nav>

      <div class="flex flex-col gap-5 md:col-span-4">
        <p class="text-lg font-black tracking-widest text-white uppercase drop-shadow-sm">ฝ่ายดูแลสมาชิก</p>
        <div class="h-[1px] w-12 bg-[#ff6bb5]"></div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] py-3.5 font-bold text-white shadow-[0_5px_15px_rgba(0,185,0,0.3)] transition-all hover:-translate-y-1 hover:shadow-[0_8px_20px_rgba(0,185,0,0.4)]">
          ติดต่อแอดมิน LINE
        </a>

        {
          BRAND_ADDRESS.lines.length > 0 && (
            <address aria-label={BRAND_ADDRESS.label} class="mt-2 rounded-xl border border-white/15 bg-black/20 p-4 text-xs leading-relaxed not-italic opacity-90">
              <p class="mb-2 flex items-center gap-2 text-[11px] font-bold tracking-wider uppercase opacity-80">
                <span aria-hidden="true" class="text-sm">📍</span>
                {BRAND_ADDRESS.label}
              </p>
              {BRAND_ADDRESS.lines.map((line) => (
                <span class="block">{line}</span>
              ))}
              {BRAND_ADDRESS.email && (
                <a href={`mailto:${BRAND_ADDRESS.email}`} class="mt-3 inline-flex items-center gap-2 font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                  <span aria-hidden="true" class="text-sm">✉️</span>
                  {BRAND_ADDRESS.email}
                </a>
              )}
            </address>
          )
        }

        <div class="mt-4 text-xs font-medium tracking-widest text-[#ffa6d5]/55 uppercase">ช่องทางฝากถอนที่รองรับ</div>
        <BankStrip size={30} />
      </div>
    </div>

    <div class="flex flex-col items-center justify-between border-t border-[#a4126b]/40 pt-8 text-xs font-medium tracking-wide text-[#f9dcec]/45 md:flex-row">
      <p>COPYRIGHT &copy; {new Date().getFullYear()} ANKERSPIN. ALL RIGHTS RESERVED.</p>
      <div class="mt-4 flex gap-4 md:mt-0">
        <a href="/terms/" class="transition-colors hover:text-[#ffa6d5]">TERMS &amp; CONDITIONS</a>
        <a href="/privacy/" class="transition-colors hover:text-[#ffa6d5]">PRIVACY POLICY</a>
      </div>
    </div>
  </div>
</footer>
