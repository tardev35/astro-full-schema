---
const reviews = [
  {
    name: "สมาชิกที่ใช้บัญชีเดียวจัดการทุกอย่าง",
    role: "รวมสล็อต โบนัส และเครดิตไว้ที่เดียว",
    stars: 5,
    tag: "ระบบสมาชิกบัญชีเดียว",
    content:
      "ที่ถูกใจคือไม่ต้องเปิดหลายหน้าครับ เข้าสู่ระบบครั้งเดียวแล้วเลือกสล็อต เช็กเครดิต ดูโบนัส หรือย้อนดูประวัติรายการได้จากจุดเดียว วันไหนอยากลองเกมใหม่ก็เปลี่ยนได้ทันที ใช้เครดิตชุดเดิมไม่ต้องสลับบัญชีให้ปวดหัว",
    avatar: "👑",
  },
  {
    name: "สมาชิกที่ใช้วอเลทเป็นช่องทางหลัก",
    role: "ฝากถอนผ่าน True Wallet และระบบออโต้",
    stars: 5,
    tag: "True Wallet และระบบออโต้",
    content:
      "ใช้ True Wallet อยู่แล้วเลยสะดวกมากค่ะ ทำรายการผ่านมือถือได้เอง ระบบออโต้รับรายการตลอดวันไม่ต้องรอใครมาจัดการ แล้วรายการก็เชื่อมกับบัญชีสมาชิก เลยดูเครดิตแล้วกลับเข้าเกมต่อได้จากระบบเดียว",
    avatar: "👛",
  },
  {
    name: "สมาชิกใหม่ที่เริ่มจากการเช็กโบนัส",
    role: "อ่านเงื่อนไขก่อนเลือกรับโปรที่เหมาะ",
    stars: 5,
    tag: "โบนัสสมาชิกใหม่",
    content:
      "ผมดูรายละเอียดโบนัสสมาชิกใหม่ก่อนเลือกรับครับ แต่ละโปรเงื่อนไขไม่เหมือนกัน เลยเลือกอันที่ตรงกับสไตล์ที่ตัวเองเล่นจริง ไม่ต้องไล่กดรับทุกอันที่ตัวเลขใหญ่ ตั้งแต่บาทแรกก็รู้สึกว่าคุ้มกับที่เริ่มไว้แล้ว",
    avatar: "🎁",
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label="เสียงจากสมาชิก TEMMAX69" class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#67e8f9] via-[#22d3ee] to-[#c084fc] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      เสียงจากสมาชิก <span class="text-[#22d3ee]">TEMMAX69</span>
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#22d3ee] to-transparent"></div>
  </div>

  <div class="mx-auto mb-8 flex max-w-md items-center justify-center gap-5 rounded-2xl border border-[#22d3ee]/25 bg-[#160735]/92 px-6 py-4 shadow-[0_10px_30px_rgba(7,2,24,0.5)] backdrop-blur-xl">
    <div class="flex flex-col items-center">
      <span class="bg-gradient-to-b from-[#67e8f9] to-[#0e7490] bg-clip-text text-4xl leading-none font-black text-transparent">{average}</span>
      <span class="mt-1 text-[10px] font-bold tracking-widest text-[#ece4ff]/70 uppercase">คะแนนเฉลี่ย</span>
    </div>
    <div class="h-12 w-px bg-[#35107a]"></div>
    <div class="flex flex-col gap-1.5">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#22d3ee]" : "text-[#35107a]"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#ece4ff]/70">คะแนนเฉลี่ย {average} จาก 5 ดาว จากการใช้งานจริงของสมาชิก {reviews.length} ด้าน</span>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
    {
      reviews.map((review) => (
        <article class="group relative isolate flex flex-col gap-4 overflow-hidden rounded-2xl border border-[#22d3ee]/25 bg-[#160735]/92 p-6 text-left shadow-[0_10px_30px_rgba(7,2,24,0.5)] backdrop-blur-xl transition-all duration-300 hover:-translate-y-1 hover:border-[#22d3ee]/55 hover:shadow-[0_15px_40px_rgba(34,211,238,0.30)]">
          <span class="absolute inset-y-0 left-0 -z-10 w-1 bg-gradient-to-b from-[#67e8f9] to-[#a855f7] opacity-80 transition-opacity duration-300 group-hover:opacity-100" />
          <span class="pointer-events-none absolute -top-14 -right-14 -z-10 h-32 w-32 rounded-full bg-[#a855f7]/45 blur-[50px] transition-all duration-300 group-hover:bg-[#22d3ee]/25" />

          <div class="flex items-center justify-between gap-3">
            <span class="inline-flex items-center gap-1.5 rounded-full border border-[#22d3ee]/25 bg-[#2b0a5e] px-3 py-1 text-[10px] font-bold tracking-widest text-[#22d3ee] uppercase">
              <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#22d3ee]" />
              {review.tag}
            </span>
            <span class="flex gap-0.5 text-sm">
              <span aria-hidden="true" class="flex gap-0.5">
                {Array.from({ length: 5 }).map((_, i) => (
                  <span class={i < review.stars ? "text-[#22d3ee]" : "text-[#35107a]"}>★</span>
                ))}
              </span>
              <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
            </span>
          </div>

          <p class="text-left text-base leading-relaxed text-[#ece4ff]">{review.content}</p>

          <div class="mt-auto flex items-center gap-3 border-t border-[#35107a] pt-4">
            <span
              aria-hidden="true"
              class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#22d3ee]/30 bg-gradient-to-br from-[#67e8f9] via-[#22d3ee] to-[#35107a] text-xl shadow-inner transition-transform duration-300 group-hover:scale-110">
              {review.avatar}
            </span>
            <span class="flex flex-col">
              <span class="text-sm font-black text-[#ece4ff] transition-colors group-hover:text-[#67e8f9]">{review.name}</span>
              <span class="text-[10px] font-bold tracking-wider text-[#ece4ff]/70 uppercase">{review.role}</span>
            </span>
          </div>
        </article>
      ))
    }
  </div>
</section>
