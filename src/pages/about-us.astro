---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementCyber.astro";
import { pageGraph } from "../lib/schema";

const pageTitle = "เกี่ยวกับเรา TEMMAX69 เว็บสล็อตมาใหม่ รวมเกม โบนัสสมาชิก และ True Wallet ไว้ในบัญชีเดียว";

const pageDescription =
  "เกี่ยวกับเรา TEMMAX69 เว็บสล็อตมาใหม่ รวมเกมสล็อต โบนัสสมาชิกใหม่ ระบบสมาชิก ฝากถอนผ่าน True Wallet และระบบออโต้ไว้ในบัญชีเดียว ใช้งานผ่านมือถือตลอด 24 ชั่วโมง";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox as="h1" title={pageTitle}>
    <p class="mb-4 text-left text-base leading-relaxed text-[#ece4ff]">
      <strong class="text-[#22d3ee]">TEMMAX69</strong> รวมสล็อต โบนัส ระบบสมาชิก และการจัดการเครดิตไว้ในบัญชีเดียว สมาชิกเข้าสู่ระบบครั้งเดียวแล้วเลือกเกม ดูเครดิต
      หรือจัดการข้อมูลบัญชีต่อได้ทันที ทั้งบนมือถือและคอมพิวเตอร์ โดยไม่ต้องสลับไปมาระหว่างหลายระบบให้เสียจังหวะ
    </p>

    <p class="text-left text-base leading-relaxed text-[#ece4ff]">
      หน้านี้ทำหน้าที่เป็นหน้าข้อมูลและแนะนำตัว อธิบายว่าเราเปิดให้บริการอะไร วางระบบสมาชิกไว้อย่างไร และเหมาะกับผู้เล่นแบบไหน เพื่อให้อ่านแล้วนำไปเทียบกับสิ่งที่เห็นในหน้าสมาชิกจริงได้
      ส่วนรายละเอียดของแต่ละสิทธิ์และเงื่อนไขจะอยู่ในหน้าโปรโมชั่นโดยตรง จึงควรเปิดดูก่อนกดรับทุกครั้ง เพราะเงินอาจหาใหม่ได้ แต่เวลาที่เสียไปกับขั้นตอนเยอะ ๆ นั่นแพงกว่า
    </p>
  </ContentBox>

  <ContentBox as="h2" title="TEMMAX69 เว็บสล็อตมาใหม่ มีเกมและหมวดไหนให้เลือกบ้าง">
    <p class="mb-4 text-left text-base leading-relaxed text-[#ece4ff]">
      เราจัดสล็อตเป็นหมวดหลักของเว็บ มีทั้งเกมคลาสสิก เกมที่มีฟีเจอร์ฟรีสปินและตัวคูณ ไปจนถึงเกมใหม่ที่ทยอยเพิ่มเข้ามา เลือกได้จากหมวดเดียวผ่านมือถือ
      สมาชิกที่มีเกมประจำอยู่แล้วจึงเข้าเกมเดิมได้ไว ส่วนสายที่ชอบลองของใหม่ก็เปิดดูเกมใหม่จากหมวดสล็อตได้โดยตรง
    </p>

    <p class="text-left text-base leading-relaxed text-[#ece4ff]">
      เราแยกสล็อตตามรูปแบบเกม ทำให้สายโบนัส สายฟรีสปิน หรือคนที่มีเกมประจำเข้าถึงตัวเลือกที่ชอบได้เร็ว อยากเปลี่ยนเกมก็เปลี่ยนได้ทันที
      เพราะเกมเยอะต้องหาเจอง่ายด้วย ความหรูจริงไม่ใช่การมีตัวเลือกเยอะ แต่คือมีเยอะแล้วไม่ต้องเสียเวลาหา
    </p>
  </ContentBox>

  <ContentBox as="h2" title="โบนัสสมาชิกใหม่ TEMMAX69 คุ้มตั้งแต่เริ่มต้นอย่างไร">
    <p class="mb-4 text-left text-base leading-relaxed text-[#ece4ff]">
      โบนัสสำหรับสมาชิกใหม่ช่วยเพิ่มสิทธิ์เริ่มต้นตามโปรโมชั่นที่เปิดอยู่ในช่วงนั้น โดยสมาชิกตรวจรายละเอียดของแต่ละรายการก่อนเลือกรับได้เสมอ
      แต่ละโปรกำหนดเกมที่ร่วมรายการ ยอดเริ่มต้น เทิร์น และเงื่อนไขการถอนไม่เหมือนกัน จึงควรเปิดหน้าโปรโมชั่นอ่านให้ครบก่อนกดรับทุกครั้ง
    </p>

    <p class="text-left text-base leading-relaxed text-[#ece4ff]">
      นอกจากสิทธิ์สำหรับสมาชิกใหม่ ยังมีกิจกรรมตามช่วงเวลาให้เลือกอีก สมาชิกจึงเลือกโปรให้ตรงกับรูปแบบการเล่นของตัวเองได้
      เลือกให้ตรงสไตล์ดีกว่าไล่รับทุกอย่าง เพราะคนมีคลาสเลือกของที่คุ้ม ไม่ใช่ของที่ตัวเลขใหญ่ที่สุด
    </p>
  </ContentBox>

  <ContentBox as="h2" title="True Wallet และระบบออโต้ของ TEMMAX69 ทำรายการได้ตลอด 24 ชั่วโมง">
    <p class="mb-4 text-left text-base leading-relaxed text-[#ece4ff]">
      True Wallet ช่วยให้สมาชิกจัดการฝากถอนผ่านมือถือได้โดยตรง เหมาะกับคนที่ใช้วอเลทเป็นช่องทางหลักอยู่แล้ว รายการเชื่อมกับบัญชีสมาชิก
      ทำให้ดูเครดิตและกลับเข้าเกมต่อได้จากระบบเดียว ไม่ต้องสลับแอปไปมาระหว่างทำรายการกับเลือกเกม
    </p>

    <p class="text-left text-base leading-relaxed text-[#ece4ff]">
      ระบบออโต้รับรายการฝากถอนตลอดวัน สมาชิกตรวจเครดิตและสถานะผ่านบัญชีได้โดยไม่ต้องรอการจัดการแบบแมนนวล
      ออโต้ที่ดีต้องช่วยประหยัดเวลา เงินเดินเร็ว เจ้าของเงินก็ควรเดินน้อย ไม่ใช่เปลี่ยนจากรอคนมาเป็นรอวงกลมหมุนบนหน้าจอ
    </p>
  </ContentBox>

  <ContentBox as="h2" title="ระบบสมาชิก TEMMAX69 รวมเครดิต โบนัส และประวัติรายการไว้ตรงไหน">
    <p class="mb-4 text-left text-base leading-relaxed text-[#ece4ff]">
      หน้าสมาชิกรวมเครดิต โบนัส และประวัติรายการไว้ในจุดเดียว ทำให้เช็กข้อมูลสำคัญได้โดยไม่ต้องเปิดหลายหน้า
      คนที่เล่นหลายเกมหรือถือหลายโปรโมชั่นพร้อมกันจะตามข้อมูลได้ง่ายขึ้น เพราะทุกอย่างอยู่ในที่เดียวกันตั้งแต่ต้น ของสำคัญควรอยู่เป็นที่ เงินก็เหมือนกัน
    </p>

    <p class="text-left text-base leading-relaxed text-[#ece4ff]">
      หลังเข้าสู่ระบบผ่านมือถือด้วยยูสเดิม สมาชิกเลือกสล็อต ดูเครดิต เช็กโบนัส และจัดการบัญชีต่อได้ทันที เมนูหลักถูกจัดให้เหมาะกับจอเล็กและใช้งานด้วยมือเดียวได้สะดวก
      และขอย้ำเสมอว่าไม่ควรส่งรหัสผ่านหรือรหัส OTP ให้บุคคลอื่นไม่ว่ากรณีใด เพราะทีมงานจริงไม่มีความจำเป็นต้องขอสองสิ่งนี้
    </p>
  </ContentBox>

  <ContentBox as="h2" title="TEMMAX69 เหมาะกับผู้เล่นแบบไหน">
    <p class="mb-4 text-left text-base leading-relaxed text-[#ece4ff]">
      TEMMAX69 เหมาะกับคนที่เล่นสล็อตผ่านมือถือ ใช้ Wallet เป็นประจำ และอยากจัดการเกม โบนัส กับเครดิตจากบัญชีเดียว
      เลือกเกมที่ชอบ รับโปรที่เหมาะ แล้วจัดการฝากถอนจากมือถือได้เลย โดยไม่ต้องเปิดบัญชีที่สองหรือจำรหัสเพิ่มอีกชุด
    </p>

    <p class="text-left text-base leading-relaxed text-[#ece4ff]">
      ทางเข้าเว็บหลักเชื่อมไปยังล็อกอิน เกม โปรโมชั่น และระบบสมาชิก รองรับทั้งมือถือและคอมด้วยบัญชีเดียว การเข้าจากทางเข้าโดยตรงยังช่วยลดความสับสนจากชื่อเว็บใกล้เคียง
      เพราะเสียเงินยังพอเข้าใจ แต่เสียเวลาเข้าผิดเว็บนี่ไม่ค่อยสง่างาม หลายเกมมีไว้เลือก หลายบัญชีมีไว้ปวดหัว
    </p>
  </ContentBox>

  <Navfoot />
</MainLayout>
