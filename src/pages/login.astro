---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement4.astro";
import CtaRedirect from "../components/CtaRedirect.astro";
import { pageGraph } from "../lib/schema";

const pageTitle = "เข้าสู่ระบบ OSIRIS168 | ปุ่มล็อกอินเข้าหน้าเมมเบอร์ สล็อตระบบใหม่";

const pageDescription =
  "เข้าสู่ระบบ OSIRIS168 กดปุ่มเดียวไปยังหน้าล็อกอินด้วยยูสเดิม เข้าเล่นสล็อตรวมค่ายเกมดังในยูสเดียว เช็กเครดิตและส่งรายการฝากถอนออโต้ได้จากหน้าเมมเบอร์จุดเดียว";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เข้าสู่ระบบ", path: "/login" },
  ],
});

const targetUrl = "https://yoalink.com/22hs";
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="เข้าสู่ระบบ OSIRIS168" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label="เข้าสู่ระบบ OSIRIS168"
        class="group relative mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#064c39]/60 bg-gradient-to-b from-[#0a8f68] to-[#064c39] px-6 py-4 text-xl font-bold tracking-wide text-[#f8ecc9] shadow-[0_10px_30px_rgba(18,196,143,0.18)] transition-all duration-300 hover:scale-105 hover:border-[#4ff0bb]/70 hover:shadow-[0_15px_40px_rgba(79,240,187,0.28)]">
        เข้าสู่ระบบ OSIRIS168
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="เข้าสู่ระบบ" />
</MainLayout>
