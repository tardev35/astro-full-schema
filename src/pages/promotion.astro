---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxCyberCut.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";

import { Picture } from "astro:assets";

import pro1 from "../assets/slide1.png";
import pro2 from "../assets/slide2.png";
import pro3 from "../assets/slide3.png";
import pro4 from "../assets/slide4.png";
import { pageGraph } from "../lib/schema";

const pageDescription =
  "รวมโปรโมชั่น YIMSIAM889 สล็อตสยาม เว็บตรงแตกดีจริง ยิ้มรับโปรสมาชิกใหม่ตั้งแต่ก้าวแรก ฝากถอนผ่านระบบอัตโนมัติรวดเร็ว รองรับธนาคารชั้นนำและทรูวอลเลท ตลอด 24 ชม.";

const graph = pageGraph(Astro, {
  name: "โปรโมชั่น YIMSIAM889 ยิ้มรับโปรสมาชิกใหม่ คุ้มค่าตั้งแต่ก้าวแรก",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: pro3.src,
});
---

<MainLayout title="โปรโมชั่น - YIMSIAM889" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="โปรโมชั่น YIMSIAM889" as="h1">
    <h2 class="mb-4 text-2xl leading-normal font-bold text-[#e9b949]">ยิ้มรับโปรสมาชิกใหม่ คุ้มค่าตั้งแต่ก้าวแรก</h2>

    <p class="mb-5 text-left text-base leading-relaxed text-[#f2ddc4]">
      สำหรับท่านที่เพิ่งก้าวเข้ามาเป็นส่วนหนึ่งของครอบครัว <strong class="text-[#f8dc9a]">YIMSIAM889</strong> กระผมได้จัดเตรียมของขวัญต้อนรับชุดใหญ่เอาไว้ให้แล้วขอรับ
      การต้อนรับแขกบ้านแขกเมืองด้วยรอยยิ้มเป็นธรรมเนียมไทยแท้ที่เรายึดถือ ไม่ว่าจะเป็นโบนัสเพิ่มทุนก้อนแรก หรือสิทธิพิเศษเล็กๆ น้อยๆ ระหว่างทาง
      ล้วนจัดสรรมาให้อย่างเหมาะสม เพื่อให้ท่านมี “กระสุน” ในการเริ่มต้นที่มากขึ้น ไม่ต้องกังวลเรื่องทุนรอนตั้งแต่ก้าวแรก
    </p>

    <p class="mb-8 text-left text-base leading-relaxed text-[#f2ddc4]">
      เงื่อนไขของเราเขียนไว้อ่านง่าย ไม่มีบรรทัดเล็กๆ ซ่อนไว้ให้ท่านต้องมานั่งเพ่งทีหลัง สมัครปุ๊บรับสิทธิ์ปั๊บ ง่ายดายเพียงลัดนิ้วมือเดียว
      และหากตรงไหนยังสงสัย ทักมาสอบถามทีมงานได้ทุกเมื่อ เราตอบเองด้วยคนไทย ไม่ใช้บอทวนคำถามให้ท่านหงุดหงิดใจขอรับ
    </p>

    <h2 class="mt-10 mb-4 text-2xl leading-normal font-bold text-[#e9b949]">เว็บตรงแตกดีจริง วัดกันที่ดวงและฝีมือล้วนๆ</h2>

    <p class="mb-8 text-left text-base leading-relaxed text-[#f2ddc4]">
      <strong class="text-[#f8dc9a]">YIMSIAM889</strong> ให้บริการในรูปแบบของเว็บตรง ไม่ผ่านเอเย่นต์หรือนายหน้าค้าความใดๆ ทั้งสิ้น เราเชื่อมต่อสัญญาณเกมโดยตรงจากค่ายแม่
      ระบบเกมจึงเสถียรและยุติธรรมที่สุด คำว่า <strong class="text-[#f8dc9a]">เว็บตรงแตกดีจริง</strong> ของเราไม่ได้กล่าวเกินจริงแต่อย่างใด เพราะเมื่อระบบมันตรงไปตรงมา
      อัตราการชนะ (RTP) ก็เป็นไปตามมาตรฐานสากล ไม่มีใครมาแอบปรับหลังบ้านให้ท่านระคายเคืองใจ บทจะแตกก็แตก บทจะเข้าฟรีสปินก็ไหลยาว
      วัดกันที่ดวงและฝีมือล้วนๆ ตรวจสอบได้ทุกขั้นตอนขอรับ
    </p>

    <h2 class="mt-10 mb-4 text-2xl leading-normal font-bold text-[#e9b949]">ธุรกรรมว่องไว ฝากถอนผ่านระบบอัตโนมัติ ปลอดภัยหายห่วง</h2>

    <p class="mb-5 text-left text-base leading-relaxed text-[#f2ddc4]">
      สมัยนี้จะให้นั่งส่งสลิปแล้วรอแอดมินตอบแชตข้ามวันมันไม่ทันการณ์ขอรับ ระบบฝาก-ถอนของเราจึงเป็นระบบอัตโนมัติ (Auto) ที่ทำงานรวดเร็วปานกามนิตหนุ่ม
      ท่านทำรายการได้ด้วยตัวเองผ่านแอปพลิเคชันธนาคารชั้นนำ หรือจะใช้ทรูมันนี่วอลเล็ทก็ได้เช่นกัน ฝากปุ๊บเครดิตเข้าปั๊บ ถอนปุ๊บเงินเด้งเข้าบัญชีทันที
      ไม่ต้องส่งสลิปให้ใครดูให้เสียเวลา
    </p>

    <p class="mb-8 text-left text-base leading-relaxed text-[#f2ddc4]">
      เรื่องเงินๆ ทองๆ ต้องรอบคอบ แต่ก็ต้องรวดเร็วด้วยเช่นกัน ทุกรายการจึงถูกต้อง แม่นยำ และเข้ารหัสตามมาตรฐานความปลอดภัยขั้นสูง
      ท่านสบายใจได้เลยว่าทุกบาททุกสตางค์จะถูกดูแลเป็นอย่างดี และทีมงานของเราแสตนด์บายให้ตลอด 24 ชั่วโมง ไม่มีวันหยุดราชการขอรับ
    </p>

    <div class="grid w-full grid-cols-1 gap-6 sm:grid-cols-2">
      <Picture
        src={pro1}
        alt="ภาพโปรโมชั่น YIMSIAM889 ข้อความทองขอบแดง ธุรกรรมว่องไว ระบบอัตโนมัติ มุมซ้ายบนเป็นโลโก้หน้าบันทรงไทยสีทอง ด้านขวาเป็นพรีเซ็นเตอร์หญิงชุดราตรีเลื่อมทองชี้นิ้วมาที่ข้อความ รอบภาพมีเส้นแสงทองโค้ง เหรียญทอง ชิปคาสิโน และไพ่ปลิวเหนือธารลาวา"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600, 800]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class="mx-auto h-auto w-full rounded-xl border border-[#e9b949]/25 object-contain shadow-[0_10px_30px_rgba(168,31,26,0.18)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#a81f1a]/50 hover:shadow-[0_15px_40px_rgba(168,31,26,0.30)]"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />

      <Picture
        src={pro2}
        alt="ภาพโปรโมชั่น YIMSIAM889 ข้อความทองขนาดใหญ่ ทางเข้า YIMSIAM889 รองรับทุกอุปกรณ์ ด้านบนกลางภาพเป็นโลโก้หน้าบันทรงไทยสีทอง ทางซ้ายเป็นพรีเซ็นเตอร์หญิงชุดราตรีเลื่อมทองถือไพ่คลี่เป็นพัด พื้นหลังเป็นธารลาวา เส้นแสงทอง เหรียญทอง และชิปคาสิโน"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600, 800]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class="mx-auto h-auto w-full rounded-xl border border-[#e9b949]/25 object-contain shadow-[0_10px_30px_rgba(168,31,26,0.18)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#a81f1a]/50 hover:shadow-[0_15px_40px_rgba(168,31,26,0.30)]"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />

      <Picture
        src={pro3}
        alt="ภาพโปรโมชั่น YIMSIAM889 ข้อความทอง ยิ้มรับโปรสมาชิกใหม่ คุ้มค่าตั้งแต่ก้าวแรก มุมซ้ายบนเป็นโลโก้หน้าบันทรงไทยสีทอง กลางภาพเป็นพรีเซ็นเตอร์หญิงชุดราตรีเลื่อมทองคอวีกำลังยิ้ม รอบภาพมีเหรียญทองลอย ชิปคาสิโน ไพ่ และธารลาวาเรืองแสงสีแดงส้ม"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600, 800]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class="mx-auto h-auto w-full rounded-xl border border-[#e9b949]/25 object-contain shadow-[0_10px_30px_rgba(168,31,26,0.18)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#a81f1a]/50 hover:shadow-[0_15px_40px_rgba(168,31,26,0.30)]"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />

      <Picture
        src={pro4}
        alt="ภาพโปรโมชั่น YIMSIAM889 ข้อความทอง เว็บตรงแตกดีจริง มาตรฐานสากล มุมซ้ายบนเป็นโลโก้หน้าบันทรงไทยสีทอง ด้านขวาเป็นพรีเซ็นเตอร์หญิงชุดราตรีเลื่อมทองถือไพ่คลี่เป็นพัด รอบภาพมีเหรียญทองลอย ชิปคาสิโน และเส้นแสงทองพาดผ่านธารลาวา"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600, 800]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class="mx-auto h-auto w-full rounded-xl border border-[#e9b949]/25 object-contain shadow-[0_10px_30px_rgba(168,31,26,0.18)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#a81f1a]/50 hover:shadow-[0_15px_40px_rgba(168,31,26,0.30)]"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />
    </div>

    <div class="mt-12 flex justify-center pb-4">
      <a
        href="/register"
        class="flex items-center justify-center rounded-lg border border-[#e9b949]/60 bg-gradient-to-r from-[#f8dc9a] via-[#e9b949] to-[#a81f1a] px-10 py-3.5 text-lg font-black text-[#140604] shadow-[0_10px_30px_rgba(168,31,26,0.18)] transition-transform hover:scale-105 hover:shadow-[0_15px_40px_rgba(168,31,26,0.30)]">
        สมัครสมาชิก YIMSIAM889
      </a>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
