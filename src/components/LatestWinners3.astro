---
import kbankLogo from "../assets/banks/kbank.png";
import scbLogo from "../assets/banks/scb.png";
import krungsriLogo from "../assets/banks/krungsri.png";
import ktbLogo from "../assets/banks/ktb.png";
import ttbLogo from "../assets/banks/ttb.png";
import { brandFlag, brandPick } from "../lib/brandProfile";

const bankPool = [
  { name: "KBank", color: "bg-[#1155cc]", icon: kbankLogo.src },
  { name: "SCB", color: "bg-[#4e1c80]", icon: scbLogo.src },
  { name: "Krungsri", color: "bg-[#fcd34d]", icon: krungsriLogo.src },
  { name: "KTB", color: "bg-[#0ea5e9]", icon: ktbLogo.src },
  { name: "TTB", color: "bg-[#1279be]", icon: ttbLogo.src },
];

const LETTERS = "abcdefghijklmnopqrstuvwxyz";
const pickFrom = (chars: string, salt: string) => chars.charAt(brandPick(Astro.site, salt, chars.length));

const initialRows = Array.from({ length: 5 }, (_, i) => ({
  bank: bankPool[brandPick(Astro.site, `winner-bank-${i}`, bankPool.length)],
  user: `${pickFrom(LETTERS, `winner-a-${i}`)}${pickFrom(LETTERS, `winner-b-${i}`)}***${[0, 1, 2, 3].map((d) => brandPick(Astro.site, `winner-d${i}-${d}`, 10)).join("")}`,
  amount: (15000 + brandPick(Astro.site, `winner-amount-${i}`, 80001)).toLocaleString("en-US"),
  pending: brandFlag(Astro.site, `winner-pending-${i}`),
}));
---

<div class="mx-auto w-full max-w-[900px] p-4 font-sans">
  <section
    aria-label="ประวัติการถอนเงินล่าสุดของสมาชิก VODKAFUN"
    class="relative overflow-hidden rounded-[30px] border border-[#1d5c22] bg-[#06230a] px-4 py-8 shadow-[0_10px_30px_rgba(200,252,4,0.12)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-16 -right-10 h-40 w-40 rounded-full bg-[#c8fc04]/12 blur-[60px]"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -bottom-16 -left-10 h-40 w-40 rounded-full bg-[#3fc20a]/14 blur-[60px]"></div>

    <div class="relative z-10 mb-8 text-center">
      <p class="bg-gradient-to-r from-[#f3ffe9] via-[#c8fc04] to-[#3fc20a] bg-clip-text text-xl font-black text-transparent md:text-3xl">ประวัติการถอนเงินของสมาชิก VODKAFUN แบบเรียลไทม์</p>
      <p class="mt-2 text-base leading-relaxed text-[#d9f7d0]">
        ยอดถอนของสมาชิก VODKAFUN ทำรายการผ่านระบบออโต้ รองรับทั้งบัญชีธนาคารและทรูมันนี่วอเล็ตตามช่องทางที่เปิดให้บริการ ตัวเลขด้านล่างเป็นข้อมูลตัวอย่างสำหรับแสดงรูปแบบรายการเท่านั้น
      </p>
    </div>

    <div data-winners-feed class="relative z-10 ml-4 border-l-2 border-[#1d5c22] pl-6 md:ml-8 md:pl-8">
      {
        initialRows.map((row) => (
          <div data-winner-row class="winner-row relative mb-6 transition-all duration-500 ease-out">
            <div class="absolute top-2 -left-[35px] h-4 w-4 rounded-full border-2 border-[#06230a] bg-[#c8fc04] shadow-[0_0_10px_rgba(200,252,4,0.45)] md:-left-[43px]" />

            <div class="flex items-center gap-4 rounded-[20px] border border-[#1d5c22] bg-gradient-to-r from-[#0b3a10] to-[#06230a] p-4 transition-colors hover:from-[#0b3a10] hover:to-[#0b3a10]">
              <div data-winner-bank class={`flex h-10 w-10 shrink-0 items-center justify-center rounded-full ${row.bank.color}`}>
                <img data-winner-icon src={row.bank.icon} alt="" width="24" height="24" loading="lazy" decoding="async" class="h-6 w-6 object-contain" />
              </div>

              <div class="min-w-0 flex-1">
                <div class="text-sm text-[#a9d9a0]">
                  ยูสเซอร์:{" "}
                  <span data-winner-user class="font-bold text-[#f3ffe9]">
                    {row.user}
                  </span>
                </div>
                <div class="text-xl font-black text-[#c8fc04]">
                  <span data-winner-amount>{row.amount}</span> THB
                </div>
              </div>

              <div
                data-winner-status
                data-pending-text="กำลังตรวจสอบรายการ"
                data-done-text="โอนสำเร็จแล้ว"
                class={`winner-status hidden shrink-0 rounded-full border px-3 py-1 text-[10px] tracking-widest md:block ${row.pending ? "is-pending" : "is-verified"}`}>
                {row.pending ? "กำลังตรวจสอบรายการ" : "โอนสำเร็จแล้ว"}
              </div>
            </div>
          </div>
        ))
      }
    </div>

    <script type="application/json" data-winners-banks set:html={JSON.stringify(bankPool)} />
  </section>
</div>

<script>
  import { startWinnersFeed } from "../lib/winnersFeed";

  startWinnersFeed();
</script>

<style>
  .winner-status.is-pending {
    color: #c8fc04;
    border-color: rgba(200, 252, 4, 0.45);
    background-color: #0b3a10;
  }
  .winner-status.is-verified {
    color: #3fc20a;
    border-color: rgba(63, 194, 10, 0.45);
    background-color: #06230a;
  }

  .winner-row.is-entering {
    transform: translateX(-1rem);
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .winner-row {
      transition: none;
    }
  }
</style>
