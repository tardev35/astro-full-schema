          quality={80}
        />
      </div>
      <div class="flex flex-col gap-4">
        <Picture
          src={image11}
          alt="โปรโมชั่นสล็อตแตกแจกเพิ่ม KIKI49 รับโบนัสเพิ่ม 10% เมื่อยอดชนะตามเงื่อนไข"
          loading="lazy"
          fetchpriority="low"
          widths={[200, 400, 600]}
          sizes="(max-width: 768px) 100vw, 33vw"
          class="mx-auto h-auto w-full max-w-[400px] object-contain shadow-xl"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />
      </div>
      <div class="flex flex-col gap-4">
        <Picture
          src={image12}
          alt="เลือกเล่นแบบไม่รับโบนัสกับ KIKI49 ถอนได้ไม่อั้น ไม่ต้องทำเทิร์นโอเวอร์"
          loading="lazy"
          fetchpriority="low"
          widths={[200, 400, 600]}
          sizes="(max-width: 768px) 100vw, 33vw"
          class="mx-auto h-auto w-full max-w-[400px] object-contain shadow-xl"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />
      </div>
    </div>
  </ContentBox>
</MainLayout>
<Navfoot />
