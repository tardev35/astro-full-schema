---
const faqs = [
  {
    q: "ขั้นตอนการสมัครสมาชิก Teenoi168 อย่างปลอดภัยและรวดเร็ว",
    a: "การสมัครสมาชิกกับเราทำได้ง่ายผ่านระบบออโต้หน้าเว็บ กรอกข้อมูลเพียงไม่กี่ขั้นตอน ข้อมูลส่วนตัวของคุณจะถูกจัดเก็บด้วยระบบเข้ารหัส SSL ขั้นสูง ทำให้ปลอดภัยจากการรั่วไหล 100% และไม่มีการนำข้อมูลไปใช้ในทางที่ผิด",
  },
  {
    q: "แนวทางแก้ไขเบื้องต้นเมื่อพบปัญหาเข้าหน้าเว็บ Teenoi168 ไม่ได้",
    a: "หากคุณพบปัญหาเข้าเว็บไม่ได้ อาจเกิดจากแคช (Cache) บราวเซอร์เก่าสะสม แนะนำให้ทำการล้างแคชหรือเปลี่ยนบราวเซอร์ หากยังพบปัญหา สามารถติดต่อแอดมินเพื่อขอรับ ลิงก์ทางเข้าสำรองล่าสุด ได้ทันที ทีมงานเราเตรียมช่องทางสำรองไว้รองรับสถานการณ์ฉุกเฉินเสมอ",
  },
  {
    q: "ช่องทางการติดต่อทีมงาน Teenoi168 ดูแลตลอด 24 ชั่วโมง",
    a: "เรามีทีมงานมืออาชีพสแตนด์บายดูแลคุณตลอด 24 ชั่วโมง ไม่มีวันหยุด ไม่ว่าจะเป็นปัญหาด้านการใช้งาน การสอบถามโปรโมชั่น หรือปัญหาด้านเทคนิค คุณสามารถติดต่อเราผ่านช่องทาง Line Official ที่ระบุหน้าเว็บไซต์ เราพร้อมดูแลทุกท่านด้วยความรวดเร็วและเป็นกันเอง ",
  },
];
---

<div class="mx-auto max-w-[1000px] px-4 py-10 font-sans">
  <h3 class="mb-8 bg-gradient-to-b from-yellow-200 to-yellow-600 bg-clip-text text-center text-2xl font-black tracking-tighter text-transparent uppercase italic md:text-4xl">
    คำถามที่พบบ่อย (FAQ) เกี่ยวกับการใช้งาน Teenoi168
  </h3>

  <div class="space-y-4">
    {
      faqs.map((faq, index) => (
        <div class="faq-item group overflow-hidden rounded-xl border border-yellow-500/20 bg-gradient-to-br from-[#1a1a1a] to-[#0a0a0a] transition-all hover:border-yellow-500/50">
          <button class="faq-trigger flex w-full items-center justify-between p-5 text-left transition-all">
            <span class="text-sm font-bold text-gray-200 md:text-lg">{faq.q}</span>
            <span class="icon ml-4 flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-yellow-500/40 text-yellow-500 transition-transform duration-300">
              <i class="fa-solid fa-plus text-xs" />
            </span>
          </button>
          <div class="faq-content max-h-0 overflow-hidden transition-all duration-300 ease-in-out">
            <div class="border-t border-white/5 p-5 pt-0 text-sm leading-relaxed text-gray-400 md:text-base">{faq.a}</div>
          </div>
        </div>
      ))
    }
  </div>
</div>

<script>
  const triggers = document.querySelectorAll(".faq-trigger");
  triggers.forEach((trigger) => {
    trigger.addEventListener("click", () => {
      const parent = trigger.parentElement;
      const content = trigger.nextElementSibling;
      const icon = trigger.querySelector(".icon");

      document.querySelectorAll(".faq-item").forEach((item) => {
        if (item !== parent) {
          item.classList.remove("active");
          (item.querySelector(".faq-content") as HTMLElement).style.maxHeight = "0";
          item.querySelector(".icon")?.classList.remove("rotate-45");
        }
      });

      parent?.classList.toggle("active");
      if (parent?.classList.contains("active")) {
        (content as HTMLElement).style.maxHeight = content?.scrollHeight + "px";
        icon?.classList.add("rotate-45");
      } else {
        (content as HTMLElement).style.maxHeight = "0";
        icon?.classList.remove("rotate-45");
      }
    });
  });
</script>

<style>
  .rotate-45 {
    transform: rotate(45deg);
    border-color: #ef4444 !important;
    color: #ef4444 !important;
  }
  .faq-item.active {
    border-color: rgba(234, 179, 8, 0.6);
    box-shadow: 0 0 20px rgba(0, 0, 0, 0.5);
  }
  h3,
  .space-y-4 {
    font-family: "kanit", sans-serif;
  }
</style>
