---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";
import { pageGraph } from "../lib/schema";

const pageTitle = "เกี่ยวกับเรา 888NEO เว็บสล็อต คาสิโนสด และระบบออโต้ในบัญชีเดียว";

const pageDescription =
  "เกี่ยวกับเรา 888NEO หน้ารวมข้อมูลเว็บสล็อตและคาสิโนสด อธิบายหมวดเกม ระบบออโต้ฝากถอน และระบบสมาชิกที่รวมเครดิตกับประวัติรายการไว้ในบัญชีเดียว ใช้งานผ่านมือถือ";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox as="h1" title={pageTitle}>
    <p class="mb-4 text-left text-base leading-relaxed text-[#f3e3c6]">
      <strong class="text-[#f5c542]">888NEO</strong> รวมเกมสล็อต คาสิโนสด ระบบสมาชิก และการจัดการเครดิตไว้ในบัญชีเดียว สมาชิกเข้าสู่ระบบครั้งเดียวแล้วเลือกเกม
      ดูเครดิต หรือจัดการข้อมูลบัญชีต่อได้ทันที ทั้งบนมือถือและคอมพิวเตอร์ โดยไม่ต้องเปิดหลายระบบให้เสียจังหวะ
    </p>

    <p class="text-left text-base leading-relaxed text-[#f3e3c6]">
      หน้านี้ทำหน้าที่เป็นหน้าข้อมูลและแนะนำตัว อธิบายว่าเราเปิดให้บริการอะไร วางระบบสมาชิกไว้อย่างไร และเหมาะกับผู้เล่นแบบไหน
      เพื่อให้อ่านแล้วนำไปเทียบกับสิ่งที่เห็นในหน้าสมาชิกจริงได้ ความสะดวกที่ดีควรทำให้เวลาไปอยู่กับเกม ไม่ใช่หมดไปกับการหาเมนู
    </p>
  </ContentBox>

  <ContentBox as="h2" title="888NEO เปิดให้บริการเกมแบบไหนบ้าง">
    <p class="mb-4 text-left text-base leading-relaxed text-[#f3e3c6]">
      เรารวมสล็อตหลายรูปแบบกับคาสิโนสดไว้ในแพลตฟอร์มเดียว สมาชิกจึงเลือกเกมหมุนหรือเปลี่ยนไปเล่นเกมโต๊ะได้ตามสไตล์โดยใช้บัญชีเดิม
      หน้าเกมแบ่งหมวดไว้ชัด ทำให้กดเข้าเกมที่อยากเล่นได้เร็วตั้งแต่เปิดหน้าแรก
    </p>

    <p class="text-left text-base leading-relaxed text-[#f3e3c6]">
      มีหลายหมวดไว้เลือกก็ดี เพราะบางวันอยากสล็อต บางวันอยากคาสิโน คนมีทางเลือกไม่จำเป็นต้องอธิบายเยอะ แค่เลือกสิ่งที่ถูกใจก็พอ
      สิ่งที่เราให้ความสำคัญคือทางเลือกเยอะแล้วยังหาเจอง่ายอยู่
    </p>
  </ContentBox>

  <ContentBox as="h2" title="สล็อตและคาสิโนสดของ 888NEO ต่างกันอย่างไร">
    <p class="mb-4 text-left text-base leading-relaxed text-[#f3e3c6]">
      ฝั่งสล็อตแยกเกมตามรูปแบบและหมวดเกม ช่วยให้ทั้งสายที่มีเกมประจำและคนชอบลองเกมใหม่ค้นหาตัวเลือกที่สนใจได้เร็วขึ้น
      ตัวเลือกเยอะควรเพิ่มความสนุก ไม่ใช่เพิ่มงานให้นิ้วโป้ง เกมที่ชอบควรหาเจอเร็วกว่าร้านอาหารดี ๆ ตอนหิว
    </p>

    <p class="text-left text-base leading-relaxed text-[#f3e3c6]">
      ส่วนคาสิโนสดเพิ่มทางเลือกให้คนที่อยากเปลี่ยนจากเกมหมุนไปสัมผัสเกมแบบโต๊ะและบรรยากาศเรียลไทม์ โดยยังใช้งานต่อจากบัญชีสมาชิกเดิม
      วันนี้สล็อต พรุ่งนี้คาสิโนก็เรื่องปกติ รสนิยมเปลี่ยนได้โดยไม่ต้องเปลี่ยนบัญชีตาม
    </p>
  </ContentBox>

  <ContentBox as="h2" title="ระบบออโต้ของ 888NEO ช่วยเรื่องฝากถอนอย่างไร">
    <p class="mb-4 text-left text-base leading-relaxed text-[#f3e3c6]">
      ระบบออโต้ช่วยให้ขั้นตอนฝากถอนและการตรวจสอบเครดิตทำผ่านบัญชีสมาชิกได้โดยตรง ลดจังหวะที่ต้องรอการจัดการแบบแมนนวล
      สมาชิกจึงดูสถานะรายการแล้วกลับเข้าเกมต่อได้จากหน้าเดิม ไม่ต้องสลับไปมาระหว่างการทำรายการกับการเลือกเกม
    </p>

    <p class="text-left text-base leading-relaxed text-[#f3e3c6]">
      เมื่อเชื่อมกับระบบของเรา การทำรายการจึงต่อเนื่องกับหน้าเกมมากขึ้น เงินมีหน้าที่เคลื่อนที่ ส่วนเจ้าของเงินไม่ควรต้องวิ่งตามหลายเมนู
    </p>
  </ContentBox>

  <ContentBox as="h2" title="ระบบสมาชิก 888NEO รวมเครดิตและประวัติรายการไว้ตรงไหน">
    <p class="mb-4 text-left text-base leading-relaxed text-[#f3e3c6]">
      หน้าสมาชิกเป็นจุดรวมเครดิต เกมที่ใช้งาน และข้อมูลรายการสำคัญ ช่วยให้ตรวจสอบบัญชีได้โดยไม่ต้องเปิดหลายหน้าพร้อมกัน
      คนที่สลับเล่นหลายหมวดจะตามข้อมูลได้ง่ายขึ้น เพราะของสำคัญควรจัดไว้เป็นที่ โดยเฉพาะเครดิต เรื่องนี้ไม่เหมาะกับเกมซ่อนหา
    </p>

    <p class="text-left text-base leading-relaxed text-[#f3e3c6]">
      หลังเข้าสู่ระบบผ่านมือถือด้วยยูสเดิม สมาชิกเลือกสล็อต เปิดคาสิโนสด เช็กเครดิต และจัดการข้อมูลบัญชีต่อได้ทันที
      และขอย้ำเสมอว่าไม่ควรส่งรหัสผ่านหรือรหัส OTP ให้บุคคลอื่นไม่ว่ากรณีใด เพราะทีมงานจริงไม่มีความจำเป็นต้องขอสองสิ่งนี้
    </p>
  </ContentBox>

  <ContentBox as="h2" title="888NEO เหมาะกับผู้เล่นแบบไหน">
    <p class="mb-4 text-left text-base leading-relaxed text-[#f3e3c6]">
      888NEO เหมาะกับคนที่ชอบเปลี่ยนระหว่างสล็อตและคาสิโนสด พร้อมต้องการระบบออโต้และการใช้งานผ่านมือถือในบัญชีเดียว
      เลือกเกมที่ตรงอารมณ์ จัดการเครดิต แล้วกลับเข้าเล่นต่อจากอุปกรณ์ที่สะดวกได้เลย โดยไม่ต้องเปิดบัญชีที่สองหรือจำรหัสเพิ่มอีกชุด
    </p>

    <p class="text-left text-base leading-relaxed text-[#f3e3c6]">
      ทางเข้าเว็บหลักเชื่อมไปยังล็อกอิน เกม และระบบบัญชี รองรับทั้งมือถือและคอมพิวเตอร์ด้วยข้อมูลสมาชิกเดิม
      การใช้ทางเข้าหลักยังช่วยลดความสับสนจากชื่อเว็บใกล้เคียงบนผลค้นหา ความหรูไม่จำเป็นต้องซับซ้อน บางครั้งแค่ทุกอย่างอยู่ถูกที่ก็พอ
    </p>
  </ContentBox>

  <Navfoot />
</MainLayout>
