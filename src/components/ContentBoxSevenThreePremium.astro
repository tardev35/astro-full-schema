---
export interface Props {
  title?: string;
  titleleft?: string;
  titleright?: string;
}
const { title, titleleft, titleright } = Astro.props;
const rightHeading = titleright ?? title;
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#e8a13c]/30 bg-gradient-to-br from-[#12251b]/92 to-[#0b1610]/88 p-8 text-[#f1e6d3] shadow-[0_10px_30px_rgba(232,161,60,0.16)] backdrop-blur-xl transition-all duration-500 hover:border-[#e8a13c]/60 hover:shadow-[0_15px_40px_rgba(232,161,60,0.28)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-24 -left-24 -z-10 h-48 w-48 rounded-full bg-[#e8a13c]/20 blur-[60px] transition-all duration-500 group-hover:bg-[#f7cf8a]/30">
    </div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-24 -bottom-24 -z-10 h-48 w-48 rounded-full bg-[#0a4a2e]/45 blur-[60px] transition-all duration-500 group-hover:bg-[#0f8f57]/40">
    </div>

    <div class="grid grid-cols-1 gap-10 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f1e6d3]">
        {
          titleleft && (
            <h2 class="bg-gradient-to-r from-[#f7cf8a] via-[#e8a13c] to-[#0f8f57] bg-clip-text text-center text-xl leading-normal font-black tracking-widest text-transparent uppercase md:text-left">
              {titleleft}
            </h2>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f1e6d3] md:border-l md:border-[#0a4a2e] md:pl-10">
        {
          rightHeading && (
            <h2 class="mb-2 bg-gradient-to-r from-[#f7cf8a] via-[#e8a13c] to-[#0f8f57] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{rightHeading}</h2>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
