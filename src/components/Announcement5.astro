---
const {
  message = "BABYSHARK8899 เว็บนอกลิขสิทธิ์แท้ ให้บริการเข้าเล่นเกมสล็อตผ่านระบบตรง ยูสเดียวเลือกค่ายที่เปิดให้บริการได้ทันที • จ่ายเต็มทุกยอดทุกบิล ไม่มีลดทอนยอดที่สมาชิกได้รับจากระบบ • ตรวจสอบยอดคงเหลือ ยอดถอน และสถานะรายการได้ก่อนยืนยันทุกครั้ง • ฝากถอนออโต้ ประมวลผลอัตโนมัติ ไม่ต้องรอเจ้าหน้าที่ตรวจยอดทีละรายการ • ดูรายละเอียดเกม ตารางจ่าย ฟีเจอร์โบนัส และข้อมูล RTP ได้จากหน้าของเกมโดยตรง • อ่านเงื่อนไขของบัญชี โบนัส และโปรโมชั่นให้ครบก่อนทำรายการ โดยเฉพาะวงเงินต่อรายการและข้อกำหนดของสิทธิ์ที่กำลังใช้งาน • เข้าใช้งานได้ทั้งมือถือ แท็บเล็ต และคอมพิวเตอร์ ด้วยข้อมูลบัญชีชุดเดียวกัน",
} = Astro.props;

const SCROLL_PX_PER_SEC = 50;
const PX_PER_CHAR = 6.2;
const TRAILING_PX = 81;
const scrollSeconds = Math.max(12, Math.round((message.length * PX_PER_CHAR + TRAILING_PX) / SCROLL_PX_PER_SEC));
---

<div class="mx-auto w-full max-w-7xl px-4 py-3 font-sans">
  <div class="relative overflow-hidden rounded-md border border-[#0b83fa]/45 bg-[#000b24] shadow-[0_0_15px_rgba(11,131,250,0.25)]">
    <div aria-hidden="true" class="absolute top-0 -left-4 h-full w-8 -skew-x-12 bg-gradient-to-b from-[#38a9ff] to-[#00397f]"></div>
    <div aria-hidden="true" class="absolute top-0 -right-4 h-full w-8 -skew-x-12 bg-[#e8202a]/25"></div>

    <div class="flex items-center">
      <div class="relative z-10 flex w-12 shrink-0 items-center justify-center bg-gradient-to-b from-[#38a9ff] to-[#00397f] py-2.5">
        <span aria-hidden="true" class="animate-pulse text-lg drop-shadow-[0_0_5px_rgba(158,212,255,0.85)]">🦈</span>
      </div>

      <div class="marquee-container relative flex-1 overflow-hidden py-2.5 pr-6">
        <div aria-hidden="true" class="pointer-events-none absolute top-0 left-0 z-10 h-full w-8 bg-gradient-to-r from-[#000b24] to-transparent"></div>
        <div aria-hidden="true" class="pointer-events-none absolute top-0 right-0 z-10 h-full w-12 bg-gradient-to-l from-[#000b24] to-transparent"></div>

        <div class="marquee-content inline-block pl-4 text-sm font-bold tracking-wide whitespace-nowrap text-[#e6f2ff]" style={`animation-duration:${scrollSeconds}s`}>
          <span class="mr-8 inline-flex items-center gap-2"><span aria-hidden="true" class="h-1.5 w-1.5 rounded-full bg-[#e8202a] shadow-[0_0_5px_rgba(232,32,42,0.85)]"></span>{message}</span>
          <span aria-hidden="true" class="mr-8 inline-flex items-center gap-2"><span class="h-1.5 w-1.5 rounded-full bg-[#e8202a] shadow-[0_0_5px_rgba(232,32,42,0.85)]"></span>{message}</span>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .marquee-content {
    animation: marquee 25s linear infinite;
  }
  .marquee-container:hover .marquee-content {
    animation-play-state: paused;
  }
  @keyframes marquee {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee-content {
      animation: none;
    }
  }
</style>
