---
const providers = [
  { name: "สล็อตแตกหนัก", desc: "รวมเกมที่อัตราจ่ายสูง ไหลดีเหมือนเจอบ่อน้ำมันส่วนตัว แตกหนักแตกจริงทุกเกม", tag: "อัตราจ่ายสูง", icon: "🛢️" },
  { name: "สล็อตซื้อฟรีสปิน", desc: "สายลุ้นโบนัสกดเข้าฟีเจอร์ได้เลย ตัวคูณซ้อนหลายชั้นตามจังหวะของเกมจริงๆ", tag: "ฟีเจอร์แน่น", icon: "🔥" },
  { name: "สล็อตคลาสสิกรอบสั้น", desc: "รูปแบบเข้าใจง่าย จบไว เหมาะกับการบริหารเงินหน้าตักแบบไม่มีเงื่อนไขผูกมัด", tag: "จบไว", icon: "🍒" },
  { name: "คาสิโนสด", desc: "ถ่ายทอดสดจากโต๊ะจริง ภาพคมไม่กระตุก เหมือนเดินเข้าคาสิโนส่วนตัวระดับ VIP", tag: "สดจากโต๊ะจริง", icon: "🎴" },
  { name: "เกมยิงปลา", desc: "ยิงเก็บรางวัลได้ต่อเนื่อง ระบบเสถียรเหมือนถนนไฮเวย์ในดูไบที่เรียบกริบ", tag: "เล่นเพลิน", icon: "🐟" },
  { name: "เกมใหม่สำหรับมือถือ", desc: "เมนูภาษาไทยชัดเจน อ่านง่ายสบายตา รองรับทั้ง iOS และ Android ลื่นไหลไม่มีสะดุด", tag: "อัปเดตต่อเนื่อง", icon: "📱" },
  { name: "เกมสายทุนน้อย", desc: "เริ่มด้วยเงินติดบัญชีแค่ 1 บาทก็เข้าเล่นได้ เพราะดวงไม่ได้เลือกข้างคนรวยเสมอไป", tag: "เริ่ม 1 บาท", icon: "🪙" },
];
---

<section aria-label="หมวดเกมและบริการที่ GODDUBAI รวมไว้ให้ครบ" class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#f7cf8a] via-[#e8a13c] to-[#0f8f57] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      หมวดเกมและบริการที่ <span class="text-[#e8a13c]">GODDUBAI</span> รวมไว้ให้ครบ
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#e8a13c] to-transparent"></div>
  </div>

  <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4 lg:gap-5 xl:grid-cols-7">
    {
      providers.map((provider) => (
        <a
          href="/register"
          class="group relative flex flex-col items-center justify-center overflow-hidden rounded-2xl border border-[#e8a13c]/25 bg-[#0f1d16]/92 p-5 shadow-[0_10px_30px_rgba(11,22,16,0.55)] backdrop-blur-md transition-all duration-300 hover:-translate-y-2 hover:border-[#e8a13c]/50 hover:bg-[#12251b]/95 hover:shadow-[0_15px_40px_rgba(232,161,60,0.3)]">
          <div class="pointer-events-none absolute inset-0 bg-[#0a4a2e]/25 opacity-0 transition-opacity duration-300 group-hover:opacity-100" />

          <div class="absolute top-2 right-2 z-10 rounded-full bg-gradient-to-r from-[#f7cf8a] via-[#e8a13c] to-[#a8611a] px-2 py-0.5 text-[9px] font-black tracking-wide whitespace-nowrap text-[#091310] shadow-sm transition-transform duration-300 group-hover:scale-110">
            {provider.tag}
          </div>

          <div aria-hidden="true" class="mb-3 text-4xl transition-transform duration-300 group-hover:scale-125 group-hover:rotate-3">
            {provider.icon}
          </div>
          <p class="text-center text-sm font-black text-[#f1e6d3] transition-colors group-hover:text-[#f7cf8a]">{provider.name}</p>
          <p class="mt-1 text-center text-[10px] text-[#f1e6d3]/70">{provider.desc}</p>

          <span class="relative z-10 mt-4 block w-full rounded-full border border-[#e8a13c]/25 bg-[#0b1610] py-1.5 text-center text-[11px] font-bold text-[#e8a13c] shadow-inner transition-colors duration-300 group-hover:border-[#e8a13c]/50 group-hover:bg-gradient-to-r group-hover:from-[#f7cf8a] group-hover:via-[#e8a13c] group-hover:to-[#a8611a] group-hover:text-[#091310]">
            เข้าดูเกม
          </span>
        </a>
      ))
    }
  </div>
</section>
