---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";
const headingTone = HeadingTag === "h1" ? "bg-gradient-to-b from-white via-[#ffe08a] to-[#f5c542]" : "bg-gradient-to-r from-[#e8e8ee] via-[#ffe08a] to-[#e061e3]";
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#5a1a60] bg-[#1c0620] p-8 text-left text-base leading-relaxed text-[#ead9ec] shadow-[0_10px_30px_rgba(0,0,0,0.35)] transition-all duration-500 hover:border-[#8a2f8f] hover:shadow-[0_15px_40px_rgba(193,63,196,0.28)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#c13fc4]/20 blur-[55px] transition-all duration-500 group-hover:bg-[#c13fc4]/30"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#f5c542]/15 blur-[55px] transition-all duration-500 group-hover:bg-[#f5c542]/25"></div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#5a1a60] pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffe08a] via-[#c13fc4] to-[#62035b] shadow-[0_0_10px_rgba(193,63,196,0.45)]" />
          <HeadingTag class={`${headingTone} bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
