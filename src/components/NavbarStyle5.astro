---
import { Picture } from "astro:assets";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });

const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

const currentPath = Astro.url.pathname;

const isActive = (path: string) => {
  if (path === "/") return currentPath === "/";
  return currentPath.startsWith(path);
};
---

<header class="sticky top-0 z-50 w-full font-sans shadow-[0_4px_20px_rgba(0,0,0,0.8)]">
  <div class="hidden items-center justify-between border-b border-red-900/50 bg-[#450a0a] px-6 py-1.5 text-xs font-medium tracking-wide lg:flex xl:px-10">
    <div class="flex items-center gap-2 text-white/80">
      <span class="text-sm text-red-500">✦</span>
      ยินดีต้อนรับสู่ HYDRA888auto สล็อตออโต้ที่ดีที่สุด ฝาก-ถอน 3 วินาที
    </div>
    <div class="flex items-center gap-5">
      <a href="/login" class="flex items-center gap-1 text-white/80 transition-colors hover:text-red-500">🔒 เข้าสู่ระบบ</a>
      <a href="/register" class="flex items-center gap-1 font-bold text-yellow-400 drop-shadow-[0_0_5px_rgba(220,38,38,0.5)] transition-colors hover:text-white">🔥 สมัครใหม่รับโบนัส 100%</a>
    </div>
  </div>

  <nav class="relative z-[70] flex h-[70px] w-full items-center justify-between border-b border-red-900/40 bg-[#000]/95 px-4 shadow-xl backdrop-blur-md xl:px-10">
    <a href="/" class="z-50 flex-shrink-0 transition-transform hover:scale-105">
      <Picture
        src={mainLogo!}
        alt="HYDRA888 Logo"
        loading="eager"
        fetchpriority="high"
        class="h-[35px] w-auto drop-shadow-[0_0_10px_rgba(220,38,38,0.3)] xl:h-[40px]"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
      />
    </a>

    <div class="hidden h-full items-center gap-6 lg:flex xl:gap-10">
      {
        [
          { name: "หน้าแรก", path: "/" },
          { name: "โปรโมชั่น", path: "/promotion" },
          { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
          { name: "ทางเข้า", path: "/ทางเข้า" },
          { name: "ติดต่อเรา", path: "/contact-us" },
        ].map((item) => (
          <a
            href={item.path}
            class={`group relative flex h-full items-center text-sm font-bold transition-colors xl:text-base ${isActive(item.path) ? "text-red-500 drop-shadow-[0_0_8px_rgba(220,38,38,0.5)]" : "text-white/80 hover:text-red-500"}`}>
            <span>{item.name}</span>
            <div
              class={`absolute bottom-[-1px] left-0 h-[3px] w-full origin-left bg-gradient-to-r from-red-600 to-red-400 transition-transform duration-300 ${isActive(item.path) ? "scale-x-100" : "scale-x-0 group-hover:scale-x-100"}`}
            />
          </a>
        ))
      }
    </div>

    <div class="z-50 flex items-center gap-4">
      <a
        href="/register"
        class="hidden items-center justify-center rounded-full bg-gradient-to-r from-red-700 via-red-600 to-red-800 px-6 py-2 text-sm font-extrabold text-white shadow-[0_0_15px_rgba(220,38,38,0.4)] transition-all hover:scale-105 lg:flex">
        สมัครสมาชิก
      </a>

      <button id="hamburger-btn" class="relative flex h-[40px] w-[40px] flex-col items-end justify-center gap-[6px] p-2 lg:hidden" aria-label="Menu">
        <span class="line-1 h-[2px] w-6 origin-center rounded-full bg-red-500 shadow-sm transition-all duration-300"></span>
        <span class="line-2 h-[2px] w-4 origin-center rounded-full bg-red-500 shadow-sm transition-all duration-300"></span>
      </button>
    </div>
  </nav>

  <div id="fullscreen-menu" class="pointer-events-none fixed inset-0 z-[60] flex flex-col items-center justify-center bg-[#050000]/98 opacity-0 backdrop-blur-2xl transition-opacity duration-500">
    <div class="flex w-full flex-col items-center space-y-6 px-6">
      {
        [
          { name: "หน้าแรก", path: "/" },
          { name: "โปรโมชั่น", path: "/promotion" },
          { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
          { name: "ทางเข้า", path: "/ทางเข้า" },
          { name: "ติดต่อเรา", path: "/contact-us" },
        ].map((item) => (
          <a
            href={item.path}
            class={`fs-item text-3xl font-black tracking-widest uppercase transition-all duration-300 ${isActive(item.path) ? "text-red-500 drop-shadow-[0_0_10px_rgba(220,38,38,0.6)]" : "text-white/80 hover:text-white"}`}>
            {item.name}
          </a>
        ))
      }

      <div class="fs-item mt-4 flex w-full max-w-[250px] flex-col gap-4 pt-8">
        <a
          href="/register"
          class="flex w-full items-center justify-center rounded-full bg-gradient-to-r from-red-700 to-red-500 py-3.5 text-lg font-extrabold text-white shadow-[0_0_20px_rgba(220,38,38,0.4)]">
          สมัครสมาชิก
        </a>
        <a href="/login" class="flex w-full items-center justify-center rounded-full border-2 border-red-500/40 py-3.5 text-lg font-bold text-red-500 transition-colors hover:bg-red-500/10">
          เข้าสู่ระบบ
        </a>
      </div>
    </div>
  </div>
</header>

<style is:global>
  nav,
  header {
    font-family: kanit, sans-serif !important;
  }
  /* Hamburger Animation */
  #hamburger-btn.active .line-1 {
    transform: translateY(4px) rotate(45deg);
  }
  #hamburger-btn.active .line-2 {
    width: 24px;
    transform: translateY(-4px) rotate(-45deg);
  }

  /* FS Menu Animation */
  .fs-item {
    opacity: 0;
    transform: translateY(30px) scale(0.9);
    transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .fs-item.show {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
  .fs-item:nth-child(1) {
    transition-delay: 0.1s;
  }
  .fs-item:nth-child(2) {
    transition-delay: 0.15s;
  }
  .fs-item:nth-child(3) {
    transition-delay: 0.2s;
  }
  .fs-item:nth-child(4) {
    transition-delay: 0.25s;
  }
  .fs-item:nth-child(5) {
    transition-delay: 0.3s;
  }
  .fs-item:nth-child(6) {
    transition-delay: 0.4s;
  }
</style>

<script>
  const hamburgerBtn = document.getElementById("hamburger-btn");
  const fsMenu = document.getElementById("fullscreen-menu");
  const fsItems = document.querySelectorAll(".fs-item");

  const toggleFsMenu = () => {
    hamburgerBtn?.classList.toggle("active");
    fsMenu?.classList.toggle("opacity-0");
    fsMenu?.classList.toggle("pointer-events-none");

    if (!fsMenu?.classList.contains("opacity-0")) {
      document.body.style.overflow = "hidden";
      fsItems.forEach((item) => item.classList.add("show"));
    } else {
      document.body.style.overflow = "";
      fsItems.forEach((item) => item.classList.remove("show"));
    }
  };

  hamburgerBtn?.addEventListener("click", toggleFsMenu);
  fsItems.forEach((item) => {
    item.addEventListener("click", () => {
      if (!fsMenu?.classList.contains("opacity-0")) toggleFsMenu();
    });
  });
</script>
