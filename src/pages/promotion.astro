---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement6.astro";

import { Picture } from "astro:assets";
import image1 from "../assets/pro1.jpg";
import image2 from "../assets/pro2.jpg";
import image3 from "../assets/pro3.jpg";
import image4 from "../assets/pro4.jpg";
---

<MainLayout
  title="โปรโมชั่น LONDON45 รวมสิทธิพิเศษสุดคุ้ม โบนัสสมาชิกใหม่"
  ,
  description="โปรโมชั่น LONDON45 อัปเดต ล่าสุด รวมโบนัสสล็อตและข้อเสนอสุดพิเศษสำหรับสมาชิก เงื่อนไขเป็นธรรม ถอนง่ายไม่ต้องทำเทิร์นสูง เพิ่มกิจกรรมแจกหนักตลอดเดือน">
  <Announcement />
  <ContentBox>
    <h1 class="mb-7 text-3xl">โปรโมชั่น LONDON45 รวมสิทธิพิเศษสุดคุ้ม โบนัสสมาชิกใหม่</h1>

    <div class="mb-5 grid grid-cols-2 gap-5 md:grid-cols-3">
      <div class="flex flex-col gap-4">
        <Picture
          src={image1}
          alt="กิจกรรมแนะนำเพื่อน Panama888 รับโบนัสสูงสุด 10,000 บาท"
          loading="lazy"
          fetchpriority="low"
          widths={[200, 400, 600]}
          sizes="(max-width: 768px) 100vw, 33vw"
          class="mx-auto h-auto w-full max-w-[400px] object-contain shadow-xl"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={60}
        />
      </div>

      <div class="flex flex-col gap-4">
        <Picture
          src={image2}
          alt="โปรโมชั่น Panama888 แจกรางวัลใหญ่ประจำเดือน รวมมูลค่ากว่า 1,000,000 บาท"
          loading="lazy"
          fetchpriority="low"
          widths={[200, 400, 600]}
          sizes="(max-width: 768px) 100vw, 33vw"
          class="mx-auto h-auto w-full max-w-[400px] object-contain shadow-xl"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />
      </div>

      <div class="flex flex-col gap-4">
        <Picture
          src={image3}
          alt="โปรโมชั่นสะสมเพชร Panama888 แลกรางวัลใหญ่ iPhone ทองคำ และรถมอเตอร์ไซค์"
          loading="lazy"
          fetchpriority="low"
          widths={[200, 400, 600]}
          sizes="(max-width: 768px) 100vw, 33vw"
          class="mx-auto h-auto w-full max-w-[400px] object-contain shadow-xl"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />
      </div>

      <div class="flex flex-col gap-4">
        <Picture
          src={image4}
          alt="สะสมเพชรแลกรางวัลใหญ่กับ Panama888 ยิ่งเล่นยิ่งได้เพชร"
          loading="lazy"
          fetchpriority="low"
          widths={[200, 400, 600]}
          sizes="(max-width: 768px) 100vw, 33vw"
          class="mx-auto h-auto w-full max-w-[400px] object-contain shadow-xl"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />
      </div>
    </div>
  </ContentBox>
</MainLayout>
<Navfoot />
