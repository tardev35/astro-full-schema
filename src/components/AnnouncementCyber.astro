---
const {
  message = "GODKINGKONG เว็บตรงเกมสล็อตแตกหนัก เกมแท้ส่งตรงจากค่ายแม่ ไม่ปรับ RTP ไม่ล็อกยูส • โบนัสแรง แตกง่าย จ่ายจริงทุกยอด ไม่แบ่งจ่าย • ฝากถอนออโต้ไม่เกิน 3 วินาที รองรับวอเล็ทไม่มีขั้นต่ำ • สมัครเองได้ทันที ไม่ต้องส่งบัตรประชาชน",
} = Astro.props;
---

<div class="mx-auto w-full max-w-7xl px-4 py-3 font-sans">
  <div
    class="relative flex overflow-hidden border border-[#2fe35f]/50 bg-[#050f09]/90 shadow-[0_0_15px_rgba(47,227,95,0.3)] backdrop-blur-md"
    style="clip-path: polygon(15px 0, 100% 0, calc(100% - 15px) 100%, 0 100%);">
    <div
      class="relative z-10 flex shrink-0 items-center justify-center bg-gradient-to-r from-[#0b6b34] to-[#2fe35f] px-6 py-2.5 font-black text-[#04170b]"
      style="clip-path: polygon(0 0, 100% 0, calc(100% - 10px) 100%, 0 100%);">
      ประกาศ
    </div>

    <div class="marquee-container relative flex-1 overflow-hidden py-2.5 pr-6">
      <div class="pointer-events-none absolute top-0 left-0 z-10 h-full w-8 bg-gradient-to-r from-[#050f09] to-transparent"></div>

      <div class="marquee-content inline-block pl-4 text-sm font-bold tracking-widest whitespace-nowrap text-[#ddf3e2]">
        <span class="mr-8 inline-flex items-center gap-2"><span class="h-2 w-2 bg-[#f0c43a] shadow-[0_0_8px_rgba(240,196,58,1)]"></span>{message}</span>
        <span class="mr-8 inline-flex items-center gap-2"><span class="h-2 w-2 bg-[#f0c43a] shadow-[0_0_8px_rgba(240,196,58,1)]"></span>{message}</span>
      </div>
    </div>
  </div>
</div>

<style>
  .marquee-content {
    animation: marquee 20s linear infinite;
  }
  .marquee-container:hover .marquee-content {
    animation-play-state: paused;
  }
  @keyframes marquee {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee-content {
      animation: none;
    }
  }
</style>
