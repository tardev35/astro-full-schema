---
const reviews = [
  {
    name: "สมาชิกที่ใช้บัญชีเดียวจัดการทุกอย่าง",
    role: "รวมสล็อต คาสิโน และเครดิตไว้ที่เดียว",
    stars: 5,
    tag: "ระบบสมาชิกบัญชีเดียว",
    content:
      "ที่ถูกใจคือไม่ต้องเปิดหลายที่ครับ เข้าสู่ระบบครั้งเดียวแล้วเลือกเกม เช็กยอด ดูสิทธิ์โปร หรือย้อนดูประวัติรายการได้จากหน้าเดียว วันไหนอยากหมุนสล็อตก็หมุน วันไหนอยากเปลี่ยนไปเล่นเกมโต๊ะก็เปลี่ยนหมวดต่อได้เลย ใช้เครดิตชุดเดิมไม่ต้องสลับบัญชี",
    avatar: "🐐",
  },
  {
    name: "สมาชิกที่ทำรายการเองทุกครั้ง",
    role: "ฝากถอนผ่านระบบออโต้จากหน้าบัญชี",
    stars: 5,
    tag: "ฝากถอนออโต้",
    content:
      "ทำรายการผ่านบัญชีได้เองเลยค่ะ ไม่ต้องไล่แจ้งใครก่อน แล้วยอดเครดิตกับข้อมูลรายการอยู่ในระบบเดียวกัน เลยตามได้ง่ายว่าอันไหนทำไปแล้ว ขั้นตอนสั้นลงจริง กลับเข้าเกมต่อได้ไวโดยไม่ต้องออกไปทำอย่างอื่นก่อน",
    avatar: "⚡",
  },
  {
    name: "สมาชิกใหม่ที่เริ่มจากหน้าโปรโมชั่น",
    role: "เช็กสิทธิ์เครดิตฟรีก่อนตัดสินใจสมัคร",
    stars: 5,
    tag: "โปรโมชั่นและเครดิตฟรี",
    content:
      "ผมเปิดหน้าโปรโมชั่นดูก่อนสมัครครับ มีทั้งสิทธิ์ของสมาชิกใหม่และกิจกรรมตามช่วงเวลา แต่ละอันเงื่อนไขไม่เหมือนกันทั้งเกมที่ร่วม ยอดเริ่มต้น และเทิร์น เลยเลือกอันที่ตรงกับที่ตัวเองเล่นจริง ไม่ต้องไล่กดรับทุกอันที่ตัวเลขใหญ่",
    avatar: "🎁",
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label="เสียงจากสมาชิก GOAT888" class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#ffe6a3] via-[#f5c451] to-[#ffa3ee] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      เสียงจากสมาชิก <span class="text-[#f5c451]">GOAT888</span>
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#f5c451] to-transparent"></div>
  </div>

  <div class="mx-auto mb-8 flex max-w-md items-center justify-center gap-5 rounded-2xl border border-[#f5c451]/25 bg-[#1a0414]/92 px-6 py-4 shadow-[0_10px_30px_rgba(10,2,8,0.5)] backdrop-blur-xl">
    <div class="flex flex-col items-center">
      <span class="bg-gradient-to-b from-[#ffe6a3] to-[#b07d1c] bg-clip-text text-4xl leading-none font-black text-transparent">{average}</span>
      <span class="mt-1 text-[10px] font-bold tracking-widest text-[#f7e3f4]/70 uppercase">คะแนนเฉลี่ย</span>
    </div>
    <div class="h-12 w-px bg-[#4a0640]"></div>
    <div class="flex flex-col gap-1.5">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#f5c451]" : "text-[#4a0640]"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#f7e3f4]/70">คะแนนเฉลี่ย {average} จาก 5 ดาว จากการใช้งานจริงของสมาชิก {reviews.length} ด้าน</span>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
    {
      reviews.map((review) => (
        <article class="group relative isolate flex flex-col gap-4 overflow-hidden rounded-2xl border border-[#f5c451]/25 bg-[#1a0414]/92 p-6 text-left shadow-[0_10px_30px_rgba(10,2,8,0.5)] backdrop-blur-xl transition-all duration-300 hover:-translate-y-1 hover:border-[#f5c451]/55 hover:shadow-[0_15px_40px_rgba(245,196,81,0.30)]">
          <span class="absolute inset-y-0 left-0 -z-10 w-1 bg-gradient-to-b from-[#ffe6a3] to-[#ff3ddb] opacity-80 transition-opacity duration-300 group-hover:opacity-100" />
          <span class="pointer-events-none absolute -top-14 -right-14 -z-10 h-32 w-32 rounded-full bg-[#ff3ddb]/45 blur-[50px] transition-all duration-300 group-hover:bg-[#f5c451]/25" />

          <div class="flex items-center justify-between gap-3">
            <span class="inline-flex items-center gap-1.5 rounded-full border border-[#f5c451]/25 bg-[#2b0722] px-3 py-1 text-[10px] font-bold tracking-widest text-[#f5c451] uppercase">
              <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#f5c451]" />
              {review.tag}
            </span>
            <span class="flex gap-0.5 text-sm">
              <span aria-hidden="true" class="flex gap-0.5">
                {Array.from({ length: 5 }).map((_, i) => (
                  <span class={i < review.stars ? "text-[#f5c451]" : "text-[#4a0640]"}>★</span>
                ))}
              </span>
              <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
            </span>
          </div>

          <p class="text-left text-base leading-relaxed text-[#f7e3f4]">{review.content}</p>

          <div class="mt-auto flex items-center gap-3 border-t border-[#4a0640] pt-4">
            <span
              aria-hidden="true"
              class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#f5c451]/30 bg-gradient-to-br from-[#ffe6a3] via-[#f5c451] to-[#4a0640] text-xl shadow-inner transition-transform duration-300 group-hover:scale-110">
              {review.avatar}
            </span>
            <span class="flex flex-col">
              <span class="text-sm font-black text-[#f7e3f4] transition-colors group-hover:text-[#ffe6a3]">{review.name}</span>
              <span class="text-[10px] font-bold tracking-wider text-[#f7e3f4]/70 uppercase">{review.role}</span>
            </span>
          </div>
        </article>
      ))
    }
  </div>
</section>
