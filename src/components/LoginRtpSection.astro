---
import ContentBoxTwo from "./ContentBoxTwo.astro";

const steps = [
  { icon: "🔑", name: "เข้าสู่ระบบด้วยยูสเดิม", detail: "ใช้เบอร์โทรศัพท์หรือยูสเซอร์เนมที่สมัครไว้ เข้าได้ทั้งจากมือถือและคอม", tag: "ขั้นที่ 1" },
  { icon: "🎰", name: "เลือกค่ายสล็อตหรือห้องคาสิโนสด", detail: "ไล่ดูค่ายที่เปิดอยู่ก่อน แล้วค่อยเลือกเกมหรือโต๊ะที่ตรงกับสไตล์ของตัวเอง", tag: "ขั้นที่ 2" },
  { icon: "🎁", name: "เช็กโปรสมาชิกใหม่ที่เปิดอยู่", detail: "ดูยอดรับ เงื่อนไข เทิร์น และช่วงเวลาที่ใช้ได้จากหน้าสมาชิกก่อนกดรับ", tag: "ขั้นที่ 3" },
  { icon: "💳", name: "จัดการเครดิตผ่านระบบออโต้", detail: "ส่งรายการผ่านวอลเล็ทหรือบัญชีธนาคารจากหน้าเดิม ดูยอดคงเหลือก่อนกลับไปปั่นต่อ", tag: "ขั้นที่ 4" },
  { icon: "🧾", name: "ย้อนดูประวัติรายการ", detail: "เครดิต โปร และรายการฝากถอนรวมอยู่ในยูสเดียว ตรวจย้อนหลังได้เอง", tag: "ขั้นที่ 5" },
];

const chips = ["สล็อตออโต้", "ไม่มีขั้นต่ำ", "รองรับวอลเล็ท", "คาสิโนสด", "บาคาร่า", "ฝากถอนออโต้", "ยูสเดียว"];
---

<ContentBoxTwo titleleft="เข้าสู่ระบบ PIGAUTO" titleright="ลำดับการใช้งานบนหน้าสมาชิก" label="เข้าสู่ระบบ PIGAUTO และลำดับการใช้งานบนหน้าสมาชิก">
  <div slot="left" class="flex h-full flex-col gap-4">
    <div class="relative overflow-hidden rounded-2xl border border-[#6b2020] bg-[#280707] p-6 shadow-[0_10px_30px_rgba(239,68,68,0.18)]">
      <div aria-hidden="true" class="pointer-events-none absolute -top-10 -right-10 h-32 w-32 rounded-full bg-[#ef4444]/20 blur-[50px]"></div>

      <div class="relative z-10 mb-5 flex items-center gap-3">
        <span
          aria-hidden="true"
          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#6b2020] bg-gradient-to-br from-[#f87171] via-[#ef4444] to-[#7f1d1d] text-xl shadow-inner">
          🎰
        </span>
        <div class="flex flex-col">
          <p class="text-base font-black text-[#ffe9a8]">เข้าสู่ระบบแล้วเลือกค่ายหรือโต๊ะที่ชอบต่อได้ทันที</p>
          <span class="text-[11px] text-[#cfa79c]">ยูสเดียวใช้เข้าทั้งสล็อตออโต้ คาสิโนสด และบาคาร่า เช็กเครดิต ดูโปร และย้อนดูประวัติรายการของ PIGAUTO ได้จากหน้าเดียว</span>
        </div>
      </div>

      <div class="relative z-10 flex flex-col gap-3.5">
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#f87171]">👤</span>
          <input
            type="text"
            placeholder="เบอร์โทรศัพท์ / ยูสเซอร์เนม"
            class="w-full rounded-xl border border-[#6b2020] bg-[#1a0303] py-3 pr-4 pl-12 text-[#f7e2d6] transition-all outline-none placeholder:text-[#cfa79c] focus:border-[#ef4444] focus:ring-1 focus:ring-[#ef4444]/40"
          />
        </div>
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#f87171]">🔑</span>
          <input
            type="password"
            placeholder="รหัส PIN 4 หลัก"
            class="w-full rounded-xl border border-[#6b2020] bg-[#1a0303] py-3 pr-4 pl-12 text-[#f7e2d6] transition-all outline-none placeholder:text-[#cfa79c] focus:border-[#ef4444] focus:ring-1 focus:ring-[#ef4444]/40"
          />
        </div>

        <div class="flex items-center justify-between px-1 text-xs">
          <label class="flex items-center gap-2 text-[#cfa79c]">
            <input type="checkbox" class="h-3.5 w-3.5 rounded border-[#6b2020] bg-[#1a0303] accent-[#ef4444]" />
            จดจำฉันไว้
          </label>
          <a href="/login" class="text-[#cfa79c] transition-colors hover:text-[#f87171]">ลืมรหัส PIN?</a>
        </div>

        <button
          class="mt-1 w-full rounded-xl border border-[#ef4444]/50 bg-gradient-to-r from-[#ffd75e] via-[#f5c542] to-[#a3610c] p-3.5 font-black text-[#1a0303] shadow-[0_10px_30px_rgba(239,68,68,0.28)] transition-all hover:scale-[1.02] hover:shadow-[0_15px_40px_rgba(239,68,68,0.36)]">
          เข้าสู่ระบบ
        </button>

        <div class="flex items-center gap-3 py-1 text-[11px] text-[#cfa79c]">
          <span class="h-px flex-1 bg-[#6b2020]"></span>
          หรือ
          <span class="h-px flex-1 bg-[#6b2020]"></span>
        </div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] p-3 text-sm font-bold text-white shadow-md transition-all hover:scale-[1.02]">
          <span aria-hidden="true">💬</span> ทักไลน์ทีมงานตลอด 24 ชั่วโมง
        </a>

        <div class="mt-1 flex items-center justify-between px-1">
          <div class="flex gap-2">
            <span class="rounded-full border border-[#6b2020] bg-[#1a0303] px-2.5 py-1 text-[10px] font-bold text-[#f87171]"><span aria-hidden="true">🔒</span> เข้ารหัสข้อมูล</span>
            <span class="rounded-full border border-[#a3610c]/60 bg-[#241206] px-2.5 py-1 text-[10px] font-bold text-[#ffe9a8]"><span aria-hidden="true">🕐</span> ใช้งานได้ตลอด 24 ชม.</span>
          </div>
          <a href="/register" class="text-xs font-bold text-[#cfa79c] transition-colors hover:text-[#f87171]">สมัครสมาชิกใหม่</a>
        </div>
      </div>
    </div>
  </div>

  <div slot="right" class="h-full">
    <div class="flex h-full flex-col rounded-2xl border border-[#6b2020] bg-[#280707] p-5 shadow-[0_10px_30px_rgba(239,68,68,0.18)]">
      <div class="mb-5 flex items-center justify-between gap-3">
        <div>
          <span class="text-xs font-bold tracking-wide text-[#cfa79c]">ลำดับการใช้งานที่ PIGAUTO วางไว้บนหน้าสมาชิก หลังเข้าสู่ระบบด้วยยูสเดิม</span>
          <div class="bg-gradient-to-r from-[#f87171] via-[#ffe2d8] to-[#f5c542] bg-clip-text text-2xl font-black text-transparent sm:text-3xl">สล็อตออโต้ • ไม่มีขั้นต่ำ • รองรับวอลเล็ท</div>
        </div>
        <span class="flex items-center gap-1.5 self-start rounded-full border border-green-500/40 bg-green-900/20 px-2.5 py-1">
          <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-green-400 shadow-[0_0_8px_rgba(74,222,128,0.7)]"></span>
          <span class="text-[10px] font-bold tracking-widest text-green-400 uppercase">Live</span>
        </span>
      </div>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#cfa79c] uppercase">
        <span>ขั้นตอนการใช้งาน</span>
        <span>ลำดับ</span>
      </div>

      <div class="flex flex-1 flex-col gap-2.5">
        {
          steps.map((s) => (
            <div class="rounded-xl border border-[#6b2020] bg-[#1a0303] px-3.5 py-2.5 transition-colors hover:border-[#ef4444]/60 hover:bg-[#33090a]">
              <div class="flex items-center justify-between gap-2 text-sm">
                <span class="flex min-w-0 items-center gap-2 font-bold text-[#ffe2d8]">
                  <span aria-hidden="true" class="w-5 shrink-0 text-center">
                    {s.icon}
                  </span>{" "}
                  <span class="truncate">{s.name}</span>
                </span>
                <span class="shrink-0 rounded-full border border-[#ef4444]/45 bg-[#33090a] px-2.5 py-0.5 text-[10px] font-bold text-[#ffe9a8]">{s.tag}</span>
              </div>
              <div class="mt-1.5 text-[11px] tracking-wide text-[#cfa79c]">{s.detail}</div>
            </div>
          ))
        }
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
        {chips.map((c) => <span class="rounded-full border border-[#6b2020] bg-[#1a0303] px-3 py-1 text-[10px] font-bold text-[#f87171]">{c}</span>)}
      </div>

      <div class="mt-3 text-center text-[10px] tracking-wide text-[#cfa79c]">
        ลำดับในตารางสรุปจากที่หน้าเว็บแสดงไว้ รายละเอียดของค่ายเกม ห้องเล่น และเงื่อนไขโปรจริงให้ยึดตามหน้าสมาชิกและหน้าโปรโมชั่นของ PIGAUTO ก่อนเลือกใช้ทุกครั้ง หากติดขัดตรงไหนทักไลน์ทีมงานได้ตลอด 24 ชั่วโมง
      </div>
    </div>
  </div>
</ContentBoxTwo>
