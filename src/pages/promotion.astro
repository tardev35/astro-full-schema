---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";

import { Picture } from "astro:assets";

import pro1 from "../assets/slide1.png";
import pro2 from "../assets/slide2.png";
import pro3 from "../assets/slide3.png";
import pro4 from "../assets/slide4.png";
import { pageGraph } from "../lib/schema";

const pageTitle = "โปรโมชั่น WINDRAGON | คืนยอดเสียทุกสัปดาห์ ฝากถอนออโต้ เริ่ม 1 บาท";

const pageHeading = "โปรโมชั่น WINDRAGON รวมโปรสุดคุ้มเสริมทุนสำหรับสมาชิก";

const pageDescription =
  "รวมโปรโมชั่น WINDRAGON ไว้ในหน้าเดียว คืนยอดเสียทุกสัปดาห์สูงสุด 10,000 บาท ฝากถอนออโต้เริ่มแค่ 1 บาท รองรับทุกธนาคารและทรูวอเล็ท สมัครแล้วรับสิทธิ์ได้เลย";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: pro1.src,
});

const promoClass =
  "mx-auto h-auto w-full rounded-xl border border-[#5a2a12] object-contain shadow-[0_10px_30px_rgba(242,107,29,0.14)] transition-all duration-300 hover:-translate-y-1 hover:border-[#f26b1d]/55 hover:shadow-[0_15px_40px_rgba(242,107,29,0.28)]";
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageHeading} as="h1">
    <p class="mb-4 text-left text-base leading-relaxed">
      หากคุณกำลังมองหาโปรที่ช่วยเสริมทุนให้มีรอบลุ้นนานขึ้น <strong class="text-[#ff9a4d]">WINDRAGON</strong> พร้อมมอบทั้งโปรคืนยอดเสียทุกสัปดาห์สูงสุด 10,000 บาท และระบบฝากถอนออโต้ที่เริ่มได้ตั้งแต่ 1 บาท รวมไว้ให้ดูครบในหน้าเดียว
    </p>

    <p class="mb-8 text-left text-base leading-relaxed">
      เงื่อนไขและช่วงเวลารับสิทธิ์ของแต่ละโปรไม่เหมือนกัน เช็กรายละเอียดล่าสุดในหน้าสมาชิกก่อนกดรับทุกครั้ง สมัครครั้งเดียวใช้ได้ทุกสิทธิ์ เพื่อประสบการณ์การเล่นที่คุ้มค่าและต่อเนื่องกว่าที่เคย
    </p>

    <div class="grid w-full grid-cols-1 gap-6 sm:grid-cols-2">
      <Picture
        src={pro1}
        alt="โปรโมชั่น WINDRAGON ข้อความบนภาพ: WINDRAGON168 เว็บเดิมพันอันดับ 1 บริการออนไลน์ครบวงจร สล็อต บาคาร่า กีฬาสด หวย"
        loading="lazy"
        fetchpriority="low"
        widths={[400, 600]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class={promoClass}
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />

      <Picture
        src={pro2}
        alt="โปรโมชั่น WINDRAGON ข้อความบนภาพ: ฝาก-ถอนระบบอัตโนมัติ แค่ 1 บาทก็สนุกได้ รองรับทุกธนาคารและทรูวอเล็ท"
        loading="lazy"
        fetchpriority="low"
        widths={[400, 600]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class={promoClass}
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />

      <Picture
        src={pro3}
        alt="โปรโมชั่น WINDRAGON ข้อความบนภาพ: กีฬาสดออนไลน์ ลีกเล็ก ลีกใหญ่ทั่วโลก ค่าน้ำดีที่สุด เคลียร์บิลไว ถอนได้เลย!"
        loading="lazy"
        fetchpriority="low"
        widths={[400, 600]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class={promoClass}
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />

      <Picture
        src={pro4}
        alt="โปรโมชั่น WINDRAGON ข้อความบนภาพ: คืนยอดเสียทุกสัปดาห์ คืนให้สูงสุด 10,000.-"
        loading="lazy"
        fetchpriority="low"
        widths={[400, 600]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class={promoClass}
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />
    </div>

    <div class="mt-12 flex justify-center pb-4">
      <a
        href="/register/"
        class="flex items-center justify-center rounded-xl bg-gradient-to-r from-[#ff8a2a] to-[#e2550a] px-10 py-3.5 text-lg font-black text-[#1a0701] shadow-[0_10px_30px_rgba(242,107,29,0.35)] transition-all hover:scale-105 hover:brightness-110 hover:shadow-[0_15px_40px_rgba(242,107,29,0.5)]">
        สมัครสมาชิก WINDRAGON
      </a>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
