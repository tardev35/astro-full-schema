---
import { Picture } from "astro:assets";
import BankStrip from "./BankStrip.astro";
import { BRAND_ADDRESS } from "../lib/brandProfile";

const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.*", { eager: true });
const imagePaths = Object.keys(images);
const targetPath = imagePaths.find((path) => path.endsWith(".webp")) || imagePaths.find((path) => path.endsWith(".png")) || (imagePaths.length > 0 ? imagePaths[0] : null);
const mainLogo = targetPath ? images[targetPath].default : null;

const shortcuts = [
  { name: "หน้าแรก", path: "/" },
  { name: "โปรโมชั่น", path: "/promotion" },
  { name: "สมัครสมาชิก", path: "/register" },
  { name: "เข้าสู่ระบบ", path: "/login" },
  { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  { name: "ทางเข้า", path: "/ทางเข้า" },
  { name: "เกี่ยวกับเรา", path: "/about-us" },
  { name: "ติดต่อเรา", path: "/contact-us" },
];

const logoAlt =
  "โลโก้ OSIRIS168 ตัวอักษร OSIRIS สีทองนูนวางบนแผ่นป้ายอียิปต์สีน้ำเงินเข้ม ต่อด้วยเลข 168 สีเขียวมรกต ด้านบนเป็นมงกุฎอาเตฟสีทองกับดวงตาแห่งฮอรัส ขนาบสองข้างด้วยปีกทอง คทาเฮคัตและเสาเจด ด้านล่างเป็นแถบอักษรไฮโรกลิฟิกและด้วงปีกทองประดับหยกสีเขียว";
---

<footer
  class="relative mt-12 w-full overflow-hidden rounded-t-[3rem] border-t-2 border-[#e8b52c] bg-[#050d0b] pt-16 pb-8 font-sans text-[#dfeee6] shadow-[0_-10px_30px_rgba(232,181,44,0.20)]">
  <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 -top-20 mx-auto h-[200px] w-full max-w-4xl rounded-full bg-[#e8b52c]/12 blur-[80px]"></div>

  <div class="relative z-10 mx-auto w-full max-w-[1400px] px-6">
    <div class="mb-12 grid grid-cols-1 gap-12 md:grid-cols-12">
      <div class="flex flex-col gap-4 md:col-span-5">
        <a href="/" class="inline-block max-w-max rounded-xl border border-[#e8b52c]/35 bg-[#0f241d] px-4 py-2 transition-transform duration-300 hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt={logoAlt}
                widths={[100, 200, 300]}
                sizes="100px"
                class="h-[50px] w-auto object-contain"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <span class="text-3xl font-black tracking-widest text-[#ffdd8a]">
                OSIRIS<span class="text-[#12c48f]">168</span>
              </span>
            )
          }
        </a>
        <p class="mt-2 border-l-2 border-[#e8b52c] pl-4 text-sm leading-relaxed text-[#b9d6c9]">
          OSIRIS168 รวมสล็อตหลายค่ายไว้ในยูสเดียว เปลี่ยนเกมหรือเปลี่ยนค่ายได้โดยไม่ต้องเปิดบัญชีใหม่ ระบบฝากถอนออโต้เชื่อมกับหน้าเมมเบอร์ที่รวมเครดิต โปรโมชั่น
          และประวัติรายการไว้จุดเดียว เปิดผ่านมือถือ แท็บเล็ต หรือคอมก็ใช้ยูสเดิมต่อได้ทันที
        </p>
        <div class="mt-2 flex gap-3">
          <span class="rounded-sm border border-[#e8b52c]/35 bg-[#8a6314]/40 px-3 py-1 text-[10px] font-bold text-[#ffdd8a]">HTTPS / SSL</span>
          <span class="rounded-sm border border-[#12c48f]/35 bg-[#064c39]/40 px-3 py-1 text-[10px] font-bold text-[#4ff0bb]">AUTO 24 HR</span>
        </div>
      </div>

      <nav class="flex flex-col gap-4 md:col-span-3 lg:pl-12">
        <p class="border-b border-[#e8b52c]/30 pb-2 text-base font-black tracking-widest text-[#ffdd8a] uppercase">ทางลัด</p>
        <ul class="flex flex-col gap-3 text-sm font-medium text-[#b9d6c9]">
          {
            shortcuts.map((item) => (
              <li>
                <a href={item.path} class="flex items-center gap-2 transition-colors hover:text-[#ffdd8a]">
                  <span aria-hidden="true" class="text-[#e8b52c]">
                    ▸
                  </span>{" "}
                  {item.name}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="flex flex-col gap-4 md:col-span-4">
        <p class="border-b border-[#e8b52c]/30 pb-2 text-base font-black tracking-widest text-[#ffdd8a] uppercase">บริการลูกค้า 24 ชม.</p>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-md bg-gradient-to-r from-green-600 to-green-500 py-3 text-sm font-black text-white shadow-md transition-all hover:scale-[1.02]">
          <span aria-hidden="true">💬</span> ติดต่อแอดมิน (LINE)
        </a>

        {
          BRAND_ADDRESS.lines.length > 0 && (
            <address aria-label={BRAND_ADDRESS.label} class="mt-2 rounded-xl border border-white/15 bg-black/20 p-4 text-xs leading-relaxed not-italic opacity-90">
              <p class="mb-2 flex items-center gap-2 text-[11px] font-bold tracking-wider uppercase opacity-80">
                <span aria-hidden="true" class="text-sm">
                  📍
                </span>
                {BRAND_ADDRESS.label}
              </p>
              {BRAND_ADDRESS.lines.map((line) => (
                <span class="block">{line}</span>
              ))}
              {BRAND_ADDRESS.email && (
                <a href={`mailto:${BRAND_ADDRESS.email}`} class="mt-3 inline-flex items-center gap-2 font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                  <span aria-hidden="true" class="text-sm">
                    ✉️
                  </span>
                  {BRAND_ADDRESS.email}
                </a>
              )}
            </address>
          )
        }

        <div class="mt-2 text-xs font-bold text-[#b9d6c9]">รองรับทุกธนาคารและทรูมันนี่วอเลท:</div>
        <BankStrip size={32} />
      </div>
    </div>

    <div class="flex flex-col items-center justify-between border-t border-[#e8b52c]/15 pt-6 text-xs font-medium text-[#b9d6c9] md:flex-row">
      <p>COPYRIGHT &copy; {new Date().getFullYear()} OSIRIS168. ALL RIGHTS RESERVED.</p>
      <div class="mt-3 flex gap-4 md:mt-0">
        <a href="/terms/" class="transition-colors hover:text-[#ffdd8a]">เงื่อนไขข้อตกลง</a>
        <a href="/privacy/" class="transition-colors hover:text-[#ffdd8a]">นโยบายความเป็นส่วนตัว</a>
        <a href="#top" class="transition-colors hover:text-[#ffdd8a]">กลับขึ้นบน</a>
      </div>
    </div>
  </div>
</footer>
