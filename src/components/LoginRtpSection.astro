---
import ContentBoxTwo from "./ContentBoxTwo.astro";

const menus = [
  { icon: "🎴", name: "คาสิโนมากกว่า 13 ค่าย", detail: "บาคาร่า รูเล็ต และเกมสด ต่างกันที่โต๊ะ ภาษา วงเงิน และจังหวะรอบ", tag: "เริ่มจากเกมที่เข้าใจ" },
  { icon: "🎰", name: "สล็อตหลายรูปแบบ", detail: "ดูเดิมพันเริ่มต้น ความผันผวน และฟีเจอร์โบนัสก่อนลงเครดิตจริง", tag: "ดูก่อนหมุน" },
  { icon: "⚽", name: "กีฬาและบอลสด", detail: "ตรวจคู่แข่งขัน ตลาด และราคาให้ครบก่อนส่งบิลทุกครั้ง", tag: "เช็กราคาก่อนส่ง" },
  { icon: "👛", name: "ระบบกระเป๋าเดียว", detail: "เครดิตใช้ร่วมกันทุกหมวด ไม่ต้องโยกยอดหรือสมัครบัญชีใหม่", tag: "ตรวจยอดจุดเดียว" },
  { icon: "⏱️", name: "ฝากออโต้", detail: "ตัวเลขร่างประมาณ 10–30 วินาที ขึ้นกับธนาคารและสถานะระบบ", tag: "ยังไม่เข้าอย่าเพิ่งกดซ้ำ" },
  { icon: "💸", name: "ถอนออโต้", detail: "ตัวเลขร่างประมาณ 1–3 นาที ทำรายการเองได้ตลอด 24 ชั่วโมง", tag: "ตรวจประวัติรายการ" },
  { icon: "🔁", name: "คืนยอดเดิมพัน 1%", detail: "แยกให้ชัดว่าคิดจากยอดเดิมพันรวม ยอดเสียสุทธิ หรือเฉพาะเกมที่ร่วมรายการ", tag: "ดูรอบคำนวณ" },
];

const chips = ["คาสิโน 13 ค่าย", "สล็อต", "กีฬา", "กระเป๋าเดียว", "ฝากออโต้", "ถอนออโต้", "มือถือ"];
---

<ContentBoxTwo
  titleleft="เข้าสู่ระบบ WINSIAM88"
  titleright="หมวดเกมและระบบที่ใช้ได้ทั้งบนมือถือและคอมพิวเตอร์"
  label="เข้าสู่ระบบ WINSIAM88 และหมวดเกมที่ใช้ได้ทุกอุปกรณ์">
  <div slot="left" class="flex h-full flex-col gap-4">
    <div class="relative overflow-hidden rounded-2xl border border-[#d4a017]/25 bg-[#071005]/92 p-6 shadow-[0_10px_30px_rgba(212,160,23,0.14)] backdrop-blur-md">
      <div class="pointer-events-none absolute -top-10 -right-10 h-32 w-32 rounded-full bg-[#a3e635]/20 blur-[50px]"></div>

      <div class="relative z-10 mb-5 flex items-center gap-3">
        <span aria-hidden="true" class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#d4a017]/40 bg-gradient-to-br from-[#f5cf4d] via-[#d4a017] to-[#9a7112] text-xl shadow-inner">🎰</span>
        <div class="flex flex-col">
          <p class="text-base font-black text-[#d4a017]">ยินดีต้อนรับกลับ</p>
          <span class="text-[11px] text-[#a3e635]">บัญชีเดียวใช้เลือกเกม รับสิทธิ์ และทำรายการฝากถอนของ WINSIAM88 ได้จากจุดเดียว</span>
        </div>
      </div>

      <div class="relative z-10 flex flex-col gap-3.5">
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#9a7112]">👤</span>
          <input
            type="text"
            placeholder="เบอร์โทรศัพท์ / ยูสเซอร์เนม"
            class="w-full rounded-xl border border-[#25381a] bg-[#0b1408]/95 py-3 pr-4 pl-12 text-[#dfeacf] transition-all outline-none placeholder:text-[#a3e635]/60 focus:border-[#d4a017] focus:ring-1 focus:ring-[#d4a017]/50"
          />
        </div>
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#9a7112]">🔑</span>
          <input
            type="password"
            placeholder="รหัส PIN 4 หลัก"
            class="w-full rounded-xl border border-[#25381a] bg-[#0b1408]/95 py-3 pr-4 pl-12 text-[#dfeacf] transition-all outline-none placeholder:text-[#a3e635]/60 focus:border-[#d4a017] focus:ring-1 focus:ring-[#d4a017]/50"
          />
        </div>

        <div class="flex items-center justify-between px-1 text-xs">
          <label class="flex items-center gap-2 text-[#a3e635]">
            <input type="checkbox" class="h-3.5 w-3.5 rounded border-[#25381a] bg-[#0b1408] accent-[#d4a017]" />
            จดจำฉันไว้
          </label>
          <a href="/login" class="text-[#a3e635] transition-colors hover:text-[#f5cf4d]">ลืมรหัส PIN?</a>
        </div>

        <button
          class="mt-1 w-full rounded-xl border border-[#d4a017]/40 bg-gradient-to-r from-[#f5cf4d] via-[#d4a017] to-[#9a7112] p-3.5 font-black text-[#0f1a06] shadow-[0_10px_30px_rgba(212,160,23,0.26)] transition-all hover:scale-[1.02] hover:shadow-[0_15px_40px_rgba(212,160,23,0.36)]">
          เข้าสู่ระบบ
        </button>

        <div class="flex items-center gap-3 py-1 text-[11px] text-[#a3e635]/70">
          <span class="h-px flex-1 bg-[#25381a]"></span>
          หรือ
          <span class="h-px flex-1 bg-[#25381a]"></span>
        </div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] p-3 text-sm font-bold text-white shadow-md transition-all hover:scale-[1.02]">
          <span aria-hidden="true">💬</span> ติดต่อแอดมิน LINE
        </a>

        <div class="mt-1 flex items-center justify-between px-1">
          <div class="flex gap-2">
            <span class="rounded-full border border-[#d4a017]/25 bg-[#0b1408] px-2.5 py-1 text-[10px] font-bold text-[#d4a017]"><span aria-hidden="true">🔒</span> HTTPS + SSL</span>
            <span class="rounded-full border border-[#4d7c0f]/60 bg-[#0b1408]/80 px-2.5 py-1 text-[10px] font-bold text-[#a3e635]"><span aria-hidden="true">🕐</span> ระบบออโต้ 24 ชั่วโมง</span>
          </div>
          <a href="/register" class="text-xs font-bold text-[#9a7112] transition-colors hover:text-[#f5cf4d]">สมัครสมาชิกใหม่</a>
        </div>
      </div>
    </div>
  </div>

  <div slot="right" class="h-full">
    <div class="flex h-full flex-col rounded-2xl border border-[#d4a017]/25 bg-[#071005]/92 p-5 shadow-[0_10px_30px_rgba(212,160,23,0.14)] backdrop-blur-md">
      <div class="mb-5 flex items-center justify-between gap-3">
        <div>
          <span class="text-xs font-bold tracking-wide text-[#a3e635]">ตารางอ้างอิงหมวดเกมและเวลาทำรายการภายในบัญชีเดียว</span>
          <div class="bg-gradient-to-r from-[#f5cf4d] via-[#d4a017] to-[#9a7112] bg-clip-text text-3xl font-black text-transparent sm:text-4xl">ฝาก 10–30 วิ • ถอน 1–3 นาที</div>
        </div>
        <span class="flex items-center gap-1.5 self-start rounded-full border border-green-500/40 bg-green-900/40 px-2.5 py-1">
          <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-green-500 shadow-[0_0_8px_rgba(34,197,94,0.7)]"></span>
          <span class="text-[10px] font-bold tracking-widest text-green-300 uppercase">Live</span>
        </span>
      </div>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#a3e635]/70 uppercase">
        <span>หมวดเกม / บริการในระบบ</span>
        <span>จุดที่ต้องดู</span>
      </div>

      <div class="flex flex-1 flex-col gap-2.5">
        {
          menus.map((m) => (
            <div class="rounded-xl border border-[#25381a] bg-[#0b1408]/95 px-3.5 py-2.5 transition-colors hover:border-[#d4a017]/50 hover:bg-[#122010]">
              <div class="flex items-center justify-between gap-2 text-sm">
                <span class="flex min-w-0 items-center gap-2 font-bold text-[#dfeacf]">
                  <span aria-hidden="true" class="w-5 shrink-0 text-center">{m.icon}</span> <span class="truncate">{m.name}</span>
                </span>
                <span class="shrink-0 rounded-full border border-[#d4a017]/30 bg-[#071005] px-2.5 py-0.5 text-[10px] font-bold text-[#f5cf4d]">{m.tag}</span>
              </div>
              <div class="mt-1.5 text-[11px] tracking-wide text-[#a3e635]">{m.detail}</div>
            </div>
          ))
        }
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
        {chips.map((c) => <span class="rounded-full border border-[#d4a017]/25 bg-[#0b1408] px-3 py-1 text-[10px] font-bold text-[#d4a017]">{c}</span>)}
      </div>

      <div class="mt-3 text-center text-[10px] tracking-wide text-[#a3e635]/70">
        ตัวเลขทั้งหมดเป็นข้อมูลร่างสำหรับอ้างอิง ควรตรวจยอดขั้นต่ำ จำนวนเทิร์น เกมที่ร่วมรายการ และเพดานถอนจากหน้าโปรโมชั่นจริงก่อนกดรับทุกครั้ง
      </div>
    </div>
  </div>
</ContentBoxTwo>
