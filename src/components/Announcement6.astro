---
const { message = "🎰 HENGJUD365 รีวิวเว็บสล็อต ข้อมูลเว็บตรง ระบบฝากถอนอัตโนมัติ ทางเข้าล่าสุด อัปเดตต่อเนื่อง!" } = Astro.props;
---

<div class="mx-auto max-w-[900px] p-2">
  <div
    class="group relative flex h-[50px] items-center overflow-hidden rounded-full border border-blue-400/40 bg-gradient-to-b from-[#04101f] via-[#02060f] to-[#04101f] p-1 shadow-[0_5px_20px_rgba(37,99,235,0.15),inset_0_1px_1px_rgba(255,255,255,0.08)]">
    <!-- แสงพื้นหลัง -->
    <div class="pointer-events-none absolute -top-6 left-10 h-16 w-16 rounded-full bg-blue-400/20 blur-[30px]"></div>
    <div class="pointer-events-none absolute -bottom-6 right-16 h-16 w-16 rounded-full bg-yellow-400/10 blur-[30px]"></div>

    <div class="relative z-10 flex h-full shrink-0 items-center gap-1.5 rounded-full border border-yellow-400/40 bg-gradient-to-b from-yellow-400 via-yellow-500 to-yellow-600 px-3.5 shadow-[inset_0_1px_1px_rgba(255,255,255,0.6)] md:px-4">
      <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#04101f] shadow-[0_0_6px_rgba(4,16,31,0.8)]"></span>
      <span class="text-xs font-black tracking-wider text-[#04101f] uppercase md:text-sm">🎰 HENGJUD365</span>
    </div>

    <div class="relative z-10 flex-1 overflow-hidden px-4">
      <div class="flex w-max animate-[scroll_18s_linear_infinite] gap-10 text-sm font-bold whitespace-nowrap text-yellow-300/90">
        <span>{message}</span>
        <span class="text-blue-400/70">✨</span>
        <span>{message}</span>
        <span class="text-blue-400/70">✨</span>
        <span>{message}</span>
      </div>
    </div>

    <div class="pointer-events-none absolute inset-x-0 bottom-0 h-[2px] bg-gradient-to-r from-transparent via-blue-400/70 to-transparent opacity-70"></div>
  </div>
</div>

<style>
  @keyframes scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(calc(-33.33% - 13.33px));
    }
  }
</style>
