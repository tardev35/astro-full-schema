---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/AnnouncementCyber.astro";
import ContentBox from "../components/ContentBox.astro";
import ContentBoxCyberCut from "../components/ContentBoxCyberCut.astro";
import ContentBoxSpecial from "../components/ContentBoxSpecial.astro";
import ContentBoxTwoCyberCut from "../components/ContentBoxTwoCyberCut.astro";
import ContentBoxSevenThreeCyberCut from "../components/ContentBoxSevenThreeCyberCut.astro";
import ContentBoxSevenThree from "../components/ContentBoxSevenThree.astro";
import FeatureHighlights from "../components/FeatureHighlights.astro";
import ProviderGrid from "../components/ProviderGrid.astro";
import GameRankingBoard from "../components/GameRankingBoard.astro";
import SmoothCarousel from "../components/SmoothCarousel.astro";
import LatestWinnersPremium from "../components/LatestWinnersPremium.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import ReviewCardSumo2 from "../components/ReviewCardSumo2.astro";
import Faq3 from "../components/Faq3.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
import imgAllInOne from "../assets/slide3.png";
import imgCommission from "../assets/slide1.png";

const pageTitle = "VODKAFUN สล็อตเว็บตรงเว็บใหญ่ ลิขสิทธิ์แท้100% สนุกครบทุกเกม";

const pageDescription = "VODKAFUN สล็อตเว็บตรงเว็บใหญ่ ลิขสิทธิ์แท้100% สมัครฟรี ไม่ต้องฝากก่อน ฝากถอน Auto ไม่มีขั้นต่ำ รวม PG SOFT, Pragmatic Play, Joker Gaming ไม่ปรับเรท ไม่ล็อกยูส";

const announcementMessage =
  "VODKAFUN สล็อตเว็บตรงเว็บใหญ่ ลิขสิทธิ์แท้ 100% ส่งตรงจากค่ายแม่ผ่าน API แบบ Real-Time • สมัครฟรี ไม่ต้องฝากก่อน ไม่มีค่าธรรมเนียมแรกเข้า • ระบบฝากถอน AI Auto รองรับแอปธนาคารและ True Money Wallet • ไม่มีขั้นต่ำทั้งฝากและถอน เริ่มได้ตั้งแต่ 1 บาท • รวมค่าย PG SOFT, Pragmatic Play, Joker Gaming ในกระเป๋าเดียว ไม่ต้องโยกเงิน";

const allInOneAlt =
  "ภาพโปรโมชั่นธีมนีออนซินธ์เวฟ โลโก้ขวดค็อกเทลสีฟ้า VODKAFUN มุมขวาบน ปุ่มเรียงด้านซ้าย หวย บอล บาคาร่า สล็อต ข้อความขนาดใหญ่ ครบจบในที่เดียว แถบล่าง บอล คาสิโน สล็อต ยิงปลา ไก่ชน มวย ไฮโล รูเล็ต กลางภาพเป็นพรีเซนเตอร์หญิงชุดสีชมพูฟ้า";

const commissionAlt =
  "ภาพโปรโมชั่น โลโก้ VODKAFUN หัวข้อ COMMISSION คืนทุกยอดเล่นตลอดทั้งวัน 0.3% เล่นถึง 50% ถอนได้เลย สามารถกดรับง่ายๆ ที่หน้าเว็บได้เลยค่ะ รับสิทธิ์ก่อน 23.59 น. ของทุกวัน ยิ่งเล่นเยอะ ยิ่งได้เยอะ";

const providerHighlights = [
  {
    icon: "🍸",
    title: "PG SOFT",
    description: "รสชาติยอดฮิต ทานง่าย แตกหนัก กราฟิกสวยบาดใจ",
    accent: "magenta" as const,
  },
  {
    icon: "🔥",
    title: "Pragmatic Play",
    description: "รสเข้มข้น ดุดัน ฟีเจอร์ซื้อฟรีสปินจัดจ้าน",
    accent: "cyan" as const,
  },
  {
    icon: "🃏",
    title: "Joker Gaming",
    description: "รสคลาสสิกที่คุ้นเคย แตกบ่อย เล่นเพลิน",
    accent: "magenta" as const,
  },
];

const faqs = [
  {
    q: "VODKAFUN คือเว็บอะไร เชื่อถือได้ไหม?",
    a: "VODKAFUN คือสล็อตเว็บตรงเว็บใหญ่ ลิขสิทธิ์แท้ 100% ระบบส่งตรงจากค่ายแม่แบบ API Real-Time ไม่ปรับเรท ไม่ล็อกยูส และมีความมั่นคงด้านการเงินสูง สมัครฟรี เล่นได้ทันทีโดยไม่ต้องฝากก่อน.",
  },
  {
    q: "สล็อต VODKAFUN แตกง่ายจริงไหม?",
    a: "แตกง่ายจริง เพราะทุกเกมของ VODKAFUN ใช้ค่า RTP เดิมจากค่ายหลัก ไม่ปรับลดอัตราชนะ ไม่แบ่งยูสใหม่ยูสเก่า จังหวะแตกดี รับโบนัสแบบเป็นธรรมทุกยูสเซอร์.",
  },
  {
    q: "สมัครสมาชิก VODKAFUN ต้องเสียเงินหรือฝากก่อนไหม?",
    a: "ไม่ต้องเสียเงิน สมัครฟรี 100% ไม่ต้องฝากก่อน คุณสามารถสมัครและเข้าระบบชมเกม ทดลองระบบ หรือดูเมนูต่าง ๆ ได้ทันทีโดยไม่ต้องเติมเครดิต.",
  },
  {
    q: "ฝากถอนกับ VODKAFUN ใช้เวลานานแค่ไหน?",
    a: "รวดเร็วมาก ระบบฝากถอนเป็น AI Auto 100% ทำรายการเฉลี่ย 2–5 วินาที ฝากปุ๊บเข้าเลย ถอนปุ๊บเงินเด้งเข้าบัญชีทันที รองรับทั้งธนาคารและ True Wallet.",
  },
  {
    q: "VODKAFUN ฝากถอนขั้นต่ำเท่าไหร่?",
    a: "ไม่มีขั้นต่ำ 100% จะเล่น 1 บาทหรือหลักหมื่นก็เริ่มได้ทันที VODKAFUN ให้คุณเล่นตามงบของตัวเอง ไม่บังคับยอด ไม่ยัดเงื่อนไขแอบแฝง.",
  },
];

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement message={announcementMessage} />

  <SmoothCarousel />

  <ContentBoxCyberCut as="h1" title="VODKAFUN สล็อตเว็บตรงเว็บใหญ่ สมัครฟรี ไม่ต้องฝากก่อน ไม่มีขั้นต่ำ">
    <p class="text-left text-base leading-relaxed">
      VODKAFUN (วอดก้าฟัน) เปิดขวดฉลองความรวย สล็อตเว็บตรงเว็บใหญ่ ดีที่สุดในไทย! สมัครฟรีวันนี้ ไม่ต้องฝากก่อน ฝากถอนไม่มีขั้นต่ำ ระบบลื่นไหลระดับพรีเมียม VODKAFUN เปรียบ เสมือนบาร์เทนเดอร์มืออาชีพ
      พร้อมเสิร์ฟเกมคุณภาพที่คัดมาแล้วว่า “แตกง่าย เล่นเพลิน ไม่เครียด” ให้คุณได้ดื่มด่ำกับการทำแจ็คพอตแตกแบบ Non-stop ทั้งความปลอดภัย การเงิน และความโปร่งใส ไม่ล็อกยูส ไม่โกง ไม่ปรับเรท
    </p>
  </ContentBoxCyberCut>

  <ContentBoxSevenThreeCyberCut as="h2" titleright="สล็อตเว็บตรงเว็บใหญ่ VODKAFUN ลิขสิทธิ์แท้100% มั่นคงสูง">
    <Picture
      slot="left"
      src={imgAllInOne}
      alt={allInOneAlt}
      loading="lazy"
      fetchpriority="low"
      widths={[240, 346, 480, 692]}
      sizes="(max-width: 767px) calc(100vw - 96px), 346px"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={70}
      class="mx-auto h-auto w-full rounded-2xl border border-[#2c1266] shadow-[0_10px_30px_rgba(255,61,200,0.22)]"
    />

    <p slot="right" class="text-left text-base leading-relaxed">
      VODKAFUN สล็อตเว็บตรงเว็บใหญ่ มีฐานระบบทั้งหมดคือของแท้ 100% จากค่ายเกมแม่โดยตรง ทุกเกมที่คุณเห็นในเว็บนี้ เชื่อมผ่าน API ของค่ายต้นสังกัดแบบเรียลไทม์ ความมั่นคงการเงินสูง และมีความมั่นคงในระบบ
      ความปลอดภัย ไม่ว่าจะเป็นผู้เล่นใหม่ หรือผู้เล่นที่ย้ายจากเว็บอื่นเพราะเจอปัญหาเดิม ๆ อย่าง ล็อกยูส อัตราแพ้สูง หรือถอนยาก เว็บนี้จะกลายเป็นเหมือนบ้านหลังใหม่ที่อยู่แล้วสบายใจมากกว่าเดิมหลายเท่า
    </p>
  </ContentBoxSevenThreeCyberCut>

  <LoginRtpSection />

  <ContentBoxSpecial as="h2" title="VODKAFUN สล็อตเว็บใหญ่ แตกง่าย ไม่มีหน้าม้า ไม่มีปรับเรท">
    <p slot="left" class="text-left text-base leading-relaxed">
      เล่นสล็อตเว็บตรง กับเจ้าใหญ่ VODKAFUN ยังไงก็ แตกง่าย แน่นอน เพราะ ใช้ระบบ API จากค่ายแม่โดยตรง ตัวเกมส่งตรงแบบ Real-Time ค่า RTP เดิม 100% ไม่แต่ง ไม่ปรุง ไม่เติมของปลอม
    </p>

    <p slot="right" class="text-left text-base leading-relaxed">
      ทุกคนสามารถเล่นเกมสล็อตได้แบบยุติธรรม ไม่เอาเปรียบสมาชิก ไม่มีการกดอัตราชนะ ไม่ล็อกไอดี ไม่แบ่งกลุ่มยูสใหม่/ยูสเก่า ทุกคนมีโอกาสเข้าสู่จังหวะการแตกดี แตกง่าย สม่ำเสมอ
      ทำแจ็คพอตแตกอย่างเท่าเทียมเสมอ
    </p>
  </ContentBoxSpecial>

  <ContentBoxCyberCut as="h2" title="สมัครฟรี สมาชิก VODKAFUN วันนี้ ไม่ต้องฝากก่อน">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed">
        ที่คลับของเรา ไม่มีค่าผ่านประตูครับ! เราเปิดกว้างให้ทุกคนเข้ามาสัมผัสความสนุกได้ทันที นโยบายของเราคือ “สมัครฟรี ไม่ต้องฝากก่อน” ไม่ต้องโอนเงินมาจองสิทธิ์ ไม่ต้องเสียค่าธรรมเนียมแรกเข้า
        แค่กรอกข้อมูลเบื้องต้นให้ครบถ้วน คุณก็ได้รับ User VIP ไปล็อกอินเข้าชมหน้าเว็บ เลือกดูเกม หรือทดลองเล่นระบบได้ทันที เราใจป๋าพอที่จะให้คุณพิสูจน์ระบบจนพอใจ ก่อนที่จะตัดสินใจควักกระเป๋าลงทุน
        เพราะความเชื่อใจคือสิ่งแรกที่เราอยากเสิร์ฟให้คุณ
      </p>

      <a
        href="/register/"
        class="inline-flex w-fit items-center gap-2 rounded-full bg-gradient-to-r from-[#1be5f4] to-[#0aa4c4] px-7 py-3 text-sm font-black tracking-widest text-[#14042e] shadow-[0_10px_30px_rgba(27,229,244,0.34)] transition-transform duration-300 hover:scale-105">
        <span aria-hidden="true">🍸</span> สมัครสมาชิก VODKAFUN
      </a>
    </div>
  </ContentBoxCyberCut>

  <ContentBoxTwoCyberCut as="h2" title="ระบบฝากถอน Auto เร็วทุกขั้นตอน ไม่ต้องรอนาน" titleleft="ฝาก Auto" titleright="ถอน Auto">
    <p>ระบบฝาก-ถอนของ VODKAFUN ใช้งานได้ไวดุจสายฟ้าฟาด ด้วยเทคโนโลยี AI Auto ที่แม่นยำที่สุดในปี 2025</p>

    <p slot="left" class="text-left text-base leading-relaxed">ฝากปุ๊บ เข้าปั๊บ: ไม่ต้องส่งสลิปให้แอดมินดู</p>

    <div slot="right" class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed">ถอนปุ๊บ เงินเด้ง: กดถอนเงินปุ๊บ เงินเข้าบัญชีเร็วกว่าชงเหล้าเสร็จ</p>
      <p class="text-left text-base leading-relaxed">ไม่ว่าจะฝากผ่านแอปธนาคาร หรือ True Money Wallet ทุกธุรกรรมลื่นไหล ไม่มีสะดุด ให้คุณสนุกต่อเนื่องได้ยาวๆ ยันเช้า</p>
    </div>
  </ContentBoxTwoCyberCut>

  <ContentBoxSevenThree as="h2" titleright="สล็อตเว็บใหญ่ ไม่มีขั้นต่ำ สนุกได้ตั้งแต่บาทแรก">
    <Picture
      slot="left"
      src={imgCommission}
      alt={commissionAlt}
      loading="lazy"
      fetchpriority="low"
      widths={[240, 353, 480, 706]}
      sizes="(max-width: 767px) calc(100vw - 96px), 353px"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={70}
      class="mx-auto h-auto w-full rounded-2xl border border-[#2c1266] shadow-[0_10px_30px_rgba(27,229,244,0.22)]"
    />

    <p slot="right" class="text-left text-base leading-relaxed">
      คือสิ่งที่เรายึดมั่น VODKAFUN ไม่มีขั้นต่ำทั้งฝากและถอน จะเริ่ม 1 บาท หรือเริ่มแบบจัดหนักเป็นหมื่นก็เลือกตามสไตล์คุณ การเปิดโอกาสให้ทุกคนเล่นได้ตามงบของตัวเอง เว็บนี้ไม่บังคับยอด
      ไม่กดดันให้ฝากเพิ่ม ไม่หลอกล่อด้วยเงื่อนไขยิบย่อย ทุกอย่างตรง ๆ สบาย ๆ เหมือนนั่งคุยกับเพื่อนสนิทที่อยากให้คุณได้เงินมากกว่าเสีย
    </p>
  </ContentBoxSevenThree>

  <ContentBox as="h2" title="สนุกครบทุกเกม VODKAFUN รวมสล็อตค่ายระดับโลก">
    <div class="flex flex-col gap-4">
      <p class="text-left text-base leading-relaxed">เมนูเกมของเราจัดจ้านไม่แพ้ใคร! VODKAFUN รวบรวมค่ายเกมสล็อตชั้นนำมาไว้ให้คุณเลือกเล่นแบบจุใจ เหมือนบาร์ที่มีเครื่องดื่มครบทุกสัญชาติ</p>

      <FeatureHighlights items={providerHighlights} />

      <p class="text-left text-base leading-relaxed">อยากเปลี่ยนบรรยากาศไปเล่นแนวไหน แค่คลิกเดียวก็สลับเกมได้ทันที ไม่ต้องโยกเงินให้เสียเวลา ระบบกระเป๋าเดียวจบ ครบทุกความบันเทิง</p>
    </div>
  </ContentBox>

  <ProviderGrid />

  <Faq3 title="คำถามที่พบบ่อยเกี่ยวกับ VODKAFUN" faqs={faqs} />

  <GameRankingBoard />

  <LatestWinnersPremium />

  <ReviewCardSumo2 title="เสียงตอบรับจากสมาชิก VODKAFUN" />

  <Navfoot />
</MainLayout>
