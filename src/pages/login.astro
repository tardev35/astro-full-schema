---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";
import CtaRedirect from "../components/CtaRedirect.astro";
import { pageGraph } from "../lib/schema";

const pageTitle = "เข้าสู่ระบบ TOPGAMEVIP | ปุ่มล็อกอินเข้าหน้าเมมเบอร์ เว็บตรงเกมสล็อต";

const pageDescription =
  "หากคุณกำลังมองหาทางกลับเข้าหน้าเมมเบอร์แบบไม่ยุ่งยาก TOPGAMEVIP พร้อมมอบปุ่มเข้าสู่ระบบเพียงปุ่มเดียว เพื่อกลับไปเล่นเกมสล็อตลิขสิทธิ์แท้ด้วยยูสเดิมได้ทันที";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เข้าสู่ระบบ", path: "/login" },
  ],
});

const targetUrl = "https://yoalink.com/22hs";
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="เข้าสู่ระบบ TOPGAMEVIP" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label="เข้าสู่ระบบ TOPGAMEVIP"
        class="group relative mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#8a0208]/70 bg-gradient-to-b from-[#ff4b41] via-[#e60012] to-[#b30009] px-6 py-4 text-xl font-bold tracking-wide text-white shadow-[0_10px_30px_rgba(230,0,18,0.26)] transition-all duration-300 hover:scale-105 hover:border-[#e60012] hover:shadow-[0_15px_40px_rgba(230,0,18,0.38)]">
        เข้าสู่ระบบ TOPGAMEVIP
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="เข้าสู่ระบบ" />
</MainLayout>
