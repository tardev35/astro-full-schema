---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxPremium.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement2.astro";

import { Picture } from "astro:assets";

import pro1 from "../assets/slide1.png";
import pro2 from "../assets/slide2.png";
import pro3 from "../assets/slide3.png";
import pro4 from "../assets/slide4.png";
import { pageGraph } from "../lib/schema";

const pageTitle = "โปรโมชั่น WINNOW168 ฝาก 100 รับ 150 โปรวันเกิด และกิจกรรมสำหรับสมาชิก";

const pageDescription =
  "รวมโปรโมชั่น WINNOW168 ทั้งฝาก 100 รับ 150 สำหรับสมาชิกใหม่ โปรวันเกิด และกิจกรรมลุ้นของรางวัล พร้อมวิธีใช้สิทธิ์และเงื่อนไขที่ควรดูในหน้ารายการก่อนรับเครดิต";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: pro1.src,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="โปรโมชั่น WINNOW168" as="h1">
    <p class="mb-8 text-left text-base leading-relaxed text-[#f2dede]">
      หน้านี้รวมโปรโมชั่นและกิจกรรมที่ <strong class="text-[#f5c542]">WINNOW168</strong> เปิดให้สมาชิกใช้สิทธิ์ ทั้งข้อเสนอสำหรับสมาชิกใหม่ โบนัสวันเกิด และกิจกรรมสะสมของรางวัล
      ทุกรายการอยู่ในบัญชีเดียวกับที่ใช้เล่นบาคาร่า สล็อต คาสิโนสด และกีฬา จึงกดรับและตรวจสถานะได้จากหน้าสมาชิกหน้าเดิม ไม่ต้องเปิดบัญชีแยกตามประเภทเกม
      เงื่อนไขของแต่ละโปรอาจไม่เหมือนกัน จึงควรดูเงื่อนไขในหน้ารายการของโปรนั้นก่อนกดรับทุกครั้ง
    </p>

    <h2 class="mt-10 mb-4 text-2xl leading-normal font-bold text-[#ff5a5f]">ฝาก 100 รับ 150 สำหรับสมาชิกใหม่ ใช้สิทธิ์อย่างไร</h2>

    <p class="mb-5 text-left text-base leading-relaxed text-[#f2dede]">
      โปรโมชั่น <strong class="text-[#f5c542]">ฝาก 100 รับเครดิตรวม 150</strong> เป็นข้อเสนอสำหรับสมาชิกใหม่ตามช่วงกิจกรรม เครดิตที่เพิ่มเข้ามาช่วยให้มีงบเลือกเกม
      และลองใช้งานระบบได้มากกว่ายอดฝากเริ่มต้น เหมาะกับคนที่เพิ่งสมัครและยังไม่แน่ใจว่าอยากเล่นหมวดไหนเป็นหลัก
    </p>

    <p class="mb-8 text-left text-base leading-relaxed text-[#f2dede]">
      ก่อนกดรับควรอ่านรายละเอียดของโปรในหน้าเดียวกันให้ครบ ทั้งเกมที่ร่วมรายการ จำนวนรอบเดิมพัน และยอดถอนสูงสุด เพราะโบนัสกับเงื่อนไขควรอยู่ด้วยกันเสมอ
      เหมือนสั่งชาไข่มุกแล้วต้องรู้ด้วยว่าเลือกระดับหวานเท่าไร ไม่ใช่ดูแค่แก้วสวย
    </p>

    <h2 class="mt-10 mb-4 text-2xl leading-normal font-bold text-[#ff5a5f]">โปรวันเกิดและกิจกรรมสะสมของรางวัล</h2>

    <p class="mb-5 text-left text-base leading-relaxed text-[#f2dede]">
      นอกจากข้อเสนอสำหรับสมาชิกใหม่ <strong class="text-[#f5c542]">WINNOW168</strong> ยังมีโบนัสวันเกิดสูงสุด 5,000 และกิจกรรมรวมของรางวัลกับเครดิตฟรี
      ทั้งภารกิจรายวันและการล็อกอินประจำวัน ตามรายละเอียดที่ประกาศไว้ในหน้ากิจกรรมของแต่ละรอบ
    </p>

    <p class="mb-8 text-left text-base leading-relaxed text-[#f2dede]">
      กิจกรรมเหล่านี้ผูกกับบัญชีสมาชิกเดียวกัน จึงเก็บความคืบหน้าไว้ที่เดียวโดยไม่ต้องจดเอง สิ่งที่ควรดูก่อนร่วมกิจกรรมคือช่วงเวลาของรอบนั้น
      รายการที่นับสิทธิ์ และวิธีรับรางวัล เพราะแต่ละกิจกรรมกำหนดไว้ไม่เหมือนกัน
    </p>

    <h2 class="mt-10 mb-4 text-2xl leading-normal font-bold text-[#ff5a5f]">ฝากถอนออโต้ 24 ชั่วโมง และยอดเริ่มต้นที่เข้าถึงง่าย</h2>

    <p class="mb-5 text-left text-base leading-relaxed text-[#f2dede]">
      ระบบฝากถอนอัตโนมัติของ <strong class="text-[#f5c542]">WINNOW168</strong> รองรับการทำรายการตลอด 24 ชั่วโมง สมาชิกเติมเครดิต ถอนเงิน และดูสถานะรายการผ่านหน้าบัญชีได้โดยตรง
      จึงจัดการยอดก่อนหรือหลังใช้สิทธิ์โปรโมชั่นได้ตามเวลาที่สะดวก บางคนเข้าช่วงกลางวัน บางคนเพิ่งว่างหลังเที่ยงคืน ขั้นตอนก็เป็นชุดเดียวกัน
    </p>

    <p class="mb-8 text-left text-base leading-relaxed text-[#f2dede]">
      เว็บใช้คำว่า <strong class="text-[#f5c542]">ไม่มีขั้นต่ำ</strong> เป็นจุดขายสำหรับการเริ่มต้นด้วยยอดที่เข้าถึงง่าย แต่สมาชิกควรดูในหน้ารายการว่าเงื่อนไขครอบคลุมยอดฝาก ยอดถอน
      หรือการเดิมพันหมวดใด เพราะแต่ละบริการอาจกำหนดไม่เหมือนกัน ข้อดีของยอดเริ่มต้นต่ำคือได้ทดลองหน้าเว็บและเลือกเกมที่ชอบโดยไม่ต้องใส่เงินก้อนใหญ่ตั้งแต่ครั้งแรก
    </p>

    <h2 class="mt-10 mb-4 text-2xl leading-normal font-bold text-[#ff5a5f]">ทางเข้าและการรับสิทธิ์จากทุกอุปกรณ์</h2>

    <p class="mb-8 text-left text-base leading-relaxed text-[#f2dede]">
      ทางเข้า <strong class="text-[#f5c542]">WINNOW168</strong> รองรับโทรศัพท์ แท็บเล็ต และคอมพิวเตอร์ สมาชิกใช้บัญชีเดิมเพื่อเข้าสู่ระบบ ดูโปรโมชั่น เลือกเกม และตรวจประวัติรายการได้จากอุปกรณ์ที่อยู่ใกล้มือ
      วันนี้เปิดผ่านมือถือ พรุ่งนี้ใช้คอมก็เข้าเมนูเดิมได้ ไม่ต้องสร้างบัญชีใหม่ทุกเครื่อง ความเร็วในการโหลดยังขึ้นอยู่กับมือถือ เบราว์เซอร์ และสัญญาณอินเทอร์เน็ตของแต่ละคนด้วย
    </p>

    <div class="grid w-full grid-cols-1 gap-6 sm:grid-cols-2">
      <Picture
        src={pro1}
        alt="แบนเนอร์พื้นแดงทอง โลโก้ WINNOW168 พร้อมข้อความ WINNOW168 เว็บตรงน้องใหม่ รวมสล็อต คาสิโน กีฬา ในบัญชีเดียว และตัวอักษรใหญ่ เล่นลื่นผ่านมือถือ ใต้ลงมาเป็นแถบ ฝากถอนออโต้ ใช้งานง่าย จ่ายไว กับไอคอนสล็อตค่ายดัง คาสิโนสด กีฬา และโบนัส ด้านขวาเป็นพรีเซ็นเตอร์หญิงชุดดำถือชิปคาสิโนยืนข้างมือถือที่เปิดหน้าเว็บ"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600, 800]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class="mx-auto h-auto w-full rounded-xl border border-[#e01e26]/35 object-contain shadow-[0_10px_30px_rgba(224,30,38,0.18)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#f5c542]/60 hover:shadow-[0_15px_40px_rgba(245,197,66,0.28)]"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />

      <Picture
        src={pro2}
        alt="แบนเนอร์พื้นแดงทอง ข้อความ เว็บตรงครบจบ สายเล่นอยากไว มาทางนี้ ใต้ลงมาเป็นโลโก้ WINNOW168 และแถบสามบรรทัด สล็อต คาสิโน กีฬา บัญชีเดียว เล่นได้ครบ และ เล่นผ่านมือถือ 24 ชม. ด้านขวาเป็นพรีเซ็นเตอร์หญิงชุดเดรสสีแดงยืนข้างมือถือที่เปิดหน้าเกม"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600, 800]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class="mx-auto h-auto w-full rounded-xl border border-[#e01e26]/35 object-contain shadow-[0_10px_30px_rgba(224,30,38,0.18)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#f5c542]/60 hover:shadow-[0_15px_40px_rgba(245,197,66,0.28)]"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />

      <Picture
        src={pro3}
        alt="แบนเนอร์โปรวันเกิดพื้นแดงทอง โลโก้ WINNOW168 พร้อมข้อความ โปรวันเกิด รับโบนัสวันเกิด สูงสุด 5,000 ใต้ลงมาเป็นไอคอนสล็อต คาสิโน กีฬา และผ่านมือถือสะดวก กับแถบ เช็กเงื่อนไขก่อนรับโบนัส ด้านขวาเป็นพรีเซ็นเตอร์หญิงถือเค้กวันเกิดติดเทียน ข้างกล่องของขวัญสีแดงผูกโบทอง"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600, 800]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class="mx-auto h-auto w-full rounded-xl border border-[#e01e26]/35 object-contain shadow-[0_10px_30px_rgba(224,30,38,0.18)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#f5c542]/60 hover:shadow-[0_15px_40px_rgba(245,197,66,0.28)]"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />

      <Picture
        src={pro4}
        alt="แบนเนอร์กิจกรรมพื้นแดงทอง โลโก้ WINNOW168 พร้อมข้อความ รวมกิจกรรม ลุ้นของรางวัลและเครดิตฟรีอีกมากมาย มูลค่ารวมกว่า 1,000,000.- มีวงล้อหมุนแสดงรางวัลไอโฟน 15 ทองคำ หูฟังบลูทูธ และเครดิตฟรี ใต้ลงมาเป็นแถบ ภารกิจรายวัน ล็อกอินประจำวัน และระบบเดียวเล่นได้หลายหมวด ด้านขวาเป็นพรีเซ็นเตอร์หญิงชูมือดีใจข้างเครื่องประดับทองและกล่องของขวัญ"
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600, 800]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class="mx-auto h-auto w-full rounded-xl border border-[#e01e26]/35 object-contain shadow-[0_10px_30px_rgba(224,30,38,0.18)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#f5c542]/60 hover:shadow-[0_15px_40px_rgba(245,197,66,0.28)]"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
      />
    </div>

    <div class="mt-12 flex justify-center pb-4">
      <a
        href="/register"
        class="flex items-center justify-center rounded-lg border border-[#e01e26]/60 bg-gradient-to-r from-[#ff5a5f] via-[#e01e26] to-[#a20d12] px-10 py-3.5 text-lg font-black text-[#1a0202] shadow-[0_10px_30px_rgba(224,30,38,0.22)] transition-transform hover:scale-105 hover:shadow-[0_15px_40px_rgba(224,30,38,0.36)]">
        สมัครสมาชิก WINNOW168
      </a>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
