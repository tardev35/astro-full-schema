---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";
import CtaRedirect from "../components/CtaRedirect.astro";
import { pageGraph } from "../lib/schema";

const pageTitle = "สมัครสมาชิก SUPERCLUB168 | ปุ่มเปิดยูสใหม่ผ่านมือถือ ฝากถอนออโต้ทั้งเว็บ";

const pageDescription =
  "หากคุณกำลังมองหาสล็อตเว็บตรง API แท้ที่สมัครฟรีจบใน 10 วินาที SUPERCLUB168 พร้อมมอบปุ่มเปิดยูสใหม่ผ่านมือถือ เพื่อเข้าเล่นทุกค่ายด้วยกระเป๋าเดียวและฝากถอนออโต้";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "สมัครสมาชิก", path: "/register" },
  ],
});

const targetUrl = "https://tinyurl.com/tarspclv";
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="สมัครสมาชิก SUPERCLUB168" as="h1">
    <div class="flex justify-center py-8">
      <a
        href={targetUrl}
        rel="nofollow sponsored"
        data-cta-redirect
        aria-label="สมัครสมาชิก SUPERCLUB168"
        class="group relative mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#8f6a08]/70 bg-gradient-to-b from-[#ffe89a] via-[#f7d046] to-[#c99a17] px-6 py-4 text-xl font-bold tracking-wide text-[#03091f] shadow-[0_10px_30px_rgba(247,208,70,0.26)] transition-all duration-300 hover:scale-105 hover:border-[#ffd95e] hover:shadow-[0_15px_40px_rgba(247,208,70,0.38)]">
        สมัครสมาชิก SUPERCLUB168
      </a>
    </div>
  </ContentBox>

  <Navfoot />

  <CtaRedirect label="สมัครสมาชิก" />
</MainLayout>
