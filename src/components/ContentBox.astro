---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  ctaText?: string;
  ctaHref?: string;
}
const { title, as: HeadingTag = "h1", ctaText = "สมัครสมาชิกทันที", ctaHref } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 text-center font-sans">
  <div
    class="group relative w-full max-w-[1400px] rounded-3xl bg-gradient-to-br from-green-500/40 via-lime-500/25 to-green-500/40 p-[1.5px] shadow-[0_10px_30px_rgba(0,0,0,0.8)] transition-all duration-500 hover:from-green-400/70 hover:via-lime-400/50 hover:to-green-400/70 hover:shadow-[0_15px_45px_rgba(34,197,94,0.25)]">
    <div class="relative overflow-hidden rounded-[calc(1.5rem-1.5px)] bg-[#03120a]/90 p-8 text-white/90 backdrop-blur-xl md:p-10">
      <div class="pointer-events-none absolute inset-x-0 top-0 h-[3px] bg-gradient-to-r from-green-500 via-lime-400 to-green-500 opacity-80"></div>

      <div class="pointer-events-none absolute -top-20 -left-20 h-40 w-40 rounded-full bg-green-500/10 blur-[60px] transition-all duration-500 group-hover:bg-green-400/20"></div>
      <div class="pointer-events-none absolute -right-20 -bottom-20 h-40 w-40 rounded-full bg-lime-500/10 blur-[60px] transition-all duration-500 group-hover:bg-lime-500/20"></div>

      {
        title && (
          <header class="relative z-10 mb-6 flex flex-wrap items-center justify-between gap-3 border-b border-green-500/40 pb-4">
            <div class="flex items-center gap-4">
              <div class="h-8 w-1.5 rounded-full bg-gradient-to-b from-lime-400 to-green-500 shadow-[0_0_15px_rgba(34,197,94,0.6)]" />
              <HeadingTag class={`bg-gradient-to-r from-white via-gray-200 to-gray-400 bg-clip-text ${headingSize} font-black tracking-widest text-transparent uppercase drop-shadow-sm`}>{title}</HeadingTag>
            </div>
            <span class="inline-flex shrink-0 items-center gap-1 rounded-full border border-lime-400/30 bg-lime-400/10 px-3 py-1 text-[10px] font-bold tracking-widest text-lime-400">
              ✓ เว็บทางการ
            </span>
          </header>
        )
      }

      <div class="relative z-10 text-base leading-relaxed text-gray-300">
        <slot />
      </div>

      {
        ctaHref && (
          <div class="relative z-10 mt-8 flex justify-center border-t border-white/5 pt-6">
            <a
              href={ctaHref}
              class="group/cta inline-flex items-center gap-2 rounded-full bg-gradient-to-r from-green-400 via-green-500 to-green-600 px-8 py-3 font-black text-white shadow-[0_5px_20px_rgba(34,197,94,0.4)] transition-all duration-300 hover:-translate-y-1 hover:scale-105 hover:shadow-[0_8px_25px_rgba(34,197,94,0.6)]">
              {ctaText} <span class="transition-transform duration-300 group-hover/cta:translate-x-1">→</span>
            </a>
          </div>
        )
      }
    </div>
  </div>
</section>
<style>
  .font-sans {
    font-family: "Kanit", sans-serif;
  }
</style>
