---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
---

<section class="my-8 flex w-full justify-center px-4 font-sans">
  <div class="w-full max-w-7xl rounded-2xl border border-gray-200 bg-white p-8 shadow-sm md:p-10">
    {
      title && (
        <header class="mb-6 flex items-center gap-3 border-b border-gray-100 pb-4">
          <div class="h-6 w-1.5 rounded-full bg-[#007bff]" />
          <HeadingTag class="text-2xl font-black tracking-widest text-[#0a1128] uppercase">{title}</HeadingTag>
        </header>
      )
    }
    <div class="text-base leading-relaxed text-gray-700">
      <slot />
    </div>
  </div>
</section>
<style>
  .font-sans {
    font-family: "Kanit", sans-serif;
  }
</style>
