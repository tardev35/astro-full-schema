---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";
import { pageGraph } from "../lib/schema";

const pageTitle = "ทางเข้า SUPERCLUB168 เว็บหลัก เข้าสู่ระบบและสมัครสมาชิก";

const pageHeading = "ทางเข้า SUPERCLUB168 เว็บหลัก";

const pageDescription =
  "ทางเข้า SUPERCLUB168 เว็บหลัก กดเข้าสู่ระบบหรือสมัครสมาชิกได้จากจุดเดียว เข้าเล่นสล็อตเว็บตรง API แท้ แตกบ่อย ฝากถอนออโต้ ไม่มีขั้นต่ำ ใช้ได้ทุกอุปกรณ์";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทางเข้า", path: "/ทางเข้า" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageHeading} as="h1">
    <div class="mb-5 grid grid-cols-1 gap-8 md:grid-cols-2">
      <div class="flex flex-col items-center justify-center gap-4">
        <a
          href="/login/"
          aria-label="เข้าสู่ระบบ SUPERCLUB168"
          class="group relative mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#a31a12] bg-gradient-to-b from-[#ff5a4a] to-[#a31a12] px-6 py-4 shadow-[0_10px_30px_rgba(225,43,39,0.24)] transition-all duration-300 hover:scale-105 hover:border-[#e12b27] hover:shadow-[0_15px_40px_rgba(225,43,39,0.34)]">
          <div aria-hidden="true" class="absolute inset-x-0 top-0 h-1/2 bg-gradient-to-b from-white/22 to-transparent"></div>

          <svg
            class="relative z-10 h-9 w-9 text-white"
            aria-hidden="true"
            focusable="false"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            viewBox="0 0 24 24"
            xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"></path>
          </svg>

          <span class="relative z-10 text-3xl font-bold tracking-wide text-white">เข้าสู่ระบบ</span>
        </a>
      </div>

      <div class="flex flex-col items-center justify-center gap-4">
        <a
          href="/register/"
          aria-label="สมัครสมาชิก SUPERCLUB168"
          class="group relative mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#c99a17] bg-gradient-to-r from-[#ffe89a] via-[#f7d046] to-[#c99a17] px-6 py-4 shadow-[0_10px_30px_rgba(247,208,70,0.24)] transition-all duration-300 hover:scale-105 hover:border-[#8f6a08] hover:shadow-[0_15px_40px_rgba(247,208,70,0.34)]">
          <div aria-hidden="true" class="absolute inset-x-0 top-0 h-1/2 bg-gradient-to-b from-white/25 to-transparent"></div>

          <svg
            class="relative z-10 h-9 w-9 text-[#03091f]"
            aria-hidden="true"
            focusable="false"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            viewBox="0 0 24 24"
            xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"></path>
          </svg>

          <span class="relative z-10 text-3xl font-bold tracking-wide text-[#03091f]">สมัครสมาชิก</span>
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
