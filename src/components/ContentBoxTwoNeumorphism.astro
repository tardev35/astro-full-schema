---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;
---

<section class="mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="w-full rounded-[25px] border border-[#a855f7]/35 bg-[#0b011b] p-8 shadow-[10px_10px_20px_#000000,-10px_-10px_20px_#1e0c33] transition-all duration-300 hover:shadow-[15px_15px_30px_#000000,-15px_-15px_30px_#2a1147]">
    {
      title && (
        <header class="mb-8 border-b border-[#a855f7]/30 pb-4 text-center">
          <HeadingTag class="bg-gradient-to-r from-[#ffe9a8] via-[#f5c542] to-[#a3610c] bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#e7dcf7]">
        {titleleft && <p class="text-xl leading-normal font-black tracking-wide text-[#f5c542] drop-shadow-[0_0_10px_rgba(168,85,247,0.35)]">{titleleft}</p>}
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#e7dcf7] md:border-l md:border-[#a855f7]/30 md:pl-8">
        {titleright && <p class="text-xl leading-normal font-black tracking-wide text-[#f5c542] drop-shadow-[0_0_10px_rgba(168,85,247,0.35)]">{titleright}</p>}
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
