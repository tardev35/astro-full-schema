---
const providers = [
  { name: "PG Slot", desc: "ค่ายเกมหลักที่รวมไว้ในบัญชีเดียว มีเกมหลายธีมให้เลือกเปิดจากหน้าเดียว", tag: "ค่ายใหญ่", icon: "🎰" },
  { name: "JILI", desc: "อีกค่ายใหญ่ที่อยู่ในระบบเดียวกัน สลับไปเลือกเกมต่อได้โดยไม่ต้องออกจากบัญชี", tag: "ค่ายใหญ่", icon: "🎮" },
  { name: "เกมสล็อตหลายสไตล์", desc: "มีทั้งธีมแฟนตาซี เกมโบนัส และฟรีสปิน เลือกดูรูปแบบของแต่ละเกมก่อนเข้าเล่นได้", tag: "หมวดเกม", icon: "🕹️" },
  { name: "โบนัสและโปรโมชั่น", desc: "สิทธิ์โบนัสจัดไว้เป็นส่วนหนึ่งของระบบสมาชิก เช็กโปรที่เปิดอยู่ก่อนเลือกใช้ได้ทุกครั้ง", tag: "สิทธิ์สมาชิก", icon: "🎁" },
  { name: "ระบบสมาชิก", desc: "รวมเครดิต โบนัส และประวัติรายการไว้ในพื้นที่เดียว ตรวจย้อนหลังได้โดยไม่ต้องเปิดหลายหน้า", tag: "บัญชีเดียว", icon: "🧾" },
  { name: "ฝากถอน True Wallet", desc: "จัดการเครดิตผ่านหน้าบัญชี ดูยอดและประวัติการฝากถอนได้จากจุดเดียว", tag: "ช่องทางหลัก", icon: "💳" },
  { name: "ใช้งานผ่านมือถือ", desc: "สมัคร เข้าสู่ระบบ และเลือกเกมผ่านเบราว์เซอร์มือถือได้โดยไม่ต้องพึ่งคอม", tag: "ทุกอุปกรณ์", icon: "📱" },
];
---

<section aria-label="ค่ายเกมและบริการที่ BUNNY555 รวมไว้ในบัญชีเดียว" class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#9d174d] via-[#be185d] to-[#ec4899] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      ค่ายเกมและบริการที่ <span class="text-[#a86a10]">BUNNY555</span> รวมไว้ในบัญชีเดียว
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#ec4899] to-transparent"></div>
  </div>

  <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4 lg:gap-5 xl:grid-cols-7">
    {
      providers.map((provider) => (
        <a
          href="/register"
          class="group relative flex flex-col items-center justify-center overflow-hidden rounded-2xl border border-[#f9c2d9] bg-[#ffffff]/92 p-5 shadow-[0_10px_30px_rgba(157,23,77,0.12)] backdrop-blur-md transition-all duration-300 hover:-translate-y-2 hover:border-[#e8a020]/60 hover:bg-[#fff2f7]/95 hover:shadow-[0_15px_40px_rgba(236,72,153,0.20)]">
          <div class="pointer-events-none absolute inset-0 bg-[#ec4899]/5 opacity-0 transition-opacity duration-300 group-hover:opacity-100" />

          <div class="absolute top-2 right-2 z-10 rounded-full bg-gradient-to-r from-[#f7c948] via-[#e8a020] to-[#a86a10] px-2 py-0.5 text-[9px] font-black tracking-wide whitespace-nowrap text-[#7a1038] shadow-sm transition-transform duration-300 group-hover:scale-110">
            {provider.tag}
          </div>

          <div aria-hidden="true" class="mb-3 text-4xl transition-transform duration-300 group-hover:scale-125 group-hover:rotate-3">
            {provider.icon}
          </div>
          <p class="text-center text-sm font-black text-[#7a1038] transition-colors group-hover:text-[#be185d]">{provider.name}</p>
          <p class="mt-1 text-center text-[10px] text-[#a8577a]">{provider.desc}</p>

          <span class="relative z-10 mt-4 block w-full rounded-full border border-[#f9c2d9] bg-[#fff5f9] py-1.5 text-center text-[11px] font-bold text-[#be185d] shadow-inner transition-colors duration-300 group-hover:border-[#e8a020]/60 group-hover:bg-gradient-to-r group-hover:from-[#f7c948] group-hover:via-[#e8a020] group-hover:to-[#a86a10] group-hover:text-[#7a1038]">
            เข้าดูหมวดนี้
          </span>
        </a>
      ))
    }
  </div>
</section>
