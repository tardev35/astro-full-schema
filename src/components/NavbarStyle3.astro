---
import { isActivePath } from "../lib/nav";
import { Picture } from "astro:assets";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });

const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

const currentPath = Astro.url.pathname;

const isActive = (path: string) => isActivePath(currentPath, path);

const affUrl = "https://yoalink.com/gf78";

const links = [
  { name: "หน้าแรก", path: "/", icon: "🏠" },
  { name: "โปรโมชั่น", path: "/promotion/", icon: "🎁" },
  { name: "ทดลองเล่น", path: "/ทดลองเล่น/", icon: "🎰" },
  { name: "วิธีฝากถอน", path: "/วิธีฝากถอน/", icon: "💳" },
  { name: "เกี่ยวกับเรา", path: "/about-us/", icon: "🦈" },
  { name: "ติดต่อเรา", path: "/contact-us/", icon: "💬" },
];

const logoAlt = "โลโก้ BABYSHARK8899 หัวฉลามการ์ตูนสีฟ้าฟันแหลมในวงกลมสีแดง ตัวอักษร BABY สีแดง SHARK สีขาวเงิน และเลข 8899 สีฟ้าขอบดำ มีลายสาดสีแดงและน้ำเงินด้านหลัง";
---

<header class="sticky top-4 z-50 w-full px-4 font-sans">
  <nav
    aria-label="เมนูหลัก BABYSHARK8899"
    class="mx-auto flex h-[70px] w-full max-w-[1600px] items-center justify-between gap-3 rounded-full border border-[#1a4a9c] bg-[#041a45]/95 px-5 shadow-[0_8px_24px_rgba(0,0,0,0.45),0_0_0_3px_rgba(11,124,244,0.10)] xl:px-8">
    <a href="/" class="z-50 flex-shrink-0 transition-transform hover:scale-105">
      {
        mainLogo ? (
          <Picture
            src={mainLogo}
            alt={logoAlt}
            widths={[120, 240, 360]}
            sizes="120px"
            loading="eager"
            fetchpriority="high"
            class="h-[44px] w-auto drop-shadow-[0_4px_12px_rgba(11,124,244,0.45)] xl:h-[52px]"
            formats={["avif", "webp"]}
            fallbackFormat="webp"
          />
        ) : (
          <span class="text-2xl font-black tracking-wide italic">
            <span class="text-[#ff5a60]">BABY</span>
            <span class="text-white">SHARK</span>
            <span class="text-[#4da3ff]">8899</span>
          </span>
        )
      }
    </a>

    <div class="hidden h-full items-center gap-6 xl:flex 2xl:gap-12">
      {
        links.map((item) => (
          <a
            href={item.path}
            class={`group relative flex h-full items-center gap-1.5 text-sm font-bold whitespace-nowrap transition-colors xl:text-base ${isActive(item.path) ? "text-[#4da3ff]" : "text-[#dbe9ff] hover:text-white"}`}>
            <span aria-hidden="true" class="text-base">
              {item.icon}
            </span>
            <span>{item.name}</span>
            <div
              aria-hidden="true"
              class={`absolute bottom-[15px] left-0 h-[3px] w-full origin-left rounded-full bg-gradient-to-r from-[#4da3ff] to-[#e8202a] transition-transform duration-300 ${isActive(item.path) ? "scale-x-100" : "scale-x-0 group-hover:scale-x-100"}`}
            />
          </a>
        ))
      }
    </div>

    <div class="z-50 flex shrink-0 items-center gap-2 xl:gap-3">
      <a
        href={affUrl}
        rel="nofollow sponsored"
        class="hidden items-center justify-center gap-1.5 rounded-full border border-[#2f7bff]/60 bg-[#0a2a66] px-4 py-2 text-sm font-bold whitespace-nowrap text-white transition-all hover:border-[#4da3ff] hover:bg-[#0554b8] lg:flex xl:px-5">
        <span aria-hidden="true">🔑</span> เข้าสู่ระบบ
      </a>
      <a
        href={affUrl}
        rel="nofollow sponsored"
        class="hidden items-center justify-center gap-1.5 rounded-full bg-gradient-to-b from-[#ff5a60] to-[#b0121a] px-4 py-2 text-sm font-extrabold whitespace-nowrap text-white shadow-[0_4px_14px_rgba(232,32,42,0.40)] transition-all hover:scale-105 lg:flex xl:px-6">
        <span aria-hidden="true">📝</span> สมัครสมาชิก
      </a>

      <button id="hamburger-btn" class="relative flex h-[40px] w-[40px] flex-col items-end justify-center gap-[6px] p-2 xl:hidden" aria-label="เปิดเมนู">
        <span class="line-1 h-[2px] w-6 origin-center rounded-full bg-[#dbe9ff] transition-all duration-300"></span>
        <span class="line-2 h-[2px] w-4 origin-center rounded-full bg-[#e8202a] transition-all duration-300"></span>
      </button>
    </div>
  </nav>

  <div id="fullscreen-menu" class="pointer-events-none fixed inset-0 z-[60] flex flex-col items-center justify-center bg-[#010d28]/98 opacity-0 transition-opacity duration-500">
    <div class="flex w-full flex-col items-center space-y-5 px-6">
      {
        links.map((item) => (
          <a
            href={item.path}
            class={`fs-item flex items-center gap-3 text-2xl font-black tracking-widest uppercase transition-all duration-300 ${isActive(item.path) ? "text-[#4da3ff]" : "text-[#dbe9ff] hover:text-white"}`}>
            <span aria-hidden="true" class="text-2xl">
              {item.icon}
            </span>
            <span>{item.name}</span>
          </a>
        ))
      }

      <div class="fs-item mt-4 flex w-full max-w-[250px] flex-col gap-4 pt-8">
        <a
          href={affUrl}
          rel="nofollow sponsored"
          class="flex w-full items-center justify-center gap-2 rounded-full bg-gradient-to-b from-[#ff5a60] to-[#b0121a] py-3.5 text-lg font-extrabold text-white shadow-[0_6px_20px_rgba(232,32,42,0.40)]">
          <span aria-hidden="true">📝</span> สมัครสมาชิก
        </a>
        <a
          href={affUrl}
          rel="nofollow sponsored"
          class="flex w-full items-center justify-center gap-2 rounded-full border border-[#2f7bff]/60 bg-[#0a2a66] py-3.5 text-lg font-bold text-white transition-colors hover:bg-[#0554b8]">
          <span aria-hidden="true">🔑</span> เข้าสู่ระบบ
        </a>
      </div>
    </div>
  </div>
</header>

<style is:global>
  #hamburger-btn.active .line-1 {
    transform: translateY(4px) rotate(45deg);
  }
  #hamburger-btn.active .line-2 {
    width: 24px;
    transform: translateY(-4px) rotate(-45deg);
  }

  .fs-item {
    opacity: 0;
    transform: translateY(30px) scale(0.9);
    transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .fs-item.show {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
  .fs-item:nth-child(1) {
    transition-delay: 0.1s;
  }
  .fs-item:nth-child(2) {
    transition-delay: 0.15s;
  }
  .fs-item:nth-child(3) {
    transition-delay: 0.2s;
  }
  .fs-item:nth-child(4) {
    transition-delay: 0.25s;
  }
  .fs-item:nth-child(5) {
    transition-delay: 0.3s;
  }
  .fs-item:nth-child(6) {
    transition-delay: 0.35s;
  }
  .fs-item:nth-child(7) {
    transition-delay: 0.4s;
  }
  @media (prefers-reduced-motion: reduce) {
    .fs-item {
      transition: none;
      opacity: 1;
      transform: none;
    }
  }
</style>

<script>
  const hamburgerBtn = document.getElementById("hamburger-btn");
  const fsMenu = document.getElementById("fullscreen-menu");
  const fsItems = document.querySelectorAll(".fs-item");

  const toggleFsMenu = () => {
    hamburgerBtn?.classList.toggle("active");
    fsMenu?.classList.toggle("opacity-0");
    fsMenu?.classList.toggle("pointer-events-none");

    if (!fsMenu?.classList.contains("opacity-0")) {
      document.body.style.overflow = "hidden";
      fsItems.forEach((item) => item.classList.add("show"));
    } else {
      document.body.style.overflow = "";
      fsItems.forEach((item) => item.classList.remove("show"));
    }
  };

  hamburgerBtn?.addEventListener("click", toggleFsMenu);
  fsItems.forEach((item) => {
    item.addEventListener("click", () => {
      if (!fsMenu?.classList.contains("opacity-0")) toggleFsMenu();
    });
  });
</script>
