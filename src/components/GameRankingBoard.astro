---
import { Picture } from "astro:assets";
import img1 from "../assets/providers/game1.avif";
import img2 from "../assets/providers/game2.avif";
import img3 from "../assets/providers/game3.avif";
import img4 from "../assets/providers/game4.avif";
import img5 from "../assets/providers/game5.avif";
import img6 from "../assets/providers/game6.avif";

const games = [
  {
    rank: 1,
    name: "PG Slot",
    type: "ค่ายที่สมาชิก PAYDAY24 เปิดบ่อยที่สุด สล็อตแตกง่าย แตกบ่อย ภาพชัด และหลายเกมออกแบบมาให้เหมาะกับหน้าจอมือถือ",
    menus: ["สายมือถือ", "RTP สูง"],
    players: 5124,
    img: img4,
  },
  {
    rank: 2,
    name: "Joker Gaming",
    type: "วงล้อคลาสสิกที่คนไทยคุ้นมือ พร้อมเกมใหม่ที่ทยอยเปิดเพิ่มในระบบให้สลับไปลองได้เรื่อย ๆ",
    menus: ["คลาสสิก", "เกมใหม่"],
    players: 3842,
    img: img5,
  },
  { rank: 3, name: "Jili", type: "เกมจังหวะไว ฟีเจอร์โบนัสและตัวคูณชัดเจน เหมาะกับคนที่ชอบเปลี่ยนธีมเกมบ่อยภายในวันเดียว", menus: ["จังหวะไว", "โบนัส"], players: 3517, img: img6 },
  { rank: 4, name: "SA Gaming", type: "คาสิโนสดส่งตรงจากสตูดิโอชั้นนำ บาคาร่าเสมือนจริง เลือกโต๊ะจากหน้าเดียวโดยไม่ต้องเปลี่ยนยูส", menus: ["บาคาร่า", "โต๊ะสด"], players: 2905, img: img2 },
  {
    rank: 5,
    name: "หวยออนไลน์",
    type: "หวยออนไลน์ที่มีให้อัปเดตทุกงวด เลือกตลาดได้จากยูสเดิม ตรวจรอบเปิด-ปิดของแต่ละตลาดก่อนทำรายการทุกครั้ง",
    menus: ["ทุกงวด", "เลือกตลาด"],
    players: 2431,
    img: img1,
  },
  {
    rank: 6,
    name: "กีฬาและแทงบอล",
    type: "แทงบอลออนไลน์ในราคานับบอลที่ดีที่สุด ตามรายการแข่งขันที่เปิดให้บริการในแต่ละช่วงเวลา",
    menus: ["ราคานับบอล", "ตามฤดูกาล"],
    players: 2108,
    img: img3,
  },
];

const medal = (rank: number) => (rank === 1 ? "🥇" : rank === 2 ? "🥈" : rank === 3 ? "🥉" : null);
---

<section aria-label="ค่ายและหมวดเกมที่สมาชิก PAYDAY24 เปิดเล่นบ่อย" class="mx-auto w-full max-w-[1300px] px-4 py-8 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <span aria-hidden="true" class="text-2xl">🏆</span>
    <p class="bg-gradient-to-r from-[#ffe680] via-[#fdc700] to-[#d99400] bg-clip-text text-2xl font-black tracking-widest text-transparent uppercase">
      ค่ายและหมวดเกมที่สมาชิก PAYDAY24 เปิดเล่นบ่อยที่สุด
    </p>
    <p class="max-w-3xl text-base leading-relaxed text-[#ede4fb]">
      ทุกค่ายและทุกหมวดในตารางนี้อยู่หลังยูสเดียวกัน สลับจากสล็อตไปคาสิโนสด หวย หรือกีฬาได้โดยไม่ต้องสมัครใหม่ ลำดับความนิยมขยับตามคนที่เข้ามาใช้งานในแต่ละช่วง
      ไม่ได้แปลว่าค่ายไหนให้อัตราจ่ายดีกว่าค่ายไหน รายการที่เปิดให้บริการจริงให้ยึดตามหน้าเมมเบอร์ก่อนทำรายการทุกครั้ง
    </p>
    <div class="mt-2 h-[3px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#fdc700] to-transparent"></div>
  </div>

  <div class="flex flex-col gap-3">
    {
      games.map((g) => {
        const top = g.rank === 1;
        return (
          <article
            class={`group relative flex items-center gap-3 overflow-hidden rounded-2xl border p-3 transition-all duration-300 hover:-translate-y-0.5 sm:gap-5 sm:p-4 ${
              top
                ? "border-[#fdc700]/75 bg-gradient-to-r from-[#2c1247] via-[#1c0a30] to-[#2c1247] shadow-[0_15px_40px_rgba(253,199,0,0.22)]"
                : "border-[#fdc700]/35 bg-[#1c0a30] shadow-[0_10px_30px_rgba(253,199,0,0.10)] hover:border-[#fdc700]/65 hover:shadow-[0_15px_40px_rgba(253,199,0,0.20)]"
            }`}>
            <div
              aria-hidden="true"
              class="pointer-events-none absolute top-1/2 -left-10 h-24 w-24 -translate-y-1/2 rounded-full bg-[#fdc700]/12 blur-[40px] transition-all duration-500 group-hover:bg-[#a855f7]/18"
            />

            <div class="relative z-10 flex w-8 shrink-0 flex-col items-center justify-center sm:w-12">
              {medal(g.rank) ? (
                <span class="text-2xl sm:text-3xl">
                  <span aria-hidden="true">{medal(g.rank)}</span>
                  <span class="sr-only">อันดับ {g.rank}</span>
                </span>
              ) : (
                <span class="text-xl font-black text-[#fdc700] sm:text-2xl">#{g.rank}</span>
              )}
            </div>

            <div class={`relative z-10 h-14 w-14 shrink-0 overflow-hidden rounded-xl border sm:h-16 sm:w-16 ${top ? "border-[#fdc700]/75" : "border-[#a86f00]/55"}`}>
              <Picture
                src={g.img}
                alt={`ภาพหน้าปกเกมประกอบรายการ ${g.name} บนกระดานค่ายและหมวดเกมยอดนิยมของ PAYDAY24`}
                formats={["avif", "webp"]}
                fallbackFormat="webp"
                loading="lazy"
                fetchpriority="low"
                widths={[100, 200]}
                quality={60}
                sizes="(max-width: 640px) 56px, 64px"
                decoding="async"
                class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-110"
              />
            </div>

            <div class="relative z-10 min-w-0 flex-1">
              <div class="flex items-center gap-2">
                <p class="truncate text-base font-black text-[#ffe680] sm:text-lg">{g.name}</p>
                {top && (
                  <span class="hidden shrink-0 rounded-full border border-[#fdc700]/55 bg-[#2c1247] px-2 py-0.5 text-[9px] font-black tracking-wider text-[#ffe680] sm:inline">ยอดนิยมสูงสุด</span>
                )}
              </div>
              <p class="truncate text-[11px] text-[#c4b5e8] sm:text-xs">{g.type}</p>

              <div class="mt-2 flex flex-wrap items-center gap-1.5">
                {g.menus.map((m) => (
                  <span class="rounded-full border border-[#a86f00]/55 bg-[#2c1247] px-2.5 py-0.5 text-[10px] font-bold text-[#ffe680]">{m}</span>
                ))}
              </div>
            </div>

            <div class="relative z-10 hidden shrink-0 flex-col items-end gap-1 sm:flex">
              <span class="flex items-center gap-1.5 text-[11px] text-[#c4b5e8]">
                <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#a855f7] shadow-[0_0_6px_rgba(168,85,247,0.7)]" />
                <span class="tabular-nums" data-players data-base={g.players}>
                  {g.players.toLocaleString("en-US")}
                </span>{" "}
                ออนไลน์
              </span>
              <a
                href="/register"
                class={`rounded-full px-4 py-1.5 text-xs font-black transition-transform hover:scale-105 ${
                  top
                    ? "bg-gradient-to-r from-[#ffe680] via-[#fdc700] to-[#d99400] text-[#150726] shadow-[0_10px_30px_rgba(253,199,0,0.28)]"
                    : "border border-[#a86f00]/60 bg-[#2c1247] text-[#ffe680] hover:border-[#fdc700]/70 hover:bg-[#331652]"
                }`}>
                สมัครเข้าเล่น
              </a>
            </div>
          </article>
        );
      })
    }
  </div>
</section>

<script>
  import { startLiveCounters } from "../lib/liveCounter";

  startLiveCounters();
</script>
