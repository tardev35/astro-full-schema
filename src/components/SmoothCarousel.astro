---
import { Picture } from "astro:assets";

import slide1 from "../assets/slide1.png";
import slide2 from "../assets/slide2.png";
import slide3 from "../assets/slide3.png";
import slide4 from "../assets/slide4.png";

const images = [
  {
    src: slide1,
    alt: "แบนเนอร์ YIMSIAM88 ตัวอักษร YIMSIAM88 เป็นเปลวไฟสีทอง มีโลโก้หน้าจั่ววัดไทยสีทองอยู่ด้านบน ใต้ชื่อเขียนว่า แชทได้24ชม ตอบไว ไม่ใช้บอท ด้านข้างมีพรีเซนเตอร์หญิงในชุดราตรีสีดำแดงถือไพ่อยู่ในมือ รอบภาพมีเหรียญทองและไพ่กระจายบนพื้นหลังลาวาและเปลวไฟ",
  },
  {
    src: slide2,
    alt: "แบนเนอร์ YIMSIAM88 ตัวอักษร YIMSIAM88 เป็นเปลวไฟสีทอง มีโลโก้หน้าจั่ววัดไทยสีทองอยู่ด้านบน ใต้ชื่อเขียนว่า แตก10ล้าน จ่ายเต็มไม่มีหัก ด้านข้างมีพรีเซนเตอร์หญิงในชุดราตรีสีแดงทองชี้ไปที่ไพ่ที่คลี่เป็นพัด รอบภาพมีเหรียญทองและชิปคาสิโนบนพื้นหลังลาวาและเปลวไฟ",
  },
  {
    src: slide3,
    alt: "แบนเนอร์ YIMSIAM88 ตัวอักษร YIMSIAM88 เป็นเปลวไฟสีทองอยู่ด้านบน ใต้ชื่อเขียนว่า เติมผ่านวอเล็ทก็ได้ ไม่มีขั้นต่ำ ตรงกลางเป็นโลโก้หน้าจั่ววัดไทยสีทอง ด้านขวามีพรีเซนเตอร์หญิงในชุดกี่เพ้าสีแดงทองถือไพ่คลี่เป็นพัด ด้านล่างมีไพ่ ลูกเต๋า เหรียญทองและชิปคาสิโนบนพื้นหลังลาวาและเปลวไฟ",
  },
  {
    src: slide4,
    alt: "แบนเนอร์ YIMSIAM88 มีพรีเซนเตอร์หญิงในชุดราตรีสีแดงทองยืนอยู่ด้านซ้าย มุมขวาบนเป็นโลโก้หน้าจั่ววัดไทยสีทอง กลางภาพเป็นตัวอักษร YIMSIAM88 สีทองแบบเปลวไฟ ใต้ชื่อเขียนว่า โบนัสแรงแตกบ่อย ไม่ล็อคยูส รอบภาพมีเหรียญทอง ชิปคาสิโนและไพ่กระจายบนพื้นหลังลาวาและเปลวไฟ",
  },
];

const COPIES = 3;
const slides = Array.from({ length: COPIES }, () => images).flat();
---

<div class="marquee mx-auto w-full max-w-[1301px] overflow-hidden px-4 py-5">
  <input id="carousel-pause" type="checkbox" class="peer sr-only" />
  <label
    for="carousel-pause"
    class="sr-only cursor-pointer peer-focus-visible:not-sr-only peer-focus-visible:mb-3 peer-focus-visible:inline-block peer-focus-visible:rounded-full peer-focus-visible:border peer-focus-visible:border-[#ff7a18]/60 peer-focus-visible:px-4 peer-focus-visible:py-2 peer-focus-visible:text-sm peer-focus-visible:font-bold peer-focus-visible:text-[#ffd98a]">
    หยุด / เล่นสไลด์ภาพ
  </label>

  <div class="marquee-track flex">
    {
      slides.map((slide, index) => {
        const isDuplicate = index >= images.length;
        return (
          <div class="marquee-slide" aria-hidden={isDuplicate ? "true" : undefined}>
            <Picture
              src={slide.src}
              alt={isDuplicate ? "" : slide.alt}
              class="block w-full rounded-xl border border-[#ff7a18]/25 object-cover shadow-[0_10px_30px_rgba(255,122,24,0.18)]"
              width={slide.src.width}
              height={slide.src.height}
              loading="lazy"
              fetchpriority="low"
              decoding="async"
              widths={[200, 400, 600]}
              sizes="(max-width: 768px) 50vw, 33vw"
              formats={["avif", "webp"]}
              fallbackFormat="webp"
              quality={60}
            />
          </div>
        );
      })
    }
  </div>
</div>

<style>
  .marquee {
    --gap: 12px;
    --per-view: 2;
    --shift: calc(-200% - 24px);
  }

  @media (min-width: 768px) {
    .marquee {
      --gap: 16px;
      --per-view: 3;
      --shift: calc(-133.3333% - 21.3333px);
    }
  }

  .marquee-track {
    gap: var(--gap);
    width: 100%;
    animation: carousel-scroll 32s linear infinite;
    will-change: transform;
  }

  .marquee-slide {
    flex: 0 0 calc((100% - (var(--per-view) - 1) * var(--gap)) / var(--per-view));
  }

  @keyframes carousel-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(var(--shift));
    }
  }

  .marquee:hover .marquee-track,
  .marquee:focus-within .marquee-track,
  .marquee > input:checked ~ .marquee-track {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
    }
  }
</style>
