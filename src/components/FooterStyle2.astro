---
import { Picture } from "astro:assets";
import BankStrip from "./BankStrip.astro";
import { BRAND_ADDRESS } from "../lib/brandProfile";

const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });
const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;
---

<footer class="relative w-full overflow-hidden border-t-[3px] border-[#2e8bff] bg-[#020a1e] pt-16 pb-8 text-white shadow-[0_-10px_30px_rgba(46,139,255,0.2)]">
  <div aria-hidden="true" class="pointer-events-none absolute top-0 right-0 h-96 w-96 rounded-full bg-[#2e8bff]/12 blur-[100px]"></div>
  <div aria-hidden="true" class="pointer-events-none absolute bottom-0 left-0 h-96 w-96 rounded-full bg-[#cd994e]/30 blur-[100px]"></div>

  <div class="relative z-10 mx-auto w-full max-w-[1200px] px-6">
    <div class="mb-12 grid grid-cols-1 gap-10 md:grid-cols-2 lg:grid-cols-4 lg:gap-8">
      <div class="flex flex-col gap-5">
        <a href="/" class="inline-block origin-left transition-transform hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt="โลโก้ POE888 รูปหมีแพนด้าในตัวอักษร P สีขาวบนกรอบสี่เหลี่ยมสีน้ำเงินขอบทอง ใต้ลงมาเป็นแถบสีเหลืองเขียนว่า โป888"
                widths={[110, 220, 330]}
                sizes="110px"
                class="h-[50px] w-auto drop-shadow-[0_0_15px_rgba(46,139,255,0.5)]"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <span class="bg-gradient-to-b from-[#ffe98a] to-[#ffd93d] bg-clip-text text-4xl font-black text-transparent drop-shadow-[0_0_10px_rgba(46,139,255,0.45)]">POE888</span>
            )
          }
        </a>
        <p class="text-base leading-relaxed text-[#b9cdf0]">
          POE888 เว็บสีฟ้า รวมหวยไทย หวยลาว หวยฮานอย และหวยมาเลย์ไว้ในบัญชีเดียว เลือกเลข จัดโพย ตรวจผล และดูประวัติรายการผ่านมือถือได้จากจุดเดียว พร้อมระบบสมาชิกที่รวมเครดิตและรายการฝากถอนไว้ในหน้าเดียวกัน
        </p>
        <div class="mt-2 flex items-center gap-3">
          <div class="flex items-center gap-1.5 rounded border border-[#2e8bff]/50 bg-[#2e8bff]/10 px-3 py-1.5 text-xs font-bold text-[#a8d4ff] shadow-[0_0_10px_rgba(46,139,255,0.25)]">
            <span aria-hidden="true" class="text-base">🛡️</span> SSL/TLS 256-BIT
          </div>
          <div class="flex items-center gap-1.5 rounded border border-[#ffd93d]/50 bg-[#cd994e]/25 px-3 py-1.5 text-xs font-bold text-[#ffd93d]">
            <span aria-hidden="true" class="text-base">⚡</span> AUTO 24H
          </div>
        </div>
      </div>

      <nav aria-label="เมนูหลัก" class="flex flex-col gap-4 lg:pl-8">
        <p class="flex items-center gap-2 text-lg font-extrabold text-[#a8d4ff]">
          <span aria-hidden="true" class="h-6 w-1.5 rounded-full bg-gradient-to-b from-[#a8d4ff] to-[#0b4ea8]"></span> เมนูหลัก
        </p>
        <ul class="flex flex-col gap-3 text-sm">
          {
            [
              { name: "หน้าแรก", path: "/" },
              { name: "โปรโมชั่น", path: "/promotion" },
              { name: "ตรวจหวย", path: "/ตรวจหวย" },
              { name: "แนวทาง", path: "/แนวทาง" },
              { name: "ทางเข้า", path: "/ทางเข้า" },
              { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
              { name: "เกี่ยวกับเรา", path: "/about-us" },
              { name: "ติดต่อเรา", path: "/contact-us" },
            ].map((link) => (
              <li>
                <a href={link.path} class="group flex items-center text-[#b9cdf0] transition-all hover:text-[#a8d4ff]">
                  <span aria-hidden="true" class="mr-2 -ml-4 text-[#2e8bff] opacity-0 transition-all group-hover:ml-0 group-hover:opacity-100">
                    ➤
                  </span>
                  {link.name}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav aria-label="หมวดหมู่บริการ" class="flex flex-col gap-4">
        <p class="flex items-center gap-2 text-lg font-extrabold text-[#a8d4ff]">
          <span aria-hidden="true" class="h-6 w-1.5 rounded-full bg-gradient-to-b from-[#a8d4ff] to-[#0b4ea8]"></span> ตลาดหวยและบริการ
        </p>
        <ul class="flex flex-col gap-3 text-sm">
          {
            ["หวยไทย (Thai Lottery)", "หวยลาว (Lao Lottery)", "หวยฮานอย (Hanoi)", "หวยมาเลย์ (Malay)", "สล็อตและกีฬา (Slot &amp; Sport)"].map((game) => (
              <li>
                <a href="/register" class="group flex items-center text-[#b9cdf0] transition-all hover:text-[#a8d4ff]">
                  <span aria-hidden="true" class="mr-3 h-1.5 w-1.5 rounded-full bg-[#cd994e] transition-colors group-hover:bg-[#ffd93d] group-hover:shadow-[0_0_8px_rgba(255,217,61,0.8)]" />
                  {game}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="flex flex-col gap-5">
        <p class="flex items-center gap-2 text-lg font-extrabold text-[#a8d4ff]">
          <span aria-hidden="true" class="h-6 w-1.5 rounded-full bg-gradient-to-b from-[#a8d4ff] to-[#0b4ea8]"></span> บริการลูกค้า
        </p>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-lg bg-[#00B900] py-3 font-bold text-white shadow-[0_0_15px_rgba(0,185,0,0.3)] transition-transform hover:scale-105">
          <span class="text-xl font-black">LINE</span> @POE888
        </a>

        {
          BRAND_ADDRESS.lines.length > 0 && (
            <address aria-label={BRAND_ADDRESS.label} class="mt-2 rounded-xl border border-white/15 bg-black/20 p-4 text-xs leading-relaxed not-italic opacity-90">
              <p class="mb-2 flex items-center gap-2 text-[11px] font-bold tracking-wider uppercase opacity-80">
                <span aria-hidden="true" class="text-sm">📍</span>
                {BRAND_ADDRESS.label}
              </p>
              {BRAND_ADDRESS.lines.map((line) => (
                <span class="block">{line}</span>
              ))}
              {BRAND_ADDRESS.email && (
                <a href={`mailto:${BRAND_ADDRESS.email}`} class="mt-3 inline-flex items-center gap-2 font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                  <span aria-hidden="true" class="text-sm">✉️</span>
                  {BRAND_ADDRESS.email}
                </a>
              )}
            </address>
          )
        }

        <div class="mt-2">
          <p class="mb-3 text-xs font-bold tracking-wider text-[#a8d4ff]/90 uppercase">รองรับทุกธนาคาร &amp; True Wallet</p>
          <BankStrip size={26} />
        </div>
      </div>
    </div>

    <div class="mb-6 flex flex-wrap justify-center gap-4 border-y border-[#2e8bff]/25 py-6 opacity-60 grayscale transition-all duration-500 hover:opacity-100 hover:grayscale-0 md:gap-8">
      <span class="text-lg font-black text-gray-300 italic md:text-2xl">PG<span class="text-[#a8d4ff]">SOFT</span></span>
      <span class="text-lg font-black text-gray-300 italic md:text-2xl">PRAGMATIC<span class="text-[#a8d4ff]">PLAY</span></span>
      <span class="text-lg font-black text-gray-300 italic md:text-2xl">EVO<span class="text-[#a8d4ff]">LUTION</span></span>
      <span class="text-lg font-black text-gray-300 italic md:text-2xl">JILI<span class="text-[#a8d4ff]">GAMES</span></span>
      <span class="text-lg font-black text-gray-300 italic md:text-2xl">MICRO<span class="text-[#a8d4ff]">GAMING</span></span>
    </div>

    <div class="flex flex-col items-center justify-between gap-4 text-xs text-[#8ba3c9] md:flex-row">
      <p>&copy; {new Date().getFullYear()} <span class="font-bold text-[#ffd93d]">POE888</span>. All rights reserved. หวยออนไลน์ ไทย–ลาว ตรวจผลไว ถอนง่าย</p>
      <div class="flex gap-4">
        <a href="/terms/" class="transition-colors hover:text-[#a8d4ff]">เงื่อนไขการให้บริการ</a>
        <a href="/privacy/" class="transition-colors hover:text-[#a8d4ff]">นโยบายความเป็นส่วนตัว</a>
      </div>
    </div>
  </div>
</footer>

<style>
  footer a {
    text-decoration: none;
  }
  footer {
    font-family: var(--font-sans);
  }
</style>
