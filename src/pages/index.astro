---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxCyberCut.astro";
import ContentBoxTwo from "../components/ContentBoxTwoCyberCut.astro";
import ContentBoxSevenThree from "../components/ContentBoxSevenThreeCyberCut.astro";
import ContentBoxThreeColums from "../components/ContentBox3ThreeCyberCut.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementCyber.astro";
import SmoothCarousel from "../components/SmoothCarousel.astro";
import ProviderGrid from "../components/ProviderGrid.astro";
import LatestWinners from "../components/LatestWinnersCyber.astro";

const currentPath = Astro.url.pathname;
const homePage = Astro.url.origin;
const logoUrl = homePage + "/logo.webp";

const webPageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: "WAIVER388 เว็บสล็อตตรงไม่ผ่านเอเย่นต์ ทางเข้าหลัก มั่นคง ปลอดภัย 100%  ",
  description: "สมัครสมาชิก WAIVER388 สัมผัสประสบการณ์เดิมพันออนไลน์ระดับพรีเมียม เว็บตรงไม่ผ่านเอเย่นต์ ทางเข้าหลักที่มั่นคงและปลอดภัยที่สุด 100%  ",
  url: currentPath,
};
const webSiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "WAIVER388",
  alternateName: ["waiver388", "waiver388h", "waiver388 auto"],
  url: "https://waiver388-homepage.com/",
};
const orgSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "WAIVER388",
  logo: logoUrl,
  url: homePage,
};
const allSchemas = [webPageSchema, orgSchema, webSiteSchema];

import { Picture } from "astro:assets";
import image1 from "../assets/pro2.jpg";
---

<MainLayout>
  <script type="application/ld+json" set:html={JSON.stringify(allSchemas)} />

  <Announcement />

  <ContentBox title="WAIVER388 เว็บสล็อตตรงไม่ผ่านเอเย่นต์ ทางเข้าหลัก มั่นคง ปลอดภัย 100% ">
    <p class="leading-relaxed">
      <strong class="text-yellow-400">WAIVER388</strong> ก้าวขึ้นมาเป็นผู้นำด้วยการส่งมอบประสบการณ์เดิมพันผ่าน เว็บสล็อตตรง ทางเข้าหลัก ที่ตัดผ่านตัวกลางทุกรูปแบบ ไม่ผ่านเอเย่นต์ Waiver388 ยึดมั่นในความปลอดภัยของข้อมูลและเสถียรภาพทางการเงินเป็นหัวใจสำคัญ
      เพื่อให้ทุกการเดิมพันของคุณคือการเล่นที่สนุกที่คุ้มค่าและไร้ความกังวล นี่คือพื้นที่ที่เทคโนโลยีและความบันเทิงบรรจบกันอย่างสมบูรณ์แบบ ให้คุณเข้าถึงความสนุกได้อย่างไร้รอยต่อ ผ่านทางเข้าหลักที่การันตีความปลอดภัย
      100%
    </p>

    <div class="mt-8 flex flex-wrap justify-center gap-6">
      <a
        href="/login"
        class="group relative flex items-center justify-center px-10 py-3.5 font-black text-white transition-all hover:scale-105"
        style="clip-path: polygon(15% 0, 100% 0, 100% 70%, 85% 100%, 0 100%, 0 30%); background: #3c096c; border: 1px solid #9d4edd;">
        เข้าระบบเกม
      </a>
      <a
        href="/register"
        class="group relative flex items-center justify-center px-10 py-3.5 font-black text-white shadow-[0_0_20px_rgba(255,215,0,0.4)] transition-all hover:scale-105"
        style="clip-path: polygon(15% 0, 100% 0, 100% 70%, 85% 100%, 0 100%, 0 30%); background: linear-gradient(to right, #ff9100, #ffea00); color: #10002b;">
        สมัครสมาชิก
      </a>
    </div>
  </ContentBox>

  <LatestWinners />

  <ProviderGrid />

  <ContentBoxThreeColums titleleft="CORE_STABILITY" titlecenter="AUTO_TRANSFER" titleright="ENCRYPTED_VIP">
    <div slot="left">ระบบประมวลผลความเร็วสูง มั่นใจได้ในทุกการเดิมพัน ไม่มีสะดุด ปลอดภัย 100%</div>
    <div slot="center">ฝาก-ถอน อัตโนมัติด้วย AI อัจฉริยะ ทำรายการเพียง 3 วินาที รองรับทุกธนาคาร</div>
    <div slot="right">การดูแลระดับพรีเมียมจากทีมงานผู้เชี่ยวชาญ พร้อมความปลอดภัยข้อมูลขั้นสูงสุด</div>
  </ContentBoxThreeColums>

  <ContentBoxTwo titleleft="WAIVER388 ตัวเลือกเว็บสล็อต อันดับ 1 ของผู้เล่นมืออาชีพ? " titleright="สนุกไร้ขีดจำกัด กับคลังเกมสล็อต เดิมพันคุณภาพสูงที่">
    <div slot="left" class="text-white/80">
      <p>
        <strong class="text-[#10b981]">WAIVER388</strong> กลายเป็นตัวเลือกอันดับหนึ่งในใจของผู้เล่นมืออาชีพ เพราะ <strong class="text-yellow-400">ระบบ API ที่เสถียรและยุติธรรม</strong> เราใช้มาตรฐานระบบเกมลิขสิทธิ์แท้
        (Original API) ที่ไม่มีการปรับแต่ง ความมั่นคงทางการเงินระดับ High-End: สำหรับมืออาชีพ "กำไร" คือสิ่งที่ต้องเบิกถอนได้จริง Waiver388 บริหารจัดการด้วยระบบการเงินที่มีสภาพคล่องสูง การออกแบบที่เน้นประสิทธิภาพ
        (Performance-Driven UI/UX): เราตัดทอนความยุ่งยากที่ไม่จำเป็นออก เพื่อเน้นความรวดเร็วและลื่นไหลในการใช้งา
      </p>
    </div>
    <div slot="right" class="text-white/80">
      <p>
        เราคัดสรรเฉพาะเกมที่มีคุณภาพระดับโลก เพื่อให้สมาชิก <strong class="text-[#10b981]">WAIVER388</strong> ได้เพลิดเพลินกับประสบการณ์เดิมพันที่สมบูรณ์แบบที่สุด ไม่ว่าคุณจะเป็นสายปั่นสล็อต หรือคอเกมคาสิโนสด
        เรามีครบจบในที่เดียว รวมสล็อตทุกค่ายดังฟีเจอร์โบนัสแตกง่าย และอัตราจ่ายรางวัลสูง เว็บสล็อตตรง ไม่ผ่านเอเย่นต์คาสิโนระดับพรีเมียม WAIVER388 อัปเดตเกมใหม่ทุกสัปดาห์ รับรองว่าคุณจะไม่พลาดเทรนด์เกมใหม่ๆ
        ที่กำลังมาแรงที่สุดในขณะนี้ ระบบเสถียร เล่นได้ลื่นไหลไม่มีสะดุด ทั้งบนมือถือและคอมพิวเตอร์
      </p>
    </div>
  </ContentBoxTwo>

  <SmoothCarousel />

  <ContentBoxSevenThree>
    <div slot="left" class="flex h-full flex-col justify-center">
      <Picture
        src={image1}
        loading="lazy"
        fetchpriority="low"
        widths={[200, 400, 600, 800]}
        sizes="(max-width: 768px) 100vw, 50vw"
        decoding="async"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={80}
        alt="Vegus24 VIP Service"
        class="mx-auto h-auto w-full rounded-2xl border-2 border-yellow-500/30 shadow-[0_10px_30px_rgba(234,179,8,0.2)]"
      />
    </div>
    <div slot="right">
      <h2 class="mb-4 text-3xl font-black tracking-[0.2em] text-indigo-300 uppercase drop-shadow-[0_0_10px_rgba(157,78,221,0.5)]">
        โปรโมชั่นเด็ด! รับโบนัสสมาชิกใหม่และสิทธิพิเศษสำหรับสมาชิกปัจจุบัน
      </h2>
      <ul class="list-disc pl-5">
        <li class="mb-2">โบนัสต้อนรับสมาชิกใหม่ 100%: เพิ่มต้นทุนให้คุณมีโอกาสชนะรางวัลใหญ่ได้ง่ายขึ้น</li>
        <li class="mb-2">คืนยอดเสียทุกวัน: อุ่นใจทุกการเดิมพันด้วยระบบคืนกำไรให้สมาชิกที่ได้รับความนิยมสูงสุด</li>
        <li class="mb-2">กิจกรรมแจกเครดิตฟรี: ร่วมสนุกกับกิจกรรมหน้าเว็บและช่องทางโซเชียลของเรา เพื่อลุ้นรับเครดิตฟรีง่ายๆ ทุกวัน</li>
        <li class="mb-2">โปรโมชั่นฝากประจำ: สิทธิพิเศษสำหรับสมาชิก VIP ที่มอบโบนัสเพิ่มในทุกยอดฝาก</li>
      </ul>
      <a href="/line" class="inline-flex items-center rounded-full bg-yellow-500 px-8 py-3 font-bold text-green-950 shadow-lg transition-transform hover:scale-105">
        <span class="mr-2 text-xl">LINE</span> ติดต่อแอดมิน
      </a>
    </div>
  </ContentBoxSevenThree>
  <ContentBoxTwo titleleft="ขั้นตอนการสมัครสมาชิก Waiver388 ง่ายๆ ใน 3 นาที" titleright="บริการระดับ VIP ด้วยทีมงานมืออาชีพพร้อมดูแลคุณ 24 ชั่วโมง">
    <div slot="left" class="text-white/80">
      <ul class="list-decimal pl-5">
        <li class="mb-2">คลิกที่ปุ่ม "สมัครสมาชิก" บนหน้าเว็บไซต์</li>
        <li class="mb-2">กรอกข้อมูลเบอร์โทรศัพท์ และเลขบัญชีธนาคาร (ชื่อต้องตรงกัน)</li>
        <li class="mb-2">รับ User และ Password เริ่มต้นความสนุกได้ทันที</li>
      </ul>
    </div>
    <div slot="right" class="text-white/80">
      <p>
        ตอบกลับรวดเร็ว ทีมงาน Admin มืออาชีพผ่านการฝึกอบรมพร้อมแก้ปัญหาให้คุณได้ทันที ผ่านช่องทาง LINE และแชทสดบนหน้าเว็บ บริการด้วยใจ ใส่ใจในทุกรายละเอียด ตั้งแต่การสมัครสมาชิก การฝาก-ถอน
        ไปจนถึงคำแนะนำการเลือกเกมไม่มีวันหยุด ไม่ว่าคุณจะต้องการทำรายการช่วงเวลาไหน เราพร้อมให้บริการตลอด 24 ชั่วโมง ไม่มีวันหยุด ระบบความปลอดภัยสูงสุด
        ข้อมูลส่วนตัวของสมาชิกจะถูกเก็บเป็นความลับสูงสุดด้วยระบบรักษาความปลอดภัยมาตรฐานสากล เพื่อให้คุณโฟกัสกับการเดิมพันได้อย่างเต็มที่
      </p>
    </div>
  </ContentBoxTwo>
  <Navfoot />

  <style>
    :global(.text-emerald-gradient) {
      background: linear-gradient(to bottom, #34d399 0%, #10b981 100%) !important;
      -webkit-background-clip: text !important;
      -webkit-text-fill-color: transparent !important;
    }
  </style>
</MainLayout>
