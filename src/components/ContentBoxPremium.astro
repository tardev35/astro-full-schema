---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#f5c542]/35 bg-gradient-to-br from-[#4a0d0a]/92 to-[#1c0403]/88 p-8 text-left text-base leading-relaxed text-[#f7e2e2] shadow-[0_10px_30px_rgba(245,197,66,0.16)] backdrop-blur-xl transition-all duration-500 hover:border-[#f5c542]/65 hover:shadow-[0_15px_40px_rgba(245,197,66,0.28)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#f5c542]/30 blur-[55px] transition-all duration-500 group-hover:bg-[#ffe9a8]/35"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#d81f26]/45 blur-[55px] transition-all duration-500 group-hover:bg-[#f9a8bd]/40"></div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#f5c542]/30 pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffe9a8] via-[#f5c542] to-[#d81f26] shadow-[0_0_10px_rgba(245,197,66,0.5)]" />
          <HeadingTag
            class={`bg-gradient-to-r from-[#ffe9a8] via-[#f5c542] to-[#f9a8bd] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
            {title}
          </HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
