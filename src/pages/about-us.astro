---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import { pageGraph } from "../lib/schema";

const pageTitle = "เกี่ยวกับเรา BABYSHARK8899 เว็บนอกลิขสิทธิ์แท้ ระบบตรง จ่ายเต็มทุกบิล";

const pageHeading = "เกี่ยวกับเรา BABYSHARK8899 เว็บนอกลิขสิทธิ์แท้ ที่จบได้ในยูสเดียว";

const pageDescription =
  "รู้จัก BABYSHARK8899 เว็บนอกลิขสิทธิ์แท้ ที่รวมการเข้าเล่นสล็อตผ่านระบบตรง ฝากถอนออโต้ และการตรวจสอบสถานะรายการไว้ในยูสเดียว จ่ายเต็มทุกบิล ใช้งานได้ทุกอุปกรณ์";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox as="h1" title={pageHeading}>
    <p class="mb-4 text-left text-base leading-relaxed">
      <strong class="text-[#6cc5ff]">BABYSHARK8899</strong> คือเว็บสล็อตที่เชื่อมการเข้าเล่น การฝาก และการถอนไว้ในระบบเดียว สมาชิกใช้ยูสเดิมเลือกเกม ดูยอด และตรวจสถานะรายการของตัวเองได้จากหน้าเดียวกัน
    </p>

    <p class="mb-4 text-left text-base leading-relaxed">
      สิ่งที่เราให้เวลากับมันคือขั้นตอนที่สั้นลง ไม่ใช่ฟีเจอร์ที่เยอะขึ้น ทุกอย่างถูกวางให้จบได้จากมือถือเครื่องเดียวตั้งแต่รายการแรกของวัน
    </p>

    <p class="text-left text-base leading-relaxed">หน้านี้เล่าว่าเว็บทำงานอย่างไร ไม่ได้เขียนไว้ขายของ</p>
  </ContentBox>

  <ContentBox as="h2" title="เว็บนอกลิขสิทธิ์แท้ ระบบตรง ไม่ต้องผ่านเอเย่นต์หลายชั้น">
    <p class="mb-4 text-left text-base leading-relaxed">
      การเข้าเล่นของเราต่อตรงกับระบบของค่ายที่เปิดให้บริการ เส้นทางตั้งแต่หน้าล็อกอินไปถึงหน้าเกมจึงสั้น ไม่ต้องเดินผ่านเอเย่นต์หลายชั้นเหมือนที่หลายคนเคยเจอ
    </p>

    <p class="mb-4 text-left text-base leading-relaxed">
      รายละเอียดของแต่ละเกมอยู่ในหน้าเกมเอง ทั้งตารางจ่าย ฟีเจอร์โบนัส และค่า RTP ที่ค่ายประกาศไว้ อ่านแล้วเทียบกันได้ก่อนตัดสินใจว่าจะลงรอบไหน
    </p>

    <p class="text-left text-base leading-relaxed">ข้อมูลที่แสดงครบ ทำให้เลือกเกมจากตัวเลข ไม่ใช่จากชื่อ</p>
  </ContentBox>

  <ContentBox as="h2" title="ฝากถอนออโต้ ที่ไม่ต้องรอเจ้าหน้าที่ไล่ตรวจทีละยอด">
    <p class="mb-4 text-left text-base leading-relaxed">
      คำขอฝากและถอนถูกประมวลผลอัตโนมัติ ระบบรับรายการ ตรวจข้อมูล และอัปเดตยอดในบัญชีสมาชิกเอง ส่งคำขอแล้วติดตามสถานะได้จากหน้าสมาชิกของตัวเอง
    </p>

    <p class="mb-4 text-left text-base leading-relaxed">
      ถ้ายอดยังไม่ขึ้น ให้รอรอบประมวลผลก่อนแล้วค่อยเช็กซ้ำ การกดส่งคำขอรัวๆ ไม่ได้ทำให้เร็วขึ้น มีแต่จะสร้างรายการซ้ำที่ต้องตามแก้ทีหลัง
    </p>

    <p class="mb-4 text-left text-base leading-relaxed">
      อัตโนมัติไม่ได้แปลว่าไม่มีคน ทีมงานยังอยู่ตามปกติสำหรับรายการที่ต้องถาม ต่างกันแค่ว่าไม่ต้องรอคิวเพื่อให้ยอดเข้าบัญชี
    </p>

    <p class="text-left text-base leading-relaxed">รายการตอนตีสามกับตอนบ่ายสองจึงใช้เวลาไม่ต่างกัน</p>
  </ContentBox>

  <ContentBox as="h2" title="จ่ายเต็มทุกบิล กับเงื่อนไขการถอนที่เขียนไว้ให้อ่านก่อน">
    <p class="mb-4 text-left text-base leading-relaxed">
      ยอดที่ชนะถูกจ่ายเต็มจำนวนตามที่ระบบคำนวณไว้ ไม่มีการลดทอนระหว่างทาง ทั้งยอดคงเหลือ ยอดถอน และสถานะรายการจะแสดงให้เห็นก่อนกดยืนยันทุกครั้ง
    </p>

    <p class="mb-4 text-left text-base leading-relaxed">
      ส่วนที่ต่างกันจริงคือเงื่อนไขของแต่ละสิทธิ์ ทั้งวงเงินต่อรายการ จำนวนครั้งที่ถอนได้ และข้อกำหนดของโบนัสที่กำลังใช้อยู่ จุดนี้ควรอ่านของรายการนั้นก่อนทำ
    </p>

    <p class="text-left text-base leading-relaxed">ตัวเลขที่ประกาศไว้กับตัวเลขที่เข้าบัญชี ควรเป็นจำนวนเดียวกัน</p>
  </ContentBox>

  <ContentBox as="h2" title="ความเสถียรของระบบ และการดูแลบัญชีสมาชิก">
    <p class="mb-4 text-left text-base leading-relaxed">
      เรื่องที่เราลงแรงมากที่สุดคืออาการโหลดช้า หน้าเว็บค้าง และหลุดตอนเปลี่ยนเมนู ทั้งการเช็กยอดและการเข้าเกมถูกวางให้ทำงานต่อเนื่องตลอดทั้งวัน
    </p>

    <p class="mb-4 text-left text-base leading-relaxed">
      ประสิทธิภาพจริงยังขึ้นกับอุปกรณ์ เบราว์เซอร์ และเครือข่ายของผู้ใช้ด้วย ถ้าเจอปัญหา ลองรีเฟรชหน้า ตรวจอินเทอร์เน็ต หรือเข้าสู่ระบบใหม่ จะแยกสาเหตุได้เร็วขึ้น
    </p>

    <p class="mb-4 text-left text-base leading-relaxed">
      ฝั่งบัญชี การสมัครขอเฉพาะข้อมูลที่จำเป็นต่อการยืนยันตัวตน รหัสผ่านควรตั้งให้ไม่ซ้ำกับบัญชีสำคัญอื่น และไม่ส่งต่อให้ใครไม่ว่าจะอ้างว่าเป็นใคร
    </p>

    <p class="text-left text-base leading-relaxed">หลังบ้านที่นิ่งไม่ได้ทำให้เล่นเก่งขึ้น แต่ทำให้ไม่ต้องคอยระแวงมัน</p>
  </ContentBox>

  <Navfoot />
</MainLayout>
