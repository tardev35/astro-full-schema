---
const reviews = [
  {
    name: "สมาชิกที่ทำรายการบ่อยทั้งวัน",
    role: "ฝากปุ๊บเข้าปั๊บ ถอนปุ๊บยอดขึ้นปั๊บ",
    stars: 5,
    tag: "ฝากถอนตรง",
    content:
      "ที่ถูกใจคือไม่ต้องส่งสลิปให้ใครดูครับ โอนตามยอดที่ระบบแสดงแล้วเครดิตก็ขึ้นเอง ถอนก็เหมือนกัน กดยืนยันแล้วยอดวิ่งเข้าบัญชีเลย ไม่มีคนกลาง ไม่มีช่วงพักระบบให้ต้องลุ้น เคยเจอเว็บที่ปรับยอดช้ามาก่อน มาที่นี่แล้วรู้เลยว่าต่างกันตรงไหน",
    avatar: "⚡",
  },
  {
    name: "สมาชิกที่เริ่มจากทุนก้อนเล็ก",
    role: "ไม่มีขั้นต่ำจริง ไม่มีเงื่อนไขบังคับยอด",
    stars: 5,
    tag: "ไม่มีขั้นต่ำ",
    content:
      "ตอนแรกก็กลัวว่าจะเป็นแบบเว็บอื่นที่เขียนว่าไม่มีขั้นต่ำแต่พอเล่นจริงมีเงื่อนไขเต็มไปหมดค่ะ ที่นี่ลองฝากยอดเล็ก ๆ ดูก่อนก็ทำได้ ถอนยอดเล็กก็ถอนได้ตามที่มี ไม่มีใครมาบอกว่าต้องถึงเท่านั้นเท่านี้ก่อน เลยกล้าลองระบบก่อนค่อยเพิ่มทุนทีหลัง",
    avatar: "🐷",
  },
  {
    name: "สมาชิกที่ใช้วอเล็ทอย่างเดียว",
    role: "สมัครได้โดยไม่ต้องผูกบัญชีธนาคาร",
    stars: 5,
    tag: "pig auto wallet",
    content:
      "ผมไม่อยากผูกบัญชีธนาคารไว้กับเว็บพนันครับ พอที่นี่รองรับ True Wallet เต็มระบบก็จบเลย สมัครด้วยมือถือเครื่องเดียว ทำรายการผ่านวอเล็ทเร็วพอ ๆ กับโอนธนาคาร ไม่มีดีเลย์ให้ต้องนั่งรอ เข้าเกมค่ายไหนก็ใช้เครดิตชุดเดิม ตามสถานะรายการเองได้จากหน้าสมาชิก",
    avatar: "👛",
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label="เสียงจากสมาชิก PIGAUTO" class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#f87171] via-[#fff5e6] to-[#f5c542] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      เสียงจากสมาชิก <span class="text-[#ef4444]">PIGAUTO</span>
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#ef4444] to-transparent"></div>
  </div>

  <div class="mx-auto mb-8 flex max-w-md items-center justify-center gap-5 rounded-2xl border border-[#7f1d1d] bg-[#280707] px-6 py-4 shadow-[0_10px_30px_rgba(239,68,68,0.18)]">
    <div class="flex flex-col items-center">
      <span class="bg-gradient-to-b from-[#ffe9a8] to-[#a3610c] bg-clip-text text-4xl leading-none font-black text-transparent">{average}</span>
      <span class="mt-1 text-[10px] font-bold tracking-widest text-[#b08b80] uppercase">คะแนนเฉลี่ย</span>
    </div>
    <div class="h-12 w-px bg-[#7f1d1d]"></div>
    <div class="flex flex-col gap-1.5">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#ef4444]" : "text-[#7f1d1d]"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#b08b80]">คะแนนเฉลี่ย {average} จาก 5 ดาว จากการใช้งานจริงของสมาชิก {reviews.length} ด้าน</span>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
    {
      reviews.map((review) => (
        <article class="group relative isolate flex flex-col gap-4 overflow-hidden rounded-2xl border border-[#7f1d1d] bg-[#280707] p-6 text-left shadow-[0_10px_30px_rgba(239,68,68,0.14)] transition-all duration-300 hover:-translate-y-1 hover:border-[#ef4444]/60 hover:shadow-[0_15px_40px_rgba(239,68,68,0.28)]">
          <span class="absolute inset-y-0 left-0 -z-10 w-1 bg-gradient-to-b from-[#ef4444] to-[#f5c542] opacity-80 transition-opacity duration-300 group-hover:opacity-100" />
          <span class="pointer-events-none absolute -top-14 -right-14 -z-10 h-32 w-32 rounded-full bg-[#ef4444]/16 blur-[50px] transition-all duration-300 group-hover:bg-[#f87171]/24" />

          <div class="flex items-center justify-between gap-3">
            <span class="inline-flex items-center gap-1.5 rounded-full border border-[#7f1d1d] bg-[#1a0303] px-3 py-1 text-[10px] font-bold tracking-widest text-[#d9b7ab] uppercase">
              <span aria-hidden="true" class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#fbbccc]" />
              {review.tag}
            </span>
            <span class="flex gap-0.5 text-sm">
              <span aria-hidden="true" class="flex gap-0.5">
                {Array.from({ length: 5 }).map((_, i) => (
                  <span class={i < review.stars ? "text-[#ef4444]" : "text-[#7f1d1d]"}>★</span>
                ))}
              </span>
              <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
            </span>
          </div>

          <p class="text-left text-base leading-relaxed text-[#f7e2d6]">{review.content}</p>

          <div class="mt-auto flex items-center gap-3 border-t border-[#7f1d1d] pt-4">
            <span
              aria-hidden="true"
              class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#ef4444]/40 bg-gradient-to-br from-[#f87171] via-[#ef4444] to-[#7f1d1d] text-xl shadow-inner transition-transform duration-300 group-hover:scale-110">
              {review.avatar}
            </span>
            <span class="flex flex-col">
              <span class="text-sm font-black text-[#fff5e6] transition-colors group-hover:text-[#f5c542]">{review.name}</span>
              <span class="text-[10px] font-bold tracking-wider text-[#b08b80] uppercase">{review.role}</span>
            </span>
          </div>
        </article>
      ))
    }
  </div>
</section>
