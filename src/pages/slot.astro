const pgGames = [
  { name: "Treasures of Aztec", img: pgAztec, alt: "ปกเกม Treasures of Aztec สาวนักสำรวจสวมเครื่องประดับขนนกหน้าจานหินทองของชาวแอซเท็ก" },
  { name: "Tree of Fortune", img: pgTree, alt: "ปกเกม Tree of Fortune ต้นไม้ใหญ่กลางทุ่งหญ้าที่มีเหรียญทองร่วงจากกิ่ง" },
  { name: "Alchemy Gold", img: pgAlchemy, alt: "ปกเกม Alchemy Gold หม้อต้มยาสีน้ำเงินที่ทองหลอมพุ่งขึ้นเป็นควันสีส้ม" },
  { name: "Alibaba's Cave of Fortune", img: pgAlibaba, alt: "ปกเกม Alibaba's Cave of Fortune ชายสวมผ้าโพกหัวสีม่วงยิ้มอยู่หน้าถ้ำสมบัติ" },
  { name: "Anubis Wrath", img: pgAnubis, alt: "ปกเกม Anubis Wrath เทพอนูบิสหัวสุนัขจิ้งจอกนั่งบนบัลลังก์ทองในวิหารอียิปต์" },
  { name: "Asgardian Rising", img: pgAsgard, alt: "ปกเกม Asgardian Rising นักรบไวกิ้งกล้ามโตถือขวานและโล่กลางพายุทราย" },
  { name: "Bakery Bonanza", img: pgBakery, alt: "ปกเกม Bakery Bonanza เค้กช็อกโกแลตราดสตรอว์เบอร์รีล้อมด้วยขนมปังและครัวซองต์" },
  { name: "Bali Vacation", img: pgBali, alt: "ปกเกม Bali Vacation นางรำบาหลีสวมมงกุฎทองและชุดสีแดงหน้าต้นมะพร้าว" },
  { name: "Battleground Royale", img: pgBattle, alt: "ปกเกม Battleground Royale ทหารกระโดดร่มถือปืนกลางสนามรบ" },
