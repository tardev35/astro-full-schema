---
export interface Props {
  title?: string;
  titleleft?: string;
  titleright?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, titleleft, titleright, as: HeadingTag = "h2" } = Astro.props;
---

<section class="my-10 flex w-full justify-center px-4 font-sans">
  <div
    class="relative isolate w-full max-w-7xl rounded-2xl border-2 border-[#ffd400]/25 bg-gradient-to-b from-[#170733]/95 to-[#0d0320]/95 p-8 pt-32 shadow-[0_10px_30px_rgba(255,212,0,0.16)] md:pt-28">
    <div aria-hidden="true" class="pointer-events-none absolute -right-10 -bottom-16 -z-10 h-40 w-40 rounded-full bg-[#ff4fd8]/30 blur-[60px]"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -top-16 -left-10 -z-10 h-40 w-40 rounded-full bg-[#ffd400]/25 blur-[60px]"></div>

    {
      title && (
        <div class="absolute -top-6 left-1/2 w-[92%] max-w-2xl -translate-x-1/2 rounded-lg border-2 border-[#ffd400]/35 bg-[#170733] px-4 py-2.5 text-center shadow-[0_10px_30px_rgba(255,212,0,0.22)] sm:px-8">
          <HeadingTag class="bg-gradient-to-r from-[#ffe94d] via-[#ffd400] to-[#ff4fd8] bg-clip-text text-lg leading-normal font-black tracking-tight text-transparent uppercase sm:text-xl md:text-2xl">
            {title}
          </HeadingTag>
        </div>
      )
    }

    <div class="grid grid-cols-1 gap-10 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#ece2fb]">
        {titleleft && <p class="text-2xl leading-normal font-bold text-[#ffd400]">{titleleft}</p>}
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#ece2fb] md:border-l md:border-[#ffd400]/25 md:pl-10">
        {titleright && <p class="text-2xl leading-normal font-bold text-[#ffd400]">{titleright}</p>}
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
