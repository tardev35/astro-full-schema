---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementCyber.astro";

import { Picture } from "astro:assets";
import { itemList, pageGraph, schemaCtx } from "../lib/schema";
import image1 from "../assets/gamedemo7.webp";
import image2 from "../assets/gamedemo8.webp";
import image3 from "../assets/gamedemo9.webp";
import image4 from "../assets/gamedemo10.webp";
import image5 from "../assets/gamedemo11.webp";
import image6 from "../assets/gamedemo12.webp";
import image7 from "../assets/gamedemo13.webp";
import image8 from "../assets/gamedemo14.webp";
import image9 from "../assets/gamedemo15.webp";
import image10 from "../assets/gamedemo16.webp";
import image11 from "../assets/gamedemo17.webp";
import image12 from "../assets/gamedemo18.webp";

const demoGames = [
  { name: "AskmeSlot", src: image1, alt: "แบนเนอร์ค่าย askmeslot โลโก้โพดำสีทองที่มีสัญลักษณ์ไพ่อยู่ข้างใน คู่กับตัวการ์ตูนเด็กชายสวมหมวกแดงติดดาว กางแขนวิ่งบนถนนในเมืองยุโรปที่มีกังหันลม" },
  { name: "Popular Game", src: image2, alt: "แบนเนอร์ Popular Game ตัวอักษรทองนูนหน้าวงแหวนชิปคาสิโนสีทอง ขนาบด้วยกระต่ายถือหีบสมบัติกับแมวใส่แว่นกันแดด ท่ามกลางเหรียญทองและชิปที่ลอยฟุ้ง" },
  { name: "SlotXO", src: image3, alt: "แบนเนอร์ค่าย SLOTXO โลโก้ตู้สล็อตล้อมด้วยเหรียญทอง คู่กับนักรบโรมันผมขาวสวมมงกุฎใบลอเรลและเกราะทอง ยืนหน้าโคลอสเซียมกับทหารอีกสองนาย" },
  { name: "Skywind Group", src: image4, alt: "แบนเนอร์ค่าย Skywind Group โลโก้วงกลมสี่สีบนพื้นดำ คู่กับแมวกวักนำโชคสีขาวคาดกระพรวนทอง ยืนข้างไหทองและถุงเงินสีม่วงใต้ต้นซากุระ" },
  { name: "PG Soft", src: image5, alt: "แบนเนอร์ค่าย PG Pocket Games Soft โลโก้ตัวอักษรพิกเซลบนพื้นดำ คู่กับตัวละครหญิงนักรบผิวแทนสวมเครื่องประดับทองและหมวกขนนกสไตล์แอซเท็ก" },
  { name: "SBOBET", src: image6, alt: "แบนเนอร์ค่ายเกม SBOBET โลโก้ตัวอักษรขาวบนพื้นดำ คู่กับตัวการ์ตูนอนิเมะสาวหูจิ้งจอกผมบลอนด์ในชุดกิโมโนสีชมพู มือถืออมยิ้มเกลียวหลากสี" },
  { name: "Sexy Slot", src: image7, alt: "แบนเนอร์ค่าย Sexy Slot ตัวอักษรสีชมพูม่วงมีประกายวิบวับ คู่กับตัวการ์ตูนสาวผมน้ำตาลในชุดรัดรูปสีม่วง นั่งอยู่ในกรอบวงกลมที่ล้อมด้วยหัวใจสีชมพู" },
  { name: "JILI", src: image8, alt: "แบนเนอร์ค่ายเกม JILI ตัวอักษรทองบนพื้นดำ คู่กับนางเงือกผมแดงสวมเกราะเปลือกหอยสีทอง ยกหอยสังข์แนบหูอยู่ใต้ทะเลที่มีปลาการ์ตูนและปะการัง" },
  { name: "Ask Me Bet", src: image9, alt: "แบนเนอร์ค่ายเกม ask me bet โลโก้สามช่องสีขาวเขียวเหลืองบนพื้นดำ คู่กับหัวสิงโตเชิดตรุษจีนสีแดงทองตาโต ใต้แถวโคมไฟแดงหน้าศาลเจ้า" },
  { name: "New Game", src: image10, alt: "แบนเนอร์ New Game ตัวอักษรสีขาวนูนกลางภาพ ขนาบด้วยตัวการ์ตูนฟักทองหัวไฟกับโครงกระดูกยิ้ม ยืนบนฟลอร์นีออนสีชมพูฟ้าที่เกลื่อนด้วยชิปและลูกเต๋า" },
  { name: "JOKER", src: image11, alt: "แบนเนอร์ค่ายเกม JOKER ตัวอักษรขาวทองบนพื้นดำ คู่กับนักรบโรมันสวมหมวกเหล็กติดขนนกและถือโล่ ยืนเคียงสิงโตกำลังคำรามกลางสนามประลอง" },
  { name: "AFB Gaming", src: image12, alt: "แบนเนอร์ค่ายเกม AFB Gaming โลโก้ตัวอักษรทองบนพื้นดำ คู่กับเทพซุสเคราขาวตาเรืองแสงสีฟ้า สวมมงกุฎใบลอเรลและกำไลทองหน้าวิหารกรีก" },
];

const gameList = demoGames.map((game) => ({ name: game.name, imagePath: game.src.src }));

const pageTitle = "ทดลองเล่นสล็อต GODKINGKONG";

const pageHeading = "ทดลองเล่นสล็อต GODKINGKONG เปิดดูระบบเกมก่อนลงเครดิตจริง";

const pageDescription =
  "ทดลองเล่นสล็อต GODKINGKONG เว็บตรงเกมแท้ส่งตรงจากค่ายแม่ ไม่ปรับ RTP เปิดดูหน้าเกม ปุ่มปรับเดิมพัน และฟีเจอร์ฟรีสปินก่อนลงเครดิตจริง รองรับวอเล็ทไม่มีขั้นต่ำ";

const ctx = schemaCtx(Astro);
const graph = pageGraph(Astro, {
  type: "CollectionPage",
  name: pageHeading,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  ],
  extra: [
    itemList(ctx, {
      name: "ทดลองเล่นเกมสล็อตของ GODKINGKONG",
      alternateName: "GODKINGKONG โหมดทดลองสล็อตหลายค่ายบนมือถือก่อนเล่นด้วยเงินจริง",
      itemType: "Game",
      items: gameList,
    }),
  ],
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox as="h1" title={pageHeading}>
    <p class="mb-4 text-left text-base leading-relaxed text-[#ddf3e2]">
      GODKINGKONG ให้บริการในรูปแบบเว็บตรง เกมสล็อตทุกเกมส่งตรงผ่าน API จากค่ายแม่บน Official Server ไม่ใช่ของก๊อป ไม่ผ่านเอเย่นต์ และไม่ผ่านคนกลางชั้นใด
      เราไม่มีการดัดแปลงค่า RTP ใด ๆ และไม่ล็อกยูส หน้ารวมเกมจึงแบ่งตามค่ายและรูปแบบการเล่นไว้ชัดเจน ทั้ง PG Soft, JOKER, JILI, SlotXO, Skywind Group
      และ AFB Gaming อยู่ในเมนูภาษาไทยชุดเดียวกัน เปิดดูได้ทั้งบนมือถือและคอมพิวเตอร์
    </p>

    <p class="text-left text-base leading-relaxed text-[#ddf3e2]">
      หน้านี้จัดไว้ให้คุณกดเปิดดูหน้าเกมก่อนว่าระบบหน้าตาเป็นอย่างไร ปุ่มปรับเดิมพันอยู่ตรงไหน ฟีเจอร์ฟรีสปินเรียกใช้อย่างไร และหนึ่งรอบกินเวลาเท่าไร
      โดยที่ยังไม่ต้องใส่เงินจริงและไม่มีการได้เสียเกิดขึ้นแม้แต่บาทเดียว สิ่งที่ควรดูจริง ๆ คือเดิมพันเริ่มต้นต่อรอบ ความผันผวนของเกม และรูปแบบการจ่าย
      มากกว่าจะดูว่าเกมไหนกำลังเป็นที่พูดถึงที่สุด เพราะเกมดังช่วยให้หารีวิวง่ายก็จริง แต่ไม่ได้ช่วยเจรจากับระบบสุ่มให้คุณเป็นการส่วนตัว
    </p>
  </ContentBox>

  <ContentBox as="h2" title="รวมค่ายที่ GODKINGKONG เชื่อมสัญญาณตรงจากค่ายแม่">
    <p class="mb-8 text-left text-base leading-relaxed text-[#ddf3e2]">
      ทุกค่ายด้านล่างนี้คือค่ายที่เราเชื่อม API ตรงกับต้นทาง เราไม่ได้ขนเกมมาถมให้เต็มเว็บ แต่คัดเฉพาะค่ายที่มีสถิติการแตกดีตรงตามต้นฉบับและโบนัสเข้าบ่อย
      ทุกเกมใช้ค่า RTP เต็มจำนวนตามที่ค่ายผู้พัฒนากำหนดมา กดที่ภาพเพื่อเข้าสู่ขั้นตอนสมัครและเปิดเข้าเล่นเกมนั้นได้ทันที กรอกข้อมูลที่จำเป็นไม่กี่อย่าง
      ตั้งรหัส แล้วเลือกวิธีฝาก ไม่ต้องส่งบัตรประชาชน ไม่ต้องถ่ายรูปหน้า
    </p>

    <div class="mb-5 grid grid-cols-2 gap-5 sm:grid-cols-2 md:grid-cols-4">
      {
        demoGames.map((game) => (
          <div class="group/game relative mx-auto w-full max-w-[400px] overflow-hidden rounded-xl">
            <Picture
              src={game.src}
              alt={game.alt}
              loading="lazy"
              fetchpriority="low"
              widths={[200, 400, 600]}
              sizes="(max-width: 768px) 100vw, 25vw"
              class="block h-auto w-full object-cover shadow-[0_10px_30px_rgba(47,227,95,0.18)] transition-transform duration-300 group-hover/game:scale-105"
              decoding="async"
              formats={["avif", "webp"]}
              fallbackFormat="webp"
              quality={60}
            />
            <a
              href="/register"
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`สมัครสมาชิกเพื่อเล่น ${game.name} ที่ GODKINGKONG`}
              class="absolute inset-0 flex items-center justify-center bg-[#050f09]/80 opacity-0 transition-opacity duration-300 group-hover/game:opacity-100 focus-visible:opacity-100">
              <span class="rounded-full border border-[#2fe35f]/60 bg-gradient-to-r from-[#7bff9f] via-[#2fe35f] to-[#0b6b34] px-6 py-2 font-bold text-[#04170b] shadow-[0_10px_30px_rgba(47,227,95,0.30)] transition-transform hover:scale-110">เล่นเลย</span>
            </a>
          </div>
        ))
      }
    </div>
  </ContentBox>

  <ContentBox as="h2" title="โหมดทดลองบอกอะไรได้ และบอกอะไรไม่ได้">
    <p class="mb-4 text-left text-base leading-relaxed text-[#ddf3e2]">
      โหมดทดลองบอกได้ว่าเกมทำงานอย่างไร เมนูอยู่ตรงไหน ฟีเจอร์ซื้อฟรีสปินเรียกใช้อย่างไร และหนึ่งรอบใช้เวลาเท่าไร แต่เครดิตในโหมดนี้เป็นยอดสมมติ ถอนไม่ได้
      และผลที่ออกมาก็ไม่ได้แปลว่าเล่นจริงแล้วจะออกในรูปแบบเดียวกัน เกมของ GODKINGKONG ทำงานตามค่า RTP ที่ค่ายแม่กำหนดมาเต็มจำนวน ไม่แต่ง ไม่ปรับ ไม่ลด
      ฉะนั้นต่อให้กดในโหมดทดลองแล้วจังหวะเข้ามือ ก็ไม่ใช่หลักฐานว่าเกมนั้นกำลังรอคุณอยู่ โหมดนี้มีไว้ศึกษาระบบ ไม่ได้มีไว้ดูดวงผ่านหน้าจอ
    </p>

    <p class="text-left text-base leading-relaxed text-[#ddf3e2]">
      อีกเรื่องที่ควรเผื่อใจไว้คือโหมดทดลองไม่ได้มีให้ครบทุกเกม จึงควรเปิดหน้ารายละเอียดของเกมดูเสียก่อนเลือก และยอดที่หมุนในโหมดทดลองไม่นับเป็นยอดเทิร์นของบัญชีหรือของโปรโมชั่นใดทั้งสิ้น
      ถ้าเกมที่อยากลองยังไม่มีปุ่มทดลอง ให้ถือว่าวันนี้ยังไม่ถูกจังหวะ ไม่ใช่สัญญาณลับที่ระบบส่งมาให้คุณคนเดียว และเวลาเทียบเกมกัน ให้ดูที่จำนวนไลน์ ตัวคูณ และเงื่อนไขการเข้าฟรีสปิน
      แล้วเอามาเทียบกับงบต่อรอบของตัวคุณเอง นั่นคือข้อมูลที่นำไปตัดสินใจได้จริง ไม่ใช่ความรู้สึกว่าเกมไหนหน้าตาใจดีกว่ากัน
    </p>
  </ContentBox>

  <ContentBox as="h2" title="จากโหมดทดลองไปเล่นจริงกับ GODKINGKONG ควรเตรียมอะไรบ้าง">
    <p class="mb-4 text-left text-base leading-relaxed text-[#ddf3e2]">
      เมื่อพร้อมขยับจากโหมดทดลองไปเล่นด้วยเงินจริง เรื่องที่ควรจัดการก่อนคือบัญชี งบต่อรอบ และลิงก์ที่ใช้เข้า ด้านบัญชี การสมัครกับเราง่ายเหมือนดีดนิ้ว
      กรอกข้อมูลที่จำเป็นไม่กี่อย่าง ตั้งรหัส แล้วเลือกวิธีฝาก ไม่ต้องส่งบัตรประชาชนและไม่ต้องถ่ายรูปหน้า แต่ชื่อบัญชีหรือวอเล็ทต้องตรงกับผู้สมัคร
      และเบอร์โทรต้องรับข้อความได้จริง เพราะระบบจะเร็วแค่ไหนก็ไม่มีประโยชน์ ถ้ากรอกชื่อบัญชีคลาดเคลื่อนตั้งแต่แรกแล้วต้องมาตามแก้ทีหลัง
    </p>

    <p class="mb-4 text-left text-base leading-relaxed text-[#ddf3e2]">
      ด้านงบ GODKINGKONG รองรับทั้ง True Wallet และ Mobile Banking พร้อมเพย์ โดยไม่มีขั้นต่ำ มีเงินติดวอเล็ทแค่ 1 บาทก็เข้ามาเป็นสมาชิกได้และได้รับการดูแลเหมือนกันทุกคน
      ทุกช่องทางวิ่งเร็วเท่ากัน ไม่มีช่องทางไหนถูกลดความสำคัญ ส่วนธุรกรรมทำงานแบบออโต้ฉับไว เงินเข้าออกไม่เกิน 3-5 วินาที ทำรายการเองได้ตลอด 24 ชั่วโมง
      ไม่ต้องส่งสลิปให้แอดมินตรวจ ไม่ต้องทักตามเงิน และไม่มีการถือดองยอด
    </p>

    <p class="text-left text-base leading-relaxed text-[#ddf3e2]">
      สุดท้ายควรเข้าใช้งานผ่านทางเข้าจริงของ GODKINGKONG ที่ตรวจชื่อเว็บไซต์แล้วและเชื่อมต่อแบบ HTTPS เท่านั้น ไม่ใช่ลิงก์ที่ส่งต่อกันมาในแชตพร้อมคำโฆษณาหวือหวา
      และไม่ควรส่งรหัสผ่านหรือรหัส OTP ให้บุคคลอื่นไม่ว่ากรณีใด ทีมงานตัวจริงไม่มีความจำเป็นต้องขอสองสิ่งนี้ ทางเข้าของเรารองรับทั้งมือถือ iOS และ Android รวมถึงคอมพิวเตอร์และแท็บเล็ต
      เปิดเล่นได้ทุกที่โดยระบบยังลื่นไหลเหมือนกันทุกอุปกรณ์
    </p>
  </ContentBox>

  <Navfoot />
</MainLayout>
