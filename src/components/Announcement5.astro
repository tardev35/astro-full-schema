---
const {
  message = "OKHENG รวมบาคาร่า คาสิโนสด และสล็อตลิขสิทธิ์จากหลายค่ายไว้ในยูสเดียว • ระบบ API แท้เชื่อมเกมทุกค่ายเข้ากับหน้าเมมเบอร์เดียว เปลี่ยนค่ายกลางทางได้โดยไม่ต้องสมัครใหม่ • ถอนได้จริงสูงสุด 10 ล้านบาท ทำรายการถอนจากหน้าเมมเบอร์และเช็กสถานะได้เอง • ระบบฝากถอนออโต้รองรับทรูวอลเล็ตและธนาคารชั้นนำ ส่งรายการได้ตลอด 24 ชั่วโมง • โปรสมาชิกใหม่ดูยอดรับ เทิร์น และช่วงเวลาที่ใช้ได้ก่อนกดรับทุกครั้ง • ทางเข้า OKHENG รองรับมือถือ ใช้ยูสเดิมล็อกอินแล้วกลับเข้าเกมต่อได้ทันที",
} = Astro.props;

const SCROLL_PX_PER_SEC = 50;
const PX_PER_CHAR = 6.2;
const TRAILING_PX = 81;
const scrollSeconds = Math.max(12, Math.round((message.length * PX_PER_CHAR + TRAILING_PX) / SCROLL_PX_PER_SEC));
---

<div class="mx-auto w-full max-w-7xl px-4 py-3 font-sans">
  <div class="relative overflow-hidden rounded-md border border-[#ed0133]/45 bg-[#170206] shadow-[0_0_15px_rgba(237,1,51,0.22)]">
    <div aria-hidden="true" class="absolute top-0 -left-4 h-full w-8 -skew-x-12 bg-gradient-to-b from-[#ff3d63] to-[#7a0119]"></div>
    <div aria-hidden="true" class="absolute top-0 -right-4 h-full w-8 -skew-x-12 bg-[#f0b429]/20"></div>

    <div class="flex items-center">
      <div class="relative z-10 flex w-12 shrink-0 items-center justify-center bg-gradient-to-b from-[#ff3d63] to-[#a30122] py-2.5">
        <span aria-hidden="true" class="animate-pulse text-lg drop-shadow-[0_0_5px_rgba(240,180,41,0.85)]">🏮</span>
      </div>

      <div class="marquee-container relative flex-1 overflow-hidden py-2.5 pr-6">
        <div aria-hidden="true" class="pointer-events-none absolute top-0 left-0 z-10 h-full w-8 bg-gradient-to-r from-[#170206] to-transparent"></div>
        <div aria-hidden="true" class="pointer-events-none absolute top-0 right-0 z-10 h-full w-12 bg-gradient-to-l from-[#170206] to-transparent"></div>

        <div class="marquee-content inline-block pl-4 text-sm font-bold tracking-wide whitespace-nowrap text-[#ffdb7d]" style={`animation-duration:${scrollSeconds}s`}>
          <span class="mr-8 inline-flex items-center gap-2"><span aria-hidden="true" class="h-1.5 w-1.5 rounded-full bg-[#ed0133] shadow-[0_0_5px_rgba(237,1,51,0.85)]"></span>{message}</span>
          <span aria-hidden="true" class="mr-8 inline-flex items-center gap-2"><span class="h-1.5 w-1.5 rounded-full bg-[#ed0133] shadow-[0_0_5px_rgba(237,1,51,0.85)]"></span>{message}</span>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .marquee-content {
    animation: marquee 25s linear infinite;
  }
  .marquee-container:hover .marquee-content {
    animation-play-state: paused;
  }
  @keyframes marquee {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee-content {
      animation: none;
    }
  }
</style>
